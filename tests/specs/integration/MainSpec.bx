class extends   ="coldbox.system.testing.BaseTestCase" appMapping="/app" {

	function beforeAll() {
		super.beforeAll();
	}

	function afterAll() {
		super.afterAll();
	}

	function run() {
		describe(
			"Main Handler",
			() => {
				beforeEach( ( currentSpec ) => {
						setup();
					} );

				it(
					"can render the dashboard homepage",
					() => {
						var event = this.get( "main.index" );
						expect( event.getRenderedContent() ).toInclude( "id=""history-panel""" );
						expect( event.getRenderedContent() ).toInclude( "id=""history-filters""" );
						expect( event.getRenderedContent() ).toInclude( "id=""history-trends""" );
						expect( event.getRenderedContent() ).toInclude( "id=""history-comparison""" );
						expect( event.getRenderedContent() ).toInclude( "Start Review" );
						expect( event.getRenderedContent() ).toInclude( "Start Modernize" );
					}
				);

				it(
					"can render the review workspace",
					() => {
						var event = this.get( "main.review" );
						expect( event.getRenderedContent() ).notToInclude( "value=""##encodeForHTML" );
						expect( event.getRenderedContent() ).toInclude( "id=""project-path""" );
						expect( event.getRenderedContent() ).toInclude( "id=""review-goal""" );
						expect( event.getRenderedContent() ).toInclude( "name=""reviewPreset"" value=""quick""" );
						expect( event.getRenderedContent() ).toInclude( "name=""reviewPreset"" value=""balanced"" checked" );
						expect( event.getRenderedContent() ).toInclude( "name=""reviewPreset"" value=""deep""" );
						expect( event.getRenderedContent() ).toInclude( "id=""advanced-settings""" );
						expect( event.getRenderedContent() ).toInclude( "Read-only" );
						expect( event.getRenderedContent() ).toInclude( "id=""pipeline-steps""" );
						expect( event.getRenderedContent() ).toInclude( "data-pipeline-stage=""specialists""" );
						expect( event.getRenderedContent() ).toInclude( "id=""command-files""" );
						expect( event.getRenderedContent() ).toInclude( "id=""jump-findings-button""" );
						expect( event.getRenderedContent() ).toInclude( "id=""jump-trace-button""" );
						expect( event.getRenderedContent() ).toInclude( "id=""command-export-button""" );
						expect( event.getRenderedContent() ).toInclude( "id=""evidence-panel""" );
						expect( event.getRenderedContent() ).toInclude( "id=""trace-count""" );
						expect( event.getRenderedContent() ).toInclude( "id=""observe-run-context""" );
						expect( event.getRenderedContent() ).toInclude( "id=""observe-trace-status""" );
						expect( event.getRenderedContent() ).toInclude( "id=""observe-stage-map""" );
						expect( event.getRenderedContent() ).toInclude( "Observation timeline" );
						expect( event.getRenderedContent() ).toInclude( "Langfuse-inspired" );
						expect( event.getRenderedContent() ).toInclude( "visibility across the review lifecycle" );
						expect( event.getRenderedContent() ).toInclude( "id=""finding-search""" );
						expect( event.getRenderedContent() ).toInclude( "id=""finding-severity""" );
						expect( event.getRenderedContent() ).toInclude( "id=""finding-detail""" );
					}
				);

				it(
					"can render the modernize workspace",
					() => {
						var event = this.get( "main.modernize" );
						expect( event.getRenderedContent() ).notToInclude( "value=""##encodeForHTML" );
						expect( event.getRenderedContent() ).toInclude( "id=""project-path""" );
						expect( event.getRenderedContent() ).toInclude( "id=""modernization-fields""" );
						expect( event.getRenderedContent() ).toInclude( "id=""source-engine""" );
						expect( event.getRenderedContent() ).toInclude( "id=""target-runtime""" );
						expect( event.getRenderedContent() ).toInclude( "id=""modernization-results""" );
						expect( event.getRenderedContent() ).toInclude( "id=""modernization-panes""" );
					}
				);

				it(
					"can render the codegraph workspace",
					() => {
						var event = this.get( "/codegraph" );
						expect( event.getResponse() ).toHaveStatus( 200 );
						expect( event.getRenderedContent() ).toInclude( "id=""project-path""" );
						expect( event.getRenderedContent() ).toInclude( "id=""codegraph-canvas""" );
						expect( event.getRenderedContent() ).toInclude( "CodeGraph" );
					}
				);

				it(
					"can startup executable code",
					() => {
						var event = execute( "main.onAppInit" );
					}
				);

				it(
					"can handle exceptions",
					() => {
						var exceptionBean = createMock( "coldbox.system.web.context.ExceptionBean" ).init(
								erroStruct   = structNew(),
								extramessage = "My unit test exception",
								extraInfo    = "Any extra info, simple or complex"
							);
						prepareMock( getRequestContext() ).setValue(
								name    = "exception",
								value   = exceptionBean,
								private = true
							).$( "setHTTPHeader" );

						var event = execute( "main.onException" );
					}
				);

				it(
					"fires on request start",
					() => {
						var event = execute( "main.onRequestStart" );
					}
				);
			}
		);
	}
}
