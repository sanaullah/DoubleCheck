class extends   ="coldbox.system.testing.BaseTestCase" appMapping="/app" {

	function beforeAll() {
		super.beforeAll();
	}

	function run() {
		describe(
			"Project path validation",
			() => {
				beforeEach( () => setup() );

				it(
					"allows any existing directory for local reviews",
					() => {
						var security = getInstance( "SecurityContextService" );
						var context = security.defaultContext();
						var windowsPath = createObject( "java", "java.io.File" ).init( "C:/Windows" ).getCanonicalPath();
						expect(
							security.authorizeProjectPath(
									context,
									"default",
									windowsPath
								)
						).toBe( windowsPath );
					}
				);

				it(
					"rejects missing directories",
					() => {
						var security = getInstance( "SecurityContextService" );
						var context = security.defaultContext();
						expect(
							() => {
								security.authorizeProjectPath(
										context,
										"default",
										"C:/doublecheck-missing-#createUUID()#"
									);
							}
						).toThrow( type = "ValidationException" );
					}
				);
			}
		);
	}
}