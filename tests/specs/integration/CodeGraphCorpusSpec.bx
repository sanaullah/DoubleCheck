/**
 * CodeGraph's small, deterministic acceptance corpus.
 *
 * The fixture is intentionally source-backed: parser dispatch, target
 * resolution, metrics/flow assembly, and bounded path traversal all run before
 * the thresholds are scored. It must not promote a language tier.
 */
class extends="coldbox.system.testing.BaseTestCase" {

	function run() {
		describe( "CodeGraph corpus — deterministic tier", () => {
			var corpusRoot = expandPath( "/tests/../resources/evaluation-corpus/codegraph-v1" );
			var manifest = jsonDeserialize( fileRead( corpusRoot & "/manifest.json", "UTF-8" ) );
			var corpusCase = manifest.cases[ 1 ];

			// Every case, not just the first. The manifest held one BoxLang case and
			// the spec read `cases[1]`, so adding a case would have scored nothing —
			// and the CFML gap it exposes (routes, renders and the read/write split
			// all absent) survived precisely because nothing scored ColdFusion.
			// `each` rather than an index loop: a closure created inside a `for` body
			// captures the loop variable, so every `it` block saw the last case and
			// two specs reported the same case's failure. `each` gives each iteration
			// its own binding.
			manifest.cases.each( ( scored ) => {
				it( "meets flow/path/domain thresholds for the #scored.language ?: 'unknown'# case '#scored.id#'", () => {
					expect( manifest.version ).toBe( "codegraph-corpus-v1" );
					expect( manifest.corpusKind ).toBe( "codegraph" );
					expect( manifest.promotesLanguageTier ).toBeFalse();

					var first = evaluateCase( corpusRoot, scored );
					var second = evaluateCase( corpusRoot, scored );
					var expected = scored.expected;

					for ( var route in ( expected.routes ?: [] ) ) {
						expect( first.routes ).toInclude( route, "route missing for #scored.id#" );
					}
					for ( var table in ( expected.tables ?: [] ) ) {
						expect( first.tables ).toInclude( table, "table missing for #scored.id#" );
					}
					// Containment, not equality. Exact equality made the corpus assert
					// the clustering algorithm's current output, so adding a file to a
					// case failed it for a reason that had nothing to do with the
					// capability being measured. What matters is that the domains the
					// case is built to expose are found, and that the set does not move
					// between identical runs — which `domainStability` covers.
					for ( var domain in ( expected.domains ?: [] ) ) {
						expect( first.domains ).toInclude( domain, "domain missing for #scored.id#" );
					}
					var domainStability = first.domainSignature == second.domainSignature ? 1 : 0;

					var flowThreshold = val( manifest.thresholds.flowRecall ?: 1 );
					var pathThreshold = val( manifest.thresholds.pathRecall ?: 1 );
					var domainThreshold = val( manifest.thresholds.domainStability ?: 1 );
					expect( first.flowRecall ).toBeGTE( flowThreshold, "flow recall below threshold for #scored.id#" );
					expect( first.pathRecall ).toBeGTE( pathThreshold, "path recall below threshold for #scored.id#" );
					// `extends` and `implements` were correct-and-empty on this
					// repository, which reads exactly like a broken relationship.
					// Both cases declare a supertype and an interface so the
					// difference is measurable.
					expect( first.hierarchyRecall ).toBeGTE(
						val( manifest.thresholds.hierarchyRecall ?: 1 ),
						"hierarchy recall below threshold for #scored.id#"
					);
					expect( domainStability ).toBeGTE( domainThreshold, "domain labels changed between repeated runs for #scored.id#" );
					expect( first.fingerprint ).toBe( second.fingerprint, "repeated source indexing must remain deterministic" );
				} );
			} );

			it( "scores at least one case per supported language", () => {
				// BoxLang, ColdFusion and JavaScript are the product's three supported
				// languages. A corpus that only scores one of them measures a third of
				// the promise; every JS case here participates through its case's
				// `calls-api` path assertion.
				var languages = manifest.cases.map( ( item ) => lCase( trim( item.language ?: "" ) ) );
				expect( languages ).toInclude( "boxlang" );
				expect( languages ).toInclude( "cfml" );
			} );

			it( "produces an identical fingerprint when the same files arrive in reverse order", () => {
				// INV-1's guard. `canonicalJson` sorts struct keys before hashing and
				// every struct iteration sorts before it reaches output; this is the
				// check that keeps that true, because a single missed sort would be
				// silent and would break byte-identical output across machines.
				var forward = evaluateCase( corpusRoot, corpusCase );
				var reversed = evaluateCase( corpusRoot, corpusCase, true );
				expect( reversed.fingerprint ).toBe( forward.fingerprint, "input order must not change the snapshot fingerprint" );
			} );

			it( "records a gate run without promoting a language tier", () => {
				// Green in the suite is not a measurement anyone can point at later.
				// Every one of the recorded gate rows belonged to the review corpus
				// until this existed, so graph fidelity had no trend at all.
				var before = queryExecute(
					"SELECT COUNT(*) AS total FROM evaluation_gate_runs WHERE corpus_version = :version",
					{ version: "codegraph-corpus-v1" }
				);
				var tiersBefore = queryExecute( "SELECT language, capability_tier FROM language_capabilities" );
				var gateRun = getInstance( "QualityGateService" ).runCodeGraphGate();

				expect( gateRun.passed ).toBeTrue( "the codegraph corpus must pass its own thresholds" );
				var after = queryExecute(
					"SELECT COUNT(*) AS total FROM evaluation_gate_runs WHERE corpus_version = :version",
					{ version: "codegraph-corpus-v1" }
				);
				expect( val( after.total[ 1 ] ) ).toBe( val( before.total[ 1 ] ) + 1, "the gate run must be recorded" );

				// The graph corpus measures fidelity, not finding quality, so it must
				// leave the tier registry exactly as it found it.
				var tiersAfter = queryExecute( "SELECT language, capability_tier FROM language_capabilities" );
				expect( tiersAfter.recordCount ).toBe( tiersBefore.recordCount, "a graph gate must not promote a language tier" );
			} );

			it( "keeps the corpus honest about language-tier measurement", () => {
				expect( manifest.promotesLanguageTier ).toBeFalse();
				expect( manifest.thresholds.flowRecall ).toBeGTE( 1 );
				expect( manifest.thresholds.pathRecall ).toBeGTE( 1 );
				expect( manifest.thresholds.domainStability ).toBeGTE( 1 );
			} );
		} );
	}

	/**
	 * Delegates to the service that also backs the recorded gate.
	 *
	 * The scoring used to live here, which is why the corpus could be green in the
	 * suite and absent from `evaluation_gate_runs` for its whole life. One owner,
	 * two callers.
	 */
	private struct function evaluateCase( required string corpusRoot, required struct corpusCase, boolean reverseFileOrder = false ) {
		return new app.models.services.CodeGraphCorpusService().scoreCase(
			arguments.corpusRoot,
			arguments.corpusCase,
			arguments.reverseFileOrder
		);
	}
}
