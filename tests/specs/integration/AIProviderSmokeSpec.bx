class extends   ="coldbox.system.testing.BaseTestCase" appMapping="/app" {

	function beforeAll() {
		super.beforeAll();
	}

	function afterAll() {
		super.afterAll();
	}

	function run() {
		describe(
			"Configured BoxLang AI provider",
			() => {
				beforeEach( () => {
						setup();
					} );

				it(
					title = "completes a minimal OpenAI-compatible chat request",
					skip  = () => !getSystemSetting( "RUN_LIVE_AI_TESTS", false ),
					body  = () => {
						var service = getInstance( "AIReviewService" );
						expect( service.isEnabled() ).toBeTrue();
						var result = service.smokeTest();
						expect( result.success ).toBeTrue( "Provider response did not contain the expected marker." );
						expect( result.response ).notToBeEmpty();
						expect( result.response ).toBeStruct();
						expect( result.response.marker ).toBe( "OK" );
						expect( result.responseFormat ).toBe( "json" );
						expect( result.provider ).notToBeEmpty();
						expect( result.model ).notToBeEmpty();
						expect( result.baseHost ).notToBeEmpty();
						expect( result.durationMs ).toBeGT( 0 );
						expect( result.outputCharacters ).toBeGT( 0 );
						expect( result.usage.totalTokens ).toBeGT( 0 );
						expect( result.usage.source ).toBe( "estimated-from-characters" );
						expect( result.errorClass ).toBeEmpty();
					}
				);
			}
		);
	}
}
