class extends="coldbox.system.testing.BaseTestCase" appMapping="/app" {

	function beforeAll() {
		super.beforeAll();
	}

	function afterAll() {
		prepareMock( getInstance( "ReviewRunService" ) ).$property(
				"workerEnabled",
				"variables",
				true
			);
		super.afterAll();
	}

	function run() {
		describe( "CodeGraph API", () => {
			beforeEach( () => {
				setup();
				prepareMock( getInstance( "ReviewRunService" ) ).$property(
						"workerEnabled",
						"variables",
						false
					);
			} );

			it( "creates a codegraph run with 202 and Location", () => {
				var fixturePath = expandPath( "/tests/../resources/evaluation-corpus/modernization-v1/cases/separable-domain" );
				var created = this.post(
						route   = "/api/v1/runs",
						headers = { "Content-Type": "application/json", "Accept": "application/json" },
						body    = {
							projectPath: fixturePath,
							runKind    : "codegraph",
							mode       : "full"
						}
					);
				var statusCode = created.getRenderData().statusCode ?: 0;
				if ( !statusCode ) {
					statusCode = created.getResponse().getStatusCode();
				}
				expect( statusCode ).toBe(
						202,
						"create body: #left( toString( created.getRenderedContent() ), 500 )#"
					);
				var body = jsonDeserialize( created.getRenderedContent() );
				expect( body.data.runKind ).toBe( "codegraph" );
				expect( body.data.mode ).toBe( "full" );
				expect( len( trim( body.data.id ?: "" ) ) ).toBeGT( 0 );

				var expectedLocation = "/api/v1/runs/#body.data.id#";
				var location = created.getResponse().getMemento().location ?: "";
				if ( !len( trim( toString( location ) ) ) ) {
					try {
						location = created.getResponse().getHeader( "Location" );
					} catch ( any ignored ) {
						location = "";
					}
				}
				expect( toString( location ) ).toInclude( expectedLocation );
				queryExecute( "DELETE FROM review_runs WHERE id = :runId", { runId: body.data.id } );
			} );

			it( "returns codegraph result totals without raw edges, bounded drill-down, history, paths, and export formats", () => {
				var marker = lCase( createUUID() );
				var runId = "codegraph-api-#marker#";
				var nowValue = dateTimeFormat( now(), "iso" );
				var fixtureRoot = expandPath( "/tests/../resources/evaluation-corpus/codegraph-v1/cases/order-flow" );
				var runRepository = getInstance( "ReviewRunRepository" );
				var codeGraphRepository = getInstance( "CodeGraphRepository" );
				var paths = [
					"app/A.bx",
					"app/B.bx",
					"app/C.bx",
					"app/D.bx",
					"app/E.bx",
					"app/F.bx",
					"app/G.bx",
					"app/H.bx"
				];
				try {
					runRepository.create( {
						id           : runId,
						tenantId     : "default",
						projectId    : "default",
						projectPath  : fixtureRoot,
						mode         : "full",
						runKind      : "codegraph",
						input        : { version: "codegraph-input-v1" },
						baseRevision : "",
						headRevision : "HEAD",
						status       : "succeeded",
						progress     : 100,
						currentPhase : "completed",
						message      : "CodeGraph API fixture",
						policy       : { version: "codegraph-input-v1", runKind: "codegraph" },
						budgets      : {},
						createdAt    : nowValue,
						updatedAt    : nowValue
					} );

					var nodes = [];
					for ( var path in paths ) {
						nodes.append( { id: lCase( path ), path: path } );
					}
					codeGraphRepository.save(
						runId              = runId,
						snapshot           = {
							version           : "codegraph-snapshot-v1",
							fingerprint       : "fp-api-#marker#",
							truncated         : false,
							truncationReasons : [],
							totals            : {
								files           : paths.len(),
								symbols         : paths.len(),
								dependencies    : paths.len() - 1,
								nodes           : paths.len(),
								edges           : paths.len() - 1,
								clusters        : 1,
								cycles          : 0,
								orphans         : 0,
								layerViolations : 0
							},
							nodes             : nodes,
							clusters          : [ { id: "c1", label: "app", fileCount: paths.len() } ],
							flows             : [ { id: "f1", entryFile: "app/A.bx", steps: [ "app/a.bx" ] } ],
							directories       : [ { path: "app", fileCount: paths.len(), symbolCount: paths.len() } ],
							clusterEdges      : [ { source: "c1", target: "c1", weight: 1 } ],
							cycles            : [],
							hotspots          : [],
							orphans           : [],
							layerViolations   : []
						},
						projectPath        = fixtureRoot,
						repositoryRevision = "deadbeef",
						narrativeCacheKey  = "",
						narrative          = { used: false }
					);

					var parsedFiles = [];
					for ( var i = 1; i < paths.len(); i++ ) {
						parsedFiles.append( {
							filePath     : paths[ i ],
							contentHash  : "hash-#i#",
							parserVersion: "test-v1",
							symbols      : [],
							dependencies : [
								{
									id        : "dep-#i#",
									kind      : "constructs",
									target    : listLast( paths[ i + 1 ], "/" ),
									targetFile: paths[ i + 1 ],
									line      : i,
									evidence  : "fixture"
								}
							]
						} );
					}
					getInstance( "AnalysisGraphRepository" ).replaceRunGraph(
						runId,
						parsedFiles,
						[],
						{
							parserVersion   : "test-v1",
							filesAnalyzed   : paths.len(),
							parserExecutions: paths.len(),
							cacheHits       : 0,
							symbolCount     : 0,
							dependencyCount : paths.len() - 1,
							impactCount     : 0,
							baselineRunId   : ""
						}
					);

					var resultEvent = this.get( "/api/v1/runs/#runId#/result" );
					expect( resultEvent.getResponse() ).toHaveStatus( 200 );
					var resultBody = jsonDeserialize( resultEvent.getRenderedContent() );
					expect( resultBody.data.result.codegraph.totals.nodes ).toBe( paths.len() );
					expect( resultBody.data.result.codegraph ).notToHaveKey( "edges" );
					expect( resultBody.data.result.codegraph.clusterEdges ).toBeArray();
					expect( resultBody.data.result.codegraph.flows ).toBeArray();
					expect( resultBody.data.result.codegraph.flows ).toHaveLength( 1 );
					expect( resultBody.data.result.codegraph.directories ).toHaveLength( 1 );
					expect( resultBody.data.result.codegraph.coChange ).toBeStruct();
					expect( resultBody.data.result.codegraph.hotspotFormula ).toBeString();

					var subgraphEvent = this.get(
							"/api/v1/runs/#runId#/codegraph/subgraph",
							{ focus: "app/A.bx", depth: 3, limit: 5 }
						);
					expect( subgraphEvent.getResponse() ).toHaveStatus( 200 );
					var subgraph = jsonDeserialize( subgraphEvent.getRenderedContent() ).data;
					expect( subgraph.nodes.len() ).toBeLTE( 5 );
					// D7: `truncated` used to compare the neighbourhood against the
					// whole graph, so it was true for every request and carried no
					// information. This fixture's neighbourhood fits inside the
					// limit and is fully explored, so the honest answer is false.
					// The genuinely capped case is asserted below.
					expect( subgraph.truncated ).toBeFalse( "a neighbourhood that fits is not truncated" );

					var cappedSubgraph = jsonDeserialize(
						this.get( "/api/v1/runs/#runId#/codegraph/subgraph", { focus: "app/A.bx", depth: 3, limit: 1 } ).getRenderedContent()
					).data;
					expect( cappedSubgraph.truncated ).toBeTrue( "hitting the node limit is truncation" );
					expect( subgraph.focus ).toBe( "app/A.bx" );
					expect( subgraph.edges.len() ).toBeGTE( 1 );
					expect( subgraph.edges[ 1 ] ).toHaveKey( "from" );
					expect( subgraph.edges[ 1 ] ).toHaveKey( "to" );
					expect( subgraph.returnedNodes ).toBe( subgraph.nodes.len() );
					expect( subgraph.graphNodes ).toBeGTE( subgraph.returnedNodes );

					var edgesEvent = this.get(
							"/api/v1/runs/#runId#/codegraph/edges",
							{ limit: 50 }
						);
					expect( edgesEvent.getResponse() ).toHaveStatus( 200 );
					var edgesBody = jsonDeserialize( edgesEvent.getRenderedContent() ).data;
					expect( edgesBody.edges ).toBeArray();
					expect( edgesBody.edges.len() ).toBeGTE( 1 );
					expect( edgesBody.edges[ 1 ] ).toHaveKey( "from" );
					expect( edgesBody.edges[ 1 ] ).toHaveKey( "kind" );

					var pathsEvent = this.get(
							"/api/v1/runs/#runId#/codegraph/paths",
							{ from: "app/A.bx", to: "app/C.bx", direction: "forward", limit: 3 }
						);
					expect( pathsEvent.getResponse() ).toHaveStatus( 200 );
					var pathsBody = jsonDeserialize( pathsEvent.getRenderedContent() ).data;
					expect( pathsBody.paths ).toBeArray();
					expect( pathsBody.paths[ 1 ].hops ).toHaveLength( 2 );
					expect( pathsBody.paths[ 1 ].hops[ 1 ].evidence ).toBe( "fixture" );

					var forwardMissingEvent = this.get(
						"/api/v1/runs/#runId#/codegraph/paths",
						{ from: "app/C.bx", to: "app/A.bx", direction: "forward" }
					);
					var forwardMissing = jsonDeserialize( forwardMissingEvent.getRenderedContent() ).data;
					expect( forwardMissing.paths ).toBe( [] );
					expect( forwardMissing.truncated ).toBeFalse();
					expect( forwardMissing.reason ).toBe( "unreachable" );

					var reverseEvent = this.get(
						"/api/v1/runs/#runId#/codegraph/paths",
						{ from: "app/C.bx", to: "app/A.bx", direction: "reverse" }
					);
					var reverseBody = jsonDeserialize( reverseEvent.getRenderedContent() ).data;
					expect( reverseBody.paths[ 1 ].hops ).toHaveLength( 2 );

					var queryService = getInstance( "CodeGraphQueryService" );
					queryService.codegraphPathMaxExploredNodes = 1;
					var runServiceForCap = getInstance( "CodeGraphRunService" );
					prepareMock( runServiceForCap ).$property( "codeGraphQueryService", "variables", queryService );
					prepareMock( runServiceForCap ).$property( "codegraphPathMaxExploredNodes", "variables", 1 );
					var cappedEvent = this.get(
						"/api/v1/runs/#runId#/codegraph/paths",
						{ from: "app/A.bx", to: "app/C.bx", direction: "forward" }
					);
					var cappedBody = jsonDeserialize( cappedEvent.getRenderedContent() ).data;
					expect( cappedBody.paths ).toBe( [], "explored-node cap must not return the uncapped path" );
					expect( cappedBody.truncated ).toBeTrue();
					expect( cappedBody.reason ).toBe( "explored-cap" );
					queryService.codegraphPathMaxExploredNodes = 5000;
					prepareMock( runServiceForCap ).$property( "codegraphPathMaxExploredNodes", "variables", 5000 );

					var pathOverLimit = this.get(
						"/api/v1/runs/#runId#/codegraph/paths",
						{ from: "app/A.bx", to: "app/C.bx", limit: 9999 }
					);
					var pathOverStatus = pathOverLimit.getRenderData().statusCode ?: 0;
					if ( !pathOverStatus ) pathOverStatus = pathOverLimit.getResponse().getStatusCode();
					expect( pathOverStatus ).toBe( 422 );

					var sourceEvent = this.get(
							"/api/v1/runs/#runId#/codegraph/source",
							{ path: "app/config/Router.bx", line: 3, before: 0, after: 0 }
						);
					expect( sourceEvent.getResponse() ).toHaveStatus( 200 );
					var sourceBody = jsonDeserialize( sourceEvent.getRenderedContent() ).data;
					expect( sourceBody.available ).toBeTrue();
					expect( sourceBody.path ).toBe( "app/config/Router.bx" );
					expect( sourceBody.focusLine ).toBe( 3 );
					expect( sourceBody.lines ).toHaveLength( 1 );
					expect( sourceBody.lines[ 1 ].focus ).toBeTrue();

					var sourceTraversal = this.get(
							"/api/v1/runs/#runId#/codegraph/source",
							{ path: "../manifest.json", line: 1 }
					);
					var sourceTraversalStatus = sourceTraversal.getRenderData().statusCode ?: 0;
					if ( !sourceTraversalStatus ) sourceTraversalStatus = sourceTraversal.getResponse().getStatusCode();
					expect( sourceTraversalStatus ).toBe( 422 );

					var overLimit = this.get(
							"/api/v1/runs/#runId#/codegraph/subgraph",
							{ focus: "app/A.bx", limit: 9999 }
						);
					var overStatus = overLimit.getRenderData().statusCode ?: 0;
					if ( !overStatus ) overStatus = overLimit.getResponse().getStatusCode();
					expect( overStatus ).toBe( 422 );
					expect( jsonDeserialize( overLimit.getRenderedContent() ).error.code ).toBe( "validation_failed" );

					var missing = this.get(
							"/api/v1/runs/missing-codegraph-id/codegraph/subgraph",
							{ focus: "app/A.bx" }
						);
					var missingStatus = missing.getRenderData().statusCode ?: 0;
					if ( !missingStatus ) missingStatus = missing.getResponse().getStatusCode();
					expect( missingStatus ).toBe( 404 );

					// BaseTestCase reuses rc within a spec; clear the earlier path query's
					// from/to values so this request models a fresh HTTP request.
					var history = this.get(
						"/api/v1/history",
						{ runKind: "codegraph", q: marker, from: "", to: "" }
					);
					expect( history.getResponse() ).toHaveStatus( 200 );
					var historyBody = jsonDeserialize( history.getRenderedContent() );
					expect( historyBody.data ).toHaveLength( 1 );
					expect( historyBody.data[ 1 ].run.runKind ).toBe( "codegraph" );
					expect( historyBody.data[ 1 ].run.planState ).toBe( "" );
					expect( historyBody.data[ 1 ].metrics.modernization ).toBeStruct();
					expect( structCount( historyBody.data[ 1 ].metrics.modernization ) ).toBe( 0 );

					var exportEvent = this.get( "/api/v1/runs/#runId#/export", { exportFormat: "markdown" } );
					var exportStatus = exportEvent.getRenderData().statusCode ?: 0;
					if ( !exportStatus ) exportStatus = exportEvent.getResponse().getStatusCode();
					expect( exportStatus ).toBe( 200 );
					expect( exportEvent.getRenderedContent() ).toInclude( "DoubleCheck CodeGraph" );

					var mermaidEvent = this.get( "/api/v1/runs/#runId#/export", { format: "mermaid", exportFormat: "mermaid" } );
					var mermaidStatus = mermaidEvent.getRenderData().statusCode ?: 0;
					if ( !mermaidStatus ) mermaidStatus = mermaidEvent.getResponse().getStatusCode();
					expect( mermaidStatus ).toBe( 200 );
					expect( mermaidEvent.getRenderedContent() ).toInclude( "flowchart LR" );

					var svgEvent = this.get( "/api/v1/runs/#runId#/export", { format: "svg", exportFormat: "svg" } );
					var svgStatus = svgEvent.getRenderData().statusCode ?: 0;
					if ( !svgStatus ) svgStatus = svgEvent.getResponse().getStatusCode();
					expect( svgStatus ).toBe( 200 );
					expect( svgEvent.getRenderedContent() ).toInclude( "<svg" );

					var codeGraphRunService = getInstance( "CodeGraphRunService" );
					prepareMock( codeGraphRunService ).$property(
							"narrativeService",
							"variables",
							{
								isEnabled: () => true,
								cacheKey : ( snapshot, projectPath ) => "retry-cache-key",
								narrate  : ( snapshot ) => {
									return {
										used       : true,
										enabled    : true,
										pitch      : { text: "Retried pitch" },
										domains    : [],
										processes  : [],
										onboarding : [],
										risk       : [],
										summaries  : []
									};
								}
							}
						);
					var narrateEvent = this.post(
							route   = "/api/v1/runs/#runId#/codegraph/narrative",
							headers = { "Accept": "application/json" }
						);
					expect( narrateEvent.getResponse() ).toHaveStatus( 200 );
					var narrateBody = jsonDeserialize( narrateEvent.getRenderedContent() );
					expect( narrateBody.data.narrative.used ).toBeTrue();
					expect( narrateBody.data.narrative.pitch.text ).toBe( "Retried pitch" );
					var stored = codeGraphRepository.get( runId );
					expect( stored.narrative.used ).toBeTrue();
					expect( stored.narrative.pitch.text ).toBe( "Retried pitch" );

					var projectEntry = this.get( "/api/v1/codegraph", { projectPath: fixtureRoot } );
					expect( projectEntry.getResponse() ).toHaveStatus( 200 );
					var projectBody = jsonDeserialize( projectEntry.getRenderedContent() );
					expect( projectBody.data.projectPath ).toBe( fixtureRoot );
					expect( projectBody.data.run.id ).toBe( runId );

					var labelEvent = this.put(
						route   = "/api/v1/runs/#runId#/codegraph/label",
						headers = { "Content-Type": "application/json", "Accept": "application/json" },
						body    = { clusterId: "c1", label: "Orders module" }
					);
					expect( labelEvent.getResponse() ).toHaveStatus( 200 );
					expect( jsonDeserialize( labelEvent.getRenderedContent() ).data.provenance ).toBe( "user" );
					expect( codeGraphRepository.get( runId ).snapshot.clusters[ 1 ].label ).toBe( "Orders module" );

					var clearLabelEvent = this.delete( "/api/v1/runs/#runId#/codegraph/label", { clusterId: "c1" } );
					expect( clearLabelEvent.getResponse() ).toHaveStatus( 200 );
				} finally {
					queryExecute( "DELETE FROM codegraph_labels WHERE project_path = :projectPath", { projectPath: fixtureRoot } );
					queryExecute( "DELETE FROM codegraph_narrative_shards WHERE project_path = :projectPath", { projectPath: fixtureRoot } );
					queryExecute( "DELETE FROM review_runs WHERE id = :runId", { runId: runId } );
				}
			} );

			it( "serves levelled graph rows and finds symbols the canvas never drew", () => {
				var marker = lCase( createUUID() );
				var runId = "codegraph-levels-#marker#";
				var nowValue = dateTimeFormat( now(), "iso" );
				var fixtureRoot = expandPath( "/tests/../resources/evaluation-corpus/codegraph-v1/cases/order-flow" );
				try {
					getInstance( "ReviewRunRepository" ).create( {
						id          : runId,
						tenantId    : "default",
						projectId   : "default",
						projectPath : fixtureRoot,
						mode        : "full",
						runKind     : "codegraph",
						input       : { version: "codegraph-input-v1" },
						baseRevision: "",
						headRevision: "HEAD",
						status      : "succeeded",
						progress    : 100,
						currentPhase: "completed",
						message     : "CodeGraph levels fixture",
						policy      : { version: "codegraph-input-v1", runKind: "codegraph" },
						budgets     : {},
						createdAt   : nowValue,
						updatedAt   : nowValue
					} );
					// An indexed graph is the precondition every structural endpoint tests.
					var levelsSource = "class {" & char( 10 ) & "function place() {" & char( 10 ) & "orderRepository.save();" & char( 10 ) & "}" & char( 10 ) & "}";
					getInstance( "ArchitectureIndexService" ).index( runId, [ {
						filePath   : "app/OrderService.bx",
						contentHash: lCase( hash( levelsSource & marker, "SHA-256" ) ),
						language   : "BoxLang",
						content    : levelsSource,
						lines      : listToArray( levelsSource, char( 10 ), true, true )
					} ] );

					var projection = getInstance( "CodeGraphProjectionService" ).project(
						{
							clusters    : [ { id: "c1", label: "Orders", filePaths: [ "app/OrderService.bx" ], fileCount: 1 } ],
							directories : [ { path: "app", fileCount: 1, symbolCount: 2 } ],
							nodes       : [ { id: "app/orderservice.bx", path: "app/OrderService.bx", dir: "app", role: "domain", component: "application-models", hotspotScore: 3, fanIn: 1, fanOut: 2 } ],
							clusterEdges: []
						},
						{
							symbols     : [
								{ id: "sym-place", filePath: "app/OrderService.bx", kind: "function", name: "place", line: 2, endLine: 4 }
							],
							dependencies: [
								{ sourceFile: "app/OrderService.bx", targetFile: "app/OrderRepository.bx", kind: "calls", target: "save", line: 3, sourceSymbolId: "sym-place" }
							]
						}
					);
					expect( projection.nodes.len() ).toBeGT( 0 );
					getInstance( "CodeGraphGraphRepository" ).replaceGraph( runId, projection.nodes, projection.edges );

					var clusterLevel = this.get( "/api/v1/runs/#runId#/codegraph/graph", { level: "cluster", limit: 10 } );
					expect( clusterLevel.getResponse() ).toHaveStatus( 200 );
					var clusterBody = jsonDeserialize( clusterLevel.getRenderedContent() );
					expect( clusterBody.data.level ).toBe( "cluster" );
					expect( clusterBody.data.nodes ).notToBeEmpty();
					expect( clusterBody.data.completeness.complete ).toBeTrue();

					// Scoping to a parent is how drill-down works at every level.
					var symbolLevel = this.get(
						"/api/v1/runs/#runId#/codegraph/graph",
						{ level: "symbol", scope: "file:app/orderservice.bx", limit: 10 }
					);
					expect( symbolLevel.getResponse() ).toHaveStatus( 200 );
					var symbolBody = jsonDeserialize( symbolLevel.getRenderedContent() );
					expect( symbolBody.data.nodes ).notToBeEmpty();
					expect( symbolBody.data.nodes[ 1 ].symbolName ).toBe( "place" );

					// A capped level must state the cap, not merely be short.
					var capped = this.get( "/api/v1/runs/#runId#/codegraph/graph", { level: "symbol", limit: 1 } );
					var cappedBody = jsonDeserialize( capped.getRenderedContent() );
					expect( cappedBody.data.completeness.returned ).toBe( 1 );
					expect( cappedBody.data.completeness.rankedBy ).toBe( "hotspot" );

					var found = this.get( "/api/v1/runs/#runId#/codegraph/search", { q: "place" } );
					expect( found.getResponse() ).toHaveStatus( 200 );
					var foundBody = jsonDeserialize( found.getRenderedContent() );
					expect( foundBody.data.matches ).notToBeEmpty();
					expect( foundBody.data.matches[ 1 ].level ).toBe( "symbol" );

					// renderData-set statuses surface on the render data, not the response.
					var missingTerm = this.get( "/api/v1/runs/#runId#/codegraph/search", { q: "" } );
					expect( missingTerm.getRenderData().statusCode ?: 0 ).toBe( 422, "empty q must be rejected" );
					var badLevel = this.get( "/api/v1/runs/#runId#/codegraph/graph", { level: "galaxy" } );
					expect( badLevel.getRenderData().statusCode ?: 0 ).toBe( 422 );
				} finally {
					queryExecute( "DELETE FROM codegraph_node_search WHERE run_id = :runId", { runId: runId } );
					queryExecute( "DELETE FROM codegraph_edges WHERE run_id = :runId", { runId: runId } );
					queryExecute( "DELETE FROM codegraph_nodes WHERE run_id = :runId", { runId: runId } );
					queryExecute( "DELETE FROM review_runs WHERE id = :runId", { runId: runId } );
				}
			} );

			it( "still finds nodes when the search index does not cover the run", () => {
				// A run indexed before the FTS mirror existed has nodes and no mirrored
				// rows. Narrowing to zero index hits made every such run answer "nothing
				// matches" — the defect the LIKE backstop was supposed to make
				// impossible. The index may only ever change how many rows are examined.
				var marker = lCase( createUUID() );
				var runId = "codegraph-unmirrored-#marker#";
				var nowValue = dateTimeFormat( now(), "iso" );
				var fixtureRoot = expandPath( "/tests/../resources/evaluation-corpus/codegraph-v1/cases/order-flow" );
				try {
					getInstance( "ReviewRunRepository" ).create( {
						id          : runId,
						tenantId    : "default",
						projectId   : "default",
						projectPath : fixtureRoot,
						mode        : "full",
						runKind     : "codegraph",
						input       : { version: "codegraph-input-v1" },
						baseRevision: "",
						headRevision: "HEAD",
						status      : "succeeded",
						progress    : 100,
						currentPhase: "completed",
						message     : "CodeGraph unmirrored search fixture",
						policy      : { version: "codegraph-input-v1", runKind: "codegraph" },
						budgets     : {},
						createdAt   : nowValue,
						updatedAt   : nowValue
					} );
					// `hasIndexedGraph` gates every structural endpoint, so the review
					// graph has to exist before the levelled rows are worth writing.
					var seedSource = "class {" & char( 10 ) & "function place() {" & char( 10 ) & "orderRepository.save();" & char( 10 ) & "}" & char( 10 ) & "}";
					getInstance( "ArchitectureIndexService" ).index( runId, [ {
						filePath   : "app/OrderService.bx",
						contentHash: lCase( hash( seedSource & marker, "SHA-256" ) ),
						language   : "BoxLang",
						content    : seedSource,
						lines      : listToArray( seedSource, char( 10 ), true, true )
					} ] );
					getInstance( "CodeGraphGraphRepository" ).replaceGraph(
						runId,
						[
							{
								id      : "file:app/OrderService.bx",
								level   : "file",
								parentId: "",
								path    : "app/OrderService.bx",
								symbolName: "",
								kind    : "application-models",
								role    : "domain",
								language: "BoxLang",
								line    : 0,
								endLine : 0,
								fanIn   : 1,
								fanOut  : 0,
								hotspot : 3
							}
						],
						[]
					);

					var mirrored = queryExecute(
						"SELECT COUNT(*) AS total FROM codegraph_node_search WHERE run_id = :runId",
						{ runId: runId }
					);
					expect( val( mirrored.total[ 1 ] ?: 0 ) ).toBeGT( 0, "replaceGraph must mirror rows for a fresh run" );

					// Reproduce a pre-mirror run exactly: nodes present, index empty.
					queryExecute( "DELETE FROM codegraph_node_search WHERE run_id = :runId", { runId: runId } );

					// `orderservice` is a mid-identifier term, so it exercises the trigram
					// path rather than a prefix the default tokenizer would also serve.
					var found = this.get( "/api/v1/runs/#runId#/codegraph/search", { q: "orderservice" } );
					expect( found.getResponse() ).toHaveStatus( 200 );
					var body = jsonDeserialize( found.getRenderedContent() );
					expect( body.data.matches ).notToBeEmpty( "an uncovered index must fall back to the scan, not answer empty" );
					expect( body.data.completeness.available ).toBe( 1 );
					expect( body.data.completeness.state ).toBe( "complete" );

					// A term genuinely absent still answers empty, so the fallback did not
					// simply disable the predicate.
					var absent = this.get( "/api/v1/runs/#runId#/codegraph/search", { q: "zzzabsentzzz" } );
					var absentBody = jsonDeserialize( absent.getRenderedContent() );
					expect( absentBody.data.matches ).toBeEmpty();
					expect( absentBody.data.completeness.state ).toBe( "empty" );
				} finally {
					queryExecute( "DELETE FROM codegraph_node_search WHERE run_id = :runId", { runId: runId } );
					queryExecute( "DELETE FROM codegraph_edges WHERE run_id = :runId", { runId: runId } );
					queryExecute( "DELETE FROM codegraph_nodes WHERE run_id = :runId", { runId: runId } );
					queryExecute( "DELETE FROM review_runs WHERE id = :runId", { runId: runId } );
				}
			} );

			it( "reports a snapshot that predates levelled storage instead of returning an empty graph", () => {
				var marker = lCase( createUUID() );
				var runId = "codegraph-nolevels-#marker#";
				var nowValue = dateTimeFormat( now(), "iso" );
				var fixtureRoot = expandPath( "/tests/../resources/evaluation-corpus/codegraph-v1/cases/order-flow" );
				try {
					getInstance( "ReviewRunRepository" ).create( {
						id          : runId,
						tenantId    : "default",
						projectId   : "default",
						projectPath : fixtureRoot,
						mode        : "full",
						runKind     : "codegraph",
						input       : { version: "codegraph-input-v1" },
						baseRevision: "",
						headRevision: "HEAD",
						status      : "succeeded",
						progress    : 100,
						currentPhase: "completed",
						message     : "CodeGraph legacy snapshot fixture",
						policy      : { version: "codegraph-input-v1", runKind: "codegraph" },
						budgets     : {},
						createdAt   : nowValue,
						updatedAt   : nowValue
					} );
					var legacySource = "class {" & char( 10 ) & "function run() {}" & char( 10 ) & "}";
					getInstance( "ArchitectureIndexService" ).index( runId, [ {
						filePath   : "app/Legacy.bx",
						contentHash: lCase( hash( legacySource & marker, "SHA-256" ) ),
						language   : "BoxLang",
						content    : legacySource,
						lines      : listToArray( legacySource, char( 10 ), true, true )
					} ] );
					var event = this.get( "/api/v1/runs/#runId#/codegraph/graph", { level: "file" } );
					expect( event.getRenderData().statusCode ?: 0 ).toBe( 409 );
					var body = jsonDeserialize( event.getRenderedContent() );
					expect( body.error.code ).toBe( "snapshot_predates_node_tables" );
				} finally {
					queryExecute( "DELETE FROM review_runs WHERE id = :runId", { runId: runId } );
				}
			} );

			it( "advertises codegraph in capabilities", () => {
				var event = this.get( "/api/v1/capabilities" );
				expect( event.getResponse() ).toHaveStatus( 200 );
				var body = jsonDeserialize( event.getRenderedContent() );
				expect( body.data.runKinds ).toInclude( "review" );
				expect( body.data.runKinds ).toInclude( "modernize" );
				expect( body.data.runKinds ).toInclude( "codegraph" );
				expect( body.data.codegraph.enabled ).toBeTrue();
				expect( body.data.codegraph.requiresLlm ).toBeFalse();
				expect( body.data.codegraph.meaningRequiresLlm ).toBeTrue();
				expect( body.data.codegraph.schemaVersion ).toBe( "codegraph-snapshot-v2" );
				expect( body.data.codegraph.narrativeVersion ).toBe( "codegraph-narrative-v2" );
			} );

			it( "allows structural drill-down for an indexed Review run but keeps narrative CodeGraph-only", () => {
				var marker = lCase( createUUID() );
				var runId = "review-graph-api-#marker#";
				var nowValue = dateTimeFormat( now(), "iso" );
				var fixtureRoot = expandPath( "/tests/../resources/evaluation-corpus/codegraph-v1/cases/order-flow" );
				try {
					getInstance( "ReviewRunRepository" ).create( {
						id: runId,
						tenantId: "default",
						projectId: "default",
						projectPath: fixtureRoot,
						mode: "full",
						runKind: "review",
						input: {},
						baseRevision: "",
						headRevision: "HEAD",
						status: "succeeded",
						progress: 100,
						currentPhase: "completed",
						message: "Indexed Review fixture",
						policy: {},
						budgets: {},
						createdAt: nowValue,
						updatedAt: nowValue
					} );
					getInstance( "AnalysisGraphRepository" ).replaceRunGraph(
						runId,
						[
							{
								filePath: "app/A.bx",
								contentHash: "review-a",
								parserVersion: "test-v1",
								symbols: [ { id: "review-a-symbol", kind: "class", name: "A", line: 1, evidence: "class A" } ],
								dependencies: [ { id: "review-dep", kind: "constructs", target: "B", targetFile: "app/B.bx", line: 2, evidence: "new B()" } ]
							},
							{
								filePath: "app/B.bx",
								contentHash: "review-b",
								parserVersion: "test-v1",
								symbols: [ { id: "review-b-symbol", kind: "class", name: "B", line: 1, evidence: "class B" } ],
								dependencies: []
							}
						],
						[],
						{ parserVersion: "test-v1", filesAnalyzed: 2, parserExecutions: 2, cacheHits: 0, symbolCount: 2, dependencyCount: 1, impactCount: 0, baselineRunId: "" }
					);

					var subgraph = this.get( "/api/v1/runs/#runId#/codegraph/subgraph", { focus: "app/A.bx" } );
					expect( subgraph.getResponse() ).toHaveStatus( 200 );
					var subgraphBody = jsonDeserialize( subgraph.getRenderedContent() ).data;
					expect( subgraphBody.edges ).toHaveLength( 1, jsonSerialize( subgraphBody ) );
					var edges = this.get( "/api/v1/runs/#runId#/codegraph/edges" );
					expect( edges.getResponse() ).toHaveStatus( 200 );
					expect( jsonDeserialize( edges.getRenderedContent() ).data.edges ).toHaveLength( 1 );
					var narrative = this.post( "/api/v1/runs/#runId#/codegraph/narrative" );
					var narrativeStatus = narrative.getRenderData().statusCode ?: 0;
					if ( !narrativeStatus ) narrativeStatus = narrative.getResponse().getStatusCode();
					expect( narrativeStatus ).toBe( 404 );
				} finally {
					queryExecute( "DELETE FROM review_runs WHERE id = :runId", { runId: runId } );
				}
			} );
		} );
	}

}
