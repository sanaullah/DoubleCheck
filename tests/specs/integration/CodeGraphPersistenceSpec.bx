class extends="coldbox.system.testing.BaseTestCase" appMapping="/app" {

	function run() {
		describe( "CodeGraph persistence", () => {
			beforeEach( () => setup() );

			it( "creates codegraph_snapshots table and indexes, and orphan repair keeps FK check clean", () => {
				var tables = queryExecute(
					"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'codegraph_snapshots'"
				);
				expect( tables.recordCount ).toBe( 1 );

				var indexes = queryExecute(
					"
						SELECT name FROM sqlite_master
						WHERE type = 'index'
							AND name IN (
								'idx_codegraph_snapshots_narrative_reuse',
								'idx_codegraph_snapshots_fingerprint'
							)
					"
				);
				expect( indexes.recordCount ).toBe( 2 );

				var schemaService = getInstance( "SchemaService" );
				schemaService.ensureSchema();
				var fkIssues = queryExecute( "PRAGMA foreign_key_check" );
				expect( fkIssues.recordCount ).toBe( 0 );
			} );

			it( "saves and reads a snapshot round-trip and cascades on run delete", () => {
				var runId = lCase( createUUID() );
				var nowValue = dateTimeFormat( now(), "iso" );
				var runRepository = getInstance( "ReviewRunRepository" );
				var codeGraphRepository = getInstance( "CodeGraphRepository" );
				var snapshot = {
					version           : "codegraph-snapshot-v1",
					fingerprint       : "fp-test-1",
					truncated         : false,
					truncationReasons : [],
					totals            : {
						files            : 2,
						symbols          : 3,
						dependencies     : 1,
						nodes            : 2,
						edges            : 1,
						clusters         : 1,
						cycles           : 0,
						orphans          : 0,
						layerViolations  : 0
					},
					nodes        : [ { id: "a", path: "app/models/A.bx" }, { id: "b", path: "app/handlers/B.bx" } ],
					clusters     : [ { id: "c1", label: "models", fileCount: 1 } ],
					clusterEdges : [],
					cycles       : [],
					hotspots     : [],
					orphans      : [],
					layerViolations: []
				};
				try {
					runRepository.create( {
						id           : runId,
						tenantId     : "default",
						projectId    : "default",
						projectPath  : "C:/codegraph-fixture",
						mode         : "full",
						runKind      : "codegraph",
						input        : { version: "codegraph-input-v1" },
						baseRevision : "",
						headRevision : "HEAD",
						status       : "queued",
						progress     : 0,
						currentPhase : "queued",
						message      : "CodeGraph persistence fixture",
						policy       : { version: "codegraph-input-v1", runKind: "codegraph" },
						budgets      : {},
						createdAt    : nowValue,
						updatedAt    : nowValue
					} );

					codeGraphRepository.save(
						runId               = runId,
						snapshot            = snapshot,
						projectPath         = "C:/codegraph-fixture",
						repositoryRevision  = "abc123",
						narrativeCacheKey   = "narrative-key-1",
						narrative           = { used: true, summaries: [ { clusterId: "c1", text: "Models layer" } ] }
					);

					var loaded = codeGraphRepository.get( runId );
					expect( isNull( loaded ) ).toBeFalse();
					expect( loaded.version ).toBe( "codegraph-snapshot-v1" );
					expect( loaded.fingerprint ).toBe( "fp-test-1" );
					expect( loaded.snapshot.totals.nodes ).toBe( 2 );
					expect( loaded.snapshot.nodes[ 1 ].path ).toBe( "app/models/A.bx" );
					expect( loaded.narrative.used ).toBeTrue();
					expect( loaded.narrative.summaries[ 1 ].clusterId ).toBe( "c1" );
					expect( loaded.narrativeCacheKey ).toBe( "narrative-key-1" );
					expect( loaded.repositoryRevision ).toBe( "abc123" );
				} finally {
					queryExecute( "DELETE FROM review_runs WHERE id = :runId", { runId: runId } );
				}
				expect( isNull( codeGraphRepository.get( runId ) ) ).toBeTrue();
			} );

			it( "retains orientation edges when a dependency read is capped", () => {
				var runId = lCase( createUUID() );
				var nowValue = dateTimeFormat( now(), "iso" );
				var runRepository = getInstance( "ReviewRunRepository" );
				var graphRepository = getInstance( "AnalysisGraphRepository" );
				try {
					runRepository.create( {
						id: runId, tenantId: "default", projectId: "default", projectPath: "C:/codegraph-cap",
						mode: "full", runKind: "codegraph", input: {}, baseRevision: "", headRevision: "HEAD",
						status: "succeeded", progress: 100, currentPhase: "completed", message: "ok",
						policy: { runKind: "codegraph" }, budgets: {}, createdAt: nowValue, updatedAt: nowValue
					} );
					graphRepository.replaceRunGraph(
						runId,
						[
							{
								filePath: "a/Generic.bx", contentHash: "hash-a", parserVersion: "test-v1", symbols: [],
								dependencies: [
									{ id: lCase( createUUID() ), kind: "calls", target: "one", targetFile: "b/One.bx", line: 1, endLine: 1, evidence: "generic one" },
									{ id: lCase( createUUID() ), kind: "calls", target: "two", targetFile: "b/Two.bx", line: 2, endLine: 2, evidence: "generic two" }
								]
							},
							{
								filePath: "z/Client.js", contentHash: "hash-z", parserVersion: "test-v1", symbols: [],
								dependencies: [
									{ id: lCase( createUUID() ), kind: "calls-api", target: "/api/v1/orders", targetFile: "app/config/Router.bx", line: 10, endLine: 10, evidence: "request orders" },
									{ id: lCase( createUUID() ), kind: "routes", target: "/api/v1/orders", targetFile: "app/handlers/Orders.bx", line: 20, endLine: 20, evidence: "orders route" }
								]
							}
						],
						[
							{ id: lCase( createUUID() ), changedFile: "a/Generic.bx", changedSymbol: "one", impactedFile: "b/One.bx", reason: "calls", depth: 1, viaFile: "a/Generic.bx" }
						],
						{ parserVersion: "test-v1", filesAnalyzed: 2, parserExecutions: 2, cacheHits: 0, symbolCount: 0, dependencyCount: 4, impactCount: 1, baselineRunId: "" }
					);
					var defaultGraph = graphRepository.getGraph( runId );
					expect( defaultGraph.impacts ).toHaveLength( 1 );

					var graph = graphRepository.getGraph(
						runId = runId,
						symbolLimit = 10,
						dependencyLimit = 2,
						impactLimit = 10
					);
					expect( graph.dependencies.map( ( edge ) => edge.kind ) ).toBe( [ "calls-api", "routes" ] );
					expect( graph.truncationReasons ).toInclude( "graphDependencies" );
				} finally {
					queryExecute( "DELETE FROM review_runs WHERE id = :runId", { runId: runId } );
				}
			} );

			it( "carries levelled rows through graph adoption so a reused run can still be explored", () => {
				// D1: adoption copied review_* only, so every reused run answered 409
				// "snapshot predates levelled storage" and searched to nothing.
				var graphs = getInstance( "AnalysisGraphRepository" );
				var source = "adopt-source-" & createUUID();
				var target = "adopt-target-" & createUUID();
				for ( var runId in [ source, target ] ) {
					queryExecute(
						"INSERT INTO review_runs ( id, project_path, status, run_kind, mode, created_at, updated_at ) VALUES ( :id, '/tmp/p', 'succeeded', 'codegraph', 'full', :now, :now )",
						{ id: runId, now: dateTimeFormat( now(), "iso" ) }
					);
				}
				getInstance( "CodeGraphGraphRepository" ).replaceGraph(
					source,
					[ { id: "file:a.bx", level: "file", parentId: "", path: "a.bx", symbolName: "", kind: "file", role: "", language: "BoxLang", line: 0, endLine: 0, fanIn: 1, fanOut: 0, hotspot: 2 } ],
					[ { id: "file-1", level: "file", from: "file:a.bx", to: "file:a.bx", groupKind: "calls", kinds: [ "calls" ], occurrences: 1, weight: 1, resolution: "path", line: 3, evidence: "x()" } ]
				);

				graphs.adoptRunGraph( source, target );

				var nodes = queryExecute( "SELECT COUNT(*) AS n FROM codegraph_nodes WHERE run_id = :id", { id: target } );
				expect( nodes.n[ 1 ] ).toBe( 1, "adopted run must carry node rows" );
				expect( getInstance( "CodeGraphGraphRepository" ).hasGraph( target ) ).toBeTrue();
				queryExecute( "DELETE FROM review_runs WHERE id IN ( :a, :b )", { a: source, b: target } );
			} );

			it( "reports an unreadable snapshot instead of throwing out of the read path", () => {
				// D30: an unguarded jsonDeserialize surfaced as "run not found".
				var runId = "corrupt-" & createUUID();
				queryExecute(
					"INSERT INTO review_runs ( id, project_path, status, run_kind, mode, created_at, updated_at ) VALUES ( :id, '/tmp/p', 'succeeded', 'codegraph', 'full', :now, :now )",
					{ id: runId, now: dateTimeFormat( now(), "iso" ) }
				);
				queryExecute(
					"INSERT INTO codegraph_snapshots ( run_id, snapshot_version, project_path, fingerprint, node_count, edge_count, cluster_count, cycle_count, truncated, truncation_reasons_json, snapshot_json, created_at ) VALUES ( :id, 'v', '/tmp/p', 'f', 0, 0, 0, 0, 0, '[]', :bad, :now )",
					{ id: runId, bad: "{ this is not json", now: dateTimeFormat( now(), "iso" ) }
				);

				var stored = getInstance( "CodeGraphRepository" ).get( runId );

				expect( isNull( stored ) ).toBeFalse( "a corrupt snapshot must not read as a missing run" );
				expect( stored.unreadable ?: false ).toBeTrue();
				queryExecute( "DELETE FROM review_runs WHERE id = :id", { id: runId } );
			} );

			it( "reuses narrative by project path, revision, and cache key", () => {
				var runIdA = lCase( createUUID() );
				var runIdB = lCase( createUUID() );
				var nowValue = dateTimeFormat( now(), "iso" );
				var runRepository = getInstance( "ReviewRunRepository" );
				var codeGraphRepository = getInstance( "CodeGraphRepository" );
				var snapshot = {
					version           : "codegraph-snapshot-v1",
					fingerprint       : "fp-reuse",
					truncated         : false,
					truncationReasons : [],
					totals            : { nodes: 1, edges: 0, clusters: 1, cycles: 0 },
					nodes             : [ { id: "n1", path: "app/Main.bx" } ],
					clusters          : [ { id: "c1", label: "app" } ],
					clusterEdges      : [],
					cycles            : [],
					hotspots          : [],
					orphans           : [],
					layerViolations   : []
				};
				try {
					for ( var runId in [ runIdA, runIdB ] ) {
						runRepository.create( {
							id           : runId,
							tenantId     : "default",
							projectId    : "default",
							projectPath  : "C:/codegraph-reuse",
							mode         : "full",
							runKind      : "codegraph",
							input        : {},
							baseRevision : "",
							headRevision : "HEAD",
							status       : "succeeded",
							progress     : 100,
							currentPhase : "completed",
							message      : "ok",
							policy       : { runKind: "codegraph" },
							budgets      : {},
							createdAt    : nowValue,
							updatedAt    : nowValue
						} );
					}
					codeGraphRepository.save(
						runId              = runIdA,
						snapshot           = snapshot,
						projectPath        = "C:/codegraph-reuse",
						repositoryRevision = "rev-9",
						narrativeCacheKey  = "nk-shared",
						narrative          = { used: true, summaries: [ { clusterId: "c1", text: "reusable" } ] }
					);
					var reused = codeGraphRepository.findReusableNarrative(
						"C:/codegraph-reuse",
						"rev-9",
						"nk-shared"
					);
					expect( isNull( reused ) ).toBeFalse();
					expect( reused.used ).toBeTrue();
					expect( reused.summaries[ 1 ].text ).toBe( "reusable" );

					expect( isNull( codeGraphRepository.findReusableNarrative( "C:/codegraph-reuse", "rev-9", "missing" ) ) ).toBeTrue();
					expect( isNull( codeGraphRepository.findReusableNarrative( "", "rev-9", "nk-shared" ) ) ).toBeTrue();
				} finally {
					queryExecute( "DELETE FROM review_runs WHERE id IN ( :a, :b )", { a: runIdA, b: runIdB } );
				}
			} );

			it( "excludes pending structure then reuses the same finalized cancelled row", () => {
				var runId = lCase( createUUID() );
				var projectPath = "C:/codegraph-phase-one-" & runId;
				var nowValue = dateTimeFormat( now(), "iso" );
				var runRepository = getInstance( "ReviewRunRepository" );
				var codeGraphRepository = getInstance( "CodeGraphRepository" );
				var snapshot = {
					version: "codegraph-snapshot-v1",
					fingerprint: "phase-one-fingerprint",
					truncated: false,
					truncationReasons: [],
					totals: { nodes: 1, edges: 0, clusters: 1, cycles: 0 },
					nodes: [ { id: "app/main.bx", path: "app/Main.bx" } ],
					clusters: [ { id: "cluster-app", label: "app", filePaths: [ "app/Main.bx" ] } ],
					clusterEdges: [], cycles: [], flows: [], hotspots: [], orphans: [], layerViolations: []
				};
				try {
					runRepository.create( {
						id: runId, tenantId: "default", projectId: "default", projectPath: projectPath,
						mode: "full", runKind: "codegraph", input: {}, baseRevision: "", headRevision: "HEAD",
						status: "running", progress: 60, currentPhase: "codegraph-clusters", message: "structure saved",
						policy: { runKind: "codegraph" }, budgets: {}, createdAt: nowValue, updatedAt: nowValue
					} );
					codeGraphRepository.save(
						runId = runId, snapshot = snapshot, projectPath = projectPath,
						repositoryRevision = "rev-phase-one", narrative = { used: false, pending: true },
						snapshotReuseKey = "reuse-phase-one"
					);

					expect( isNull( codeGraphRepository.findReusableSnapshot( projectPath, "rev-phase-one", "reuse-phase-one" ) ) ).toBeTrue();

					codeGraphRepository.updateNarrative( runId, { used: false, pending: false, error: "cancelled" }, "", snapshot );
					runRepository.updateState(
						id = runId,
						status = "cancelled",
						progress = 60,
						currentPhase = "cancelled",
						message = "cancelled after structure",
						completedAt = nowValue
					);
					var reusable = codeGraphRepository.findReusableSnapshot( projectPath, "rev-phase-one", "reuse-phase-one" );
					expect( isNull( reusable ) ).toBeFalse();
					expect( reusable.fingerprint ).toBe( "phase-one-fingerprint" );
					expect( reusable.narrative.pending ).toBeFalse();
					var rows = queryExecute( "SELECT COUNT(*) AS total FROM codegraph_snapshots WHERE run_id = :runId", { runId: runId } );
					expect( rows.total[ 1 ] ).toBe( 1 );
				} finally {
					queryExecute( "DELETE FROM review_runs WHERE id = :runId", { runId: runId } );
				}
			} );
		} );
	}

}
