class extends   ="coldbox.system.testing.BaseTestCase" appMapping="/app" {

	function beforeAll() {
		super.beforeAll();
	}

	function afterAll() {
		prepareMock( getInstance( "ReviewRunService" ) ).$property(
				"workerEnabled",
				"variables",
				true
			);
		super.afterAll();
	}

	function run();
	{
		describe(
			"Review API",
			() => {
				beforeEach(
					() => {
						setup();
						prepareMock( getInstance( "ReviewRunService" ) ).$property(
								"workerEnabled",
								"variables",
								false
							);
					}
				);

				it(
					"reports SQLite health",
					() => {
						var event = this.get( "/api/v1/health" );
						expect( event.getResponse() ).toHaveStatus( 200 );
						var body = jsonDeserialize( event.getRenderedContent() );
						expect( body.data.status ).toBe( "ok" );
						expect( body
								.data
								.checks
								.database
								.status ).toBe( "up" );
					}
				);

				it(
					"publishes specialist and persistence capabilities",
					() => {
						var event = this.get( "/api/v1/capabilities" );
						expect( event.getResponse() ).toHaveStatus( 200 );
						var body = jsonDeserialize( event.getRenderedContent() );
						expect( body.data.persistence ).toBe( "sqlite" );
						expect( body
								.data
								.streaming
								.transport ).toBe( "sse" );
						expect( body.data.mode ).toBe( "local" );
						expect( body
								.data
								.localControls
								.workers ).toBe( "sqlite-lease-token-v1" );
						expect( body.data.aiExecution ).toBeStruct();
						expect( body
								.data
								.review
								.evidenceValidation ).toBeTrue();
						expect( body
								.data
								.review
								.syntaxParsing ).toBeTrue();
						expect( body
								.data
								.review
								.dependencyGraph ).toBeTrue();
						expect( body
								.data
								.review
								.resolvedTestImpact ).toBeTrue();
						expect( body
								.data
								.review
								.changedSymbolImpact ).toBe( "bounded-reverse-file-cone-v1" );
						expect( body
								.data
								.review
								.deterministicAIContract ).toBeTrue();
						expect( body
								.data
								.review
								.seededEvaluationCorpus ).toBe( "boxlang-review-corpus-v1" );
						expect( body
								.data
								.review
								.architectureModel ).toBe( "deterministic-evidence-v1" );
						expect( body
								.data
								.review
								.architectureEnrichment ).toBe( "validated-fact-citations-v1" );
						expect( body
								.data
								.review
								.architectureModelReuse ).toBe( "project-revision-input-fingerprint-v1" );
						expect( body
								.data
								.review
								.architectureDiff ).toBe( "fact-identity-v1" );
						expect( body
								.data
								.review
								.reviewPlanner ).toBe( "bounded-role-plan-v2" );
						expect( body
								.data
								.review
								.contextPacks ).toBe( "symbol-range-artifact-refs-v2" );
						expect( body
								.data
								.review
								.reviewPolicy ).toBe( "immutable-allowlisted-roles-v1" );
						expect( body
								.data
								.review
								.runBudgets ).toBe( "immutable-task-token-time-iteration-output-cost-v2" );
						expect( body
								.data
								.review
								.contentAddressedReuse ).toBeTrue();
						expect( body
								.data
								.review
								.historicalBlobReads ).toBeTrue();
						expect( body
								.data
								.review
								.specialistAgents ).toBe( "native-bx-ai-role-factory-v2" );
						expect( body
								.data
								.review
								.specialistCfmlDepth ).toBe( "cfml-conventions-llm-v1" );
						expect( body
								.data
								.review
								.controlledReadTools ).toBe( "indexed-artifact-range-budget-v2" );
						expect( body
								.data
								.review
								.specialistResults ).toBe( "durable-partial-artifact-reference-v2" );
						expect( body
								.data
								.review
								.specialistConcurrency ).toBe( "fixed-per-provider-executor-v1" );
						expect( body
								.data
								.review
								.specialistResilience ).toBe( "deadline-retry-circuit-cancel-v1" );
						expect( body
								.data
								.review
								.specialistStreaming ).toBe( "coalesced-metadata-sse-v1" );
						expect;
						(
							body
								.data
								.languages
								.map
						);
						( ( item ) -> item.name; );
					}
				).toBe( [ "BoxLang", "CFML", "JavaScript", "Java"] );
				expect;
				(
					body
						.data
						.languages
						.filter
				);
				( ( item ) -> item.name != "BoxLang"; ).every;
				( ( item ) -> item.tier == "discovery-only" && !item.measured; );
			}
		).toBeTrue();
		expect( body.data.languages[ 1 ].tier ).toBe( "parsed-dependency-aware" );
		expect( body.data.languages[ 1 ].measured ).toBeTrue();
		expect( body.data.runModes ).toInclude( "revision-diff" );
	}
}