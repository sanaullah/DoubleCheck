class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "Modernization pipeline boundary", () => {
			it( "fails before any provider call when the scan has no CFML scope", () => {
				var service = new app.models.services.ModernizationRunService();
				service.inventoryService = { build: ( scan ) => {
					return { noModernizationScope: true, files: [], units: [], dependencies: [], routeEvidence: [], unresolved: [], fingerprint: "empty" };
				} };
			service.modernizationRepository = {
				getCheckpoints: ( runId ) => [],
				getSchemaPack: ( runId ) => javacast( "null", "" ),
				saveCheckpoint: ( runId, stage, payload ) => payload
			};
			var run = new tests.resources.ScriptedModernizationRun( runId = "empty-scope", projectPath = "C:/fixture" );
			var result = service.execute(
				run,
				{ files: [], repositoryRevision: "empty", skipped: {}, discoveryTruncated: false },
				{ checkCancellation: () => false }
			);
			expect( result.status ).toBe( "failed" );
			expect( result.message ).toInclude( "No CFML modernization scope" );
			expect( result.errors ).notToBeEmpty();
		} );
	} );
}
}
