class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "ModernizationSkillService", () => {
			var service = "";
			beforeEach( () => {
				service = new app.models.services.ModernizationSkillService();
			} );

			it( "returns an allowlisted boxlang application pack with excerpts when skills exist", () => {
				var pack = service.listPack( "boxlang", "modern", "modernization-application" );
				expect( pack.len() ).toBeGT( 0 );
				var names = pack.map( ( item ) => item.name );
				expect( names ).toInclude( "coldbox-handler-development" );
				expect( names ).notToInclude( "boxlang-runtime-docker" );
				expect( len( pack[ 1 ].excerpt ?: "" ) ).toBeGT( 0 );
			} );

			it( "omits boxlang-only skills for lucee packs", () => {
				var pack = service.listPack( "lucee", "flat", "modernization-application" );
				var names = pack.map( ( item ) => item.name );
				expect( names ).notToInclude( "boxlang-language-fundamentals" );
			} );

			it( "rejects non-allowlisted skill reads", () => {
				expect( () => service.readSkill( "../secrets" ) ).toThrow( type = "ValidationException" );
				expect( () => service.readSkill( "not-a-real-skill" ) ).toThrow( type = "ValidationException" );
			} );
		} );
	}
}
