/**
 * Regression cover for the modernization accuracy/actionability repairs.
 *
 * Each spec pins one defect found by tracing a real CFTunes modernize run whose
 * plan looked populated (170 units, 12 phases) but was ungrounded, disconnected,
 * and reported as clean.
 */
class extends="testbox.system.BaseSpec" {

	function newService() {
		var service = new app.models.services.ModernizationProposalService();
		service.agentFactory = new app.models.services.ModernizationAgentFactory();
		service.secretRedactionService = new app.models.services.SecretRedactionService();
		service.identityService = new app.models.services.ModernizationIdentityService();
		return service;
	}

	function run() {
		describe( "Modernization proposal repairs", () => {

			it( "shards only paths whose source text reached a context partition", () => {
				var service = newService();
				makePublic( service, "buildApplicationShards" );
				var evidence = {
					inventory: { units: [], files: [
						{ filePath: "Library/album.cfm" },
						{ filePath: "Library/artist.cfm" },
						{ filePath: "guitar/upload.cfm" }
					] },
					// Only two of the three files survived the context budget.
					context: { partitions: [
						{ filePath: "Library/album.cfm", text: "1| <cfoutput>album</cfoutput>" },
						{ filePath: "Library/artist.cfm", text: "1| <cfoutput>artist</cfoutput>" }
					] }
				};
				var shards = service.buildApplicationShards( evidence, { applicationShardSize: 6 } );
				var covered = {};
				for ( var shard in shards ) {
					for ( var path in ( shard.shardMeta.paths ?: [] ) ) covered[ lCase( path ) ] = true;
				}
				expect( covered ).toHaveKey( "library/album.cfm" );
				expect( covered ).toHaveKey( "library/artist.cfm" );
				// Mapping a file the model cannot read invents a confident answer.
				expect( covered ).notToHaveKey( "guitar/upload.cfm" );
			} );

			it( "shards every inventory path when no context partitions exist at all", () => {
				var service = newService();
				makePublic( service, "buildApplicationShards" );
				var shards = service.buildApplicationShards(
					{ inventory: { units: [], files: [ { filePath: "a.cfm" }, { filePath: "b.cfm" } ] } },
					{ applicationShardSize: 6 }
				);
				var covered = {};
				for ( var shard in shards ) {
					for ( var path in ( shard.shardMeta.paths ?: [] ) ) covered[ lCase( path ) ] = true;
				}
				expect( covered.count() ).toBe( 2 );
			} );



			it( "drops a route whose only derivable path escapes the application root", () => {
				var service = newService();
				// safeRoutePathFrom moved to ModernizationArtifactService (Step 11).
				service = new app.models.services.ModernizationArtifactService();
				expect( service.safeRoutePathFrom( "../../.." ) ).toBe( "" );
				expect( service.safeRoutePathFrom( "" ) ).toBe( "" );
				expect( service.safeRoutePathFrom( "admin\manageUsers.cfm" ) ).toBe( "/admin/manageUsers.cfm" );
				expect( service.safeRoutePathFrom( "./playlist/../Library/song.cfm" ) ).toBe( "/Library/song.cfm" );
			} );




			it( "wraps provider up/down statements into a cfmigrations component", () => {
				var service = newService();
				// normalizeDbTransitions moved to ModernizationArtifactService (Step 11).
				service = new app.models.services.ModernizationArtifactService();
				var transitions = service.normalizeDbTransitions( [ {
					id: "t-1",
					operation: "expand",
					objectsTouched: [ "album" ],
					sampleMigration: {
						up: "schema.create('album', function(table){ table.increments('id'); });",
						down: "schema.drop('album');"
					}
				} ] );

				expect( transitions[ 1 ] ).toHaveKey( "migrationCode" );
				expect( reFindNoCase( "function\s+up\s*\(", transitions[ 1 ].migrationCode ) ).toBeGT( 0 );
				expect( reFindNoCase( "function\s+down\s*\(", transitions[ 1 ].migrationCode ) ).toBeGT( 0 );
				// The provider's own statements survive the wrapping.
				expect( transitions[ 1 ].migrationCode ).toInclude( "schema.create" );
				expect( transitions[ 1 ].migrationCode ).toInclude( "schema.drop" );
				expect( transitions[ 1 ].migrationCodeProvenance ).toBe( "wrapped-provider-statements" );
			} );

			it( "synthesizes a cfmigrations path when the provider supplies junk", () => {
				var service = newService();
				// normalizeDbTransitions moved to ModernizationArtifactService (Step 11).
				service = new app.models.services.ModernizationArtifactService();
				// Observed provider output: the operation name in the path field,
				// and a bare directory with no filename.
				var transitions = service.normalizeDbTransitions( [
					{ id: "t-a", operation: "expand", order: 1, objectsTouched: [ "album" ], migrationPath: "expand" },
					{ id: "t-b", operation: "expand", order: 2, objectsTouched: [ "artist" ], migrationPath: "resources/database/migrations/" }
				] );

				for ( var t in transitions ) {
					expect( reFind( "[0-9]{4}_[0-9]{2}_[0-9]{2}_[0-9]{6}.*\.bx$", t.migrationPath ) ).toBeGT(
						0, "expected a cfmigrations timestamp, got #t.migrationPath#"
					);
					expect( t.migrationPathProvenance ).toBe( "derived-from-order-and-object" );
				}
				expect( transitions[ 1 ].migrationPath ).toInclude( "album" );
				expect( transitions[ 2 ].migrationPath ).toInclude( "artist" );
				// Order drives the stamp, so the path is stable across runs.
				expect( transitions[ 1 ].migrationPath ).toInclude( "000001" );
				expect( transitions[ 2 ].migrationPath ).toInclude( "000002" );
			} );

			it( "keeps a valid provider migration path untouched", () => {
				var service = newService();
				// normalizeDbTransitions moved to ModernizationArtifactService (Step 11).
				service = new app.models.services.ModernizationArtifactService();
				var original = "resources/database/migrations/2025_01_01_000000_create_album_table.bx";
				var transitions = service.normalizeDbTransitions( [
					{ id: "t-c", operation: "expand", order: 1, migrationPath: original }
				] );
				expect( transitions[ 1 ].migrationPath ).toBe( original );
				expect( transitions[ 1 ] ).notToHaveKey( "migrationPathProvenance" );
			} );

			it( "maps provider transition vocabulary onto the allowed operations", () => {
				var service = newService();
				// normalizeDbTransitions moved to ModernizationArtifactService (Step 11).
				service = new app.models.services.ModernizationArtifactService();
				// Observed live: 23 "verify" and 1 "capture", every one of which
				// tripped the invalid-operation gate.
				var transitions = service.normalizeDbTransitions( [
					{ id: "t-1", operation: "verify", order: 1 },
					{ id: "t-2", operation: "capture", order: 2 },
					{ id: "t-3", operation: "expand", order: 3 }
				] );
				expect( transitions[ 1 ].operation ).toBe( "switch" );
				expect( transitions[ 2 ].operation ).toBe( "expand" );
				// A recognized operation is left exactly as provided.
				expect( transitions[ 3 ].operation ).toBe( "expand" );
				expect( transitions[ 3 ] ).notToHaveKey( "operationInferred" );
			} );

			it( "falls back to expand for unrecognized operations and records what was provided", () => {
				var service = newService();
				// normalizeDbTransitions moved to ModernizationArtifactService (Step 11).
				service = new app.models.services.ModernizationArtifactService();
				var transitions = service.normalizeDbTransitions( [
					{ id: "t-x", operation: "frobnicate", order: 1 },
					{ id: "t-y", order: 2 }
				] );
				expect( transitions[ 1 ].operation ).toBe( "expand" );
				expect( transitions[ 1 ].operationInferred ).toBeTrue();
				expect( transitions[ 1 ].operationProvided ).toBe( "frobnicate" );
				// An absent operation infers without claiming the provider said anything.
				expect( transitions[ 2 ].operation ).toBe( "expand" );
				expect( transitions[ 2 ].operationInferred ).toBeTrue();
				expect( transitions[ 2 ] ).notToHaveKey( "operationProvided" );
			} );



			it( "renumbers transition order monotonically without reordering intent", () => {
				var service = newService();
				// normalizeDbTransitions moved to ModernizationArtifactService (Step 11).
				service = new app.models.services.ModernizationArtifactService();
				var transitions = service.normalizeDbTransitions( [
					{ id: "c", operation: "contract", order: 9, objectsTouched: [ "c" ] },
					{ id: "a", operation: "expand", order: 1, objectsTouched: [ "a" ] },
					{ id: "b", operation: "backfill", order: 1, objectsTouched: [ "b" ] }
				] );
				expect( transitions.map( ( item ) => item.order ) ).toBe( [ 1, 2, 3 ] );
				// The provider's sequence is preserved; only the numbering is repaired.
				expect( transitions[ 3 ].id ).toBe( "c" );
				var seenOrder = 0;
				for ( var t in transitions ) {
					expect( t.order ).toBeGT( seenOrder );
					seenOrder = t.order;
				}
			} );


			it( "leaves an already-wrapped migration untouched", () => {
				var service = newService();
				// normalizeDbTransitions moved to ModernizationArtifactService (Step 11).
				service = new app.models.services.ModernizationArtifactService();
				var original = "component { function up( schema, query ) { } function down( schema, query ) { } }";
				var transitions = service.normalizeDbTransitions( [
					{ id: "t-2", operation: "expand", sampleMigration: original }
				] );
				expect( transitions[ 1 ].migrationCode ).toBe( original );
				expect( transitions[ 1 ] ).notToHaveKey( "migrationCodeProvenance" );
			} );



			it( "names leftover roadmap shards after their feature directory", () => {
				var service = newService();
				makePublic( service, "buildRoadmapShards" );
				// Mirrors the live CFTunes run: architecture claimed only part of the
				// estate at roadmap-planning time, and directory gap-fill had not run.
				var units = [];
				var claimed = [];
				for ( var i = 1; i <= 4; i++ ) {
					units.append( { id: "core-#i#", sourcePath: "Application.cfc", targetPath: "app/handlers/Core#i#.bx" } );
					claimed.append( "core-#i#" );
				}
				for ( var l = 1; l <= 6; l++ ) units.append( { id: "lib-#l#", sourcePath: "Library/album#l#.cfm", targetPath: "app/views/album#l#.bxm" } );
				for ( var g = 1; g <= 3; g++ ) units.append( { id: "git-#g#", sourcePath: "guitar/chord#g#.cfm", targetPath: "app/views/chord#g#.bxm" } );
				units.append( { id: "svc-1", sourcePath: "cfc/services/SongServices.cfc", targetPath: "app/models/services/SongService.bx" } );

				var shards = service.buildRoadmapShards( {
					target: {
						units: units,
						placements: [ { name: "Core application monolith", targetUnitIds: claimed, placementType: "main-app" } ],
						contexts: [],
						extracts: []
					}
				}, {} );

				var names = shards.map( ( item ) => item.shardMeta.groupName ?: "" );
				expect( names ).toInclude( "Core application monolith" );
				// Leftovers carry their directory, not a sequential counter.
				expect( names ).toInclude( "Library" );
				expect( names ).toInclude( "Guitar" );
				// A container folder reaches one level in for the real feature name.
				expect( names ).toInclude( "Cfc Services" );
				for ( var name in names ) {
					expect( name ).notToInclude( "Continue strangler slices" );
				}
				// Largest leftover domain is sharded first, deterministically.
				var leftoverNames = [];
				for ( var shard in shards ) {
					if ( ( shard.shardMeta.kind ?: "" ) == "leftover" ) leftoverNames.append( shard.shardMeta.groupName ?: "" );
				}
				expect( leftoverNames[ 1 ] ).toBe( "Library" );
			} );

			it( "falls back to a generic leftover name when no path is available", () => {
				var service = newService();
				var derivedStructure = new app.models.services.ModernizationDerivedStructureService();
				// These moved to ModernizationRoadmapSynthesisService (Step 11) and are
				// public there, so no makePublic is needed.
				derivedStructure = new app.models.services.ModernizationRoadmapSynthesisService();
				var groups = derivedStructure.leftoverRoadmapGroups(
					[ { id: "u-1" }, { id: "u-2" } ],
					[ "u-1", "u-2" ]
				);
				expect( groups ).toHaveLength( 1 );
				expect( groups[ 1 ].name ).toBe( "Remaining application slices" );
				expect( groups[ 1 ].targetUnitIds ).toHaveLength( 2 );
			} );

			it( "restores roadmap phase collections that were persisted as text", () => {
				var placement = new app.models.services.ModernizationPlacementService();
				// Exactly the shape that broke the workspace: BoxLang array toString,
				// not JSON. A non-empty string is truthy, so the UI's `|| []` guard
				// passed it to .forEach and nothing rendered.
				var plan = placement.canonicalize( {
					target: { units: [], placements: [], contexts: [], extracts: [] },
					roadmapPhases: [ {
						id: "phase-a",
						dependencies: "[" & char( 10 ) & "    phase-media-player-pages" & char( 10 ) & "]",
						exitCriteria: "[" & char( 10 ) & "    All routes render,,  Comments persist" & char( 10 ) & "]",
						componentIds: "[ tu-one, tu-two ]",
						migrationSteps: "[ { targetPath : ""app/handlers/A.bx"" } ]",
						unitIds: [ "already-fine" ]
					} ]
				}, {}, true );

				var phase = plan.roadmapPhases[ 1 ];
				expect( phase.dependencies ).toBeArray();
				expect( phase.dependencies ).toBe( [ "phase-media-player-pages" ] );
				expect( phase.exitCriteria ).toBeArray();
				expect( phase.exitCriteria ).toHaveLength( 2 );
				expect( phase.componentIds ).toBe( [ "tu-one", "tu-two" ] );
				// Objects cannot be recovered from that notation, so they are emptied
				// rather than guessed at — and the loss is recorded.
				expect( phase.migrationSteps ).toBeArray();
				expect( phase.migrationSteps ).toBeEmpty();
				expect( phase.repairedCollections ).toInclude( "migrationSteps" );
				// A field that was already well-formed is left exactly as it was.
				expect( phase.unitIds ).toBe( [ "already-fine" ] );
			} );

			it( "leaves well-formed roadmap phases untouched", () => {
				var placement = new app.models.services.ModernizationPlacementService();
				var plan = placement.canonicalize( {
					target: { units: [], placements: [], contexts: [], extracts: [] },
					roadmapPhases: [ { id: "phase-ok", dependencies: [ "phase-x" ], unitIds: [ "u-1" ], migrationSteps: [] } ]
				}, {}, true );
				var phase = plan.roadmapPhases[ 1 ];
				expect( phase.dependencies ).toBe( [ "phase-x" ] );
				expect( phase ).notToHaveKey( "repairedCollections" );
			} );








			it( "drops a placement that owns no units", () => {
				var placement = new app.models.services.ModernizationPlacementService();
				var plan = placement.canonicalize( {
					target: {
						units: [ { id: "u1", layer: "handler", sourcePath: "a/x.cfm", targetPath: "app/handlers/A.bx" } ],
						placements: [
							{ id: "p-real", name: "Real", placementType: "main-app", targetUnitIds: [ "u1" ] },
							{ id: "p-empty", name: "Login and logout", placementType: "main-app", targetUnitIds: [] }
						],
						contexts: [], extracts: []
					}
				}, {}, true );
				var ids = plan.target.placements.map( ( item ) => item.id ?: "" );
				expect( ids ).notToInclude( "p-empty" );
			} );

			it( "repoints roadmap migration steps at the module path", () => {
				var placement = new app.models.services.ModernizationPlacementService();
				var plan = placement.canonicalize( {
					target: {
						units: [ { id: "m1", layer: "handler", sourcePath: "userHome/x.cfm", targetPath: "app/handlers/UserHome.bx" } ],
						placements: [ { id: "p", name: "n", domainKey: "userhome", placementType: "coldbox-module", targetUnitIds: [ "m1" ] } ],
						contexts: [], extracts: []
					},
					roadmapPhases: [ { id: "p1", unitIds: [ "m1" ], migrationSteps: [
						{ targetRef: { targetPath: "app/handlers/UserHome.bx" } }
					] } ]
				}, {}, true );
				expect( plan.roadmapPhases[ 1 ].migrationSteps[ 1 ].targetRef.targetPath ).toBe( "modules/userhome/handlers/UserHome.bx" );
			} );

			it( "moves ColdBox module units under modules/<slug>/ and names them by behaviour", () => {
				var placement = new app.models.services.ModernizationPlacementService();
				var plan = placement.canonicalize( {
					target: {
						units: [
							{ id: "m1", layer: "handler", sourcePath: "userHome/newPlaylist.cfm", targetPath: "app/handlers/UserHome.bx", action: "newPlaylist" },
							{ id: "m2", layer: "view", sourcePath: "userHome/myPlaylistGrid.cfm", targetPath: "app/views/myPlaylistGrid.bxm" },
							{ id: "m3", layer: "service", sourcePath: "userHome/playlistService.cfc", targetPath: "app/models/services/PlaylistService.bx" }
						],
						placements: [ {
							id: "p-userhome", name: "Userhome module candidate", domainKey: "userhome",
							placementType: "coldbox-module", targetUnitIds: [ "m1", "m2", "m3" ]
						} ],
						contexts: [], extracts: []
					}
				}, {}, true );

				var byId = {};
				for ( var u in plan.target.units ) byId[ u.id ] = u;
				expect( byId.m1.targetPath ).toBe( "modules/userhome/handlers/UserHome.bx" );
				expect( byId.m2.targetPath ).toBe( "modules/userhome/views/myPlaylistGrid.bxm" );
				expect( byId.m3.targetPath ).toBe( "modules/userhome/models/services/PlaylistService.bx" );
				expect( byId.m1.modulePackaging.slug ).toBe( "userhome" );
				var p = plan.target.placements[ 1 ];
				expect( p.moduleSlug ).toBe( "userhome" );
				expect( p.moduleRoot ).toBe( "modules/userhome" );
			} );

			it( "names a module from the layers it actually contains", () => {
				var placement = new app.models.services.ModernizationPlacementService();
				makePublic( placement, "moduleDisplayName" );
				makePublic( placement, "humanizeDomainKey" );
				// camelCase legacy folders must not collapse to "Userhome".
				expect( placement.humanizeDomainKey( "userHome" ) ).toBe( "User Home" );
				var units = [
					{ id: "a", layer: "handler" }, { id: "b", layer: "view" }, { id: "c", layer: "service" }
				];
				expect( placement.moduleDisplayName( "userHome", [ "a", "b", "c" ], units ) ).toBe( "User Home pages and services" );
				expect( placement.moduleDisplayName( "userHome", [ "a", "b" ], units ) ).toBe( "User Home pages" );
				expect( placement.moduleDisplayName( "userHome", [ "c" ], units ) ).toBe( "User Home services and models" );
			} );


			it( "reports context-omitted paths in the shard omission counters", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": { targetUnits: [ { id: "u-album", targetPath: "app/handlers/Album.bx", sourcePath: "Library/album.cfm", purpose: "album" } ], unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: [] },
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": { roadmapPhases: [], assumptions: [], samples: [] }
				} );
				var service = newService();
				service.agentGateway = gateway;
				var result = service.propose(
					"run-ungrounded",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000 } },
					{
						coverage: {},
						schemaEvidence: {},
						inventory: { units: [], files: [
							{ filePath: "Library/album.cfm" },
							{ filePath: "guitar/upload.cfm" },
							{ filePath: "guitar/newLesson.cfm" }
						] },
						context: { partitions: [ { filePath: "Library/album.cfm", text: "1| <cfoutput>album</cfoutput>" } ] }
					}
				);

				expect( result.ok ).toBeTrue( jsonSerialize( result.errors ?: [] ) );
				var shardReport = result.plan.metadata.applicationShards;
				// The two files with no partition are counted, not silently zeroed.
				expect( shardReport.omittedUngrounded ).toBe( 2 );
				expect( shardReport.omitted ).toBeGTE( 2 );
				expect( shardReport.omittedPaths ).toHaveLength( 2 );
				expect( ( result.notes ?: [] ).filter( ( item ) => item.message == "omitted-ungrounded-paths" ) ).notToBeEmpty();
			} );

		} );
	}
}
