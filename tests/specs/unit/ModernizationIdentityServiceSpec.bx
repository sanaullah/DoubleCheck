class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "ModernizationIdentityService", () => {
			it( "normalizes path separators and case for stable IDs", () => {
				var service = new app.models.services.ModernizationIdentityService();
				var first = service.itemId( "unit", { filePath: "SRC\\Handlers\\Order.cfc", name: "Order" } );
				var second = service.itemId( "unit", { filePath: "src/handlers/order.cfc", name: "Order" } );
				expect( first ).toBe( second );
			} );
			it( "changes fingerprints when item content changes", () => {
				var service = new app.models.services.ModernizationIdentityService();
				var first = service.itemFingerprint( "route-contract", { path: "/orders", method: "GET", response: "list" } );
				var second = service.itemFingerprint( "route-contract", { path: "/orders", method: "POST", response: "list" } );
				expect( first ).notToBe( second );
			} );
			it( "keeps item kinds in separate identity namespaces", () => {
				var service = new app.models.services.ModernizationIdentityService();
				var identity = { path: "/orders", name: "Order" };
				expect( service.itemId( "unit", identity ) ).notToBe( service.itemId( "route", identity ) );
			} );
		} );
	}
}
