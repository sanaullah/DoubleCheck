class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Secret redaction structure safety", () => {
			it( "redacts sensitive leaf strings without destroying JSON object shape", () => {
				var service = new app.models.services.SecretRedactionService();
				var payload = {
					targetUnits: [
						{
							id: "tu-1",
							purpose: "Move password validation into CrimeService",
							sampleCode: "function authenticate() { var password = form.password; return password; }",
							targetPath: "app/models/AuthService.bx"
						}
					],
					unitLinks: [],
					routeContracts: [ { id: "rc-1", auth: "session", path: "/login" } ],
					token: "should-stay-as-key",
					notes: "api_key=super-secret-value-here"
				};
				var redacted = service.redactStructured( payload );
				expect( redacted ).toBeStruct();
				expect( redacted.targetUnits ).toBeArray();
				expect( redacted.targetUnits.len() ).toBe( 1 );
				expect( redacted.targetUnits[ 1 ].id ).toBe( "tu-1" );
				expect( redacted.targetUnits[ 1 ].targetPath ).toBe( "app/models/AuthService.bx" );
				expect( redacted.notes ).toBe( "[REDACTED SENSITIVE CONTENT]" );
				expect( findNoCase( "super-secret-value-here", jsonSerialize( redacted ) ) ).toBe( 0 );
			} );
		} );
	}
}
