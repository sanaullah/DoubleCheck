class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Repository scanner prioritization", () => {
			it( "puts CFML paths ahead of JavaScript when modernize priority extensions are set", () => {
				var service = new app.models.services.RepositoryScannerService();
				service.supportedLanguageService = new app.models.services.SupportedLanguageService();
				var paths = [
					"D:/repo/assets/app.js",
					"D:/repo/dashboard/index.cfm",
					"D:/repo/lib/vendor.js",
					"D:/repo/dashboard/components/crime.cfc"
				];
				var ordered = service.prioritizeCandidatePaths( paths, [ "cfm", "cfc", "bx", "bxm" ] );
				expect( ordered[ 1 ] ).toInclude( "index.cfm" );
				expect( ordered[ 2 ] ).toInclude( "crime.cfc" );
				expect( ordered[ 3 ] ).toInclude( "app.js" );
				expect( ordered[ 4 ] ).toInclude( "vendor.js" );
			} );
		} );
	}
}
