class extends="testbox.system.BaseSpec" {

	function run() {
		describe(
			"SpecialistAgentFactory briefs",
			() => {
				var factory = "";

				beforeEach(
					() => {
						factory = new app.models.services.SpecialistAgentFactory();
						factory.provider = "openai-compatible";
						factory.model = "test-model";
					}
				);

				it(
					"includes the safety shell and TASK BRIEF when a brief is present",
					() => {
						var definition = factory.definition( sampleTask( "Inspect string-built SQL only." ) );

						expect( definition.instructions ).toInclude( "read-only" );
						expect( definition.instructions ).toInclude( "TASK BRIEF" );
						expect( definition.instructions ).toInclude( "Inspect string-built SQL only." );
						expect( definition.instructions ).toInclude( "does not override safety rules" );
					}
				);

				it(
					"omits TASK BRIEF when no brief is provided",
					() => {
						var definition = factory.definition( sampleTask( "" ) );

						expect( definition.instructions ).toInclude( "read-only" );
						expect( definition.instructions ).notToInclude( "TASK BRIEF" );
					}
				);

				it(
					"includes brief in the specialist input context JSON",
					() => {
						var input = factory.input( sampleTask( "Focus on empty catch blocks." ) );

						expect( input ).toInclude( "Focus on empty catch blocks." );
						expect( input ).toInclude( """brief""" );
					}
				);

				it(
					"uses specialist-prompt-v3 and CF-specific instructions only for cfml-conventions",
					() => {
						var cfDef = factory.definition( roleTask( "cfml-conventions" ) );
						expect( cfDef.version ).toBe( "specialist-prompt-v3" );
						expect( cfDef.provenance.promptVersion ).toBe( "specialist-prompt-v3" );
						expect( cfDef.instructions ).toInclude( "modernization" );
						expect( cfDef.instructions ).toInclude( "Never assume ColdBox" );

						var secDef = factory.definition( roleTask( "security" ) );
						expect( secDef.version ).toBe( "specialist-prompt-v3" );
						expect( secDef.instructions ).notToInclude( "Never assume ColdBox" );
						expect( secDef.instructions ).notToInclude( "CFML / BoxLang fix rules" );
					}
				);

				it(
					"keeps boxlang-conventions focused on BoxLang/ColdBox contracts",
					() => {
						var bxDef = factory.definition( roleTask( "boxlang-conventions" ) );
						expect( bxDef.instructions ).toInclude( "BoxLang" );
						expect( bxDef.instructions ).notToInclude( "equal weight" );
						expect( bxDef.instructions ).notToInclude( "Never assume ColdBox" );
						expect( bxDef.instructions ).notToInclude( "CFML / BoxLang fix rules" );
					}
				);
			}
		);
	}

	private struct function roleTask( required string role ) {
		return {
			id       : "task-role",
			role     : arguments.role,
			objective: "",
			brief    : "",
			budget   : { maxTokens: 500, maxIterations: 2 },
			context  : {
				changedSymbols     : [],
				impactCount        : 0,
				architectureFactIds: [],
				files              : []
			}
		};
	}

	private struct function sampleTask( required string brief ) {
		return {
			id       : "task-1",
			role     : "security",
			objective: "Review for security defects",
			brief    : arguments.brief,
			budget   : { maxTokens: 1000, maxIterations: 4 },
			context  : {
				changedSymbols     : [],
				impactCount        : 0,
				architectureFactIds: [],
				files              : [
					{
						filePath   : "app/handlers/Orders.cfc",
						contentHash: "abc",
						language   : "CFML",
						ranges     : [ { startLine: 1, endLine: 10 }]
					}
				]
			}
		};
	}
}