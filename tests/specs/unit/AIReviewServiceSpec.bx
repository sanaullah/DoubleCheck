class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "AI review provider smoke", () => {
			it( "uses a bounded JSON request and reports a structured result", () => {
				var captured = {};
				var gateway = {
					isEnabled: ( provider, apiKey ) => true,
					chat: ( prompt, params, options ) => {
						captured.prompt = prompt;
						captured.params = params;
						captured.options = options;
						return { marker: "OK", responseFormat: "json" };
					}
				};
				var service = new app.models.services.AIReviewService();
				service.chatGateway = gateway;
				service.aiProviderResolver = new tests.resources.StubAIProviderResolver( {
					provider: "openrouter",
					apiKey  : "configured",
					model   : "test/model",
					baseURL : "https://openrouter.ai/api/v1",
					timeout : 600
				} );

				var result = service.smokeTest();

				expect( result.success ).toBeTrue();
				expect( result.provider ).toBe( "openrouter" );
				expect( result.model ).toBe( "test/model" );
				expect( result.baseHost ).toBe( "openrouter.ai" );
				expect( result.responseFormat ).toBe( "json" );
				expect( result.response.marker ).toBe( "OK" );
				expect( result.outputCharacters ).toBeGT( 0 );
				expect( result.usage.totalTokens ).toBeGT( 0 );
				expect( result.usage.source ).toBe( "estimated-from-characters" );
				expect( result.errorClass ).toBeEmpty();
				expect( captured.prompt ).toBeArray();
				expect( captured.params.model ).toBe( "test/model" );
				expect( captured.params.temperature ).toBe( 0 );
				expect( captured.params.max_tokens ).toBe( 64 );
				expect( captured.options.provider ).toBe( "openrouter" );
				expect( captured.options.returnFormat ).toBe( "json" );
				expect( captured.options.timeout ).toBe( 600 );
				expect( captured.options.baseURL ).toBe( "https://openrouter.ai/api/v1" );
			} );
		} );
	}
}
