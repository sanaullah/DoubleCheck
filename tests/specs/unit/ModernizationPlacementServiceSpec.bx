class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Modernize v2 placement contract", () => {

			it( "keeps placement identity stable when the provider renames a capability", () => {
				var service = new app.models.services.ModernizationPlacementService();
				var base = { version: "modernization-plan-v2", target: { units: [ { id: "tu-a" }, { id: "tu-b" } ], placements: [ { domainKey: "orders", name: "Orders", placementType: "coldbox-module", targetUnitIds: [ "tu-b", "tu-a" ] } ] } };
				var first = service.canonicalize( base );
				base.target.placements[ 1 ].name = "Order Processing";
				var second = service.canonicalize( base );
				expect( second.target.placements[ 1 ].id ).toBe( first.target.placements[ 1 ].id );
			} );


			it( "preserves duplicate ownership as a validation signal instead of silently reassigning it", () => {
				var service = new app.models.services.ModernizationPlacementService();
				var plan = service.canonicalize( { version: "modernization-plan-v2", target: { units: [ { id: "tu-a" } ], placements: [ { id: "one", targetUnitIds: [ "tu-a" ] }, { id: "two", targetUnitIds: [ "tu-a" ] } ] } } );
				expect( plan.placementCoverage.duplicateUnitIds ).toContain( "tu-a" );
				expect( plan.placementCoverage.complete ).toBeFalse();
			} );

			it( "retains more than sixteen provider capability placements", () => {
				var service = new app.models.services.ModernizationPlacementService();
				var units = [];
				var placements = [];
				for ( var index = 1; index <= 18; index++ ) {
					units.append( { id: "tu-#index#" } );
					placements.append( { domainKey: "domain-#index#", placementType: "coldbox-module", targetUnitIds: [ "tu-#index#" ], rationale: "Cohesive feature boundary" } );
				}
				var plan = service.canonicalize( { version: "modernization-plan-v2", target: { units: units, placements: placements } } );
				expect( plan.target.placements ).toHaveLength( 18 );
				expect( plan.placementCoverage.complete ).toBeTrue();
			} );

			it( "proposes ColdBox modules for repeated directory domains while keeping shared work in the main app", () => {
				var service = new app.models.services.ModernizationPlacementService();
				var plan = service.canonicalize( {
					version: "modernization-plan-v2",
					target: {
						units: [
							{ id: "calendar-page", sourcePath: "weboffice/calendar/index.cfm" },
							{ id: "calendar-service", sourcePath: "weboffice/calendar/calendar.cfc" },
							{ id: "calendar-view", sourcePath: "weboffice/calendar/day.cfm" },
							{ id: "shared-config", sourcePath: "config/settings.cfm" },
							{ id: "small-one", sourcePath: "web/tiny/one.cfm" },
							{ id: "small-two", sourcePath: "web/tiny/two.cfm" }
						],
						placements: []
					}
				} );
				var calendar = plan.target.placements.filter( ( item ) => ( item.domainKey ?: "" ) == "weboffice/calendar" );
				expect( calendar ).toHaveLength( 1 );
				expect( calendar[ 1 ].placementType ).toBe( "coldbox-module" );
				expect( calendar[ 1 ].decisionRequired ).toBeTrue();
				var main = plan.target.placements.filter( ( item ) => item.placementType == "main-app" );
				expect( main ).toHaveLength( 1 );
				expect( main[ 1 ].targetUnitIds ).toInclude( "shared-config" );
				expect( main[ 1 ].targetUnitIds ).toInclude( "small-one" );
				expect( plan.target.placements.filter( ( item ) => item.placementType == "external-service" ) ).toBeEmpty();
			} );
		} );
	}
}
