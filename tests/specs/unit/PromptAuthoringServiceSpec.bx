class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Offline prompt authoring", () => {
			it( "builds a bounded proposal request without changing runtime authority", () => {
				var service = new app.models.services.PromptAuthoringService();
				var package = service.build( "specialist.security", { version: "fixtures-v1", fixtures: [] } );
				expect( package.offlineOnly ).toBeTrue();
				expect( package.messages[ 2 ].content ).toInclude( "BEGIN_CONTRACT_JSON" );
				expect( package.messages[ 2 ].content ).toInclude( "BEGIN_OUTPUT_SCHEMA_JSON" );
				expect( package.messages[ 2 ].content ).toInclude( "BEGIN_EVAL_FIXTURES_JSON" );
				expect( package.systemPrompt ).toInclude( "offline proposal" );
				expect( package.provenance.promptHash ).toHaveLength( 64 );
			} );

			it( "uses the shared validator for authoring proposals", () => {
				var service = new app.models.services.PromptAuthoringService();
				var valid = service.validateProposal( { roleInstructions: "Review evidence.", adversarialCases: [], contractRisks: [], testCases: [] } );
				var invalid = service.validateProposal( { roleInstructions: "missing other sections" } );
				expect( valid.valid ).toBeTrue();
				expect( invalid.valid ).toBeFalse();
				expect( invalid.reasonCodes ).toInclude( "required" );
			} );
		} );
	}
}
