class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Modernization agent prompt contracts", () => {
			var factory = "";
			beforeEach( () => { factory = new app.models.services.ModernizationAgentFactory(); } );

			it( "builds versioned application, database and roadmap roles", () => {
				var appPrompt = factory.build( "modernization-application", { runtime: "boxlang", profile: "modern" }, { files: [] }, { maxTokens: 500 } );
				var dbPrompt = factory.build( "modernization-database", { runtime: "lucee", profile: "flat" }, { schema: {} }, { maxTokens: 500 } );
				var roadmapPrompt = factory.build( "modernization-roadmap", { runtime: "boxlang", profile: "modern" }, { merged: true }, { maxTokens: 500 } );
				expect( appPrompt.promptVersion ).toBe( "modernization-prompt-v5" );
				expect( appPrompt.messages[ 2 ].content ).toInclude( "target units" );
				expect( appPrompt.messages[ 2 ].content ).toInclude( "unitLinks" );
				expect( dbPrompt.messages[ 2 ].content ).toInclude( "dbTransitions" );
				expect( roadmapPrompt.messages[ 2 ].content ).toInclude( "roadmapPhases" );
				expect( roadmapPrompt.messages[ 2 ].content ).toInclude( "rollback" );
			} );

			it( "rejects unsupported roles and keeps evidence bounded", () => {
				expect( () => factory.build( "security", {}, {}, {} ) ).toThrow( "ValidationException" );
				var evidence = { z: [ 1, 2 ], a: "source evidence" };
				var prompt = factory.build( "modernization-application", {}, evidence, {} );
				expect( prompt.messages[ 2 ].content ).toInclude( "source evidence" );
			} );

			it( "prioritizes schema for database analysis and mapped ids for roadmap analysis", () => {
				var dbPrompt = factory.build(
					"modernization-database",
					{ runtime: "boxlang", profile: "modern" },
					{
						context: { text: repeatString( "context-", 8000 ) },
						inventory: { text: repeatString( "inventory-", 5000 ) },
						schemaEvidence: { sourceKind: "auto-discovered", tables: [ { name: "portalsetting" } ] }
					},
					{}
				);
				expect( dbPrompt.messages[ 2 ].content ).toInclude( "portalsetting" );
				expect( dbPrompt.messages[ 2 ].content ).toInclude( "auto-discovered" );

				var roadmapPrompt = factory.build(
					"modernization-roadmap",
					{ runtime: "boxlang", profile: "modern" },
					{
						coverage: { note: repeatString( "coverage-", 6000 ) },
						target: { units: [ { id: "target-crime-handler", targetPath: "app/handlers/Crime.bx" } ] },
						unitLinks: [ { id: "link-crime", targetUnitId: "target-crime-handler" } ],
						routeContracts: [ { id: "route-crime", targetUnitId: "target-crime-handler", unitLinkId: "link-crime", path: "/crime" } ]
					},
					{}
				);
				expect( roadmapPrompt.messages[ 2 ].content ).toInclude( "target-crime-handler" );
				expect( roadmapPrompt.messages[ 2 ].content ).toInclude( "route-crime" );
			} );

			it( "injects skill pack excerpts and coexistence sample-contract rules for application role", () => {
				factory.skillService = new app.models.services.ModernizationSkillService();
				var prompt = factory.build( "modernization-application", { runtime: "boxlang", profile: "modern" }, { files: [] }, {} );
				expect( prompt.promptVersion ).toBe( "modernization-prompt-v5" );
				expect( prompt.messages[ 1 ].content ).toInclude( "coexist" );
				expect( prompt.messages[ 1 ].content ).toInclude( "sample contract" );
				expect( prompt.messages[ 2 ].content ).toInclude( "BEGIN_SKILL_PACK" );
				expect( arrayLen( prompt.skillPack ?: [] ) ).toBeGT( 0 );
			} );

			it( "injects shard-scoped application instructions when shardMeta paths are present", () => {
				var prompt = factory.build(
					"modernization-application",
					{ runtime: "boxlang", profile: "modern" },
					{ shardMeta: { index: 2, total: 5, paths: [ "Application.cfc", "model/SongService.cfc" ] }, inventory: { units: [] } },
					{}
				);
				expect( prompt.messages[ 2 ].content ).toInclude( "APPLICATION SHARD 2 of 5" );
				expect( prompt.messages[ 2 ].content ).toInclude( "Application.cfc" );
				expect( prompt.messages[ 2 ].content ).toInclude( "contexts and extracts MUST be empty" );
			} );

			it( "builds a whole-repository architecture role that allows tiered, labeled packaging picks", () => {
				var prompt = factory.build(
					"modernization-architecture",
					{ runtime: "boxlang", profile: "modern" },
					{
						target: { units: [ { id: "target-crime-handler", targetPath: "app/handlers/Crime.bx" } ] },
						unitLinks: [ { id: "link-crime", targetUnitId: "target-crime-handler" } ],
						routeContracts: [],
						signals: { signals: [ { group: "datasource-table-coupling", signalId: "sql.table-ref" } ] }
					},
					{}
				);
				expect( prompt.promptVersion ).toBe( "modernization-prompt-v5" );
				expect( prompt.messages[ 1 ].content ).toInclude( "domain-clustering" );
				expect( prompt.messages[ 1 ].content ).toInclude( "explicit-seam" );
				expect( prompt.messages[ 1 ].content ).notToInclude( "Do not propose a ColdBox module, side app, worker" );
				expect( prompt.messages[ 2 ].content ).toInclude( "target-crime-handler" );
				expect( prompt.messages[ 2 ].content ).toInclude( "datasource-table-coupling" );
			} );

			it( "tells the roadmap role to follow context/extract groupings into phases", () => {
				var roadmapPrompt = factory.build( "modernization-roadmap", { runtime: "boxlang", profile: "modern" }, { target: { contexts: [], extracts: [] } }, {} );
				expect( roadmapPrompt.messages[ 2 ].content ).toInclude( "prefer one phase per coherent group" );
			} );

			it( "builds a slice-rebuild role that keeps scope locked to one phase", () => {
				factory.skillService = new app.models.services.ModernizationSkillService();
				var prompt = factory.build( "modernization-slice-rebuild", { runtime: "boxlang", profile: "modern" }, { phaseId: "phase-3", note: "use Crime handler" }, {} );
				expect( prompt.messages[ 2 ].content ).toInclude( "phase-3" );
				expect( prompt.messages[ 2 ].content ).toInclude( "Do not rewrite unrelated phases" );
			} );

			it( "builds an item-rebuild role that keeps scope locked to one db-finding or db-transition", () => {
				var prompt = factory.build(
					"modernization-item-rebuild",
					{ runtime: "boxlang", profile: "modern" },
					{
						itemType: "db-finding",
						itemId: "db-finding-007",
						note: "tighten the severity",
						priorItem: { id: "db-finding-007", category: "index", severity: "medium" },
						schemaEvidence: { sourceKind: "auto-discovered", tables: [ { name: "crime" } ] }
					},
					{}
				);
				expect( prompt.promptVersion ).toBe( "modernization-prompt-v5" );
				expect( prompt.messages[ 2 ].content ).toInclude( "db-finding-007" );
				expect( prompt.messages[ 2 ].content ).toInclude( "tighten the severity" );
				expect( prompt.messages[ 2 ].content ).toInclude( "Do not widen scope to other findings or transitions" );
				expect( prompt.messages[ 2 ].content ).toInclude( "crime" );
			} );
		} );
	}
}
