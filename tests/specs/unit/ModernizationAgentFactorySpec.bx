class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Modernization agent prompt contracts", () => {
			var factory = "";
			beforeEach( () => { factory = new app.models.services.ModernizationAgentFactory(); } );

			it( "builds versioned application, database and roadmap roles", () => {
				var appPrompt = factory.build( "modernization-application", { runtime: "boxlang", profile: "modern" }, { files: [] }, { maxTokens: 500 } );
				var dbPrompt = factory.build( "modernization-database", { runtime: "lucee", profile: "flat" }, { schema: {} }, { maxTokens: 500 } );
				var roadmapPrompt = factory.build( "modernization-roadmap", { runtime: "boxlang", profile: "modern" }, { merged: true }, { maxTokens: 500 } );
				expect( appPrompt.promptVersion ).toBe( "modernization-prompt-v1" );
				expect( appPrompt.messages[ 2 ].content ).toInclude( "target units" );
				expect( appPrompt.messages[ 2 ].content ).toInclude( "unitLinks" );
				expect( dbPrompt.messages[ 2 ].content ).toInclude( "dbTransitions" );
				expect( roadmapPrompt.messages[ 2 ].content ).toInclude( "roadmapPhases" );
				expect( roadmapPrompt.messages[ 2 ].content ).toInclude( "rollback" );
			} );

			it( "rejects unsupported roles and keeps evidence bounded", () => {
				expect( () => factory.build( "security", {}, {}, {} ) ).toThrow( "ValidationException" );
				var evidence = { z: [ 1, 2 ], a: "source evidence" };
				var prompt = factory.build( "modernization-application", {}, evidence, {} );
				expect( prompt.messages[ 2 ].content ).toInclude( "source evidence" );
			} );
		} );
	}
}
