class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Modernization agent prompt contracts", () => {
			var factory = "";
			beforeEach( () => { factory = new app.models.services.ModernizationAgentFactory(); } );

			it( "builds versioned application, database and roadmap roles", () => {
				var appPrompt = factory.build( "modernization-application", { runtime: "boxlang", profile: "modern" }, { files: [] }, { maxTokens: 500 } );
				var dbPrompt = factory.build( "modernization-database", { runtime: "lucee", profile: "flat" }, { schema: {} }, { maxTokens: 500 } );
				var roadmapPrompt = factory.build( "modernization-roadmap", { runtime: "boxlang", profile: "modern" }, { merged: true }, { maxTokens: 500 } );
				expect( appPrompt.promptVersion ).toBe( "modernization-prompt-v3" );
				expect( appPrompt.messages[ 2 ].content ).toInclude( "target units" );
				expect( appPrompt.messages[ 2 ].content ).toInclude( "unitLinks" );
				expect( dbPrompt.messages[ 2 ].content ).toInclude( "dbTransitions" );
				expect( roadmapPrompt.messages[ 2 ].content ).toInclude( "roadmapPhases" );
				expect( roadmapPrompt.messages[ 2 ].content ).toInclude( "rollback" );
			} );

			it( "rejects unsupported roles and keeps evidence bounded", () => {
				expect( () => factory.build( "security", {}, {}, {} ) ).toThrow( "ValidationException" );
				var evidence = { z: [ 1, 2 ], a: "source evidence" };
				var prompt = factory.build( "modernization-application", {}, evidence, {} );
				expect( prompt.messages[ 2 ].content ).toInclude( "source evidence" );
			} );

			it( "injects skill pack excerpts and coexistence sample-contract rules for application role", () => {
				factory.skillService = new app.models.services.ModernizationSkillService();
				var prompt = factory.build( "modernization-application", { runtime: "boxlang", profile: "modern" }, { files: [] }, {} );
				expect( prompt.promptVersion ).toBe( "modernization-prompt-v3" );
				expect( prompt.messages[ 1 ].content ).toInclude( "coexist" );
				expect( prompt.messages[ 1 ].content ).toInclude( "sample contract" );
				expect( prompt.messages[ 2 ].content ).toInclude( "BEGIN_SKILL_PACK" );
				expect( arrayLen( prompt.skillPack ?: [] ) ).toBeGT( 0 );
			} );

			it( "injects shard-scoped application instructions when shardMeta paths are present", () => {
				var prompt = factory.build(
					"modernization-application",
					{ runtime: "boxlang", profile: "modern" },
					{ shardMeta: { index: 2, total: 5, paths: [ "Application.cfc", "model/SongService.cfc" ] }, inventory: { units: [] } },
					{}
				);
				expect( prompt.messages[ 2 ].content ).toInclude( "APPLICATION SHARD 2 of 5" );
				expect( prompt.messages[ 2 ].content ).toInclude( "Application.cfc" );
				expect( prompt.messages[ 2 ].content ).toInclude( "contexts and extracts MUST be empty" );
			} );

			it( "builds a slice-rebuild role that keeps scope locked to one phase", () => {
				factory.skillService = new app.models.services.ModernizationSkillService();
				var prompt = factory.build( "modernization-slice-rebuild", { runtime: "boxlang", profile: "modern" }, { phaseId: "phase-3", note: "use Crime handler" }, {} );
				expect( prompt.messages[ 2 ].content ).toInclude( "phase-3" );
				expect( prompt.messages[ 2 ].content ).toInclude( "Do not rewrite unrelated phases" );
			} );
		} );
	}
}
