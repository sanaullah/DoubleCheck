class extends="testbox.system.BaseSpec" {

	/**
	 * Detector behaviour, asserted where it actually runs.
	 *
	 * A standalone CLI probe of this class returned nothing for patterns that
	 * demonstrably work in the application, because BoxLang serves compiled
	 * classes from its runtime cache. A spec runs against the same compiled state
	 * as the server, which is the only place the answer is meaningful.
	 */
	function run() {
		describe( "IntegrationDetector", () => {

			var detector = new app.models.services.IntegrationDetector();

			var kindsFor = ( line ) => {
				var kinds = [];
				for ( var hit in detector.detect( line ) ) kinds.append( hit.kind );
				return kinds;
			};

			it( "detects configuration read both ways it is written", () => {
				// G6: the row count alone could not tell these apart, and all 27 rows
				// on the live run came from the injection form.
				expect( kindsFor( "var limit = getSystemSetting( 'DOUBLECHECK_MAX', 10 );" ) ).toInclude( "reads-config" );
				expect( kindsFor( 'property name="datasource" inject="coldbox:setting:datasource";' ) ).toInclude( "reads-config" );
			} );

			it( "names the setting rather than reporting an anonymous read", () => {
				var found = detector.detect( "getSystemSetting( 'DOUBLECHECK_MAX_NODES' )" );
				var target = "";
				for ( var hit in found ) if ( hit.kind == "reads-config" ) target = hit.target;
				expect( target ).toBe( "doublecheck_max_nodes" );
			} );

			it( "still detects the integrations it shipped with", () => {
				expect( kindsFor( "fileRead( path )" ) ).toInclude( "filesystem" );
				expect( kindsFor( "new java:java.io.File( x )" ) ).toInclude( "java" );
				expect( kindsFor( "httpRequest( url )" ) ).toInclude( "http" );
			} );

			it( "detects event publication", () => {
				// G1a. Previously shipped dead and removed; re-added only with an
				// assertion, after a backspace byte was found silently disabling a
				// sibling pattern in exactly this way.
				expect( kindsFor( "eventService.publish( runId, 'codegraph.completed', {} )" ) ).toInclude( "emits" );
				expect( kindsFor( "announce( 'onRunComplete' )" ) ).toInclude( "emits" );
			} );

			it( "names the event rather than reporting an anonymous emit", () => {
				var target = "";
				for ( var hit in detector.detect( "eventService.publish( runId, 'codegraph.completed', {} )" ) ) {
					if ( hit.kind == "emits" ) target = hit.target;
				}
				expect( target ).toBe( "codegraph.completed" );
			} );
		} );
	}
}
