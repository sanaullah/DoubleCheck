class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Modernization run budgets", () => {
			it( "honors an explicit token and cost ceiling", () => {
				var service = new app.models.services.ReviewRunService();
				var budgets = service.normalizeModernizationBudgets( {
					maxTokens: 6000,
					maxTokensPerTask: 6000,
					maxCostUsd: 1
				} );
				expect( budgets.maxTokens ).toBe( 6000 );
				expect( budgets.maxTokensPerTask ).toBe( 6000 );
				expect( budgets.maxCostUsd ).toBe( 1 );
			} );

			it( "permits the explicitly bounded Stage 6 audit ceiling", () => {
				var service = new app.models.services.ReviewRunService();
				var budgets = service.normalizeModernizationBudgets( {
					maxDurationMs: 3600000,
					maxCostUsd: 200
				} );
				expect( budgets.maxDurationMs ).toBe( 3600000 );
				expect( budgets.maxCostUsd ).toBe( 200 );
			} );

			it( "defaults modernization duration to the 120-minute estate budget", () => {
				var service = new app.models.services.ReviewRunService();
				var budgets = service.normalizeModernizationBudgets( {} );
				expect( budgets.maxDurationMs ).toBe( 7200000 );
			} );

			it( "clamps modernization budgets above the supported ceiling", () => {
				var service = new app.models.services.ReviewRunService();
				var budgets = service.normalizeModernizationBudgets( {
					maxDurationMs: 9000000,
					maxCostUsd: 500
				} );
				expect( budgets.maxDurationMs ).toBe( 7200000 );
				expect( budgets.maxCostUsd ).toBe( 200 );
			} );
		} );
	}
}
