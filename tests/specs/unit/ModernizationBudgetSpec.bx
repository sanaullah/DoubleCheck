class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Modernization run budgets", () => {
			it( "honors an explicit token and cost ceiling", () => {
				var service = new app.models.services.ReviewRunService();
				var budgets = service.normalizeModernizationBudgets( {
					maxTokens: 6000,
					maxTokensPerTask: 6000,
					maxCostUsd: 1
				} );
				expect( budgets.maxTokens ).toBe( 6000 );
				expect( budgets.maxTokensPerTask ).toBe( 6000 );
				expect( budgets.maxCostUsd ).toBe( 1 );
			} );
		} );
	}
}
