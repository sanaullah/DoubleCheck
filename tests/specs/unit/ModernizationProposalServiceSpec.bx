				expect( result.ok ).toBeTrue();
				expect( result.partial ).toBeTrue();
				expect( result.plan.roadmapPhases ).toBeEmpty();
				expect( result.plan.dbFindings ).notToBeEmpty();
				expect( result.errors.filter( ( item ) => item.message == "skipped-without-application-fragment" ) ).notToBeEmpty();
