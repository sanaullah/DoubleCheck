			it( "rewrites colliding phase ids and chains dependencies deterministically across independent roadmap shards, ignoring cross-shard references the provider could not have known", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": {
						targetUnits: [
							{ id: "unit-a", targetPath: "app/handlers/A.bx", sourcePath: "handlers/A.cfc" },
							{ id: "unit-b", targetPath: "app/handlers/B.bx", sourcePath: "handlers/B.cfc" }
						],
						unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: []
					},
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": {
						contexts: [
							{ id: "ctx-a", name: "Group A", targetUnitIds: [ "unit-a" ], packaging: "coldbox-module", evidenceBasis: "domain-clustering" },
							{ id: "ctx-b", name: "Group B", targetUnitIds: [ "unit-b" ], packaging: "centralized", evidenceBasis: "explicit-seam" }
						],
						extracts: []
					},
					"modernization-roadmap": [
						{ roadmapPhases: [ { id: "phase-1", name: "Group A", unitIds: [ "unit-a" ], routeIds: [], dependencies: [ "phase-never-seen" ], currentSlice: true } ], assumptions: [], samples: [] },
						{ roadmapPhases: [ { id: "phase-1", name: "Group B", unitIds: [ "unit-b" ], routeIds: [], dependencies: [], currentSlice: true } ], assumptions: [], samples: [] }
					]
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose(
					"run-roadmap-collision",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000, maxIterations: 2 } },
					{ coverage: {}, inventory: {}, schemaEvidence: {} }
				);
				expect( result.ok ).toBeTrue();
				var phases = result.plan.roadmapPhases;
				// Both shards proposed "phase-1"; both must survive under distinct ids.
				expect( phases ).toHaveLength( 2 );
				var ids = phases.map( ( phase ) => phase.id );
				expect( ids[ 1 ] ).notToBe( ids[ 2 ] );
				// Neither shard's own (untrustworthy) dependencies/currentSlice survive:
				// the pipeline chains phases in shard order and keeps exactly one current slice.
				var groupA = phases.filter( ( phase ) => phase.name == "Group A" )[ 1 ];
				var groupB = phases.filter( ( phase ) => phase.name == "Group B" )[ 1 ];
				expect( groupA.dependencies ).toBeEmpty();
				expect( groupB.dependencies ).toBe( [ groupA.id ] );
				expect( phases.filter( ( phase ) => phase.currentSlice ?: false ) ).toHaveLength( 1 );
				expect( groupA.currentSlice ).toBeTrue();
			} );

