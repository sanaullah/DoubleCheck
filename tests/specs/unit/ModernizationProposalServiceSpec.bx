					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000, maxIterations: 2 } },
					{ coverage: {}, inventory: {}, schemaEvidence: {} }
				);
				expect( result.ok ).toBeTrue();
				var phase = result.plan.roadmapPhases.filter( ( item ) => item.id == "phase-pdf" )[ 1 ];
				expect( phase.migrationSteps ).toHaveLength( 1 );
				expect( phase.migrationSteps[ 1 ].legacyRef.filePath ).toBe( "handlers/Pdf.cfc" );
				expect( phase.migrationSteps[ 1 ].targetRef.targetPath ).toBe( "app/handlers/Pdf.bx" );
				expect( phase.itemFingerprint ).notToBeEmpty();
			} );


