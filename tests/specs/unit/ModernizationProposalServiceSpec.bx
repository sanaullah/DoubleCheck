			it( "does not reserve disabled downstream-role budget from an application-only run", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": {
						targetUnits: [ { id: "app-only", targetPath: "app/handlers/AppOnly.bx", sourcePath: "index.cfm" } ],
