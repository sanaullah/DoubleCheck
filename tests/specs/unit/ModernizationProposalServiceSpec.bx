class extends="testbox.system.BaseSpec" {
	function run() {
			describe( "Modernization proposal orchestration", () => {
			it( "preserves millisecond timestamps without int overflow", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": { targetUnits: [ { id: "seed-unit", targetPath: "app/handlers/Seed.bx", newProposal: true, proposalReason: "timestamp seed" } ], unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: [] },
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": { roadmapPhases: [], assumptions: [], samples: [] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose( "run-timestamp", { startedAt: getTickCount(), target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000, maxIterations: 2 } }, { coverage: {}, inventory: {}, schemaEvidence: {} } );
				expect( result.ok ).toBeTrue();
				expect( gateway.callCount() ).toBe( 4 );
			} );

			it( "merges role fragments, adds stable identities and sorts deterministically", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": { targetUnits: [ { id: "z-unit", targetPath: "app/z.bx" }, { id: "a-unit", targetPath: "app/a.bx" } ], unitLinks: [], routeContracts: [], contexts: [ { id: "ctx-1", evidenceRefs: [ { filePath: "index.cfm" } ] } ], extracts: [], samples: [] },
					"modernization-database": {
						dbFindings: [],
						dbTransitions: [
							{ id: "transition-2", order: 2, operation: "expand", migrationPath: "resources/database/migrations/2025_03_25_121000_add_indexes.cfm", evidenceRefs: "[ schema.sql##L2 ]", objectsTouched: "[ orders ]" },
							{ id: "transition-1", order: 1, operation: "expand", migrationPath: "resources/database/migrations/20250325120000_expand_password.bx" }
						],
						samples: []
					},
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": { roadmapPhases: [ { id: "phase-2" }, { id: "phase-1" } ], assumptions: [], samples: [] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				expect( service.agentGateway.isEnabled() ).toBeTrue();
				var result = service.propose( "run-1", { target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 10000, maxIterations: 2 } }, { coverage: {}, inventory: {}, schemaEvidence: { contentHash: "schema-content-fp" } } );
				expect( result.ok ).toBeTrue();
				expect( result.plan.target.units[ 1 ].id ).toBe( "a-unit" );
				expect( result.plan.target.units[ 1 ].itemFingerprint ).notToBeEmpty();
				expect( result.plan.roadmapPhases[ 1 ].id ).toBe( "phase-1" );
				expect( result.plan.dbTransitions[ 1 ].id ).toBe( "transition-1" );
				expect( result.plan.dbTransitions[ 1 ].migrationPath ).toInclude( "2025_03_25_120000_expand_password.bx" );
				expect( result.plan.dbTransitions[ 2 ].migrationPath ).toInclude( "2025_03_25_121000_add_indexes.bx" );
				expect( result.plan.dbTransitions[ 2 ].evidenceRefs ).toBeArray();
				expect( result.plan.dbTransitions[ 2 ].evidenceRefs[ 1 ] ).toBe( "schema.sql##L2" );
				expect( result.plan.dbTransitions[ 2 ].objectsTouched ).toBeArray();
				expect( result.plan.target.contexts[ 1 ].itemFingerprint ).notToBeEmpty();
				expect( result.plan.metadata.schemaFingerprint ).toBe( "schema-content-fp" );
				expect( gateway.callCount() ).toBe( 4 );
			} );

			it( "rewrites legacy source paths into legal target layout paths", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": { targetUnits: [ { id: "dashboard/index.cfm", proposedRole: "page", targetPath: "dashboard/index.cfm" } ], unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: [] },
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": { roadmapPhases: [], assumptions: [], samples: [] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose( "run-layout", { target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 10000, maxIterations: 2 } }, { coverage: {}, inventory: {}, schemaEvidence: {} } );
				expect( result.plan.target.units[ 1 ].sourcePath ).toBe( "dashboard/index.cfm" );
				expect( result.plan.target.units[ 1 ].targetPath ).toBe( "app/handlers/index.bx" );
			} );

			it( "normalizes ColdBox application paths, roadmap collections, and BoxLang samples", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": {
						targetUnits: [
							{ id: "root-app", targetPath: "app/config/Application.bx", sourcePath: "Application.cfc", layer: "config" },
							{ id: "nested-app", targetPath: "app/config/Application.bx", sourcePath: "dashboard/Application.cfc", layer: "config" },
							{ id: "dashboard-handler", targetPath: "app/handlers/Dashboard.bx", sourcePath: "dashboard/index.cfm", layer: "handler" }
						],
						unitLinks: [ { id: "link-dashboard", legacyUnitId: "legacy-dashboard", sourcePath: "dashboard/index.cfm", targetUnitId: "dashboard-handler", evidenceRefs: [ { filePath: "dashboard/index.cfm", startLine: 1, endLine: 2 } ] } ],
						routeContracts: [ { id: "route-dashboard", path: "/dashboard/index.cfm", method: "GET", targetUnitId: "dashboard-handler", unitLinkId: "link-dashboard", evidence: [ { filePath: "dashboard/index.cfm", startLine: 1, endLine: 1 } ] } ],
						contexts: [],
						extracts: [],
						samples: [ { id: "sample-dashboard", sampleKind: "handler", targetPath: "app/handlers/Dashboard.cfc", language: "boxlang", body: "class {}", relatedItemIds: [ "dashboard-handler" ], irreversible: false, phaseId: "phase-dashboard" } ]
					},
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": {
						roadmapPhases: [ { id: "phase-dashboard", unitIds: [ "dashboard-handler", "route-dashboard" ], routeIds: [], sampleIds: [ "sample-dashboard" ], dependencies: [], currentSlice: true } ],
						assumptions: [ "Keep coexistence", "keep coexistence" ],
						samples: []
					}
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var inventory = {
					units: [
						{ id: "legacy-root", filePath: "Application.cfc" },
						{ id: "legacy-nested", filePath: "dashboard/Application.cfc" },
						{ id: "legacy-dashboard", filePath: "dashboard/index.cfm" }
					]
				};

				var result = service.propose(
					"run-normalize",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, samplePolicy: { maxFiles: 20, currentPhasesOnly: true }, budgets: { maxTasks: 3, maxDurationMs: 10000, maxIterations: 2 } },
					{ coverage: {}, inventory: inventory, schemaEvidence: {} }
				);

				expect( result.plan.target.units.filter( ( item ) => item.id == "root-app" )[ 1 ].targetPath ).toBe( "Application.bx" );
				expect( result.plan.target.units.filter( ( item ) => item.id == "nested-app" )[ 1 ].targetPath ).toBe( "app/config/dashboardApplicationLifecycle.bx" );
				expect( result.plan.roadmapPhases[ 1 ].unitIds ).toBe( [ "dashboard-handler" ] );
				expect( result.plan.roadmapPhases[ 1 ].routeIds ).toBe( [ "route-dashboard" ] );
				expect( result.plan.samples[ 1 ].targetPath ).toBe( "app/handlers/Dashboard.bx" );
				expect( result.plan.samples[ 1 ].code ).toBe( "class {}" );
				expect( result.plan.assumptions ).toHaveLength( 1 );
			} );

			it( "resolves cross-shard target collisions and omits routes without route evidence", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": {
						targetUnits: [
							{ id: "dashboard-index", targetPath: "app/handlers/index.bx", sourcePath: "dashboard/index.cfm", layer: "handler" },
							{ id: "login-index", targetPath: "app/handlers/index.bx", sourcePath: "webportal/login/index.cfm", layer: "handler" },
							{ id: "root-index", targetPath: "app/handlers/index.bx", sourcePath: "index.cfm", layer: "handler" },
							{ id: "dashboard-app-config", targetPath: "app/config/Application.bx", sourcePath: "dashboard/Application.cfc", layer: "config" },
							{ id: "dashboard-app-interceptor", targetPath: "app/interceptors/Application.bx", sourcePath: "dashboard/Application.cfc", layer: "interceptor" },
							{ id: "dashboard-view", targetPath: "app/views/dashboard.bx", sourcePath: "dashboard/index.cfm", layer: "view" }
						],
						unitLinks: [
							{ id: "dashboard-link", sourcePath: "dashboard/index.cfm", targetUnitId: "dashboard-index", evidenceRefs: [ { filePath: "dashboard/index.cfm", startLine: 1, endLine: 1 } ] }
						],
						routeContracts: [
							{ id: "dashboard-route", path: "/dashboard", method: "GET", targetUnitId: "dashboard-index", unitLinkId: "dashboard-link", evidence: [ { filePath: "dashboard/index.cfm", startLine: 1, endLine: 1 } ] },
							{ id: "invented-route", path: "/invented", method: "GET", targetUnitId: "dashboard-index", unitLinkId: "dashboard-link", evidence: [] }
						],
						contexts: [],
						extracts: [],
						samples: []
					}
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();

				var result = service.propose(
					"run-collisions",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 1, maxDurationMs: 10000 } },
					{ coverage: {}, inventory: { units: [] }, schemaEvidence: {} }
				);

				var paths = result.plan.target.units.map( ( item ) => item.targetPath );
				var uniquePaths = {};
				for ( var path in paths ) uniquePaths[ lCase( path ) ] = true;
				expect( paths.len() ).toBe( uniquePaths.count() );
				expect( paths ).toInclude( "app/handlers/dashboard.bx" );
				expect( paths ).toInclude( "app/handlers/login.bx" );
				expect( paths ).toInclude( "app/handlers/Main.bx" );
				expect( paths ).toInclude( "app/config/dashboardApplicationLifecycle.bx" );
				expect( paths ).toInclude( "app/interceptors/dashboardApplicationLifecycle.bx" );
				expect( paths ).toInclude( "app/views/dashboard.bxm" );
				expect( result.plan.routeContracts.map( ( item ) => item.id ) ).toBe( [ "dashboard-route" ] );
			} );

			it( "ignores non-object provider collection entries without crashing", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": { targetUnits: [ "invalid target" ], unitLinks: [ "invalid link" ], routeContracts: [], contexts: [], extracts: [], samples: [ "invalid sample" ] },
					"modernization-database": { dbFindings: [ "invalid finding" ], dbTransitions: [], samples: [] },
					"modernization-roadmap": { roadmapPhases: [ "invalid phase" ], assumptions: [], samples: [ "invalid roadmap sample" ] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose( "run-malformed-items", { target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 10000, maxIterations: 2 } }, { coverage: {}, inventory: {}, schemaEvidence: {} } );
				expect( result.ok ).toBeTrue();
				expect( result.partial ).toBeTrue();
				expect( result.plan.target.units ).toBeEmpty();
				expect( result.plan.samples ).toBeEmpty();
				expect( result.errors.filter( ( item ) => item.message == "ignored-non-object-items" ) ).toBeEmpty();
				expect( ( result.notes ?: [] ).filter( ( item ) => item.message == "ignored-non-object-items" ) ).notToBeEmpty();
				expect( result.errors.filter( ( item ) => item.message == "empty-application-fragment" ) ).notToBeEmpty();
			} );

			it( "uses one modular-monolith context unless an extraction boundary is explicitly established", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": {
						targetUnits: [
							{ id: "cfg-1", targetPath: "app/config/Coldbox.bx", sourcePath: "config/Coldbox.cfc", purpose: "config" },
							{ id: "songs-h", targetPath: "app/handlers/Songs.bx", sourcePath: "handlers/Songs.cfc", purpose: "songs list" },
							{ id: "songs-s", targetPath: "app/models/services/SongService.bx", sourcePath: "model/SongService.cfc", purpose: "songs service" },
							{ id: "http-w", targetPath: "app/models/services/TunesHttpGateway.bx", sourcePath: "model/TunesHttpGateway.cfc", purpose: "http api worker", layer: "service" }
						],
						unitLinks: [],
						routeContracts: [ { id: "route-songs", path: "/songs", method: "GET", targetUnitId: "songs-h" } ],
						contexts: [],
						extracts: [],
						samples: []
					},
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": { roadmapPhases: [ { id: "phase-1", name: "Slice", unitIds: [ "songs-h" ], routeIds: [ "route-songs" ], currentSlice: true } ], assumptions: [], samples: [] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose(
					"run-arch",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000, maxIterations: 2 } },
					{ coverage: {}, inventory: {}, schemaEvidence: {}, signals: [ { signalId: "http.outbound", meaning: "Outbound HTTP integration" } ] }
				);
				expect( result.ok ).toBeTrue();
				expect( result.plan.target.contexts ).notToBeEmpty();
				expect( result.plan.target.contexts.filter( ( item ) => item.packaging == "centralized" ) ).notToBeEmpty();
				expect( result.plan.target.contexts.filter( ( item ) => item.packaging == "coldbox-module" ) ).toBeEmpty();
				expect( result.plan.target.extracts ).toBeEmpty();
				expect( result.plan.target.contexts.filter( ( item ) => !( isArray( item.evidenceRefs ?: "" ) && item.evidenceRefs.len() ) ) ).toBeEmpty();
				expect( result.plan.unitLinks.filter( ( item ) => listFindNoCase( "module-extract,extract-side-app", item.relation ?: "" ) ) ).toBeEmpty();
				expect( result.partial ).toBeFalse();
				expect( result.errors.filter( ( item ) => item.message == "synthesized-architecture-packaging" ) ).toBeEmpty();
				expect( ( result.notes ?: result.plan.generationNotes ?: [] ).filter( ( item ) => item.message == "synthesized-architecture-packaging" ) ).notToBeEmpty();
			} );

			it( "runs the architecture role before roadmap and merges its labeled packaging groups", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": {
						targetUnits: [
							{ id: "pdf-h", targetPath: "app/handlers/Pdf.bx", sourcePath: "handlers/Pdf.cfc", purpose: "pdf tools" },
							{ id: "pdf-s", targetPath: "app/models/services/PdfService.bx", sourcePath: "model/PdfService.cfc", purpose: "pdf tools" }
						],
						unitLinks: [],
						routeContracts: [],
						contexts: [],
						extracts: [],
						samples: []
					},
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": {
						contexts: [ {
							id: "ctx-pdf-tools",
							name: "PDF tools",
							packaging: "coldbox-module",
							targetUnitIds: [ "pdf-h", "pdf-s" ],
							recommendation: "Group the PDF handler and service; no deployment seam observed yet",
							evidenceBasis: "domain-clustering",
							evidenceRefs: [ { filePath: "handlers/Pdf.cfc" } ]
						} ],
						extracts: []
					},
					"modernization-roadmap": { roadmapPhases: [ { id: "phase-pdf", unitIds: [ "pdf-h", "pdf-s" ] } ], assumptions: [], samples: [] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose(
					"run-architecture-pass",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000, maxIterations: 2 } },
					{ coverage: {}, inventory: {}, schemaEvidence: {} }
				);
				expect( result.ok ).toBeTrue();
				expect( result.partial ).toBeFalse();
				var modules = result.plan.target.contexts.filter( ( item ) => item.packaging == "coldbox-module" );
				expect( modules ).toHaveLength( 1 );
				expect( modules[ 1 ].evidenceBasis ).toBe( "domain-clustering" );
				expect( modules[ 1 ].itemFingerprint ).notToBeEmpty();
				expect( result.errors.filter( ( item ) => item.message == "synthesized-architecture-packaging" ) ).toBeEmpty();
				var roles = gateway.requestLog().map( ( item ) => item.role );
				expect( roles.findNoCase( "modernization-architecture" ) ).toBeGT( 0 );
				expect( roles.findNoCase( "modernization-roadmap" ) ).toBeGT( 0 );
				expect( roles.findNoCase( "modernization-architecture" ) ).toBeLT( roles.findNoCase( "modernization-roadmap" ) );
			} );

			it( "synthesizes a mapped roadmap when the provider roadmap is skipped for cost", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": {
						targetUnits: [
							{ id: "cfg-1", targetPath: "app/config/Coldbox.bx", sourcePath: "config/Coldbox.cfc", purpose: "config" },
							{ id: "songs-1", targetPath: "app/handlers/Songs.bx", sourcePath: "handlers/Songs.cfc", purpose: "songs" },
							{ id: "artists-1", targetPath: "app/models/services/ArtistService.bx", sourcePath: "model/ArtistService.cfc", purpose: "artists" }
						],
						unitLinks: [],
						routeContracts: [ { id: "route-songs", path: "/songs", method: "GET", targetUnitId: "songs-1" } ],
						contexts: [],
						extracts: [],
						samples: []
					},
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": { throw: true, message: "cost-budget-exceeded" }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose(
					"run-synth-road",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000, maxIterations: 2 } },
					{ coverage: {}, inventory: {}, schemaEvidence: {} }
				);
				expect( result.ok ).toBeTrue();
				expect( result.plan.target.units ).notToBeEmpty();
				expect( result.plan.roadmapPhases ).notToBeEmpty();
				expect( result.plan.roadmapPhases.filter( ( phase ) => phase.currentSlice ?: false ) ).notToBeEmpty();
				expect( result.plan.roadmapPhases.filter( ( phase ) => ( phase.unitIds ?: [] ).len() ).len() ).toBeGTE( 1 );
				expect( result.errors.filter( ( item ) => item.message == "synthesized-from-application-maps" ) ).toBeEmpty();
				expect( ( result.notes ?: result.plan.generationNotes ?: [] ).filter( ( item ) => item.message == "synthesized-from-application-maps" ) ).notToBeEmpty();
			} );

			it( "does not reserve disabled downstream-role budget from an application-only run", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": {
						targetUnits: [ { id: "app-only", targetPath: "app/handlers/AppOnly.bx", sourcePath: "index.cfm" } ],
						unitLinks: [],
						routeContracts: [],
						contexts: [],
						extracts: [],
						samples: []
					}
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();

				var result = service.propose(
					"run-app-only-budget",
					{
						target: { runtime: "boxlang", layoutProfile: "modern" },
						budgets: {
							maxTasks: 1,
							maxDurationMs: 300000,
							maxCostUsd: 5,
							maxApplicationShards: 1,
							applicationShardSize: 4,
							applicationShardConcurrency: 1
						}
					},
					{
						coverage: {},
						inventory: { files: [ { filePath: "index.cfm" } ], units: [ { id: "legacy-index", filePath: "index.cfm" } ] },
						schemaEvidence: {}
					},
					{ maxRetries: 0 }
				);

				expect( result.ok ).toBeTrue();
				var appOptions = gateway.optionsHistory().filter( ( item ) => ( item.role ?: "" ) == "modernization-application" );
				expect( appOptions ).toHaveLength( 1 );
				expect( appOptions[ 1 ].budgets.maxCostUsd ).toBe( 5 );
				expect( appOptions[ 1 ].maxDurationMs ).toBeGTE( 299000 );
				expect( appOptions[ 1 ].maxRetries ).toBe( 0 );
			} );

			it( "merges multiple application shards and keeps going when one shard fails", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": [
						{ targetUnits: [ { id: "app-cfc", targetPath: "app/Application.bx", sourcePath: "Application.cfc", newProposal: false, purpose: "bootstrap" } ], unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: [] },
						{ throw: true, message: "Provider JSON was truncated mid-object" },
						{ targetUnits: [ { id: "song-svc", targetPath: "app/models/services/SongService.bx", sourcePath: "model/SongService.cfc", purpose: "songs" } ], unitLinks: [ { id: "link-song", legacyUnitId: "song-1", targetUnitId: "song-svc" } ], routeContracts: [ { id: "route-songs", path: "/songs", method: "GET" } ], contexts: [], extracts: [], samples: [] }
					],
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": { roadmapPhases: [ { id: "phase-1", name: "Foundation", unitIds: [ "app-cfc", "song-svc" ], routeIds: [ "route-songs" ] } ], assumptions: [], samples: [] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var evidence = {
					inventory: {
						units: [
							{ id: "u1", filePath: "Application.cfc" },
							{ id: "u2", filePath: "config/Coldbox.cfc" },
							{ id: "u3", filePath: "model/SongService.cfc" },
							{ id: "u4", filePath: "model/ArtistService.cfc" },
							{ id: "u5", filePath: "handlers/Songs.cfc" },
							{ id: "u6", filePath: "views/songs/list.cfm" },
							{ id: "u7", filePath: "model/AlbumService.cfc" },
							{ id: "u8", filePath: "model/PlaylistService.cfc" },
							{ id: "u9", filePath: "model/UserService.cfc" }
						],
						routeEvidence: [],
						dependencies: [],
						unresolved: []
					},
					coverage: {},
					schemaEvidence: {}
				};
				var result = service.propose(
					"run-shards",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000, maxIterations: 2, maxCostUsd: 5, maxApplicationShards: 3, applicationShardSize: 3, applicationShardConcurrency: 3 } },
					evidence
				);
				expect( result.ok ).toBeTrue();
				expect( gateway.callCount() ).toBe( 6 );
				expect( result.plan.target.units.len() ).toBeGTE( 2 );
				expect( result.plan.routeContracts ).toBeEmpty();
				expect( ( result.notes ?: [] ).filter( ( item ) => item.message == "omitted-unbacked-route" ) ).notToBeEmpty();
				expect( result.plan.roadmapPhases ).notToBeEmpty();
				expect( result.errors.filter( ( item ) => findNoCase( "truncated", item.message ?: "" ) ).len() ).toBeGTE( 1 );
				expect( result.plan.metadata.applicationShards.accepted ).toBe( 2 );
				expect( result.plan.metadata.applicationShards.total ).toBe( 3 );
				expect( result.plan.metadata.applicationShards.failed ).toBe( 1 );
				expect( result.plan.metadata.applicationShards.outcomes.filter( ( item ) => item.status == "failed" ) ).toHaveLength( 1 );
				expect( result.plan.metadata.applicationShards.outcomes.every( ( item ) => item.keyExists( "durationMs" ) && item.keyExists( "costUsd" ) && item.keyExists( "outputCharacters" ) ) ).toBeTrue();
				expect( result.plan.coverage.llm.status ).toBe( "incomplete" );
				expect( result.plan.coverage.llm.gaps ).notToBeEmpty();
				expect( result.plan.metadata.provenanceContract.version ).toBe( "modernization-provenance-v1" );
				expect( result.plan.target.units.every( ( item ) => len( item.provenanceClass ?: "" ) > 0 ) ).toBeTrue();
				expect( result.plan.target.units.filter( ( item ) => findNoCase( "Coverage fallback", item.purpose ?: "" ) ).every( ( item ) => item.provenanceClass == "deterministically-derived" ) ).toBeTrue();
				var coveredPaths = {};
				for ( var target in result.plan.target.units ) if ( len( target.sourcePath ?: "" ) ) coveredPaths[ lCase( target.sourcePath ) ] = true;
				for ( var link in result.plan.unitLinks ) if ( len( link.sourcePath ?: "" ) ) coveredPaths[ lCase( link.sourcePath ) ] = true;
				for ( var inventoryUnit in evidence.inventory.units ) expect( coveredPaths ).toHaveKey( lCase( inventoryUnit.filePath ) );
				expect( ( result.notes ?: [] ).filter( ( item ) => item.message == "inventory-coverage-fallback" ) ).notToBeEmpty();
				var appOptions = gateway.optionsHistory().filter( ( item ) => ( item.role ?: "" ) == "modernization-application" );
				expect( appOptions ).toHaveLength( 3 );
				expect( appOptions.every( ( item ) => val( item.budgets.maxCostUsd ?: 0 ) <= 1.34 ) ).toBeTrue();
				expect( appOptions.every( ( item ) => val( item.maxDurationMs ?: 0 ) > 90000 ) ).toBeTrue();
			} );

			it( "retains accepted application fragments when cancellation arrives between shards", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": [
						{ targetUnits: [ { id: "accepted-first", targetPath: "app/handlers/First.bx", sourcePath: "first.cfm" } ], unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: [] },
						{ targetUnits: [ { id: "should-not-run", targetPath: "app/handlers/Second.bx", sourcePath: "second.cfm" } ], unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: [] }
					]
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var evidence = {
					inventory: {
						files: [
							{ filePath: "first.cfm", lineCount: 1 },
							{ filePath: "second.cfm", lineCount: 1 },
							{ filePath: "third.cfm", lineCount: 1 }
						],
						units: [
							{ id: "first-unit", filePath: "first.cfm" },
							{ id: "second-unit", filePath: "second.cfm" },
							{ id: "third-unit", filePath: "third.cfm" }
						]
					},
					coverage: {},
					schemaEvidence: {}
				};
				var result = service.propose(
					"run-cancel-between-shards",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000, applicationShardSize: 2, applicationShardConcurrency: 1 } },
					evidence,
					{ isCancelled: () => gateway.callCount() >= 1 }
				);
				expect( result.ok ).toBeTrue();
				expect( result.partial ).toBeTrue();
				expect( result.plan.target.units.map( ( item ) => item.id ) ).toInclude( "accepted-first" );
				expect( result.plan.target.units.filter( ( item ) => item.id == "accepted-first" ) ).toHaveLength( 1 );
				expect( result.plan.coverage.llm.status ).toBe( "incomplete" );
				expect( result.plan.coverage.llm.gaps.some( ( item ) => ( item.reason ?: "" ) == "cancelled" ) ).toBeTrue();
				expect( result.errors.some( ( item ) => ( item.message ?: "" ) == "cancelled-after-partial-acceptance" ) ).toBeTrue();
			} );

			it( "keeps application fragments when sample code mentions password assignments", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": {
						targetUnits: [ { id: "auth-unit", targetPath: "app/models/AuthService.bx", purpose: "Move password validation into a service", sampleCode: "function login() { var password = form.password; return password; }", newProposal: true, proposalReason: "auth extract" } ],
						unitLinks: [],
						routeContracts: [ { id: "login-route", path: "/login", method: "POST" } ],
						contexts: [],
						extracts: [],
						samples: [ { id: "auth-sample", kind: "target-unit", sampleCode: "token = request.token" } ]
					},
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": { roadmapPhases: [ { id: "phase-1", name: "Auth first", unitIds: [ "auth-unit" ], routeIds: [ "login-route" ] } ], assumptions: [], samples: [] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose( "run-redact-safe", { target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 10000, maxIterations: 2 } }, { coverage: {}, inventory: {}, schemaEvidence: {} } );
				expect( result.ok ).toBeTrue();
				expect( result.errors.filter( ( item ) => item.message == "redaction-failed" ) ).toBeEmpty();
				expect( result.plan.target.units ).notToBeEmpty();
				expect( result.plan.target.units[ 1 ].id ).toBe( "auth-unit" );
				expect( result.plan.routeContracts ).toBeEmpty();
				expect( result.plan.roadmapPhases ).notToBeEmpty();
			} );

			it( "skips roadmap when the application role returns only empty collections", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": { targetUnits: [], unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: [] },
					"modernization-database": { dbFindings: [ { id: "db-1", problem: "schema absent" } ], dbTransitions: [], samples: [] },
					"modernization-roadmap": { roadmapPhases: [ { id: "phase-hollow", name: "Should not appear" } ], assumptions: [], samples: [] }
				} );
