				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose(
					"run-sample-prune",
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 3, maxDurationMs: 900000, maxIterations: 2 } },
					{ coverage: {}, inventory: {}, schemaEvidence: {} }
				);
				expect( result.ok ).toBeTrue();
				// Only the current slice's sample survives pruning...
				expect( result.plan.samples.map( ( item ) => item.id ) ).toBe( [ "sample-a" ] );
				// ...so phase-b must not keep referencing the sample that got pruned.
				var phaseB = result.plan.roadmapPhases.filter( ( item ) => item.id == "phase-b" )[ 1 ];
				expect( phaseB.sampleIds ).toBeEmpty();
				var phaseA = result.plan.roadmapPhases.filter( ( item ) => item.id == "phase-a" )[ 1 ];
				expect( phaseA.sampleIds ).toBe( [ "sample-a" ] );
			} );

