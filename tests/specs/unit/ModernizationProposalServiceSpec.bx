					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": {
						roadmapPhases: [
							{ id: "phase-a", unitIds: [ "u1" ], currentSlice: true, sampleIds: [ "sample-a" ] },
							{ id: "phase-b", unitIds: [ "u2" ], currentSlice: false, sampleIds: [ "sample-b" ] }
						],
						assumptions: [],
						samples: [
							{ id: "sample-a", sampleKind: "app", targetPath: "app/handlers/A.bx", language: "boxlang", code: "component {}" },
							{ id: "sample-b", sampleKind: "app", targetPath: "app/handlers/B.bx", language: "boxlang", code: "component {}" }
						]
					}
				} );
