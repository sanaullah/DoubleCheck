			it( "backfills roadmap classification wave risks and strategies for synth and LLM phases", () => {
				var service = new app.models.services.ModernizationProposalService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				makePublic( service, "polishPlan" );
				var polished = service.polishPlan( {
					metadata: { runtime: { runtime: "boxlang" }, architectureSource: "synthesized", roadmapSource: "synthesized" },
					target: {
						units: [
							{ id: "tu-job", targetPath: "app/handlers/Jobs.bx", sourcePath: "legacy/_scheduledScripts/job.cfm" },
							{ id: "tu-mod", targetPath: "app/modules/feature/ModuleConfig.bx", sourcePath: "legacy/modules/feature/ModuleConfig.cfc" }
						],
						placements: [
							{ id: "pl-job", placementType: "scheduled-service", targetUnitIds: [ "tu-job" ] },
							{ id: "pl-mod", placementType: "coldbox-module", targetUnitIds: [ "tu-mod" ] }
						],
						contexts: [],
						extracts: []
					},
					unitLinks: [],
					routeContracts: [],
					dbFindings: [],
					dbTransitions: [],
					roadmapPhases: [
						{ id: "phase-empty", unitIds: [ "tu-job" ], classification: "", wave: "", risks: [], rollbackStrategy: "", testingStrategy: "", estimatedComplexity: "" },
						{ id: "phase-llm", unitIds: [ "tu-mod" ], classification: "coldbox-module", wave: 2, risks: [ "Module ownership drift" ], rollbackStrategy: "Disable module route", testingStrategy: "Module boot smoke", estimatedComplexity: "medium" }
					],
					samples: [],
					assumptions: []
				} );
				var emptyPhase = polished.roadmapPhases.filter( ( item ) => item.id == "phase-empty" )[ 1 ];
				var llmPhase = polished.roadmapPhases.filter( ( item ) => item.id == "phase-llm" )[ 1 ];
				expect( emptyPhase.classification ).toBe( "scheduled-service" );
				expect( val( emptyPhase.wave ) ).toBeGTE( 1 );
				expect( emptyPhase.risks ).notToBeEmpty();
				expect( len( trim( emptyPhase.rollbackStrategy ?: "" ) ) ).toBeGT( 0 );
				expect( len( trim( emptyPhase.testingStrategy ?: "" ) ) ).toBeGT( 0 );
				expect( emptyPhase.estimatedComplexity ).toBe( "low" );
				expect( llmPhase.classification ).toBe( "coldbox-module" );
				expect( llmPhase.wave ).toBe( 2 );
				expect( llmPhase.risks[ 1 ] ).toBe( "Module ownership drift" );
				expect( llmPhase.rollbackStrategy ).toBe( "Disable module route" );
				expect( llmPhase.testingStrategy ).toBe( "Module boot smoke" );
				expect( llmPhase.estimatedComplexity ).toBe( "medium" );
			} );

			it( "drops unitLinks whose targetUnitId cannot be resolved after alias repair", () => {
				var service = new app.models.services.ModernizationProposalService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				makePublic( service, "polishPlan" );
				var polished = service.polishPlan( {
					metadata: { runtime: { runtime: "boxlang" } },
					target: {
						units: [ { id: "canonical-song", targetPath: "app/models/services/SongService.bx", sourcePath: "models/SongService.cfc" } ],
						placements: [],
						contexts: [],
						extracts: []
					},
					unitLinks: [
						{ id: "link-ok", sourcePath: "models/SongService.cfc", targetUnitId: "canonical-song" },
						{ id: "link-path", sourcePath: "models/SongService.cfc", targetUnitId: "models/SongService.cfc" },
						{ id: "link-phantom", sourcePath: "models/Other.cfc", targetUnitId: "targetUnit-2" },
						{ id: "link-hash", sourcePath: "models/Missing.cfc", targetUnitId: "946d79410175ad26f08439e32f6d785a72d75e43ac6e0356674561f7a1df6780" }
					],
					routeContracts: [],
					dbFindings: [],
					dbTransitions: [],
					roadmapPhases: [ { id: "phase-1", unitIds: [ "canonical-song" ], currentSlice: true } ],
					samples: [],
					assumptions: []
				}, {}, [] );
				expect( polished.unitLinks.len() ).toBe( 2 );
				expect( polished.unitLinks.map( ( item ) => item.id ) ).toBe( [ "link-ok", "link-path" ] );
				expect( polished.unitLinks[ 2 ].targetUnitId ).toBe( "canonical-song" );
			} );

			it( "keeps current-slice samples by relatedItemIds and synthesizes when empty", () => {
				var service = new app.models.services.ModernizationProposalService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				makePublic( service, "polishPlan" );
				var withRelated = service.polishPlan( {
					metadata: { runtime: { runtime: "boxlang" }, samplePolicy: { currentPhasesOnly: true } },
					target: {
						units: [
							{ id: "u1", targetPath: "app/handlers/Playlist.bx", sourcePath: "views/playlist/index.cfm", layer: "handler" },
							{ id: "u2", targetPath: "app/handlers/Other.bx", sourcePath: "views/other/index.cfm", layer: "handler" }
						],
						placements: [],
						contexts: [],
						extracts: []
					},
					unitLinks: [],
					routeContracts: [],
					dbFindings: [],
					dbTransitions: [],
					roadmapPhases: [
						{ id: "phase-current", unitIds: [ "u1" ], currentSlice: true, sampleIds: [] },
						{ id: "phase-later", unitIds: [ "u2" ], currentSlice: false, sampleIds: [] }
					],
					samples: [
						{ id: "sample-related", sampleKind: "app", targetPath: "app/handlers/Playlist.bx", language: "boxlang", code: "class {}", relatedItemIds: [ "u1" ], irreversible: false },
						{ id: "sample-other", sampleKind: "app", targetPath: "app/handlers/Other.bx", language: "boxlang", code: "class {}", relatedItemIds: [ "u2" ], irreversible: false }
					],
					assumptions: []
				}, { currentPhasesOnly: true, maxFiles: 10 }, [] );
				expect( withRelated.samples.map( ( item ) => item.id ) ).toBe( [ "sample-related" ] );

				var synthesized = service.polishPlan( {
					metadata: { runtime: { runtime: "boxlang" } },
					target: {
						units: [ { id: "u1", targetPath: "app/handlers/Playlist.bx", sourcePath: "views/playlist/index.cfm", layer: "handler" } ],
						placements: [],
						contexts: [],
						extracts: []
					},
					unitLinks: [],
					routeContracts: [],
					dbFindings: [],
					dbTransitions: [],
					roadmapPhases: [ { id: "phase-current", unitIds: [ "u1" ], currentSlice: true, sampleIds: [] } ],
					samples: [],
					assumptions: []
				}, { currentPhasesOnly: true, maxFiles: 10 }, [] );
				expect( synthesized.samples ).notToBeEmpty();
				expect( synthesized.samples[ 1 ].provenanceClass ).toBe( "deterministically-derived" );
				expect( synthesized.samples[ 1 ].code ).toInclude( "not observed source" );
				expect( synthesized.roadmapPhases[ 1 ].sampleIds ).notToBeEmpty();
			} );

			it( "synthesizes database findings from observed schema when the provider fails", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-application": { targetUnits: [ { id: "seed-unit", targetPath: "app/handlers/Seed.bx", sourcePath: "legacy/seed.cfm", newProposal: true, proposalReason: "seed" } ], unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: [] },
					"modernization-database": { throw: true, message: "Provider JSON was truncated mid-object", errorType: "truncated_json" },
					"modernization-architecture": { placements: [ { id: "pl-1", domainKey: "seed", placementType: "main-app", targetUnitIds: [ "seed-unit" ] } ], contexts: [], extracts: [] },
					"modernization-roadmap": { roadmapPhases: [ { id: "phase-1", unitIds: [ "seed-unit" ], currentSlice: true } ], assumptions: [], samples: [] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.propose(
					"run-db-synth",
					{ startedAt: getTickCount(), target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxTasks: 4, maxDurationMs: 900000, maxIterations: 2 } },
					{
						coverage: {},
						inventory: { files: [ { filePath: "legacy/seed.cfm" } ], units: [ { id: "inv-1", filePath: "legacy/seed.cfm" } ] },
						schemaEvidence: { coverage: "partial-ddl", sourceKind: "auto-discovered", tables: [ { name: "songs" }, { name: "playlists" } ] }
					}
				);
				expect( result.ok ).toBeTrue( jsonSerialize( result.errors ?: [] ) );
				expect( result.plan.dbFindings.len() ).toBeGTE( 2 );
				expect( result.plan.dbTransitions.len() ).toBeGTE( 2 );
				expect( result.plan.dbFindings[ 1 ].provenanceClass ).toBe( "deterministically-derived" );
				expect( result.plan.metadata.databaseSource ).toBe( "synthesized" );
				expect( ( result.notes ?: [] ).some( ( item ) => ( item.message ?: "" ) == "synthesized-database-from-schema" ) ).toBeTrue();
			} );

			it( "repairs only the invalid fingerprint-listed item", () => {
				var gateway = new tests.resources.ScriptedModernizationGateway( responses = {
					"modernization-repair": { replacements: [ { itemFingerprint: "bad-fp", item: { id: "provider-must-not-change-id", targetPath: "app/Fixed.bx" } } ] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
				service.agentGateway = gateway;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				service.identityService = new app.models.services.ModernizationIdentityService();
				var result = service.repair(
					"run-4",
					{ schemaVersion: "modernization-plan-v1", target: { units: [ { id: "unit-1", itemFingerprint: "bad-fp", targetPath: "../bad.cfc" }, { id: "unit-2", itemFingerprint: "good-fp", targetPath: "app/Good.bx" } ] } },
					{ blocking: 1, messages: [ { category: "target.units", level: "blocking", itemId: "unit-1", message: "unsafe path" } ] },
					{ target: { runtime: "boxlang", layoutProfile: "modern" }, budgets: { maxIterations: 2 } },
					{},
					1
				);
				expect( result.repaired ).toBeTrue();
				expect( result.plan.target.units[ 1 ].id ).toBe( "unit-1" );
				expect( result.plan.target.units[ 1 ].targetPath ).toBe( "app/Fixed.bx" );
				expect( result.plan.target.units[ 2 ].targetPath ).toBe( "app/Good.bx" );
			} );
		} );
	}
}
