						unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: []
					},
					"modernization-database": { dbFindings: [], dbTransitions: [], samples: [] },
					"modernization-architecture": { contexts: [], extracts: [] },
					"modernization-roadmap": { roadmapPhases: [ {
						id: "phase-pdf", unitIds: [ "pdf-h" ],
						migrationSteps: [ {
							order: 1, action: "Move PDF generation into a handler",
							legacyRef: { filePath: "handlers/Pdf.cfc", symbolName: "generate" },
							targetRef: { targetPath: "app/handlers/Pdf.bx", methodName: "generate" },
							note: "Preserve legacy query params"
						} ]
					} ], assumptions: [], samples: [] }
				} );
				var service = new app.models.services.ModernizationProposalService();
				service.agentFactory = new app.models.services.ModernizationAgentFactory();
