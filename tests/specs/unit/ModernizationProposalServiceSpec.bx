						],
						routeContracts: [
							{ id: "dashboard-route", path: "/dashboard", method: "GET", targetUnitId: "dashboard-index", unitLinkId: "dashboard-link", evidence: [ { filePath: "dashboard/index.cfm", startLine: 1, endLine: 1 } ] },
							{ id: "invented-route", path: "/invented", method: "GET", targetUnitId: "dashboard-index", unitLinkId: "dashboard-link", evidence: [] }
						],
						contexts: [],
						extracts: [],
						samples: []
					}
				} );
