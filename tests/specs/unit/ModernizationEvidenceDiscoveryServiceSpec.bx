class extends="testbox.system.BaseSpec" {
    function run() {
        describe( "Modernization evidence discovery", () => {
            it( "redacts credentials and excludes row DML from selected migration evidence", () => {
                var root = getTempDirectory() & "doublecheck-modernize-evidence-" & replace( createUUID(), "-", "", "all" );
                directoryCreate( root, true );
                try {
                    directoryCreate( root & "/migrations", true );
                    fileWrite( root & "/migrations/001.sql", "CREATE TABLE orders (id INT);" & char( 10 ) & "INSERT INTO orders VALUES (1);" & char( 10 ) & "password=hidden" );
                    var result = new app.models.services.ModernizationEvidenceDiscoveryService().discover( root, { migrationPaths: [ "migrations" ] } );
					expect( result.files.len() ).toBe( 1 );
                    expect( result.files[ 1 ].content ).notToInclude( "INSERT INTO" );
                    expect( result.files[ 1 ].content ).notToInclude( "hidden" );
                    expect( result.dmlRemoved ).toBeGT( 0 );
                } finally {
                    directoryDelete( root, true );
                }
            } );
        } );
    }
}
