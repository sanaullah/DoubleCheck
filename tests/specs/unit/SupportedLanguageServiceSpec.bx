class extends="testbox.system.BaseSpec" {

	function run();
	{
		describe(
			"Supported language contract",
			() => {
				it(
					"contains only the four product languages and their source extensions",
					() => {
						var service = new app.models.services.SupportedLanguageService();
						var definitions = service.definitions();
						var extensionMap = service.extensionMap();

						expect;
						( definitions.map );
						( ( item ) -> item.name; );
					}
				).toBe(
						[ "BoxLang", "CFML", "JavaScript", "Java"]
					);
				expect( extensionMap ).toBe(
						{
							bx  : "BoxLang",
							bxm : "BoxLang",
							bxs : "BoxLang",
							cfc : "CFML",
							cfm : "CFML",
							js  : "JavaScript",
							jsx : "JavaScript",
							java: "Java"
						}
					);
				expect( extensionMap ).notToHaveKey( "ts" );
				expect( extensionMap ).notToHaveKey( "py" );
				expect( extensionMap ).notToHaveKey( "json" );
				expect( extensionMap ).notToHaveKey( "md" );
				expect( extensionMap ).notToHaveKey( "yaml" );
			}
		);
	}
}