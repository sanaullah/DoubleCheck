class extends="testbox.system.BaseSpec" {

	function run() {
		describe(
			"CoverageAssessmentService",
			() => {
				it(
					"reports completed work and bounded remaining gaps",
					() => {
						var result = new app.models.services.CoverageAssessmentService().assess(
								{
									plan: {
										tasks: [
											{ id: "one", role: "security", files: [ "a.bx"] },
											{ id: "two", role: "testing", files: [ "b.bx"] },
											{ id: "three", role: "testing", files: [ "c.bx"] },
											{ id: "four", role: "performance", files: [ "d.bx"] }
										]
									},
									specialists: {
										results: [
											{ taskId: "one", status: "succeeded", error: "" },
											{
												taskId: "two",
												status: "failed",
												error : "Provider timeout"
											}
										]
									}
								}
							);
						expect( result.plannedTasks ).toBe( 4 );
						expect( result.completedTasks ).toBe( 1 );
						expect( result.gapCount ).toBe( 3 );
						expect( result.followUp.maxTasks ).toBe( 3 );
						expect( result.followUp.roles ).toInclude( "testing" );
						expect( result.followUp.roles ).toInclude( "performance" );
					}
				);

				it(
					"adds discovery gaps for truncated discovery and scan limits",
					() => {
						var coverage = new app.models.services.CoverageAssessmentService().assess(
								{
									plan              : { tasks: [] },
									specialists       : { results: [] },
									discoveryTruncated: true,
									skipped           : {
										ignored   : 0,
										oversized : 2,
										binary    : 0,
										unreadable: 0,
										limit     : 1
									}
								}
							);
						var reasons = coverage.gaps.map( ( gap ) => gap.reason );
						expect( reasons ).toInclude( "Repository discovery reached its configured limit" );
						expect( reasons ).toInclude( "2 files skipped as oversized" );
						expect( reasons ).toInclude( "1 candidate file skipped by file-count budget" );
					}
				);
			}
		);
	}
}