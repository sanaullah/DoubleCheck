class extends="testbox.system.BaseSpec" {

	function run() {
		describe(
			"RulePlaybookCatalog",
			() => {
				var catalog = "";

				beforeEach(
					() => {
						catalog = new app.models.services.RulePlaybookCatalog();
					}
				);

				it(
					"returns a playbook with steps for each deterministic ruleId",
					() => {
						var ruleIds = [
							"secrets/hardcoded-credential",
							"execution/dynamic-code",
							"database/query-interpolation",
							"errors/empty-catch",
							"maintenance/open-marker"
						];
						for ( var ruleId in ruleIds ) {
							var playbook = catalog.get( ruleId );
							expect( isNull( playbook ) ).toBeFalse( ruleId );
							expect( playbook.steps ).toBeArray();
							expect( playbook.steps.len() ).toBeGT( 0 );
						}
					}
				);

				it(
					"returns null for unknown ruleIds",
					() => {
						expect( isNull( catalog.get( "unknown/rule" ) ) ).toBeTrue();
					}
				);
			}
		);
	}
}