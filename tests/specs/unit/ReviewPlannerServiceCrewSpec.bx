class extends   ="coldbox.system.testing.BaseTestCase" appMapping="/app" {

	function beforeAll() {
		super.beforeAll();
	}

	function afterAll() {
		super.afterAll();
	}

	function run() {
		describe(
			"ReviewPlannerService LLM crew proposals",
			() => {
				beforeEach( () => setup() );

				it(
					"builds tasks from an LLM crew proposal including briefs",
					() => {
						var model = getInstance( "ArchitectureModelService" ).build(
								graphFixture(),
								fileFixtures(),
								"crew-llm"
							);
						var plan = getInstance( "ReviewPlannerService" ).plan(
								model,
								graphFixture(),
								fileFixtures(),
								{},
								{},
								{
									ok     : true,
									source : "llm",
									summary: "SQL and CFML focus",
									tasks  : [
										{
											role     : "security",
											priority : 95,
											objective: "Watch query construction",
											brief    : "Inspect string-built SQL in Orders.cfc"
										},
										{
											role          : "cfml-conventions",
											priority      : 85,
											objective     : "CFML depth",
											brief         : "Modernization assist only with evidence",
											emphasizeFiles: [ "legacy/Orders.cfc"]
										}
									]
								}
							);
						var data = plan.getMemento();

						expect( data.summary.crewSource ).toBe( "llm" );
						expect( data.summary.crewSummary ).toBe( "SQL and CFML focus" );
						expect( data.summary.selectedRoles ).toBe( [ "security", "cfml-conventions"] );
						expect( data.tasks ).toHaveLength( 2 );
						expect( data.tasks[ 1 ].brief ).toInclude( "string-built SQL" );
						expect( data.tasks[ 1 ].objective ).toBe( "Watch query construction" );
						expect( data.tasks[ 2 ].context.files[ 1 ].filePath ).toBe( "legacy/Orders.cfc" );
					}
				);

				it(
					"falls back to a deterministic crew when the proposal is invalid",
					() => {
						var model = getInstance( "ArchitectureModelService" ).build(
								graphFixture(),
								fileFixtures(),
								"crew-fallback"
							);
						var plan = getInstance( "ReviewPlannerService" ).plan(
								model,
								graphFixture(),
								fileFixtures(),
								{},
								{},
								{
									ok     : false,
									source : "none",
									summary: "",
									tasks  : [],
									error  : "disabled"
								}
							);
						var data = plan.getMemento();

						expect( data.summary.crewSource ).toBe( "deterministic" );
						expect( data.summary.crewSummary ).toBe( "Default crew" );
						expect( data.summary.selectedRoles ).toInclude( "security" );
						expect( data.summary.selectedRoles ).toInclude( "correctness" );
						var securityTasks = data.tasks.filter( ( task ) => task.role == "security" );
						expect( securityTasks ).toHaveLength( 1 );
						expect( securityTasks[ 1 ].brief ).toBe( "" );
					}
				);

				it(
					"adds a deterministic CFML brief without LLM crew",
					() => {
						var model = getInstance( "ArchitectureModelService" ).build(
								graphFixture(),
								fileFixtures(),
								"crew-deterministic-brief"
							);
						var plan = getInstance( "ReviewPlannerService" ).plan(
								model,
								graphFixture(),
								fileFixtures(),
								{},
								{},
								{
									ok     : false,
									source : "none",
									summary: "",
									tasks  : []
								}
							);
						var data = plan.getMemento();
						var cfmlTasks = data.tasks.filter( ( task ) => task.role == "cfml-conventions" );
						var securityTasks = data.tasks.filter( ( task ) => task.role == "security" );

						expect( cfmlTasks ).toHaveLength( 1 );
						expect( cfmlTasks[ 1 ].brief ).toInclude( "legacy/Orders.cfc" );
						expect( cfmlTasks[ 1 ].brief ).toInclude( "modernization" );
						expect( securityTasks ).toHaveLength( 1 );
						expect( securityTasks[ 1 ].brief ).toBe( "" );
					}
				);

				it(
					"emphasizes CFML paths for cfml-conventions without an LLM crew",
					() => {
						var graph = graphFixture();
						graph.symbols = graph.symbols.filter( ( symbol ) => symbol.filePath != "legacy/Orders.cfc" );
						graph.summary.symbolCount = graph.symbols.len();
						var model = getInstance( "ArchitectureModelService" ).build(
								graph,
								fileFixtures(),
								"crew-emphasize"
							);
						var plan = getInstance( "ReviewPlannerService" ).plan(
								model,
								graph,
								fileFixtures(),
								{},
								{},
								{
									ok     : false,
									source : "none",
									summary: "",
									tasks  : []
								}
							);
						var cfmlTasks = plan
							.getMemento()
							.tasks
							.filter( ( task ) => task.role == "cfml-conventions" );
						var testingTasks = plan
							.getMemento()
							.tasks
							.filter( ( task ) => task.role == "testing" );

						expect( cfmlTasks ).toHaveLength( 1 );
						expect( cfmlTasks[ 1 ].context.files[ 1 ].filePath ).toBe( "legacy/Orders.cfc" );
						expect( testingTasks ).toHaveLength( 1 );
						expect( testingTasks[ 1 ].context.files[ 1 ].filePath ).toBe( "tests/specs/ReviewsSpec.bx" );
					}
				);

				it(
					"admits emphasized CFML files around changedLines not from line 1",
					() => {
						var lines = [];
						for ( var lineNumber = 1; lineNumber <= 50; lineNumber++ ) {
							lines.append( "/* line #lineNumber# */" );
						}
						var cfmlFile = {
							filePath     : "legacy/Deep.cfc",
							language     : "CFML",
							contentHash  : lCase( hash( lines.toList( char( 10 ) ), "SHA-256" ) ),
							content      : lines.toList( char( 10 ) ),
							lines        : lines,
							sizeBytes    : len( lines.toList( char( 10 ) ) ),
							lineCount    : 50,
							changedLines : [ { startLine: 40, endLine: 42 }]
						};
						var files = fileFixtures();
						files.append( cfmlFile );
						var graph = {
							summary: { symbolCount: 0, dependencyCount: 0, impactCount: 0 },
							symbols: [],
							dependencies: [],
							impacts: []
						};
						var emptyPack = {
							version       : "symbol-range-artifact-refs-v3",
							fingerprint   : "empty-pack",
							changedSymbols: [],
							files         : [],
							summary       : {
								fileCount     : 0,
								rangeCount    : 0,
								lineCount     : 0,
								characters    : 0,
								candidateCount: 0,
								truncated     : false
							}
						};
						var planner = prepareMock( getInstance( "ReviewPlannerService" ) );
						var packService = createStub().$( "build", emptyPack );
						planner.$property( propertyName = "contextPackService", mock = packService );
						planner.$property( propertyName = "beforeLines", mock = 3 );
						planner.$property( propertyName = "afterLines", mock = 12 );
						planner.$property( propertyName = "maxLinesPerRange", mock = 80 );
						planner.$property( propertyName = "maxTasks", mock = 6 );
						var model = getInstance( "ArchitectureModelService" ).build( graph, files, "crew-changed-lines" );
						var plan = planner.plan(
								model,
								graph,
								files,
								{},
								{},
								{
									ok     : false,
									source : "none",
									summary: "",
									tasks  : []
								}
							);
						var cfmlTasks = plan
							.getMemento()
							.tasks
							.filter( ( task ) => task.role == "cfml-conventions" );
						expect( cfmlTasks ).toHaveLength( 1 );
						var deepFile = cfmlTasks[ 1 ].context.files.filter( ( file ) => file.filePath == "legacy/Deep.cfc" );
						expect( deepFile ).toHaveLength( 1 );
						expect( deepFile[ 1 ].ranges[ 1 ].startLine ).toBeGTE( 37 );
						expect( deepFile[ 1 ].ranges[ 1 ].startLine ).notToBe( 1 );
						expect( deepFile[ 1 ].ranges[ 1 ].endLine ).toBeGTE( 42 );
					}
				);

				it(
					"prefers CFML files with changedLines when emphasizing convention roles",
					() => {
						var files = [
							sourceFile(
								"legacy/Old.cfc",
								"CFML",
								"component { function stale() { return 1; } }"
							),
							sourceFile(
								"legacy/New.cfc",
								"CFML",
								"component { function fresh() { return 2; } }"
							)
						];
						files[ 2 ].changedLines = [ { startLine: 1, endLine: 1 }];
						var graph = {
							summary: { symbolCount: 0, dependencyCount: 0, impactCount: 0 },
							symbols: [],
							dependencies: [],
							impacts: []
						};
						var emptyPack = {
							version       : "symbol-range-artifact-refs-v3",
							fingerprint   : "empty-pack-pref",
							changedSymbols: [],
							files         : [],
							summary       : {
								fileCount     : 0,
								rangeCount    : 0,
								lineCount     : 0,
								characters    : 0,
								candidateCount: 0,
								truncated     : false
							}
						};
						var planner = prepareMock( getInstance( "ReviewPlannerService" ) );
						planner.$property(
							propertyName = "contextPackService",
							mock         = createStub().$( "build", emptyPack )
						);
						planner.$property( propertyName = "maxTasks", mock = 6 );
						var model = getInstance( "ArchitectureModelService" ).build( graph, files, "crew-prefer-changed" );
						var plan = planner.plan(
								model,
								graph,
								files,
								{},
								{},
								{
									ok     : false,
									source : "none",
									summary: "",
									tasks  : []
								}
							);
						var cfmlTasks = plan
							.getMemento()
							.tasks
							.filter( ( task ) => task.role == "cfml-conventions" );
						expect( cfmlTasks ).toHaveLength( 1 );
						expect( cfmlTasks[ 1 ].context.files[ 1 ].filePath ).toBe( "legacy/New.cfc" );
					}
				);
			}
		);
	}

	private struct function graphFixture() {
		return {
			summary: {
				symbolCount    : 3,
				dependencyCount: 2,
				impactCount    : 1
			},
			symbols: [
				{
					id      : "handler-action",
					filePath: "app/handlers/Reviews.bx",
					kind    : "handler-action",
					name    : "index",
					line    : 2,
					evidence: "function index()"
				},
				{
					id      : "service-class",
					filePath: "app/models/ReviewService.bx",
					kind    : "class",
					name    : "ReviewService",
					line    : 1,
					evidence: "class"
				},
				{
					id      : "test-spec",
					filePath: "tests/specs/ReviewsSpec.bx",
					kind    : "test",
					name    : "reviews",
					line    : 3,
					evidence: "it"
				},
				{
					id      : "legacy-service",
					filePath: "legacy/Orders.cfc",
					kind    : "class",
					name    : "Orders",
					line    : 1,
					evidence: "component"
				}
			],
			dependencies: [
				{
					id        : "call-edge",
					sourceFile: "app/handlers/Reviews.bx",
					kind      : "calls",
					target    : "reviewService.review",
					targetFile: "app/models/ReviewService.bx",
					line      : 3,
					evidence  : "reviewService.review()"
				},
				{
					id        : "test-edge",
					sourceFile: "tests/specs/ReviewsSpec.bx",
					kind      : "tests",
					target    : "ReviewService",
					targetFile: "app/models/ReviewService.bx",
					line      : 2,
					evidence  : "new ReviewService()"
				}
			],
			impacts: [
				{
					changedFile  : "app/models/ReviewService.bx",
					changedSymbol: "review",
					impactedFile : "tests/specs/ReviewsSpec.bx",
					reason       : "tests",
					depth        : 1,
					viaFile      : "app/models/ReviewService.bx"
				}
			]
		};
	}

	private array function fileFixtures() {
		return [
			sourceFile(
				"app/handlers/Reviews.bx",
				"BoxLang",
				"class { function index() { reviewService.review(); } }"
			),
			sourceFile(
				"app/models/ReviewService.bx",
				"BoxLang",
				"class { function review() { return 'SENSITIVE_SOURCE_BODY'; } }"
			),
			sourceFile(
				"tests/specs/ReviewsSpec.bx",
				"BoxLang",
				"class { function testReviews() {} }"
			),
			sourceFile(
				"legacy/Orders.cfc",
				"CFML",
				"component { function list() { return []; } }"
			)
		];
	}

	private struct function sourceFile( required string filePath, required string language, required string content ) {
		var lines = listToArray(
			arguments.content,
			char( 10 ),
			true,
			true
		);
		return {
			filePath   : arguments.filePath,
			language   : arguments.language,
			contentHash: lCase( hash( arguments.content, "SHA-256" ) ),
			content    : arguments.content,
			lines      : lines,
			sizeBytes  : len( arguments.content ),
			lineCount  : lines.len()
		};
	}
}