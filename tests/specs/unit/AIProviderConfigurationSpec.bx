class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "AI provider configuration", () => {
			it( "selects first-class providers for known OpenAI and OpenRouter endpoints", () => {
				var config = new app.config.Coldbox();
				makePublic( config, "resolveAiProvider" );

				expect( config.resolveAiProvider( "", "https://openrouter.ai/api/v1" ) ).toBe( "openrouter" );
				expect( config.resolveAiProvider( "openai-compatible", "https://openrouter.ai/api/v1" ) ).toBe( "openrouter" );
				expect( config.resolveAiProvider( "", "https://api.openai.com/v1" ) ).toBe( "openai" );
				expect( config.resolveAiProvider( "openai-compatible", "https://api.openai.com/v1" ) ).toBe( "openai" );
			} );

			it( "retains the generic provider for arbitrary compatible endpoints", () => {
				var config = new app.config.Coldbox();
				makePublic( config, "resolveAiProvider" );

				expect( config.resolveAiProvider( "", "https://models.example.test/v1" ) ).toBe( "openai-compatible" );
				expect( config.resolveAiProvider( "openai-compatible", "https://models.example.test/v1" ) ).toBe( "openai-compatible" );
				expect( config.resolveAiProvider( "ollama", "http://127.0.0.1:11434/v1" ) ).toBe( "ollama" );
			} );
		} );
	}
}
