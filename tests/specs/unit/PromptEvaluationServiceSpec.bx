class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Prompt evaluation harness", () => {
			it( "runs registry lint and deterministic adversarial fixtures without a provider", () => {
				var service = new app.models.services.PromptEvaluationService();
				var report = service.evaluate();
				expect( report.lint.valid ).toBeTrue();
				expect( report.total ).toBeGT( 0 );
				expect( report.passRate ).toBe( 1 );
				expect( report.metrics.unauthorizedEvidenceRate ).toBe( 0 );
				expect( report.metrics.repairRate ).toBeGT( 0 );
				expect( report.metrics.repairSuccessRate ).toBe( 1 );
				expect( report.metrics.fitPassRate ).toBe( 1 );
				expect( report.metrics.roleFamilyCoverage ).toBeGTE( 6 );
			} );
		} );
	}
}
