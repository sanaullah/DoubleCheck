class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "PromptOutputValidator architecture compaction", () => {
			it( "splits oversized architecture placements so sanitizeValid succeeds", () => {
				var validator = new app.models.services.PromptOutputValidator();
				var ids = [];
				for ( var i = 1; i <= 95; i++ ) {
					ids.append( "tu-" & i );
				}
				var refs = [];
				for ( var j = 1; j <= 50; j++ ) {
					refs.append( "ev-" & j );
				}
				var result = validator.sanitizeValid(
					{
						placements: [
							{
								id: "placement-large",
								domainKey: "feature-domain",
								name: "Feature domain module",
								placementType: "coldbox-module",
								targetUnitIds: ids,
								evidenceRefs: refs,
								rationale: "Cohesive category feature"
							}
						]
					},
					"modernization-architecture-v2"
				);
				expect( result.valid ).toBeTrue();
				expect( result.value.placements.len() ).toBeGTE( 3 );
				expect( result.value.placements.every( ( item ) => ( item.targetUnitIds ?: [] ).len() <= 40 ) ).toBeTrue();
				expect( result.value.placements.every( ( item ) => ( item.evidenceRefs ?: [] ).len() <= 40 ) ).toBeTrue();
			} );

			it( "hard-caps residual oversized placement arrays after split", () => {
				var validator = new app.models.services.PromptOutputValidator();
				makePublic( validator, "compactArchitectureResponse" );
				var ids = [];
				for ( var i = 1; i <= 120; i++ ) ids.append( "unit-" & i );
				var compacted = validator.compactArchitectureResponse( {
					placements: [ {
						id: "p1",
						domainKey: "jobs",
						placementType: "background-worker",
						targetUnitIds: ids,
						evidenceRefs: ids,
						rationale: "Scheduled job cluster"
					} ],
					contexts: [],
					extracts: []
				} );
				expect( compacted.placements.len() ).toBeGTE( 3 );
				expect( compacted.placements.every( ( item ) => ( item.targetUnitIds ?: [] ).len() <= 40 ) ).toBeTrue();
			} );
		} );
	}

}
