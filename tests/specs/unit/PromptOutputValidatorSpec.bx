class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "PromptOutputValidator architecture compaction", () => {

			it( "hard-caps residual oversized placement arrays after split", () => {
				var validator = new app.models.services.PromptOutputValidator();
				makePublic( validator, "compactArchitectureResponse" );
				var ids = [];
				for ( var i = 1; i <= 120; i++ ) ids.append( "unit-" & i );
				var compacted = validator.compactArchitectureResponse( {
					placements: [ {
						id: "p1",
						domainKey: "jobs",
						placementType: "background-worker",
						targetUnitIds: ids,
						evidenceRefs: ids,
						rationale: "Scheduled job cluster"
					} ],
					contexts: [],
					extracts: []
				} );
				expect( compacted.placements.len() ).toBeGTE( 3 );
				expect( compacted.placements.every( ( item ) => ( item.targetUnitIds ?: [] ).len() <= 40 ) ).toBeTrue();
			} );
		} );
	}

}
