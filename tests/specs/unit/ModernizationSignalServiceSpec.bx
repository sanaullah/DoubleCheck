class extends="testbox.system.BaseSpec" {
    function run() {
        describe( "Modernization signals", () => {
        it( "emits deterministic signal ids and groups", () => {
            var inventory = { files: [], units: [], dependencies: [ { kind: "http", target: "outbound", filePath: "index.cfm", startLine: 2 } ], unresolved: [], routeEvidence: [] };
            var service = new app.models.services.ModernizationSignalService();
            var first = service.build( inventory );
            var second = service.build( inventory );
            expect( first.fingerprint ).toBe( second.fingerprint );
            expect( first.signals[ 1 ].signalId ).toBe( "http.outbound" );
            expect( first.groups.keyExists( "outbound-integration" ) ).toBeTrue();
        } );

        it( "surfaces parameter mismatch and dynamic SQL as reviewable signals", () => {
            var inventory = {
                files: [],
                units: [],
                dependencies: [ { kind: "sql-parameter-mismatch", target: "parameter-binding", filePath: "Order.cfc", startLine: 4 } ],
                unresolved: [ { kind: "dynamic-sql", filePath: "Order.cfc", startLine: 5, evidence: "FROM ##tableName##" } ],
                routeEvidence: []
            };
            var result = new app.models.services.ModernizationSignalService().build( inventory );
            expect( result.groups.keyExists( "cf-sql-parameter-mismatch" ) ).toBeTrue();
            expect( result.signals.map( ( item ) => item.signalId ) ).toInclude( "sql.parameter-mismatch" );
        } );

        it( "preserves closure arguments when assigning signal confidence", () => {
            var result = new app.models.services.ModernizationSignalService().build( {
                files: [], units: [], dependencies: [ { kind: "http", target: "outbound", filePath: "index.cfm", startLine: 2 } ], unresolved: [], routeEvidence: []
            } );
            expect( result.signals[ 1 ].confidence ).toBe( 1 );
        } );
        } );
    }
}
