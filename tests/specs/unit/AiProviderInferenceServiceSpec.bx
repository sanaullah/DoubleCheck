class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "AiProviderInferenceService", () => {
			it( "treats known local provider names as local regardless of base URL", () => {
				var service = new app.models.services.AiProviderInferenceService();
				expect( service.isLocal( "ollama", "https://example.invalid" ) ).toBeTrue();
				expect( service.isLocal( "docker", "https://example.invalid" ) ).toBeTrue();
				expect( service.isLocal( "lmstudio", "https://example.invalid" ) ).toBeTrue();
				expect( service.isLocal( "llamacpp", "https://example.invalid" ) ).toBeTrue();
			} );

			it( "treats a localhost/127.0.0.1 base URL as local regardless of provider name", () => {
				var service = new app.models.services.AiProviderInferenceService();
				expect( service.isLocal( "openai-compatible", "http://localhost:1234/v1" ) ).toBeTrue();
				expect( service.isLocal( "openai-compatible", "http://127.0.0.1:11434/v1" ) ).toBeTrue();
			} );

			it( "treats a remote provider on a remote host as not local", () => {
				var service = new app.models.services.AiProviderInferenceService();
				expect( service.isLocal( "openrouter", "https://openrouter.ai/api/v1" ) ).toBeFalse();
				expect( service.isLocal( "openai", "https://api.openai.com/v1" ) ).toBeFalse();
			} );

			it( "is case-insensitive on the provider name", () => {
				var service = new app.models.services.AiProviderInferenceService();
				expect( service.isLocal( "OLLAMA", "https://example.invalid" ) ).toBeTrue();
			} );
		} );
	}

}
