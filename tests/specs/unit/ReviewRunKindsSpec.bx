class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "ReviewRunKinds", () => {
			it( "lists review, modernize, and codegraph", () => {
				var kinds = new app.models.services.ReviewRunKinds();
				expect( kinds.all() ).toBe( [ "review", "modernize", "codegraph" ] );
			} );

			it( "validates known kinds case-insensitively and rejects unknown", () => {
				var kinds = new app.models.services.ReviewRunKinds();
				expect( kinds.isValid( "review" ) ).toBeTrue();
				expect( kinds.isValid( "Modernize" ) ).toBeTrue();
				expect( kinds.isValid( "CODEGRAPH" ) ).toBeTrue();
				expect( kinds.isValid( "other" ) ).toBeFalse();
				expect( kinds.isValid( "" ) ).toBeFalse();
			} );

			it( "exposes a stable invalid-message string", () => {
				var kinds = new app.models.services.ReviewRunKinds();
				expect( kinds.invalidMessage() ).toInclude( "codegraph" );
			} );
		} );
	}

}
