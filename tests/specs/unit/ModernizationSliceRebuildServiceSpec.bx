class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "ModernizationSliceRebuildService", () => {
			it( "refuses rebuild when linked legacy units have no evidence excerpts", () => {
				var service = new app.models.services.ModernizationSliceRebuildService();
				expect( () => service.assertEvidencePack( { units: [ { id: "lu-1" } ] }, [] ) )
					.toThrow( type = "ModernizationRebuildException" );
			} );

			it( "merges rebuilt units without touching unrelated phases", () => {
				var service = new app.models.services.ModernizationSliceRebuildService();
				var plan = {
					target: { units: [ { id: "tu-keep", targetPath: "app/handlers/Keep.bx" }, { id: "tu-old", targetPath: "app/handlers/Old.bx" } ] },
					roadmapPhases: [ { id: "phase-1", unitIds: [ "tu-old" ] }, { id: "phase-2", unitIds: [ "tu-keep" ] } ],
					unitLinks: [], routeContracts: [], samples: [], dbFindings: [], dbTransitions: []
				};
				var fragment = {
					targetUnits: [ { id: "tu-old", targetPath: "app/handlers/Crime.bx", sampleCode: "class { property name=""x"" inject; function edit(){} }" } ],
					roadmapPhase: { id: "phase-1", unitIds: [ "tu-old" ], name: "Crime slice" },
					unitLinks: [], routeContracts: [], samples: [], dbFindings: [], dbTransitions: []
				};
				var merged = service.mergeFragment( plan, "phase-1", fragment );
				expect( merged.target.units.filter( ( u ) => u.id == "tu-keep" ).len() ).toBe( 1 );
				expect( merged.target.units.filter( ( u ) => u.id == "tu-old" )[ 1 ].targetPath ).toInclude( "Crime.bx" );
				expect( merged.roadmapPhases.filter( ( p ) => p.id == "phase-2" ).len() ).toBe( 1 );
			} );
		} );
	}
}
