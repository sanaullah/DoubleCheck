class extends="testbox.system.BaseSpec" {

	function run() {
		describe(
			"AiFlight PayloadSanitizer",
			() => {
				it(
					"redacts api keys and authorization fields",
					() => {
						var sanitizer = new aiFlight.models.PayloadSanitizer();
						var cleaned = sanitizer.sanitize(
								{
									model        : "gpt-test",
									apiKey       : "sk-secret",
									Authorization: "Bearer tok",
									nested       : { client_secret: "x", ok: true }
								}
							);
						expect( cleaned.model ).toBe( "gpt-test" );
						expect( cleaned.apiKey ).toBe( "[redacted]" );
						expect( cleaned.Authorization ).toBe( "[redacted]" );
						expect( cleaned.nested.client_secret ).toBe( "[redacted]" );
						expect( cleaned.nested.ok ).toBeTrue();
					}
				);
			}
		);
	}
}