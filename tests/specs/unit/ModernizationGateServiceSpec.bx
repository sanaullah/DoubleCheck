class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Modernize placement gates", () => {
			it( "fails service extraction on shared state and data coupling", () => {
				var service = new app.models.services.ModernizationGateService();
				var plan = service.evaluatePlan( {
					target: { units: [ { id: "tu-1", legacyUnitIds: [ "legacy-1" ], sourcePath: "dashboard/orders.cfm" } ], placements: [ { id: "placement-orders", placementType: "external-service", evidenceBasis: "explicit-seam", targetUnitIds: [ "tu-1" ] } ] },
					signals: [
						{ signalId: "scope.session-heavy", unitIds: [ "legacy-1" ], evidenceRefs: [ { filePath: "dashboard/orders.cfm", startLine: 10 } ] },
						{ signalId: "sql.table-ref", unitIds: [ "legacy-1" ], evidenceRefs: [ { filePath: "dashboard/orders.cfm", startLine: 20 } ] },
						{ signalId: "http.outbound", unitIds: [ "legacy-1" ], evidenceRefs: [ { filePath: "dashboard/orders.cfm", startLine: 30 } ] }
					]
				} );
				var gates = plan.target.placements[ 1 ].gates;
				expect( gates.some( ( gate ) => gate.id == "state-isolation" && gate.status == "fail" ) ).toBeTrue();
				expect( gates.some( ( gate ) => gate.id == "data-ownership" && gate.status == "fail" ) ).toBeTrue();
				expect( plan.target.placements[ 1 ].decisionRequired ).toBeTrue();
				expect( plan.gateSummary.failed ).toBeGT( 0 );
			} );

			it( "keeps unknown operational evidence distinct from a pass", () => {
				var service = new app.models.services.ModernizationGateService();
				var plan = service.evaluatePlan( { target: { units: [ { id: "tu-1" } ], placements: [ { id: "placement-1", placementType: "external-service", evidenceBasis: "explicit-seam", targetUnitIds: [ "tu-1" ] } ] }, signals: [ { signalId: "http.outbound", unitIds: [ "tu-1" ], evidenceRefs: [] } ], routeContracts: [] } );
				var gate = plan.target.placements[ 1 ].gates.filter( ( item ) => item.id == "operational-need" )[ 1 ];
				expect( gate.status ).toBe( "unknown" );
				expect( plan.target.placements[ 1 ].gateStatus ).toBe( "needs-review" );
			} );

			it( "asks for a human decision when the judge disputes a derived boundary", () => {
				var service = new app.models.services.ModernizationGateService();
				var plan = service.evaluatePlan( {
					target: { units: [ { id: "tu-1" } ], placements: [ { id: "ctx-derived-a1", placementType: "main-app", evidenceBasis: "coupling-derived", targetUnitIds: [ "tu-1" ] } ] },
					judgement: { verdicts: [ {
						clusterId: "ctx-derived-a1",
						defensible: false,
						confidence: 0.8,
						rationale: "Writes application.cart, which orders also writes.",
						breaksOnExtraction: [ "application.cart" ]
					} ] },
					signals: []
				} );
				var placement = plan.target.placements[ 1 ];
				expect( placement.judgeReview.defensible ).toBeFalse();
				expect( placement.judgeReview.breaksOnExtraction ).toBe( [ "application.cart" ] );
				expect( placement.decisionRequired ).toBeTrue();
			} );

			it( "treats a hedged verdict as a reason to ask, not as agreement", () => {
				var service = new app.models.services.ModernizationGateService();
				var plan = service.evaluatePlan( {
					target: { units: [ { id: "tu-1" } ], placements: [ { id: "ctx-derived-a1", placementType: "main-app", evidenceBasis: "coupling-derived", targetUnitIds: [ "tu-1" ] } ] },
					// Says defensible, but barely believes it.
					judgement: { verdicts: [ { clusterId: "ctx-derived-a1", defensible: true, confidence: 0.3, rationale: "Hard to tell." } ] },
					signals: []
				} );
				expect( plan.target.placements[ 1 ].decisionRequired ).toBeTrue();
			} );

			it( "finds the verdict after canonicalize has reassigned the placement id", () => {
				// The defect this guards: canonicalize() recomputes `id`, so joining
				// verdicts on `id` missed every one and judgeReview silently vanished
				// from every placement on every live run.
				var service = new app.models.services.ModernizationGateService();
				var plan = service.evaluatePlan( {
					target: { units: [ { id: "tu-1" } ], placements: [ {
						id: "placement-id-reassigned-by-canonicalize",
						derivedClusterId: "ctx-derived-a1",
						placementType: "main-app", evidenceBasis: "coupling-derived", targetUnitIds: [ "tu-1" ]
					} ] },
					judgement: { verdicts: [ { clusterId: "ctx-derived-a1", defensible: false, confidence: 0.9, rationale: "Spans the whole system." } ] },
					signals: []
				} );
				expect( plan.target.placements[ 1 ] ).toHaveKey( "judgeReview" );
				expect( plan.target.placements[ 1 ].judgeReview.defensible ).toBeFalse();
				expect( plan.target.placements[ 1 ].decisionRequired ).toBeTrue();
			} );

			it( "does not attach a review when no judge ran", () => {
				var service = new app.models.services.ModernizationGateService();
				var plan = service.evaluatePlan( {
					target: { units: [ { id: "tu-1" } ], placements: [ { id: "ctx-derived-a1", placementType: "main-app", evidenceBasis: "coupling-derived", targetUnitIds: [ "tu-1" ] } ] },
					signals: []
				} );
				expect( plan.target.placements[ 1 ] ).notToHaveKey( "judgeReview" );
			} );
		} );
	}
}
