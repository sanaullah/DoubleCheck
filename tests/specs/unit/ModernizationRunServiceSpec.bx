class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Modernization pipeline lifecycle", () => {
			it( "does not reuse checkpoints from an older pipeline contract", () => {
				var service = new app.models.services.ModernizationRunService();
				makePublic( service, "reusableCheckpoint" );
				var oldCheckpoint = {
					stage: "inventory",
					status: "succeeded",
					payload: {
						provenance: {
							inputFingerprint: "input-fp",
							sourceFingerprint: "source-fp"
						}
					}
				};
				var currentCheckpoint = duplicate( oldCheckpoint );
				currentCheckpoint.payload.provenance.pipelineContractVersion = "modernization-pipeline-v7";

				var oldResult = service.reusableCheckpoint( [ oldCheckpoint ], "inventory", "input-fp", "source-fp" );
				var currentResult = service.reusableCheckpoint( [ currentCheckpoint ], "inventory", "input-fp", "source-fp" );
				var changedSourceResult = service.reusableCheckpoint( [ currentCheckpoint ], "inventory", "input-fp", "changed-source-fp" );
				var changedInputResult = service.reusableCheckpoint( [ currentCheckpoint ], "inventory", "changed-input-fp", "source-fp" );
				expect( isNull( oldResult ) ).toBeTrue();
				expect( isNull( currentResult ) ).toBeFalse();
				expect( isNull( changedSourceResult ) ).toBeTrue();
				expect( isNull( changedInputResult ) ).toBeTrue();
			} );

				it( "fails safely when the shared scan contains no CFML scope", () => {
				var repository = new tests.resources.ScriptedModernizationRepository();
				var inventory = new tests.resources.ScriptedModernizationInventory( { noModernizationScope: true, type: "NoModernizationScope", units: [], dependencies: [], routeEvidence: [], unresolved: [] } );
				var service = new app.models.services.ModernizationRunService();
				service.modernizationRepository = repository;
				service.inventoryService = inventory;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				var run = new tests.resources.ScriptedModernizationRun( "run-empty", "modernize", getTempDirectory(), { fingerprint: "input-fp" }, { fingerprint: "input-fp" }, {} );
				var result = service.execute( run, { files: [], repositoryRevision: "rev-1", discoveryTruncated: false } );
				expect( result.status ).toBe( "failed" );
				expect( result.planState ).toBe( "failed" );
				expect( result.errors ).notToBeEmpty();
				expect( repository.checkpointWrites ).toBe( 1 );
			} );

			it( "honors cancellation before starting modernization stages", () => {
				var repository = new tests.resources.ScriptedModernizationRepository();
				var inventory = new tests.resources.ScriptedModernizationInventory( { noModernizationScope: false, units: [] } );
				var service = new app.models.services.ModernizationRunService();
				service.modernizationRepository = repository;
				service.inventoryService = inventory;
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				var run = new tests.resources.ScriptedModernizationRun( "run-cancelled", "modernize", getTempDirectory(), { fingerprint: "input-fp" }, { fingerprint: "input-fp" }, {} );
				var result = service.execute( run, { files: [], repositoryRevision: "rev-1" }, { checkCancellation: () => true } );
				expect( result.status ).toBe( "cancelled" );
				expect( result.planState ).toBe( "needs-review" );
				expect( repository.checkpointWrites ).toBe( 0 );
			} );

			it( "persists an accepted partial plan when cancellation arrives after proposal", () => {
				var repository = new tests.resources.ScriptedModernizationRepository();
				var control = { cancelled: false };
				var service = new app.models.services.ModernizationRunService();
				service.modernizationRepository = repository;
				service.inventoryService = {
					build: ( scan ) => {
						return {
							noModernizationScope: false,
							fingerprint: "inventory-fp",
							files: [ { filePath: "legacy/index.cfm" } ],
							units: [ { id: "legacy-index", filePath: "legacy/index.cfm" } ],
							dependencies: [],
							routeEvidence: [],
							unresolved: []
						};
					}
				};
				service.schemaPackService = { discover: ( path ) => { return { coverage: "absent", fingerprint: "schema-fp" }; } };
				service.evidenceDiscoveryService = { discover: ( path, options ) => { return { routeEvidence: [] }; } };
				service.signalService = { build: ( inventory, schema, extra ) => { return { signals: [] }; } };
				service.contextPackService = {
					build: ( scan, inventory, signals, options ) => {
						return { fingerprint: "context-fp", contexts: [], summary: { files: 1, omittedPartitions: 0 }, truncated: false };
					}
				};
				service.coverageService = {
					assess: ( scan, inventory, schema, context, llm ) => {
						return { complete: true, status: "complete", repository: { truncation: false, modernizationLanguagesComplete: true }, llm: { complete: true, status: "complete", gaps: [] } };
					}
				};
				service.proposalService = {
					propose: ( runId, input, evidence, options ) => {
						control.cancelled = true;
						return {
							ok: true,
							partial: false,
							errors: [],
							plan: {
								version: "modernization-plan-v1",
								metadata: { provenanceContract: { version: "modernization-provenance-v1" } },
								coverage: evidence.coverage,
								assumptions: [],
								inventory: evidence.inventory,
								schemaEvidence: evidence.schemaEvidence,
								signals: [],
								target: { units: [ { id: "accepted-target", itemFingerprint: "accepted-fp", targetPath: "app/handlers/Index.bx", provenanceClass: "provider-suggested" } ], contexts: [], extracts: [] },
								unitLinks: [],
								dbFindings: [],
								dbTransitions: [],
								routeContracts: [],
								roadmapPhases: [],
								samples: [],
								validation: {},
								decisions: []
							}
						};
					},
					cancelRun: ( runId ) => {}
				};
				service.validationService = { validate: ( plan, context ) => { return { ok: true, blocking: 0, warnings: 0, messages: [] }; } };
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				var run = new tests.resources.ScriptedModernizationRun(
					"run-cancel-after-proposal",
					"modernize",
					getTempDirectory(),
					{ target: { runtime: "boxlang", layoutProfile: "modern" } },
					{ fingerprint: "input-fp" },
					{ maxDurationMs: 900000 }
				);
				var result = service.execute(
					run,
					{ files: [ { filePath: "legacy/index.cfm", content: "index" } ], repositoryRevision: "rev-1", discoveryTruncated: false },
					{ checkCancellation: () => control.cancelled }
				);
				expect( result.status ).toBe( "cancelled", jsonSerialize( result ) );
				expect( result.target.units.map( ( item ) => item.id ) ).toInclude( "accepted-target" );
				expect( result.coverage.complete ).toBeFalse();
				expect( result.coverage.llm.gaps.some( ( item ) => ( item.reason ?: "" ) == "cancelled" ) ).toBeTrue();
				expect( repository.getPlan( run.getId() ) ).notToBeNull();
			} );

			it( "backfills signalIds and touched tables/columns onto inventory units in the PERSISTED plan", () => {
				var repository = new tests.resources.ScriptedModernizationRepository();
				var service = new app.models.services.ModernizationRunService();
				service.modernizationRepository = repository;
				service.inventoryService = {
					build: ( scan ) => {
						return {
							noModernizationScope: false,
							fingerprint: "inventory-fp",
							files: [ { filePath: "legacy/index.cfm" } ],
							// No signalIds/touchedTables/touchedColumns keys at all —
							// the backfill must tolerate their absence.
							units: [
								{ id: "legacy-index", filePath: "legacy/index.cfm", startLine: 1, endLine: 60 },
								{ id: "legacy-untouched", filePath: "legacy/other.cfm", startLine: 1, endLine: 10 }
							],
							dependencies: [],
							routeEvidence: [],
							unresolved: []
						};
					}
				};
				service.schemaPackService = { discover: ( path ) => { return { coverage: "absent", fingerprint: "schema-fp" }; } };
				service.evidenceDiscoveryService = { discover: ( path, options ) => { return { routeEvidence: [] }; } };
				service.signalService = { build: ( inventory, schema, extra ) => {
					return { signals: [
						{ signalId: "scope.application-state", group: "application-lifecycle-state", unitIds: [ "legacy-index" ], evidenceRefs: [ { filePath: "legacy/index.cfm", startLine: 4, target: "application" } ] },
						{ signalId: "sql.query", group: "datasource-table-coupling", unitIds: [ "legacy-index" ], evidenceRefs: [ { filePath: "legacy/index.cfm", startLine: 9, target: "sql" } ] },
						// Duplicate slug must collapse, not inflate the rollup.
						{ signalId: "sql.query", group: "datasource-table-coupling", unitIds: [ "legacy-index" ], evidenceRefs: [ { filePath: "legacy/index.cfm", startLine: 11, target: "sql" } ] },
						{ signalId: "sql.table-ref", group: "datasource-table-coupling", unitIds: [ "legacy-index" ], evidenceRefs: [ { filePath: "legacy/index.cfm", startLine: 9, target: "crime" } ] },
						{ signalId: "sql.column-ref", group: "datasource-table-coupling", unitIds: [ "legacy-index" ], evidenceRefs: [ { filePath: "legacy/index.cfm", startLine: 9, target: "state" } ] }
					] };
				} };
				service.contextPackService = {
					build: ( scan, inventory, signals, options ) => {
						return { fingerprint: "context-fp", contexts: [], summary: { files: 1, omittedPartitions: 0 }, truncated: false };
					}
				};
				service.coverageService = {
					assess: ( scan, inventory, schema, context, llm ) => {
						return { complete: true, status: "complete", repository: { truncation: false, modernizationLanguagesComplete: true }, llm: { complete: true, status: "complete", gaps: [] } };
					}
				};
				service.proposalService = {
					propose: ( runId, input, evidence, options ) => {
						return {
							ok: true, partial: false, errors: [],
							plan: {
								version: "modernization-plan-v1",
								metadata: { provenanceContract: { version: "modernization-provenance-v1" } },
								coverage: evidence.coverage,
								assumptions: [],
								inventory: evidence.inventory,
								schemaEvidence: evidence.schemaEvidence,
								signals: evidence.signals,
								target: { units: [], contexts: [], extracts: [] },
								unitLinks: [], dbFindings: [], dbTransitions: [], routeContracts: [],
								roadmapPhases: [], samples: [], validation: {}, decisions: []
							}
						};
					},
					cancelRun: ( runId ) => {}
				};
				service.validationService = { validate: ( plan, context ) => { return { ok: true, blocking: 0, warnings: 0, messages: [] }; } };
				service.secretRedactionService = new app.models.services.SecretRedactionService();
				var run = new tests.resources.ScriptedModernizationRun(
					"run-signal-backfill",
					"modernize",
					getTempDirectory(),
					{ target: { runtime: "boxlang", layoutProfile: "modern" } },
					{ fingerprint: "input-fp" },
					{ maxDurationMs: 900000 }
				);
				service.execute( run, { files: [ { filePath: "legacy/index.cfm", content: "index" } ], repositoryRevision: "rev-1", discoveryTruncated: false } );

				// Assert on the PERSISTED plan, not the in-memory result: a stale
				// evidence checkpoint restoring a pre-join inventory would pass a
				// result-only assertion while shipping empty signalIds to the user.
				var persisted = repository.getPlan( run.getId() );
				expect( persisted ).notToBeNull();
				var persistedUnits = persisted.plan.inventory.units;
				var indexUnit = persistedUnits.filter( ( item ) => item.id == "legacy-index" )[ 1 ];
				expect( indexUnit.signalIds ).toBe( [ "scope.application-state", "sql.column-ref", "sql.query", "sql.table-ref" ] );
				expect( indexUnit.touchedTables ).toBe( [ "crime" ] );
				expect( indexUnit.touchedColumns ).toBe( [ "state" ] );
				// A unit no signal points at keeps its empty/absent rollup.
				var untouched = persistedUnits.filter( ( item ) => item.id == "legacy-untouched" )[ 1 ];
				expect( untouched.signalIds ?: [] ).toBeEmpty();
			} );

			it( "enriches getResult() with risk/effort data via the risk service when a run entity exists", () => {
				var repository = new tests.resources.ScriptedModernizationRepository();
				repository.savePlan( "run-risk", { schemaVersion: "modernization-plan-v1", roadmapPhases: [] } );
				var service = new app.models.services.ModernizationRunService();
				service.modernizationRepository = repository;
				var enrichCalls = [];
				service.modernizationRiskService = {
					enrich: ( plan, projectPath, tenantId, projectId ) => {
						enrichCalls.append( { projectPath: projectPath, tenantId: tenantId, projectId: projectId } );
						plan.riskEnriched = true;
						return plan;
					}
				};
				service.runRepository = {
					find: ( runId ) => {
						return {
							getProjectPath: () => "D:\Temp\cfportal\opengovdashboard",
							getTenantId: () => "tenant-1",
							getProjectId: () => "project-1"
						};
					}
				};
				var result = service.getResult( "run-risk" );
				expect( result.riskEnriched ?: false ).toBeTrue();
				expect( enrichCalls ).toHaveLength( 1 );
				expect( enrichCalls[ 1 ].projectPath ).toBe( "D:\Temp\cfportal\opengovdashboard" );
				expect( enrichCalls[ 1 ].tenantId ).toBe( "tenant-1" );
			} );

			it( "returns the result unchanged when no run entity is found for risk enrichment", () => {
				var repository = new tests.resources.ScriptedModernizationRepository();
				repository.savePlan( "run-no-entity", { schemaVersion: "modernization-plan-v1", roadmapPhases: [] } );
				var service = new app.models.services.ModernizationRunService();
				service.modernizationRepository = repository;
				var enrichCalled = false;
				service.modernizationRiskService = { enrich: ( plan, projectPath, tenantId, projectId ) => { enrichCalled = true; return plan; } };
				service.runRepository = { find: ( runId ) => javacast( "null", "" ) };
				var result = service.getResult( "run-no-entity" );
				expect( enrichCalled ).toBeFalse();
				expect( result.schemaVersion ).toBe( "modernization-plan-v1" );
			} );

			it( "returns checkpoint summaries without cumulative payload snapshots", () => {
				var repository = new tests.resources.ScriptedModernizationRepository( checkpoints = [ {
					runId: "run-checkpoint-summary",
					stage: "proposal",
					status: "succeeded",
					progress: 72,
					updatedAt: "2026-08-02T00:00:00Z",
					payload: { inventory: { units: [ { id: "large-unit", source: repeatString( "x", 10000 ) } ] } }
				} ] );
				repository.savePlan( "run-checkpoint-summary", { schemaVersion: "modernization-plan-v2", target: { units: [], placements: [] }, roadmapPhases: [] } );
				var service = new app.models.services.ModernizationRunService();
				service.modernizationRepository = repository;
				service.modernizationRiskService = { enrich: ( plan, projectPath, tenantId, projectId ) => plan };
				service.runRepository = { find: ( runId ) => javacast( "null", "" ) };

				var result = service.getResult( "run-checkpoint-summary" );

				expect( result.checkpoints ).toHaveLength( 1 );
				expect( result.checkpoints[ 1 ].stage ).toBe( "proposal" );
				expect( result.checkpoints[ 1 ].progress ).toBe( 72 );
				expect( result.checkpoints[ 1 ].hasPayload ).toBeTrue();
				expect( result.checkpoints[ 1 ] ).notToHaveKey( "payload" );
				expect( len( jsonSerialize( result.checkpoints ) ) ).toBeLT( 500 );
			} );
		} );
	}
}
