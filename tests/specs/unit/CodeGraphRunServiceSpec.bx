class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "CodeGraphRunService", () => {

			it( "emits the phase/progress/event sequence and succeeds with clusters when narrative is disabled", () => {
				var service = new app.models.services.CodeGraphRunService();
				var indexed = { called: false, files: [] };
				var saved = { saveCount: 0, updateCount: 0, initialNarrative: {}, finalNarrative: {} };
				var transitions = [];
				var events = [];

				service.architectureIndexService = {
					index: ( runId, files ) => {
						indexed.called = true;
						indexed.files = files;
						return { filesAnalyzed: files.len() };
					}
				};
				service.graphRepository = {
					getGraph: ( runId, resultLimit ) => {
						return {
							symbols: [
								{ id: "s1", filePath: "app/models/Order.cfc", kind: "function", name: "save", line: 10 }
							],
							dependencies: [
								{
									id: "d1",
									sourceFile: "app/handlers/Orders.bx",
									kind: "injects",
									target: "Order",
									targetFile: "app/models/Order.cfc",
									line: 3
								}
							],
							summary: { symbolCount: 1, dependencyCount: 1 }
						};
					}
				};
				service.metricsService = new app.models.services.CodeGraphMetricsService();
				service.codeGraphRepository = {
					save: ( runId, snapshot, projectPath, repositoryRevision, narrativeCacheKey, narrative ) => {
						saved.saveCount++;
						saved.snapshot = snapshot;
						saved.initialNarrative = narrative;
					},
					updateNarrative: ( runId, narrative, narrativeCacheKey, snapshot ) => {
						saved.updateCount++;
						saved.finalNarrative = narrative;
					}
				};
				service.eventService = {
					publish: ( runId, eventType, payload ) => {
						events.append( { type: eventType, progress: payload.progress ?: 0, phase: payload.phase ?: "" } );
					}
				};
				service.narrativeService = {
					isEnabled: () => false,
					cacheKey: ( snapshot, projectPath ) => "unused",
					narrate: ( snapshot ) => { return { used: false }; }
				};
				service.codegraphMaxEdges = 20000;
				service.codegraphMaxNodes = 1500;
				service.codegraphMaxClusters = 60;
				service.codegraphMaxHotspots = 50;
				service.codegraphMaxOrphans = 200;
				service.codegraphMaxLayerViolations = 200;

				var run = new tests.resources.ScriptedModernizationRun(
					"run-cg-1",
					"codegraph",
					getTempDirectory(),
					{ version: "codegraph-input-v1" },
					{ fingerprint: "fp-1", providerEnabled: false, runKind: "codegraph" },
					{}
				);
				var scan = {
					files: [
						{ filePath: "app/models/Order.cfc", language: "CFML" },
						{ filePath: "app/handlers/Orders.bx", language: "BoxLang" }
					],
					repositoryRevision: "rev-1"
				};
				var result = service.execute(
					run,
					scan,
					{
						runId: "run-cg-1",
						runKind: "codegraph",
						transition: ( progress, phase, message ) => {
							transitions.append( { progress: progress, phase: phase, message: message } );
						},
						checkCancellation: () => false,
						renewLease: () => true
					}
				);

				expect( result.status ).toBe( "succeeded" );
				expect( indexed.called ).toBeTrue();
				expect( saved.saveCount ).toBe( 1 );
				expect( saved.updateCount ).toBe( 1 );
				expect( saved.initialNarrative.used ?: true ).toBeFalse();
				expect( saved.finalNarrative.used ?: true ).toBeFalse();
				expect( result.narrative.used ?: true ).toBeFalse();
				expect( isArray( result.snapshot.clusters ?: "" ) ).toBeTrue();
				expect( result.snapshot.clusters.len() ).toBeGTE( 1 );

				var phases = transitions.map( ( item ) => item.phase );
				expect( phases ).toBe( [
					"codegraph-index",
					"codegraph-metrics",
					"codegraph-clusters",
					"codegraph-narrative",
					"codegraph-persist"
				] );
				expect( transitions[ 1 ].progress ).toBe( 20 );
				expect( transitions[ 2 ].progress ).toBe( 40 );
				expect( transitions[ 3 ].progress ).toBe( 60 );
				expect( transitions[ 4 ].progress ).toBe( 75 );
				expect( transitions[ 5 ].progress ).toBe( 90 );

				var eventTypes = events.map( ( item ) => item.type );
				expect( eventTypes ).toBe( [
					"codegraph.index",
					"codegraph.metrics",
					"codegraph.clusters",
					"codegraph.narrative"
				] );
			} );

			it( "reuses full-git snapshots before indexing", () => {
				var persisted = { saveCount: 0, updateCount: 0, snapshot: {}, narrative: {} };
				var service = executableService( persisted );
				var calls = { indexed: false, reuseKey: "" };
				service.architectureIndexService = {
					parserVersionFor: ( files ) => "boxlang-ast-parser-v3",
					index: ( runId, files ) => {
						calls.indexed = true;
						return {};
					}
				};
				service.codeGraphRepository.findReusableSnapshot = ( projectPath, revision, reuseKey ) => {
					calls.reuseKey = reuseKey;
					return {
						runId: "source-codegraph-run",
						snapshot: { version: "codegraph-snapshot-v1", fingerprint: "reused", totals: {}, nodes: [], clusters: [] },
						narrative: { used: false }
					};
				};

				var result = service.execute(
					new tests.resources.ScriptedModernizationRun( "run-cg-reuse", "codegraph", getTempDirectory() ),
					{ scope: "full-git", files: [ { filePath: "app/A.bx", language: "BoxLang" } ], repositoryRevision: "rev-reuse" },
					{ checkCancellation: () => false }
				);

				expect( result.status ).toBe( "succeeded" );
				expect( result.reused ).toBeTrue();
				expect( result.snapshot.fingerprint ).toBe( "reused" );
				expect( len( calls.reuseKey ) ).toBeGT( 0 );
				expect( calls.indexed ).toBeFalse();
				expect( persisted.saveCount ).toBe( 1 );
			} );

			it( "reuses a clean full project before repository scanning", () => {
				var persisted = { saveCount: 0, updateCount: 0, snapshot: {}, narrative: {} };
				var service = executableService( persisted );
				var adopted = {};
				service.codegraphSnapshotReuseEnabled = true;
				service.architectureIndexService = { parserVersionSignature: () => "all-parser-v1" };
				service.gitRepositoryService = {
					workingTreePaths: ( root, maxEntries ) => { return { available: true, paths: [], truncated: false }; },
					inspect: ( root ) => { return { available: true, repositoryRevision: "clean-head" }; }
				};
				service.graphRepository.adoptRunGraph = ( sourceRunId, targetRunId ) => {
					adopted.source = sourceRunId;
					adopted.target = targetRunId;
				};
				service.codeGraphRepository.findReusableSnapshot = ( projectPath, revision, reuseKey ) => {
					return {
						runId: "source-run",
						narrativeCacheKey: "narrative-key",
						snapshot: { version: "codegraph-snapshot-v1", fingerprint: "pre-scan", totals: { files: 2 }, nodes: [], clusters: [] },
						narrative: { used: false }
					};
				};
				var run = {
					getId: () => "target-run",
					getMode: () => "full",
					getInput: () => ( {} ),
					getProjectPath: () => getTempDirectory()
				};

				var result = service.reuseBeforeScan( run );

				expect( result.reused ).toBeTrue();
				expect( result.repositoryRevision ).toBe( "clean-head" );
				expect( adopted ).toBe( { source: "source-run", target: "target-run" } );
				expect( persisted.saveCount ).toBe( 1 );
			} );

			it( "skips snapshot reuse when the working tree is dirty", () => {
				var persisted = { saveCount: 0, updateCount: 0, snapshot: {}, narrative: {} };
				var service = executableService( persisted );
				var reuseLookups = 0;
				service.gitRepositoryService = {
					workingTreePaths: ( root, maxEntries ) => { return { available: true, paths: [ root.getPath() & "/dirty.bx" ], truncated: false }; },
					commitFilePairs: () => { return { available: false, commits: [], reason: "disabled" }; }
				};
				service.codeGraphRepository.findReusableSnapshot = () => { reuseLookups++; return javacast( "null", "" ); };

				var result = service.execute(
					new tests.resources.ScriptedModernizationRun( "run-cg-dirty", "codegraph", getTempDirectory() ),
					{ scope: "full-git", files: [], repositoryRevision: "rev-dirty" },
					{ checkCancellation: () => false }
				);

				expect( result.status ).toBe( "succeeded" );
				expect( reuseLookups ).toBe( 0 );
				expect( persisted.saveCount ).toBe( 1 );
			} );

			it( "changes the pre-scan reuse key when any parser version changes", () => {
				var keys = [];
				for ( var signature in [ "all-parser-v1", "all-parser-v2" ] ) {
					var service = executableService( { saveCount: 0, updateCount: 0, snapshot: {}, narrative: {} } );
					service.codegraphSnapshotReuseEnabled = true;
					service.architectureIndexService = { parserVersionSignature: () => signature };
					service.gitRepositoryService = {
						workingTreePaths: () => { return { available: true, paths: [], truncated: false }; },
						inspect: () => { return { available: true, repositoryRevision: "same-head" }; }
					};
					service.codeGraphRepository.findReusableSnapshot = ( projectPath, revision, reuseKey ) => {
						keys.append( reuseKey );
						return javacast( "null", "" );
					};
					service.reuseBeforeScan( {
						getId: () => "target-#signature#",
						getMode: () => "full",
						getInput: () => ( {} ),
						getProjectPath: () => getTempDirectory()
					} );
				}

				expect( keys ).toHaveLength( 2 );
				expect( keys[ 1 ] ).notToBe( keys[ 2 ] );
			} );

			it( "treats a non-git project as a normal cache miss", () => {
				var service = executableService( { saveCount: 0, updateCount: 0, snapshot: {}, narrative: {} } );
				var reuseLookups = 0;
				service.codegraphSnapshotReuseEnabled = true;
				service.gitRepositoryService = {
					workingTreePaths: () => { return { available: false, paths: [], truncated: false }; },
					inspect: () => { return { available: false, repositoryRevision: "" }; }
				};
				service.codeGraphRepository.findReusableSnapshot = () => { reuseLookups++; return javacast( "null", "" ); };

				var result = service.reuseBeforeScan( {
					getId: () => "non-git-run",
					getMode: () => "full",
					getInput: () => ( {} ),
					getProjectPath: () => getTempDirectory()
				} );

				expect( result.reused ).toBeFalse();
				expect( reuseLookups ).toBe( 0 );
			} );

			it( "keeps one complete structure row when narrative fails", () => {
				var persisted = { saveCount: 0, updateCount: 0, snapshot: {}, narrative: {} };
				var service = executableService( persisted );
				service.narrativeService = {
					isEnabled: () => true,
					usesShards: () => false,
					cacheKey: ( snapshot, projectPath ) => "narrative-failure-key",
					narrate: ( snapshot, projectPath ) => {
						throw( type = "ProviderException", message = "provider down" );
					}
				};
				service.codeGraphRepository.findReusableNarrative = () => javacast( "null", "" );

				var result = service.execute(
					new tests.resources.ScriptedModernizationRun( "run-cg-provider-fail", "codegraph", getTempDirectory() ),
					{ scope: "working-tree", files: [], repositoryRevision: "" },
					{ checkCancellation: () => false }
				);

				expect( result.status ).toBe( "succeeded" );
				expect( persisted.saveCount ).toBe( 1 );
				expect( persisted.updateCount ).toBe( 1 );
				expect( persisted.snapshot.version ).toBe( "codegraph-snapshot-v1" );
				expect( persisted.narrative.used ).toBeFalse();
				expect( persisted.narrative.pending ).toBeFalse();
				expect( persisted.narrative.error ).toInclude( "provider down" );
			} );

			it( "finalizes and serves structure when cancelled after phase one", () => {
				var persisted = { saveCount: 0, updateCount: 0, snapshot: {}, narrative: {} };
				var service = executableService( persisted );
				service.narrativeService = {
					isEnabled: () => true,
					usesShards: () => false,
					cacheKey: ( snapshot, projectPath ) => "cancel-key",
					narrate: ( snapshot, projectPath ) => { return { used: true }; }
				};
				service.codeGraphRepository.findReusableNarrative = () => javacast( "null", "" );
				service.codeGraphRepository.get = ( runId ) => {
					return {
						version: persisted.snapshot.version,
						fingerprint: persisted.snapshot.fingerprint,
						truncated: false,
						truncationReasons: [],
						snapshot: persisted.snapshot,
						narrative: persisted.narrative
					};
				};

				var result = service.execute(
					new tests.resources.ScriptedModernizationRun( "run-cg-cancel-after-structure", "codegraph", getTempDirectory() ),
					{ scope: "working-tree", files: [], repositoryRevision: "" },
					{ checkCancellation: () => persisted.saveCount > 0 }
				);

				expect( result.status ).toBe( "cancelled" );
				expect( persisted.saveCount ).toBe( 1 );
				expect( persisted.updateCount ).toBe( 1 );
				expect( persisted.narrative.pending ).toBeFalse();
				var loaded = service.getResult( "run-cg-cancel-after-structure" );
				expect( loaded.codegraph.version ).toBe( "codegraph-snapshot-v1" );
				expect( loaded.codegraph.narrative.error ).toInclude( "cancelled" );
			} );

			it( "cancels between stages before indexing when checkCancellation is true", () => {
				var service = new app.models.services.CodeGraphRunService();
				var indexed = { called: false };
				service.architectureIndexService = {
					index: ( runId, files ) => {
						indexed.called = true;
						return {};
					}
				};
				service.codeGraphRepository = { save: () => {} };
				service.eventService = { publish: () => {} };
				service.narrativeService = {
					isEnabled: () => false,
					cacheKey: ( snapshot, projectPath ) => "",
					narrate: ( snapshot ) => { return { used: false }; }
				};
				var run = new tests.resources.ScriptedModernizationRun( "run-cg-cancel", "codegraph", getTempDirectory() );
				var result = service.execute(
					run,
					{ files: [], repositoryRevision: "" },
					{ checkCancellation: () => true }
				);
				expect( result.status ).toBe( "cancelled" );
				expect( indexed.called ).toBeFalse();
			} );

			it( "cancels after index when cancellation arrives before metrics", () => {
				var service = new app.models.services.CodeGraphRunService();
				var control = { cancelAfterIndex: false };
				var indexed = { called: false };
				var assembled = { called: false };
				service.architectureIndexService = {
					index: ( runId, files ) => {
						indexed.called = true;
						control.cancelAfterIndex = true;
						return {};
					}
				};
				service.graphRepository = {
					getGraph: ( runId, resultLimit ) => {
						assembled.called = true;
						return { symbols: [], dependencies: [] };
					}
				};
				service.metricsService = {
					assemble: ( reviewGraph, options ) => {
						assembled.called = true;
						return { version: "codegraph-snapshot-v1", clusters: [], totals: {} };
					}
				};
				service.codeGraphRepository = { save: () => {} };
				service.eventService = { publish: () => {} };
				service.narrativeService = {
					isEnabled: () => false,
					cacheKey: ( snapshot, projectPath ) => "",
					narrate: ( snapshot ) => { return { used: false }; }
				};
				service.codegraphMaxEdges = 100;

				var run = new tests.resources.ScriptedModernizationRun( "run-cg-mid", "codegraph", getTempDirectory() );
				var result = service.execute(
					run,
					{ files: [ { filePath: "app/models/A.cfc" } ], repositoryRevision: "r1" },
					{
						runId: "run-cg-mid",
						runKind: "codegraph",
						transition: ( progress, phase, message ) => {},
						checkCancellation: () => control.cancelAfterIndex,
						renewLease: () => true
					}
				);
				expect( result.status ).toBe( "cancelled" );
				expect( indexed.called ).toBeTrue();
				expect( assembled.called ).toBeFalse();
			} );

			it( "getResult returns codegraph payload without raw edges and empty shell when missing", () => {
				var service = new app.models.services.CodeGraphRunService();
				service.codeGraphRepository = {
					get: ( id ) => javacast( "null", "" )
				};
				var empty = service.getResult( "missing" );
				expect( empty ).toHaveKey( "codegraph" );
				expect( empty.codegraph.narrative.used ).toBeFalse();
				expect( empty.codegraph.nodes ).toBe( [] );
				expect( empty.codegraph.flows ).toBe( [] );
				expect( empty.codegraph ).notToHaveKey( "edges" );
				expect( empty.codegraph ).notToHaveKey( "dependencies" );

				service.codeGraphRepository = {
					get: ( id ) => {
						return {
							version: "codegraph-snapshot-v1",
							fingerprint: "abc",
							truncated: false,
							truncationReasons: [],
							narrative: { used: false },
							snapshot: {
								version: "codegraph-snapshot-v1",
								fingerprint: "abc",
								totals: { nodes: 1, clusters: 1, edges: 2 },
								nodes: [ { id: "n1", path: "app/models/A.cfc" } ],
								clusters: [ { id: "c1", label: "models" } ],
								flows: [ { id: "f1", entryFile: "app/handlers/Main.bx", steps: [ "app/handlers/main.bx" ] } ],
								clusterEdges: [],
								cycles: [],
								hotspots: [],
								orphans: [],
								layerViolations: []
							}
						};
					}
				};
				var loaded = service.getResult( "run-1" );
				expect( loaded.codegraph.fingerprint ).toBe( "abc" );
				expect( loaded.codegraph.nodes ).toHaveLength( 1 );
				expect( loaded.codegraph.clusters ).toHaveLength( 1 );
				expect( loaded.codegraph.flows ).toHaveLength( 1 );
				expect( loaded.codegraph.flows[ 1 ].id ).toBe( "f1" );
				expect( loaded.codegraph ).notToHaveKey( "edges" );
			} );

			it( "subgraph BFS from focus is capped by limit and requires focus", () => {
				var service = new app.models.services.CodeGraphRunService();
				service.codegraphMaxEdges = 20000;
				service.codegraphSubgraphMaxNodes = 300;
				service.codegraphSubgraphMaxDepth = 3;
				service.graphRepository = {
					getGraph: ( runId, resultLimit ) => {
						return {
							dependencies: [
								{ id: "d1", sourceFile: "app/A.cfc", kind: "constructs", target: "B", targetFile: "app/B.cfc", line: 1, evidence: "new B()" },
								{ id: "d2", sourceFile: "app/B.cfc", kind: "constructs", target: "C", targetFile: "app/C.cfc", line: 1 },
								{ id: "d3", sourceFile: "app/C.cfc", kind: "constructs", target: "D", targetFile: "app/D.cfc", line: 1 }
							]
						};
					}
				};

				expect( () => service.subgraph( "run-1", {} ) ).toThrow( type = "ValidationException" );

				var limited = service.subgraph( "run-1", { focus: "app/A.cfc", depth: 3, limit: 2 } );
				expect( limited.focus ).toBe( "app/A.cfc" );
				expect( limited.nodes ).toHaveLength( 2 );
				expect( limited.truncated ).toBeTrue();
				expect( limited.edges.len() ).toBeGTE( 1 );
				expect( limited.edges[ 1 ] ).toHaveKey( "from" );
				expect( limited.edges[ 1 ] ).toHaveKey( "to" );
				expect( limited.nodes[ 1 ].id ).toBe( lCase( limited.nodes[ 1 ].id ) );
				var defaults = service.subgraph( "run-1", { focus: "app/A.cfc" } );
				expect( defaults.depth ).toBe( 3 );
				expect( defaults.nodes ).toHaveLength( 4 );
				expect( defaults.edges ).toHaveLength( 3 );

				expect( () => service.subgraph( "run-1", { focus: "app/A.cfc", limit: 9999 } ) )
					.toThrow( type = "ValidationException" );
			} );

			it( "fileEdges filters by cluster and returns from/to with evidence", () => {
				var service = new app.models.services.CodeGraphRunService();
				service.codegraphMaxEdges = 20000;
				service.codeGraphRepository = {
					get: ( runId ) => {
						return {
							snapshot: {
								clusters: [ {
									id: "c1",
									filePaths: [ "app/A.cfc", "app/B.cfc" ]
								} ],
								nodes: []
							}
						};
					}
				};
				service.graphRepository = {
					getGraph: ( runId, resultLimit ) => {
						return {
							dependencies: [
								{ id: "d1", sourceFile: "app/A.cfc", kind: "injects", targetFile: "app/B.cfc", evidence: "inject", line: 4 },
								{ id: "d2", sourceFile: "app/B.cfc", kind: "injects", targetFile: "app/C.cfc", evidence: "out", line: 5 },
								{ id: "d3", sourceFile: "app/A.cfc", kind: "tests", targetFile: "app/B.cfc" },
								{ id: "d4", sourceFile: "app/Handlers/X.cfc", kind: "injects", targetFile: "app/B.cfc", evidence: "caller", line: 9 }
							]
						};
					}
				};

				var payload = service.fileEdges( "run-1", { clusterId: "c1", limit: 50 } );
				expect( payload.edges ).toHaveLength( 3 );
				expect( payload.edges[ 1 ].from ).toBe( "app/a.cfc" );
				expect( payload.edges[ 1 ].to ).toBe( "app/b.cfc" );
				expect( payload.edges[ 1 ].kind ).toBe( "injects" );
				expect( payload.edges[ 1 ].evidence ).toBe( "inject" );
				expect( payload.edges[ 1 ].crossing ?: false ).toBeFalse();
				expect( payload.edges[ 2 ].crossing ).toBeTrue();
				expect( payload.edges[ 2 ].to ).toBe( "app/c.cfc" );
				expect( payload.edges[ 3 ].crossing ).toBeTrue();
				expect( payload.edges[ 3 ].from ).toBe( "app/handlers/x.cfc" );
				expect( payload.edges[ 3 ].to ).toBe( "app/b.cfc" );
				expect( payload.truncated ).toBeFalse();
				var defaultPayload = service.fileEdges( "run-1", { clusterId: "c1" } );
				expect( defaultPayload.edges ).toHaveLength( 3 );
				expect( defaultPayload.truncated ).toBeFalse();
			} );

			it( "refreshNarrative re-narrates stored snapshot and persists without re-index", () => {
				var calls = { narrate: 0, update: 0 };
				var service = new app.models.services.CodeGraphRunService();
				service.codeGraphRepository = {
					get: ( runId ) => {
						return {
							projectPath        : "C:/proj",
							repositoryRevision : "HEAD",
							snapshot           : {
								fingerprint : "fp-1",
								clusters    : [ { id: "c1" } ],
								nodes       : [ { id: "app/a.cfc", path: "app/a.cfc" } ],
								flows       : []
							}
						};
					},
					updateNarrative: ( runId, narrative, cacheKey ) => {
						calls.update++;
						expect( runId ).toBe( "run-narrate" );
						expect( narrative.used ).toBeTrue();
						expect( len( trim( cacheKey ) ) ).toBeGT( 0 );
					}
				};
				service.narrativeService = {
					isEnabled: () => true,
					cacheKey: ( snapshot, projectPath ) => "cache-key-1",
					narrate: ( snapshot ) => {
						calls.narrate++;
						expect( snapshot.fingerprint ).toBe( "fp-1" );
						return {
							used    : true,
							enabled : true,
							pitch   : { text: "Hello" },
							domains : [],
							processes: [],
							onboarding: [],
							risk    : [],
							summaries: []
						};
					}
				};

				var result = service.refreshNarrative( "run-narrate" );
				expect( result.used ).toBeTrue();
				expect( calls.narrate ).toBe( 1 );
				expect( calls.update ).toBe( 1 );
			} );

			it( "returns a bounded cited source window without allowing traversal", () => {
				var sourceRoot = getTempDirectory() & "doublecheck-codegraph-source-" & replace( lCase( createUUID() ), "-", "", "all" );
				directoryCreate( sourceRoot & "/src", true, true );
				fileWrite( sourceRoot & "/src/Sample.bx", "one" & char( 10 ) & "focused" & char( 10 ) & "three" & char( 10 ) & "four" );
				try {
					var service = new app.models.services.CodeGraphRunService();
					service.codeGraphRepository = {
						get: ( runId ) => { return { projectPath: sourceRoot }; }
					};
					service.codegraphSourceMaxBytes = 1024 * 1024;
					service.codegraphSourceBeforeLines = 1;
					service.codegraphSourceAfterLines = 1;

					var excerpt = service.sourceExcerpt( "run-source", { path: "src/Sample.bx", line: 2, before: 1, after: 1 } );
					expect( excerpt.available ).toBeTrue();
					expect( excerpt.path ).toBe( "src/Sample.bx" );
					expect( excerpt.startLine ).toBe( 1 );
					expect( excerpt.endLine ).toBe( 3 );
					expect( excerpt.lines ).toHaveLength( 3 );
					expect( excerpt.lines[ 2 ].text ).toBe( "focused" );
					expect( excerpt.lines[ 2 ].focus ).toBeTrue();
					expect( () => service.sourceExcerpt( "run-source", { path: "../outside.bx", line: 1 } ) )
						.toThrow( type = "ValidationException" );
					expect( () => service.sourceExcerpt( "run-source", { path: "src/Sample.bx", line: 99 } ) )
						.toThrow( type = "ValidationException" );
				} finally {
					if ( directoryExists( sourceRoot ) ) directoryDelete( sourceRoot, true );
				}
			} );

			it( "cancelRun is a no-op", () => {
				var service = new app.models.services.CodeGraphRunService();
				service.cancelRun( "any-id" );
				expect( true ).toBeTrue();
			} );

		} );
	}

	private any function executableService( required struct persisted ) {
		var state = arguments.persisted;
		var service = new app.models.services.CodeGraphRunService();
		service.architectureIndexService = { index: ( runId, files ) => { return {}; } };
		service.graphRepository = {
			getGraph: ( runId, resultLimit ) => { return { symbols: [], dependencies: [], impacts: [], summary: {} }; },
			adoptRunGraph: ( sourceRunId, targetRunId ) => {}
		};
		service.metricsService = {
			assemble: ( reviewGraph, options ) => {
				return {
					version: "codegraph-snapshot-v1",
					fingerprint: "structure-fingerprint",
					truncated: false,
					truncationReasons: [],
					totals: { nodes: 0, edges: 0, clusters: 0, cycles: 0 },
					nodes: [], clusters: [], flows: [], clusterEdges: [], cycles: [],
					hotspots: [], orphans: [], layerViolations: [], directories: []
				};
			}
		};
		service.codeGraphRepository = {
			save: ( runId, snapshot, projectPath, repositoryRevision, narrativeCacheKey, narrative ) => {
				state.saveCount++;
				state.snapshot = duplicate( snapshot );
				state.narrative = duplicate( narrative );
			},
			updateNarrative: ( runId, narrative, narrativeCacheKey, snapshot ) => {
				state.updateCount++;
				state.narrative = duplicate( narrative );
			}
		};
		service.eventService = { publish: () => {} };
		service.codegraphMaxEdges = 20000;
		service.codegraphMaxSymbols = 20000;
		service.codegraphMaxNodes = 1500;
		service.codegraphMaxClusters = 60;
		service.codegraphMaxHotspots = 50;
		service.codegraphMaxOrphans = 200;
		service.codegraphMaxLayerViolations = 200;
		service.codegraphFlowMaxDepth = 3;
		service.codegraphMaxFlowsPerCluster = 4;
		service.codegraphLayerPolicy = "application-models>http-handlers";
		service.codegraphCoChangeEnabled = false;
		service.codegraphScanMaxEntries = 30000;
		service.gitRepositoryService = {
			workingTreePaths: ( root, maxEntries ) => { return { available: true, paths: [], truncated: false }; },
			commitFilePairs: () => { return { available: false, commits: [], reason: "disabled" }; }
		};
		return service;
	}

}
