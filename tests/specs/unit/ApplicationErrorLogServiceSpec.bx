class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "ApplicationErrorLogService", () => {
			beforeEach( () => {
				variables.logPath = getTempDirectory() & "app-error-log-test-#createUUID()#.log";
			} );

			afterEach( () => {
				try {
					if ( fileExists( variables.logPath ) ) {
						fileDelete( variables.logPath );
					}
				} catch (any e) {
					// ignore locked files on Windows
				}
			} );

			it( "writes a parseable JSON line with a valid ISO timestamp", () => {
				var service = new app.models.services.ApplicationErrorLogService();
				service.logPath = variables.logPath;

				service.error( "boom", { source: "unit-test" } );

				expect( fileExists( variables.logPath ) ).toBeTrue();
				var line = trim( fileRead( variables.logPath ) );
				var record = jsonDeserialize( line );
				expect( record.message ).toBe( "boom" );
				expect( record.context.source ).toBe( "unit-test" );
				expect( isDate( record.timestamp ) ).toBeTrue();
			} );

			it( "does nothing when no log path is configured", () => {
				var service = new app.models.services.ApplicationErrorLogService();
				service.error( "boom", {} );
				expect( fileExists( variables.logPath ) ).toBeFalse();
			} );
		} );
	}
}
