class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "CodeGraphNarrativeService", () => {

			it( "makes zero gateway calls when no key / provider is disabled", () => {
				var calls = { chat: 0 };
				var service = new app.models.services.CodeGraphNarrativeService();
				service.chatGateway = {
					isEnabled: ( apiKey, isLocal ) => false,
					chat: ( messages, params, options ) => {
						calls.chat++;
						return { pitch: { text: "" }, domains: [], processes: [], onboarding: [], risk: [], summaries: [] };
					}
				};
				service.aiProviderResolver = new tests.resources.StubAIProviderResolver( {
					provider: "openai",
					apiKey  : "",
					model   : "test",
					isLocal : false,
					timeout : 1
				} );
				service.secretRedactionService = { redactText: ( text ) => text };
				service.maxClusters = 24;
				service.maxHotspots = 20;
				service.maxPromptCharacters = 30000;

				var snapshot = sampleSnapshot();
				var before = duplicate( snapshot );
				var result = service.narrate( snapshot );

				expect( result.used ).toBeFalse();
				expect( calls.chat ).toBe( 0 );
				expect( snapshot ).toBe( before );
			} );

			it( "requests enough max_tokens for full v2 narrative JSON", () => {
				var captured = { max_tokens: 0 };
				var service = new app.models.services.CodeGraphNarrativeService();
				service.chatGateway = {
					isEnabled: ( apiKey, isLocal ) => true,
					chat: ( messages, params, options ) => {
						captured.max_tokens = val( params.max_tokens ?: 0 );
						return v2FixtureResponse();
					}
				};
				service.aiProviderResolver = new tests.resources.StubAIProviderResolver( {
					provider      : "openai-compatible",
					apiKey        : "test-key",
					model         : "corpus-v1",
					isLocal       : false,
					timeout       : 1,
					contextWindow : 128000
				} );
				service.secretRedactionService = { redactText: ( text ) => text };
				var compiler = stubCompiler();
				compiler.capabilities = ( provider ) => {
					return { distinctSystem: true, maxOutputTokens: 16000, jsonObject: true };
				};
				service.promptCompiler = compiler;
				service.promptOutputValidator = stubPassThroughValidator();
				service.maxClusters = 24;
				service.maxHotspots = 20;
				service.maxPromptCharacters = 30000;

				var result = service.narrate( sampleSnapshot() );
				expect( result.used ).toBeTrue();
				expect( captured.max_tokens ).toBeGTE( 4096 );
			} );

			it( "drops domains and summaries that cite an unknown clusterId", () => {
				var service = new app.models.services.CodeGraphNarrativeService();
				service.chatGateway = {
					isEnabled: ( apiKey, isLocal ) => true,
					chat: ( messages, params, options ) => {
						return v2FixtureResponse();
					}
				};
				service.aiProviderResolver = new tests.resources.StubAIProviderResolver( {
					provider      : "deterministic-fake",
					apiKey        : "test-key",
					model         : "corpus-v1",
					isLocal       : false,
					timeout       : 1,
					contextWindow : 8000
				} );
				service.secretRedactionService = { redactText: ( text ) => text };
				service.promptCompiler = stubCompiler();
				service.promptOutputValidator = stubPassThroughValidator();
				service.maxClusters = 24;
				service.maxHotspots = 20;
				service.maxPromptCharacters = 30000;

				var result = service.narrate( sampleSnapshot() );

				expect( result.used ).toBeTrue();
				expect( result.version ).toBe( "codegraph-narrative-v2" );
				expect( result.domains.len() ).toBe( 1 );
				expect( result.domains[ 1 ].clusterId ).toBe( "cluster-real" );
				expect( result.summaries.len() ).toBe( 1 );
				expect( result.summaries[ 1 ].clusterId ).toBe( "cluster-real" );
				var domainIds = result.domains.map( ( item ) => item.clusterId );
				expect( domainIds ).notToInclude( "cluster-unknown" );
			} );

			it( "drops processes that cite an unknown flowId", () => {
				var service = new app.models.services.CodeGraphNarrativeService();
				service.chatGateway = {
					isEnabled: ( apiKey, isLocal ) => true,
					chat: ( messages, params, options ) => {
						return v2FixtureResponse();
					}
				};
				service.aiProviderResolver = new tests.resources.StubAIProviderResolver( {
					provider      : "deterministic-fake",
					apiKey        : "test-key",
					model         : "corpus-v1",
					isLocal       : false,
					timeout       : 1,
					contextWindow : 8000
				} );
				service.secretRedactionService = { redactText: ( text ) => text };
				service.promptCompiler = stubCompiler();
				service.promptOutputValidator = stubPassThroughValidator();
				service.maxClusters = 24;
				service.maxHotspots = 20;
				service.maxPromptCharacters = 30000;

				var result = service.narrate( sampleSnapshot() );

				expect( result.used ).toBeTrue();
				expect( result.processes.len() ).toBe( 1 );
				expect( result.processes[ 1 ].flowId ).toBe( "flow-real" );
				var flowIds = result.processes.map( ( item ) => item.flowId );
				expect( flowIds ).notToInclude( "flow-unknown" );
			} );

			it( "retains pitch text when the model supplies it", () => {
				var service = new app.models.services.CodeGraphNarrativeService();
				service.chatGateway = {
					isEnabled: ( apiKey, isLocal ) => true,
					chat: ( messages, params, options ) => {
						return v2FixtureResponse();
					}
				};
				service.aiProviderResolver = new tests.resources.StubAIProviderResolver( {
					provider      : "deterministic-fake",
					apiKey        : "test-key",
					model         : "corpus-v1",
					isLocal       : false,
					timeout       : 1,
					contextWindow : 8000
				} );
				service.secretRedactionService = { redactText: ( text ) => text };
				service.promptCompiler = stubCompiler();
				service.promptOutputValidator = stubPassThroughValidator();
				service.maxClusters = 24;
				service.maxHotspots = 20;
				service.maxPromptCharacters = 30000;

				var result = service.narrate( sampleSnapshot() );

				expect( result.used ).toBeTrue();
				expect( result.pitch.text ).toBe( "A local BoxLang review helper." );
			} );

			it( "never mutates the deterministic snapshot when the gateway throws", () => {
				var service = new app.models.services.CodeGraphNarrativeService();
				service.chatGateway = {
					isEnabled: ( apiKey, isLocal ) => true,
					chat: ( messages, params, options ) => {
						throw( type = "AIGatewayException", message = "provider down" );
					}
				};
				service.aiProviderResolver = new tests.resources.StubAIProviderResolver( {
					provider      : "openai",
					apiKey        : "test-key",
					model         : "gpt-test",
					isLocal       : false,
					timeout       : 1,
					contextWindow : 8000
				} );
				service.secretRedactionService = { redactText: ( text ) => text };
				service.promptCompiler = stubCompiler();
				service.promptOutputValidator = stubPassThroughValidator();
				service.log = { error: ( message, detail ) => true };
				service.maxClusters = 24;
				service.maxHotspots = 20;
				service.maxPromptCharacters = 30000;

				var snapshot = sampleSnapshot();
				snapshot.marker = "untouched";
				var fingerprintBefore = snapshot.fingerprint;
				var clusterCountBefore = snapshot.clusters.len();

				var result = service.narrate( snapshot );

				expect( result.used ).toBeFalse();
				expect( len( result.error ?: "" ) ).toBeGT( 0 );
				expect( snapshot.marker ).toBe( "untouched" );
				expect( snapshot.fingerprint ).toBe( fingerprintBefore );
				expect( snapshot.clusters.len() ).toBe( clusterCountBefore );
			} );

			it( "produces a stable cacheKey for the same snapshot and project path", () => {
				var service = new app.models.services.CodeGraphNarrativeService();
				service.chatGateway = {
					isEnabled: ( apiKey, isLocal ) => false,
					chat: ( messages, params, options ) => { return {}; }
				};
				service.aiProviderResolver = new tests.resources.StubAIProviderResolver( {
					provider: "openai",
					apiKey  : "",
					model   : "test",
					isLocal : false
				} );

				var snapshot = sampleSnapshot();
				var a = service.cacheKey( snapshot, "C:/Projects/Demo" );
				var b = service.cacheKey( snapshot, "C:/Projects/Demo" );
				var c = service.cacheKey( snapshot, "C:/Projects/Other" );

				expect( a ).toBe( b );
				expect( a ).notToBe( c );
				expect( len( a ) ).toBe( 64 );
			} );

			it( "budgets each evidence section and relativizes provider paths", () => {
				var captured = {};
				var service = narrativeServiceForTests( true );
				var compiler = stubCompiler();
				compiler.compile = ( contractId, data, options ) => {
					captured.data = duplicate( arguments.data );
					return { messages: [ { role: "user", content: "test" } ], provenance: { contractId: contractId } };
				};
				service.promptCompiler = compiler;
				service.promptOutputValidator = stubPassThroughValidator();
				service.sectionReserve = 100;
				service.maxPromptCharacters = 12000;

				var result = service.narrate( payloadSnapshot(), "C:/Users/Sana/clients/orders" );

				expect( result.used ).toBeTrue();
				expect( captured.data.evidence.clusters[ 1 ].filePaths[ 1 ] ).toBe( "app/services/OrderService.bx" );
				expect( captured.data.evidence.flows[ 1 ].entryFile ).toBe( "app/handlers/OrderHandler.bx" );
				expect( captured.data.evidence.cycles[ 1 ].members[ 1 ] ).toBe( "app/services/OrderService.bx" );
				expect( jsonSerialize( captured.data ) ).notToInclude( "C:/Users/Sana/clients/orders" );
			} );

			it( "reuses unchanged shards and only calls the provider for a changed cluster", () => {
				var calls = { chat: 0, find: 0, save: 0 };
				var service = narrativeServiceForTests( true );
				service.codeGraphRepository = {
					clusterKey: ( cluster ) => cluster.id,
					clusterFingerprint: ( cluster ) => "fp-" & cluster.id,
					findNarrativeShard: ( projectPath, clusterKey, fingerprint ) => {
						calls.find++;
						return clusterKey == "cluster-first" ? cachedShard( "cluster-first", "First module" ) : javacast( "null", "" );
					},
					saveNarrativeShard: ( projectPath, clusterKey, fingerprint, narrative ) => { calls.save++; }
				};
				service.chatGateway = {
					isEnabled: ( apiKey, isLocal ) => true,
					chat: ( messages, params, options ) => {
						calls.chat++;
						return { pitch: {}, domains: [ { clusterId: "cluster-second", title: "Second module", text: "Changed" } ], processes: [], onboarding: [], risk: [], summaries: [] };
					}
				};
				service.promptCompiler = stubCompiler();
				service.promptOutputValidator = stubPassThroughValidator();

				var result = service.narrate( shardedSnapshot(), "C:/Projects/orders" );

				expect( result.used ).toBeTrue();
				expect( calls.find ).toBe( 2 );
				expect( calls.chat ).toBe( 1 );
				expect( calls.save ).toBe( 1 );
				expect( result.domains.map( ( item ) => item.clusterId ) ).toInclude( "cluster-first" );
				expect( result.domains.map( ( item ) => item.clusterId ) ).toInclude( "cluster-second" );
			} );

			it( "reuses the cluster shard when the graph has only one cluster", () => {
				var calls = { chat: 0, find: 0 };
				var service = narrativeServiceForTests( true );
				service.codeGraphRepository = {
					clusterKey: ( cluster ) => cluster.id,
					clusterFingerprint: ( cluster ) => "fp-" & cluster.id,
					findNarrativeShard: ( projectPath, clusterKey, fingerprint ) => {
						calls.find++;
						return cachedShard( clusterKey, "Orders module" );
					},
					saveNarrativeShard: ( projectPath, clusterKey, fingerprint, narrative ) => {}
				};
				service.chatGateway = {
					isEnabled: ( apiKey, isLocal ) => true,
					chat: ( messages, params, options ) => { calls.chat++; return v2FixtureResponse(); }
				};

				var result = service.narrate( payloadSnapshot(), "C:/Projects/orders" );

				expect( result.used ).toBeTrue();
				expect( calls.find ).toBe( 1 );
				expect( calls.chat ).toBe( 0 );
			} );

		} );
	}

	private struct function narrativeServiceForTests( required boolean enabled ) {
		var service = new app.models.services.CodeGraphNarrativeService();
		var providerEnabled = arguments.enabled;
		service.chatGateway = {
			isEnabled: ( apiKey, isLocal ) => providerEnabled,
			chat: ( messages, params, options ) => v2FixtureResponse()
		};
		service.aiProviderResolver = new tests.resources.StubAIProviderResolver( {
			provider: "deterministic-fake", apiKey: arguments.enabled ? "test-key" : "", model: "corpus-v1", isLocal: false, timeout: 1, contextWindow: 8000
		} );
		service.secretRedactionService = { redactText: ( text ) => text };
		service.maxClusters = 24;
		service.maxHotspots = 20;
		service.maxFlows = 24;
		service.maxCycles = 12;
		service.maxPromptCharacters = 30000;
		return service;
	}

	private struct function payloadSnapshot() {
		return {
			fingerprint: "payload-fingerprint",
			clusters: [ { id: "cluster-real", label: "orders", filePaths: [ "C:/Users/Sana/clients/orders/app/services/OrderService.bx" ], fileCount: 1, symbolCount: 3 } ],
			nodes: [ { id: "C:/Users/Sana/clients/orders/app/services/OrderService.bx", path: "C:/Users/Sana/clients/orders/app/services/OrderService.bx", role: "domain" } ],
			hotspots: [ { id: "C:/Users/Sana/clients/orders/app/services/OrderService.bx", path: "C:/Users/Sana/clients/orders/app/services/OrderService.bx", hotspotScore: 1 } ],
			flows: [ { id: "flow-real", entryFile: "C:/Users/Sana/clients/orders/app/handlers/OrderHandler.bx", entrySymbol: "create", steps: [ "C:/Users/Sana/clients/orders/app/handlers/OrderHandler.bx" ], sinkFile: "C:/Users/Sana/clients/orders/app/services/OrderService.bx" } ],
			cycles: [ [ "C:/Users/Sana/clients/orders/app/services/OrderService.bx" ] ]
		};
	}

	private struct function shardedSnapshot() {
		var snapshot = payloadSnapshot();
		snapshot.clusters = [
			{ id: "cluster-first", label: "first", filePaths: [ "app/first.bx" ], fileCount: 1, symbolCount: 1 },
			{ id: "cluster-second", label: "second", filePaths: [ "app/second.bx" ], fileCount: 1, symbolCount: 1 }
		];
		snapshot.nodes = [
			{ id: "app/first.bx", path: "app/first.bx", clusterId: "cluster-first", role: "domain" },
			{ id: "app/second.bx", path: "app/second.bx", clusterId: "cluster-second", role: "domain" }
		];
		return snapshot;
	}

	private struct function cachedShard( required string clusterId, required string title ) {
		return { used: true, enabled: true, version: "codegraph-narrative-v2", provider: "cache", model: "cache", pitch: {}, domains: [ { clusterId: arguments.clusterId, title: arguments.title, text: "Cached" } ], processes: [], onboarding: [], risk: [], summaries: [], coverage: {}, trimmedSections: [] };
	}

	private struct function sampleSnapshot() {
		return {
			version     : "codegraph-snapshot-v1",
			fingerprint : "fp-narrative-test",
			clusters    : [
				{
					id          : "cluster-real",
					label       : "models",
					fileCount   : 1,
					symbolCount : 2,
					filePaths   : [ "app/models/Order.cfc" ]
				}
			],
			nodes: [
				{ id: "app/models/Order.cfc", path: "app/models/Order.cfc", clusterId: "cluster-real", role: "domain" }
			],
			hotspots: [
				{ id: "app/models/Order.cfc", path: "app/models/Order.cfc", hotspotScore: 0.9, fanIn: 3, fanOut: 1 }
			],
			flows: [
				{
					id          : "flow-real",
					entryFile   : "app/handlers/Orders.bx",
					entrySymbol : "create",
					steps       : [ "app/handlers/Orders.bx", "app/models/Order.cfc" ],
					sinkFile    : "app/models/Order.cfc"
				}
			],
			cycles: [
				[ "app/models/Order.cfc", "app/models/Invoice.cfc" ]
			]
		};
	}

	private struct function v2FixtureResponse() {
		return {
			pitch: { text: "A local BoxLang review helper." },
			domains: [
				{ clusterId: "cluster-real", title: "Orders", text: "Order domain modules." },
				{ clusterId: "cluster-unknown", title: "Ghost", text: "Should be dropped." }
			],
			processes: [
				{ flowId: "flow-real", title: "Create order", text: "Handler to model." },
				{ flowId: "flow-unknown", title: "Ghost flow", text: "Should be dropped." }
			],
			onboarding: [],
			risk: [],
			summaries: [
				{ clusterId: "cluster-real", title: "Orders", text: "Order domain modules." },
				{ clusterId: "cluster-unknown", title: "Ghost", text: "Should be dropped." }
			]
		};
	}

	private struct function stubCompiler() {
		return {
			compile: ( contractId, data, options ) => {
				return {
					messages   : [ { role: "user", content: "test" } ],
					provenance : { contractId: contractId }
				};
			},
			compileRepair: ( activePackage, message ) => arguments.activePackage,
			capabilities: ( provider ) => {
				return { distinctSystem: true, maxOutputTokens: 1000, jsonObject: true };
			},
			structuredOutput: ( contractId, provider ) => {
				return { response_format: { type: "json_object" } };
			}
		};
	}

	private struct function stubPassThroughValidator() {
		return {
			sanitizeValid: ( response, schemaId, context ) => {
				var value = isStruct( arguments.response ) ? arguments.response : jsonDeserialize( arguments.response );
				return { value: value, rejectedItems: [], valid: true };
			}
		};
	}

}
