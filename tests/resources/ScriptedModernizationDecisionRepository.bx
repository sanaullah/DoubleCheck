class {
	property name="planRecord";
	property name="decisions";
	property name="events";

	function init( required struct plan ) {
		variables.planRecord = { runId: "run-1", fingerprint: "plan-fp", state: "needs-review", plan: duplicate( arguments.plan ), validation: { blocking: 0 }, coverage: {} };
		variables.decisions = [];
		variables.events = [];
		return this;
	}
	any function getPlan( required string runId ) { return variables.planRecord; }
	struct function upsertDecision( required string runId, required struct decision ) {
		var found = javacast( "null", "" );
		for ( var item in variables.decisions ) if ( item.itemType == decision.itemType && item.itemId == decision.itemId ) found = item;
		if ( isNull( found ) ) { found = duplicate( decision ); variables.decisions.append( found ); } else structAppend( found, duplicate( decision ), true );
		return found;
	}
	void function deleteDecision( required string runId, required string itemType, required string itemId ) { variables.decisions = variables.decisions.filter( ( item ) => !( item.itemType == itemType && item.itemId == itemId ) ); }
	struct function appendDecisionEvent( required string runId, required struct event ) { variables.events.append( duplicate( event ) ); return { success: true }; }
	array function listDecisions( required string runId ) { return duplicate( variables.decisions ); }
	array function listDecisionEvents( required string runId ) { return duplicate( variables.events ); }
	struct function savePlan( required string runId, required any plan, struct validation = {}, struct coverage = {} ) { variables.planRecord.plan = isStruct( arguments.plan ) ? duplicate( arguments.plan ) : {}; variables.planRecord.state = variables.planRecord.plan.state ?: variables.planRecord.state; return variables.planRecord; }
}
