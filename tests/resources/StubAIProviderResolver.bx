/** Configurable stand-in for AIProviderResolverService.resolve() in unit specs that construct a gateway directly. */
class {
	variables.data = {
		profileId          : "",
		profileName         : "",
		provider            : "",
		baseURL             : "",
		apiKey              : "",
		model               : "",
		timeout             : 120,
		contextWindow       : 128000,
		maxPromptCharacters : 60000,
		isLocal             : false,
		inputUsdPerMillion  : 0,
		outputUsdPerMillion : 0
	};

	function init( struct overrides = {} ) {
		structAppend( variables.data, arguments.overrides, true );
		return this;
	}

	/** Reconfigures fields mid-test, e.g. to simulate switching models between assertions. */
	function set( required struct overrides ) {
		structAppend( variables.data, arguments.overrides, true );
		return this;
	}

	struct function resolve( string profileId = "" ) {
		return duplicate( variables.data );
	}
}
