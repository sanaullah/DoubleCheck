class {
	property name="runId";
	property name="runKind";
	property name="projectPath";
	property name="input";
	property name="policy";
	property name="budgets";
	property name="sourceRunId";
	function init( required string runId = "run-1", required string runKind = "modernize", string projectPath = "", struct input = {}, struct policy = {}, struct budgets = {}, string sourceRunId = "" ) {
		variables.runId = arguments.runId;
		variables.runKind = arguments.runKind;
		variables.projectPath = arguments.projectPath;
		variables.input = duplicate( arguments.input );
		variables.policy = duplicate( arguments.policy );
		variables.budgets = duplicate( arguments.budgets );
		variables.sourceRunId = arguments.sourceRunId;
		return this;
	}
	string function getId() { return variables.runId; }
	string function getRunKind() { return variables.runKind; }
	string function getProjectPath() { return variables.projectPath; }
	struct function getInput() { return duplicate( variables.input ); }
	struct function getPolicy() { return duplicate( variables.policy ); }
	struct function getBudgets() { return duplicate( variables.budgets ); }
	string function getSourceRunId() { return variables.sourceRunId; }
}
