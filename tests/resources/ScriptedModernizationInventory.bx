/** In-memory inventory double for modernization pipeline lifecycle specs. */
class {
	property name="result";
	property name="calls" type="numeric" default="0";
	function init( struct result = {} ) { variables.result = duplicate( arguments.result ); variables.calls = 0; return this; }
	struct function build( required struct scan ) { variables.calls++; return duplicate( variables.result ); }
	numeric function callCount() { return variables.calls; }
}
