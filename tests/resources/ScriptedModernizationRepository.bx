/** In-memory modernization repository double for pipeline lifecycle specs. */
class {
	property name="checkpoints";
	property name="schemaPack";
	property name="planRecord";
	property name="decisions";
	property name="events";
	property name="checkpointWrites";

	function init( array checkpoints = [], any schemaPack = javacast( "null", "" ) ) {
		variables.checkpoints = duplicate( arguments.checkpoints );
		variables.schemaPack = arguments.schemaPack;
		variables.planRecord = javacast( "null", "" );
		variables.decisions = [];
		variables.events = [];
		variables.checkpointWrites = 0;
		return this;
	}

	array function getCheckpoints( required string runId ) { return duplicate( variables.checkpoints ); }
	any function getSchemaPack( required string runId ) { return variables.schemaPack; }
	struct function saveSchemaPack( required string runId, required struct schemaPack ) { variables.schemaPack = duplicate( arguments.schemaPack ); return variables.schemaPack; }
	struct function saveCheckpoint( required string runId, required string stage, required struct checkpoint ) {
		variables.checkpointWrites++;
		var saved = { runId: arguments.runId, stage: arguments.stage, status: checkpoint.status ?: "pending", progress: checkpoint.progress ?: 0, payload: duplicate( checkpoint.payload ?: {} ) };
		variables.checkpoints = variables.checkpoints.filter( ( item ) => ( item.stage ?: "" ) != arguments.stage );
		variables.checkpoints.append( saved );
		return saved;
	}
	struct function savePlan( required string runId, required any plan, struct validation = {}, struct coverage = {} ) {
		variables.planRecord = { runId: arguments.runId, state: plan.state ?: "generated", fingerprint: plan.fingerprint ?: "plan-fp", plan: duplicate( plan ), validation: duplicate( arguments.validation ), coverage: duplicate( arguments.coverage ) };
		return variables.planRecord;
	}
	any function getPlan( required string runId ) { return variables.planRecord; }
	array function listDecisions( required string runId ) { return duplicate( variables.decisions ); }
	array function listDecisionEvents( required string runId ) { return duplicate( variables.events ); }
	struct function upsertDecision( required string runId, required struct decision ) { variables.decisions.append( duplicate( arguments.decision ) ); return arguments.decision; }
	void function deleteDecision( required string runId, required string itemType, required string itemId ) {}
	struct function appendDecisionEvent( required string runId, required struct event ) { variables.events.append( duplicate( arguments.event ) ); return { success: true }; }
}
