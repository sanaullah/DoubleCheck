/** Tiny aiChat double used to exercise JSON/retry/cancellation contracts. */
class {
	property name="response";
	property name="enabled" type="boolean" default="true";
	property name="calls" type="numeric" default="0";

	function init( any response = { ok: true }, boolean enabled = true ) {
		variables.response = arguments.response;
		variables.enabled = arguments.enabled;
		variables.calls = 0;
		return this;
	}
	boolean function isEnabled( required string provider, required string apiKey ) { return variables.enabled; }
	any function chat( required any prompt, required struct params, required struct options ) { variables.calls++; return variables.response; }
	numeric function callCount() { return variables.calls; }
}
