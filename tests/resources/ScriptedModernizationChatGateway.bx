/** Tiny aiChat double used to exercise JSON/retry/cancellation contracts. */
class {
	property name="response";
	property name="responses" type="array";
	property name="enabled" type="boolean" default="true";
	property name="calls" type="numeric" default="0";
	property name="lastParams" type="struct";
	property name="lastOptions" type="struct";
	property name="lastPrompt";
	property name="throwMessage" type="string" default="";
	property name="throwType" type="string" default="";

	function init( any response = { ok: true }, boolean enabled = true, array responses = [] ) {
		variables.response = arguments.response;
		variables.responses = arguments.responses;
		variables.enabled = arguments.enabled;
		variables.calls = 0;
		variables.lastParams = {};
		variables.lastOptions = {};
		variables.lastPrompt = "";
		variables.throwMessage = "";
		variables.throwType = "";
		return this;
	}
	boolean function isEnabled( required string provider, required string apiKey ) { return variables.enabled; }
	any function chat( required any prompt, required struct params, required struct options ) {
		variables.calls++;
		variables.lastPrompt = arguments.prompt;
		variables.lastParams = duplicate( arguments.params );
		variables.lastOptions = duplicate( arguments.options );
		if ( len( trim( variables.throwMessage ?: "" ) ) ) {
			throw(
				type = len( trim( variables.throwType ?: "" ) ) ? variables.throwType : "ProviderException",
				message = variables.throwMessage
			);
		}
		if ( isArray( variables.responses ) && variables.responses.len() >= variables.calls ) {
			return variables.responses[ variables.calls ];
		}
		return variables.response;
	}
	numeric function callCount() { return variables.calls; }
}
