class {
	variables.response = {};
	variables.requests = [];

	function init( required any response ) {
		variables.response = arguments.response;
		return this;
	}

	boolean function isEnabled( required string provider, required string apiKey ) {
		return true;
	}

	any function chat( required any prompt, required struct params, required struct options ) {
		variables.requests.append(
				{
					prompt : arguments.prompt,
					params : duplicate( arguments.params ),
					options: duplicate( arguments.options )
				}
			);
		return duplicate( variables.response );
	}

	array function getRequests() {
		return duplicate( variables.requests );
	}
}