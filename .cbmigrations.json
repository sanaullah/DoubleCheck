{
    "default": {
        "manager": "cfmigrations.models.QBMigrationManager",
        "migrationsDirectory": "resources/database/migrations/",
        "seedsDirectory": "resources/database/seeds/",
        "properties": {
            "defaultGrammar": "SQLiteGrammar@qb",
            "migrationsTable": "cbmigrations",
            "datasource": "doublecheck",
            "connectionInfo": {
                "driver": "sqlite",
                "database": "${DOUBLECHECK_DB_PATH:./.db/doublecheck.db}",
                "connectionString": "jdbc:sqlite:${DOUBLECHECK_DB_PATH:./.db/doublecheck.db}",
                "class": "org.sqlite.JDBC"
            }
        }
    }
}
