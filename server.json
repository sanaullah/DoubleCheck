{
	"name":"DoubleCheck",
	"app":{
		"cfengine":"boxlang@be",
		"engineConfigFile":"./runtime/boxlang.json"
	},
	"jvm":{
		"heapSize":"4096",
		"javaVersion":"openjdk25_jre",
		"args":"-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=8889"
	},
	"web":{
		"webroot":"public",
		"rewrites":{
			"enable":true
		},
		"aliases":{
			"/coldbox/system/exceptions":"./lib/coldbox/system/exceptions/",
			"/tests":"./tests/",
			"/cbswagger":"./lib/modules/cbswagger/",
			"/api/v1/openapi.json":"./resources/apidocs/openapi.json",
			"/api/v1/openapi.yaml":"./resources/apidocs/openapi.yaml"
		}
	},
	"scripts":{
		"onServerInitialInstall":"install bx-esapi,bx-ai,bx-sqlite"
	},
	"openBrowser":false
}