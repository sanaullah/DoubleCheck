#Name and Environment
APPNAME=DoubleCheck
ENVIRONMENT=development

# BoxLang Environment
BOXLANG_DEBUG=true

# DoubleCheck persistence
DOUBLECHECK_DB_PATH=./.db/doublecheck.db

# BoxLang AI (deterministic review still runs without credentials)
# These 4 values are the ONLY provider connection settings. They are shared by
# both plain Review specialists and the Modernize gateway - there is no
# separate provider config for Modernize.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
DEFAULT_MODEL=
# Use openrouter for https://openrouter.ai/api/v1; use openai-compatible only
# for an arbitrary compatible endpoint that has no first-class bx-ai provider.
AI_PROVIDER=openai
# Per-request provider timeout in seconds. Shared by Review and Modernize;
# Modernize additionally caps each call to its own remaining run budget (see
# DOUBLECHECK_RUN_DEFAULT_DURATION_MS below - Modernize does NOT use it).
AI_TIMEOUT=120
AI_MAX_PROMPT_CHARACTERS=60000

# Modernize workspace (LLM-assisted, read-only analysis).
# These settings control repository EVIDENCE GATHERING ONLY (inventory,
# schema, and context-pack size limits). They do NOT control Modernize's
# provider token/cost/time/shard budgets - those are fixed ceilings in
# ReviewRunService.normalizeModernizationBudgets() (max 16,000 tokens/task,
# $200, 30 minutes, 20 shards) and are set PER RUN from the "Advanced limits"
# and Modernize settings panel in the UI (or the API's `budgets` field), not
# from this file. DOUBLECHECK_RUN_* below applies to plain Review runs only.
DOUBLECHECK_MODERNIZE_DEFAULT_COLDBOX_MAJOR=8
DOUBLECHECK_MODERNIZE_DEFAULT_CLI_MAJOR=6
DOUBLECHECK_MODERNIZE_MAX_SAMPLE_FILES=80
DOUBLECHECK_MODERNIZE_MAX_OUTCOMES=12
DOUBLECHECK_MODERNIZE_SCHEMA_MAX_BYTES=2097152
DOUBLECHECK_MODERNIZE_SCHEMA_MAX_FILES=100
DOUBLECHECK_MODERNIZE_SCHEMA_MAX_STATEMENTS=5000
DOUBLECHECK_MODERNIZE_EVIDENCE_MAX_FILES=10000
DOUBLECHECK_MODERNIZE_EVIDENCE_MAX_BYTES=1048576
DOUBLECHECK_MODERNIZE_MAX_CONTEXT_PARTITIONS=100
DOUBLECHECK_MODERNIZE_MAX_CONTEXT_CHARACTERS=240000
DOUBLECHECK_MODERNIZE_MAX_CONTEXT_LINES_PER_FILE=160
DOUBLECHECK_MODERNIZE_MAX_CONTEXT_CHARACTERS_PER_PARTITION=18000
# Token context size of the loaded model (LM Studio / Ollama / llama.cpp n_ctx).
# Local default is 8192 when OPENAI_API_BASE is localhost. Raise to match the
# server (e.g. 32768) if specialists fail with exceed_context_size_error.
# AI_CONTEXT_WINDOW=8192

# Repository scan budgets
DOUBLECHECK_SCAN_MAX_FILES=250
DOUBLECHECK_SCAN_MAX_BYTES=10485760
DOUBLECHECK_SCAN_MAX_FILE_BYTES=524288
DOUBLECHECK_SCAN_MAX_ENTRIES=5000
# Modernize scans the whole legacy estate by default while ordinary review
# keeps the faster limits above. Reduce these on memory-constrained desktops.
DOUBLECHECK_MODERNIZE_SCAN_MAX_FILES=10000
DOUBLECHECK_MODERNIZE_SCAN_MAX_BYTES=67108864
DOUBLECHECK_MODERNIZE_SCAN_MAX_ENTRIES=30000
DOUBLECHECK_MODERNIZE_SCAN_MAX_JAVASCRIPT_FILES=500
DOUBLECHECK_GRAPH_RESULT_LIMIT=1000
DOUBLECHECK_GRAPH_IMPACT_MAX_DEPTH=3
DOUBLECHECK_GRAPH_IMPACT_MAX_NODES=2000
# CodeGraph (CF/BoxLang knowledge graph workspace)
DOUBLECHECK_CODEGRAPH_SCAN_MAX_FILES=2500
DOUBLECHECK_CODEGRAPH_SCAN_MAX_BYTES=33554432
DOUBLECHECK_CODEGRAPH_SCAN_MAX_ENTRIES=30000
DOUBLECHECK_CODEGRAPH_MAX_NODES=1500
DOUBLECHECK_CODEGRAPH_MAX_EDGES=20000
DOUBLECHECK_CODEGRAPH_MAX_CLUSTERS=60
DOUBLECHECK_CODEGRAPH_MAX_HOTSPOTS=50
DOUBLECHECK_CODEGRAPH_MAX_ORPHANS=200
DOUBLECHECK_CODEGRAPH_MAX_LAYER_VIOLATIONS=200
DOUBLECHECK_CODEGRAPH_SUBGRAPH_MAX_NODES=300
DOUBLECHECK_CODEGRAPH_SUBGRAPH_MAX_DEPTH=3
DOUBLECHECK_CODEGRAPH_NARRATIVE_MAX_CLUSTERS=24
DOUBLECHECK_CODEGRAPH_NARRATIVE_MAX_HOTSPOTS=20
DOUBLECHECK_CODEGRAPH_NARRATIVE_MAX_CHARACTERS=30000
DOUBLECHECK_ARCHITECTURE_FACT_LIMIT=500
DOUBLECHECK_ARCHITECTURE_ENRICHMENT_FACT_LIMIT=200
DOUBLECHECK_ARCHITECTURE_ENRICHMENT_MAX_CHARACTERS=30000
DOUBLECHECK_ARCHITECTURE_ENRICHMENT_MAX_FACTS=50
DOUBLECHECK_PLAN_MAX_TASKS=6
DOUBLECHECK_PLAN_MAX_CONTEXT_FILES=20
DOUBLECHECK_PLAN_MAX_CONTEXT_CHARACTERS=30000
DOUBLECHECK_PLAN_MAX_CHANGED_SYMBOLS=50
DOUBLECHECK_PLAN_CONTEXT_BEFORE_LINES=3
DOUBLECHECK_PLAN_CONTEXT_AFTER_LINES=12
DOUBLECHECK_PLAN_MAX_CONTEXT_LINES=1000
DOUBLECHECK_PLAN_MAX_RANGES_PER_FILE=12
DOUBLECHECK_PLAN_MAX_LINES_PER_RANGE=80
DOUBLECHECK_PLAN_CONTEXT_MERGE_GAP=2

# Plain Review run budgets (ReviewPolicyService). These bound the "Advanced
# limits" fields in the Review UI/API for AI-assisted specialists only.
# Modernize ignores every DOUBLECHECK_RUN_* setting below - its ceilings are
# fixed in code (see the Modernize workspace section above) and its per-run
# values come from the Modernize settings panel, not from .env.
DOUBLECHECK_RUN_DEFAULT_TOKEN_BUDGET=12000
DOUBLECHECK_RUN_MAX_TOKEN_BUDGET=24000
DOUBLECHECK_RUN_DEFAULT_TOKENS_PER_TASK=3000
DOUBLECHECK_RUN_MAX_TOKENS_PER_TASK=6000
DOUBLECHECK_RUN_DEFAULT_DURATION_MS=120000
DOUBLECHECK_RUN_MAX_DURATION_MS=600000
# Local LM Studio / Ollama tip: raise both duration values above (e.g.
# 900000 / 1800000) and raise the single AI_TIMEOUT setting near the top of
# this file (e.g. 600) to match - there is only one AI_TIMEOUT, not a
# per-section override.
DOUBLECHECK_RUN_DEFAULT_ITERATIONS_PER_TASK=8
DOUBLECHECK_RUN_MAX_ITERATIONS_PER_TASK=20
DOUBLECHECK_RUN_DEFAULT_TOOL_OUTPUT_CHARACTERS=48000
DOUBLECHECK_RUN_MAX_TOOL_OUTPUT_CHARACTERS=120000
DOUBLECHECK_RUN_DEFAULT_COST_USD=5
DOUBLECHECK_RUN_MAX_COST_USD=50
DOUBLECHECK_RUN_MAX_CONCURRENT=2
DOUBLECHECK_RUN_LEASE_SECONDS=300
# Enforcement of the per-task cost estimate, tool call limit, repeated-call
# dedup, and tool output cap above. Off by default - these budgets were
# rejecting specialist tasks/tool calls too aggressively. Set to true to
# re-enable enforcement once the rates/limits above are tuned for your setup.
DOUBLECHECK_SPECIALIST_BUDGET_ENFORCEMENT_ENABLED=false

# Workers and evaluation corpus
DOUBLECHECK_WORKER_ID=
DOUBLECHECK_WORKER_ENABLED=true
DOUBLECHECK_WORKER_LEASE_SECONDS=60
DOUBLECHECK_WORKER_POLL_SECONDS=2
DOUBLECHECK_EVALUATION_CORPUS=./resources/evaluation-corpus/v1
DOUBLECHECK_CLEAR_CLASS_FILES=true
DOUBLECHECK_TRUSTED_CACHE=false
DOUBLECHECK_MODERNIZE_INVENTORY_MAX_DEEP_FILES=300

# Specialist orchestration
DOUBLECHECK_SPECIALIST_MAX_TOOL_CALLS=8
DOUBLECHECK_SPECIALIST_MAX_TOOL_OUTPUT_CHARACTERS=12000
DOUBLECHECK_SPECIALIST_MAX_SEARCH_MATCHES=20
DOUBLECHECK_SPECIALIST_TOOL_TIMEOUT_MS=2000
DOUBLECHECK_SPECIALIST_MAX_FINDINGS_PER_TASK=20
DOUBLECHECK_SPECIALIST_MAX_SUMMARY_CHARACTERS=2000
DOUBLECHECK_SPECIALIST_EXECUTOR_THREADS=1
DOUBLECHECK_SPECIALIST_MAX_RETRIES=2
DOUBLECHECK_SPECIALIST_RETRY_BACKOFF_MS=250
DOUBLECHECK_SPECIALIST_CIRCUIT_FAILURE_THRESHOLD=3
DOUBLECHECK_SPECIALIST_CIRCUIT_COOLDOWN_MS=30000
DOUBLECHECK_SPECIALIST_EVENT_COALESCE_MS=250

# Observability (specialist prompt/response/tool traces in UI + /traces export)
DOUBLECHECK_OBSERVABILITY_ENABLED=true
DOUBLECHECK_OBSERVABILITY_PREVIEW_CHARACTERS=1600

# Reservation rates (USD per million tokens) used to enforce each immutable
# run cost cap. These are NOT looked up automatically -- they must be set to
# match whatever model/provider is actually configured above, or the cost cap
# will be wildly inaccurate for cheap models (e.g. DeepSeek on OpenRouter is
# roughly $0.09/M input, $0.18/M output) and easy to blow through on tiny runs
# even though real spend is a fraction of a cent. Check your provider's
# pricing page for the exact model in use and update these accordingly.
DOUBLECHECK_SPECIALIST_INPUT_USD_PER_MILLION=100
DOUBLECHECK_SPECIALIST_OUTPUT_USD_PER_MILLION=100
