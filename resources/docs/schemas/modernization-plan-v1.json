{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doublecheck.local/schemas/modernization-plan-v1.json",
  "title": "DoubleCheck Modernization Plan v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "version", "metadata", "coverage", "assumptions", "inventory",
    "schemaEvidence", "signals", "target", "unitLinks", "dbFindings",
    "dbTransitions", "routeContracts", "roadmapPhases", "samples",
    "validation", "decisions"
  ],
  "properties": {
    "schemaVersion": { "const": "modernization-plan-v1" },
    "version": { "const": "modernization-plan-v1" },
    "metadata": { "$ref": "#/$defs/object" },
    "coverage": { "$ref": "#/$defs/object" },
    "assumptions": { "type": "array", "maxItems": 200 },
    "inventory": {
      "type": "object",
      "required": ["units", "routeEvidence", "dependencies", "unresolved"],
      "properties": {
        "units": { "type": "array", "items": { "$ref": "#/$defs/unit" }, "maxItems": 500 },
        "routeEvidence": { "type": "array", "items": { "$ref": "#/$defs/routeEvidence" }, "maxItems": 500 },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" }, "maxItems": 1000 },
        "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" }, "maxItems": 500 }
      },
      "additionalProperties": true
    },
    "schemaEvidence": {
      "type": "object",
      "required": ["objects", "routines", "unresolved"],
      "properties": {
        "database": { "$ref": "#/$defs/object" },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/schemaObject" }, "maxItems": 1000 },
        "routines": { "type": "array", "items": { "$ref": "#/$defs/schemaObject" }, "maxItems": 500 },
        "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" }, "maxItems": 500 }
      },
      "additionalProperties": true
    },
    "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" }, "maxItems": 1000 },
    "target": {
      "type": "object",
      "required": ["units", "contexts", "extracts"],
      "properties": {
        "runtime": { "enum": ["boxlang", "lucee"] },
        "layoutProfile": { "enum": ["boxlang", "modern", "flat"] },
        "units": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" }, "maxItems": 500 },
        "contexts": { "type": "array", "maxItems": 500 },
        "extracts": { "type": "array", "maxItems": 1000 }
      },
      "additionalProperties": true
    },
    "unitLinks": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" }, "maxItems": 1000 },
    "dbFindings": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" }, "maxItems": 1000 },
    "dbTransitions": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" }, "maxItems": 1000 },
    "routeContracts": {
      "type": "array", "items": {
        "allOf": [
          { "$ref": "#/$defs/decisionItem" },
          { "type": "object", "required": ["method", "path", "request", "response", "auth", "sideEffects", "rollback", "evidence"] }
        ]
      },
      "maxItems": 1000
    },
    "roadmapPhases": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" }, "maxItems": 100 },
    "samples": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["sampleKind", "targetPath", "language", "validationLevel", "relatedItemIds", "irreversible"],
        "properties": {
          "sampleKind": { "type": "string", "maxLength": 80 },
          "targetPath": { "type": "string", "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
          "language": { "type": "string", "enum": ["boxlang", "cfml", "sql", "json", "javascript", "java"] },
          "validationLevel": { "type": "string", "enum": ["evidence-grounded", "structurally-valid", "structurally-invalid", "syntax-checked", "syntax-unchecked", "dialect-checked", "dialect-unchecked", "human-reviewed", "human-unreviewed", "structural", "warning", "blocking", "unknown"] },
          "relatedItemIds": { "type": "array", "maxItems": 50 },
          "irreversible": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "validation": { "$ref": "#/$defs/object" },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" }, "maxItems": 2000 }
  },
  "$defs": {
    "object": { "type": "object", "additionalProperties": true },
    "evidenceRef": {
      "type": "object",
      "required": ["filePath", "startLine", "endLine"],
      "properties": {
        "filePath": { "type": "string", "maxLength": 240 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string", "maxLength": 128 },
        "extractionMethod": { "type": "string", "maxLength": 80 },
        "snippet": { "type": "string", "maxLength": 240 }
      },
      "additionalProperties": true
    },
    "unit": {
      "type": "object",
      "required": ["id", "filePath", "unitType", "startLine", "endLine", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "filePath": { "type": "string", "maxLength": 240 },
        "unitType": { "type": "string", "enum": ["page", "component", "function", "application", "custom-tag", "scheduled", "other"] },
        "symbolName": { "type": "string", "maxLength": 160 },
        "signature": { "type": "string", "maxLength": 500 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" }, "maxItems": 20 }
      },
      "additionalProperties": true
    },
    "routeEvidence": {
      "type": "object",
      "required": ["id", "filePath", "startLine", "endLine", "legacyPath", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "legacyPath": { "type": "string", "maxLength": 240 },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD", "UNKNOWN"] },
        "filePath": { "type": "string", "maxLength": 240 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" }, "maxItems": 20 }
      },
      "additionalProperties": true
    },
    "dependency": {
      "type": "object",
      "required": ["id", "kind", "target", "filePath", "startLine"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "type": "string", "maxLength": 80 },
        "target": { "type": "string", "maxLength": 240 },
        "filePath": { "type": "string", "maxLength": 240 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "unresolved": {
      "type": "object",
      "required": ["id", "kind", "filePath", "startLine"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "type": "string", "maxLength": 80 },
        "filePath": { "type": "string", "maxLength": 240 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "evidence": { "type": "string", "maxLength": 240 }
      },
      "additionalProperties": true
    },
    "schemaObject": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "kind": { "type": "string", "enum": ["table", "column", "constraint", "index", "procedure", "function", "view", "trigger", "routine", "other"] },
        "table": { "type": "string", "maxLength": 240 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" }, "maxItems": 20 }
      },
      "additionalProperties": true
    },
    "signal": {
      "type": "object",
      "required": ["signalId", "group", "evidenceRefs"],
      "properties": {
        "signalId": { "type": "string", "maxLength": 120 },
        "group": { "type": "string", "maxLength": 100 },
        "meaning": { "type": "string", "maxLength": 240 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" }, "maxItems": 100 }
      },
      "additionalProperties": true
    },
    "decisionItem": {
      "type": "object",
      "required": ["id", "itemFingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "itemFingerprint": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidenceRefs": { "type": "array", "maxItems": 100 },
        "validationLevel": { "type": "string", "enum": ["evidence-grounded", "structurally-valid", "structurally-invalid", "syntax-checked", "syntax-unchecked", "dialect-checked", "dialect-unchecked", "human-reviewed", "human-unreviewed", "structural", "warning", "blocking", "unknown"] }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": ["itemType", "itemId", "itemFingerprint", "decision"],
      "properties": {
        "itemType": { "type": "string", "maxLength": 80 },
        "itemId": { "type": "string", "maxLength": 128 },
        "itemFingerprint": { "type": "string", "maxLength": 128 },
        "decision": { "type": "string", "enum": ["accepted", "rejected", "undecided"] },
        "note": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": true
    }
  }
}
