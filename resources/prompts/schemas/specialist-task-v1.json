{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specialist-task-v1",
  "type": "object",
  "required": ["task", "evidence"],
  "properties": {
    "task": {
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "role": { "type": "string" },
        "objective": { "type": "string" },
        "brief": { "type": "string" },
        "budget": { "type": "object" },
        "context": { "type": "object" }
      }
    },
    "evidence": { "type": "object" },
    "reference": { "type": "array" }
  },
  "additionalProperties": true
}
