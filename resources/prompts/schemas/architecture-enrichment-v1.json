{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-enrichment-v1",
  "type": "object",
  "required": ["statements"],
  "properties": {
    "statements": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["type", "name", "statement", "confidence", "evidenceFactIds"],
        "properties": {
          "type": { "type": "string", "enum": ["component", "boundary", "data-flow", "responsibility"] },
          "name": { "type": "string" },
          "statement": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidenceFactIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": false
}
