{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modernization-architecture-v2",
  "type": "object",
  "properties": {
    "placements": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["domainKey", "placementType", "targetUnitIds", "rationale"],
        "properties": {
          "id": { "type": "string", "maxLength": 120 },
          "domainKey": { "type": "string", "maxLength": 120 },
          "name": { "type": "string", "maxLength": 120 },
          "placementType": { "enum": ["main-app", "coldbox-module", "external-service"] },
          "targetUnitIds": { "type": "array", "maxItems": 40, "items": { "type": "string" } },
          "rationale": { "type": "string", "maxLength": 500 },
          "evidenceRefs": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
          "uncertainty": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 180 } },
          "questions": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 180 } }
        },
        "additionalProperties": true
      }
    },
    "contexts": { "type": "array", "maxItems": 30 },
    "extracts": { "type": "array", "maxItems": 30 }
  },
  "anyOf": [
    { "required": ["placements"] },
    { "required": ["contexts"] },
    { "required": ["extracts"] }
  ],
  "additionalProperties": true
}
