{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modernization-roadmap-v1",
  "type": "object",
  "required": ["roadmapPhases"],
  "properties": {
    "roadmapPhases": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "maxLength": 120 },
          "name": { "type": "string", "maxLength": 200 },
          "goal": { "type": "string", "maxLength": 500 },
          "pattern": { "type": "string", "maxLength": 120 },
          "classification": {
            "enum": [
              "remain-monolith",
              "refactor-monolith",
              "coldbox-module",
              "background-worker",
              "scheduled-service",
              "microservice",
              "external-service",
              "shared-library",
              "retire",
              "investigate"
            ]
          },
          "wave": { "type": "integer", "minimum": 1, "maximum": 20 },
          "dependencies": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
          "unitIds": { "type": "array", "maxItems": 200, "items": { "type": "string" } },
          "componentIds": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
          "routeIds": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
          "dbFindingIds": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
          "transitionIds": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
          "risks": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 240 } },
          "rollbackStrategy": { "type": "string", "maxLength": 400 },
          "testingStrategy": { "type": "string", "maxLength": 400 },
          "estimatedComplexity": { "enum": ["low", "medium", "high", "unknown"] },
          "parityIntent": { "type": "string", "maxLength": 400 },
          "exitCriteria": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
          "rollback": { "type": "string", "maxLength": 400 },
          "implementerPrompt": { "type": "string", "maxLength": 500 },
          "migrationSteps": { "type": "array", "maxItems": 12 },
          "sampleIds": { "type": "array", "maxItems": 40, "items": { "type": "string" } },
          "currentSlice": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "samples": { "type": "array", "maxItems": 100 },
    "assumptions": { "type": "array", "maxItems": 100 },
    "executiveSummary": { "type": "string", "maxLength": 2000 },
    "unresolvedQuestions": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 240 } }
  },
  "additionalProperties": true
}
