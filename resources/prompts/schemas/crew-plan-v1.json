{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crew-plan-v1",
  "type": "object",
  "required": ["summary", "tasks"],
  "properties": {
    "summary": { "type": "string" },
    "tasks": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["role", "priority", "objective", "brief"],
        "properties": { "role": { "type": "string" }, "priority": { "type": "integer" }, "objective": { "type": "string" }, "brief": { "type": "string" }, "emphasizeFiles": { "type": "array", "items": { "type": "string" } } }
      }
    }
  },
  "additionalProperties": false
}
