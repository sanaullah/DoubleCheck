{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specialist-findings-v1",
  "type": "object",
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string", "maxLength": 1200 },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["category", "ruleId", "severity", "confidence", "title", "message", "filePath", "startLine", "endLine"],
        "properties": {
          "category": { "type": "string", "enum": ["security", "correctness", "reliability", "performance", "maintainability", "testing", "architecture"] },
          "ruleId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "filePath": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "startLine": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "suggestion": { "type": "string", "maxLength": 4000 },
          "fixPatch": {
            "type": "object",
            "required": ["before", "after", "confidence"],
            "properties": { "before": { "type": "string", "minLength": 1 }, "after": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
