{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modernization-judge-v1",
  "type": "object",
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["clusterId", "defensible", "confidence", "rationale"],
        "properties": {
          "clusterId": { "type": "string" },
          "defensible": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string", "maxLength": 600 },
          "breaksOnExtraction": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 200 } },
          "worthIt": { "type": "string", "enum": ["yes", "no", "unclear"] },
          "worthRationale": { "type": "string", "maxLength": 400 },
          "openQuestion": { "type": "string", "maxLength": 300 },
          "evidenceRefs": { "type": "array", "maxItems": 8 }
        },
        "additionalProperties": true
      }
    },
    "assumptions": { "type": "array", "maxItems": 6 }
  },
  "additionalProperties": true
}
