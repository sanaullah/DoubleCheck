{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codegraph-narrative-input-v2",
  "type": "object",
  "required": ["task", "evidence"],
  "properties": {
    "task": {
      "type": "object",
      "properties": {
        "clusterCount": { "type": "integer" },
        "hotspotCount": { "type": "integer" },
        "flowCount": { "type": "integer" },
        "cycleCount": { "type": "integer" },
        "fingerprint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "clusters": { "type": "array" },
        "hotspots": { "type": "array" },
        "flows": { "type": "array" },
        "cycles": { "type": "array" },
        "roleCounts": { "type": "object" }
      },
      "additionalProperties": true
    },
    "reference": { "type": "array" }
  },
  "additionalProperties": true
}
