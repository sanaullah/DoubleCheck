{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modernization-brief-v1",
  "type": "object",
  "required": ["verdict", "claims"],
  "properties": {
    "verdict": { "type": "string", "maxLength": 900 },
    "claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["claim", "evidenceRefs"],
        "properties": {
          "claim": { "type": "string", "maxLength": 300 },
          "targetItemId": { "type": "string" },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["filePath"],
              "properties": {
                "filePath": { "type": "string" },
                "startLine": { "type": "integer", "minimum": 1 },
                "endLine": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "startHere": { "type": "string", "maxLength": 300 },
    "assumptions": { "type": "array", "maxItems": 4 }
  },
  "additionalProperties": true
}
