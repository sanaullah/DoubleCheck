{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modernization-narrate-v1",
  "type": "object",
  "required": ["narrations"],
  "properties": {
    "narrations": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["clusterId", "name", "purpose"],
        "properties": {
          "clusterId": { "type": "string" },
          "name": { "type": "string", "maxLength": 60 },
          "purpose": { "type": "string", "maxLength": 300 },
          "migrationSteps": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["order", "action"],
              "properties": {
                "order": { "type": "integer" },
                "action": { "type": "string", "maxLength": 240 },
                "legacyRef": { "type": "object" },
                "targetRef": { "type": "object" },
                "note": { "type": "string", "maxLength": 200 }
              },
              "additionalProperties": true
            }
          },
          "samples": { "type": "array", "maxItems": 1 },
          "evidenceRefs": { "type": "array", "maxItems": 8 }
        },
        "additionalProperties": true
      }
    },
    "assumptions": { "type": "array", "maxItems": 6 }
  },
  "additionalProperties": true
}
