{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codegraph-narrative-v1",
  "type": "object",
  "required": ["summaries"],
  "properties": {
    "summaries": {
      "type": "array",
      "maxItems": 44,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "clusterId": { "type": "string" },
          "nodeId": { "type": "string" },
          "title": { "type": "string", "maxLength": 120 },
          "text": { "type": "string", "maxLength": 800 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
