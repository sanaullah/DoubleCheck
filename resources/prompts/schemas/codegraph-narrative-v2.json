{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codegraph-narrative-v2",
  "type": "object",
  "required": ["pitch", "domains", "processes", "onboarding", "risk", "summaries"],
  "properties": {
    "pitch": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "maxLength": 600 }
      },
      "additionalProperties": false
    },
    "domains": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["clusterId", "title", "text"],
        "properties": {
          "clusterId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "maxLength": 120 },
          "text": { "type": "string", "maxLength": 800 }
        },
        "additionalProperties": false
      }
    },
    "processes": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["flowId", "title", "text"],
        "properties": {
          "flowId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "maxLength": 120 },
          "text": { "type": "string", "maxLength": 800 }
        },
        "additionalProperties": false
      }
    },
    "onboarding": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["step", "refType", "refId", "text"],
        "properties": {
          "step": { "type": "integer", "minimum": 1, "maximum": 5 },
          "refType": { "type": "string", "enum": ["cluster", "node", "flow"] },
          "refId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "maxLength": 400 }
        },
        "additionalProperties": false
      }
    },
    "risk": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["refType", "refId", "text"],
        "properties": {
          "refType": { "type": "string", "enum": ["hotspot", "cycle"] },
          "refId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "maxLength": 600 }
        },
        "additionalProperties": false
      }
    },
    "summaries": {
      "type": "array",
      "maxItems": 44,
      "items": {
        "type": "object",
        "required": ["clusterId", "title", "text"],
        "properties": {
          "clusterId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "maxLength": 120 },
          "text": { "type": "string", "maxLength": 800 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
