{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modernization-critic-v1",
  "type": "object",
  "required": ["critiques"],
  "properties": {
    "critiques": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["severity", "targetItemId", "claim"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocker", "high", "medium", "low", "info"] },
          "targetItemId": { "type": "string" },
          "claim": { "type": "string", "maxLength": 400 },
          "contradictingEvidence": { "type": "array", "maxItems": 6 },
          "suggestedChange": { "type": "string", "maxLength": 300 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": true
      }
    },
    "assumptions": { "type": "array", "maxItems": 6 }
  },
  "additionalProperties": true
}
