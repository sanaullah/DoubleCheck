/**
 * Denormalizes AI provider/model/token usage onto review_summaries so the
 * history list can render per-run AI badges without exporting the full trace
 * (up to 1000 events) for every row on every page view.
 */
class {
	function up( schema, query ) {
		queryExecute( "ALTER TABLE review_summaries ADD COLUMN ai_providers_json TEXT" );
		queryExecute( "ALTER TABLE review_summaries ADD COLUMN ai_models_json TEXT" );
		queryExecute( "ALTER TABLE review_summaries ADD COLUMN ai_prompt_tokens INTEGER" );
		queryExecute( "ALTER TABLE review_summaries ADD COLUMN ai_completion_tokens INTEGER" );
		queryExecute( "ALTER TABLE review_summaries ADD COLUMN ai_total_tokens INTEGER" );
		queryExecute( "ALTER TABLE review_summaries ADD COLUMN ai_retries INTEGER" );
		queryExecute( "ALTER TABLE review_summaries ADD COLUMN ai_observation_count INTEGER" );
	}

	function down( schema, query ) {
		queryExecute( "ALTER TABLE review_summaries DROP COLUMN ai_observation_count" );
		queryExecute( "ALTER TABLE review_summaries DROP COLUMN ai_retries" );
		queryExecute( "ALTER TABLE review_summaries DROP COLUMN ai_total_tokens" );
		queryExecute( "ALTER TABLE review_summaries DROP COLUMN ai_completion_tokens" );
		queryExecute( "ALTER TABLE review_summaries DROP COLUMN ai_prompt_tokens" );
		queryExecute( "ALTER TABLE review_summaries DROP COLUMN ai_models_json" );
		queryExecute( "ALTER TABLE review_summaries DROP COLUMN ai_providers_json" );
	}
}
