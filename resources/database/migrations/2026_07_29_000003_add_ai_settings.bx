/** AI provider profiles (user-managed connection/cost config) and flat app settings overrides. */
class {
	function up( schema, query ) {
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS ai_provider_profiles (
					id TEXT PRIMARY KEY,
					tenant_id TEXT NOT NULL DEFAULT 'default',
					name TEXT NOT NULL,
					provider TEXT NOT NULL,
					base_url TEXT NOT NULL,
					api_key TEXT NOT NULL DEFAULT '',
					model TEXT NOT NULL,
					timeout_seconds INTEGER NOT NULL DEFAULT 120,
					context_window INTEGER NOT NULL DEFAULT 8192,
					input_usd_per_million REAL NOT NULL DEFAULT 0,
					output_usd_per_million REAL NOT NULL DEFAULT 0,
					is_active INTEGER NOT NULL DEFAULT 0,
					created_at TEXT NOT NULL,
					updated_at TEXT NOT NULL
				)
			"
		);
		queryExecute( "CREATE INDEX IF NOT EXISTS idx_ai_provider_profiles_active ON ai_provider_profiles ( tenant_id, is_active )" );
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS app_settings (
					tenant_id TEXT NOT NULL DEFAULT 'default',
					setting_key TEXT NOT NULL,
					setting_value TEXT NOT NULL,
					updated_at TEXT NOT NULL,
					PRIMARY KEY ( tenant_id, setting_key )
				)
			"
		);
	}

	function down( schema, query ) {
		queryExecute( "DROP TABLE IF EXISTS app_settings" );
		queryExecute( "DROP INDEX IF EXISTS idx_ai_provider_profiles_active" );
		queryExecute( "DROP TABLE IF EXISTS ai_provider_profiles" );
	}
}
