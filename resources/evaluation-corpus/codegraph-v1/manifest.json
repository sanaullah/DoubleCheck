{
  "version": "codegraph-corpus-v1",
  "corpusKind": "codegraph",
  "promotesLanguageTier": false,
  "thresholds": {
    "flowRecall": 1,
    "pathRecall": 1,
    "domainStability": 1,
    "hierarchyRecall": 1
  },
  "cases": [
    {
      "id": "order-flow",
      "language": "BoxLang",
      "root": "cases/order-flow",
      "expected": {
        "domains": [
          "App Config",
          "Base",
          "Order"
        ],
        "routes": [
          "/api/v1/orders"
        ],
        "tables": [
          "orders",
          "order_items"
        ],
        "flows": [
          {
            "from": "route:/api/v1/orders",
            "to": "table:orders"
          }
        ],
        "paths": [
          {
            "from": "route:/api/v1/orders",
            "to": "table:orders",
            "requiredKinds": [
              "routes",
              "calls",
              "calls",
              "table-read"
            ]
          },
          {
            "from": "public/app.js",
            "to": "table:orders",
            "requiredKinds": [
              "calls-api",
              "routes",
              "calls",
              "calls",
              "table-read"
            ]
          }
        ],
        "hierarchy": [
          {
            "from": "app/handlers/OrderHandler.bx",
            "to": "app/handlers/BaseHandler.bx",
            "kind": "extends"
          },
          {
            "from": "app/handlers/BaseHandler.bx",
            "to": "app/handlers/IHandlerContract.bx",
            "kind": "implements"
          }
        ]
      }
    },
    {
      "id": "cfml-invoice-flow",
      "language": "CFML",
      "root": "cases/cfml-invoice-flow",
      "note": "The same chain in ColdFusion. It exists because self-analysis on a BoxLang repository cannot show that CFML produces a weaker graph, and it found exactly that: routes and renders could not fire, and table access never split into reads and writes.",
      "expected": {
        "domains": [
          "App Config",
          "Base",
          "Invoice"
        ],
        "routes": [
          "/api/v1/invoices"
        ],
        "tables": [
          "invoices",
          "invoice_lines"
        ],
        "flows": [
          {
            "from": "route:/api/v1/invoices",
            "to": "table:invoices"
          }
        ],
        "paths": [
          {
            "from": "route:/api/v1/invoices",
            "to": "table:invoices",
            "requiredKinds": [
              "routes",
              "calls",
              "calls",
              "table-read"
            ]
          },
          {
            "from": "public/app.js",
            "to": "table:invoices",
            "requiredKinds": [
              "calls-api",
              "routes",
              "calls",
              "calls",
              "table-read"
            ]
          }
        ],
        "hierarchy": [
          {
            "from": "app/handlers/InvoiceHandler.cfc",
            "to": "app/handlers/BaseHandler.cfc",
            "kind": "extends"
          },
          {
            "from": "app/handlers/BaseHandler.cfc",
            "to": "app/handlers/IHandlerContract.cfc",
            "kind": "implements"
          }
        ]
      }
    }
  ],
  "domainsNote": "Asserted by containment, not equality, and per case: the router cluster, the inheritance cluster, and the handler-service-repository chain are what each case is built to expose. Requiring the exact set made the corpus assert the clustering algorithm's current output, so adding a file failed it for a reason unrelated to the capability being measured. Stability across identical runs is covered separately by domainStability.",
  "hierarchyNote": "Both cases declare a supertype and an interface inside the case. DoubleCheck itself inherits only from framework classes, so extends and implements were correct-and-empty on the only project ever measured \u2014 which reads exactly like a relationship that does not work."
}
