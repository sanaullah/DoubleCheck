{
  "version": "codegraph-corpus-v1",
  "corpusKind": "codegraph",
  "promotesLanguageTier": false,
  "thresholds": {
    "flowRecall": 1,
    "pathRecall": 1,
    "domainStability": 1
  },
  "cases": [
    {
      "id": "order-flow",
      "language": "BoxLang",
      "root": "cases/order-flow",
      "expected": {
        "domains": [
          "App Config",
          "App Handlers",
          "Resources"
        ],
        "routes": [
          "/api/v1/orders"
        ],
        "tables": [
          "orders",
          "order_items"
        ],
        "flows": [
          {
            "from": "route:/api/v1/orders",
            "to": "table:orders"
          }
        ],
        "paths": [
          {
            "from": "route:/api/v1/orders",
            "to": "table:orders",
            "requiredKinds": [
              "routes",
              "calls",
              "calls",
              "table-read"
            ]
          },
          {
            "from": "public/app.js",
            "to": "table:orders",
            "requiredKinds": [
              "calls-api",
              "routes",
              "calls",
              "calls",
              "table-read"
            ]
          }
        ]
      }
    },
    {
      "id": "cfml-invoice-flow",
      "language": "CFML",
      "root": "cases/cfml-invoice-flow",
      "note": "The same chain in ColdFusion. It exists because self-analysis on a BoxLang repository cannot show that CFML produces a weaker graph, and it found exactly that: routes and renders could not fire, and table access never split into reads and writes.",
      "expected": {
        "domains": [
          "App Config",
          "App Handlers",
          "Resources"
        ],
        "routes": [
          "/api/v1/invoices"
        ],
        "tables": [
          "invoices",
          "invoice_lines"
        ],
        "flows": [
          {
            "from": "route:/api/v1/invoices",
            "to": "table:invoices"
          }
        ],
        "paths": [
          {
            "from": "route:/api/v1/invoices",
            "to": "table:invoices",
            "requiredKinds": [
              "routes",
              "calls",
              "calls",
              "table-read"
            ]
          },
          {
            "from": "public/app.js",
            "to": "table:invoices",
            "requiredKinds": [
              "calls-api",
              "routes",
              "calls",
              "calls",
              "table-read"
            ]
          }
        ]
      }
    }
  ],
  "domainsNote": "Handler, service and repository cluster together because the call chain binds them; the view stands alone because only a renders edge reaches it. The earlier expectation split repositories into their own domain, which held only while intra-file calls went unresolved and the chain was weaker."
}
