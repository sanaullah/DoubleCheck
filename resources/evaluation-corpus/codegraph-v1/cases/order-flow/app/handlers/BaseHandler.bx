/**
 * In-repository supertype for the corpus handlers.
 *
 * Exists so `extends` has a target inside the case. Every class in DoubleCheck
 * itself inherits only from framework types, so the hierarchy relationship was
 * correct-and-empty on the only project it had ever been measured against —
 * which is indistinguishable from a hierarchy that does not work.
 */
class BaseHandler implements="IHandlerContract" {

    function respond( required any payload ) {
        return { data: arguments.payload };
    }

}
