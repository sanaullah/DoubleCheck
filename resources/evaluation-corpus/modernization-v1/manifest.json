{
    "version": "modernization-corpus-v1",
    "language": "CFML",
    "capabilityTier": "derived-structure",
    "corpusKind": "modernize",
    "promotesLanguageTier": false,
    "thresholds": {
        "minSeamPrecision": 1.0,
        "minDagValidity": 1.0,
        "minCoverageOfSignals": 1.0,
        "maxFalseExtractions": 0
    },
    "cases": [
        {
            "id": "false-seam",
            "intent": "Two folders that look separable share four tables, session state and application state. Folder-shaped clustering extracts reporting; coupling-shaped clustering must refuse. This is the decisive case: it is the only one that fails when clustering is folder-shaped.",
            "files": [
                { "source": "cases/false-seam/Application.cfc", "filePath": "app/Application.cfc", "language": "CFML" },
                { "source": "cases/false-seam/ReportingService.cfc", "filePath": "app/reporting/ReportingService.cfc", "language": "CFML" },
                { "source": "cases/false-seam/BillingService.cfc", "filePath": "app/billing/BillingService.cfc", "language": "CFML" },
                { "source": "cases/false-seam/nightly-close.cfm", "filePath": "app/reporting/nightly-close.cfm", "language": "CFML" }
            ],
            "expected": [
                { "kind": "co-access-shared", "a": "app/reporting/ReportingService.cfc", "b": "app/billing/BillingService.cfc", "minSharedResources": 4 },
                { "kind": "shared-state-shared", "a": "app/reporting/ReportingService.cfc", "b": "app/billing/BillingService.cfc", "scopes": [ "scope.application", "scope.session" ] },
                { "kind": "same-cluster", "a": "reporting", "b": "billing" },
                { "kind": "placement-not", "domain": "reporting", "type": "external-service" },
                { "kind": "gate-recommends", "domain": "reporting", "recommendation": "stay" }
            ],
            "fakeResponse": { "summary": "Deterministic tier: no model response is used.", "findings": [] }
        },
        {
            "id": "separable-domain",
            "intent": "A genuinely extractable domain: own datasource, own tables, one external provider, no shared scope. The true positive that stops the corpus rewarding a service which refuses everything.",
            "files": [
                { "source": "cases/separable-domain/NotificationService.cfc", "filePath": "app/notifications/NotificationService.cfc", "language": "CFML" },
                { "source": "cases/separable-domain/NotificationQueue.cfc", "filePath": "app/notifications/NotificationQueue.cfc", "language": "CFML" },
                { "source": "cases/separable-domain/OrderService.cfc", "filePath": "app/orders/OrderService.cfc", "language": "CFML" }
            ],
            "expected": [
                { "kind": "co-access-disjoint", "a": "app/notifications/NotificationService.cfc", "b": "app/orders/OrderService.cfc" },
                { "kind": "not-same-cluster", "a": "notifications", "b": "orders" },
                { "kind": "placement-is", "domain": "notifications", "type": "external-service" },
                { "kind": "gate-recommends", "domain": "notifications", "recommendation": "extract" }
            ],
            "fakeResponse": { "summary": "Deterministic tier: no model response is used.", "findings": [] }
        },
        {
            "id": "below-inference-threshold",
            "intent": "Four units, far below minUnitsForFolderInference (24). Folder inference collapses everything into ctx-modular-monolith-default; the graph must still find two disjoint domains. Targets 2.3 directly.",
            "files": [
                { "source": "cases/below-inference-threshold/CatalogService.cfc", "filePath": "app/CatalogService.cfc", "language": "CFML" },
                { "source": "cases/below-inference-threshold/PricingRules.cfc", "filePath": "app/PricingRules.cfc", "language": "CFML" },
                { "source": "cases/below-inference-threshold/ShippingService.cfc", "filePath": "app/ShippingService.cfc", "language": "CFML" },
                { "source": "cases/below-inference-threshold/CarrierGateway.cfc", "filePath": "app/CarrierGateway.cfc", "language": "CFML" }
            ],
            "expected": [
                { "kind": "co-access-disjoint", "a": "app/CatalogService.cfc", "b": "app/ShippingService.cfc" },
                { "kind": "cluster-count-at-least", "count": 2 },
                { "kind": "not-same-cluster", "a": "catalog", "b": "shipping" }
            ],
            "fakeResponse": { "summary": "Deterministic tier: no model response is used.", "findings": [] }
        },
        {
            "id": "cyclic-boundary",
            "intent": "OrderService and InvoiceService construct each other. The cycle must be reported and extraction of either half blocked until it is broken. Proves the graph is genuinely consulted rather than decorated with.",
            "files": [
                { "source": "cases/cyclic-boundary/OrderService.cfc", "filePath": "app/orders/OrderService.cfc", "language": "CFML" },
                { "source": "cases/cyclic-boundary/InvoiceService.cfc", "filePath": "app/invoicing/InvoiceService.cfc", "language": "CFML" },
                { "source": "cases/cyclic-boundary/dispatch.cfm", "filePath": "app/dispatch.cfm", "language": "CFML" }
            ],
            "expected": [
                { "kind": "cycle-reported", "between": [ "app/orders/OrderService.cfc", "app/invoicing/InvoiceService.cfc" ] },
                { "kind": "placement-not", "domain": "orders", "type": "external-service" },
                { "kind": "gate-recommends", "domain": "orders", "recommendation": "stay" }
            ],
            "fakeResponse": { "summary": "Deterministic tier: no model response is used.", "findings": [] }
        }
    ]
}
