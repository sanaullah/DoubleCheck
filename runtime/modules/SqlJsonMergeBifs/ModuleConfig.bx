/**
 * Native BoxLang module descriptor whose sole purpose is registering the
 * SqlJsonMerge BIFs (jsonMerge, jsonInsert, dbInfo, tableInfo, generateGUID, dbDateTime)
 * as global functions with the BoxLang runtime.
 *
 * This is intentionally a separate, minimal native BoxLang module rather than being
 * folded into app/modules/SqlJsonMerge: BoxLang's native ModuleService and ColdBox's
 * module service both look for a file named ModuleConfig.bx, but expect different
 * descriptor shapes (native modules inject moduleRecord/boxRuntime/functionService/etc,
 * while ColdBox modules use this.autoMapModels, this.viewParentLookup, etc). A single
 * ModuleConfig.bx cannot satisfy both loaders. All actual logic (dialects, SQL
 * generation, JSON cleaning) still lives in the ColdBox module at
 * app/modules/SqlJsonMerge - these BIFs are thin delegates that resolve that module's
 * JsonMerge/DatabaseDialectFactory services via WireBox at call time.
 */
class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="functionService";
	property name="log";

	this.version = "1.0.0";
	this.mapping = "SqlJsonMergeBifs";
	this.author = "DoubleCheck";
	this.description = "Registers global BIFs for the SqlJsonMerge multi-database JSON merge/insert module.";
	this.enabled = true;

	function configure() {
	}

	function onLoad() {
	}

	function onUnload() {
	}

}
