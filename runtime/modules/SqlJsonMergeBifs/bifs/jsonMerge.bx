/**
 * Global BIF for UPSERT (INSERT/UPDATE) operations using JSON data, delegating to
 * the SqlJsonMerge ColdBox module's JsonMerge service.
 */
@BoxBIF
class {

	/**
	 * @data Array of records to merge (required)
	 * @tableName Name of the target table (required)
	 * @targets Array of key column names for matching (required)
	 * @updateFields Array of columns to update on match (default: all writeable columns)
	 * @datasource Optional datasource name (default: app's configured datasource)
	 * @sessionContext Optional struct of session context variables (SQL Server only)
	 * @return Struct with result, timing, and execution details
	 */
	function invoke(
		required array data,
		required string tableName,
		required array targets,
		array updateFields = [],
		string datasource = "",
		struct sessionContext = {}
	) {
		var jsonMergeService = application.cbController.getWireBox().getInstance("JsonMerge@SqlJsonMerge");
		return jsonMergeService.jsonMerge(
			data = arguments.data,
			tableName = arguments.tableName,
			targets = arguments.targets,
			update = arguments.updateFields,
			datasource = arguments.datasource,
			sessionContext = arguments.sessionContext
		);
	}

}
