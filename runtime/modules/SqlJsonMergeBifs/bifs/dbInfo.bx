/**
 * Global BIF for database metadata introspection, delegating to the SqlJsonMerge
 * ColdBox module's JsonMerge service.
 */
@BoxBIF
class {

	/**
	 * @type Type of info to retrieve: "tables" or "columns" (required)
	 * @table Table name (optional for tables, required for columns)
	 * @dbname Database name (required for tables)
	 * @datasource Optional datasource name (default: app's configured datasource)
	 * @return Query object with database information
	 */
	function invoke(
		required string type,
		string table = "",
		string dbname = "",
		string datasource = ""
	) {
		var jsonMergeService = application.cbController.getWireBox().getInstance("JsonMerge@SqlJsonMerge");
		return jsonMergeService.dbInfo(
			type = arguments.type,
			table = arguments.table,
			dbname = arguments.dbname,
			datasource = arguments.datasource
		);
	}

}
