/**
 * Global BIF for comprehensive table structure information, delegating to the
 * SqlJsonMerge ColdBox module's JsonMerge service.
 */
@BoxBIF
class {

	/**
	 * @tableName Name of the table (required)
	 * @datasource Optional datasource name (default: app's configured datasource)
	 * @return Struct with column metadata and helper collections
	 */
	function invoke(
		required string tableName,
		string datasource = ""
	) {
		var jsonMergeService = application.cbController.getWireBox().getInstance("JsonMerge@SqlJsonMerge");
		var columns = jsonMergeService.columnData(arguments.tableName, arguments.datasource);

		return {
			table: jsonMergeService.parseTableName(arguments.tableName, arguments.datasource),
			columns: columns.keyArray(),
			writeableColumns: columns.filter((k, c) => c.bWriteable).keyArray(),
			columnMap: columns,
			metadata: columns
		};
	}

}
