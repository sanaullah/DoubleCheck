/**
 * Global BIF for database current datetime retrieval, delegating to the
 * SqlJsonMerge ColdBox module's DatabaseDialectFactory.
 */
@BoxBIF
class {

	/**
	 * @datasource Optional datasource name (default: app's configured datasource)
	 * @utc Optional boolean - return UTC datetime if true (default: false)
	 * @return Date - current datetime from the database
	 */
	function invoke(string datasource = "", boolean utc = false) {
		var dialectFactory = application.cbController.getWireBox().getInstance("DatabaseDialectFactory@SqlJsonMerge");
		var dialect = dialectFactory.getDialect(arguments.datasource.len() ? arguments.datasource : "doublecheck");
		var datetimeSQL = arguments.utc ? dialect.getDatabaseUTCDateTime() : dialect.getDatabaseDateTime();
		var result = queryExecute(datetimeSQL, [], {});

		if (!result.recordCount) {
			return now();
		}

		return arguments.utc ? result.UTCDateTime : result.dateTime;
	}

}
