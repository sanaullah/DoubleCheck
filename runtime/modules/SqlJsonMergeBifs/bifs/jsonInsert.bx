/**
 * Global BIF for bulk INSERT operations using JSON data, delegating to the
 * SqlJsonMerge ColdBox module's JsonMerge service.
 */
@BoxBIF
class {

	/**
	 * @data Array of records to insert (required)
	 * @tableName Name of the target table (required)
	 * @datasource Optional datasource name (default: app's configured datasource)
	 * @return Struct with result and execution timing
	 */
	function invoke(
		required array data,
		required string tableName,
		string datasource = ""
	) {
		var jsonMergeService = application.cbController.getWireBox().getInstance("JsonMerge@SqlJsonMerge");
		return jsonMergeService.jsonInsert(
			data = arguments.data,
			tableName = arguments.tableName,
			datasource = arguments.datasource
		);
	}

}
