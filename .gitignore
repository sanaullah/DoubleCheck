# =============================================================================
# DoubleCheck .gitignore
# =============================================================================

# --- OS / editor clutter -----------------------------------------------------
.DS_Store
settings.xml

# --- Secrets & environment ---------------------------------------------------
.env

# --- Local runtime / temp ----------------------------------------------------
.tmp/**
.engine/**
.cbfs/**
WEB-INF
runtime/logs/**
runtime/boxlang_modules/**
runtime/classes/**

# --- Database & local app data -----------------------------------------------
# SQLite state (encrypted secrets + review data)
.db/**
!.db/.gitkeep
# Non-database app data
data/backups/
docker/.db/**
.devcontainer/.db/**

# --- Build & package artifacts -----------------------------------------------
build/**
/public/includes/build/**
effective-pom.xml

# --- Logs & test output ------------------------------------------------------
app/logs/**
tests/results/**

# --- npm ---------------------------------------------------------------------
**/node_modules/*
npm-debug.log
yarn-error.log

# --- Framework / CommandBox lib (keep placeholders only) ---------------------
lib/**
!lib/java/
!lib/java/.gitkeep
!lib/modules/
!lib/modules/.gitkeep

# --- Project-local (not published) -------------------------------------------
.docs/
