# =============================================================================
# DoubleCheck .gitignore
# =============================================================================

# --- OS / editor clutter -----------------------------------------------------
.DS_Store
settings.xml

# --- Secrets & environment ---------------------------------------------------
.env

# --- Local runtime / temp ----------------------------------------------------
.tmp/**
.engine/**
!.engine/boxlang-miniserver*.jar
.cbfs/**
WEB-INF
runtime/logs/**
runtime/boxlang_modules/**
runtime/classes/**

# --- Database & local app data -----------------------------------------------
# SQLite state (encrypted secrets + review data)
.db/**
!.db/.gitkeep
# Databases moved aside rather than deleted (see the modernize plan, Step 0.1)
.db.bak/
.db.bak*/
# Raw LLM-baseline capture (~1MB of provider output). The reduced, committed
# artifact is baseline-llm-path.json; this is the audit trail behind it.
resources/evaluation-corpus/*/baseline-raw.json
# Non-database app data
data/backups/
docker/.db/**
.devcontainer/.db/**

# --- Build & package artifacts -----------------------------------------------
build/**
/public/includes/build/**
effective-pom.xml

# --- Logs & test output ------------------------------------------------------
app/logs/**
tests/results/**

# --- npm ---------------------------------------------------------------------
**/node_modules/*
npm-debug.log
yarn-error.log

# --- Framework / CommandBox lib (keep placeholders only) ---------------------
lib/**
!lib/java/
!lib/java/.gitkeep
!lib/modules/
!lib/modules/.gitkeep

# --- Project-local (not published) -------------------------------------------
.superpowers/**
.tmp_*

# resources/docs/ is the single documentation source of truth and IS published.
# It was previously ignored wholesale, which left readme.md with a broken link to
# application-features.md on every clone. Do not re-add it here, and do not
# recreate .docs/ or .superpowers/ — one documentation tree, committed.