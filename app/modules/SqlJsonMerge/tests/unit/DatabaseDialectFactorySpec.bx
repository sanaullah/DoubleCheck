/**
 * Unit tests for DatabaseDialectFactory
 * Tests dialect detection and instantiation
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.factory = new app.modules.SqlJsonMerge.models.DatabaseDialectFactory();
	}

	function run() {
		describe("DatabaseDialectFactory", () => {
			it("should instantiate SQLiteDialect by default", () => {
				var dialect = variables.factory.getDialect("doublecheck");
				expect(dialect).toBeInstanceOf("app.modules.SqlJsonMerge.models.SQLiteDialect");
			});

			it("should cache dialect instances", () => {
				var dialect1 = variables.factory.getDialect("test");
				var dialect2 = variables.factory.getDialect("test");
				expect(dialect1).toBe(dialect2);
			});

			it("should clear cache when requested", () => {
				var dialect1 = variables.factory.getDialect("test");
				variables.factory.clearCache();
				// After clearing, a new instance should be created
				var dialect2 = variables.factory.getDialect("test");
				expect(dialect1 == dialect2).toBeFalse();
			});

			it("should generate GUID SQL for SQLite", () => {
				var dialect = variables.factory.getDialect("doublecheck");
				var guidSQL = dialect.generateGUID();
				expect(guidSQL).toContain("randomblob");
				expect(guidSQL).toContain("hex");
			});

			it("should generate datetime SQL for SQLite", () => {
				var dialect = variables.factory.getDialect("doublecheck");
				var dtSQL = dialect.getDatabaseDateTime();
				expect(dtSQL).toContain("datetime");
				expect(dtSQL).toContain("now");
			});

			it("should generate UTC datetime SQL for SQLite", () => {
				var dialect = variables.factory.getDialect("doublecheck");
				var utcSQL = dialect.getDatabaseUTCDateTime();
				expect(utcSQL).toContain("datetime");
				expect(utcSQL).toContain("utc");
			});

			it("should return temp table pattern for SQLite", () => {
				var dialect = variables.factory.getDialect("doublecheck");
				var pattern = dialect.getTempTableNamePattern();
				expect(pattern).toBe("TEMPORARY TABLE");
			});

			it("should parse simple table name correctly", () => {
				var dialect = variables.factory.getDialect("doublecheck");
				var parsed = dialect.parseTableNameComponents("users");
				expect(parsed.table).toBe("users");
				expect(parsed.schema).toBe("main");
				expect(parsed.database).toBe("");
			});

			it("should parse schema.table format correctly", () => {
				var dialect = variables.factory.getDialect("doublecheck");
				var parsed = dialect.parseTableNameComponents("public.users");
				expect(parsed.table).toBe("users");
				expect(parsed.schema).toBe("public");
			});
		});
	}

}
