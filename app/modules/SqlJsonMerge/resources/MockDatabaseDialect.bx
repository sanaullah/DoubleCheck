/**
 * Mock database dialect for unit testing.
 * Returns predictable SQL strings for verification without actual database calls.
 */
class extends="app.modules.SqlJsonMerge.models.DatabaseDialect" {

	string function generateGUID() {
		return "SELECT 'mock-guid-' || random() AS guid";
	}

	string function getDatabaseDateTime() {
		return "SELECT datetime('now') AS dateTime";
	}

	string function getDatabaseUTCDateTime() {
		return "SELECT datetime('now', 'utc') AS UTCDateTime";
	}

	string function getJsonInsertSQL(
		required array data,
		required string tableName,
		required struct columns,
		required string jsonData,
		struct sessionContext = {}
	) {
		return "INSERT INTO #tableName# (mock columns) VALUES (mock values)";
	}

	string function getJsonMergeSQL(
		required array data,
		required string tableName,
		required array targets,
		required array updateFields,
		required struct columns,
		required string jsonData,
		struct sessionContext = {}
	) {
		return "MERGE INTO #tableName# USING (mock source) ON (mock condition) WHEN MATCHED THEN UPDATE SET (mock) WHEN NOT MATCHED THEN INSERT (mock)";
	}

	string function getColumnMetadataQuery(
		required string tableName,
		required struct parseResult
	) {
		return "SELECT * FROM mock_columns WHERE table_name = '#tableName#'";
	}

	string function getTableListQuery(required string dbname) {
		return "SELECT * FROM mock_tables WHERE database_name = '#dbname#'";
	}

	string function getTempTableCheckQuery(required string tempTableName) {
		return "SELECT 1 FROM mock_tables WHERE name = '#tempTableName#'";
	}

	string function getTempTableCreateSQL(
		required string tableName,
		required array columns
	) {
		return "CREATE TEMPORARY TABLE #tableName# (mock_column mock_type)";
	}

	string function getTempTableNamePattern() {
		return "MOCK_TEMP";
	}

	struct function parseTableNameComponents(required string fullTableName) {
		return {
			name: fullTableName,
			tempName: "mock_temp_table",
			database: "mock_db",
			schema: "mock_schema",
			table: fullTableName,
			_name: "mock_name"
		};
	}

}
