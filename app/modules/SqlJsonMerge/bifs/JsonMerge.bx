/**
 * Global BoxLang BIF for UPSERT (INSERT/UPDATE) operations using JSON data.
 * Automatically available without imports due to module BIF auto-discovery.
 *
 * @param data Array of records to merge (required)
 * @param tableName Name of the target table (required)
 * @param targets Array of key column names for matching (required)
 * @param updateFields Array of columns to update on match (default: all writeable columns)
 * @param datasource Optional datasource name (default: current context's datasource)
 * @param sessionContext Optional struct of session context variables (SQL Server only)
 * @return Struct with result, timing, and execution details
 */
function invoke(
	required array data,
	required string tableName,
	required array targets,
	array updateFields = [],
	string datasource = "",
	struct sessionContext = {}
) {
	var jsonMergeService = new SqlJsonMerge.models.JsonMerge();
	return jsonMergeService.jsonMerge(
		data = data,
		tableName = tableName,
		targets = targets,
		update = updateFields,
		datasource = datasource,
		sessionContext = sessionContext
	);
}
