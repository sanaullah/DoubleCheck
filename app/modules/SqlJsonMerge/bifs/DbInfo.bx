/**
 * Global BoxLang BIF for database metadata introspection.
 * Automatically available without imports due to module BIF auto-discovery.
 *
 * @param type Type of info to retrieve: "tables" or "columns" (required)
 * @param table Table name (optional for tables, required for columns)
 * @param dbname Database name (required for tables)
 * @param datasource Optional datasource name (default: current context's datasource)
 * @return Query object with database information
 */
function invoke(
	required string type,
	string table = "",
	string dbname = "",
	string datasource = ""
) {
	var jsonMergeService = new SqlJsonMerge.models.JsonMerge();
	return jsonMergeService.dbInfo(
		type = type,
		table = table,
		dbname = dbname,
		datasource = datasource
	);
}
