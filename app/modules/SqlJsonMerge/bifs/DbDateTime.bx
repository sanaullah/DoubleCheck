/**
 * Global BoxLang BIF for database current datetime retrieval.
 * Uses the appropriate database function for the configured datasource.
 * Automatically available without imports due to module BIF auto-discovery.
 *
 * @param datasource Optional datasource name (default: current context's datasource)
 * @param utc Optional boolean - return UTC datetime if true (default: false)
 * @return Date - current datetime from the database
 */
function invoke(string datasource = "", boolean utc = false) {
	var dialectFactory = new SqlJsonMerge.models.DatabaseDialectFactory();
	var dialect = dialectFactory.getDialect(datasource.len() ? datasource : "doublecheck");
	var datetimeSQL = utc ? dialect.getDatabaseUTCDateTime() : dialect.getDatabaseDateTime();
	var result = queryExecute(datetimeSQL, [], {});

	// Extract the datetime value from the result
	return result.recordCount ? result[1][result.columnList[1]] : now();
}
