/**
 * Global BoxLang BIF for bulk INSERT operations using JSON data.
 * Automatically available without imports due to module BIF auto-discovery.
 *
 * @param data Array of records to insert (required)
 * @param tableName Name of the target table (required)
 * @param datasource Optional datasource name (default: current context's datasource)
 * @return Struct with result and execution timing
 */
function invoke(
	required array data,
	required string tableName,
	string datasource = ""
) {
	var jsonMergeService = new SqlJsonMerge.models.JsonMerge();
	return jsonMergeService.jsonInsert(
		data = data,
		tableName = tableName,
		datasource = datasource
	);
}
