/**
 * Global BoxLang BIF for comprehensive table structure information.
 * Automatically available without imports due to module BIF auto-discovery.
 *
 * @param tableName Name of the table (required)
 * @param datasource Optional datasource name (default: current context's datasource)
 * @return Struct with column metadata, DDL statements, and helper methods
 */
function invoke(
	required string tableName,
	string datasource = ""
) {
	var jsonMergeService = new SqlJsonMerge.models.JsonMerge();
	var columns = jsonMergeService.columnData(tableName, datasource);

	return {
		table: jsonMergeService.parseTableName(tableName),
		columns: columns.keyArray(),
		writeableColumns: columns
			.filter((k, c) => c.bWriteable)
			.keyArray(),
		columnMap: columns,
		metadata: columns
	};
}
