/**
 * Global BIF for database-agnostic GUID generation, delegating to the SqlJsonMerge
 * ColdBox module's DatabaseDialectFactory.
 */
@BoxBIF
class {

	/**
	 * @datasource Optional datasource name (default: app's configured datasource)
	 * @return String - generated GUID unique to the database system
	 */
	function invoke(string datasource = "") {
		var dialectFactory = application.cbController.getWireBox().getInstance("DatabaseDialectFactory@SqlJsonMerge");
		var dialect = dialectFactory.getDialect(arguments.datasource.len() ? arguments.datasource : "doublecheck");
		var result = queryExecute(dialect.generateGUID(), [], {});

		// Every dialect's generateGUID() SQL aliases its result column as "guid".
		return result.recordCount ? result.guid : "";
	}

}
