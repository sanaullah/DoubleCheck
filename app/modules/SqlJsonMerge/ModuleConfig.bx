/**
 * SqlJsonMerge Module Configuration
 * Configures the multi-database SQL/JSON merge module for ColdBox
 */
component {

	this.title = "SqlJsonMerge";
	this.author = "DoubleCheck";
	this.description = "Multi-database SQL generation and JSON merge/insert operations";
	this.version = "1.0.0";
	this.viewParentLookup = true;
	this.layoutParentLookup = true;
	this.parseParentLookup = true;
	this.autoMapModels = true;

	/**
	 * Configure the module
	 */
	function configure() {
		// Module settings
		var settings = {
			// Default datasource if none specified
			defaultDatasource: "doublecheck"
		};

		controller.getWireBox().registerInstance(
			name: "SqlJsonMergeSettings",
			instancePath: settings
		);
	}

	/**
	 * Fired when the module is activated
	 */
	function onLoad() {
		controller.getWireBox().wireInstance(new this.models.DatabaseDialectFactory());
	}

	/**
	 * Fired when the module is deactivated
	 */
	function onUnload() {
		// Cleanup if needed
	}

}
