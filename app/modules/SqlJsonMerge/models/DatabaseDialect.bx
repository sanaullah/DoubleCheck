/**
 * Abstract base class for database-specific SQL generation and operations.
 * Each concrete implementation handles the nuances of a specific database system
 * (SQL Server, PostgreSQL, MySQL, Oracle, SQLite).
 */
component abstract accessors=true {

	/**
	 * Returns the SQL function to generate a database-specific GUID/UUID.
	 * Must be executable with queryExecute() to retrieve a generated ID.
	 * Example: NEWID() for SQL Server, gen_random_uuid() for PostgreSQL
	 *
	 * @return The SQL function call that generates a GUID
	 */
	abstract string function generateGUID();

	/**
	 * Returns the SQL function to get the current database datetime in the database's timezone.
	 * Must be executable with queryExecute() to retrieve the current datetime.
	 * Example: GETDATE() for SQL Server, NOW() for PostgreSQL
	 *
	 * @return The SQL function call that returns current datetime
	 */
	abstract string function getDatabaseDateTime();

	/**
	 * Returns the SQL function to get the current database datetime in UTC.
	 * Must be executable with queryExecute() to retrieve the current UTC datetime.
	 * Example: GETUTCDATE() for SQL Server, NOW() AT TIME ZONE 'UTC' for PostgreSQL
	 *
	 * @return The SQL function call that returns current UTC datetime
	 */
	abstract string function getDatabaseUTCDateTime();

	/**
	 * Generates database-specific SQL for inserting JSON data into a table.
	 * This is the complex operation that differs significantly across databases.
	 *
	 * @param data Array of structs to insert
	 * @param tableName Target table name
	 * @param columns Struct of column metadata with type information
	 * @param sessionContext Optional session context variables (SQL Server: sp_set_session_context)
	 *
	 * @return Complete INSERT SQL statement for the JSON data
	 */
	abstract string function getJsonInsertSQL(
		required array data,
		required string tableName,
		required struct columns,
		struct sessionContext = {}
	);

	/**
	 * Generates database-specific SQL for UPSERT (INSERT/UPDATE) operations using JSON data.
	 * Implements MERGE (SQL Server/Oracle) or INSERT...ON CONFLICT/DUPLICATE KEY UPDATE (other DBs).
	 *
	 * @param data Array of structs to merge
	 * @param tableName Target table name
	 * @param targets Array of column names that define uniqueness
	 * @param updateFields Array of column names to update on match (empty = update all)
	 * @param columns Struct of column metadata with type information
	 * @param sessionContext Optional session context variables
	 *
	 * @return Complete MERGE/UPSERT SQL statement for the JSON data
	 */
	abstract string function getJsonMergeSQL(
		required array data,
		required string tableName,
		required array targets,
		required array updateFields,
		required struct columns,
		struct sessionContext = {}
	);

	/**
	 * Returns SQL query to retrieve column information for a table.
	 * Must return columns: columnName, typeName, columnSize, precision, scale, bNullable, bAutoIncrement, bComputed, defaultValue
	 *
	 * @param tableName Table name (may include schema/database prefix)
	 * @param parseResult Parsed table name components with database, schema, table parts
	 *
	 * @return SQL query to get column metadata
	 */
	abstract string function getColumnMetadataQuery(
		required string tableName,
		required struct parseResult
	);

	/**
	 * Returns SQL query to check if a temporary table exists.
	 * Database-specific implementation for checking temp table presence.
	 *
	 * @param tempTableName Name of the temporary table to check
	 *
	 * @return SQL query that returns record count if temp table exists, 0 otherwise
	 */
	abstract string function getTempTableCheckQuery(required string tempTableName);

	/**
	 * Generates CREATE TEMPORARY TABLE SQL for this database.
	 * Handles database-specific temp table syntax and constraints.
	 *
	 * @param tableName Name for the temporary table
	 * @param columns Array of column structs with type information
	 *
	 * @return Complete CREATE TEMPORARY TABLE statement
	 */
	abstract string function getTempTableCreateSQL(
		required string tableName,
		required array columns
	);

	/**
	 * Returns the database-specific pattern/prefix for temporary table naming.
	 * Examples: "##" for SQL Server temp tables, "TEMPORARY TABLE" for PostgreSQL/SQLite
	 *
	 * @return Naming convention string: "##", "#", or "TEMPORARY TABLE"
	 */
	abstract string function getTempTableNamePattern();

	/**
	 * Parses and components a fully qualified table name into database, schema, and table parts.
	 * Handles database-specific naming conventions and defaults.
	 *
	 * @param fullTableName Table name (e.g., "database.schema.table" or "schema.table" or "table")
	 *
	 * @return Struct with keys: database, schema, table, name (reconstructed), tempName, _name (with underscores)
	 */
	abstract struct function parseTableNameComponents(required string fullTableName);

}
