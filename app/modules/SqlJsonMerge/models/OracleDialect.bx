/**
 * Oracle-specific database dialect implementation.
 * Oracle has MERGE support (similar to SQL Server) and JSON capabilities via json_table.
 * Oracle 12c+ recommended for JSON support.
 */
class extends="DatabaseDialect" {

	string function generateGUID() {
		return "SELECT SYS_GUID() AS guid FROM dual";
	}

	string function getDatabaseDateTime() {
		return "SELECT SYSDATE AS dateTime FROM dual";
	}

	string function getDatabaseUTCDateTime() {
		return "SELECT SYSTIMESTAMP AT TIME ZONE 'UTC' AS UTCDateTime FROM dual";
	}

	string function getJsonInsertSQL(
		required array data,
		required string tableName,
		required struct columns,
		required string jsonData,
		struct sessionContext = {}
	) {
		// Oracle JSON support via json_table (12c+)
		var colList = getColumnList(columns);

		var sql = "INSERT INTO #tableName# (#colList#)" & char(10);
		sql &= "SELECT #colList#" & char(10);
		sql &= "FROM JSON_TABLE('#jsonData#', '$[*]' COLUMNS (" & char(10);
		sql &= getJsonTableColumns(columns) & char(10);
		sql &= ") jt";

		return sql;
	}

	string function getJsonMergeSQL(
		required array data,
		required string tableName,
		required array targets,
		required array updateFields,
		required struct columns,
		required string jsonData,
		struct sessionContext = {}
	) {
		var updateCols = updateFields.len() ? updateFields : getWriteableColumns(columns);

		var sql = "MERGE INTO #tableName# t" & char(10);
		sql &= "USING (SELECT " & getSelectColumns(columns) & char(10);
		sql &= "FROM JSON_TABLE('#jsonData#', '$[*]' COLUMNS (" & char(10);
		sql &= getJsonTableColumns(columns) & char(10);
		sql &= ")) s" & char(10);
		sql &= "ON (#getMergeOnClause(targets)#)" & char(10);

		// WHEN MATCHED - UPDATE
		if (updateCols.len()) {
			sql &= "WHEN MATCHED THEN UPDATE SET" & char(10);
			var updates = updateCols.map((col) => {
				if (!targets.find(col)) {
					return "t.#col# = s.#col#";
				}
				return "";
			}).filter((str) => str.len());
			sql &= arrayToList(updates, ", " & char(10)) & char(10);
		}

		// WHEN NOT MATCHED - INSERT
		var insertCols = getWriteableColumns(columns);
		sql &= "WHEN NOT MATCHED THEN INSERT (#arrayToList(insertCols, ', ')#)" & char(10);
		sql &= "VALUES (#arrayToList(insertCols.map((col) => "s.#col#"), ", ")#)";

		return sql;
	}

	string function getColumnMetadataQuery(
		required string tableName,
		required struct parseResult
	) {
		var hasExplicitSchema = parseResult.schema.len() && parseResult.schema != "PUBLIC";

		// When no explicit schema is given, query the current user's own columns via
		// USER_TAB_COLUMNS rather than filtering ALL_TAB_COLUMNS by the literal string
		// "USER" (which does not resolve to the connected schema name).
		if (!hasExplicitSchema) {
			return "
				SELECT
					COLUMN_NAME AS columnName,
					DATA_TYPE AS typeName,
					DATA_LENGTH AS columnSize,
					DATA_PRECISION AS precision,
					DATA_SCALE AS scale,
					NULLABLE AS bNullable,
					VIRTUAL_COLUMN AS bAutoIncrement,
					0 AS bComputed,
					DEFAULT_LENGTH AS defaultValue
				FROM USER_TAB_COLUMNS
				WHERE TABLE_NAME = UPPER('#parseResult.table#')
				ORDER BY COLUMN_ID
			";
		}

		return "
			SELECT
				COLUMN_NAME AS columnName,
				DATA_TYPE AS typeName,
				DATA_LENGTH AS columnSize,
				DATA_PRECISION AS precision,
				DATA_SCALE AS scale,
				NULLABLE AS bNullable,
				VIRTUAL_COLUMN AS bAutoIncrement,
				0 AS bComputed,
				DEFAULT_LENGTH AS defaultValue
			FROM ALL_TAB_COLUMNS
			WHERE TABLE_NAME = UPPER('#parseResult.table#')
			AND OWNER = UPPER('#parseResult.schema#')
			ORDER BY COLUMN_ID
		";
	}

	string function getTableListQuery(required string dbname) {
		return "
			SELECT
				NULL AS tableCatalog,
				OWNER AS tableSchema,
				TABLE_NAME AS tableName,
				'TABLE' AS tableType
			FROM ALL_TABLES
			WHERE OWNER = UPPER('#dbname#')
		";
	}

	string function getTempTableCheckQuery(required string tempTableName) {
		return "SELECT COUNT(*) AS cnt FROM USER_TABLES WHERE TABLE_NAME = UPPER('#tempTableName#')";
	}

	string function getTempTableCreateSQL(
		required string tableName,
		required array columns
	) {
		var colDefs = [];
		for (var col in columns) {
			var def = "#col.columnName# #col.typeName#";
			if (col.typeName contains "VARCHAR" || col.typeName contains "CHAR") {
				def &= "(#(col.columnSize == -1 ? 255 : col.columnSize)#)";
			} else if (col.typeName contains "NUMBER") {
				def &= "(#col.precision#, #col.scale#)";
			}
			def &= " #(col.bNullable ? '' : 'NOT NULL')#";
			if (col.defaultValue.len()) {
				def &= " DEFAULT #col.defaultValue#";
			}
			colDefs.append(def);
		}

		return "CREATE GLOBAL TEMPORARY TABLE #tableName# (#arrayToList(colDefs, ', ')#) ON COMMIT DELETE ROWS";
	}

	string function getTempTableNamePattern() {
		return "GLOBAL TEMPORARY TABLE";
	}

	struct function parseTableNameComponents(required string fullTableName) {
		var components = {
			name: arguments.fullTableName,
			tempName: "TMP_" & replace(createUUID(), "-", "_", "all"),
			database: ""
		};

		var dotCount = listLen(fullTableName, ".");

		if (dotCount == 2) {
			components.schema = listGetAt(fullTableName, 1, ".");
			components.table = listGetAt(fullTableName, 2, ".");
		} else if (dotCount == 1) {
			components.schema = "PUBLIC";
			components.table = listGetAt(fullTableName, 1, ".");
		} else {
			components.schema = "PUBLIC";
			components.table = fullTableName;
		}

		components.name = components.schema & "." & components.table;
		components._name = components.name.replace(".", "_", "all");
		return components;
	}

	private string function getColumnList(required struct columns) {
		var cols = [];
		for (var colName in columns) {
			if (columns[colName].bInJson) {
				cols.append(colName);
			}
		}
		return arrayToList(cols, ", ");
	}

	private string function getSelectColumns(required struct columns) {
		var cols = [];
		for (var colName in columns) {
			if (columns[colName].bInJson) {
				cols.append(colName);
			}
		}
		return arrayToList(cols, ", ");
	}

	private string function getJsonTableColumns(required struct columns) {
		var cols = [];
		for (var colName in columns) {
			if (columns[colName].bInJson) {
				var oracleType = mapTypeToOracle(columns[colName].typeName);
				cols.append("#colName# #oracleType# PATH '$." & colName & "'");
			}
		}
		return arrayToList(cols, ", " & char(10));
	}

	private array function getWriteableColumns(required struct columns) {
		var cols = [];
		for (var colName in columns) {
			if (columns[colName].bWriteable && columns[colName].bInJson) {
				cols.append(colName);
			}
		}
		return cols;
	}

	private string function getMergeOnClause(required array targets) {
		var conditions = [];
		for (var target in targets) {
			conditions.append("t.#target# = s.#target#");
		}
		return arrayToList(conditions, " AND ");
	}

	private string function mapTypeToOracle(required string sqlType) {
		if (sqlType contains "BIGINT") return "NUMBER(19,0)";
		if (sqlType contains "INT") return "NUMBER(10,0)";
		if (sqlType contains "DECIMAL" || sqlType contains "NUMERIC") return "NUMBER";
		if (sqlType contains "FLOAT" || sqlType contains "DOUBLE") return "BINARY_DOUBLE";
		if (sqlType contains "DATE") return "DATE";
		if (sqlType contains "TIME") return "TIMESTAMP";
		if (sqlType contains "CHAR" || sqlType contains "VARCHAR" || sqlType contains "TEXT") return "VARCHAR2(255)";
		return "VARCHAR2(255)";
	}

}
