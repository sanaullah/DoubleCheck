/**
 * Factory for creating database dialect instances.
 * Detects the database type from BoxLang datasource configuration
 * and returns the appropriate dialect implementation.
 */
@singleton
class {

	property name="dialectCache" type="struct" default="#{}#";

	/**
	 * Get the dialect for a specific datasource.
	 * Caches dialect instances to avoid repeated instantiation.
	 *
	 * @param datasourceName Name of the datasource (from boxlang.json)
	 *
	 * @return DatabaseDialect implementation instance
	 */
	function getDialect(required string datasourceName) {
		if (dialectCache.keyExists(datasourceName)) {
			return dialectCache[datasourceName];
		}

		var dialect = createDialectForDriver(detectDriver(datasourceName));
		dialectCache[datasourceName] = dialect;
		return dialect;
	}

	/**
	 * Detect the JDBC driver name configured for a datasource by reading the
	 * application's boxlang.json. Falls back to "sqlite" if the datasource
	 * cannot be found or the configuration cannot be read.
	 *
	 * @param datasourceName Name of the datasource to detect
	 *
	 * @return Driver identifier string (e.g. "sqlite", "sqlserver", "postgresql", "mysql", "oracle")
	 */
	private string function detectDriver(required string datasourceName) {
		// boxlang.json commonly lives at the project root, but some setups keep it
		// under /runtime - check both locations.
		var candidatePaths = ["/runtime/boxlang.json", "/boxlang.json"];

		for (var candidate in candidatePaths) {
			try {
				var fullPath = expandPath(candidate);
				if (fileExists(fullPath)) {
					var parsed = jsonDeserialize(fileRead(fullPath));
					if (
						structKeyExists(parsed, "datasources") &&
						structKeyExists(parsed.datasources, datasourceName) &&
						structKeyExists(parsed.datasources[datasourceName], "driver")
					) {
						return parsed.datasources[datasourceName].driver;
					}
				}
			} catch (any e) {
				// Ignore and try the next candidate path
			}
		}

		return "sqlite";
	}

	/**
	 * Instantiate the concrete dialect for a given driver identifier.
	 *
	 * @param driver Driver identifier (e.g. "sqlserver", "postgresql")
	 *
	 * @return DatabaseDialect implementation instance
	 */
	private function createDialectForDriver(required string driver) {
		switch (arguments.driver) {
			case "sqlserver":
				return new app.modules.SqlJsonMerge.models.SQLServerDialect();
			case "postgresql":
				return new app.modules.SqlJsonMerge.models.PostgreSQLDialect();
			case "mysql":
				return new app.modules.SqlJsonMerge.models.MySQLDialect();
			case "oracle":
				return new app.modules.SqlJsonMerge.models.OracleDialect();
			case "sqlite":
			default:
				return new app.modules.SqlJsonMerge.models.SQLiteDialect();
		}
	}

	/**
	 * Clear the dialect cache. Useful for testing or when configuration changes.
	 */
	function clearCache() {
		dialectCache = {};
	}

}
