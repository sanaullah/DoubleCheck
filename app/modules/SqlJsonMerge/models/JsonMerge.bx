/**
 * JsonMerge Service - Multi-database JSON merge and insert operations.
 * Moved and refactored from app/models/services/QueryUtility.cfc
 * Now uses database dialects for SQL Server, PostgreSQL, Oracle, MySQL, and SQLite compatibility.
 */
@singleton
class {

	property name="dialectFactory" inject="DatabaseDialectFactory@SqlJsonMerge";

	// Populated via WireBox injection when resolved through the container. When this
	// component is instantiated directly with `new` (e.g. from a BIF), the injection
	// does not fire, so resolveDatasource() below falls back to a sane default.
	property name="defaultDatasource" inject="coldbox:setting:datasource";

	/**
	 * Query execution with retry logic for transient failures.
	 * Retries up to 5 times for deadlocks, timeouts, connection resets, and the
	 * SQLite/HikariCP statement-pointer race ("Cannot invoke ... isClosed() ...
	 * this.pointer is null") that surfaces intermittently when a pooled statement
	 * is reused across nested singleton-scoped queryExecute() calls.
	 */
	function qe(
		required string sql,
		struct bindings = {},
		struct options = {},
		numeric count = 1
	) {
		var retryLimit = 5;

		try {
			return queryExecute(arguments.sql, arguments.bindings, arguments.options);
		} catch (any error) {
			if (
				(
					error.message contains "deadlock" ||
					error.message contains "timed out" ||
					error.message contains "Connection reset" ||
					error.message contains "isClosed" ||
					error.message contains "pointer is null"
				) &&
				arguments.count <= retryLimit
			) {
				sleep(1000);
				return qe(arguments.sql, arguments.bindings, arguments.options, arguments.count + 1);
			}
			rethrow;
		}
	}

	/**
	 * Converts a query object to an array of structs.
	 * Each row becomes an ordered struct in the result array.
	 */
	array function queryToArrayOfStructs(required any q) {
		var queryColumns = listToArray(arguments.q.columnList);

		return queryReduce(
			arguments.q,
			function (results, row) {
				var rowData = structNew("ordered");
				for (var column in queryColumns) {
					rowData[column] = row[column];
				}
				results.append(rowData);
				return results;
			},
			[]
		);
	}

	/**
	 * Bulk insert JSON data into a table using the appropriate database dialect.
	 * Generates and executes database-specific INSERT SQL.
	 */
	struct function jsonInsert(
		required array data,
		required string tableName,
		boolean bReturnSQL = false,
		string datasource = "",
		struct sessionContext = {}
	) {
		if ((isStruct(arguments.data) && arguments.data.isEmpty()) || len(arguments.data) == 0) {
			return false;
		}

		var tickCountDB = getTickCount();
		var resolvedDatasource = resolveDatasource(arguments.datasource);
		var queryOptions = {datasource: resolvedDatasource};

		var dialect = dialectFactory.getDialect(resolvedDatasource);
		var columns = columnData(arguments.tableName, resolvedDatasource);

		// cleanJsonData() escapes quotes and normalizes types for safe embedding in SQL
		// text - dialects MUST use this cleaned JSON, not the raw incoming data, or
		// string values containing an apostrophe will break/inject the generated SQL.
		var cleanedJsonData = cleanJsonData(arguments.data, columns);

		columns = columns.filter((k, c) => {
			return c.bInJson;
		});

		var sql = dialect.getJsonInsertSQL(
			data = arguments.data,
			tableName = arguments.tableName,
			columns = columns,
			jsonData = cleanedJsonData,
			sessionContext = sessionContext
		);

		var build = ((getTickCount() - tickCountDB) / 1000);

		if (bReturnSQL) {
			return sql;
		}

		tickCountDB = getTickCount();
		var queryOut = {query: qe(sql, {}, queryOptions)};
		var execute = ((getTickCount() - tickCountDB) / 1000);

		queryOut.timing = {
			build: build,
			execute: execute,
			message: "(#numberFormat(data.len(), "9,999,999")# record#((data.len() == 1) ? "" : "s")#) || Build SQL: " & build & " || DB Execution: " & execute
		};
		queryOut.result = {recordCount: queryOut.query.recordCount};

		return queryOut;
	}

	/**
	 * UPSERT (INSERT/UPDATE) JSON data using the appropriate database dialect.
	 * Handles matching on key columns and updating specified fields on match.
	 */
	struct function jsonMerge(
		required array data,
		required string tableName,
		array targets = [],
		array update = [],
		boolean bDelete = false,
		boolean bReturnSQL = false,
		string datasource = "",
		struct sessionContext = {},
		string deleteClause = ""
	) {
		if ((isStruct(arguments.data) && arguments.data.isEmpty()) || arguments.data.len() == 0) {
			return false;
		}

		var tickCountDB = getTickCount();
		var resolvedDatasource = resolveDatasource(arguments.datasource);
		var queryOptions = {datasource: resolvedDatasource};

		var dialect = dialectFactory.getDialect(resolvedDatasource);
		var columns = columnData(arguments.tableName, resolvedDatasource);

		// cleanJsonData() escapes quotes and normalizes types for safe embedding in SQL
		// text - dialects MUST use this cleaned JSON, not the raw incoming data.
		var cleanedJsonData = cleanJsonData(arguments.data, columns);

		// Fix case for provided targets
		var matchTargets = [];
		arguments.targets.each((item) => {
			return matchTargets.append(columns[item].name);
		});

		arguments.targets = matchTargets;

		columns = columns.filter((k, c) => {
			return c.bInJson;
		});

		var sql = dialect.getJsonMergeSQL(
			data = arguments.data,
			tableName = arguments.tableName,
			targets = arguments.targets,
			updateFields = arguments.update,
			columns = columns,
			jsonData = cleanedJsonData,
			sessionContext = sessionContext
		);

		var build = ((getTickCount() - tickCountDB) / 1000);

		if (bReturnSQL) {
			return sql;
		}

		tickCountDB = getTickCount();
		var queryOut = {query: qe(sql, {}, queryOptions)};
		var execute = ((getTickCount() - tickCountDB) / 1000);

		queryOut.timing = {
			build: build,
			execute: execute,
			message: "#numberFormat(data.len(), "9,999,999")# record#((data.len() == 1) ? "" : "s")# to #arguments.tableName# || Build SQL: " & build & " || DB Execution: " & execute
		};

		queryOut.result = {recordCount: queryOut.query.recordCount};

		return queryOut;
	}

	/**
	 * Retrieve column metadata for a table.
	 * Returns detailed column information including type, size, nullable status, etc.
	 */
	struct function columnData(required string tableName, string datasource = "") {
		var base = dbInfo(type="columns", table=arguments.tableName, datasource=arguments.datasource);

		return base
			.sort((a, b) => {
				return compare(a.columnName, b.columnName);
			})
			.reduce((o, column) => {
				o[column.columnName] = {
					name: column.columnName,
					type: column.typeName,
					bNullable: column.bNullable,
					bWriteable: !column.bAutoIncrement && !column.bComputed,
					typeString: listFirst(column.typeName, " ") &
						((column.typeName contains "char")
							? " (#(column.columnSize == -1 ? 'max' : column.columnSize)#)"
							: (column.typeName == "decimal")
							? "(#column.precision#, #column.scale#)"
							: ""),
					qualified: char(9) & "[" & column.columnName & "] " & "," & char(10)
				};
				o[column.columnName].withType = char(9) & "[" & o[column.columnName].name & "] " & o[column.columnName].typeString & "," & char(10);
				return o;
			}, {});
	}

	/**
	 * Clean and prepare JSON data for database operations.
	 * Handles type conversions, null handling, quote escaping, and column validation.
	 * The returned JSON string has string values with single quotes escaped so it can
	 * be safely embedded directly inside a single-quoted SQL string literal.
	 */
	string function cleanJsonData(required array json, required struct columnData) {
		var incomingColumns = json[1].keyArray();
		var verifyColumns = [];

		columnData = columnData.map((k, v) => {
			v.bInJson = incomingColumns.findNoCase(k) > 0;
			return v;
		});

		// Catch any mismatch/spelling corrections
		incomingColumns.each((item) => {
			if (!structKeyExists(columnData, item)) {
				verifyColumns.append(item);
			}
		}, true);

		if (verifyColumns.len()) {
			throw(message="Following columns don't match with DB Schema " & verifyColumns.toList());
		}

		// Filter out only columns which exist in json
		columnData = columnData.filter((k, v) => {
			return v.bInJson > 0;
		}, true);

		// Transform each row directly (no evaluate() - BoxLang has no dynamic
		// string-eval BIF). For every column: unwrap struct-shaped values, coerce
		// by DB type (date formatting, quote escaping, numeric/bit normalization),
		// then apply null handling for nullable columns.
		var cleanJson = arguments.json.map((row) => {
			var out = {};

			for (var colKey in columnData) {
				var colInfo = columnData[colKey];
				var rawVal = structKeyExists(row, colKey) ? row[colKey] : "";
				var val1 = isStruct(rawVal) ? rawVal.value : rawVal;

				var val2 = val1;
				if (colInfo.type contains "date") {
					val2 = dateTimeFormat(val1, "yyyy-mm-dd HH:nn:ss");
				} else if (colInfo.type contains "char" || colInfo.type contains "text") {
					val2 = replace(val1.toString(), "'", "''", "all");
				} else if (["int", "bigint", "float", "smallint", "tinyint"].find(colInfo.type)) {
					val2 = isInstanceOf(val1, "java.lang.Boolean") ? (val1 ? 1 : 0) : val(val1);
				} else if (colInfo.type == "bit") {
					val2 = val((val1.toString().len() && val1) ? 1 : 0);
				}

				if (colInfo.bNullable) {
					out[colInfo.name] = (val2.toString().trim().len()) ? val2 : javacast("null", val2);
				} else {
					out[colInfo.name] = val2;
				}
			}

			return out;
		}, true);

		arguments.json = "";

		return jsonSerialize(cleanJson);
	}

	/**
	 * Get comprehensive database information (tables or columns).
	 * Uses the appropriate dialect to generate database-specific queries.
	 */
	function dbInfo(
		required string type,
		string table = "",
		string dbname = "",
		string datasource = ""
	) {
		if (type == "tables" && (isNull(dbname) || dbname == "")) {
			throw(type="Database", message="Database name must be provided for type='tables'.");
		}

		var resolvedDatasource = resolveDatasource(arguments.datasource);
		var dialect = dialectFactory.getDialect(resolvedDatasource);

		var parsedTable = {};
		if (!isNull(table) && table != "") {
			parsedTable = parseTableName(table, resolvedDatasource);
		}

		var queryStr = "";
		var queryOptions = {};

		if (type == "tables") {
			queryStr = dialect.getTableListQuery(dbname);
		} else if (type == "columns" && !isNull(table) && table != "") {
			queryStr = dialect.getColumnMetadataQuery(table, parsedTable);
		} else {
			throw(type="Database", message="Invalid type or missing table name.");
		}

		if (!isNull(datasource) && datasource != "" && datasource != "default") {
			queryOptions.datasource = datasource;
		}

		return qe(queryStr, {}, queryOptions);
	}

	/**
	 * Parse a fully qualified table name into its components using the naming
	 * conventions of the dialect that corresponds to the given datasource.
	 */
	struct function parseTableName(required string fullTableName, string datasource = "") {
		var dialect = dialectFactory.getDialect(resolveDatasource(arguments.datasource));
		return dialect.parseTableNameComponents(fullTableName);
	}

	/**
	 * Resolve the effective datasource name: the explicit argument if provided,
	 * otherwise the injected ColdBox default, falling back to "doublecheck" when
	 * this component was instantiated directly (bypassing WireBox injection, as
	 * BIFs do) and defaultDatasource was therefore never populated.
	 */
	private string function resolveDatasource(string datasource = "") {
		if (arguments.datasource.len()) {
			return arguments.datasource;
		}
		if (!isNull(defaultDatasource) && len(defaultDatasource)) {
			return defaultDatasource;
		}
		return "doublecheck";
	}

}
