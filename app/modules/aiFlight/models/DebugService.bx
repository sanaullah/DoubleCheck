/**
 * Advanced debugging tools: replay and state diffing
 */
class {
	property name="store" inject="TraceStoreService@aiFlight";

	function replayTrace( required string traceId, struct overrides = {} ) {
		// overrides: { model, prompt, temperature, ... }
		// TODO: Re-execute trace with different parameters
		return { success: true, replayId: createUUID(), traceId: arguments.traceId };
	}

	function getStateDiff( required string traceId, string obsId1 = "", string obsId2 = "" ) {
		// TODO: Compare observation states and highlight differences
		return { diffs: [], changed: [] };
	}

	function getDependencyGraph( required string traceId ) {
		// TODO: Build service/function dependency graph
		return { nodes: [], edges: [] };
	}

	function correlateWithLogs( required string traceId, string logSource = "" ) {
		// TODO: Link trace spans to application logs
		return { correlations: [] };
	}
}
