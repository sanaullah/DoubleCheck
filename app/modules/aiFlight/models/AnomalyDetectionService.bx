/**
 * Anomaly detection and alerting for AI traces
 * Detects performance degradation, quality issues, and cost spikes
 */
class {
	property name="store" inject="TraceStoreService@aiFlight";

	/**
	 * Detect anomalies in recent traces
	 * Uses dynamic baseline learning
	 */
	function detectAnomalies( struct options = {} ) {
		var lookbackDays = options.lookbackDays ?: 7;
		var sensitivity = options.sensitivity ?: "normal"; // low, normal, high
		var metrics = options.metrics ?: [ "latency", "cost", "quality" ];

		var anomalies = [];

		// Learn baseline from historical data
		var baseline = buildBaseline( lookbackDays );

		// Detect latency anomalies
		if ( arrayContains( metrics, "latency" ) ) {
			anomalies.append( detectLatencyAnomalies( baseline, sensitivity ) );
		}

		// Detect cost anomalies
		if ( arrayContains( metrics, "cost" ) ) {
			anomalies.append( detectCostAnomalies( baseline, sensitivity ) );
		}

		// Detect quality anomalies
		if ( arrayContains( metrics, "quality" ) ) {
			anomalies.append( detectQualityAnomalies( baseline, sensitivity ) );
		}

		// Detect error rate spikes
		anomalies.append( detectErrorSpikes( baseline, sensitivity ) );

		return {
			anomalies: anomalies,
			totalCount: anomalies.len(),
			baseline: baseline,
			lastUpdated: now()
		};
	}

	/**
	 * Build dynamic baseline from historical data (mean + std dev)
	 */
	private struct function buildBaseline( numeric lookbackDays = 7 ) {
		var startDate = dateAdd( "d", -lookbackDays, now() );

		// TODO: Query historical metrics and calculate statistics
		// For now, return mock baseline
		return {
			latency: {
				mean: 2500, // ms
				stddev: 400,
				p50: 2200,
				p95: 3200,
				p99: 4000
			},
			cost: {
				mean: 0.15,
				stddev: 0.05,
				min: 0.05,
				max: 0.45
			},
			quality: {
				mean: 0.85,
				stddev: 0.08,
				min: 0.60,
				max: 0.98
			},
			errorRate: {
				mean: 0.02,
				stddev: 0.01
			}
		};
	}

	/**
	 * Detect latency anomalies
	 */
	private array function detectLatencyAnomalies( required struct baseline, string sensitivity = "normal" ) {
		var anomalies = [];
		var threshold = sensitivity == "high" ? 1.5 : ( sensitivity == "low" ? 3 : 2 ); // Standard deviations
		var stddevThreshold = baseline.latency.stddev * threshold;
		var upperBound = baseline.latency.mean + stddevThreshold;

		// TODO: Query recent traces and compare to baseline
		// var recentTraces = store.listTraces( limit = 100 );
		// for ( var trace in recentTraces ) {
		//   if ( trace.durationMs > upperBound ) {
		//     anomalies.append( { type: "latency", traceId: trace.id, value: trace.durationMs, threshold: upperBound } );
		//   }
		// }

		return anomalies;
	}

	/**
	 * Detect cost anomalies (cost spikes)
	 */
	private array function detectCostAnomalies( required struct baseline, string sensitivity = "normal" ) {
		var anomalies = [];
		var threshold = sensitivity == "high" ? 1.5 : ( sensitivity == "low" ? 3 : 2 );
		var stddevThreshold = baseline.cost.stddev * threshold;
		var upperBound = baseline.cost.mean + stddevThreshold;

		// TODO: Query recent traces and compare to baseline
		// var recentTraces = store.listTraces( limit = 100 );
		// for ( var trace in recentTraces ) {
		//   if ( trace.cost > upperBound ) {
		//     anomalies.append( { type: "cost", traceId: trace.id, value: trace.cost, threshold: upperBound } );
		//   }
		// }

		return anomalies;
	}

	/**
	 * Detect quality degradation
	 */
	private array function detectQualityAnomalies( required struct baseline, string sensitivity = "normal" ) {
		var anomalies = [];
		var threshold = sensitivity == "high" ? 1.5 : ( sensitivity == "low" ? 3 : 2 );
		var stddevThreshold = baseline.quality.stddev * threshold;
		var lowerBound = baseline.quality.mean - stddevThreshold;

		// TODO: Query recent traces with quality scores and compare

		return anomalies;
	}

	/**
	 * Detect error rate spikes
	 */
	private array function detectErrorSpikes( required struct baseline, string sensitivity = "normal" ) {
		var anomalies = [];
		var threshold = sensitivity == "high" ? 1.5 : ( sensitivity == "low" ? 3 : 2 );
		var stddevThreshold = baseline.errorRate.stddev * threshold;
		var upperBound = baseline.errorRate.mean + stddevThreshold;

		// TODO: Calculate error rate in recent window and compare to baseline

		return anomalies;
	}

	/**
	 * Set up alert rule
	 */
	function createAlertRule( required struct config ) {
		// config: { name, metric, condition, threshold, action, enabled }
		// metric: latency, cost, quality, error_rate
		// condition: gt (greater than), lt (less than), eq (equals)
		// action: email, slack, webhook, in_app

		// TODO: Persist alert rule
		return { success: true, ruleId: createUUID() };
	}

	/**
	 * List alert rules
	 */
	function listAlertRules() {
		// TODO: Retrieve alert rules
		return [];
	}

	/**
	 * Check if anomaly should trigger alert
	 */
	function shouldAlert( required struct anomaly, array rules = [] ) {
		for ( var rule in rules ) {
			if ( rule.metric == anomaly.type && rule.enabled ) {
				return checkCondition( anomaly.value, rule.condition, rule.threshold );
			}
		}
		return false;
	}

	/**
	 * Evaluate condition
	 */
	private boolean function checkCondition( required numeric value, required string condition, required numeric threshold ) {
		switch ( condition ) {
			case "gt":
				return value > threshold;
			case "lt":
				return value < threshold;
			case "eq":
				return value == threshold;
			default:
				return false;
		}
	}

	/**
	 * Correlate related anomalies to find root cause
	 */
	function correlateAnomalies( required array anomalies ) {
		var groups = [];

		// TODO: Group related anomalies by time, model, user, environment
		// Example: All cost spikes for model X at same time = related

		return {
			groups: groups,
			potentialRootCauses: []
		};
	}

	/**
	 * Get anomaly trend (frequency over time)
	 */
	function getAnomalyTrend( numeric days = 30 ) {
		// TODO: Get frequency of anomalies over time
		return {
			days: days,
			trend: [],
			totalAnomalies: 0
		};
	}

	/**
	 * Get anomaly statistics (type distribution, affected traces)
	 */
	function getAnomalyStats( numeric days = 7 ) {
		// TODO: Aggregate anomaly metrics
		return {
			byType: {
				latency: 0,
				cost: 0,
				quality: 0,
				error: 0
			},
			affectedTraces: 0,
			affectedModels: [],
			affectedUsers: []
		};
	}

	/**
	 * Send alert notification
	 */
	function sendAlert( required struct anomaly, required struct rule ) {
		// TODO: Implement alert delivery (email, Slack, webhook, etc.)
		return { success: true, alertId: createUUID() };
	}

	/**
	 * Suppress alerts temporarily
	 */
	function suppressAlerts( required numeric minutes = 30 ) {
		// TODO: Temporarily disable alert triggering
		return { success: true, suppressedUntil: dateAdd( "n", minutes, now() ) };
	}

	/**
	 * Learn from feedback (did this alert matter?)
	 */
	function recordAlertFeedback( required string alertId, required string feedback ) {
		// feedback: true_positive, false_positive, not_actionable
		// TODO: Use feedback to improve anomaly detection
		return { success: true };
	}
}
