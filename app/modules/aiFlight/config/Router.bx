/**
 * Module routes — prefixed with entryPoint /aiflight
 */
class extends="coldbox.system.web.routing.Router" {

	function configure() {
		route( "/", "flight.index" );
		route( "/trace/:id", "flight.trace" );
		route( "/api/sessions", "flight.apiSessions" );
		route( "/api/session/:id", "flight.apiSession" );
		route( "/api/trace/:traceId/observation-tree", "flight.apiTraceObservationTree" );
		route( "/api/trace/:id/feedback", "flight.apiTraceFeedback" );
		route( "/api/trace/:id", "flight.apiTrace" );
		route( "/api/traces", "flight.apiTraces" );
		route( "/api/observation/:id", "flight.apiObservation" );
		route( "/api/stats", "flight.apiStats" );
		route( "/api/status", "flight.apiStatus" );
		route( "/api/probe", "flight.apiProbe" );
	}
}