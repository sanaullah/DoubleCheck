/**
 * Module routes — prefixed with entryPoint /aiflight
 */
class extends="coldbox.system.web.routing.Router" {

	function configure() {
		route( "/", "flight.index" );
		route( "/trace/:id", "flight.trace" );
		route( "/api/sessions", "flight.apiSessions" );
		route( "/api/session/:id", "flight.apiSession" );
		route( "/api/trace/:traceId/observation-tree", "flight.apiTraceObservationTree" );
		route( "/api/trace/:traceId/observations/filtered", "flight.apiTracesFilteredByObservations" );
		route( "/api/trace/:id/metrics", "flight.apiTraceMetrics" );
		route( "/api/trace/:id/errors", "flight.apiTraceErrors" );
		route( "/api/trace/:id/export", "flight.apiTraceExport" );
		route( "/api/trace/:id/feedback", "flight.apiTraceFeedback" );
		route( "/api/trace/:id", "flight.apiTrace" );
		route( "/api/traces", "flight.apiTraces" );
		route( "/api/observation/:id", "flight.apiObservation" );
		route( "/api/stats", "flight.apiStats" );
		route( "/api/status", "flight.apiStatus" );
		route( "/api/probe", "flight.apiProbe" );
		route( "/api/filters/save", "flight.apiSaveFilter" );
		route( "/api/filters/list", "flight.apiListSavedFilters" );
		route( "/api/cohort-analysis", "flight.apiCohortAnalysis" );
		route( "/api/search", "flight.apiSearch" );
		route( "/api/search/suggestions", "flight.apiSearchSuggestions" );
		route( "/api/search/save", "flight.apiSaveSearchQuery" );
		route( "/api/search/recent", "flight.apiRecentSearches" );
		route( "/api/observation/:id/feedback", "flight.apiObservationFeedback" );
		route( "/api/feedback-stats", "flight.apiFeedbackStats" );
		route( "/api/cost-analytics", "flight.apiCostAnalytics" );
		route( "/api/cost-per-request/:id", "flight.apiCostPerRequest" );
		route( "/api/cost-comparison", "flight.apiCostComparison" );
		route( "/api/cost-forecast", "flight.apiCostForecast" );
		route( "/api/budget-status", "flight.apiBudgetStatus" );
		route( "/api/cost-efficiency", "flight.apiCostEfficiency" );
		route( "/api/latency-benchmarks", "flight.apiLatencyBenchmarks" );
		route( "/api/token-efficiency", "flight.apiTokenEfficiency" );
		route( "/api/quality-trends", "flight.apiQualityTrends" );
		route( "/api/baseline-comparison", "flight.apiBaselineComparison" );
		route( "/api/cost-attribution", "flight.apiCostAttribution" );
		route( "/api/cost-forecast2", "flight.apiCostForecast2" );
		route( "/api/rate-card", "flight.apiRateCard" );
		route( "/api/rate-history", "flight.apiRateHistory" );
		route( "/api/detect-anomalies", "flight.apiDetectAnomalies" );
		route( "/api/alert-rules", "flight.apiCreateAlertRule" );
		route( "/api/alert-rules/list", "flight.apiListAlertRules" );
		route( "/api/anomaly-stats", "flight.apiAnomalyStats" );
		route( "/api/anomaly-trend", "flight.apiAnomalyTrend" );
		route( "/api/datasets", "flight.apiCreateDataset" );
		route( "/api/datasets/list", "flight.apiListDatasets" );
		route( "/api/evaluate-trace", "flight.apiEvaluateTrace" );
		route( "/api/ab-tests", "flight.apiCreateABTest" );
		route( "/api/ab-tests/active", "flight.apiGetActiveTests" );
		route( "/api/ab-tests/compare/:testId", "flight.apiCompareVariants" );
		route( "/api/ab-tests/end/:testId", "flight.apiEndABTest" );
		route( "/api/debug/replay/:traceId", "flight.apiReplayTrace" );
		route( "/api/debug/state-diff/:traceId", "flight.apiStateDiff" );
		route( "/api/batch/submit", "flight.apiSubmitBatchJob" );
		route( "/api/batch/status/:jobId", "flight.apiGetBatchStatus" );
		route( "/api/webhooks", "flight.apiRegisterWebhook" );
		route( "/api/webhooks/list", "flight.apiListWebhooks" );
		route( "/api/visualizations/flame/:traceId", "flight.apiGetFlameGraph" );
		route( "/api/data-quality", "flight.apiGetDataQuality" );
		route( "/api/notifications", "flight.apiSendNotification" );
	}
}