<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=1280">
	<title><bx:output>#encodeForHTML( prc.pageTitle ?: "AiFlight" )#</bx:output></title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
	<style>
	:root {
		--bg: #10151c;
		--panel: #161d26;
		--panel-2: #1b2430;
		--border: #2a3544;
		--text: #e8eef6;
		--muted: #8b9bb0;
		--accent: #4ea1f3;
		--ok: #3ecf8e;
		--err: #f07178;
		--gen: #c792ea;
		--tool: #82aaff;
		--span: #89ddff;
		--event: #9ca3af;
		--font: "IBM Plex Sans", "Segoe UI", sans-serif;
		--mono: "IBM Plex Mono", Consolas, monospace;
		--list-w: 400px;
		--radius: 8px;
		--ctrl-h: 34px;
		--ctrl-pad: 7px 10px;
		--text-xs: 0.68rem;
		--text-sm: 0.78rem;
	}
	* { box-sizing: border-box; }
	html, body { height: 100%; }
	body {
		margin: 0;
		font-family: var(--font);
		background: var(--bg);
		color: var(--text);
		overflow: hidden;
	}
	.shell { height: 100vh; display: grid; grid-template-rows: auto 1fr; }
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 20px;
		border-bottom: 1px solid var(--border);
		background: var(--panel);
	}
	.brand {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 1.1rem;
		font-weight: 650;
		letter-spacing: -0.02em;
	}
	.brand-mark {
		width: 1.85rem;
		height: 1.85rem;
		display: grid;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
		border-radius: 8px;
		background: rgba(78, 161, 243, 0.1);
		color: var(--accent);
		font-size: 0.68rem;
		font-weight: 700;
		font-family: var(--mono);
	}
	.brand span { color: var(--muted); font-weight: 450; font-size: 0.8rem; }
	.meta { color: var(--muted); font-size: var(--text-sm); }
	.stats-bar {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-left: auto;
		font-size: var(--text-sm);
		font-family: var(--mono);
		color: var(--muted);
		white-space: nowrap;
	}
	.stats-bar .stat-chip b { color: var(--text); font-weight: 600; }
	.workspace {
		display: grid;
		grid-template-columns: var(--list-w) 1fr;
		min-height: 0;
		height: 100%;
	}
	.list-pane {
		display: flex;
		flex-direction: column;
		min-height: 0;
		border-right: 1px solid var(--border);
		background: var(--panel);
	}
	.mode-tabs {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 10px 12px 0;
		background: var(--panel-2);
		border-bottom: 1px solid var(--border);
	}
	.mode-tab {
		font: inherit;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		padding: 7px 12px;
		border-radius: 6px 6px 0 0;
		cursor: pointer;
		font-weight: 600;
		font-size: 0.85rem;
	}
	.mode-tab.is-active {
		color: var(--text);
		background: var(--panel);
		border-color: var(--border);
		border-bottom-color: var(--panel);
		margin-bottom: -1px;
	}
	.filters {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
		align-items: center;
		padding: 10px 12px 12px;
		border-bottom: 1px solid var(--border);
		background: var(--panel-2);
	}
	.filters-label {
		grid-column: 1 / -1;
		margin: 0;
		color: var(--muted);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.filters input, .filters select, .filters button {
		font: inherit;
		width: 100%;
		min-height: var(--ctrl-h);
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--text);
		padding: var(--ctrl-pad);
		font-size: var(--text-sm);
		line-height: 1.2;
	}
	.filters input[type="search"] { grid-column: 1 / -1; }
	.filters-status { grid-column: 1 / -1; }
	.filters input[type="text"], .filters input[type="number"] { width: 100%; min-width: 0; }
	.filters-advanced {
		grid-column: 1 / -1;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		overflow: hidden;
	}
	.filters-advanced summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 8px 10px;
		cursor: pointer;
		list-style: none;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--muted);
		user-select: none;
	}
	.filters-advanced summary::-webkit-details-marker { display: none; }
	.filters-advanced summary::after {
		content: "▸";
		color: var(--muted);
		font-size: .85rem;
		transition: transform .15s ease;
	}
	.filters-advanced[open] summary {
		border-bottom: 1px solid var(--border);
	}
	.filters-advanced[open] summary::after { transform: rotate(90deg); }
	.filters-advanced-body {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
		padding: 10px;
	}
	.filters-advanced-body .filters-nums {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}
	.filters-advanced-body .filters-checks {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 14px;
	}
	.filters-nums {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}
	.filters-checks {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 14px;
	}
	.filters .chk {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--text-sm);
		color: var(--muted);
		white-space: nowrap;
		margin: 0;
	}
	.filters .chk input {
		width: auto;
		min-height: 0;
		padding: 0;
		accent-color: var(--accent);
	}
	.filters button {
		grid-column: 1 / -1;
		background: var(--accent);
		border-color: transparent;
		color: #041018;
		font-weight: 600;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.filters button:hover { filter: brightness(1.05); }
	.live-pill {
		margin-left: auto;
		align-self: center;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ok);
		padding: 5px 8px;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--ok) 35%, var(--border));
	}
	.live-pill::before {
		content: "";
		width: 6px; height: 6px; border-radius: 50%;
		background: var(--ok);
		animation: pulse 1.4s ease-in-out infinite;
	}
	.live-pill.stale { color: var(--muted); border-color: var(--border); }
	.live-pill.stale::before { background: var(--muted); animation: none; }
	@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.35} }
	.trace-list { overflow: auto; min-height: 0; flex: 1; overflow-anchor: none; }
	.trace-item, .session-item {
		display: block;
		width: 100%;
		text-align: left;
		border: 0;
		border-bottom: 1px solid var(--border);
		background: transparent;
		color: inherit;
		font: inherit;
		padding: 10px 14px;
		cursor: pointer;
	}
	.trace-item:hover, .session-item:hover { background: rgba(78, 161, 243, 0.06); }
	.trace-item.is-active, .session-item.is-open {
		background: rgba(78, 161, 243, 0.12);
		box-shadow: inset 3px 0 0 var(--accent);
	}
	.trace-item-top, .session-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 4px;
	}
	.trace-item-top strong, .session-top strong { font-size: 0.95rem; }
	.trace-item-meta, .session-meta { font-size: 0.75rem; color: var(--muted); margin-bottom: 2px; }
	.trace-item-sub { font-size: 0.78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.session-children { display: none; background: var(--bg); }
	.session-item.is-open + .session-children,
	.session-block.is-open .session-children { display: block; }
	.session-block.is-open .session-item { box-shadow: inset 3px 0 0 var(--accent); background: rgba(78, 161, 243, 0.08); }
	.session-children .trace-item { padding-left: 22px; }
	.detail-pane { min-height: 0; overflow: auto; background: var(--bg); overflow-anchor: none; }
	.detail-inner { padding: 18px 22px 40px; max-width: 960px; }
	.detail-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 12px;
		margin-bottom: 14px;
	}
	.detail-head h2 { margin: 0; font-size: 1.28rem; letter-spacing: -0.02em; flex: 1 1 12rem; line-height: 1.2; min-width: 0; }
	.detail-head .back-link { flex: 0 0 auto; }
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
		gap: 10px 12px;
		margin-bottom: 14px;
		padding: 12px;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.stat {
		display: grid;
		gap: 3px;
		min-width: 0;
	}
	.stat > span {
		color: var(--muted);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.stat b {
		color: var(--text);
		font-weight: 600;
		font-size: var(--text-sm);
		line-height: 1.35;
		overflow-wrap: anywhere;
	}
	.stat .muted { font-weight: 400; }
	.tree { margin-top: 8px; }
	.obs {
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--panel);
		margin-bottom: 8px;
		overflow: hidden;
	}
	.obs-children { margin: 0 0 8px 18px; border-left: 1px solid var(--border); padding-left: 10px; }
	.obs-head {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 14px;
		cursor: pointer;
		user-select: none;
		background: var(--panel-2);
	}
	.obs-type {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		min-width: 78px;
	}
	.obs-type.generation { color: var(--gen); }
	.obs-type.tool { color: var(--tool); }
	.obs-type.span { color: var(--span); }
	.obs-type.event { color: var(--event); }
	.obs-name {
		font-weight: 600;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.obs-meta {
		margin-left: auto;
		flex: 0 0 auto;
		color: var(--muted);
		font-size: 0.78rem;
		font-family: var(--mono);
		white-space: nowrap;
	}
	.obs-body { display: none; padding: 12px 14px 14px; border-top: 1px solid var(--border); }
	.obs.open > .obs-body { display: block; }
	.obs-body h4 {
		margin: 0 0 6px;
		font-size: 0.72rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.obs-source {
		margin: 0 0 12px;
		font-size: 0.78rem;
		color: var(--muted);
		font-family: var(--mono);
	}
	.obs-source b { color: var(--text); font-weight: 600; }
	.obs-body pre, .preview-block {
		margin: 0 0 12px;
		padding: 10px 12px;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 6px;
		white-space: pre-wrap;
		word-break: break-word;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: #d7e2ef;
		overflow: auto;
		overflow-anchor: none;
		overscroll-behavior: contain;
	}
	.obs-body pre.io-block, .preview-block {
		max-height: min(55vh, 520px);
	}
	.obs-body pre.meta-block {
		max-height: 200px;
	}
	details.payload, details.usage-block { margin-top: 4px; }
	details.payload summary, details.usage-block summary {
		cursor: pointer;
		color: var(--muted);
		font-size: 0.78rem;
		margin-bottom: 6px;
	}
	.waterfall {
		margin: 0 0 18px;
		padding: 12px 14px;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.section-head {
		margin: 0 0 10px;
	}
	.waterfall-title,
	.section-title {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 700;
	}
	.section-purpose {
		margin: 4px 0 0;
		color: var(--muted);
		font-size: var(--text-sm);
		line-height: 1.4;
	}
	.wf-row {
		display: grid;
		grid-template-columns: minmax(90px, 140px) 1fr 64px;
		gap: 10px;
		align-items: center;
		margin-bottom: 8px;
		min-height: 22px;
		cursor: pointer;
	}
	.wf-row:hover .wf-track { background: rgba(78, 161, 243, 0.12); }
	.wf-label {
		font-size: 0.72rem;
		font-family: var(--mono);
		color: var(--muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.wf-track {
		position: relative;
		height: 14px;
		background: var(--bg);
		border-radius: 4px;
		border: 1px solid var(--border);
		overflow: hidden;
	}
	.wf-bar {
		position: absolute;
		top: 1px;
		bottom: 1px;
		border-radius: 3px;
		min-width: 4px;
		opacity: 0.9;
	}
	.wf-bar.generation { background: var(--gen); }
	.wf-bar.tool { background: var(--tool); }
	.wf-bar.span { background: var(--span); }
	.wf-bar.event { background: var(--event); }
	.wf-bar.error { background: var(--err) !important; }
	.wf-dur { font-size: 0.72rem; font-family: var(--mono); color: var(--muted); text-align: right; }
	.wf-row.error .wf-bar { background: var(--err) !important; opacity: 1; }
	.wf-row.error .wf-label { color: var(--err); font-weight: 600; }
	.wf-row.abandoned .wf-bar { opacity: 0.4; }
	.wf-row.abandoned .wf-label { color: var(--muted); opacity: 0.7; }
	.metrics-panel {
		margin: 0 0 18px;
		padding: 12px 14px;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
		gap: 12px;
		margin-top: 10px;
	}
	.metric-card {
		padding: 10px;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 6px;
		text-align: center;
	}
	.metric-label {
		font-size: var(--text-xs);
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 700;
		margin-bottom: 4px;
	}
	.metric-value {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--text);
		font-family: var(--mono);
	}
	.obs-filters {
		margin: 0 0 18px;
		padding: 12px 14px;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.filters-row {
		display: flex;
		gap: 8px;
		margin-top: 10px;
		flex-wrap: wrap;
	}
	.filter-input, .filter-select {
		font: inherit;
		padding: var(--ctrl-pad);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		color: var(--text);
		font-size: var(--text-sm);
		min-height: var(--ctrl-h);
		flex: 1;
		min-width: 120px;
	}
	.filter-input::placeholder { color: var(--muted); }
	.filter-btn {
		font: inherit;
		padding: var(--ctrl-pad);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--panel-2);
		color: var(--text);
		font-size: var(--text-sm);
		font-weight: 600;
		cursor: pointer;
		min-height: var(--ctrl-h);
		white-space: nowrap;
	}
	.filter-btn:hover { background: color-mix(in srgb, var(--accent) 15%, var(--panel-2)); }
	.chat-block { margin: 0 0 12px; display: flex; flex-direction: column; gap: 8px; }
	.chat-msg {
		padding: 10px 12px;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg);
		max-width: 920px;
	}
	.chat-msg .chat-role {
		display: block;
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		margin-bottom: 4px;
	}
	.chat-msg.user { border-left: 3px solid var(--accent); }
	.chat-msg.assistant { border-left: 3px solid var(--gen); }
	.chat-msg.system, .chat-msg.tool { border-left: 3px solid var(--tool); }
	.chat-msg .chat-body {
		white-space: pre-wrap;
		word-break: break-word;
		font-size: 0.86rem;
		line-height: 1.45;
	}
	.session-link, .back-link, .hdr-btn {
		font: inherit;
		background: var(--panel-2);
		border: 1px solid var(--border);
		color: var(--text);
		border-radius: var(--radius);
		padding: 6px 10px;
		min-height: var(--ctrl-h);
		cursor: pointer;
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.2;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.stat .session-link {
		min-height: 0;
		padding: 2px 8px;
		font-size: var(--text-xs);
		font-family: var(--mono);
		font-weight: 500;
	}
	.session-link:hover, .back-link:hover, .hdr-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.hdr-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-left: auto; align-items: center; }
	.meta-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0 0 14px;
	}
	.meta-chip {
		font-size: 0.72rem;
		font-family: var(--mono);
		padding: 3px 8px;
		border-radius: 6px;
		border: 1px solid var(--border);
		background: var(--panel);
		color: var(--muted);
	}
	.meta-chip b { color: var(--text); font-weight: 600; }
	details.meta-all { margin: 0 0 14px; }
	details.meta-all summary {
		cursor: pointer;
		color: var(--muted);
		font-size: 0.78rem;
		margin-bottom: 6px;
	}
	.replay-turn {
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--panel);
		padding: 14px 16px;
		margin-bottom: 12px;
		cursor: pointer;
	}
	.replay-turn:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
	.replay-turn-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 14px;
		align-items: center;
		margin-bottom: 10px;
		font-size: 0.78rem;
		color: var(--muted);
		font-family: var(--mono);
	}
	.replay-turn-meta strong { color: var(--text); font-family: var(--font); font-size: 0.95rem; }
	.session-item.is-active {
		background: rgba(78, 161, 243, 0.12);
		box-shadow: inset 3px 0 0 var(--accent);
	}
	.empty {
		padding: 40px 24px;
		text-align: center;
		color: var(--muted);
		display: grid;
		justify-items: center;
		gap: 8px;
	}
	.empty.compact { padding: 28px 16px; }
	.empty.detail-empty { padding-top: 18vh; }
	.empty-icon {
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
		border-radius: var(--radius);
		background: rgba(78, 161, 243, 0.08);
		color: var(--accent);
		margin-bottom: 2px;
	}
	.empty-icon svg { width: 1.05rem; height: 1.05rem; display: block; }
	.empty strong { display: block; color: var(--text); font-size: 1rem; margin: 0; line-height: 1.3; }
	.empty span, .empty:not(:has(strong)) { font-size: var(--text-sm); line-height: 1.45; max-width: 26rem; }
	.badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 3px 8px;
		border-radius: 999px;
		font-size: var(--text-xs);
		font-weight: 700;
		line-height: 1.2;
		border: 1px solid var(--border);
		background: var(--panel-2);
		white-space: nowrap;
	}
	.badge.running { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
	.feedback-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin: 0 0 16px;
		padding: 10px 12px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--panel);
	}
	.feedback-label {
		width: 100%;
		margin: 0;
		color: var(--muted);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.feedback-bar .fb-btn,
	.feedback-bar .fb-clear {
		min-height: var(--ctrl-h);
		padding: 6px 12px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--panel-2);
		color: var(--text);
		cursor: pointer;
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.2;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.feedback-bar .fb-btn[aria-pressed="true"] {
		border-color: var(--accent);
		background: rgba(78, 161, 243, 0.14);
		color: var(--accent);
	}
	.feedback-bar .fb-note {
		flex: 1 1 160px;
		min-width: 140px;
		min-height: var(--ctrl-h);
		padding: var(--ctrl-pad);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		color: var(--text);
		font-size: var(--text-sm);
		line-height: 1.2;
	}
	.feedback-bar .fb-clear {
		color: var(--muted);
	}
	.badge.ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 45%, var(--border)); }
	.badge.error { color: var(--err); border-color: color-mix(in srgb, var(--err) 45%, var(--border)); }
	.badge.abandoned { color: #d4a017; border-color: color-mix(in srgb, #d4a017 45%, var(--border)); }
	.obs, .obs-body pre, .preview-block, .chat-msg, .replay-turn, .meta-chip { border-radius: var(--radius); }
	.tree-title-wrap { margin: 0 0 10px; }
	.mono { font-family: var(--mono); }
	.muted { color: var(--muted); }
	.err-msg { color: var(--err); margin: 0 0 14px; }
	.warn-msg { color: #d4a017; margin: 0 0 14px; }

	/* Dashboard Panels */
	.dashboard-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 12px;
		margin-bottom: 20px;
	}
	.panel {
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 14px;
	}
	.panel-title {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--muted);
		margin: 0 0 8px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.panel-value {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}
	.panel-meta {
		font-size: var(--text-xs);
		color: var(--muted);
		margin-top: 4px;
	}

	/* Advanced Search */
	.search-bar {
		display: flex;
		gap: 8px;
		margin-bottom: 12px;
		grid-column: 1 / -1;
	}
	.search-bar input {
		flex: 1;
		min-height: var(--ctrl-h);
		padding: var(--ctrl-pad);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		color: var(--text);
		font-size: var(--text-sm);
	}
	.search-bar button {
		min-width: 80px;
		min-height: var(--ctrl-h);
		padding: var(--ctrl-pad);
		background: var(--accent);
		color: #041018;
		border: 0;
		border-radius: var(--radius);
		font-weight: 600;
		cursor: pointer;
	}

	/* Alert/Notification Panel */
	.alerts-panel {
		background: var(--panel-2);
		border-left: 3px solid var(--err);
		padding: 10px 12px;
		margin-bottom: 12px;
		border-radius: 4px;
	}
	.alerts-panel.warning {
		border-left-color: #d4a017;
	}
	.alert-item {
		display: flex;
		gap: 8px;
		font-size: var(--text-sm);
		color: var(--text);
		margin-bottom: 6px;
	}
	.alert-item:last-child {
		margin-bottom: 0;
	}
	.alert-icon {
		flex-shrink: 0;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--err);
		margin-top: 2px;
	}
	.alert-item.warning .alert-icon {
		background: #d4a017;
	}

	/* Charts & Graphs */
	.chart-container {
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 14px;
		margin-bottom: 12px;
		min-height: 200px;
		overflow: auto;
	}
	.chart-title {
		font-weight: 600;
		margin-bottom: 10px;
		font-size: var(--text-sm);
		color: var(--text);
	}
	.bar-chart {
		display: flex;
		align-items: flex-end;
		gap: 8px;
		height: 150px;
		margin-top: 10px;
	}
	.bar {
		flex: 1;
		background: var(--accent);
		border-radius: 4px 4px 0 0;
		min-height: 4px;
		opacity: 0.7;
		transition: opacity 0.2s;
	}
	.bar:hover {
		opacity: 1;
	}

	/* Tabs & Navigation */
	.tab-nav {
		display: flex;
		gap: 8px;
		border-bottom: 1px solid var(--border);
		margin-bottom: 12px;
	}
	.tab-btn {
		padding: 8px 12px;
		background: transparent;
		border: none;
		border-bottom: 2px solid transparent;
		color: var(--muted);
		cursor: pointer;
		font-size: var(--text-sm);
		font-weight: 500;
		transition: all 0.2s;
	}
	.tab-btn.active {
		color: var(--text);
		border-bottom-color: var(--accent);
	}
	.tab-btn:hover {
		color: var(--text);
	}

	/* Modal & Dialogs */
	.modal-overlay {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.5);
		z-index: 1000;
		align-items: center;
		justify-content: center;
	}
	.modal-overlay.active {
		display: flex;
	}
	.modal {
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 20px;
		max-width: 500px;
		width: 90%;
		max-height: 80vh;
		overflow: auto;
	}
	.modal-header {
		font-size: 1.1rem;
		font-weight: 600;
		margin-bottom: 14px;
	}
	.modal-footer {
		display: flex;
		gap: 8px;
		margin-top: 14px;
		justify-content: flex-end;
	}
	.modal-footer button {
		min-width: 80px;
		padding: 8px 12px;
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--text);
		border-radius: 4px;
		cursor: pointer;
		font-size: var(--text-sm);
	}
	.modal-footer button.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #041018;
		font-weight: 600;
	}

	/* Data Table */
	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-sm);
		margin-top: 10px;
	}
	.data-table th {
		text-align: left;
		padding: 8px;
		background: var(--panel-2);
		border-bottom: 1px solid var(--border);
		color: var(--muted);
		font-weight: 600;
		font-size: var(--text-xs);
		text-transform: uppercase;
	}
	.data-table td {
		padding: 8px;
		border-bottom: 1px solid var(--border);
		color: var(--text);
	}
	.data-table tr:hover {
		background: var(--panel-2);
	}

	/* Badges & Labels */
	.badge-inline {
		display: inline-block;
		padding: 3px 8px;
		background: var(--panel-2);
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.badge-inline.success {
		background: rgba(62, 207, 142, 0.15);
		color: var(--ok);
	}
	.badge-inline.error {
		background: rgba(240, 113, 120, 0.15);
		color: var(--err);
	}
	.badge-inline.warning {
		background: rgba(212, 160, 23, 0.15);
		color: #d4a017;
	}

	/* Loading & Empty States */
	.loading-spinner {
		display: inline-block;
		width: 14px;
		height: 14px;
		border: 2px solid var(--muted);
		border-top-color: var(--accent);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}
	@keyframes spin {
		to { transform: rotate(360deg); }
	}
	.empty-state {
		text-align: center;
		padding: 20px;
		color: var(--muted);
	}
	.empty-state-icon {
		font-size: 2rem;
		margin-bottom: 8px;
	}

	/* Feature tabs in detail pane */
	.feature-tab {
		animation: fadeIn 0.2s ease-in;
	}
	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	.filter-section {
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 12px;
		margin-bottom: 12px;
	}
	.search-bar {
		display: flex;
		gap: 8px;
		margin-bottom: 12px;
	}
	.search-bar input {
		flex: 1;
		min-height: var(--ctrl-h);
		padding: var(--ctrl-pad);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		color: var(--text);
		font-size: var(--text-sm);
	}
	.search-bar button {
		min-width: 100px;
		min-height: var(--ctrl-h);
		padding: var(--ctrl-pad);
		background: var(--accent);
		color: #041018;
		border: 0;
		border-radius: var(--radius);
		font-weight: 600;
		cursor: pointer;
		font-size: var(--text-sm);
	}
	.search-bar button:hover {
		filter: brightness(1.05);
	}

	</style>
</head>
<body>
	<div class="shell">
		<header class="top">
			<h1 class="brand"><span class="brand-mark">AF</span> AiFlight <span>local traces</span></h1>
			<div class="meta">Waterfall · sessions · replay</div>
			<div class="stats-bar" id="stats-bar" aria-label="Usage totals"></div>
		</header>
		<bx:output>#view()#</bx:output>
	</div>
	<script>
	(function () {
		const root = document.getElementById("observe-workspace");
		if (!root) return;

		const filtersAdvanced = document.getElementById("flight-filters-advanced");
		if (filtersAdvanced) {
			const advKeys = [
				"data-filter-model", "data-filter-userid", "data-filter-environment",
				"data-filter-obstype", "data-filter-minduration", "data-filter-maxduration",
				"data-filter-mincost", "data-filter-feedback"
			];
			const hasAdvanced = advKeys.some((k) => !!root.getAttribute(k))
				|| root.getAttribute("data-filter-tools") === "true"
				|| root.getAttribute("data-filter-errors") === "true";
			if (hasAdvanced) filtersAdvanced.open = true;
		}

		const listEl = document.getElementById("observe-list");
		const detailEl = document.getElementById("observe-detail");
		const liveEl = document.getElementById("observe-live");
		const pollSeconds = Number(root.getAttribute("data-poll-seconds") || "2");
		let selectedId = root.getAttribute("data-selected") || "";
		let selectedSessionId = "";
		let sessionsCache = [];
		let mode = "traces";
		let listFp = "";
		let detailContentFp = "";
		let detailMetaFp = "";
		let detailPollTimer = null;
		let anyRunning = false;
		let idleCycles = 0;
		let livePollTimer = null;
		let openSessionIds = new Set();
		let viewMode = "empty"; // empty | trace | session

		const esc = (v) => String(v ?? "")
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;");

		function formatWhen(raw) {
			if (!raw) return "-";
			const d = new Date(raw);
			if (Number.isNaN(d.getTime())) return String(raw);
			const diff = Date.now() - d.getTime();
			if (diff >= 0 && diff < 45000) return "just now";
			if (diff >= 0 && diff < 3600000) {
				const mins = Math.max(1, Math.round(diff / 60000));
				return mins === 1 ? "1 min ago" : mins + " min ago";
			}
			if (diff >= 0 && diff < 86400000) {
				return d.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit", second: "2-digit" });
			}
			const opts = { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" };
			if (d.getFullYear() !== new Date().getFullYear()) opts.year = "numeric";
			return d.toLocaleString(undefined, opts);
		}

		function formatDuration(ms) {
			const n = Number(ms) || 0;
			if (n < 1000) return n + " ms";
			if (n < 60000) return (n / 1000).toFixed(n < 10000 ? 1 : 0) + " s";
			return Math.floor(n / 60000) + "m " + Math.round((n % 60000) / 1000) + "s";
		}

		function liveDur(status, startTime, durationMs) {
			if (status === "running") {
				const start = parseMs(startTime);
				if (start != null) return formatDuration(Date.now() - start) + "…";
			}
			return formatDuration(durationMs);
		}

		function durSpan(status, startTime, durationMs) {
			return `<span class="live-dur" data-status="${esc(status || "")}" data-start="${esc(startTime || "")}" data-static="${Number(durationMs) || 0}">${esc(liveDur(status, startTime, durationMs))}</span>`;
		}

		function tickLiveDurations() {
			document.querySelectorAll('.live-dur[data-status="running"]').forEach((el) => {
				const start = parseMs(el.getAttribute("data-start"));
				if (start == null) return;
				el.textContent = formatDuration(Date.now() - start) + "…";
			});
		}

		function formatCost(usageOrCost) {
			let c = 0;
			if (typeof usageOrCost === "number") c = usageOrCost;
			else if (usageOrCost && typeof usageOrCost === "object") c = Number(usageOrCost.cost || 0);
			else c = Number(usageOrCost || 0);
			if (!c) return "";
			return c < 0.01 ? c.toFixed(6) : c.toFixed(4);
		}

		function rowCost(t) {
			if (t && t.cost !== "" && t.cost != null && Number(t.cost) > 0) return formatCost(Number(t.cost));
			return formatCost(t && t.usage);
		}

		function hydrateTimes(scope) {
			(scope || document).querySelectorAll("[data-when]").forEach((el) => {
				if (!el) return;
				const next = formatWhen(el.getAttribute("data-when") || "");
				if (el.textContent !== next) el.textContent = next;
			});
		}

		function buildListUrl() {
			const params = new URLSearchParams({ limit: "50" });
			const status = root.getAttribute("data-filter-status") || "";
			const q = root.getAttribute("data-filter-q") || "";
			if (status) params.set("status", status);
			if (q) params.set("q", q);
			if (root.getAttribute("data-filter-tools") === "true") params.set("hasTools", "true");
			if (root.getAttribute("data-filter-errors") === "true") params.set("hasErrors", "true");
			["model", "userId", "environment", "obsType", "minDurationMs", "maxDurationMs", "minCost", "feedback"].forEach((key) => {
				const map = {
					model: "data-filter-model",
					userId: "data-filter-userid",
					environment: "data-filter-environment",
					obsType: "data-filter-obstype",
					minDurationMs: "data-filter-minduration",
					maxDurationMs: "data-filter-maxduration",
					minCost: "data-filter-mincost",
					feedback: "data-filter-feedback"
				};
				const v = root.getAttribute(map[key]) || "";
				if (v) params.set(key, v);
			});
			return root.getAttribute("data-list-url") + "?" + params.toString();
		}

		function syncFiltersFromForm() {
			const form = document.getElementById("flight-filters");
			if (!form) return;
			const fd = new FormData(form);
			const set = (attr, name) => {
				const v = (fd.get(name) || "").toString().trim();
				root.setAttribute(attr, v);
			};
			set("data-filter-q", "q");
			set("data-filter-status", "status");
			set("data-filter-model", "model");
			set("data-filter-userid", "userId");
			set("data-filter-environment", "environment");
			set("data-filter-obstype", "obsType");
			set("data-filter-minduration", "minDurationMs");
			set("data-filter-maxduration", "maxDurationMs");
			set("data-filter-mincost", "minCost");
			set("data-filter-feedback", "feedback");
			root.setAttribute("data-filter-tools", form.querySelector('[name="hasTools"]')?.checked ? "true" : "");
			root.setAttribute("data-filter-errors", form.querySelector('[name="hasErrors"]')?.checked ? "true" : "");
			const url = new URL(location.href);
			["q", "status", "model", "userId", "environment", "obsType", "minDurationMs", "maxDurationMs", "minCost", "feedback", "hasTools", "hasErrors"].forEach((k) => url.searchParams.delete(k));
			const q = root.getAttribute("data-filter-q"); if (q) url.searchParams.set("q", q);
			const status = root.getAttribute("data-filter-status"); if (status) url.searchParams.set("status", status);
			const model = root.getAttribute("data-filter-model"); if (model) url.searchParams.set("model", model);
			const userId = root.getAttribute("data-filter-userid"); if (userId) url.searchParams.set("userId", userId);
			const environment = root.getAttribute("data-filter-environment"); if (environment) url.searchParams.set("environment", environment);
			const obsType = root.getAttribute("data-filter-obstype"); if (obsType) url.searchParams.set("obsType", obsType);
			const minD = root.getAttribute("data-filter-minduration"); if (minD) url.searchParams.set("minDurationMs", minD);
			const maxD = root.getAttribute("data-filter-maxduration"); if (maxD) url.searchParams.set("maxDurationMs", maxD);
			const minC = root.getAttribute("data-filter-mincost"); if (minC) url.searchParams.set("minCost", minC);
			const feedback = root.getAttribute("data-filter-feedback"); if (feedback) url.searchParams.set("feedback", feedback);
			if (root.getAttribute("data-filter-tools") === "true") url.searchParams.set("hasTools", "true");
			if (root.getAttribute("data-filter-errors") === "true") url.searchParams.set("hasErrors", "true");
			history.replaceState(null, "", url.pathname + url.search + location.hash);
		}

		function downloadJson(filename, data) {
			const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
			const a = document.createElement("a");
			a.href = URL.createObjectURL(blob);
			a.download = filename;
			a.click();
			URL.revokeObjectURL(a.href);
		}

		function downloadFile(filename, content, type) {
			const blob = new Blob([content], { type: type || "text/plain" });
			const a = document.createElement("a");
			a.href = URL.createObjectURL(blob);
			a.download = filename;
			a.click();
			URL.revokeObjectURL(a.href);
		}

		async function copyCurrentLink(btn) {
			const url = location.origin + location.pathname + location.search + location.hash;
			try {
				await navigator.clipboard.writeText(url);
				if (btn) {
					const prev = btn.textContent;
					btn.textContent = "Copied";
					setTimeout(() => { btn.textContent = prev; }, 1200);
				}
			} catch (e) {}
		}

		function metadataChips(meta) {
			if (!meta || typeof meta !== "object") return "";
			const entries = Object.keys(meta).filter((k) => {
				const v = meta[k];
				return v != null && (typeof v === "string" || typeof v === "number" || typeof v === "boolean");
			}).slice(0, 8);
			if (!entries.length) return "";
			const chips = entries.map((k) => `<span class="meta-chip"><b>${esc(k)}</b> ${esc(String(meta[k]).slice(0, 80))}</span>`).join("");
			const full = `<details class="meta-all"><summary>All metadata</summary><pre class="meta-block">${esc(JSON.stringify(meta, null, 2))}</pre></details>`;
			return `<div class="meta-chips">${chips}</div>${full}`;
		}

		function previewOf(t) {
			return String(t.outputPreview || t.inputPreview || "").replace(/\s+/g, " ").trim().slice(0, 120);
		}

		function fingerprint(rows, kind) {
			return kind + ":" + rows.map((t) => [t.id, t.status, t.totalTokens, t.traceCount || t.observationCount, t.endedAt || t.lastStartedAt, t.durationMs || 0, t.cost || "", (t.feedback && t.feedback.value) || "", (t.feedback && t.feedback.comment) || ""].join(":")).join("|");
		}

		function contentFingerprint(t) {
			if (!t || !t.id) return "";
			const obs = Array.isArray(t.observations) ? t.observations : [];
			return [
				t.id, t.errorMessage || "", t.outputPreview || "", t.sessionId || "",
				obs.map((o) => [
					o.id, o.type, o.name, o.parentObservationId || "",
					o.inputText || "", o.outputText || "", o.sourceEvent || "",
					JSON.stringify(o.usage || {}), JSON.stringify(o.payload || {})
				].join("\x1e")).join("|")
			].join("::");
		}

		function metaFingerprint(t) {
			if (!t || !t.id) return "";
			const obs = Array.isArray(t.observations) ? t.observations : [];
			const fb = t.feedback || {};
			return [
				t.status, t.totalTokens, t.promptTokens, t.completionTokens, t.durationMs, t.model, t.provider,
				fb.value || "", fb.comment || "",
				obs.map((o) => [o.id, o.status, o.durationMs, o.startTime].join(":")).join("|")
			].join("::");
		}

		function parseMs(raw) {
			const d = new Date(raw || "");
			return Number.isNaN(d.getTime()) ? null : d.getTime();
		}

		function parseMessages(raw) {
			if (raw == null) return null;
			let v = raw;
			if (typeof v === "string") {
				const s = v.trim();
				if (!s) return null;
				if (s[0] !== "[" && s[0] !== "{") return null;
				try { v = JSON.parse(s); } catch (e) { return null; }
			}
			if (Array.isArray(v)) {
				const msgs = v.filter((m) => m && typeof m === "object" && ("role" in m || "content" in m));
				return msgs.length ? msgs : null;
			}
			if (v && typeof v === "object" && ("role" in v || "content" in v)) return [v];
			return null;
		}

		function messageContent(m) {
			const c = m.content;
			if (typeof c === "string") return c;
			if (Array.isArray(c)) {
				return c.map((part) => {
					if (typeof part === "string") return part;
					if (part && typeof part === "object") return part.text || part.content || JSON.stringify(part);
					return "";
				}).join("\n");
			}
			if (c == null) return "";
			return typeof c === "object" ? JSON.stringify(c, null, 2) : String(c);
		}

		function renderIo(raw, scrollKey, cls) {
			const msgs = parseMessages(raw);
			if (msgs) {
				return `<div class="chat-block" data-scroll-key="${esc(scrollKey)}">${msgs.map((m) => {
					const role = String(m.role || "message").toLowerCase();
					return `<div class="chat-msg ${esc(role)}"><span class="chat-role">${esc(role)}</span><div class="chat-body">${esc(messageContent(m))}</div></div>`;
				}).join("")}</div>`;
			}
			const text = typeof raw === "string" ? raw : (raw == null ? "" : JSON.stringify(raw, null, 2));
			return `<pre class="${esc(cls || "io-block")}" data-scroll-key="${esc(scrollKey)}">${esc(text)}</pre>`;
		}

		function captureDetailUi() {
			const openObs = [];
			const openPayload = [];
			const openUsage = [];
			const preScroll = {};
			detailEl.querySelectorAll(".obs.open[data-obs-id]").forEach((el) => openObs.push(el.getAttribute("data-obs-id")));
			detailEl.querySelectorAll("details.payload[open]").forEach((el) => {
				const obs = el.closest("[data-obs-id]");
				if (obs) openPayload.push(obs.getAttribute("data-obs-id"));
			});
			detailEl.querySelectorAll("details.usage-block[open]").forEach((el) => {
				const obs = el.closest("[data-obs-id]");
				if (obs) openUsage.push(obs.getAttribute("data-obs-id"));
			});
			detailEl.querySelectorAll("pre[data-scroll-key]").forEach((el) => {
				preScroll[el.getAttribute("data-scroll-key")] = el.scrollTop;
			});
			return { pane: detailEl.scrollTop, openObs, openPayload, openUsage, preScroll };
		}

		function restoreDetailUi(state) {
			if (!state) return;
			state.openObs.forEach((id) => {
				const el = detailEl.querySelector('.obs[data-obs-id="' + CSS.escape(id) + '"]');
				if (el) el.classList.add("open");
			});
			(state.openPayload || []).forEach((id) => {
				const obs = detailEl.querySelector('.obs[data-obs-id="' + CSS.escape(id) + '"]');
				if (obs) {
					const d = obs.querySelector("details.payload");
					if (d) d.open = true;
				}
			});
			(state.openUsage || []).forEach((id) => {
				const obs = detailEl.querySelector('.obs[data-obs-id="' + CSS.escape(id) + '"]');
				if (obs) {
					const d = obs.querySelector("details.usage-block");
					if (d) d.open = true;
				}
			});
			Object.keys(state.preScroll || {}).forEach((key) => {
				const el = detailEl.querySelector('pre[data-scroll-key="' + CSS.escape(key) + '"]');
				if (el) el.scrollTop = state.preScroll[key];
			});
			detailEl.scrollTop = state.pane || 0;
		}

		function scheduleRestore(state) {
			if (!state) return;
			requestAnimationFrame(() => {
				restoreDetailUi(state);
				requestAnimationFrame(() => restoreDetailUi(state));
			});
		}

		function setHash(kind, id) {
			let next = "#";
			if (kind === "trace" && id) next = "#trace/" + encodeURIComponent(id);
			if (kind === "session" && id) next = "#session/" + encodeURIComponent(id);
			if (location.hash !== next) {
				history.replaceState(null, "", next === "#" ? location.pathname + location.search : next);
			}
		}

		function markActive() {
			listEl.querySelectorAll(".trace-item").forEach((btn) => {
				btn.classList.toggle("is-active", btn.getAttribute("data-id") === selectedId);
			});
			listEl.querySelectorAll(".session-item").forEach((btn) => {
				btn.classList.toggle("is-active", btn.getAttribute("data-session-toggle") === selectedSessionId && viewMode === "session");
			});
		}

		function rememberOpenSessions() {
			openSessionIds = new Set(
				Array.from(listEl.querySelectorAll(".session-block.is-open")).map((el) => el.getAttribute("data-session"))
			);
		}

		function restoreOpenSessions() {
			openSessionIds.forEach((id) => {
				const el = listEl.querySelector('.session-block[data-session="' + CSS.escape(id) + '"]');
				if (el) el.classList.add("is-open");
			});
		}

		function withListScroll(fn) {
			const top = listEl.scrollTop;
			rememberOpenSessions();
			fn();
			restoreOpenSessions();
			listEl.scrollTop = top;
			markActive();
		}

		function renderTraceButton(t) {
			const id = esc(t.id || "");
			const status = esc(t.status || "running");
			const started = esc(t.startedAt || "");
			const preview = esc(previewOf(t));
			const cost = rowCost(t);
			const hints = [];
			if (t.userId) hints.push("user " + t.userId);
			if (t.environment) hints.push(t.environment);
			if (t.feedback && t.feedback.value) hints.push("feedback:" + t.feedback.value);
			return `<button type="button" class="trace-item" role="option" data-id="${id}">
				<div class="trace-item-top">
					<strong>${esc(t.name || "trace")}</strong>
					<span class="badge ${status}">${status}</span>
				</div>
				<div class="trace-item-meta mono">
					<time class="when" data-when="${started}">${esc(formatWhen(t.startedAt))}</time>
					· ${durSpan(t.status, t.startedAt, t.durationMs)}
					· ${esc(t.totalTokens || 0)} tok
					${cost ? " · $" + esc(cost) : ""}
					· ${esc(t.observationCount || 0)} steps
				</div>
				${hints.length ? `<div class="trace-item-sub muted mono">${esc(hints.join(" · "))}</div>` : ""}
				<div class="trace-item-sub muted">${preview || esc(t.model || t.provider || "-")}</div>
			</button>`;
		}

		function renderTraces(traces) {
			withListScroll(() => {
				if (!traces.length) {
					listEl.innerHTML = '<div class="empty compact"><span class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-7 4 14 2-7h6"/></svg></span><strong>No traces yet</strong><span>Run a review - rows appear here live.</span></div>';
					return;
				}
				listEl.innerHTML = traces.map((t) => renderTraceButton(t)).join("");
				if (!selectedId && !selectedSessionId && traces[0]) selectTrace(traces[0].id, false);
			});
		}

		function renderSessions(sessions) {
			sessionsCache = sessions;
			withListScroll(() => {
				if (!sessions.length) {
					listEl.innerHTML = '<div class="empty compact"><span class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><strong>No sessions yet</strong><span>Traces with a shared request/conversation appear here.</span></div>';
					return;
				}
				listEl.innerHTML = sessions.map((s) => {
					const id = esc(s.id || "");
					const status = esc(s.status || "ok");
					const children = (s.traces || []).map((t) => renderTraceButton(t)).join("");
					return `<div class="session-block" data-session="${id}">
						<button type="button" class="session-item" data-session-toggle="${id}">
							<div class="session-top">
								<strong class="mono">${esc(String(s.id || "").slice(0, 8))}...</strong>
								<span class="badge ${status}">${status}</span>
							</div>
							<div class="session-meta mono">
								${esc(s.traceCount || 0)} traces · ${esc(s.totalTokens || 0)} tok ·
								<time data-when="${esc(s.lastStartedAt || "")}">${esc(formatWhen(s.lastStartedAt))}</time>
							</div>
						</button>
						<div class="session-children">${children}</div>
					</div>`;
				}).join("");
			});
		}

		function buildWaterfall(t) {
			const obs = Array.isArray(t.observations) ? t.observations : [];
			if (!obs.length) return "";

			// Build parent-child map for hierarchical rendering
			const byParent = {};
			const roots = [];
			obs.forEach((o) => {
				const pid = o.parentObservationId || "";
				if (!pid) roots.push(o);
				else {
					if (!byParent[pid]) byParent[pid] = [];
					byParent[pid].push(o);
				}
			});

			// Calculate timing
			const starts = obs.map((o) => parseMs(o.startTime)).filter((n) => n != null);
			const origin = parseMs(t.startedAt) ?? (starts.length ? Math.min(...starts) : Date.now());
			let end = origin + (Number(t.durationMs) || 0);
			obs.forEach((o) => {
				const s = parseMs(o.startTime) ?? origin;
				const e = s + (Number(o.durationMs) || 0);
				if (e > end) end = e;
			});
			const span = Math.max(1, end - origin);

			// Render observation bar recursively with hierarchy
			function rowHtml(o, depth) {
				const s = parseMs(o.startTime) ?? origin;
				const dur = Math.max(0, Number(o.durationMs) || 0);
				const left = Math.max(0, ((s - origin) / span) * 100);
				const width = Math.max(0.5, (dur / span) * 100);
				const type = esc(o.type || "event");
				const isError = o.status === "error";
				const cost = formatCost(o.usage);
				const indent = depth * 16;
				const tooltip = `${esc(o.name || o.type || "step")} (${durSpan(o.status, o.startTime, o.durationMs)})${cost ? ' · $' + esc(cost) : ''}`;
				const statusClass = isError ? " error" : (o.status === "abandoned" ? " abandoned" : "");

				const children = byParent[o.id] || [];
				const childHtml = children.map((c) => rowHtml(c, depth + 1)).join("");

				return `<div class="wf-row${statusClass}" data-wf-id="${esc(o.id || "")}" title="${esc(tooltip)}" data-depth="${depth}">
					<span class="wf-label" style="padding-left:${indent}px">${esc(o.name || o.type || "step")}</span>
					<span class="wf-track"><span class="wf-bar ${type}" style="left:${left}%;width:${Math.min(100 - left, width)}%"></span></span>
					<span class="wf-dur">${esc(formatDuration(dur))}</span>
				</div>${childHtml}`;
			}

			const list = roots.length ? roots : obs;
			const rows = list.map((o) => rowHtml(o, 0)).join("");

			return `<div class="waterfall"><div class="section-head"><div class="waterfall-title">Waterfall</div><p class="section-purpose">When each step ran and how long it took (hierarchical view)</p></div>${rows}</div>`;
		}

		function buildMetricsPanel(t) {
			const obsCount = Array.isArray(t.observations) ? t.observations.length : 0;
			const tokenBreakdown = t.observations ? t.observations.reduce((sum, o) => sum + (Number(o.usage?.totalTokens) || 0), 0) : 0;
			return `<div class="metrics-panel">
				<div class="section-head"><div class="section-title">Metrics</div></div>
				<div class="metrics-grid">
					<div class="metric-card">
						<div class="metric-label">Observations</div>
						<div class="metric-value">${esc(obsCount)}</div>
					</div>
					<div class="metric-card">
						<div class="metric-label">Total Duration</div>
						<div class="metric-value">${esc(formatDuration(Number(t.durationMs)))}</div>
					</div>
					<div class="metric-card">
						<div class="metric-label">Tokens</div>
						<div class="metric-value">${esc(Number(t.totalTokens || 0))}</div>
					</div>
					<div class="metric-card">
						<div class="metric-label">Cost</div>
						<div class="metric-value">$${esc(formatCost(t.usage) || Number(t.cost || 0))}</div>
					</div>
				</div>
			</div>`;
		}

		function buildObservationFilters(traceId) {
			return `<div class="obs-filters">
				<div class="section-head"><div class="section-title">Filter observations</div></div>
				<div class="filters-row">
					<input type="text" class="filter-input" placeholder="Search..." data-filter="search" aria-label="Search observations">
					<select class="filter-select" data-filter="type" aria-label="Observation type">
						<option value="">All types</option>
						<option value="generation">Generation</option>
						<option value="tool">Tool</option>
						<option value="span">Span</option>
						<option value="event">Event</option>
					</select>
					<select class="filter-select" data-filter="status" aria-label="Status">
						<option value="">All status</option>
						<option value="ok">OK</option>
						<option value="error">Error</option>
						<option value="running">Running</option>
					</select>
					<button class="filter-btn" data-filter-reset>Reset</button>
				</div>
			</div>`;
		}

		function buildTree(observations, preferredOpen) {
			const byParent = {};
			const roots = [];
			(observations || []).forEach((o) => {
				const pid = o.parentObservationId || "";
				if (!pid) roots.push(o);
				else {
					if (!byParent[pid]) byParent[pid] = [];
					byParent[pid].push(o);
				}
			});
			const restoring = Array.isArray(preferredOpen);
			const openSet = new Set(preferredOpen || []);
			function nodeHtml(o, depth, fallbackOpen) {
				const type = esc(o.type || "event");
				const kids = byParent[o.id] || [];
				const cost = formatCost(o.usage);
				const isOpen = restoring ? openSet.has(o.id) : fallbackOpen;
				let body = "";
				if (o.inputText) body += `<h4>Input</h4>${renderIo(o.inputText, o.id + ":in", "io-block")}`;
				if (o.outputText) body += `<h4>Output</h4>${renderIo(o.outputText, o.id + ":out", "io-block")}`;
				if (o.sourceEvent) body += `<p class="obs-source">Source <b data-scroll-key="${esc(o.id)}:src">${esc(o.sourceEvent)}</b></p>`;
				if (o.usage && typeof o.usage === "object" && Object.keys(o.usage).length) {
					body += `<details class="usage-block"><summary>Usage</summary><pre class="meta-block" data-scroll-key="${esc(o.id)}:usage">${esc(JSON.stringify(o.usage, null, 2))}</pre></details>`;
				}
				if (o.payload && typeof o.payload === "object" && Object.keys(o.payload).length) {
					body += `<details class="payload"><summary>Payload</summary><pre class="meta-block" data-scroll-key="${esc(o.id)}:payload">${esc(JSON.stringify(o.payload, null, 2))}</pre></details>`;
				}
				const childHtml = kids.map((c) => nodeHtml(c, depth + 1, false)).join("");
				return `<div class="obs${isOpen ? " open" : ""}" data-obs-id="${esc(o.id || "")}">
					<div class="obs-head">
						<span class="obs-type ${type}">${type}</span>
						<span class="obs-name" title="${esc(o.name || "")}">${esc(o.name || "")}</span>
						<span class="badge ${esc(o.status || "")}">${esc(o.status || "")}</span>
						<span class="obs-meta">${durSpan(o.status, o.startTime, o.durationMs)}${cost ? " · $" + esc(cost) : ""} · <time data-when="${esc(o.startTime || "")}">${esc(formatWhen(o.startTime))}</time></span>
					</div>
					<div class="obs-body">${body}</div>
					${childHtml ? `<div class="obs-children">${childHtml}</div>` : ""}
				</div>`;
			}
			const list = roots.length ? roots : observations;
			return list.map((o, i) => nodeHtml(o, 0, i === 0)).join("");
		}

		function patchDetailMeta(t) {
			const rootInner = detailEl.querySelector(".detail-inner");
			if (!rootInner) return false;
			const badge = rootInner.querySelector(".detail-head .badge");
			if (badge) {
				badge.textContent = t.status || "";
				badge.className = "badge " + (t.status || "");
			}
			const stats = rootInner.querySelector(".stats");
			if (stats) {
				const cost = formatCost((Array.isArray(t.observations) ? t.observations : []).find((o) => o.usage && o.usage.cost)?.usage || t.usage);
				stats.innerHTML = statsHtml(t, cost);
			}
			const wf = rootInner.querySelector(".waterfall");
			if (wf) wf.outerHTML = buildWaterfall(t);
			(Array.isArray(t.observations) ? t.observations : []).forEach((o) => {
				const node = detailEl.querySelector('.obs[data-obs-id="' + CSS.escape(o.id || "") + '"]');
				if (!node) return;
				const statusEl = node.querySelector(":scope > .obs-head .badge");
				if (statusEl) {
					statusEl.textContent = o.status || "";
					statusEl.className = "badge " + (o.status || "");
				}
				const metaEl = node.querySelector(":scope > .obs-head .obs-meta");
				if (metaEl) {
					const cost = formatCost(o.usage);
					metaEl.innerHTML = `${durSpan(o.status, o.startTime, o.durationMs)}${cost ? " · $" + esc(cost) : ""} · <time data-when="${esc(o.startTime || "")}">${esc(formatWhen(o.startTime))}</time>`;
				}
			});
			return true;
		}

		function patchDetailContent(t) {
			const obs = Array.isArray(t.observations) ? t.observations : [];
			const byId = {};
			detailEl.querySelectorAll(".obs[data-obs-id]").forEach((el) => {
				byId[el.getAttribute("data-obs-id")] = el;
			});
			if (Object.keys(byId).length !== obs.length) return false;
			for (let i = 0; i < obs.length; i++) {
				if (!byId[obs[i].id]) return false;
			}
			for (let i = 0; i < obs.length; i++) {
				const o = obs[i];
				const node = byId[o.id];
				const pairs = [
					[":usage", o.usage && Object.keys(o.usage).length ? JSON.stringify(o.usage, null, 2) : null],
					[":payload", o.payload && Object.keys(o.payload).length ? JSON.stringify(o.payload, null, 2) : null]
				];
				const srcEl = node.querySelector('[data-scroll-key="' + CSS.escape(o.id + ":src") + '"]');
				if (o.sourceEvent && srcEl && srcEl.textContent !== o.sourceEvent) srcEl.textContent = o.sourceEvent;
				const kinds = ["in", "out"];
				for (let k = 0; k < kinds.length; k++) {
					const kind = kinds[k];
					const key = o.id + ":" + kind;
					const val = kind === "in" ? o.inputText : o.outputText;
					if (val == null || val === "") continue;
					if (parseMessages(val)) {
						const chat = node.querySelector('.chat-block[data-scroll-key="' + CSS.escape(key) + '"]');
						if (!chat) return false;
						continue;
					}
					const pre = node.querySelector('pre[data-scroll-key="' + CSS.escape(key) + '"]');
					if (!pre) return false;
					const top = pre.scrollTop;
					if (pre.textContent !== val) {
						pre.textContent = val;
						pre.scrollTop = top;
					}
				}
				for (let p = 0; p < pairs.length; p++) {
					const key = o.id + pairs[p][0];
					const val = pairs[p][1];
					const el = node.querySelector('pre[data-scroll-key="' + CSS.escape(key) + '"]');
					if (val == null) {
						if (el) return false;
						continue;
					}
					if (!el) return false;
					const top = el.scrollTop;
					if (el.textContent !== val) {
						el.textContent = val;
						el.scrollTop = top;
					}
				}
			}
			return true;
		}

		function statsHtml(t, cost) {
			return `
				<div class="stat"><span>Started</span><b><time data-when="${esc(t.startedAt || "")}">${esc(formatWhen(t.startedAt))}</time></b></div>
				<div class="stat"><span>Duration</span><b>${durSpan(t.status, t.startedAt, t.durationMs)}</b></div>
				<div class="stat"><span>Tokens</span><b>${esc(t.totalTokens || 0)} <span class="muted">(p ${esc(t.promptTokens || 0)} / c ${esc(t.completionTokens || 0)})</span></b></div>
				${cost ? `<div class="stat"><span>Cost</span><b>$${esc(cost)}</b></div>` : ""}
				<div class="stat"><span>Model</span><b class="mono">${esc(t.model || "-")}</b></div>
				<div class="stat"><span>Provider</span><b class="mono">${esc(t.provider || "-")}</b></div>
				${t.environment ? `<div class="stat"><span>Env</span><b class="mono">${esc(t.environment)}</b></div>` : ""}
				${t.userId ? `<div class="stat"><span>User</span><b class="mono">${esc(t.userId)}</b></div>` : ""}
				${t.sessionId ? `<div class="stat"><span>Session</span><b><button type="button" class="session-link" data-open-session="${esc(t.sessionId)}">${esc(String(t.sessionId).slice(0, 8))}...</button></b></div>` : ""}
			`;
		}

		function headerActions(kind, id) {
			return `<div class="hdr-actions">
				<button type="button" class="hdr-btn" data-copy-link>Copy link</button>
				<button type="button" class="hdr-btn" data-export="${esc(kind)}" data-export-id="${esc(id || "")}">Export</button>
			</div>`;
		}

		function renderDetail(t, opts) {
			opts = opts || {};
			viewMode = "trace";
			const cFp = contentFingerprint(t);
			const mFp = metaFingerprint(t);
			if (!opts.force && cFp && cFp === detailContentFp && detailEl.querySelector(".detail-inner")) {
				if (mFp !== detailMetaFp) {
					patchDetailMeta(t);
					detailMetaFp = mFp;
				} else {
					hydrateTimes(detailEl);
				}
				return;
			}
			if (!opts.force && detailContentFp && cFp !== detailContentFp && detailEl.querySelector(".detail-inner")) {
				const patched = patchDetailContent(t);
				if (patched !== false && patched) {
					detailContentFp = cFp;
					if (mFp !== detailMetaFp) {
						patchDetailMeta(t);
						detailMetaFp = mFp;
					}
					return;
				}
			}
			const ui = opts.preserve ? captureDetailUi() : null;
			if (!t || !t.id) {
				detailContentFp = "";
				detailMetaFp = "";
				viewMode = "empty";
				detailEl.innerHTML = '<div class="empty detail-empty"><span class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg></span><strong>Select a trace</strong><span>Click a row on the left to inspect the nested timeline - no page change.</span></div>';
				return;
			}
			const obs = Array.isArray(t.observations) ? t.observations : [];
			const cost = formatCost(obs.find((o) => o.usage && o.usage.cost)?.usage || t.usage) || rowCost(t);
			const preferredOpen = ui ? ui.openObs : null;
			const hasObsOutput = obs.some((o) => !!(o.outputText || o.inputText));
			const showPreview = !!(t.outputPreview && !hasObsOutput);
			const back = selectedSessionId
				? `<button type="button" class="back-link" data-back-session="${esc(selectedSessionId)}"><- Session</button>`
				: "";
			const fb = t.feedback || null;
			const fbVal = fb && fb.value ? String(fb.value) : "";
			const fbNote = fb && fb.comment ? String(fb.comment) : "";
			const feedbackBar = `<div class="feedback-bar" data-trace-id="${esc(t.id)}">
				<p class="feedback-label">Trace feedback</p>
				<button type="button" class="fb-btn" data-fb="up" aria-pressed="${fbVal === "up" ? "true" : "false"}">Up</button>
				<button type="button" class="fb-btn" data-fb="down" aria-pressed="${fbVal === "down" ? "true" : "false"}">Down</button>
				<input type="text" class="fb-note" placeholder="Note (optional)" value="${esc(fbNote)}">
				<button type="button" class="fb-clear"${fbVal ? "" : " disabled"}>Clear</button>
			</div>`;
			detailEl.innerHTML = `<div class="detail-inner">
				<div class="detail-head">
					${back}
					<h2>${esc(t.name || "Trace")}</h2>
					<span class="badge ${esc(t.status || "")}">${esc(t.status || "")}</span>
					${headerActions("trace", t.id)}
				</div>
				${t.errorMessage ? `<p class="${t.status === "abandoned" ? "warn-msg" : "err-msg"}">${esc(t.errorMessage)}</p>` : ""}
				<div class="stats">${statsHtml(t, cost)}</div>
				${feedbackBar}
				${metadataChips(t.metadata)}
				${buildWaterfall(t)}
				${buildMetricsPanel(t)}
				${buildObservationFilters(t.id)}
				${showPreview ? `<div class="section-head"><div class="section-title">Output preview</div></div>${renderIo(t.outputPreview, "preview", "preview-block")}` : ""}
				<div class="tree">
					<div class="section-head tree-title-wrap"><div class="section-title">Observation tree</div><p class="section-purpose">Nested generations, tools, spans, and events for this trace</p></div>
					${obs.length ? buildTree(obs, preferredOpen) : '<div class="empty compact"><span class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 6h16M4 12h10M4 18h7"/></svg></span><strong>No steps yet</strong><span>Waiting for observations...</span></div>'}
				</div>
				<div style="margin-top: 20px;">
					<div class="tab-nav">
						<button class="tab-btn active" onclick="switchFeatureTab(event, 'cost')">💰 Cost</button>
						<button class="tab-btn" onclick="switchFeatureTab(event, 'anomalies')">🚨 Anomalies</button>
						<button class="tab-btn" onclick="switchFeatureTab(event, 'benchmarks')">📈 Benchmarks</button>
						<button class="tab-btn" onclick="switchFeatureTab(event, 'datasets')">📦 Datasets</button>
						<button class="tab-btn" onclick="switchFeatureTab(event, 'abtests')">🧪 A/B Tests</button>
						<button class="tab-btn" onclick="switchFeatureTab(event, 'quality')">✓ Quality</button>
						<button class="tab-btn" onclick="switchFeatureTab(event, 'notifications')">🔔 Alerts</button>
					</div>
					<div id="featureTabs" style="margin-top: 12px;">
						<div id="cost-tab" class="feature-tab" style="display: block;">
							${buildCostAnalyticsPanel()}
						</div>
						<div id="anomalies-tab" class="feature-tab" style="display: none;">
							${buildAnomalyPanel()}
						</div>
						<div id="benchmarks-tab" class="feature-tab" style="display: none;">
							${buildBenchmarkingPanel()}
						</div>
						<div id="datasets-tab" class="feature-tab" style="display: none;">
							${buildDatasetPanel()}
						</div>
						<div id="abtests-tab" class="feature-tab" style="display: none;">
							${buildABTestingPanel()}
						</div>
						<div id="quality-tab" class="feature-tab" style="display: none;">
							${buildDataQualityPanel()}
						</div>
						<div id="notifications-tab" class="feature-tab" style="display: none;">
							${buildNotificationPanel()}
						</div>
					</div>
				</div>
			</div>`;
			detailContentFp = cFp;
			detailMetaFp = mFp;
			if (ui) scheduleRestore(ui);
		}

		function renderSessionReplay(session) {
			viewMode = "session";
			selectedSessionId = session.id || selectedSessionId;
			selectedId = "";
			detailContentFp = "";
			detailMetaFp = "";
			if (detailPollTimer) {
				clearInterval(detailPollTimer);
				detailPollTimer = null;
			}
			const traces = (session.traces || []).slice().sort((a, b) => {
				const ta = parseMs(a.startedAt) || 0;
				const tb = parseMs(b.startedAt) || 0;
				return ta - tb;
			});
			const turns = traces.map((t) => {
				const cost = rowCost(t);
				const user = t.inputPreview || "";
				const assistant = t.outputPreview || "";
				return `<div class="replay-turn" data-id="${esc(t.id || "")}">
					<div class="replay-turn-meta">
						<strong>${esc(t.name || "trace")}</strong>
						<span class="badge ${esc(t.status || "")}">${esc(t.status || "")}</span>
						<span>${durSpan(t.status, t.startedAt, t.durationMs)}</span>
						<span>${esc(t.totalTokens || 0)} tok</span>
						${cost ? `<span>$${esc(cost)}</span>` : ""}
						<span><time data-when="${esc(t.startedAt || "")}">${esc(formatWhen(t.startedAt))}</time></span>
					</div>
					${user ? `<div class="chat-msg user"><span class="chat-role">user</span><div class="chat-body">${esc(user)}</div></div>` : ""}
					${assistant ? `<div class="chat-msg assistant" style="margin-top:8px"><span class="chat-role">assistant</span><div class="chat-body">${esc(assistant)}</div></div>` : (!user ? '<div class="muted">No preview</div>' : "")}
				</div>`;
			}).join("");
			detailEl.innerHTML = `<div class="detail-inner">
				<div class="detail-head">
					<h2>Session ${esc(String(session.id || "").slice(0, 8))}...</h2>
					<span class="badge ${esc(session.status || "")}">${esc(session.status || "")}</span>
					${headerActions("session", session.id)}
				</div>
				<div class="stats">
					<div class="stat"><span>Traces</span><b>${esc(session.traceCount || traces.length)}</b></div>
					<div class="stat"><span>Tokens</span><b>${esc(session.totalTokens || 0)}</b></div>
					<div class="stat"><span>Last</span><b><time data-when="${esc(session.lastStartedAt || "")}">${esc(formatWhen(session.lastStartedAt))}</time></b></div>
				</div>
				${turns || '<div class="empty compact"><span class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><strong>Empty session</strong><span>No traces in this session yet.</span></div>'}
			</div>`;
			markActive();
		}

		async function loadDetail(id) {
			const base = root.getAttribute("data-detail-url") || "/aiflight/api/trace/";
			const res = await fetch(base + encodeURIComponent(id), { headers: { Accept: "application/json" } });
			if (!res.ok) throw new Error("detail failed");
			return res.json();
		}

		async function selectTrace(id, updateHash = true) {
			if (!id) return;
			const same = selectedId === id && viewMode === "trace" && detailEl.querySelector(".detail-inner");
			selectedId = id;
			markActive();
			if (updateHash) setHash("trace", id);
			if (!same) {
				detailContentFp = "";
				detailMetaFp = "";
				detailEl.innerHTML = '<div class="empty compact"><span class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="4"/></svg></span><strong>Loading trace</strong><span>Fetching waterfall and observations...</span></div>';
			}
			try {
				const data = await loadDetail(id);
				if (selectedId !== id) return;
				if (data.sessionId) selectedSessionId = data.sessionId;
				renderDetail(data, { force: !same, preserve: same });
				scheduleDetailPoll(data);
			} catch (e) {
				if (!same) detailEl.innerHTML = '<div class="empty compact"><span class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg></span><strong>Could not load trace</strong><span>Try another row.</span></div>';
			}
		}

		function selectSession(id, updateHash = true) {
			if (!id) return;
			selectedSessionId = id;
			openSessionIds.add(id);
			const block = listEl.querySelector('.session-block[data-session="' + CSS.escape(id) + '"]');
			if (block) block.classList.add("is-open");
			let session = sessionsCache.find((s) => s.id === id);
			if (!session && block) {
				session = { id, traces: [], traceCount: 0, status: "ok" };
			}
			if (updateHash) setHash("session", id);
			if (session) renderSessionReplay(session);
			else {
				fetch((root.getAttribute("data-sessions-url") || "/aiflight/api/sessions") + "?limit=50", { headers: { Accept: "application/json" } })
					.then((r) => r.json())
					.then((data) => {
						sessionsCache = Array.isArray(data.sessions) ? data.sessions : [];
						const s = sessionsCache.find((x) => x.id === id);
						if (s) renderSessionReplay(s);
					})
					.catch(() => {});
			}
			markActive();
		}

		function scheduleDetailPoll(data) {
			if (detailPollTimer) clearInterval(detailPollTimer);
			detailPollTimer = null;
			if (!data || data.status !== "running" || pollSeconds < 1) return;
			detailPollTimer = setInterval(async () => {
				if (!selectedId || viewMode !== "trace") return;
				try {
					const fresh = await loadDetail(selectedId);
					if (selectedId !== fresh.id) return;
					renderDetail(fresh, { preserve: true });
					if (fresh.status !== "running") {
						clearInterval(detailPollTimer);
						detailPollTimer = null;
					}
				} catch (e) {}
			}, pollSeconds * 1000);
		}

		listEl.addEventListener("click", (ev) => {
			const toggle = ev.target.closest("[data-session-toggle]");
			if (toggle) {
				const sid = toggle.getAttribute("data-session-toggle");
				const block = toggle.closest(".session-block");
				if (block) {
					const opening = !block.classList.contains("is-open");
					block.classList.toggle("is-open", opening);
					rememberOpenSessions();
					if (opening) selectSession(sid, true);
				}
				return;
			}
			const btn = ev.target.closest(".trace-item");
			if (!btn) return;
			selectTrace(btn.getAttribute("data-id"), true);
		});

		async function saveTraceFeedback(traceId, value, comment) {
			const base = (root.getAttribute("data-detail-url") || "/aiflight/api/trace/") + encodeURIComponent(traceId) + "/feedback";
			const res = await fetch(base, {
				method: "PUT",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify({ value: value, comment: comment || "" })
			});
			if (!res.ok) throw new Error("feedback save failed");
			return res.json();
		}

		async function clearTraceFeedback(traceId) {
			const base = (root.getAttribute("data-detail-url") || "/aiflight/api/trace/") + encodeURIComponent(traceId) + "/feedback";
			const res = await fetch(base, { method: "DELETE", headers: { Accept: "application/json" } });
			if (!res.ok && res.status !== 204) throw new Error("feedback clear failed");
		}

		detailEl.addEventListener("click", (ev) => {
			const copyBtn = ev.target.closest("[data-copy-link]");
			if (copyBtn) {
				copyCurrentLink(copyBtn);
				return;
			}
			const fbBtn = ev.target.closest("[data-fb]");
			if (fbBtn) {
				const bar = fbBtn.closest(".feedback-bar");
				const tid = bar && bar.getAttribute("data-trace-id");
				const value = fbBtn.getAttribute("data-fb");
				const note = bar ? (bar.querySelector(".fb-note")?.value || "") : "";
				if (!tid || !value) return;
				(async () => {
					try {
						await saveTraceFeedback(tid, value, note);
						const fresh = await loadDetail(tid);
						renderDetail(fresh, { force: true, preserve: true });
						pollList();
					} catch (e) {}
				})();
				return;
			}
			const clearBtn = ev.target.closest(".fb-clear");
			if (clearBtn) {
				const bar = clearBtn.closest(".feedback-bar");
				const tid = bar && bar.getAttribute("data-trace-id");
				if (!tid) return;
				(async () => {
					try {
						await clearTraceFeedback(tid);
						const fresh = await loadDetail(tid);
						renderDetail(fresh, { force: true, preserve: true });
						pollList();
					} catch (e) {}
				})();
				return;
			}
			const exp = ev.target.closest("[data-export]");
			if (exp) {
				const kind = exp.getAttribute("data-export");
				const eid = exp.getAttribute("data-export-id") || "";
				(async () => {
					try {
						if (kind === "trace") {
							const tid = eid || selectedId;
							// Export as JSON from new API
							const res = await fetch(`/aiflight/api/trace/${encodeURIComponent(tid)}/export?format=json`);
							if (!res.ok) throw new Error("export failed");
							const data = await res.text();
							downloadFile("ai-flight-trace-" + tid.slice(0, 8) + ".json", data, "application/json");
						} else if (kind === "session") {
							const base = root.getAttribute("data-session-url") || "/aiflight/api/session/";
							const res = await fetch(base + encodeURIComponent(eid || selectedSessionId), { headers: { Accept: "application/json" } });
							if (!res.ok) throw new Error("session export failed");
							const data = await res.json();
							downloadJson("ai-flight-session-" + (data.id || eid).slice(0, 8) + ".json", data);
						}
					} catch (e) {
						console.error("export error:", e);
					}
				})();
				return;
			}
			const back = ev.target.closest("[data-back-session]");
			if (back) {
				selectSession(back.getAttribute("data-back-session"), true);
				return;
			}
			const sess = ev.target.closest("[data-open-session]");
			if (sess) {
				mode = "sessions";
				document.querySelectorAll(".mode-tab").forEach((t) => {
					const on = t.getAttribute("data-mode") === "sessions";
					t.classList.toggle("is-active", on);
					t.setAttribute("aria-selected", on ? "true" : "false");
				});
				listFp = "";
				pollList().then(() => selectSession(sess.getAttribute("data-open-session"), true));
				return;
			}
			const filterReset = ev.target.closest("[data-filter-reset]");
			if (filterReset) {
				detailEl.querySelectorAll(".filter-input, .filter-select").forEach((inp) => {
					inp.value = "";
				});
				return;
			}
			const turn = ev.target.closest(".replay-turn");
			if (turn) {
				selectTrace(turn.getAttribute("data-id"), true);
				return;
			}
			const wf = ev.target.closest("[data-wf-id]");
			if (wf) {
				const id = wf.getAttribute("data-wf-id");
				const obs = detailEl.querySelector('.obs[data-obs-id="' + CSS.escape(id) + '"]');
				if (obs) {
					obs.classList.add("open");
					obs.scrollIntoView({ block: "nearest" });
				}
				return;
			}
			const head = ev.target.closest(".obs-head");
			if (!head) return;
			head.parentElement.classList.toggle("open");
		});

		detailEl.addEventListener("change", (ev) => {
			const note = ev.target.closest(".fb-note");
			if (!note) return;
			const bar = note.closest(".feedback-bar");
			const tid = bar && bar.getAttribute("data-trace-id");
			const active = bar && bar.querySelector('.fb-btn[aria-pressed="true"]');
			const value = active && active.getAttribute("data-fb");
			if (!tid || !value) return;
			(async () => {
				try {
					await saveTraceFeedback(tid, value, note.value || "");
					const fresh = await loadDetail(tid);
					renderDetail(fresh, { force: true, preserve: true });
					pollList();
				} catch (e) {}
			})();
		});

		document.querySelectorAll(".mode-tab").forEach((tab) => {
			tab.addEventListener("click", () => {
				mode = tab.getAttribute("data-mode") || "traces";
				document.querySelectorAll(".mode-tab").forEach((t) => {
					const on = t === tab;
					t.classList.toggle("is-active", on);
					t.setAttribute("aria-selected", on ? "true" : "false");
				});
				listFp = "";
				pollList();
			});
		});

		let statsFp = "";
		async function pollStats() {
			try {
				const res = await fetch("/aiflight/api/stats", { headers: { Accept: "application/json" } });
				if (!res.ok) return;
				const s = await res.json();
				const fp = [s.traceCount, s.totalTokens, s.totalCost, s.todayTraceCount, s.todayTokens, s.todayCost, s.errorCount].join(":");
				if (fp === statsFp) return;
				statsFp = fp;
				const bar = document.getElementById("stats-bar");
				if (!bar) return;
				const todayCost = formatCost(s.todayCost);
				const totalCost = formatCost(s.totalCost);
				bar.innerHTML = `
					<span class="stat-chip">Today <b>${esc(s.todayTraceCount || 0)}</b> traces${todayCost ? ` · <b>$${esc(todayCost)}</b>` : ""}</span>
					<span class="stat-chip">All-time <b>${esc(s.traceCount || 0)}</b> traces${totalCost ? ` · <b>$${esc(totalCost)}</b>` : ""}</span>
					${s.errorCount ? `<span class="stat-chip">${esc(s.errorCount)} error${s.errorCount === 1 ? "" : "s"}</span>` : ""}
				`;
			} catch (e) {

			}
		}

		async function pollList() {
			try {
				if (mode === "sessions") {
					const res = await fetch((root.getAttribute("data-sessions-url") || "/aiflight/api/sessions") + "?limit=50", { headers: { Accept: "application/json" } });
					if (!res.ok) throw new Error("sessions failed");
					const data = await res.json();
					const rows = Array.isArray(data.sessions) ? data.sessions : [];
					anyRunning = rows.some((s) => s.status === "running" || (s.traces || []).some((t) => t.status === "running"));
					const fp = fingerprint(rows, "sessions");
					if (fp !== listFp) {
						listFp = fp;
						renderSessions(rows);
						if (viewMode === "session" && selectedSessionId) {
							const s = rows.find((x) => x.id === selectedSessionId);
							if (s) renderSessionReplay(s);
						}
					} else {
						hydrateTimes(listEl);
					}
				} else {
					const res = await fetch(buildListUrl(), { headers: { Accept: "application/json" } });
					if (!res.ok) throw new Error("list failed");
					const data = await res.json();
					const rows = Array.isArray(data.traces) ? data.traces : [];
					anyRunning = rows.some((t) => t.status === "running");
					const fp = fingerprint(rows, "traces");
					if (fp !== listFp) {
						listFp = fp;
						renderTraces(rows);
					} else {
						hydrateTimes(listEl);
					}
				}
				if (liveEl) liveEl.classList.remove("stale");
			} catch (e) {
				if (liveEl) liveEl.classList.add("stale");
			}
		}

		function idFromHash() {
			const m = location.hash.match(/^#(trace|session)\/([^/]+)/);
			if (!m) return null;
			return { kind: m[1], id: decodeURIComponent(m[2]) };
		}

		hydrateTimes(listEl);
		const hash = idFromHash();
		if (hash && hash.kind === "session") {
			mode = "sessions";
			document.querySelectorAll(".mode-tab").forEach((t) => {
				const on = t.getAttribute("data-mode") === "sessions";
				t.classList.toggle("is-active", on);
				t.setAttribute("aria-selected", on ? "true" : "false");
			});
			pollList().then(() => selectSession(hash.id, false));
		} else if (hash && hash.kind === "trace") {
			selectedId = hash.id;
			markActive();
			selectTrace(hash.id, false);
		} else if (selectedId) {
			selectTrace(selectedId, true);
		} else {
			const first = listEl.querySelector(".trace-item");
			if (first) selectTrace(first.getAttribute("data-id"), true);
		}

		pollStats();
		// Poll at the configured cadence only while a trace/session is actually
		// running. Idle (nothing in flight) backs off up to 20s so an open
		// AiFlight tab does not hammer the backend indefinitely with no new data.
		async function livePollTick() {
			await Promise.all([pollList(), pollStats()]);
			idleCycles = anyRunning ? 0 : idleCycles + 1;
			const delayMs = anyRunning
				? pollSeconds * 1000
				: Math.min(pollSeconds * 1000 * (2 + idleCycles), 20000);
			livePollTimer = setTimeout(livePollTick, delayMs);
		}
		if (pollSeconds >= 1) {
			livePollTimer = setTimeout(livePollTick, pollSeconds * 1000);
		}
		setInterval(() => {
			hydrateTimes(listEl);
			hydrateTimes(detailEl);
		}, 30000);
		setInterval(tickLiveDurations, 1000);
		window.addEventListener("hashchange", () => {
			const h = idFromHash();
			if (!h) return;
			if (h.kind === "session" && h.id !== selectedSessionId) selectSession(h.id, false);
			else if (h.kind === "trace" && h.id !== selectedId) selectTrace(h.id, false);
		});

		// ============================================
		// Enhanced UI Components for aiFlight Features
		// ============================================

		function formatCurrency(value) {
			return new Intl.NumberFormat('en-US', {
				style: 'currency',
				currency: 'USD',
				minimumFractionDigits: 2,
				maximumFractionDigits: 2
			}).format(value);
		}

		function formatNumber(value) {
			return new Intl.NumberFormat('en-US').format(Math.round(value));
		}

		function formatPercent(value) {
			return (Math.round(value * 100) / 100).toFixed(2) + '%';
		}

		// F5: Advanced Filtering UI
		function buildAdvancedFilterPanel() {
			const html = `
				<div class="filter-section">
					<div class="panel-title">Advanced Filters</div>
					<div class="search-bar">
						<input type="text" id="filterSearch" placeholder="Search filters..." />
						<button onclick="applyAdvancedFilters()">Apply</button>
					</div>
					<div class="data-table">
						<table class="data-table">
							<thead>
								<tr>
									<th>Name</th>
									<th>Type</th>
									<th>Action</th>
								</tr>
							</thead>
							<tbody id="savedFiltersBody">
								<!-- Populated by loadSavedFilters() -->
							</tbody>
						</table>
					</div>
				</div>
			`;
			return html;
		}

		async function applyAdvancedFilters() {
			try {
				const q = document.getElementById("filterSearch")?.value || "";
				const res = await fetch(`/aiflight/api/filters/list?search=${encodeURIComponent(q)}`);
				if (!res.ok) return;
				const data = await res.json();
				const tbody = document.getElementById("savedFiltersBody");
				if (!tbody) return;
				tbody.innerHTML = (data.filters || []).map(f => `
					<tr>
						<td><strong>${esc(f.name)}</strong></td>
						<td><span class="badge-inline">${esc(f.type || "custom")}</span></td>
						<td><button onclick="loadFilterAndApply('${esc(f.id)}')">Load</button></td>
					</tr>
				`).join("");
			} catch (e) {
				console.error("Filter apply error", e);
			}
		}

		// F1: Cost Analytics Dashboard
		function buildCostAnalyticsPanel() {
			const html = `
				<div class="dashboard-grid">
					<div class="panel">
						<p class="panel-title">Total Cost Today</p>
						<p class="panel-value" id="costToday">$0.00</p>
						<p class="panel-meta" id="costTodayTrend">—</p>
					</div>
					<div class="panel">
						<p class="panel-title">Cost per Request</p>
						<p class="panel-value" id="costPerReq">$0.00</p>
						<p class="panel-meta">Average</p>
					</div>
					<div class="panel">
						<p class="panel-title">Top Model</p>
						<p class="panel-value" id="topModel">—</p>
						<p class="panel-meta" id="topModelCost">—</p>
					</div>
				</div>
				<div class="chart-container">
					<div class="chart-title">Cost Trend (7 Days)</div>
					<div class="bar-chart" id="costTrendChart"></div>
				</div>
				<div class="panel">
					<p class="panel-title">Budget Status</p>
					<div id="budgetStatus"></div>
				</div>
			`;
			return html;
		}

		async function loadCostAnalytics() {
			try {
				const res = await fetch("/aiflight/api/cost-analytics?period=day");
				if (!res.ok) return;
				const data = await res.json();

				document.getElementById("costToday").textContent = formatCurrency(data.todayTotal || 0);
				document.getElementById("costPerReq").textContent = formatCurrency(data.avgCostPerRequest || 0);
				document.getElementById("topModel").textContent = data.topModel || "—";
				document.getElementById("topModelCost").textContent = formatCurrency(data.topModelCost || 0);

				// Cost trend chart
				const chart = document.getElementById("costTrendChart");
				if (chart && data.dailyTrend) {
					const maxCost = Math.max(...(data.dailyTrend || []));
					chart.innerHTML = data.dailyTrend.map((cost, i) => {
						const height = maxCost > 0 ? (cost / maxCost) * 150 : 10;
						return `<div class="bar" style="height: ${height}px;" title="$${esc(cost.toFixed(2))}"></div>`;
					}).join("");
				}

				// Budget status
				const budgetEl = document.getElementById("budgetStatus");
				if (budgetEl && data.budget) {
					const usage = (data.monthlySpend / data.budget.monthlyLimit) * 100;
					budgetEl.innerHTML = `
						<div style="margin-bottom: 8px;">
							<div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
								<span style="font-size: var(--text-sm);">${formatCurrency(data.monthlySpend || 0)} / ${formatCurrency(data.budget.monthlyLimit)}</span>
								<span class="badge-inline ${usage > 80 ? 'warning' : 'success'}">${formatPercent(usage)}</span>
							</div>
							<div style="height: 4px; background: var(--panel-2); border-radius: 2px; overflow: hidden;">
								<div style="height: 100%; width: ${usage}%; background: ${usage > 80 ? '#d4a017' : 'var(--ok)'}; border-radius: 2px;"></div>
							</div>
						</div>
					`;
				}
			} catch (e) {
				console.error("Cost analytics error", e);
			}
		}

		// F2: Anomaly Detection
		function buildAnomalyPanel() {
			const html = `
				<div class="alerts-panel">
					<div class="alert-item">
						<div class="alert-icon"></div>
						<div>
							<strong>Anomaly Detection</strong>
							<p style="margin: 2px 0; font-size: var(--text-xs); color: var(--muted);">ML-based baseline learning</p>
						</div>
					</div>
				</div>
				<div class="data-table">
					<table class="data-table">
						<thead>
							<tr>
								<th>Type</th>
								<th>Value</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody id="anomalyBody">
							<!-- Populated by loadAnomalies() -->
						</tbody>
					</table>
				</div>
			`;
			return html;
		}

		async function loadAnomalies() {
			try {
				const res = await fetch("/aiflight/api/detect-anomalies");
				if (!res.ok) return;
				const data = await res.json();
				const tbody = document.getElementById("anomalyBody");
				if (!tbody || !data.anomalies) return;

				tbody.innerHTML = (data.anomalies || []).map(a => `
					<tr>
						<td>${esc(a.type)}</td>
						<td><strong>${esc(a.value)}</strong></td>
						<td><span class="badge-inline error">${esc(a.severity)}</span></td>
					</tr>
				`).join("");
			} catch (e) {
				console.error("Anomaly detection error", e);
			}
		}

		// F7: Benchmarking
		function buildBenchmarkingPanel() {
			const html = `
				<div class="dashboard-grid">
					<div class="panel">
						<p class="panel-title">P50 Latency</p>
						<p class="panel-value" id="p50">—ms</p>
					</div>
					<div class="panel">
						<p class="panel-title">P95 Latency</p>
						<p class="panel-value" id="p95">—ms</p>
					</div>
					<div class="panel">
						<p class="panel-title">P99 Latency</p>
						<p class="panel-value" id="p99">—ms</p>
					</div>
					<div class="panel">
						<p class="panel-title">Token Efficiency</p>
						<p class="panel-value" id="tokenEff">—</p>
						<p class="panel-meta">tokens/request</p>
					</div>
				</div>
				<div class="chart-container">
					<div class="chart-title">Latency Distribution</div>
					<div class="bar-chart" id="latencyChart"></div>
				</div>
			`;
			return html;
		}

		async function loadBenchmarking() {
			try {
				const res = await fetch("/aiflight/api/latency-benchmarks");
				if (!res.ok) return;
				const data = await res.json();

				document.getElementById("p50").textContent = Math.round(data.p50 || 0) + "ms";
				document.getElementById("p95").textContent = Math.round(data.p95 || 0) + "ms";
				document.getElementById("p99").textContent = Math.round(data.p99 || 0) + "ms";
				document.getElementById("tokenEff").textContent = formatNumber(data.tokenEfficiency || 0);
			} catch (e) {
				console.error("Benchmarking error", e);
			}
		}

		// F3: Dataset Management
		function buildDatasetPanel() {
			const html = `
				<div class="search-bar">
					<input type="text" id="datasetSearch" placeholder="Search datasets..." />
					<button onclick="createNewDataset()">New Dataset</button>
				</div>
				<div class="data-table">
					<table class="data-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Traces</th>
								<th>Version</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody id="datasetsBody">
							<!-- Populated by loadDatasets() -->
						</tbody>
					</table>
				</div>
			`;
			return html;
		}

		async function loadDatasets() {
			try {
				const res = await fetch("/aiflight/api/datasets/list");
				if (!res.ok) return;
				const data = await res.json();
				const tbody = document.getElementById("datasetsBody");
				if (!tbody) return;

				tbody.innerHTML = (data.datasets || []).map(d => `
					<tr>
						<td><strong>${esc(d.name)}</strong></td>
						<td>${formatNumber(d.traceCount || 0)}</td>
						<td><span class="badge-inline">${esc(d.version || "1.0")}</span></td>
						<td><button onclick="openDataset('${esc(d.id)}')">View</button></td>
					</tr>
				`).join("");
			} catch (e) {
				console.error("Dataset loading error", e);
			}
		}

		// F4: A/B Testing
		function buildABTestingPanel() {
			const html = `
				<div class="search-bar">
					<button onclick="createNewABTest()">Start A/B Test</button>
				</div>
				<div class="data-table">
					<table class="data-table">
						<thead>
							<tr>
								<th>Test Name</th>
								<th>Variants</th>
								<th>Traffic</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody id="abTestsBody">
							<!-- Populated by loadABTests() -->
						</tbody>
					</table>
				</div>
			`;
			return html;
		}

		async function loadABTests() {
			try {
				const res = await fetch("/aiflight/api/ab-tests/active");
				if (!res.ok) return;
				const data = await res.json();
				const tbody = document.getElementById("abTestsBody");
				if (!tbody) return;

				tbody.innerHTML = (data.tests || []).map(t => `
					<tr>
						<td><strong>${esc(t.name)}</strong></td>
						<td>${(t.variants || []).length}</td>
						<td><span class="badge-inline">${formatPercent(t.allocation || 0)}</span></td>
						<td><span class="badge-inline success">Active</span></td>
					</tr>
				`).join("");
			} catch (e) {
				console.error("A/B test loading error", e);
			}
		}

		// F12: Full-Text Search
		function buildSearchPanel() {
			const html = `
				<div class="search-bar">
					<input type="text" id="globalSearch" placeholder="Search traces, outputs, errors..." />
					<button onclick="performSearch()">Search</button>
				</div>
				<div id="searchResults"></div>
			`;
			return html;
		}

		async function performSearch() {
			const q = document.getElementById("globalSearch")?.value || "";
			if (!q) return;

			try {
				const res = await fetch(`/aiflight/api/search?q=${encodeURIComponent(q)}`);
				if (!res.ok) return;
				const data = await res.json();

				const resultsEl = document.getElementById("searchResults");
				if (!resultsEl) return;

				resultsEl.innerHTML = (data.results || []).map(r => `
					<div style="padding: 8px 0; border-bottom: 1px solid var(--border);">
						<strong>${esc(r.title)}</strong>
						<p style="margin: 4px 0; font-size: var(--text-xs); color: var(--muted);">${esc(r.preview || "")}</p>
					</div>
				`).join("");
			} catch (e) {
				console.error("Search error", e);
			}
		}

		// F16: Data Quality
		function buildDataQualityPanel() {
			const html = `
				<div class="dashboard-grid">
					<div class="panel">
						<p class="panel-title">Data Freshness</p>
						<p class="panel-value" id="dataFreshness">—</p>
					</div>
					<div class="panel">
						<p class="panel-title">Completeness</p>
						<p class="panel-value" id="completeness">—</p>
					</div>
					<div class="panel">
						<p class="panel-title">Schema Valid</p>
						<p class="panel-value" id="schemaValid">—</p>
					</div>
				</div>
			`;
			return html;
		}

		async function loadDataQuality() {
			try {
				const res = await fetch("/aiflight/api/data-quality");
				if (!res.ok) return;
				const data = await res.json();

				document.getElementById("dataFreshness").textContent = data.freshness || "—";
				document.getElementById("completeness").textContent = formatPercent(data.completeness || 0);
				document.getElementById("schemaValid").textContent = data.schemaValid ? "✓ Valid" : "✗ Invalid";
			} catch (e) {
				console.error("Data quality error", e);
			}
		}

		// F17: Notifications
		function buildNotificationPanel() {
			const html = `
				<div class="alerts-panel">
					<div class="alert-item">
						<div class="alert-icon" style="background: var(--span);"></div>
						<div>
							<strong>Notification Center</strong>
							<p style="margin: 2px 0; font-size: var(--text-xs); color: var(--muted);">Multi-channel alerts</p>
						</div>
					</div>
				</div>
				<div class="tab-nav">
					<button class="tab-btn active" onclick="switchNotificationTab('inapp')">In-App</button>
					<button class="tab-btn" onclick="switchNotificationTab('email')">Email</button>
					<button class="tab-btn" onclick="switchNotificationTab('slack')">Slack</button>
				</div>
				<div id="notificationsList"></div>
			`;
			return html;
		}

		async function loadNotifications() {
			try {
				const res = await fetch("/aiflight/api/notifications");
				if (!res.ok) return;
				const data = await res.json();

				const listEl = document.getElementById("notificationsList");
				if (!listEl) return;

				listEl.innerHTML = (data.notifications || []).map(n => `
					<div style="padding: 8px; border-bottom: 1px solid var(--border);">
						<div style="display: flex; justify-content: space-between;">
							<strong>${esc(n.title)}</strong>
							<span class="badge-inline">${esc(n.channel)}</span>
						</div>
						<p style="margin: 4px 0; font-size: var(--text-xs); color: var(--muted);">${esc(n.message || "")}</p>
					</div>
				`).join("");
			} catch (e) {
				console.error("Notifications error", e);
			}
		}

		function switchNotificationTab(tab) {
			document.querySelectorAll(".notification-tab").forEach(t => {
				t.classList.toggle("active", t.getAttribute("data-tab") === tab);
			});
		}

		function createNewDataset() {
			alert("Create dataset from current filters");
		}

		function openDataset(id) {
			alert("Open dataset: " + id);
		}

		function createNewABTest() {
			alert("Start new A/B test");
		}

		function loadFilterAndApply(filterId) {
			alert("Load and apply filter: " + filterId);
		}

		function switchFeatureTab(evt, tabName) {
			evt?.preventDefault?.();
			// Hide all tabs
			document.querySelectorAll(".feature-tab").forEach(tab => {
				tab.style.display = "none";
			});
			// Deactivate all buttons
			document.querySelectorAll(".tab-nav .tab-btn").forEach(btn => {
				btn.classList.remove("active");
			});
			// Show selected tab
			const tab = document.getElementById(tabName + "-tab");
			if (tab) tab.style.display = "block";
			// Activate button
			evt?.target?.classList?.add("active");
			// Load data for this tab
			switch(tabName) {
				case "cost": loadCostAnalytics(); break;
				case "anomalies": loadAnomalies(); break;
				case "benchmarks": loadBenchmarking(); break;
				case "datasets": loadDatasets(); break;
				case "abtests": loadABTests(); break;
				case "quality": loadDataQuality(); break;
				case "notifications": loadNotifications(); break;
			}
		}

		// Initialize feature panels when detail view loads
		window.aiFlight = window.aiFlight || {};
		window.aiFlight.loadCostAnalytics = loadCostAnalytics;
		window.aiFlight.loadAnomalies = loadAnomalies;
		window.aiFlight.loadBenchmarking = loadBenchmarking;
		window.aiFlight.loadDatasets = loadDatasets;
		window.aiFlight.loadABTests = loadABTests;
		window.aiFlight.loadDataQuality = loadDataQuality;
		window.aiFlight.loadNotifications = loadNotifications;
		window.aiFlight.performSearch = performSearch;
		window.aiFlight.switchFeatureTab = switchFeatureTab;
	})();
	</script>
</body>
</html>
