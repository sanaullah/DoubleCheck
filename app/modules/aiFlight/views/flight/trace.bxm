<bx:output>
<a class="back" href="/ai-flight/">← All traces</a>

<bx:if prc.notFound ?: false>
	<div class="panel">
		<div class="empty">
			<strong>Trace not found</strong>
			It may have been pruned by retention settings.
		</div>
	</div>
<bx:else>
	<div
		class="panel"
		data-poll-url="/ai-flight/api/traces/#encodeForURL( prc.trace.id )#"
		data-poll-seconds="#encodeForHTMLAttribute( prc.pollSeconds )#"
		data-trace-status="#encodeForHTMLAttribute( prc.trace.status )#"
	>
		<div class="trace-header">
			<h1>#encodeForHTML( prc.trace.name )#</h1>
			<span class="badge #encodeForHTMLAttribute( prc.trace.status )#">#encodeForHTML( prc.trace.status )#</span>
			<div class="stats">
				<span>Started <b><time class="when" data-when="#encodeForHTMLAttribute( prc.trace.startedAt )#" title="#encodeForHTMLAttribute( prc.trace.startedAt )#">#encodeForHTML( prc.trace.startedAt )#</time></b></span>
				<span>Duration <b class="mono" data-duration-ms="#encodeForHTMLAttribute( prc.trace.durationMs )#">#encodeForHTML( prc.trace.durationMs )# ms</b></span>
				<span>Tokens <b class="mono">#encodeForHTML( prc.trace.totalTokens )#</b>
					<span class="muted">(p #encodeForHTML( prc.trace.promptTokens )# / c #encodeForHTML( prc.trace.completionTokens )#)</span>
				</span>
				<span>Provider <b class="mono">#encodeForHTML( len( prc.trace.provider ) ? prc.trace.provider : "—" )#</b></span>
				<span>Model <b class="mono">#encodeForHTML( len( prc.trace.model ) ? prc.trace.model : "—" )#</b></span>
			</div>
			<bx:if len( prc.trace.errorMessage ?: "" )>
				<p style="color: var(--err); margin: 12px 0 0;">#encodeForHTML( prc.trace.errorMessage )#</p>
			</bx:if>
		</div>

		<div class="timeline">
			<bx:if !arrayLen( prc.trace.observations ?: [] )>
				<div class="empty">
					<strong>Waiting for first observation…</strong>
					Live AI events will land here as bx-ai announces them.
				</div>
			<bx:else>
				<bx:loop array="#prc.trace.observations#" index="o">
					<div class="obs open">
						<div class="obs-head">
							<span class="obs-type #encodeForHTMLAttribute( o.type )#">#encodeForHTML( o.type )#</span>
							<span class="obs-name">#encodeForHTML( o.name )#</span>
							<span class="badge #encodeForHTMLAttribute( o.status )#">#encodeForHTML( o.status )#</span>
							<span class="obs-meta">
								#encodeForHTML( o.sourceEvent )# ·
								<span data-duration-ms="#encodeForHTMLAttribute( o.durationMs )#">#encodeForHTML( o.durationMs )# ms</span>
								· <time class="when" data-when="#encodeForHTMLAttribute( o.startTime )#" title="#encodeForHTMLAttribute( o.startTime )#">#encodeForHTML( o.startTime )#</time>
							</span>
						</div>
						<div class="obs-body">
							<bx:if len( o.inputText ?: "" )>
								<h4>Input</h4>
								<pre>#encodeForHTML( o.inputText )#</pre>
							</bx:if>
							<bx:if len( o.outputText ?: "" )>
								<h4>Output</h4>
								<pre>#encodeForHTML( o.outputText )#</pre>
							</bx:if>
							<h4>Source</h4>
							<pre>#encodeForHTML( o.sourceEvent )#</pre>
							<bx:if isStruct( o.usage ?: "" ) && structCount( o.usage )>
								<h4>Usage</h4>
								<pre>#encodeForHTML( jsonSerialize( o.usage ) )#</pre>
							</bx:if>
							<bx:if isStruct( o.payload ?: "" ) && structCount( o.payload )>
								<h4>Payload</h4>
								<pre>#encodeForHTML( jsonSerialize( o.payload ) )#</pre>
							</bx:if>
						</div>
					</div>
				</bx:loop>
			</bx:if>
		</div>
	</div>
</bx:if>
</bx:output>
