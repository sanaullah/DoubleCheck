<bx:output>
<div
	class="workspace"
	id="observe-workspace"
	data-list-url="/ai-flight/api/traces"
	data-sessions-url="/ai-flight/api/sessions"
	data-session-url="/ai-flight/api/session/"
	data-detail-url="/ai-flight/api/trace/"
	data-poll-seconds="#encodeForHTMLAttribute( prc.pollSeconds )#"
	data-filter-status="#encodeForHTMLAttribute( prc.filters.status )#"
	data-filter-q="#encodeForHTMLAttribute( prc.filters.q )#"
	data-filter-tools="#encodeForHTMLAttribute( prc.filters.hasTools ? "true" : "" )#"
	data-filter-errors="#encodeForHTMLAttribute( prc.filters.hasErrors ? "true" : "" )#"
	data-filter-model="#encodeForHTMLAttribute( prc.filters.model )#"
	data-filter-userid="#encodeForHTMLAttribute( prc.filters.userId )#"
	data-filter-environment="#encodeForHTMLAttribute( prc.filters.environment )#"
	data-filter-obstype="#encodeForHTMLAttribute( prc.filters.obsType )#"
	data-filter-minduration="#encodeForHTMLAttribute( prc.filters.minDurationMs )#"
	data-filter-maxduration="#encodeForHTMLAttribute( prc.filters.maxDurationMs )#"
	data-filter-mincost="#encodeForHTMLAttribute( prc.filters.minCost )#"
	data-selected="#encodeForHTMLAttribute( prc.selectedTraceId ?: "" )#"
>
	<aside class="list-pane">
		<div class="mode-tabs" role="tablist">
			<button type="button" class="mode-tab is-active" data-mode="traces" role="tab" aria-selected="true">Traces</button>
			<button type="button" class="mode-tab" data-mode="sessions" role="tab" aria-selected="false">Sessions</button>
			<span class="live-pill" id="observe-live" title="Auto-refresh">live</span>
		</div>
		<form class="filters" id="flight-filters" action="/ai-flight/" onsubmit="return false;">
			<input type="search" name="q" value="#encodeForHTMLAttribute( prc.filters.q )#" placeholder="Search…" autocomplete="off">
			<select name="status">
				<option value="">All</option>
				<option value="running" <bx:if prc.filters.status EQ "running">selected</bx:if>>running</option>
				<option value="ok" <bx:if prc.filters.status EQ "ok">selected</bx:if>>ok</option>
				<option value="error" <bx:if prc.filters.status EQ "error">selected</bx:if>>error</option>
			</select>
			<input type="text" name="model" value="#encodeForHTMLAttribute( prc.filters.model )#" placeholder="Model…" autocomplete="off">
			<input type="text" name="environment" value="#encodeForHTMLAttribute( prc.filters.environment )#" placeholder="Env…" autocomplete="off">
			<input type="text" name="userId" value="#encodeForHTMLAttribute( prc.filters.userId )#" placeholder="User…" autocomplete="off">
			<select name="obsType">
				<option value="">Type</option>
				<option value="generation" <bx:if prc.filters.obsType EQ "generation">selected</bx:if>>generation</option>
				<option value="tool" <bx:if prc.filters.obsType EQ "tool">selected</bx:if>>tool</option>
				<option value="span" <bx:if prc.filters.obsType EQ "span">selected</bx:if>>span</option>
				<option value="event" <bx:if prc.filters.obsType EQ "event">selected</bx:if>>event</option>
			</select>
			<input type="number" name="minDurationMs" value="#encodeForHTMLAttribute( prc.filters.minDurationMs )#" placeholder="Min ms" min="0" step="1">
			<input type="number" name="maxDurationMs" value="#encodeForHTMLAttribute( prc.filters.maxDurationMs )#" placeholder="Max ms" min="0" step="1">
			<input type="number" name="minCost" value="#encodeForHTMLAttribute( prc.filters.minCost )#" placeholder="Min $" min="0" step="any">
			<label class="chk"><input type="checkbox" name="hasTools" value="true" <bx:if prc.filters.hasTools>checked</bx:if>> tools</label>
			<label class="chk"><input type="checkbox" name="hasErrors" value="true" <bx:if prc.filters.hasErrors>checked</bx:if>> errors</label>
			<button type="submit" id="flight-filter-apply">Filter</button>
		</form>
		<div class="trace-list" id="observe-list" role="listbox" aria-label="Traces">
			<bx:if !arrayLen( prc.traces )>
				<div class="empty compact">
					<strong>No traces yet</strong>
					Run a review — rows appear here live.
				</div>
			<bx:else>
				<bx:loop array="#prc.traces#" index="t">
					<button
						type="button"
						class="trace-item"
						role="option"
						data-id="#encodeForHTMLAttribute( t.id )#"
						data-status="#encodeForHTMLAttribute( t.status )#"
						data-started="#encodeForHTMLAttribute( t.startedAt )#"
					>
						<div class="trace-item-top">
							<strong>#encodeForHTML( t.name )#</strong>
							<span class="badge #encodeForHTMLAttribute( t.status )#">#encodeForHTML( t.status )#</span>
						</div>
						<div class="trace-item-meta mono">
							<time class="when" data-when="#encodeForHTMLAttribute( t.startedAt )#">#encodeForHTML( t.startedAt )#</time>
							· #encodeForHTML( t.totalTokens )# tok
							· #encodeForHTML( t.observationCount )# steps
						</div>
						<div class="trace-item-sub muted">#encodeForHTML(
	left(
		t.outputPreview ?: t.inputPreview ?: ( len( t.model ) ? t.model : "-" ),
		120
	)
)#</div>
					</button>
				</bx:loop>
			</bx:if>
		</div>
	</aside>

	<section class="detail-pane" id="observe-detail">
		<div class="empty detail-empty" id="detail-placeholder">
			<strong>Select a trace</strong>
			Click a row on the left to inspect the nested timeline — no page change.
		</div>
	</section>
</div>
</bx:output>
