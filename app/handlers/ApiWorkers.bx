/**
 * REST: worker registry listing for multi-worker deployments.
 *
 * @see WorkerRegistryService
 */
class extends="coldbox.system.RestHandler" {
	property name="securityContextService" inject="SecurityContextService";

	property name="workerRegistryService" inject="WorkerRegistryService";

	function index( event, rc, prc ) {
		var context = securityContextService.authenticate( event );
		securityContextService.authorize( context, "workers:read" );
		event.renderData(
				type = "json",
				data = { data: workerRegistryService.listActive() }
			);
	}
}