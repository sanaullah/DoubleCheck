/**
 * REST: evaluation corpus / quality-gate status for optional production controls.
 *
 * @see QualityGateService
 */
class extends="coldbox.system.RestHandler" {
	property name="securityContextService" inject="SecurityContextService";

	property name="qualityGateService" inject="QualityGateService";

	function index( event, rc, prc ) {
		var context = securityContextService.authenticate( event );
		securityContextService.authorize( context, "quality:read" );
		event.renderData(
				type = "json",
				data = { data: qualityGateService.status() }
			);
	}
}