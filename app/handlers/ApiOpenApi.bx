/**
 * Serves the curated OpenAPI documents from the repository source of truth.
 * MiniServer aliases expose directories only, so file-backed API routes keep
 * the documented /api/v1/openapi.* contract available in every local runtime.
 */
class extends="coldbox.system.RestHandler" {

	/**
	 * @tags Health
	 * @hint Curated OpenAPI JSON contract
	 * @response-200 OpenAPI JSON document
	 */
	function json( event, rc, prc ) {
		if ( lCase( trim( toString( rc.format ?: "" ) ) ) == "yaml" ) {
			return yaml( event, rc, prc );
		}
		event.renderData(
			type        = "json",
			contentType = "application/json",
			data        = jsonDeserialize( readDocument( "openapi.json" ) )
		);
	}

	/**
	 * @tags Health
	 * @hint Curated OpenAPI YAML contract
	 * @response-200 OpenAPI YAML document
	 */
	function yaml( event, rc, prc ) {
		event.renderData(
			type        = "text",
			contentType = "application/yaml",
			data        = readDocument( "openapi.yaml" )
		);
	}

	private string function readDocument( required string name ) {
		var handlerRoot = getDirectoryFromPath( getCurrentTemplatePath() );
		var sourcePath = handlerRoot & "../../resources/apidocs/" & arguments.name;
		if ( !fileExists( sourcePath ) ) {
			throw( type = "FileNotFoundException", message = "OpenAPI document not found" );
		}
		return fileRead( sourcePath, "UTF-8" );
	}
}
