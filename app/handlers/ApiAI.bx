/**
 * REST: AI provider smoke test and specialist circuit status.
 *
 * @see AIReviewService
 * @see SpecialistAgentGateway
 */
class extends="coldbox.system.RestHandler" {
	property name="aiReviewService" inject="AIReviewService";

	property name="specialistGateway" inject="SpecialistAgentGateway";

	property name="aiProvider" inject="coldbox:setting:aiProvider";

	property name="aiModel" inject="coldbox:setting:aiModel";

	property name="aiBaseURL" inject="coldbox:setting:aiBaseURL";

	property name="log" inject="logbox:logger:{this}";

	property name="secretRedactionService" inject="SecretRedactionService";

	/**
	 * GET /api/v1/ai/smoke
	 * Live provider connectivity check for local development.
	 */
	function smoke( event, rc, prc ) {
		if ( !aiReviewService.isEnabled() ) {
			event.renderData(
					type       = "json",
					statusCode = 503,
					data       = {
						data: {
							success: false,
							enabled: false,
							message: "AI provider is not configured. Set OPENAI_API_KEY and OPENAI_API_BASE."
						}
					}
				);
			return;
		}

		specialistGateway.resetCircuit();
		try {
			var result = aiReviewService.smokeTest();
			event.renderData(
					type = "json",
					data = {
						data: {
							success   : result.success,
							enabled   : true,
							provider  : result.provider,
							model     : result.model,
							baseHost  : result.baseHost,
							durationMs: result.durationMs,
							response  : result.response,
							circuit   : specialistGateway.circuitStatus()
						}
					}
				);
		} catch (any error) {
			log.error(
					"AI connectivity test failed",
					{
						type      : error.type ?: "",
						message   : secretRedactionService.redactText( error.message ?: "" ),
						provider  : aiProvider,
						model     : aiModel,
						stackTrace: secretRedactionService.redactText( error.stackTrace ?: "" )
					}
				);
			event.renderData(
					type       = "json",
					statusCode = 502,
					data       = {
						data: {
							success : false,
							enabled : true,
							provider: aiProvider,
							model   : aiModel,
							baseURL : aiBaseURL,
							message : error.message,
							type    : error.type ?: "",
							circuit : specialistGateway.circuitStatus()
						}
					}
				);
		}
	}
}