/**
 * REST: local workspace session identity for the UI.
 *
 * @see SecurityContextService
 */
class extends="coldbox.system.RestHandler" {
	property name="securityContextService" inject="SecurityContextService";

	function show( event, rc, prc ) {
		var context = securityContextService.authenticate( event );
		event.renderData(
				type = "json",
				data = {
					data: {
						principalId: context.principalId,
						tenantId   : context.tenantId,
						tenantName : context.tenantName,
						name       : context.name,
						role       : context.role
					}
				}
			);
	}
}