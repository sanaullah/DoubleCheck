/**
 * REST: feature capability snapshot for the workspace UI (AI, review contract, baselines).
 */
class extends="coldbox.system.RestHandler" {
	property name="aiReviewService" inject="AIReviewService";

	property name="aiProviderResolver" inject="AIProviderResolverService";

	property name="boxLangParserService" inject="BoxLangParserService";

	property name="cfmlParserService" inject="CfmlParserService";

	property name="qualityGateService" inject="QualityGateService";

	property name="modernizationPolicyService" inject="ModernizationPolicyService";

	property name="modernizationSchemaMaxBytes" inject="coldbox:setting:modernizationSchemaMaxBytes";

	property name="modernizationMaxFiles" inject="coldbox:setting:modernizationMaxFiles";

	/**
	 * Feature capabilities
	 *
	 * @tags Health
	 * @hint Capability snapshot consumed by the workspace UI
	 * @response-200 Capabilities object
	 */
	function index( event, rc, prc ) {
		var resolved = aiProviderResolver.resolve();
		event.renderData(
				type = "json",
				data = {
					data: {
						apiVersion : "v1",
						mode       : "local",
						persistence: "sqlite",
						streaming  : {
							transport : "sse",
							replay    : true,
							heartbeats: true
						},
						runModes     : [ "working-tree", "revision-diff", "full"],
						languages    : qualityGateService.advertisedLanguages( {
							"BoxLang": boxLangParserService.getVersion(),
							"CFML"   : cfmlParserService.getVersion()
						} ),
						localControls: {
							workers     : "sqlite-lease-token-v1",
							qualityGates: "persisted-seeded-corpus-v1"
						},
						aiExecution: {
							enabled : aiReviewService.isEnabled(),
							provider: resolved.provider,
							optional: true
						},
						review: {
							contentAddressedIndex  : true,
							evidenceValidation     : true,
							fingerprints           : true,
							secretRedaction        : true,
							syntaxParsing          : true,
							dependencyGraph        : true,
							contentAddressedReuse  : true,
							resolvedTestImpact     : true,
							changedSymbolImpact    : "bounded-reverse-file-cone-v1",
							deterministicAIContract: true,
							seededEvaluationCorpus : "boxlang-review-corpus-v1",
							architectureModel      : "deterministic-evidence-v1",
							architectureEnrichment : "validated-fact-citations-v1",
							architectureModelReuse : "project-revision-input-fingerprint-v1",
							architectureDiff       : "fact-identity-v1",
							reviewPlanner          : "bounded-role-plan-v2",
							contextPacks           : "symbol-range-artifact-refs-v3",
							reviewPolicy           : "immutable-allowlisted-roles-v1",
							runBudgets             : "immutable-task-token-time-iteration-output-cost-v2",
							aiContextIsBounded     : true,
							aiCoverageReported     : true,
							historicalBlobReads    : true,
							specialistAgents       : "native-bx-ai-role-factory-v2",
							specialistCfmlDepth    : "cfml-conventions-llm-v2",
							controlledReadTools    : "indexed-artifact-range-budget-v2",
							specialistResults      : "durable-partial-artifact-reference-v2",
							specialistConcurrency  : "fixed-per-provider-executor-v1",
							specialistResilience   : "deadline-retry-circuit-cancel-v1",
							specialistStreaming    : "coalesced-metadata-sse-v1",
							specialistObservability: "langfuse-style-traces-export-v4",
							reportExport           : "markdown-json-sarif-v1",
							findingBaselines       : "compatible-fingerprint-delta-v1",
							findingSolutions       : "playbook-and-optional-patch-v1"
						},
						modernization: {
							enabled       : modernizationPolicyService.isProviderEnabled(),
							providerEnabled: modernizationPolicyService.isProviderEnabled(),
							localProvider : resolved.isLocal,
							requiresLlm   : true,
							schemaVersion : "modernization-plan-v2",
							placementContractVersion: "modernization-placement-v1",
							placementTypes: [ "main-app", "coldbox-module", "external-service" ],
							maxSchemaAttachmentBytes: modernizationSchemaMaxBytes,
							maxSampleFiles: modernizationMaxFiles,
							schemaPackFormats: [ "sql-ddl", "structured-json-v1", "migration-folder" ],
							skillPack     : true,
							sliceRebuild  : true,
							targetProfiles: {
								boxlang: [ "boxlang", "modern" ],
								lucee  : [ "modern", "flat" ]
							}
						}
					}
				}
			);
	}
}
