/**
 * REST: local workspace project list (single default project).
 *
 * @see SecurityContextService
 */
class extends="coldbox.system.RestHandler" {
	property name="securityContextService" inject="SecurityContextService";

	function preHandler(
		event,
		rc,
		prc,
		action,
		eventArguments
	) {
		prc.securityContext = securityContextService.authenticate( event );
	}

	function index( event, rc, prc ) {
		securityContextService.authorize( prc.securityContext, "projects:read" );
		event.renderData(
				type = "json",
				data = { data: securityContextService.projectsFor( prc.securityContext ) }
			);
	}
}