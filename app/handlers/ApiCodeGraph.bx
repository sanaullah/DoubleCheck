/**
 * REST: CodeGraph neighbourhood subgraph and bounded file edges for a finished run.
 *
 * @see CodeGraphRunService
 */
class extends="coldbox.system.RestHandler" {
	property name="codeGraphRunService" inject="CodeGraphRunService";
	property name="graphRepository" inject="AnalysisGraphRepository";
	property name="codeGraphRepository" inject="CodeGraphRepository";
	property name="codeGraphGraphRepository" inject="CodeGraphGraphRepository";

	property name="runService" inject="ReviewRunService";

	property name="securityContextService" inject="SecurityContextService";

	property name="codegraphSubgraphMaxNodes" inject="coldbox:setting:codegraphSubgraphMaxNodes";

	property name="codegraphSubgraphMaxDepth" inject="coldbox:setting:codegraphSubgraphMaxDepth";

	property name="codegraphMaxEdges" inject="coldbox:setting:codegraphMaxEdges";
	property name="codegraphPathMaxResults" inject="coldbox:setting:codegraphPathMaxResults";
	property name="codegraphPathMaxDepth" inject="coldbox:setting:codegraphPathMaxDepth";

	function preHandler(
		event,
		rc,
		prc,
		action,
		eventArguments
	) {
		prc.securityContext = securityContextService.authenticate( event );
	}

	/**
	 * Project-scoped CodeGraph entry point. Returns the newest usable local
	 * snapshot so the workspace can orient without creating a new run.
	 *
	 * @tags CodeGraph
	 * @hint Open the newest usable CodeGraph snapshot for a local project path
	 * @param-projectPath { "name":"projectPath", "in":"query", "required":true, "schema":{"type":"string"} }
	 * @param-projectId { "name":"projectId", "in":"query", "required":false, "schema":{"type":"string"} }
	 * @response-200 Project snapshot entry point
	 * @response-404 No usable snapshot for project
	 * @response-422 Validation failed
	 */
	function project( event, rc, prc ) {
		try {
			var projectPath = securityContextService.authorizeProjectPath(
				prc.securityContext,
				rc.projectId ?: "",
				rc.projectPath ?: ""
			);
			var stored = codeGraphRepository.findLatestProjectSnapshot( projectPath );
			if ( isNull( stored ) ) {
				return notFound( event );
			}
			var run = runService.getScoped( stored.runId ?: "", prc.securityContext, rc.projectId ?: "" );
			if ( isNull( run ) ) return notFound( event );
			event.renderData(
				type = "json",
				data = { data: { projectPath: projectPath, run: run.getMemento(), reused: true } }
			);
		} catch ( "ValidationException" error ) {
			validationError( event, error.message );
		}
	}

	/**
	 * Neighbourhood subgraph for a CodeGraph run
	 *
	 * @tags CodeGraph
	 * @hint BFS neighbourhood around a focus file path, capped by depth and limit
	 * @param-focus { "name":"focus", "in":"query", "required":true, "schema":{"type":"string"} }
	 * @param-depth { "name":"depth", "in":"query", "required":false, "schema":{"type":"integer","minimum":1} }
	 * @param-limit { "name":"limit", "in":"query", "required":false, "schema":{"type":"integer","minimum":1} }
	 * @param-kinds { "name":"kinds", "in":"query", "required":false, "schema":{"type":"string"} }
	 * @param-include { "name":"include", "in":"query", "required":false, "schema":{"type":"string"} }
	 * @response-200 Subgraph payload
	 * @response-404 Run not found or not a codegraph run
	 * @response-422 Validation failed
	 */
	function subgraph( event, rc, prc ) {
		var run = runService.getScoped(
				rc.id ?: "",
				prc.securityContext,
				rc.projectId ?: ""
			);
		if ( isNull( run ) || !hasIndexedGraph( run ) ) {
			return notFound( event );
		}

		var focus = trim( toString( rc.focus ?: "" ) );
		if ( !len( focus ) ) {
			return validationError( event, "focus is required" );
		}

		var maxDepth = max( 1, val( variables.codegraphSubgraphMaxDepth ?: 3 ) );
		var maxNodes = max( 1, val( variables.codegraphSubgraphMaxNodes ?: 300 ) );

		if ( len( trim( toString( rc.depth ?: "" ) ) ) ) {
			if ( !isNumeric( rc.depth ) || val( rc.depth ) < 1 || val( rc.depth ) > maxDepth ) {
				return validationError( event, "depth must be between 1 and #maxDepth#" );
			}
		}
		if ( len( trim( toString( rc.limit ?: "" ) ) ) ) {
			if ( !isNumeric( rc.limit ) || val( rc.limit ) < 1 || val( rc.limit ) > maxNodes ) {
				return validationError( event, "limit must be between 1 and #maxNodes#" );
			}
		}

		try {
			var payload = codeGraphRunService.subgraph(
					run.getId(),
					{
						focus  : focus,
						depth  : rc.depth ?: "",
						limit  : rc.limit ?: "",
						kinds  : rc.kinds ?: "",
						include: rc.include ?: ""
					}
				);
			event.renderData( type = "json", data = { data: payload } );
		} catch ( "ValidationException" error ) {
			validationError( event, error.message );
		}
	}

	/**
	 * Bounded file edges for Files depth (optional clusterId filter)
	 *
	 * @tags CodeGraph
	 * @hint File-to-file dependency edges with kind/evidence, capped by limit
	 * @param-clusterId { "name":"clusterId", "in":"query", "required":false, "schema":{"type":"string"} }
	 * @param-limit { "name":"limit", "in":"query", "required":false, "schema":{"type":"integer","minimum":1} }
	 * @param-kinds { "name":"kinds", "in":"query", "required":false, "schema":{"type":"string"} }
	 * @param-include { "name":"include", "in":"query", "required":false, "schema":{"type":"string"} }
	 * @response-200 File edges payload
	 * @response-404 Run not found or not a codegraph run
	 * @response-422 Validation failed
	 */
	function edges( event, rc, prc ) {
		var run = runService.getScoped(
				rc.id ?: "",
				prc.securityContext,
				rc.projectId ?: ""
			);
		if ( isNull( run ) || !hasIndexedGraph( run ) ) {
			return notFound( event );
		}

		var maxEdges = max( 1, val( variables.codegraphMaxEdges ?: 20000 ) );
		if ( len( trim( toString( rc.limit ?: "" ) ) ) ) {
			if ( !isNumeric( rc.limit ) || val( rc.limit ) < 1 || val( rc.limit ) > maxEdges ) {
				return validationError( event, "limit must be between 1 and #maxEdges#" );
			}
		}

		try {
			var payload = codeGraphRunService.fileEdges(
					run.getId(),
					{
						clusterId: rc.clusterId ?: "",
						limit    : rc.limit ?: "",
						kinds    : rc.kinds ?: "",
						include  : rc.include ?: ""
					}
				);
			event.renderData( type = "json", data = { data: payload } );
		} catch ( "ValidationException" error ) {
			validationError( event, error.message );
		}
	}

	/**
	 * Directed path finder between two graph nodes.
	 *
	 * @tags CodeGraph
	 * @hint Bounded directed dependency paths with per-hop evidence
	 * @param-from { "name":"from", "in":"query", "required":true, "schema":{"type":"string"} }
	 * @param-to { "name":"to", "in":"query", "required":true, "schema":{"type":"string"} }
	 * @param-direction { "name":"direction", "in":"query", "required":false, "schema":{"type":"string","enum":["forward","reverse","any"]} }
	 * @param-limit { "name":"limit", "in":"query", "required":false, "schema":{"type":"integer","minimum":1} }
	 * @param-depth { "name":"depth", "in":"query", "required":false, "schema":{"type":"integer","minimum":1} }
	 * @response-200 Directed paths payload
	 * @response-404 Run not found or no indexed graph
	 * @response-422 Validation failed
	 */
	function paths( event, rc, prc ) {
		var run = runService.getScoped(
			rc.id ?: "",
			prc.securityContext,
			rc.projectId ?: ""
		);
		if ( isNull( run ) || !hasIndexedGraph( run ) ) return notFound( event );
		var maxResults = max( 1, val( variables.codegraphPathMaxResults ?: 3 ) );
		var maxDepth = max( 1, val( variables.codegraphPathMaxDepth ?: 12 ) );
		if ( !len( trim( toString( rc.from ?: "" ) ) ) || !len( trim( toString( rc.to ?: "" ) ) ) ) return validationError( event, "from and to are required" );
		if ( len( trim( toString( rc.limit ?: "" ) ) ) && ( !isNumeric( rc.limit ) || val( rc.limit ) < 1 || val( rc.limit ) > maxResults ) ) return validationError( event, "limit must be between 1 and #maxResults#" );
		if ( len( trim( toString( rc.depth ?: "" ) ) ) && ( !isNumeric( rc.depth ) || val( rc.depth ) < 1 || val( rc.depth ) > maxDepth ) ) return validationError( event, "depth must be between 1 and #maxDepth#" );
		try {
			var payload = codeGraphRunService.paths( run.getId(), {
				from     : rc.from ?: "",
				to       : rc.to ?: "",
				direction: rc.direction ?: "forward",
				limit    : rc.limit ?: "",
				depth    : rc.depth ?: "",
				includeTests: rc.includeTests ?: false
			} );
			event.renderData( type = "json", data = { data: payload } );
		} catch ( "ValidationException" error ) {
			validationError( event, error.message );
		}
	}

	/**
	 * One level of the stored knowledge graph.
	 *
	 * @tags CodeGraph
	 * @hint Nodes and edges at one level (cluster, directory, file, symbol), optionally scoped to a parent node
	 * @param-level { "name":"level", "in":"query", "required":false, "schema":{"type":"string","enum":["cluster","directory","file","symbol"]} }
	 * @param-scope { "name":"scope", "in":"query", "required":false, "schema":{"type":"string"} }
	 * @param-rank { "name":"rank", "in":"query", "required":false, "schema":{"type":"string","enum":["hotspot","fanIn","name"]} }
	 * @param-limit { "name":"limit", "in":"query", "required":false, "schema":{"type":"integer","minimum":1} }
	 * @param-include { "name":"include", "in":"query", "required":false, "schema":{"type":"string","enum":["both","nodes"]} }
	 * @response-200 Level payload with a completeness account
	 * @response-404 Run not found or no indexed graph
	 * @response-409 Snapshot predates the node tables
	 * @response-422 Validation failed
	 */
	function graph( event, rc, prc ) {
		var run = runService.getScoped( rc.id ?: "", prc.securityContext, rc.projectId ?: "" );
		if ( isNull( run ) || !hasIndexedGraph( run ) ) return notFound( event );
		var maxNodes = max( 1, val( variables.codegraphMaxNodes ?: 1500 ) );
		if ( len( trim( toString( rc.limit ?: "" ) ) ) && ( !isNumeric( rc.limit ) || val( rc.limit ) < 1 || val( rc.limit ) > maxNodes ) ) {
			return validationError( event, "limit must be between 1 and #maxNodes#" );
		}
		var level = lCase( trim( toString( rc.level ?: "cluster" ) ) );
		if ( !listFindNoCase( "cluster,directory,file,symbol", level ) ) {
			return validationError( event, "level must be cluster, directory, file, or symbol" );
		}
		// A snapshot written before the node tables cannot answer deeper levels.
		// Say so, with the remedy, instead of returning an empty graph.
		if ( !codeGraphGraphRepository.hasGraph( run.getId() ) ) {
			return event.renderData(
				type       = "json",
				statusCode = 409,
				data       = { error: { code: "snapshot_predates_node_tables", message: "This snapshot was built before levelled storage. Rebuild the map to explore below the canvas." } }
			);
		}
		try {
			var payload = codeGraphGraphRepository.readLevel( run.getId(), {
				level  : level,
				scope  : rc.scope ?: "",
				rank   : rc.rank ?: "hotspot",
				limit  : len( trim( toString( rc.limit ?: "" ) ) ) ? val( rc.limit ) : 200,
				include: rc.include ?: "both"
			} );
			event.renderData( type = "json", data = { data: payload } );
		} catch ( "ValidationException" error ) {
			validationError( event, error.message );
		}
	}

	/**
	 * Server-side node search across every level.
	 *
	 * @tags CodeGraph
	 * @hint Find nodes by path, symbol name, role or kind, including nodes the canvas never drew
	 * @param-q { "name":"q", "in":"query", "required":true, "schema":{"type":"string"} }
	 * @param-level { "name":"level", "in":"query", "required":false, "schema":{"type":"string","enum":["cluster","directory","file","symbol"]} }
	 * @param-limit { "name":"limit", "in":"query", "required":false, "schema":{"type":"integer","minimum":1} }
	 * @response-200 Matches with a completeness account
	 * @response-404 Run not found or no indexed graph
	 * @response-422 Validation failed
	 */
	function search( event, rc, prc ) {
		var run = runService.getScoped( rc.id ?: "", prc.securityContext, rc.projectId ?: "" );
		if ( isNull( run ) || !hasIndexedGraph( run ) ) return notFound( event );
		var term = trim( toString( rc.q ?: "" ) );
		if ( !len( term ) ) return validationError( event, "q is required" );
		if ( len( trim( toString( rc.limit ?: "" ) ) ) && ( !isNumeric( rc.limit ) || val( rc.limit ) < 1 || val( rc.limit ) > 200 ) ) {
			return validationError( event, "limit must be between 1 and 200" );
		}
		var payload = codeGraphGraphRepository.search( run.getId(), {
			q    : term,
			level: rc.level ?: "",
			limit: len( trim( toString( rc.limit ?: "" ) ) ) ? val( rc.limit ) : 50
		} );
		event.renderData( type = "json", data = { data: payload } );
	}

	/**
	 * Local source window around a cited dependency line.
	 *
	 * @tags CodeGraph
	 * @hint Repository-relative source excerpt for inspector evidence
	 * @param-path { "name":"path", "in":"query", "required":true, "schema":{"type":"string"} }
	 * @param-line { "name":"line", "in":"query", "required":true, "schema":{"type":"integer","minimum":1} }
	 * @param-before { "name":"before", "in":"query", "required":false, "schema":{"type":"integer","minimum":0,"maximum":20} }
	 * @param-after { "name":"after", "in":"query", "required":false, "schema":{"type":"integer","minimum":0,"maximum":40} }
	 * @response-200 Source excerpt payload
	 * @response-404 Run or source file not found
	 * @response-422 Validation failed
	 */
	function source( event, rc, prc ) {
		var run = runService.getScoped(
			rc.id ?: "",
			prc.securityContext,
			rc.projectId ?: ""
		);
		if ( isNull( run ) || !hasIndexedGraph( run ) ) return notFound( event );
		if ( !len( trim( toString( rc.path ?: "" ) ) ) || !len( trim( toString( rc.line ?: "" ) ) ) || !isNumeric( rc.line ) || val( rc.line ) < 1 ) {
			return validationError( event, "path and a positive line are required" );
		}
		if ( len( trim( toString( rc.before ?: "" ) ) ) && ( !isNumeric( rc.before ) || val( rc.before ) < 0 || val( rc.before ) > 20 ) ) return validationError( event, "before must be between 0 and 20" );
		if ( len( trim( toString( rc.after ?: "" ) ) ) && ( !isNumeric( rc.after ) || val( rc.after ) < 0 || val( rc.after ) > 40 ) ) return validationError( event, "after must be between 0 and 40" );
		try {
			var payload = codeGraphRunService.sourceExcerpt( run.getId(), {
				path  : rc.path,
				line  : rc.line,
				before: structKeyExists( rc, "before" ) ? rc.before : "",
				after : structKeyExists( rc, "after" ) ? rc.after : ""
			} );
			event.renderData( type = "json", data = { data: payload } );
		} catch ( "NotFoundException" error ) {
			notFound( event );
		} catch ( "ValidationException" error ) {
			validationError( event, error.message );
		}
	}

	/**
	 * Retry CodeGraph meaning briefing for an existing run (no re-index)
	 *
	 * @tags CodeGraph
	 * @hint Re-runs LLM narrative against the stored snapshot and persists the result
	 * @response-200 Narrative payload
	 * @response-404 Run not found or not a codegraph run
	 * @response-422 Validation / provider failure surfaced as narrative.used=false
	 */
	function narrative( event, rc, prc ) {
		var run = runService.getScoped(
				rc.id ?: "",
				prc.securityContext,
				rc.projectId ?: ""
			);
		if ( isNull( run ) || lCase( run.getRunKind() ?: "" ) != "codegraph" ) {
			return notFound( event );
		}
		try {
			var payload = codeGraphRunService.refreshNarrative( run.getId() );
			event.renderData( type = "json", data = { data: { narrative: payload } } );
		} catch ( "NotFoundException" error ) {
			notFound( event );
		} catch ( "ValidationException" error ) {
			validationError( event, error.message );
		}
	}

	/**
	 * Override one cluster label locally. The member-composition key is derived
	 * from the stored snapshot; callers never provide a path or SQL key.
	 *
	 * @tags CodeGraph
	 * @hint Persist a local user label for one stable CodeGraph cluster
	 * @response-200 User label payload
	 * @response-404 CodeGraph run or snapshot not found
	 * @response-422 Validation failed
	 */
	function label( event, rc, prc ) {
		var run = runService.getScoped( rc.id ?: "", prc.securityContext, rc.projectId ?: "" );
		if ( isNull( run ) || lCase( run.getRunKind() ?: "" ) != "codegraph" ) return notFound( event );
		var stored = codeGraphRepository.get( run.getId() );
		if ( isNull( stored ) ) return notFound( event );
		var body = {};
		try { body = event.getHTTPContent( json = true ); } catch ( any ignored ) {}
		if ( !isStruct( body ) || !body.count() ) body = rc;
		var clusterId = trim( toString( body.clusterId ?: rc.clusterId ?: "" ) );
		var labelValue = left( trim( toString( body.label ?: rc.label ?: "" ) ), 160 );
		if ( !len( clusterId ) || !len( labelValue ) ) return validationError( event, "clusterId and label are required" );
		var snapshot = isStruct( stored.snapshot ?: "" ) ? stored.snapshot : {};
		var clusters = isArray( snapshot.clusters ?: "" ) ? snapshot.clusters : [];
		var matches = clusters.filter( ( item ) => isStruct( item ) && toString( item.id ?: "" ) == clusterId );
		if ( !matches.len() ) return validationError( event, "clusterId is not present in the stored snapshot" );
		try {
			var saved = codeGraphRepository.saveUserLabel(
				stored.projectPath ?: run.getProjectPath(),
				codeGraphRepository.clusterKey( matches[ 1 ] ),
				labelValue,
				codeGraphRepository.clusterFingerprint( matches[ 1 ] )
			);
			event.renderData( type = "json", data = { data: { clusterId: clusterId, label: saved.label, provenance: "user" } } );
		} catch ( "ValidationException" error ) {
			validationError( event, error.message );
		}
	}

	/** Clear a user label so the next narrative can supply an AI label. */
	function clearLabel( event, rc, prc ) {
		var run = runService.getScoped( rc.id ?: "", prc.securityContext, rc.projectId ?: "" );
		if ( isNull( run ) || lCase( run.getRunKind() ?: "" ) != "codegraph" ) return notFound( event );
		var stored = codeGraphRepository.get( run.getId() );
		if ( isNull( stored ) ) return notFound( event );
		var clusterId = trim( toString( rc.clusterId ?: "" ) );
		if ( !len( clusterId ) ) return validationError( event, "clusterId is required" );
		var snapshot = isStruct( stored.snapshot ?: "" ) ? stored.snapshot : {};
		var clusters = isArray( snapshot.clusters ?: "" ) ? snapshot.clusters : [];
		var matches = clusters.filter( ( item ) => isStruct( item ) && toString( item.id ?: "" ) == clusterId );
		if ( !matches.len() ) return validationError( event, "clusterId is not present in the stored snapshot" );
		codeGraphRepository.clearUserLabel( stored.projectPath ?: run.getProjectPath(), codeGraphRepository.clusterKey( matches[ 1 ] ) );
		event.renderData( type = "json", data = { data: { clusterId: clusterId, cleared: true } } );
	}

	private void function notFound( required event ) {
		arguments.event.renderData(
				type       = "json",
				statusCode = 404,
				data       = { error: { code: "run_not_found", message: "Review run not found" } }
			);
	}

	private void function validationError( required event, required string message ) {
		arguments.event.renderData(
				type       = "json",
				statusCode = 422,
				data       = { error: { code: "validation_failed", message: arguments.message } }
			);
	}

	private boolean function hasIndexedGraph( required any run ) {
		try {
			var graph = graphRepository.getGraph( runId = arguments.run.getId(), resultLimit = 1 );
			var summary = isStruct( graph.summary ?: "" ) ? graph.summary : {};
			return val( summary.filesAnalyzed ?: 0 ) > 0 || ( isArray( graph.symbols ?: "" ) && graph.symbols.len() > 0 ) || ( isArray( graph.dependencies ?: "" ) && graph.dependencies.len() > 0 );
		} catch ( any ignored ) {
			return false;
		}
	}
}
