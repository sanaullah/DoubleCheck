/**
 * This is your application router.  From here you can controll all the incoming routes to your application.
 *
 * https://coldbox.ortusbooks.com/the-basics/routing
 */
class {

	function configure() {
		/**
		 * --------------------------------------------------------------------------
		 * App Routes
		 * --------------------------------------------------------------------------
		 */

		// @app_routes@
		route( "/api/v1/health" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiHealth" )
			.end();
		route( "/api/v1/capabilities" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiCapabilities" )
			.end();
		route( "/api/v1/ai/smoke" )
			.withVerbs( "GET" )
			.withAction( "smoke" )
			.toHandler( "ApiAI" )
			.end();
		route( "/api/v1/session" )
			.withVerbs( "GET" )
			.withAction( "show" )
			.toHandler( "ApiSession" )
			.end();
		route( "/api/v1/projects" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiProjects" )
			.end();
		route( "/api/v1/workers" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiWorkers" )
			.end();
		route( "/api/v1/quality" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiQuality" )
			.end();
		route( "/api/v1/history/:id/comparison" )
			.withVerbs( "GET" )
			.withAction( "comparison" )
			.toHandler( "ApiHistory" )
			.end();
		route( "/api/v1/history" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiHistory" )
			.end();
		route( "/api/v1/runs/:id/events" )
			.withVerbs( "GET" )
			.withAction( "events" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/event-log" )
			.withVerbs( "GET" )
			.withAction( "eventLog" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/traces" )
			.withVerbs( "GET" )
			.withAction( "traces" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/result" )
			.withVerbs( "GET" )
			.withAction( "result" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/findings/:fingerprint/review" )
			.withVerbs( "PUT" )
			.withAction( "updateFindingReview" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/rerun" )
			.withVerbs( "POST" )
			.withAction( "rerun" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/follow-up" )
			.withVerbs( "POST" )
			.withAction( "followUp" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/export" )
			.withVerbs( "GET" )
			.withAction( "export" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/modernization/phases/:phaseId/rebuild" )
			.withVerbs( "POST" )
			.withAction( "rebuildModernizationPhase" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/modernization/items/:itemId/decision" )
			.withVerbs( "PUT" )
			.withAction( "updateModernizationDecision" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/modernization/items/:itemId/decision" )
			.withVerbs( "DELETE" )
			.withAction( "clearModernizationDecision" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id" )
			.withAction( { GET: "show", DELETE: "cancel" } )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs" )
			.withAction( { GET: "index", POST: "create" } )
			.toHandler( "ApiRuns" )
			.end();

		// aiflight module explorer (independent of DoubleCheck review UX)
		route( "/aiflight" ).toModuleRouting( "aiFlight" );

		// Conventions-Based Routing
		route( ":handler/:action?" ).end();
	}
}
