/**
 * This is your application router.  From here you can controll all the incoming routes to your application.
 *
 * https://coldbox.ortusbooks.com/the-basics/routing
 */
class {

	function configure() {
		/**
		 * --------------------------------------------------------------------------
		 * App Routes
		 * --------------------------------------------------------------------------
		 */

		// @app_routes@
		route( "/api/v1/health" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiHealth" )
			.end();
		route( "/api/v1/capabilities" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiCapabilities" )
			.end();
		route( "/api/v1/openapi" )
			.withVerbs( "GET" )
			.withAction( "json" )
			.toHandler( "ApiOpenApi" )
			.end();
		route( "/api/v1/openapi.yaml" )
			.withVerbs( "GET" )
			.withAction( "yaml" )
			.toHandler( "ApiOpenApi" )
			.end();
		route( "/api/v1/ai/smoke" )
			.withVerbs( "GET" )
			.withAction( "smoke" )
			.toHandler( "ApiAI" )
			.end();
		route( "/api/v1/session" )
			.withVerbs( "GET" )
			.withAction( "show" )
			.toHandler( "ApiSession" )
			.end();
		route( "/api/v1/projects/tree" )
			.withVerbs( "GET" )
			.withAction( "tree" )
			.toHandler( "ApiProjects" )
			.end();
		route( "/api/v1/projects" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiProjects" )
			.end();
		route( "/api/v1/codegraph" )
			.withVerbs( "GET" )
			.withAction( "project" )
			.toHandler( "ApiCodeGraph" )
			.end();
		route( "/api/v1/workers" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiWorkers" )
			.end();
		route( "/api/v1/quality" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiQuality" )
			.end();
		route( "/api/v1/history/:id/comparison" )
			.withVerbs( "GET" )
			.withAction( "comparison" )
			.toHandler( "ApiHistory" )
			.end();
		route( "/api/v1/history" )
			.withVerbs( "GET" )
			.withAction( "index" )
			.toHandler( "ApiHistory" )
			.end();
		route( "/api/v1/runs/:id/events" )
			.withVerbs( "GET" )
			.withAction( "events" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/event-log" )
			.withVerbs( "GET" )
			.withAction( "eventLog" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/traces" )
			.withVerbs( "GET" )
			.withAction( "traces" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/result" )
			.withVerbs( "GET" )
			.withAction( "result" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/findings/:fingerprint/review" )
			.withVerbs( "PUT" )
			.withAction( "updateFindingReview" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/rerun" )
			.withVerbs( "POST" )
			.withAction( "rerun" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/follow-up" )
			.withVerbs( "POST" )
			.withAction( "followUp" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/modernization/continue" )
			.withVerbs( "POST" )
			.withAction( "continueModernize" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/export" )
			.withVerbs( "GET" )
			.withAction( "export" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/codegraph/subgraph" )
			.withVerbs( "GET" )
			.withAction( "subgraph" )
			.toHandler( "ApiCodeGraph" )
			.end();
		route( "/api/v1/runs/:id/codegraph/edges" )
			.withVerbs( "GET" )
			.withAction( "edges" )
			.toHandler( "ApiCodeGraph" )
			.end();
		route( "/api/v1/runs/:id/codegraph/paths" )
			.withVerbs( "GET" )
			.withAction( "paths" )
			.toHandler( "ApiCodeGraph" )
			.end();
		route( "/api/v1/runs/:id/codegraph/source" )
			.withVerbs( "GET" )
			.withAction( "source" )
			.toHandler( "ApiCodeGraph" )
			.end();
		route( "/api/v1/runs/:id/codegraph/narrative" )
			.withVerbs( "POST" )
			.withAction( "narrative" )
			.toHandler( "ApiCodeGraph" )
			.end();
		route( "/api/v1/runs/:id/codegraph/label" )
			.withAction( { PUT: "label", DELETE: "clearLabel" } )
			.toHandler( "ApiCodeGraph" )
			.end();
		route( "/api/v1/runs/:id/modernization/phases/:phaseId/rebuild" )
			.withVerbs( "POST" )
			.withAction( "rebuildModernizationPhase" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/modernization/items/:itemId/rebuild" )
			.withVerbs( "POST" )
			.withAction( "rebuildModernizationItem" )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id/modernization/items/:itemId/decision" )
			.withAction( { PUT: "updateModernizationDecision", DELETE: "clearModernizationDecision" } )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs/:id" )
			.withAction( { GET: "show", DELETE: "cancel" } )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/runs" )
			.withAction( { GET: "index", POST: "create" } )
			.toHandler( "ApiRuns" )
			.end();
		route( "/api/v1/ai-providers/:id/activate" )
			.withVerbs( "POST" )
			.withAction( "activate" )
			.toHandler( "ApiAIProviders" )
			.end();
		route( "/api/v1/ai-providers/:id/smoke" )
			.withVerbs( "POST" )
			.withAction( "smoke" )
			.toHandler( "ApiAIProviders" )
			.end();
		route( "/api/v1/ai-providers/:id" )
			.withAction( { GET: "show", PUT: "update", DELETE: "delete" } )
			.toHandler( "ApiAIProviders" )
			.end();
		route( "/api/v1/ai-providers" )
			.withAction( { GET: "index", POST: "create" } )
			.toHandler( "ApiAIProviders" )
			.end();
		route( "/api/v1/app-settings" )
			.withAction( { GET: "index", PUT: "update" } )
			.toHandler( "ApiAppSettings" )
			.end();

		// aiflight module explorer (independent of DoubleCheck review UX)
		route( "/aiflight" ).toModuleRouting( "aiFlight" );

		// Workspace pages
		route( "/review" )
			.withVerbs( "GET" )
			.withAction( "review" )
			.toHandler( "Main" )
			.end();
		route( "/modernize" )
			.withVerbs( "GET" )
			.withAction( "modernize" )
			.toHandler( "Main" )
			.end();
		route( "/codegraph" )
			.withVerbs( "GET" )
			.withAction( "codegraph" )
			.toHandler( "Main" )
			.end();

		// Conventions-Based Routing
		route( ":handler/:action?" ).end();
	}
}
