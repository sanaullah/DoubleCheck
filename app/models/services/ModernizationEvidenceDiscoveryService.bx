/**
 * Discovers a small, Modernize-only set of configuration and migration
 * evidence. Review's ordinary scanner remains unchanged.
 */
@singleton
class {
	property name="maxFiles" inject="coldbox:setting:modernizeEvidenceMaxFiles";
	property name="maxBytes" inject="coldbox:setting:modernizeEvidenceMaxBytes";
	property name="secretRedactionService" inject="SecretRedactionService";
	variables.defaults = { maxFiles: 100, maxBytes: 1048576 };

	function init() {
		if ( isNull( variables.secretRedactionService ?: javacast( "null", "" ) ) ) variables.secretRedactionService = new app.models.services.SecretRedactionService();
		return this;
	}

	struct function discover(required string projectPath, struct options = {}) {
		var root = createObject( "java", "java.io.File" ).init( arguments.projectPath ).getCanonicalFile();
		if ( !root.isDirectory() ) throw( type="ModernizationEvidenceInputException", message="Project path is not a directory" );
		var fileLimit = val( arguments.options.maxFiles ?: variables.maxFiles ?: variables.defaults.maxFiles );
		var byteLimit = val( arguments.options.maxBytes ?: variables.maxBytes ?: variables.defaults.maxBytes );
		if ( fileLimit <= 0 ) fileLimit = variables.defaults.maxFiles;
		if ( byteLimit <= 0 ) byteLimit = variables.defaults.maxBytes;
		var allow = [ "server.json", "server.json.cfm", "Application.cfc", "Application.bx", "web.config", ".htaccess", "urlrewrite.xml", "rewrite.xml", "config/ColdBox.cfc", "config/ColdBox.bx", "config/Router.cfc", "config/Router.bx", "config/routes.cfm", "config/settings.cfm" ];
		var candidates = [];
		for ( var relativePath in arguments.options.relativePaths ?: [] ) {
			var normalized = normalizePath( relativePath );
			if ( reFind( "^(?:[A-Za-z]:|/)", normalized ) || listFind( normalized, "..", "/" ) ) continue;
			var candidate = createObject( "java", "java.io.File" ).init( root, normalized ).getCanonicalFile();
			if ( candidate.toPath().startsWith( root.toPath() ) && candidate.isFile() ) candidates.append( candidate );
		}
		// Built-in names are intentionally narrow. Migration directories are only
		// searched when the caller explicitly opts in.
		for ( var name in allow ) {
			var candidatePath = createObject( "java", "java.io.File" ).init( root, name );
			var canonicalCandidate = candidatePath.getCanonicalFile();
			if ( canonicalCandidate.toPath().startsWith( root.toPath() ) && canonicalCandidate.isFile() && !candidates.map( ( item ) => item.getCanonicalPath() ).contains( canonicalCandidate.getCanonicalPath() ) ) candidates.append( canonicalCandidate );
		}
		for ( var migrationRoot in arguments.options.migrationPaths ?: [] ) {
			var normalizedMigration = normalizePath( migrationRoot );
			if ( reFind( "^(?:[A-Za-z]:|/)", normalizedMigration ) || listFind( normalizedMigration, "..", "/" ) ) continue;
			var folder = createObject( "java", "java.io.File" ).init( root, normalizedMigration ).getCanonicalFile();
			if ( !folder.toPath().startsWith( root.toPath() ) || !folder.isDirectory() ) continue;
			var listed = directoryList( folder.getPath(), true, "query" );
			for ( var row = 1; row <= listed.recordCount; row++ ) {
				if ( lCase( listed.type[ row ] ?: "file" ) != "file" ) continue;
				var itemFile = createObject( "java", "java.io.File" ).init( listed.directory[ row ] & createObject( "java", "java.io.File" ).separator & listed.name[ row ] ).getCanonicalFile();
				if ( itemFile.toPath().startsWith( root.toPath() ) && itemFile.isFile() && !candidates.map( ( entry ) => entry.getCanonicalPath() ).contains( itemFile.getCanonicalPath() ) ) candidates.append( itemFile );
			}
		}
		candidates.sort( ( a, b ) => compareNoCase( a.getCanonicalPath(), b.getCanonicalPath() ) );
		var files = [];
		var routeEvidence = [];
		var skipped = { limit: 0, oversized: 0, unreadable: 0, unsupported: 0 };
		var bytes = 0;
		var dmlRemoved = 0;
		for ( var candidate in candidates ) {
			if ( files.len() >= fileLimit ) { skipped.limit++; continue; }
			var extension = lCase( listLast( candidate.getName(), "." ) );
			if ( !listFindNoCase( "json,cfm,cfc,bx,config,xml,htaccess,sql", extension ) && candidate.getName() != ".htaccess" ) { skipped.unsupported++; continue; }
			var size = candidate.length();
			if ( bytes + size > byteLimit ) { skipped.oversized++; continue; }
			try {
				var original = fileRead( candidate.getPath(), "UTF-8" );
				// Strip row-level DML before redaction so the removal count remains
				// observable even when the redactor replaces a sensitive migration
				// document wholesale.
				var dmlSafe = stripRowDml( original );
				var redacted = variables.secretRedactionService.redactText( dmlSafe.text );
				var safeEvidence = { text: redacted, removed: dmlSafe.removed };
				dmlRemoved += safeEvidence.removed;
				var rel = normalizePath( root.toPath().relativize( candidate.toPath() ).toString() );
				files.append( { filePath: rel, contentHash: lCase( hash( safeEvidence.text, "SHA-256" ) ), sizeBytes: len( safeEvidence.text ), content: safeEvidence.text, extractionMethod: "allowlisted-evidence-v1", dmlRemoved: safeEvidence.removed } );
				var safeLines = listToArray( replace( safeEvidence.text, "\\n", char( 10 ), "all" ), char( 10 ), true, true );
				for ( var lineNumber = 1; lineNumber <= safeLines.len(); lineNumber++ ) {
					var evidenceLine = safeLines[ lineNumber ];
					var rewriteTokens = reReplace( trim( evidenceLine ), "\\s+", " ", "all" ).listToArray( " " );
					if ( rewriteTokens.len() >= 3 && compareNoCase( rewriteTokens[ 1 ], "RewriteRule" ) == 0 ) routeEvidence.append( { id: lCase( hash( "rewrite|#rel#|#lineNumber#", "SHA-256" ) ), legacyPath: rewriteTokens[ 2 ], targetPath: rewriteTokens[ 3 ], method: "GET", routeKind: "rewrite-config", filePath: rel, startLine: lineNumber, endLine: lineNumber, extractionMethod: "rewrite-config-regex-v1", evidenceRefs: [ { filePath: rel, startLine: lineNumber, endLine: lineNumber, extractionMethod: "rewrite-config-regex-v1", contentHash: files[ files.len() ].contentHash, snippet: left( trim( evidenceLine ), 240 ) } ], unresolved: find( char( 35 ), evidenceLine ) > 0 } );
				}
				bytes += size;
			} catch ( any error ) { skipped.unreadable++; }
		}
		return { version: "modernization-evidence-v1", files: files, routeEvidence: routeEvidence, bytes: bytes, candidateCount: candidates.len(), dmlRemoved: dmlRemoved, skipped: skipped, truncated: skipped.limit > 0 || skipped.oversized > 0, fingerprint: lCase( hash( jsonSerialize( files.map( ( item ) => item.filePath & ":" & item.contentHash ) ) & jsonSerialize( routeEvidence ), "SHA-256" ) ) };
	}

	struct function build(required string projectPath, struct options = {}) returntype="struct" { return discover( arguments.projectPath, arguments.options ); }
	private struct function stripRowDml( required string text ) {
		var kept = [];
		var removed = 0;
		var dropping = false;
		for ( var line in listToArray( replace( arguments.text, char( 13 ), "", "all" ), char( 10 ), true, true ) ) {
			if ( !dropping && isDmlStatement( line ) ) {
				removed++;
				dropping = find( ";", line ) == 0;
				continue;
			}
			if ( dropping ) {
				removed++;
				if ( find( ";", line ) ) dropping = false;
				continue;
			}
			kept.append( line );
		}
		return { text: kept.toList( char( 10 ) ), removed: removed };
	}
	private boolean function isDmlStatement( required string line ) {
		var value = uCase( trim( arguments.line ) );
		for ( var keyword in [ "INSERT ", "UPDATE ", "DELETE ", "MERGE ", "UPSERT " ] ) if ( left( value, len( keyword ) ) == keyword ) return true;
		return false;
	}
	private string function normalizePath(required string path) { return replace( replace( arguments.path ?: "", "\\", "/", "all" ), "//", "/", "all" ); }
}
