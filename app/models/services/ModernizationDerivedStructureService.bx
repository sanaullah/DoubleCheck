/**
 * Derived structure for Modernize: clusters, architecture decisions and roadmap
 * phases computed from evidence rather than invented by a model.
 *
 * This is the promotion the plan is named for. Every function here already
 * existed inside ModernizationProposalService as the fallback path used when
 * the provider under-delivered; it is moved verbatim so the diff is a move, not
 * a rewrite, and re-pointed at the coupling graph in a separate change.
 *
 * Deterministic by contract: no gateway, no agent factory, no provider. That is
 * what keeps the deterministic corpus tier runnable without a key, and it is
 * asserted by ArchitectureFitnessSpec.
 *
 * @see ModernizationCouplingGraphService
 * @see ModernizationProposalService
 */
@singleton
class threadsafe {

	property name="identityService" inject="ModernizationIdentityService";
	// Placement owns the stayInMonolith derivation; this service asks rather
	// than re-deriving. Both are deterministic, so the no-gateway invariant holds.
	property name="placementService" inject="ModernizationPlacementService";
	property name="log" inject="logbox:logger:{this}";

	// Configuration, not state. These were class-body constants on
	// ModernizationProposalService and carry the same values.
	variables.maxRoadmapShards             = 24;
	variables.minUnitsForFolderInference   = 24;
	variables.maxInferredArchitectureScopes = 12;

	// --- clustering weights -------------------------------------------------
	// Relative, not absolute: only their ratio matters to modularity. Sharing a
	// table is stronger evidence of one domain than a single call is, because a
	// call can be a utility reference while co-written state cannot be split.
	variables.sharedTableWeight = 2.0;
	variables.sharedScopeWeight = 1.5;

	// A table touched by more than this many files is infrastructure -- an audit
	// log, a users table, a settings row -- and says nothing about where a seam
	// runs. Counting it as coupling would drag every domain into one cluster,
	// which is the degeneracy this algorithm exists to avoid.
	variables.maxCoAccessFanout = 12;

	variables.maxLouvainPasses = 20;

	function init() {
		if ( isNull( variables.identityService ?: javacast( "null", "" ) ) ) {
			variables.identityService = new app.models.services.ModernizationIdentityService();
		}
		if ( isNull( variables.placementService ?: javacast( "null", "" ) ) ) {
			variables.placementService = new app.models.services.ModernizationPlacementService();
		}
		return this;
	}

	/**
	 * When the provider roadmap is skipped (cost/time), still emit mapped phases
	 * from retained target/route ids so the Solution Road is usable.
	 */
	public struct function applySynthesizedRoadmap( required struct plan, array errors = [] ) {
		var phases = synthesizeRoadmapPhases( arguments.plan );
		if ( !phases.len() ) return arguments.plan;
		arguments.plan.roadmapPhases = phases;
		for ( var phase in arguments.plan.roadmapPhases ) ensureIdentity( phase, "roadmap-phase" );
		arguments.errors.append( { role: "modernization-roadmap", message: "synthesized-from-application-maps", severity: "info" } );
		arguments.plan.metadata = isStruct( arguments.plan.metadata ?: "" ) ? arguments.plan.metadata : {};
		arguments.plan.metadata.roadmapSource = "synthesized";
		logInfo( "Modernize roadmap synthesized from application maps (#arguments.plan.roadmapPhases.len()# phase(s))" );
		return arguments.plan;
	}

	private array function synthesizeRoadmapPhases( required struct plan ) {
		var units = isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [];
		var routes = isArray( arguments.plan.routeContracts ?: "" ) ? arguments.plan.routeContracts : [];
		if ( !units.len() && !routes.len() ) return [];
		var foundation = [];
		var feature = [];
		for ( var unit in units ) {
			if ( !isStruct( unit ) ) continue;
			var path = lCase( trim( scalarString( unit.targetPath ?: unit.sourcePath ?: unit.id ?: "" ) ) );
			if ( reFindNoCase( "application\.|coldbox\.|/config/|\\config\\|router\.|/routes", path ) ) foundation.append( unit );
			else feature.append( unit );
		}
		var phases = [];
		if ( foundation.len() ) {
			phases.append( {
				id: "phase-foundation",
				name: "Foundation and config",
				goal: "Stand up modern Application/config/router coexistence before feature slices.",
				pattern: "foundation",
				classification: "refactor-monolith",
				wave: 0,
				estimatedComplexity: "medium",
				risks: [ "Shared bootstrap changes can break every coexist route." ],
				rollbackStrategy: "Keep legacy Application/config as default entry until coexist routes prove stable.",
				testingStrategy: "Boot smoke, router coexist checks, and config parity against legacy entrypoints.",
				dependencies: [],
				unitIds: foundation.map( ( item ) => item.id ?: item.itemId ?: "" ).filter( ( id ) => len( trim( id ) ) ),
				routeIds: [],
				dbFindingIds: [],
				transitionIds: [],
				sampleIds: [],
				parityIntent: "Boot and config parity with legacy Application/ColdBox entrypoints.",
				exitCriteria: [ "Modern app boots", "Router/config coexist with legacy", "No big-bang cutover" ],
				rollback: "Keep legacy Application/config as default entry until coexist routes prove stable.",
				implementerPrompt: "Implement foundation targets first. Do not migrate feature handlers until config and routing coexist.",
				provenanceClass: "deterministically-derived",
				currentSlice: false
			} );
		}
		var sliceUnits = feature.len() ? feature : units;
		// applySynthesizedRoadmap() always runs before applySynthesizedArchitecture(),
		// so target.contexts/.extracts here are either real architecture output or
		// genuinely empty — never the single "keep everything centralized" fallback
		// context. When real groups exist, follow them into one phase per group
		// instead of an arbitrary count-based split.
		var groups = synthesisRoadmapGroups( arguments.plan );
		if ( groups.len() ) {
			phases.append( synthesizeGroupedPhases( sliceUnits, routes, groups, foundation.len() ), true );
			return phases;
		}
		var sliceSize = min( 8, sliceUnits.len() );
		var firstSlice = [];
		for ( var i = 1; i <= sliceSize; i++ ) firstSlice.append( sliceUnits[ i ] );
		var firstIds = firstSlice.map( ( item ) => item.id ?: item.itemId ?: "" ).filter( ( id ) => len( trim( id ) ) );
		var firstIdSet = {};
		for ( var id in firstIds ) firstIdSet[ id ] = true;
		var sliceRoutes = routesForUnitIds( routes, firstIdSet, true );
		phases.append( {
			id: "phase-first-slice",
			name: "First vertical slice",
			goal: "Deliver one coexist-route vertical slice with mapped targets and routes.",
			pattern: "vertical-slice",
			dependencies: foundation.len() ? [ "phase-foundation" ] : [],
			unitIds: firstIds,
			routeIds: sliceRoutes,
			dbFindingIds: [],
			transitionIds: [],
			sampleIds: [],
			parityIntent: "Feature parity for the first mapped slice only.",
			exitCriteria: [ "Coexist route serves the slice", "Target handlers/services compile", "Legacy path remains rollback" ],
			rollback: "Route traffic back to legacy paths for this slice.",
			implementerPrompt: "Implement only the listed target units and coexist routes. Keep unlisted legacy files untouched.",
			provenanceClass: "deterministically-derived",
			currentSlice: true
		} );
		if ( sliceUnits.len() > sliceSize ) {
			var later = [];
			for ( var j = sliceSize + 1; j <= sliceUnits.len(); j++ ) later.append( sliceUnits[ j ].id ?: sliceUnits[ j ].itemId ?: "" );
			phases.append( {
				id: "phase-continue-strangler",
				name: "Continue strangler slices",
				goal: "Migrate remaining mapped targets in later coexist slices.",
				pattern: "coexist-route",
				dependencies: [ "phase-first-slice" ],
				unitIds: later.filter( ( id ) => len( trim( id ) ) ),
				routeIds: [],
				dbFindingIds: [],
				transitionIds: [],
				sampleIds: [],
				parityIntent: "Incremental strangler coverage for remaining mapped files.",
				exitCriteria: [ "Each later slice has coexist routing", "No big-bang retirement" ],
				rollback: "Leave later slices on legacy until accepted.",
				implementerPrompt: "Rebuild one later slice at a time from the retained target map.",
				provenanceClass: "deterministically-derived",
				currentSlice: false
			} );
		}
		return phases;
	}

	/** Route ids whose target unit falls inside unitIdSet. Falls back to the
	 * first few unlinked routes only when nothing in the plan is linked yet
	 * (mirrors the previous inline behavior for the count-based fallback). */
	private array function routesForUnitIds( required array routes, required struct unitIdSet, boolean fallbackToUnlinked = false ) {
		var matched = [];
		for ( var route in arguments.routes ) {
			if ( !isStruct( route ) ) continue;
			var related = route.targetUnitId ?: "";
			if ( !len( related ) && isArray( route.relatedItemIds ?: "" ) && route.relatedItemIds.len() ) related = route.relatedItemIds[ 1 ];
			if ( len( related ) && arguments.unitIdSet.keyExists( related ) ) matched.append( route.id ?: route.itemId ?: "" );
			if ( matched.len() >= 8 ) break;
		}
		if ( !matched.len() && arguments.fallbackToUnlinked && !arguments.unitIdSet.count() ) {
			for ( var route in arguments.routes ) {
				if ( isStruct( route ) ) matched.append( route.id ?: route.itemId ?: "" );
				if ( matched.len() >= 6 ) break;
			}
		}
		return matched.filter( ( id ) => len( trim( id ) ) );
	}

	/** Real (non-degenerate) context/extract groupings, each with the units they
	 * cover. Empty when the architecture role hasn't produced anything yet. */
	/**
	 * Groups roadmap leftovers by feature directory so each shard names a real
	 * domain instead of "Continue strangler slices (3)".
	 *
	 * Uses the unit's legacy sourcePath (falling back to targetPath) because that
	 * is the same signal the deterministic architecture gap-fill uses when it
	 * later invents module candidates; grouping the same way keeps roadmap phase
	 * names aligned with the placements the finished plan ends up with.
	 *
	 * Groups are ordered largest-first (ties broken by name) so shard order is
	 * deterministic across runs.
	 */
	public array function leftoverRoadmapGroups( required array units, required array leftoverIds ) {
		if ( !arguments.leftoverIds.len() ) return [];
		var unitsById = {};
		for ( var unit in arguments.units ) {
			if ( !isStruct( unit ) ) continue;
			var unitId = trim( toString( unit.id ?: unit.itemId ?: "" ) );
			if ( len( unitId ) ) unitsById[ unitId ] = unit;
		}
		var buckets = {};
		var order = [];
		for ( var leftoverId in arguments.leftoverIds ) {
			var id = trim( toString( leftoverId ) );
			if ( !len( id ) ) continue;
			var unitRecord = unitsById[ id ] ?: {};
			var key = featureDomainKey( isStruct( unitRecord ) ? unitRecord : {} );
			if ( !buckets.keyExists( key ) ) {
				buckets[ key ] = [];
				order.append( key );
			}
			buckets[ key ].append( id );
		}
		var groups = [];
		for ( var key in order ) {
			groups.append( {
				name: featureDomainLabel( key ),
				targetUnitIds: buckets[ key ],
				kind: "leftover"
			} );
		}
		groups.sort( ( a, b ) => {
			if ( a.targetUnitIds.len() != b.targetUnitIds.len() ) return b.targetUnitIds.len() - a.targetUnitIds.len();
			return compareNoCase( a.name, b.name );
		} );
		return groups;
	}

	/** Feature-directory key for one target unit; "" when nothing usable exists. */
	private string function featureDomainKey( required struct unit ) {
		var path = normalizeLegacyPath( arguments.unit.sourcePath ?: "" );
		if ( !len( trim( path ) ) ) path = normalizeLegacyPath( arguments.unit.targetPath ?: "" );
		var segments = [];
		for ( var segment in listToArray( path, "/" ) ) {
			var cleaned = trim( segment );
			if ( len( cleaned ) ) segments.append( cleaned );
		}
		// Last segment is the file itself, not a domain.
		if ( segments.len() ) segments.deleteAt( segments.len() );
		if ( !segments.len() ) return "";
		// A container folder says nothing about the feature; reach one level in.
		var containers = [ "app", "src", "cfc", "com", "lib", "libs", "includes", "include", "core", "shared", "common", "handlers", "views", "models", "services", "layouts" ];
		var first = lCase( segments[ 1 ] );
		if ( containers.contains( first ) && segments.len() >= 2 ) return lCase( segments[ 1 ] & "/" & segments[ 2 ] );
		return first;
	}

	/** Human label for a feature-directory key. */
	private string function featureDomainLabel( required string key ) {
		if ( !len( trim( arguments.key ) ) ) return "Remaining application slices";
		var words = [];
		for ( var segment in listToArray( arguments.key, "/" ) ) {
			// Split camelCase and separator-delimited folder names into words.
			var spaced = reReplace( segment, "([a-z0-9])([A-Z])", "\1 \2", "all" );
			spaced = reReplace( spaced, "[_\-\.]+", " ", "all" );
			for ( var word in listToArray( spaced, " " ) ) {
				var cleaned = trim( word );
				// right( value, 0 ) throws "Count cannot be zero" in BoxLang, so a
			// single-character word must not take the general path. Reachable
			// from any one-letter folder, and from camelCase splitting like
			// "aService" -> "a Service".
			if ( len( cleaned ) == 1 ) words.append( uCase( cleaned ) );
			else if ( len( cleaned ) > 1 ) words.append( uCase( left( cleaned, 1 ) ) & lCase( right( cleaned, len( cleaned ) - 1 ) ) );
			}
		}
		if ( !words.len() ) return "Remaining application slices";
		return words.toList( " " );
	}

	public array function synthesisRoadmapGroups( required struct plan ) {
		var target = isStruct( arguments.plan.target ?: "" ) ? arguments.plan.target : {};
		var groups = [];
		for ( var placement in ( isArray( target.placements ?: "" ) ? target.placements : [] ) ) {
			if ( !isStruct( placement ) || !isArray( placement.targetUnitIds ?: "" ) || !placement.targetUnitIds.len() ) continue;
			groups.append( {
				name: placement.name ?: placement.domainKey ?: "Capability",
				targetUnitIds: placement.targetUnitIds,
				placementType: placement.placementType ?: "main-app",
				kind: ( placement.placementType ?: "main-app" ) == "external-service" ? "extract" : "context"
			} );
		}
		if ( groups.len() ) return groups;
		for ( var ctx in ( isArray( target.contexts ?: "" ) ? target.contexts : [] ) ) {
			if ( isStruct( ctx ) && isArray( ctx.targetUnitIds ?: "" ) && ctx.targetUnitIds.len() ) {
				groups.append( { name: ctx.name ?: "Slice", targetUnitIds: ctx.targetUnitIds, kind: "context" } );
			}
		}
		for ( var ext in ( isArray( target.extracts ?: "" ) ? target.extracts : [] ) ) {
			if ( isStruct( ext ) && isArray( ext.targetUnitIds ?: "" ) && ext.targetUnitIds.len() ) {
				groups.append( { name: ext.name ?: "Extract", targetUnitIds: ext.targetUnitIds, kind: "extract" } );
			}
		}
		return groups;
	}

	/** Map placement taxonomy onto roadmap classification vocabulary. */
	public string function synthesizeRoadmapClassification( required string placementType ) {
		var normalized = lCase( trim( arguments.placementType ) );
		if ( normalized == "coldbox-module" ) return "coldbox-module";
		if ( normalized == "background-worker" ) return "background-worker";
		if ( normalized == "scheduled-service" ) return "scheduled-service";
		if ( normalized == "external-service" ) return "external-service";
		if ( normalized == "worker" ) return "background-worker";
		return "refactor-monolith";
	}

	/** One roadmap phase per context/extract/placement group (capped near the
	 * roadmap shard ceiling), chained sequentially so the Road still reads as
	 * one strangler step at a time. Units no group covers land in batched
	 * trailing "continue strangler" phases. */
	public array function synthesizeGroupedPhases( required array sliceUnits, required array routes, required array groups, required boolean hasFoundation ) {
		var covered = {};
		var phases = [];
		var previousPhaseId = arguments.hasFoundation ? "phase-foundation" : "";
		var index = 0;
		var groupCap = max( 8, min( variables.maxRoadmapShards, arguments.groups.len() ) );
		for ( var group in arguments.groups ) {
			if ( index >= groupCap ) break;
			var groupIds = [];
			for ( var unitId in group.targetUnitIds ) {
				var id = trim( toString( unitId ) );
				if ( len( id ) && !covered.keyExists( id ) ) groupIds.append( id );
			}
			if ( !groupIds.len() ) continue;
			for ( var id in groupIds ) covered[ id ] = true;
			index++;
			var idSet = {};
			for ( var id in groupIds ) idSet[ id ] = true;
			var isExtract = ( group.kind ?: "" ) == "extract";
			var classification = synthesizeRoadmapClassification( group.placementType ?: ( isExtract ? "external-service" : "main-app" ) );
			phases.append( {
				id: "phase-slice-" & index,
				name: group.name,
				goal: isExtract
					? "Extract #group.name# behind a coexist boundary, verified before any deployment split."
					: "Migrate the #group.name# slice behind ColdBox, one strangler step at a time.",
				pattern: isExtract ? "side-app-extract" : "vertical-slice",
				classification: classification,
				wave: index,
				estimatedComplexity: groupIds.len() > 40 ? "high" : ( groupIds.len() > 15 ? "medium" : "low" ),
				risks: [
					"Coexistence cutover may regress routes shared with unmigrated legacy callers.",
					"Schema or credential coupling may block an early extract."
				],
				rollbackStrategy: "Route traffic back to legacy paths for this slice.",
				testingStrategy: "Parity checks for the listed target units, coexist route smoke, and rollback drill before advancing the wave.",
				dependencies: len( previousPhaseId ) ? [ previousPhaseId ] : [],
				unitIds: groupIds,
				routeIds: routesForUnitIds( arguments.routes, idSet ),
				dbFindingIds: [],
				transitionIds: [],
				sampleIds: [],
				parityIntent: "Feature parity for the #group.name# slice only.",
				exitCriteria: [ "Coexist route serves the slice", "Target handlers/services compile", "Legacy path remains rollback" ],
				rollback: "Route traffic back to legacy paths for this slice.",
				implementerPrompt: "Implement only the listed target units and coexist routes for #group.name#. Keep unlisted legacy files untouched.",
				provenanceClass: "deterministically-derived",
				currentSlice: index == 1
			} );
			previousPhaseId = "phase-slice-" & index;
		}
		var leftover = [];
		for ( var unit in arguments.sliceUnits ) {
			var id = trim( toString( unit.id ?: unit.itemId ?: "" ) );
			if ( len( id ) && !covered.keyExists( id ) ) leftover.append( id );
		}
		if ( leftover.len() ) {
			var leftoverBatch = 48;
			var leftoverIndex = 0;
			while ( leftover.len() && phases.len() < variables.maxRoadmapShards + 1 ) {
				leftoverIndex++;
				var batch = [];
				while ( batch.len() < leftoverBatch && leftover.len() ) {
					batch.append( leftover[ 1 ] );
					leftover.deleteAt( 1 );
				}
				var phaseId = leftoverIndex == 1 && !leftover.len() ? "phase-continue-strangler" : "phase-continue-strangler-" & leftoverIndex;
				phases.append( {
					id: phaseId,
					name: leftoverIndex == 1 ? "Continue strangler slices" : "Continue strangler slices (#leftoverIndex#)",
					goal: "Migrate remaining mapped targets not covered by an identified slice.",
					pattern: "coexist-route",
					classification: "refactor-monolith",
					wave: index + leftoverIndex,
					estimatedComplexity: batch.len() > 24 ? "high" : "medium",
					risks: [ "Ungrouped leftovers may mix unrelated domains in one wave." ],
					rollbackStrategy: "Leave later slices on legacy until accepted.",
					testingStrategy: "Rebuild one leftover batch at a time and verify coexist routing before advancing.",
					dependencies: len( previousPhaseId ) ? [ previousPhaseId ] : [],
					unitIds: batch,
					routeIds: [],
					dbFindingIds: [],
					transitionIds: [],
					sampleIds: [],
					parityIntent: "Incremental strangler coverage for remaining mapped files.",
					exitCriteria: [ "Each later slice has coexist routing", "No big-bang retirement" ],
					rollback: "Leave later slices on legacy until accepted.",
					implementerPrompt: "Rebuild one later slice at a time from the retained target map.",
					provenanceClass: "deterministically-derived",
					currentSlice: !phases.len()
				} );
				previousPhaseId = phaseId;
			}
		}
		return phases;
	}

	public boolean function architectureDecisionsMissing( required struct plan ) {
		var placements = isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.placements ?: "" ) ? arguments.plan.target.placements : [];
		var contexts = isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.contexts ?: "" ) ? arguments.plan.target.contexts : [];
		var extracts = isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.extracts ?: "" ) ? arguments.plan.target.extracts : [];
		return !placements.len() && !contexts.len() && !extracts.len();
	}

	/**
	 * Fill contexts/extracts from maps + signals when shards omitted them
	 * (to avoid truncation). Follows modular-monolith-first packaging policy.
	 */
	public struct function applySynthesizedArchitecture( required struct plan, required struct evidence, array errors = [] ) {
		var built = synthesizeArchitectureDecisions( arguments.plan, arguments.evidence );
		if ( !built.contexts.len() && !built.extracts.len() && !built.unitLinks.len() && !( isArray( built.placements ?: "" ) && built.placements.len() ) ) return arguments.plan;
		arguments.plan.target = isStruct( arguments.plan.target ?: "" ) ? arguments.plan.target : { units: [], contexts: [], extracts: [], placements: [] };
		arguments.plan.target.contexts = built.contexts;
		arguments.plan.target.extracts = built.extracts;
		if ( isArray( built.placements ?: "" ) && built.placements.len() ) {
			arguments.plan.target.placements = built.placements;
			for ( var placement in arguments.plan.target.placements ) ensureIdentity( placement, "placement" );
		}
		if ( !isArray( arguments.plan.unitLinks ?: "" ) ) arguments.plan.unitLinks = [];
		arguments.plan.unitLinks.append( built.unitLinks, true );
		arguments.plan.unitLinks = dedupeById( arguments.plan.unitLinks );
		for ( var item in arguments.plan.target.contexts ) ensureIdentity( item, "context" );
		for ( var item in arguments.plan.target.extracts ) ensureIdentity( item, "extract" );
		for ( var link in built.unitLinks ) ensureIdentity( link, "unit-link" );
		arguments.errors.append( { role: "modernization-application", message: "synthesized-architecture-packaging", severity: "info" } );
		arguments.plan.metadata = isStruct( arguments.plan.metadata ?: "" ) ? arguments.plan.metadata : {};
		arguments.plan.metadata.architectureSource = "synthesized";
		logInfo( "Modernize architecture packaging synthesized: contexts=#built.contexts.len()#, placements=#( isArray( built.placements ?: '' ) ? built.placements.len() : 0 )#, extracts=#built.extracts.len()#" );
		return normalizeArchitecturePlacementTypes( arguments.plan );
	}

	private struct function synthesizeArchitectureDecisions( required struct plan, required struct evidence ) {
		var units = isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [];
		var evidenceByUnit = {};
		for ( var unit in units ) {
			if ( !isStruct( unit ) ) continue;
			var unitId = trim( unit.id ?: unit.itemId ?: "" );
			if ( !len( unitId ) ) continue;
			evidenceByUnit[ unitId ] = evidenceRefsForUnit( unit );
		}
		if ( !units.len() ) return { contexts: [], extracts: [], unitLinks: [], placements: [] };
		var scopePaths = isArray( arguments.evidence.scopePaths ?: "" )
			? arguments.evidence.scopePaths
			: ( isStruct( arguments.evidence.input ?: "" ) && isArray( arguments.evidence.input.scopePaths ?: "" ) ? arguments.evidence.input.scopePaths : [] );
		var clusters = clusterUnitsForArchitecture( units, scopePaths );
		var contexts = [];
		var placements = [];
		for ( var cluster in clusters ) {
			var packaging = cluster.placementType == "coldbox-module" ? "coldbox-module" : ( [ "background-worker", "scheduled-service" ].contains( cluster.placementType ) ? "worker" : "centralized" );
			contexts.append( {
				id: cluster.id,
				name: cluster.name,
				purpose: cluster.purpose,
				packaging: packaging,
				placementType: cluster.placementType,
				domainKey: cluster.domainKey,
				recommendation: cluster.rationale,
				stayInMonolith: placementService.staysInMonolith( cluster.placementType ),
				targetUnitIds: duplicate( cluster.targetUnitIds ),
				evidenceRefs: evidenceRefsForUnitIds( cluster.targetUnitIds, evidenceByUnit ),
				newProposal: true,
				proposalReason: cluster.rationale,
				provenanceClass: "deterministically-derived"
			} );
			placements.append( {
				id: cluster.id,
				domainKey: cluster.domainKey,
				name: cluster.name,
				placementType: cluster.placementType,
				targetUnitIds: duplicate( cluster.targetUnitIds ),
				rationale: cluster.rationale,
				evidenceRefs: evidenceRefsForUnitIds( cluster.targetUnitIds, evidenceByUnit ).map( ( ref ) => {
					if ( isStruct( ref ) ) return trim( toString( ref.filePath ?: ref.ref ?: ref.legacyUnitId ?: "" ) );
					return trim( toString( ref ) );
				} ).filter( ( item ) => len( item ) ),
				uncertainty: [],
				questions: [],
				provenanceClass: "deterministically-derived"
			} );
		}
		return { contexts: contexts, extracts: [], unitLinks: [], placements: placements };
	}

	/**
	 * Path-aware packaging fallback used when the architecture role fails.
	 * Scoped directories become distinct placements (nested feature folders →
	 * coldbox-module candidates; scheduled/job folders → background-worker)
	 * so the roadmap still gets seams without estate-specific folder names.
	 */
	/**
	 * Derive clusters from coupling rather than folders.
	 *
	 * Membership is decided by three kinds of evidence, unioned:
	 *
	 *   structural edges   a calls/extends/includes b
	 *   table co-access    a and b read or write the same table
	 *   shared scope       a and b touch the same application/session/client state
	 *
	 * Table co-access, not datasource, is the discriminator. A monolith usually
	 * has one datasource, so unioning on it would collapse every file into one
	 * cluster and reproduce the folder-inference degeneracy this replaces.
	 *
	 * This is what makes a false seam visible: two folders that never reference
	 * each other, but share four tables and session state, land in one cluster
	 * and are therefore not separable — a conclusion no folder heuristic can
	 * reach.
	 */
	public array function deriveClusters( required any graph, required array units, array scopePaths = [] ) {
		var nodes = arguments.graph.getNodes();
		if ( !nodes.len() ) return clusterUnitsForArchitecture( arguments.units, arguments.scopePaths );

		// --- communities from weighted modularity ----------------------------
		var affinity = buildAffinityGraph( arguments.graph, nodes );
		var community = louvainCommunities( affinity );
		community = mergeCycleCommunities( arguments.graph, community );

		var groups = {};
		for ( var node in nodes ) {
			var root = community[ node.id ] ?: node.id;
			if ( !groups.keyExists( root ) ) groups[ root ] = [];
			groups[ root ].append( node.id );
		}

		var unitsByFile = {};
		for ( var unit in arguments.units ) {
			var filePath = normalizeEvidencePath( unit.filePath ?: "" );
			if ( !len( filePath ) ) continue;
			if ( !unitsByFile.keyExists( filePath ) ) unitsByFile[ filePath ] = [];
			unitsByFile[ filePath ].append( trim( scalarString( unit.id ?: unit.itemId ?: "" ) ) );
		}

		var rootKeys = structKeyArray( groups );
		arraySort( rootKeys, "textnocase" );

		var clusters = [];
		for ( var root in rootKeys ) {
			var members = groups[ root ];
			members.sort( ( a, b ) => compareNoCase( a, b ) );
			var unitIds = [];
			for ( var filePath in members ) {
				for ( var unitId in ( unitsByFile[ filePath ] ?: [] ) ) {
					if ( len( unitId ) && !unitIds.contains( unitId ) ) unitIds.append( unitId );
				}
			}
			if ( !unitIds.len() ) continue;

			// Membership is derived; naming stays folder-shaped, which is what
			// folders are actually good for. featureDomainKey wants a unit.
			var domainKey = featureDomainKey( { sourcePath: members[ 1 ] } );
			if ( !len( domainKey ) ) domainKey = featureFolderFromPath( members[ 1 ] );
			if ( !len( domainKey ) ) domainKey = sanitizeDomainToken( listLast( members[ 1 ], "/" ) );
			if ( !len( domainKey ) ) domainKey = "main-app";

			clusters.append( {
				id           : "ctx-derived-" & left( identityService.itemId( "cluster", { files: members } ), 16 ),
				domainKey    : domainKey,
				name         : featureDomainLabel( domainKey ),
				placementType: "main-app",
				purpose      : "Derived from coupling evidence: structural edges, table co-access and shared scope state.",
				rationale    : "",
				targetUnitIds: unitIds,
				filePaths    : members,
				boundaryEvidence: {}
			} );
		}

		return classifyDerivedClusters( arguments.graph, clusters );
	}

	/**
	 * Derive migration order from the cluster DAG.
	 *
	 * A cluster depends on what it calls: if anything in A references anything
	 * in B, B has to exist in its new shape before A can move. Wave is longest-
	 * path depth over those dependencies, so a cluster never shares a wave with
	 * something it depends on — ordering becomes a property of the graph rather
	 * than of shard arrival order.
	 *
	 * Cluster-level cycles are possible even after file-level cycles are merged:
	 * A can call B in one file while B calls A in another, with no single file
	 * cycle. Those are condensed for ordering **and reported**, never silently
	 * broken — a cycle between clusters is a real finding about the system.
	 */
	public WaveOrder function deriveWaveOrder( required any graph, required array clusters ) {
		var clusterOf = {};
		for ( var cluster in arguments.clusters ) {
			for ( var filePath in cluster.filePaths ) clusterOf[ filePath ] = cluster.id;
		}

		var dependsOn = {};
		var blocks = {};
		for ( var cluster in arguments.clusters ) {
			dependsOn[ cluster.id ] = {};
			blocks[ cluster.id ] = {};
		}

		for ( var edge in arguments.graph.getEdges() ) {
			var from = clusterOf[ edge.fromFile ] ?: "";
			var to = clusterOf[ edge.toFile ] ?: "";
			if ( !len( from ) || !len( to ) || from == to ) continue;
			dependsOn[ from ][ to ] = true;
			blocks[ to ][ from ] = true;
		}

		var cycles = clusterCycles( dependsOn );

		// Condense each cycle to its lexicographically smallest member so the
		// ordering pass runs over a genuine DAG.
		var representative = {};
		for ( var clusterId in dependsOn ) representative[ clusterId ] = clusterId;
		for ( var cycle in cycles ) {
			var target = cycle[ 1 ];
			for ( var member in cycle ) representative[ member ] = target;
		}

		var condensed = {};
		for ( var clusterId in dependsOn ) {
			var source = representative[ clusterId ];
			if ( !condensed.keyExists( source ) ) condensed[ source ] = {};
			for ( var target in dependsOn[ clusterId ] ) {
				var mapped = representative[ target ];
				if ( mapped != source ) condensed[ source ][ mapped ] = true;
			}
		}

		// Longest-path depth: a cluster sits one wave after its deepest
		// dependency. Memoised, with a visiting guard as a belt-and-braces
		// backstop in case condensation ever misses something.
		var depth = {};
		var visiting = {};
		var resolveDepth = ( id ) => {
			if ( depth.keyExists( arguments.id ) ) return depth[ arguments.id ];
			if ( visiting.keyExists( arguments.id ) ) return 0;
			visiting[ arguments.id ] = true;
			var deepest = -1;
			for ( var target in ( condensed[ arguments.id ] ?: {} ) ) {
				var candidate = resolveDepth( target );
				if ( candidate > deepest ) deepest = candidate;
			}
			structDelete( visiting, arguments.id );
			depth[ arguments.id ] = deepest + 1;
			return depth[ arguments.id ];
		};

		var order = [];
		var clusterIds = structKeyArray( dependsOn );
		arraySort( clusterIds, "textnocase" );
		var maxWave = 0;
		for ( var clusterId in clusterIds ) {
			var wave = resolveDepth( representative[ clusterId ] );
			if ( wave > maxWave ) maxWave = wave;
			var dependencyIds = structKeyArray( dependsOn[ clusterId ] );
			arraySort( dependencyIds, "textnocase" );
			var blockedIds = structKeyArray( blocks[ clusterId ] );
			arraySort( blockedIds, "textnocase" );
			order.append( {
				clusterId  : clusterId,
				wave       : wave,
				dependsOn  : dependencyIds,
				blocks     : blockedIds,
				inCycleWith : cycleMembersOf( cycles, clusterId )
			} );
		}

		return new app.models.domain.WaveOrder( {
			version     : "modernization-wave-v1",
			order       : order,
			maxWave     : maxWave,
			cycles      : cycles,
			criticalPath: longestChain( condensed, depth )
		} );
	}

	/** Tarjan over the cluster dependency map. Same shape as the file-level one. */
	private array function clusterCycles( required struct dependsOn ) {
		var index = {};
		var lowLink = {};
		var onStack = {};
		var stack = [];
		var counter = 0;
		var components = [];

		var roots = structKeyArray( arguments.dependsOn );
		arraySort( roots, "textnocase" );

		for ( var root in roots ) {
			if ( index.keyExists( root ) ) continue;
			var frames = [ { node: root, next: 1 } ];
			index[ root ] = counter;
			lowLink[ root ] = counter;
			counter++;
			stack.append( root );
			onStack[ root ] = true;

			while ( frames.len() ) {
				var frame = frames[ frames.len() ];
				var current = frame.node;
				var neighbours = structKeyArray( arguments.dependsOn[ current ] ?: {} );
				arraySort( neighbours, "textnocase" );

				if ( frame.next <= neighbours.len() ) {
					var neighbour = neighbours[ frame.next ];
					frame.next++;
					if ( !arguments.dependsOn.keyExists( neighbour ) ) continue;
					if ( !index.keyExists( neighbour ) ) {
						index[ neighbour ] = counter;
						lowLink[ neighbour ] = counter;
						counter++;
						stack.append( neighbour );
						onStack[ neighbour ] = true;
						frames.append( { node: neighbour, next: 1 } );
					} else if ( onStack.keyExists( neighbour ) && onStack[ neighbour ] ) {
						if ( index[ neighbour ] < lowLink[ current ] ) lowLink[ current ] = index[ neighbour ];
					}
					continue;
				}

				frames.deleteAt( frames.len() );
				if ( frames.len() ) {
					var parent = frames[ frames.len() ].node;
					if ( lowLink[ current ] < lowLink[ parent ] ) lowLink[ parent ] = lowLink[ current ];
				}

				if ( lowLink[ current ] == index[ current ] ) {
					var component = [];
					while ( stack.len() ) {
						var popped = stack[ stack.len() ];
						stack.deleteAt( stack.len() );
						onStack[ popped ] = false;
						component.append( popped );
						if ( popped == current ) break;
					}
					if ( component.len() > 1 ) {
						component.sort( ( a, b ) => compareNoCase( a, b ) );
						components.append( component );
					}
				}
			}
		}

		components.sort( ( a, b ) => compareNoCase( a.toList( "|" ), b.toList( "|" ) ) );
		return components;
	}

	private array function cycleMembersOf( required array cycles, required string clusterId ) {
		for ( var cycle in arguments.cycles ) {
			if ( cycle.contains( arguments.clusterId ) ) return cycle;
		}
		return [];
	}

	/**
	 * The longest dependency chain — what actually sets the length of the
	 * migration. Shortening anything off this path saves nothing.
	 */
	private array function longestChain( required struct condensed, required struct depth ) {
		var deepest = "";
		var best = -1;
		var ids = structKeyArray( arguments.depth );
		arraySort( ids, "textnocase" );
		for ( var id in ids ) {
			if ( arguments.depth[ id ] > best ) {
				best = arguments.depth[ id ];
				deepest = id;
			}
		}
		if ( !len( deepest ) ) return [];

		var chain = [ deepest ];
		var current = deepest;
		while ( true ) {
			var next = "";
			var nextDepth = -1;
			var targets = structKeyArray( arguments.condensed[ current ] ?: {} );
			arraySort( targets, "textnocase" );
			for ( var target in targets ) {
				var candidate = arguments.depth[ target ] ?: 0;
				if ( candidate > nextDepth ) {
					nextDepth = candidate;
					next = target;
				}
			}
			if ( !len( next ) || chain.contains( next ) ) break;
			chain.append( next );
			current = next;
		}
		// Dependencies first: the chain is built from dependent to dependency.
		var ordered = [];
		for ( var step = chain.len(); step >= 1; step-- ) ordered.append( chain[ step ] );
		return ordered;
	}

	/**
	 * One weighted undirected graph combining all three kinds of coupling.
	 *
	 * Modularity needs weights, not just connectivity — that is the whole point.
	 * Connectivity alone makes every cluster a connected component, so one
	 * utility call merges two unrelated domains. Weighting lets a single call
	 * across a boundary be outvoted by dense coupling inside one.
	 */
	private struct function buildAffinityGraph( required any graph, required array nodes ) {
		var adjacency = {};
		for ( var node in arguments.nodes ) adjacency[ node.id ] = {};

		var link = ( a, b, weight ) => {
			if ( arguments.a == arguments.b ) return;
			if ( !adjacency.keyExists( arguments.a ) || !adjacency.keyExists( arguments.b ) ) return;
			adjacency[ arguments.a ][ arguments.b ] = ( adjacency[ arguments.a ][ arguments.b ] ?: 0 ) + arguments.weight;
			adjacency[ arguments.b ][ arguments.a ] = ( adjacency[ arguments.b ][ arguments.a ] ?: 0 ) + arguments.weight;
		};

		// Structural edges, weighted by resolution provenance. Direction is
		// dropped: for "do these belong together" a call is symmetric evidence.
		for ( var edge in arguments.graph.getEdges() ) link( edge.fromFile, edge.toFile, edge.weight );

		var metrics = arguments.graph.getMetrics();

		for ( var resource in ( metrics.coAccess ?: {} ) ) {
			if ( left( resource, 6 ) != "table:" ) continue;
			var sharing = metrics.coAccess[ resource ];
			// Infrastructure tables carry no seam signal (see maxCoAccessFanout).
			if ( sharing.len() > variables.maxCoAccessFanout ) continue;
			for ( var i = 1; i <= sharing.len(); i++ ) {
				for ( var j = i + 1; j <= sharing.len(); j++ ) link( sharing[ i ], sharing[ j ], variables.sharedTableWeight );
			}
		}

		for ( var scope in ( metrics.sharedState ?: {} ) ) {
			var touching = metrics.sharedState[ scope ];
			if ( touching.len() > variables.maxCoAccessFanout ) continue;
			for ( var a = 1; a <= touching.len(); a++ ) {
				for ( var b = a + 1; b <= touching.len(); b++ ) link( touching[ a ], touching[ b ], variables.sharedScopeWeight );
			}
		}

		var degree = {};
		var totalWeight = 0;
		for ( var nodeId in adjacency ) {
			var sum = 0;
			for ( var peer in adjacency[ nodeId ] ) sum += adjacency[ nodeId ][ peer ];
			degree[ nodeId ] = sum;
			totalWeight += sum;
		}
		// Each undirected link was counted from both ends.
		return { adjacency: adjacency, degree: degree, totalWeight: totalWeight / 2 };
	}

	/**
	 * Louvain local-moving: repeatedly move each node into the neighbouring
	 * community that most improves modularity, until nothing moves.
	 *
	 * Single level rather than the full recursive aggregation. At the scale this
	 * runs on it converges to the same answer for the shapes that matter, and it
	 * stays readable — which is worth more here than the last fraction of
	 * modularity.
	 *
	 * Determinism is a hard requirement: nodes are visited in sorted order,
	 * ties break toward the lexicographically smaller community, and a community
	 * is finally named for its smallest member. Identical input must give a
	 * byte-identical plan or fingerprints churn.
	 */
	private struct function louvainCommunities( required struct affinity ) {
		var adjacency = arguments.affinity.adjacency;
		var degree = arguments.affinity.degree;
		var m = arguments.affinity.totalWeight;

		var nodeIds = structKeyArray( adjacency );
		arraySort( nodeIds, "textnocase" );

		var community = {};
		var communityDegree = {};
		for ( var nodeId in nodeIds ) {
			community[ nodeId ] = nodeId;
			communityDegree[ nodeId ] = degree[ nodeId ];
		}
		// With no weighted edges at all, every node is its own community.
		if ( m <= 0 ) return community;

		var passes = 0;
		var moved = true;
		while ( moved && passes < variables.maxLouvainPasses ) {
			moved = false;
			passes++;
			for ( var nodeId in nodeIds ) {
				var current = community[ nodeId ];
				var k = degree[ nodeId ];
				communityDegree[ current ] = communityDegree[ current ] - k;

				var weightTo = {};
				for ( var peer in adjacency[ nodeId ] ) {
					var peerCommunity = community[ peer ];
					weightTo[ peerCommunity ] = ( weightTo[ peerCommunity ] ?: 0 ) + adjacency[ nodeId ][ peer ];
				}
				if ( !weightTo.keyExists( current ) ) weightTo[ current ] = 0;

				var candidates = structKeyArray( weightTo );
				arraySort( candidates, "textnocase" );

				var best = current;
				var bestGain = ( weightTo[ current ] ?: 0 ) - ( ( communityDegree[ current ] ?: 0 ) * k ) / ( 2 * m );
				for ( var candidate in candidates ) {
					var gain = weightTo[ candidate ] - ( ( communityDegree[ candidate ] ?: 0 ) * k ) / ( 2 * m );
					// Strictly greater, so equal-gain ties keep the sorted-order
					// incumbent and the result cannot oscillate.
					if ( gain > bestGain + 0.000001 ) {
						best = candidate;
						bestGain = gain;
					}
				}

				community[ nodeId ] = best;
				communityDegree[ best ] = ( communityDegree[ best ] ?: 0 ) + k;
				if ( best != current ) moved = true;
			}
		}

		return relabelBySmallestMember( community );
	}

	/**
	 * A dependency cycle cannot be cut, so its members must share a cluster
	 * whatever modularity prefers. Structure beats statistics here: proposing a
	 * boundary through a cycle would be proposing something impossible.
	 */
	private struct function mergeCycleCommunities( required any graph, required struct community ) {
		var output = duplicate( arguments.community );
		for ( var cycle in ( arguments.graph.getMetrics().cycles ?: [] ) ) {
			var target = "";
			for ( var member in cycle ) {
				if ( !output.keyExists( member ) ) continue;
				if ( !len( target ) || compareNoCase( output[ member ], target ) < 0 ) target = output[ member ];
			}
			if ( !len( target ) ) continue;
			var absorbed = {};
			for ( var member in cycle ) if ( output.keyExists( member ) ) absorbed[ output[ member ] ] = true;
			for ( var nodeId in output ) if ( absorbed.keyExists( output[ nodeId ] ) ) output[ nodeId ] = target;
		}
		return relabelBySmallestMember( output );
	}

	/** Name each community for its smallest member so ids never churn. */
	private struct function relabelBySmallestMember( required struct community ) {
		var smallest = {};
		for ( var nodeId in arguments.community ) {
			var key = arguments.community[ nodeId ];
			if ( !smallest.keyExists( key ) || compareNoCase( nodeId, smallest[ key ] ) < 0 ) smallest[ key ] = nodeId;
		}
		var output = {};
		for ( var nodeId in arguments.community ) output[ nodeId ] = smallest[ arguments.community[ nodeId ] ];
		return output;
	}

	/**
	 * Decide what each derived cluster is, from what the graph can prove.
	 *
	 * A cluster is only a candidate to leave the monolith when nothing crosses
	 * its boundary — no structural edge, no shared table, no shared scope. Among
	 * those, one that already talks to the outside world (HTTP, scheduled work)
	 * has evidence of being a service; one that does not is a module.
	 *
	 * Anything else stays. `stay` is a first-class answer here, not a failure to
	 * decide.
	 */
	private array function classifyDerivedClusters( required any graph, required array clusters ) {
		var metrics = arguments.graph.getMetrics();
		var output = [];

		// A single cluster spanning the whole system has nothing crossing its
		// boundary, which makes "isolated" vacuously true. There is no seam to
		// extract *to*, so it stays. Without this, a system so coupled that it
		// collapses into one cluster would read as trivially extractable — the
		// exact inversion of the right answer, and the failure mode false-seam
		// is built to catch.
		var singleCluster = arguments.clusters.len() <= 1;

		for ( var cluster in arguments.clusters ) {
			var members = cluster.filePaths;
			var crossing = arguments.graph.edgesCrossing( members ).len();

			var sharedOutside = [];
			for ( var resource in ( metrics.coAccess ?: {} ) ) {
				if ( left( resource, 6 ) != "table:" ) continue;
				var sharing = metrics.coAccess[ resource ];
				var inside = false;
				var outside = false;
				for ( var filePath in sharing ) {
					if ( members.contains( filePath ) ) inside = true;
					else outside = true;
				}
				if ( inside && outside ) sharedOutside.append( resource );
			}

			var scopesOutside = [];
			for ( var scope in ( metrics.sharedState ?: {} ) ) {
				var touching = metrics.sharedState[ scope ];
				var insideScope = false;
				var outsideScope = false;
				for ( var filePath in touching ) {
					if ( members.contains( filePath ) ) insideScope = true;
					else outsideScope = true;
				}
				if ( insideScope && outsideScope ) scopesOutside.append( scope );
			}

			var inCycleWithOutside = false;
			for ( var filePath in members ) {
				for ( var member in arguments.graph.cycleMembersFor( filePath ) ) {
					if ( !members.contains( member ) ) inCycleWithOutside = true;
				}
			}

			var isolated = crossing == 0
				&& !sharedOutside.len()
				&& !scopesOutside.len()
				&& !inCycleWithOutside
				&& !singleCluster;

			cluster.boundaryEvidence = {
				crossingEdges       : crossing,
				sharedTablesOutside : sharedOutside,
				sharedScopesOutside : scopesOutside,
				inCycleWithOutside  : inCycleWithOutside,
				spansWholeSystem    : singleCluster,
				isolated            : isolated
			};

			if ( singleCluster ) {
				cluster.placementType = "main-app";
				cluster.rationale = "Everything in scope resolves to one cluster: coupling reaches across every candidate boundary, so there is no seam to extract along.";
			} else if ( !isolated ) {
				cluster.placementType = "main-app";
				cluster.rationale = "Coupled to the rest of the system: "
					& crossing & " crossing edge(s), "
					& sharedOutside.len() & " shared table(s), "
					& scopesOutside.len() & " shared scope(s)"
					& ( inCycleWithOutside ? ", and part of a dependency cycle that leaves the boundary" : "" )
					& ". Extracting it would split state that is written in both places.";
			} else {
				// Separable either way. What decides service vs module is
				// whether this boundary already talks to the outside world:
				// something with its own outbound integration is behaving like
				// a service already, and saying so is a stronger claim than
				// "could be a module", so it needs stronger evidence.
				var externalFiles = [];
				for ( var filePath in ( metrics.externalIntegration ?: [] ) ) {
					if ( members.contains( filePath ) ) externalFiles.append( filePath );
				}
				cluster.boundaryEvidence.externalIntegration = externalFiles;

				if ( externalFiles.len() ) {
					cluster.placementType = "external-service";
					cluster.rationale = "Nothing crosses this boundary, and it already owns an outbound integration ("
						& externalFiles.len() & " file(s)), so it is behaving as a service inside the monolith.";
				} else {
					cluster.placementType = "coldbox-module";
					cluster.rationale = "No structural edge, shared table or shared scope crosses this boundary, but it has no outbound integration of its own — separable as a module rather than a service.";
				}
			}
			output.append( cluster );
		}

		return output;
	}

	private array function clusterUnitsForArchitecture( required array units, required array scopePaths ) {
		var clusters = [];
		var assigned = {};
		var appendCluster = ( id, domainKey, name, placementType, purpose, rationale, unitIds ) => {
			if ( !arguments.unitIds.len() ) return;
			clusters.append( {
				id: arguments.id,
				domainKey: arguments.domainKey,
				name: arguments.name,
				placementType: arguments.placementType,
				purpose: arguments.purpose,
				rationale: arguments.rationale,
				targetUnitIds: duplicate( arguments.unitIds )
			} );
			for ( var unitId in arguments.unitIds ) assigned[ unitId ] = true;
		};
		var scopes = [];
		for ( var scopePath in arguments.scopePaths ) {
			var needle = lCase( reReplace( replace( trim( toString( scopePath ) ), "\", "/", "all" ), "/+$", "" ) );
			if ( len( needle ) ) scopes.append( needle );
		}
		if ( !scopes.len() ) {
			// Small unscoped plans stay modular-monolith-first. Large estates
			// (full-repo modernize) infer top feature folders so packaging and
			// roadmap seams survive architecture timeouts instead of one hollow
			// default phase covering thousands of units.
			if ( arguments.units.len() >= variables.minUnitsForFolderInference ) {
				scopes = inferArchitectureScopesFromUnits( arguments.units );
			}
			if ( !scopes.len() ) {
				appendCluster(
					"ctx-modular-monolith-default",
					"main-app",
					"ColdBox modular monolith (default)",
					"main-app",
					"Keep mapped behavior in one deployable while source-backed feature seams are validated.",
					"Conservative default because no explicit extraction boundary was established",
					arguments.units.map( ( item ) => item.id ?: item.itemId ?: "" ).filter( ( id ) => len( trim( id ) ) )
				);
				return clusters;
			}
		}
		for ( var scopeIndex = 1; scopeIndex <= scopes.len(); scopeIndex++ ) {
			var scopeNeedle = scopes[ scopeIndex ];
			var matched = [];
			for ( var unit in arguments.units ) {
				var unitId = trim( unit.id ?: unit.itemId ?: "" );
				if ( !len( unitId ) || assigned.keyExists( unitId ) ) continue;
				var source = lCase( normalizeLegacyPath( unit.sourcePath ?: unit.sourceFile ?: unit.legacyPath ?: "" ) );
				if ( !len( source ) ) continue;
				if ( source == scopeNeedle || left( source, len( scopeNeedle ) + 1 ) == scopeNeedle & "/" || find( "/" & scopeNeedle & "/", "/" & source & "/" ) ) {
					matched.append( unitId );
				}
			}
			if ( !matched.len() ) continue;
			var placementType = "main-app";
			var name = "Main app: " & listLast( scopeNeedle, "/" );
			var purpose = "Mapped behavior under #scopeNeedle# stays in the modular monolith.";
			var rationale = "Path-clustered packaging while architecture provider packaging is unavailable.";
			if ( findNoCase( "/hosting/", "/" & scopeNeedle & "/" ) || reFindNoCase( "(^|/)\d*hosting/", scopeNeedle ) ) {
				placementType = "external-service";
				name = "Side application candidate: " & listLast( scopeNeedle, "/" );
				purpose = "Separate hosting/Application tree — candidate small app or microservice boundary.";
				rationale = "Distinct hosting root under #scopeNeedle# looks like a separate deployable, not an in-process ColdBox module.";
			} else if ( findNoCase( "_scheduled", scopeNeedle ) || findNoCase( "scheduled", scopeNeedle ) || findNoCase( "/jobs/", "/" & scopeNeedle & "/" ) || findNoCase( "/workers/", "/" & scopeNeedle & "/" ) ) {
				placementType = "background-worker";
				name = "Scheduled / background workers: " & listLast( scopeNeedle, "/" );
				purpose = "Background and scheduled scripts become workers/tasks in a jobs host or main-app scheduler.";
				rationale = "Scheduled-script folders are background-worker candidates, not ColdBox UI modules or microservices.";
			} else if ( findNoCase( "/modules/", "/" & scopeNeedle & "/" ) || findNoCase( "modules/", scopeNeedle ) || listLen( scopeNeedle, "/" ) >= 2 ) {
				// Nested scoped feature directories are module candidates; bare
				// top-level roots stay main-app unless modules/ is explicit.
				placementType = "coldbox-module";
				name = "ColdBox module candidate: " & listLast( scopeNeedle, "/" );
				purpose = "Cohesive feature folder suitable for a ColdBox module boundary.";
				rationale = "Directory cohesion under #scopeNeedle# supports coldbox-module packaging.";
			}
			appendCluster(
				"ctx-scope-" & scopeIndex,
				reReplace( scopeNeedle, "[^a-zA-Z0-9]+", "-", "all" ),
				name,
				placementType,
				purpose,
				rationale,
				matched
			);
		}
		var leftover = [];
		for ( var unit in arguments.units ) {
			var unitId = trim( unit.id ?: unit.itemId ?: "" );
			if ( len( unitId ) && !assigned.keyExists( unitId ) ) leftover.append( unitId );
		}
		if ( leftover.len() || !clusters.len() ) {
			appendCluster(
				"ctx-modular-monolith-default",
				"main-app",
				"ColdBox modular monolith (default)",
				"main-app",
				"Keep remaining mapped behavior in one deployable while source-backed feature seams are validated.",
				clusters.len()
					? "Residual units without a scoped folder seam stay in the main app."
					: "Conservative default because no explicit extraction boundary was established",
				leftover.len() ? leftover : arguments.units.map( ( item ) => item.id ?: item.itemId ?: "" ).filter( ( id ) => len( trim( id ) ) )
			);
		}
		return clusters;
	}

	/**
	 * Rank feature folders by unit count for unscoped large estates. Caps the
	 * set so roadmap sharding stays bounded while still surfacing ColdBox-module
	 * and scheduled-worker candidates (modules/*, _scheduled*, /jobs/, /workers/).
	 */
	private array function inferArchitectureScopesFromUnits( required array units ) {
		var counts = {};
		for ( var unit in arguments.units ) {
			if ( !isStruct( unit ) ) continue;
			var source = lCase( normalizeLegacyPath( unit.sourcePath ?: unit.sourceFile ?: unit.legacyPath ?: "" ) );
			var folder = featureFolderFromPath( source );
			if ( !len( folder ) ) continue;
			counts[ folder ] = ( counts[ folder ] ?: 0 ) + 1;
		}
		var ranked = [];
		for ( var folder in counts ) {
			ranked.append( { folder: folder, count: counts[ folder ] } );
		}
		ranked.sort( ( a, b ) => {
			if ( a.count != b.count ) return b.count - a.count;
			return compareNoCase( a.folder, b.folder );
		} );
		var selected = [];
		for ( var item in ranked ) {
			if ( selected.len() >= variables.maxInferredArchitectureScopes ) break;
			var forceKeep = reFindNoCase( "/modules/|(^|/)modules/|_scheduled|scheduled|/jobs/|/workers/", item.folder );
			if ( item.count >= 3 || forceKeep ) selected.append( item.folder );
		}
		return selected;
	}

	private string function featureFolderFromPath( required string path ) {
		var lower = lCase( arguments.path );
		if ( !len( lower ) ) return "";
		var modulesMatch = reMatchNoCase( "modules/[^/]+", lower );
		if ( isArray( modulesMatch ) && modulesMatch.len() ) return modulesMatch[ 1 ];
		var hostingAt = reFindNoCase( "\d*hosting/", lower );
		if ( hostingAt ) {
			var hostingSlice = mid( lower, hostingAt );
			var hostingParts = listToArray( hostingSlice, "/" );
			if ( hostingParts.len() >= 2 ) return hostingParts[ 1 ] & "/" & hostingParts[ 2 ];
		}
		var parts = listToArray( lower, "/" );
		// Common CF/legacy roots keep an extra path segment so feature folders
		// (root/feature/...) cluster separately from the root itself.
		if ( parts.len() >= 3 && [ "web", "weboffice", "legacy", "src", "app", "cf", "cfm" ].contains( parts[ 1 ] ) ) {
			return parts[ 1 ] & "/" & parts[ 2 ];
		}
		if ( parts.len() >= 2 ) return parts[ 1 ] & "/" & parts[ 2 ];
		return parts.len() ? parts[ 1 ] : "";
	}

	/**
	 * Reclassify provider/synthesized placements so folder spam is not treated as
	 * ColdBox modules, and separate Application/hosting trees surface as
	 * external-service (side-app / small application) candidates.
	 */
	public struct function normalizeArchitecturePlacementTypes( required struct plan ) {
		var unitsById = {};
		for ( var unit in ( isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [] ) ) {
			if ( !isStruct( unit ) ) continue;
			var unitId = trim( unit.id ?: unit.itemId ?: "" );
			if ( len( unitId ) ) unitsById[ unitId ] = unit;
		}
		if ( isArray( arguments.plan.target.placements ?: "" ) ) {
			for ( var placement in arguments.plan.target.placements ) {
				if ( !isStruct( placement ) ) continue;
				var sourcePaths = [];
				for ( var targetId in ( isArray( placement.targetUnitIds ?: "" ) ? placement.targetUnitIds : [] ) ) {
					var mapped = unitsById[ trim( toString( targetId ) ) ] ?: {};
					var sourcePath = normalizeLegacyPath( mapped.sourcePath ?: mapped.sourceFile ?: mapped.legacyPath ?: "" );
					if ( len( sourcePath ) ) sourcePaths.append( sourcePath );
				}
				var nextType = classifyPackagingType(
					placement.name ?: "",
					placement.domainKey ?: "",
					placement.placementType ?: "main-app",
					sourcePaths,
					isArray( placement.targetUnitIds ?: "" ) ? placement.targetUnitIds.len() : 0
				);
				placement.placementType = nextType;
				placement.packaging = nextType == "coldbox-module" ? "coldbox-module" : ( nextType == "external-service" ? "external-service" : ( [ "background-worker", "scheduled-service" ].contains( nextType ) ? "worker" : "centralized" ) );
				placement.stayInMonolith = placementService.staysInMonolith( nextType );
				if ( nextType == "main-app" && reFindNoCase( "module candidate", placement.name ?: "" ) ) {
					placement.name = "Main app: " & trim( reReplaceNoCase( placement.name, "^(coldbox\s+)?module candidate:\s*", "", "one" ) );
				}
				if ( nextType == "background-worker" && !reFindNoCase( "worker|scheduled|job", placement.name ?: "" ) ) {
					placement.name = "Background workers: " & trim( reReplaceNoCase( placement.name ?: "jobs", "^(coldbox\s+)?module candidate:\s*", "", "one" ) );
				}
				if ( nextType == "external-service" && !reFindNoCase( "side application|microservice|external", placement.name ?: "" ) ) {
					placement.name = "Side application candidate: " & trim( reReplaceNoCase( placement.name ?: "capability", "^(coldbox\s+)?module candidate:\s*", "", "one" ) );
				}
			}
		}
		if ( isArray( arguments.plan.target.contexts ?: "" ) ) {
			for ( var ctx in arguments.plan.target.contexts ) {
				if ( !isStruct( ctx ) ) continue;
				var ctxType = classifyPackagingType(
					ctx.name ?: "",
					ctx.domainKey ?: "",
					( ctx.packaging ?: "" ) == "coldbox-module" ? "coldbox-module" : ( ( ctx.placementType ?: "" ) == "external-service" ? "external-service" : ( [ "background-worker", "scheduled-service" ].contains( ctx.placementType ?: "" ) ? ctx.placementType : "main-app" ) ),
					[],
					isArray( ctx.targetUnitIds ?: "" ) ? ctx.targetUnitIds.len() : 0
				);
				ctx.placementType = ctxType;
				ctx.packaging = ctxType == "coldbox-module" ? "coldbox-module" : ( [ "background-worker", "scheduled-service" ].contains( ctxType ) ? "worker" : "centralized" );
				ctx.stayInMonolith = placementService.staysInMonolith( ctxType );
			}
		}
		return arguments.plan;
	}

	private string function classifyPackagingType(
		required string name,
		required string domainKey,
		required string currentType,
		array sourcePaths = [],
		numeric unitCount = 0
	) {
		var pathBlob = arguments.sourcePaths.toList( " " );
		var blob = lCase( trim( arguments.name ) & " " & trim( arguments.domainKey ) & " " & pathBlob );
		var current = lCase( trim( arguments.currentType ) );
		if ( !len( current ) ) current = "main-app";
		// Shared / worker / static folders are never UI modules or microservices.
		if ( reFindNoCase( "_scheduled|scheduledscripts|/jobs/|/workers/", blob ) ) {
			// Integration-heavy job folders (payments, mail APIs, webhooks, CRM
			// / inventory connectors) may later become a separate jobs host.
			return reFindNoCase( "payment|autopay|billing|invoice|webhook|oauth|smtp|mail.?api|/integrations?/|inventory|crm", blob ) ? "scheduled-service" : "background-worker";
		}
		if ( reFindNoCase( "\btemp\b|copyfiles|commonfiles|comingsoon|\bjs\b|/js/|webmanagementwelcome|message.?template", blob ) ) {
			return "main-app";
		}
		var hasApplicationEntrypoint = arguments.sourcePaths.some( ( path ) => reFindNoCase( "(^|/|\\)application\.(cfc|cfm|bx)$", path ) );
		// *hosting*/AppName trees with their own Application.* look like side-apps.
		var hostingRoot = reFindNoCase( "(^|/|\\)\d*hosting/[a-z0-9_-]+", blob ) || reFindNoCase( "(^|/|\\)hosting/[a-z0-9_-]+", blob );
		if ( hostingRoot && ( hasApplicationEntrypoint || reFindNoCase( "application bootstrap|side application|orders application|hosting/", blob ) ) ) {
			return "external-service";
		}
		if ( current == "external-service" && ( hasApplicationEntrypoint || hostingRoot || reFindNoCase( "microservice|side.?app|external.?service|separate deploy", blob ) ) ) {
			return "external-service";
		}
		if ( [ "background-worker", "scheduled-service" ].contains( current ) ) return current;
		if ( reFindNoCase( "/modules/|moduleconfig\.(cfc|cfm|bx)", blob ) ) {
			return "coldbox-module";
		}
		if ( current == "coldbox-module" ) {
			if ( arguments.unitCount > 120 && !reFindNoCase( "/modules/", blob ) ) return "main-app";
			// Keep nested feature directories; demote bare "module candidate" labels
			// that lack path evidence of a real feature or modules/ package.
			var nestedFeature = arguments.sourcePaths.some( ( path ) => {
				var normalized = reReplace( replace( trim( toString( path ) ), "\", "/", "all" ), "^(\./)+", "" );
				return listLen( normalized, "/" ) >= 2;
			} );
			if ( nestedFeature ) return "coldbox-module";
			if ( reFindNoCase( "module candidate", arguments.name ) ) return "main-app";
			return "coldbox-module";
		}
		return "main-app";
	}

	private array function evidenceRefsForUnit( required struct unit ) {
		var refs = [];
		var existing = arguments.unit.evidenceRefs ?: arguments.unit.evidence ?: [];
		if ( isArray( existing ) ) {
			for ( var ref in existing ) {
				if ( isStruct( ref ) ) refs.append( duplicate( ref ) );
				else if ( len( trim( toString( ref ) ) ) ) refs.append( { ref: toString( ref ), extractionMethod: "unit-evidence" } );
			}
		}
		var sourcePath = normalizeEvidencePath( arguments.unit.sourcePath ?: arguments.unit.sourceFile ?: arguments.unit.legacyPath ?: "" );
		if ( len( sourcePath ) ) refs.append( { filePath: sourcePath, extractionMethod: "target-source-path" } );
		var targetPath = normalizeEvidencePath( arguments.unit.targetPath ?: arguments.unit.pathHint ?: "" );
		if ( len( targetPath ) ) refs.append( { filePath: targetPath, extractionMethod: "target-path", note: "proposed-target" } );
		for ( var legacyId in ( isArray( arguments.unit.legacyUnitIds ?: "" ) ? arguments.unit.legacyUnitIds : [] ) ) {
			if ( len( trim( toString( legacyId ) ) ) ) refs.append( { legacyUnitId: toString( legacyId ), extractionMethod: "legacy-unit" } );
		}
		if ( !refs.len() ) {
			refs.append( {
				extractionMethod: "synthesized-packaging",
				targetUnitId: arguments.unit.id ?: arguments.unit.itemId ?: "",
				note: "Derived from accepted application maps"
			} );
		}
		return refs;
	}

	private array function evidenceRefsForUnitIds( required array unitIds, required struct evidenceByUnit ) {
		var refs = [];
		var seen = {};
		for ( var unitId in arguments.unitIds ) {
			var key = trim( toString( unitId ) );
			if ( !len( key ) || !arguments.evidenceByUnit.keyExists( key ) ) continue;
			for ( var ref in arguments.evidenceByUnit[ key ] ) {
				var fingerprint = lCase( jsonSerialize( ref ) );
				if ( seen.keyExists( fingerprint ) ) continue;
				seen[ fingerprint ] = true;
				refs.append( duplicate( ref ) );
			}
		}
		if ( !refs.len() ) refs.append( { extractionMethod: "synthesized-packaging", note: "architecture-from-maps" } );
		return refs;
	}

	private boolean function isCentralPath( required string path ) {
		var lower = lCase( arguments.path );
		return reFindNoCase( "application\.|coldbox\.|/config/|\\config\\|router\.|/routes|/layouts?/|/interceptors?/|wirebox|security|auth|session", lower ) > 0;
	}

	private string function architectureDomainKey( required string path, required struct unit ) {
		var parts = listToArray( replace( arguments.path, "\", "/", "all" ), "/" );
		for ( var i = 1; i <= parts.len(); i++ ) {
			var piece = lCase( trim( parts[ i ] ) );
			if ( !len( piece ) ) continue;
			if ( listFindNoCase( "handlers,views,modules_app,modules,controllers", piece ) && i < parts.len() ) {
				return sanitizeDomainToken( parts[ i + 1 ] );
			}
			if ( piece == "models" && i < parts.len() ) {
				var next = lCase( trim( parts[ i + 1 ] ) );
				if ( next == "services" && i + 1 < parts.len() ) return sanitizeDomainToken( parts[ i + 2 ] );
				return sanitizeDomainToken( parts[ i + 1 ] );
			}
			if ( piece == "services" && i < parts.len() ) return sanitizeDomainToken( parts[ i + 1 ] );
		}
		var purpose = lCase( trim( arguments.unit.purpose ?: "" ) );
		if ( len( purpose ) ) {
			var token = listFirst( reReplace( purpose, "[^a-z0-9]+", "-", "all" ), "-" );
			if ( len( token ) >= 3 ) return token;
		}
		return "";
	}

	private string function sanitizeDomainToken( required string value ) {
		var token = reReplaceNoCase( trim( arguments.value ), "\.(bx|cfc|cfm|bxm)$", "" );
		token = reReplaceNoCase( token, "(service|handler|controller|gateway)$", "" );
		token = reReplace( lCase( token ), "[^a-z0-9]+", "", "all" );
		token = reReplaceNoCase( token, "ies$", "y" );
		if ( len( token ) > 4 && right( token, 1 ) == "s" ) token = left( token, len( token ) - 1 );
		return len( token ) >= 3 ? token : "";
	}


	// ------------------------------------------------------------------
	// Helpers copied from ModernizationProposalService.
	//
	// The synthesis block called these six, and all six are still used
	// 11-50 times by the code that stays behind, so they could not simply
	// move. They are stateless normalisation and identity wrappers rather
	// than invariants -- none of them owns a decision -- so a copy does not
	// create the two-owner problem that section 2.7 documents.
	//
	// Consolidate when Step 11 splits ModernizationProposalService and the
	// remaining caller set is small enough to repoint.
	// ------------------------------------------------------------------

	private string function scalarString( required any value ) {
		if ( isSimpleValue( arguments.value ) ) return toString( arguments.value );
		if ( isArray( arguments.value ) ) {
			for ( var item in arguments.value ) if ( isSimpleValue( item ) && len( trim( toString( item ) ) ) ) return trim( toString( item ) );
			return "";
		}
		return "";
	}

	private string function normalizeLegacyPath( required any path ) {
		return replace( replace( trim( scalarString( arguments.path ) ), "\", "/", "all" ), "//", "/", "all" );
	}

	private string function normalizeEvidencePath( required any path ) {
		return lCase( replace( trim( scalarString( arguments.path ) ), "\", "/", "all" ) );
	}

	private array function dedupeById( required array items ) {
		var seen = {};
		var output = [];
		for ( var item in arguments.items ) {
			if ( !isStruct( item ) ) continue;
			var id = trim( item.id ?: item.itemId ?: "" );
			if ( len( id ) && seen.keyExists( id ) ) continue;
			if ( len( id ) ) seen[ id ] = true;
			output.append( item );
		}
		return output;
	}

	private void function ensureIdentity( required struct item, required string kind ) {
		var id = trim( scalarString( arguments.item.id ?: "" ) );
		if ( !len( id ) ) id = trim( scalarString( arguments.item.itemId ?: "" ) );
		if ( !len( id ) ) arguments.item.id = identityService.itemId( arguments.kind, arguments.item );
		else arguments.item.id = id;
		var fingerprint = trim( scalarString( arguments.item.itemFingerprint ?: "" ) );
		if ( !len( fingerprint ) ) arguments.item.itemFingerprint = identityService.itemFingerprint( arguments.kind, arguments.item );
		else arguments.item.itemFingerprint = fingerprint;
	}

	private void function logInfo( required string message ) {
		try {
			if ( !isNull( variables.log ?: javacast( "null", "" ) ) ) {
				variables.log.info( arguments.message );
			}
		} catch ( any ignored ) {}
	}
}
