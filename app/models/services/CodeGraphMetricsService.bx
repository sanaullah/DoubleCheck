/**
 * CodeGraph metrics and snapshot assembly. Deterministic, no gateway.
 *
 * Owns only what nothing else owns: hotspots, orphans, layer violations,
 * directory rollup, snapshot assembly + fingerprint. Fan-in/out and cycles are
 * read from CouplingGraph — this class must never declare `fanIn(` or
 * `stronglyConnectedComponents`.
 *
 * @see ModernizationCouplingGraphService
 * @see ModernizationDerivedStructureService
 * @see ArchitectureModelService.classifyFile
 * @see CodeGraphInventoryAdapter
 */
@singleton
class threadsafe {

	property name="couplingGraphService" inject="ModernizationCouplingGraphService";
	property name="derivedStructureService" inject="ModernizationDerivedStructureService";
	property name="architectureModelService" inject="ArchitectureModelService";
	property name="inventoryAdapter" inject="CodeGraphInventoryAdapter";
	property name="flowService" inject="CodeGraphFlowService";
	property name="completenessService" inject="CodeGraphCompletenessService";
	property name="architectureRuleService" inject="ArchitectureRuleService";
	property name="centralityService" inject="CodeGraphCentralityService";

	// v5: flows carry `hops` — the chain as evidence-bearing edges rather than a
	// list of node names, so a trace can be opened at each step.
	// v4: `roleCounts` now counts files only, excluding route/table/config/event/
	// http/schedule/response entities. That changes stored snapshot content, so
	// the version has to move or reuse will serve the old counts.
	variables.snapshotVersion = "codegraph-snapshot-v5";
	variables.defaultCaps = {
		maxClusters         : 60,
		maxHotspots         : 50,
		maxOrphans          : 200,
		maxLayerViolations  : 200,
		maxNodes            : 1500,
		maxEdges            : 20000,
		flowMaxDepth        : 3,
		maxFlowsPerCluster  : 4
	};

	function init() {
		if ( isNull( variables.couplingGraphService ?: javacast( "null", "" ) ) ) {
			variables.couplingGraphService = new app.models.services.ModernizationCouplingGraphService();
		}
		if ( isNull( variables.derivedStructureService ?: javacast( "null", "" ) ) ) {
			variables.derivedStructureService = new app.models.services.ModernizationDerivedStructureService();
		}
		if ( isNull( variables.architectureModelService ?: javacast( "null", "" ) ) ) {
			variables.architectureModelService = new app.models.services.ArchitectureModelService();
		}
		if ( isNull( variables.inventoryAdapter ?: javacast( "null", "" ) ) ) {
			variables.inventoryAdapter = new app.models.services.CodeGraphInventoryAdapter();
		}
		if ( isNull( variables.flowService ?: javacast( "null", "" ) ) ) {
			variables.flowService = new app.models.services.CodeGraphFlowService();
		}
		if ( isNull( variables.completenessService ?: javacast( "null", "" ) ) ) {
			variables.completenessService = new app.models.services.CodeGraphCompletenessService();
		}
		// Specs construct this service directly, so an injected-only collaborator
		// would be null for every unit test that never touches WireBox.
		if ( isNull( variables.architectureRuleService ?: javacast( "null", "" ) ) ) {
			variables.architectureRuleService = new app.models.services.ArchitectureRuleService();
		}
		if ( isNull( variables.syntheticNodes ?: javacast( "null", "" ) ) ) {
			variables.syntheticNodes = new app.models.services.SyntheticNodeBuilder();
		}
		if ( isNull( variables.centralityService ?: javacast( "null", "" ) ) ) {
			variables.centralityService = new app.models.services.CodeGraphCentralityService();
		}
		return this;
	}

	string function snapshotVersion() {
		return variables.snapshotVersion;
	}

	/**
	 * Build the CodeGraph snapshot from a review graph struct.
	 * Caps may be overridden via options; defaults match the plan.
	 */
	struct function assemble( required struct reviewGraph, struct options = {} ) {
		var caps = resolveCaps( arguments.options );
		var coChange = isStruct( arguments.options.coChange ?: "" ) ? duplicate( arguments.options.coChange ) : {};
		if ( !structKeyExists( coChange, "files" ) || !isStruct( coChange.files ?: "" ) ) coChange.files = {};
		if ( !structKeyExists( coChange, "affinityWeights" ) || !isStruct( coChange.affinityWeights ?: "" ) ) coChange.affinityWeights = {};
		var truncation = { truncated: false, reasons: [] };
		if ( arguments.reviewGraph.truncated ?: false ) {
			markTruncated( truncation, "graphLoad" );
			for ( var loadReason in ( arguments.reviewGraph.truncationReasons ?: [] ) ) {
				markTruncated( truncation, loadReason );
			}
		}

		var inventory = inventoryAdapter.adapt( arguments.reviewGraph );
		var graph = couplingGraphService.build( inventory );
		if ( graph.truncated() ) {
			markTruncated( truncation, "couplingGraph" );
			for ( var reason in graph.getTruncationReasons() ) {
				markTruncated( truncation, reason );
			}
		}

		var rawClusters = derivedStructureService.deriveClusters( graph, inventory.units ?: [], [], coChange.affinityWeights );
		var fileStats = indexFileStats( inventory, arguments.reviewGraph );
		var clusterOf = {};
		var clusters = presentClusters( rawClusters, graph, caps, truncation, clusterOf, fileStats );
		clusters = appendCoChangeMetrics( clusters, coChange );

		var clusterEdges = buildClusterEdges( graph, clusterOf, truncation );
		var crossingCounts = indexCrossingEdges( graph, clusterOf );
		var roleEvidence = indexRoleEvidence( inventory );
		var nodes = buildNodes( graph, inventory, fileStats, clusterOf, crossingCounts, roleEvidence, coChange.files );
		syntheticNodeBuilder().append( nodes, arguments.reviewGraph.dependencies ?: [] );
		var orphanCandidateCount = countOrphanCandidates( nodes );
		var availableNodes = nodes.len();
		var nodeRanking = "path";
		if ( nodes.len() > caps.maxNodes ) {
			markTruncated( truncation, "maxNodes" );
			// Selecting alphabetically deletes whole late-alphabet directories.
			// Select by importance, then restore path order for presentation so
			// the returned array stays stable and comparable.
			nodeRanking = "hotspotScore";
			// Routes and tables score 0 by construction, so a plain ranked cut
			// removes every entry point and sink first — and because flows are
			// filtered against the visible set, the process list then empties on
			// exactly the large repositories it exists for. They are bounded by the
			// route and table count, not by repository size, so they are exempt.
			nodeRanking = "centrality";
			var syntheticNodes = [];
			var rankableNodes = [];
			for ( var candidate in nodes ) {
				if ( isSyntheticNode( candidate ) ) syntheticNodes.append( candidate );
				else rankableNodes.append( candidate );
			}
			var rankBudget = max( 1, caps.maxNodes - syntheticNodes.len() );
			// Structure decides what the graph keeps; hotspotScore stays for display.
			var centralityByFile = centralityService.rank( graph, rankableNodes );
			for ( var rankable in rankableNodes ) {
				rankable.centrality = centralityByFile[ normalizePath( rankable.id ?: rankable.path ?: "" ) ] ?: 0;
			}
			rankableNodes.sort( ( a, b ) => {
				var aRank = val( a.centrality ?: 0 );
				var bRank = val( b.centrality ?: 0 );
				if ( aRank != bRank ) return aRank > bRank ? -1 : 1;
				return compareNoCase( a.path ?: "", b.path ?: "" );
			} );
			nodes = rankableNodes.slice( 1, min( rankBudget, rankableNodes.len() ) );
			for ( var kept in syntheticNodes ) nodes.append( kept );
			nodes.sort( ( a, b ) => compareNoCase( a.path ?: "", b.path ?: "" ) );
		}
		var visibleNodes = {};
		for ( var visibleNode in nodes ) visibleNodes[ normalizePath( visibleNode.id ?: visibleNode.path ?: "" ) ] = true;
		var cycles = graph.getMetrics().cycles ?: [];
		// Measure presenter caps against the full deterministic node set even when
		// maxNodes hides the candidate rows from the returned snapshot.
		if ( orphanCandidateCount > caps.maxOrphans ) markTruncated( truncation, "maxOrphans" );

		var hotspots = selectHotspots( nodes, caps.maxHotspots, truncation );
		var orphans = selectOrphans( nodes, caps.maxOrphans, truncation );
		var layerViolations = selectLayerViolations( graph, inventory.canonicalPaths ?: {}, caps.maxLayerViolations, truncation, visibleNodes, arguments.options.layerPolicy ?: "application-models>http-handlers" );
		var flows = flowService.extract( inventory, graph, caps, arguments.reviewGraph, truncation, visibleNodes, clusterOf );
		var directories = directoryRollup( nodes );
		var roleCounts = countRoles( nodes );
		var reachability = flowService.reachability( nodes, inventory, arguments.reviewGraph.dependencies ?: [] );

		if ( graph.getEdges().len() > caps.maxEdges ) {
			markTruncated( truncation, "maxEdges" );
		}

		var totals = {
			files            : fileStats.fileCount,
			symbols          : fileStats.symbolCount,
			dependencies     : isArray( arguments.reviewGraph.dependencies ?: "" ) ? arguments.reviewGraph.dependencies.len() : 0,
			nodes            : nodes.len(),
			edges            : graph.getEdges().len(),
			clusters         : clusters.len(),
			cycles           : cycles.len(),
			orphans          : orphans.len(),
			layerViolations  : layerViolations.len(),
			flows            : flows.len()
		};

		// Each collection reports what it kept, out of what existed, by which
		// ordering. `truncated` says only that something was lost somewhere.
		var completeness = completenessService.report( {
			loaded              : arguments.reviewGraph.completeness ?: {},
			clusterCount        : clusters.len(),
			availableClusters   : rawClusters.len(),
			flowCandidateCount  : val( truncation.flowCandidates ?: flows.len() ),
			layerViolationCandidateCount: val( truncation.layerViolationCandidates ?: layerViolations.len() ),
			graph               : graph,
			nodeCount           : nodes.len(),
			availableNodes      : availableNodes,
			nodeRanking         : nodeRanking,
			hotspotCount        : hotspots.len(),
			orphanCount         : orphans.len(),
			orphanCandidateCount: orphanCandidateCount,
			layerViolationCount : layerViolations.len(),
			flowCount           : flows.len(),
			symbolCount         : fileStats.symbolCount,
			dependencyCount     : totals.dependencies,
			// The snapshot reported `truncated: true` beside nine accounts that all
			// said `complete: true`, because a section whose candidate count was never
			// supplied certified itself from its own length. The reasons name which
			// caps fired, so they are the missing input rather than a second opinion.
			truncationReasons   : truncation.reasons ?: []
		} );

		var fingerprintPayload = {
			nodes       : fingerprintNodes( nodes ),
			clusters    : clusters,
			clusterEdges: clusterEdges,
			cycles      : cycles,
			flows       : flows,
			totals      : totals
		};
		var fingerprint = stableHash( variables.snapshotVersion & "|" & canonicalJson( fingerprintPayload ) );

		return {
			version            : variables.snapshotVersion,
			fingerprint        : fingerprint,
			truncated          : truncation.truncated,
			truncationReasons  : truncation.reasons,
			completeness       : completeness,
			totals             : totals,
			nodes              : nodes,
			clusters           : clusters,
			clusterEdges       : clusterEdges,
			cycles             : cycles,
			hotspots           : hotspots,
			orphans            : orphans,
			layerViolations    : layerViolations,
			flows              : flows,
			directories        : directories,
			roleCounts         : roleCounts,
			unreachable        : reachability.unreachable,
			reachability       : reachability.summary,
			coChange           : coChangeSummary( coChange ),
			hotspotFormula     : centralityService.hotspotFormula(),
			canonicalPaths     : inventory.canonicalPaths ?: {}
		};
	}

	/** Display-only source positions must not invalidate structural identity. */
	private array function fingerprintNodes( required array nodes ) {
		var records = [];
		for ( var node in arguments.nodes ) {
			var record = duplicate( node );
			record.delete( "lineCount" );
			records.append( record );
		}
		return records;
	}

	private struct function resolveCaps( required struct options ) {
		var caps = duplicate( variables.defaultCaps );
		for ( var key in caps ) {
			if ( isNumeric( arguments.options[ key ] ?: "" ) ) {
				caps[ key ] = max( 1, val( arguments.options[ key ] ) );
			}
		}
		return caps;
	}

	private array function presentClusters(
		required array rawClusters,
		required any graph,
		required struct caps,
		required struct truncation,
		required struct clusterOf,
		struct fileStats = {}
	) {
		var ordered = duplicate( arguments.rawClusters );
		ordered.sort( ( a, b ) => compareNoCase( a.id ?: "", b.id ?: "" ) );

		if ( ordered.len() > arguments.caps.maxClusters ) {
			markTruncated( arguments.truncation, "maxClusters" );
			// Slicing an id-sorted list deletes late-alphabet domains wholesale.
			// Keep the largest domains, then restore id order for presentation so
			// the returned array stays stable and comparable.
			ordered.sort( ( a, b ) => {
				var aSize = isArray( a.filePaths ?: "" ) ? a.filePaths.len() : 0;
				var bSize = isArray( b.filePaths ?: "" ) ? b.filePaths.len() : 0;
				if ( aSize != bSize ) return aSize > bSize ? -1 : 1;
				return compareNoCase( a.id ?: "", b.id ?: "" );
			} );
			ordered = ordered.slice( 1, arguments.caps.maxClusters );
			ordered.sort( ( a, b ) => compareNoCase( a.id ?: "", b.id ?: "" ) );
		}

		var presented = [];
		// One derivation of "symbols in this file". `indexFileStats` counts the
		// non-file units; deriving it a second time from `unitCount - 1` here let
		// the cluster total disagree with the file total for the same files.
		var byFile = isStruct( arguments.fileStats.byFile ?: "" ) ? arguments.fileStats.byFile : {};
		var symbolsByFile = {};
		for ( var graphNode in arguments.graph.getNodes() ) {
			var graphPath = normalizePath( graphNode.filePath ?: graphNode.id ?: "" );
			if ( !len( graphPath ) ) continue;
			symbolsByFile[ graphPath ] = byFile.keyExists( graphPath )
				? val( byFile[ graphPath ].symbolCount ?: 0 )
				: max( 0, val( graphNode.unitCount ?: 0 ) - 1 );
		}
		for ( var cluster in ordered ) {
			var filePaths = isArray( cluster.filePaths ?: "" ) ? duplicate( cluster.filePaths ) : [];
			filePaths.sort( ( a, b ) => compareNoCase( a, b ) );
			for ( var path in filePaths ) {
				arguments.clusterOf[ normalizePath( path ) ] = cluster.id;
			}

			var cohesion = couplingGraphService.cohesion( arguments.graph, filePaths );
			var symbolCount = 0;
			for ( var filePath in filePaths ) symbolCount += val( symbolsByFile[ normalizePath( filePath ) ] ?: 0 );

			presented.append( {
				id            : cluster.id,
				key           : cluster.domainKey ?: "",
				label         : cluster.name ?: ( cluster.domainKey ?: cluster.id ),
				clusterKey    : lCase( hash( jsonSerialize( filePaths ), "SHA-256" ) ),
				fileCount     : filePaths.len(),
				symbolCount   : max( 0, symbolCount ),
				internalEdges : cohesion.internalEdges,
				crossingEdges : cohesion.crossingEdges,
				cohesion      : cohesion.cohesion,
				filePaths     : filePaths,
				clusterFingerprint: lCase( hash( jsonSerialize( {
					members       : filePaths,
					symbolCount   : max( 0, symbolCount ),
					internalEdges : cohesion.internalEdges,
					crossingEdges : cohesion.crossingEdges,
					cohesion      : cohesion.cohesion
				} ), "SHA-256" ) )
			} );
		}
		return presented;
	}

	private array function appendCoChangeMetrics( required array clusters, required struct coChange ) {
		for ( var cluster in arguments.clusters ) {
			var authors = {};
			var changeCount = 0;
			var lastTouched = "";
			for ( var path in ( cluster.filePaths ?: [] ) ) {
				var key = lCase( replace( trim( toString( path ) ), "\", "/", "all" ) );
				var fileStats = arguments.coChange.files[ key ] ?: {};
				changeCount += val( fileStats.changeCount ?: 0 );
				for ( var author in ( fileStats.authors ?: [] ) ) {
					var authorKey = trim( toString( author ) );
					if ( len( authorKey ) ) authors[ authorKey ] = true;
				}
				var touched = trim( toString( fileStats.lastTouched ?: "" ) );
				if ( len( touched ) && ( !len( lastTouched ) || compare( touched, lastTouched ) > 0 ) ) lastTouched = touched;
			}
			cluster.coChange = {
				changeCount: changeCount,
				authorCount: structKeyArray( authors ).len(),
				lastTouched: lastTouched
			};
		}
		return arguments.clusters;
	}

	private struct function coChangeSummary( required struct coChange ) {
		return {
			enabled   : arguments.coChange.enabled ?: false,
			available : arguments.coChange.available ?: false,
			degraded  : structKeyExists( arguments.coChange, "degraded" ) ? arguments.coChange.degraded : true,
			reason    : arguments.coChange.reason ?: "git-history-unavailable",
			truncated : arguments.coChange.truncated ?: false,
			commits   : val( arguments.coChange.commits ?: 0 ),
			files     : val( arguments.coChange.filesChanged ?: 0 ),
			pairCount : val( arguments.coChange.pairCount ?: 0 )
		};
	}

	private array function buildClusterEdges( required any graph, required struct clusterOf, required struct truncation ) {
		var merged = {};
		for ( var edge in arguments.graph.getEdges() ) {
			var fromCluster = arguments.clusterOf[ edge.fromFile ] ?: "";
			var toCluster = arguments.clusterOf[ edge.toFile ] ?: "";
			if ( !len( fromCluster ) || !len( toCluster ) || fromCluster == toCluster ) continue;
			var key = fromCluster & "\0" & toCluster;
			if ( !merged.keyExists( key ) ) {
				merged[ key ] = {
					from     : fromCluster,
					to       : toCluster,
					weight   : 0,
					edgeCount: 0,
					kinds    : []
				};
			}
			merged[ key ].edgeCount++;
			for ( var edgeKind in ( isArray( edge.kinds ?: "" ) ? edge.kinds : [ edge.kind ?: "" ] ) ) {
				if ( len( trim( toString( edgeKind ) ) ) && !merged[ key ].kinds.contains( edgeKind ) ) merged[ key ].kinds.append( edgeKind );
			}
			merged[ key ].weight = round4( merged[ key ].weight + val( edge.weight ?: 1 ) );
		}

		var keys = sortedKeys( merged );
		var output = [];
		for ( var key in keys ) {
			merged[ key ].kinds.sort( ( a, b ) => compareNoCase( a, b ) );
			output.append( merged[ key ] );
		}
		output.sort( ( a, b ) => {
			var byFrom = compareNoCase( a.from, b.from );
			if ( byFrom != 0 ) return byFrom;
			return compareNoCase( a.to, b.to );
		} );
		return output;
	}

	private struct function indexFileStats( required struct inventory, required struct reviewGraph ) {
		var byFile = {};
		var symbolCount = 0;
		var fileCount = 0;

		for ( var unit in ( arguments.inventory.units ?: [] ) ) {
			var key = normalizePath( unit.filePath ?: "" );
			if ( !len( key ) ) continue;
			if ( !byFile.keyExists( key ) ) {
				byFile[ key ] = {
					path         : unit.filePath,
					symbolCount  : 0,
					lineCount    : 1,
					language     : languageFor( unit.filePath )
				};
				fileCount++;
			}
			var isFileUnit = left( toString( unit.id ?: "" ), 5 ) == "file:";
			if ( !isFileUnit ) {
				byFile[ key ].symbolCount++;
				symbolCount++;
			}
			byFile[ key ].lineCount = max( byFile[ key ].lineCount, val( unit.endLine ?: 1 ) );
		}

		// Prefer explicit file metadata when present.
		var lists = [];
		if ( isArray( arguments.reviewGraph.files ?: "" ) ) lists.append( arguments.reviewGraph.files );
		if ( isArray( arguments.reviewGraph.scannedFiles ?: "" ) ) lists.append( arguments.reviewGraph.scannedFiles );
		for ( var list in lists ) {
			for ( var entry in list ) {
				if ( !isStruct( entry ) ) continue;
				var path = entry.filePath ?: entry.path ?: "";
				var key = normalizePath( path );
				if ( !len( key ) || !byFile.keyExists( key ) ) continue;
				if ( isNumeric( entry.lineCount ?: "" ) ) byFile[ key ].lineCount = max( byFile[ key ].lineCount, val( entry.lineCount ) );
				if ( isArray( entry.lines ?: "" ) ) byFile[ key ].lineCount = max( byFile[ key ].lineCount, entry.lines.len() );
				if ( len( trim( toString( entry.language ?: "" ) ) ) ) byFile[ key ].language = entry.language;
			}
		}

		return { byFile: byFile, fileCount: fileCount, symbolCount: symbolCount };
	}

	private array function buildNodes(
		required any graph,
		required struct inventory,
		required struct fileStats,
		required struct clusterOf,
		struct crossingCounts = {},
		struct roleEvidence = {},
		struct churnByFile = {}
	) {
		var canonical = arguments.inventory.canonicalPaths ?: {};
		var nodes = [];
		var graphNodes = arguments.graph.getNodes();

		for ( var graphNode in graphNodes ) {
			var key = normalizePath( graphNode.id ?: graphNode.filePath ?: "" );
			if ( !len( key ) ) continue;
			var path = canonical.keyExists( key ) ? canonical[ key ] : ( graphNode.filePath ?: key );
			var stats = arguments.fileStats.byFile[ key ] ?: {
				path       : path,
				symbolCount: max( 0, val( graphNode.unitCount ?: 0 ) - 1 ),
				lineCount  : 1,
				language   : languageFor( path )
			};
			var clusterId = arguments.clusterOf[ key ] ?: "";
			var fanInValue = arguments.graph.fanIn( key );
			var fanOutValue = arguments.graph.fanOut( key );
			var inCycle = arguments.graph.cycleMembersFor( key ).len() > 0;
			var crossing = val( arguments.crossingCounts[ key ] ?: 0 );
			var component = architectureModelService.classifyFile( path );
			var role = assignRole( {
				path     : path,
				component: component,
				fanIn    : fanInValue,
				fanOut   : fanOutValue,
				evidence : arguments.roleEvidence[ key ] ?: {}
			} );
			var churnStats = arguments.churnByFile[ key ] ?: {};
			var churn = val( churnStats.changeCount ?: 0 );
			var score = centralityService.hotspotScore( fanInValue, fanOutValue, churn, inCycle, crossing );

			nodes.append( {
				id           : key,
				path         : path,
				dir          : parentDir( path ),
				component    : component,
				layer        : component,
				role         : role,
				language     : stats.language,
				symbolCount  : stats.symbolCount,
				lineCount    : stats.lineCount,
				fanIn        : fanInValue,
				fanOut       : fanOutValue,
				churnCount   : churn,
				clusterId    : clusterId,
				hotspotScore : round4( score ),
				inCycle      : inCycle,
				// A ranking nobody can interrogate is a ranking nobody trusts, and
				// the formula was published once per snapshot rather than per node.
				// Every input is already computed here; only the product survived.
				rankRationale: centralityService.rankRationale( fanInValue, fanOutValue, churn, inCycle, crossing )
			} );
		}

		nodes.sort( ( a, b ) => compareNoCase( a.path, b.path ) );
		return nodes;
	}

	private string function assignRole( required struct nodeMeta ) {
		var component = trim( toString( arguments.nodeMeta.component ?: "" ) );
		var path = lCase( replace( arguments.nodeMeta.path ?: "", "\", "/", "all" ) );
		var fanIn = val( arguments.nodeMeta.fanIn ?: 0 );
		var fanOut = val( arguments.nodeMeta.fanOut ?: 0 );
		var evidence = isStruct( arguments.nodeMeta.evidence ?: "" ) ? arguments.nodeMeta.evidence : {};

		if ( evidence.clientAsset ?: false ) return "client";
		if ( evidence.integration ?: false ) return "integration";
		if ( evidence.entryPoint ?: false ) return "entry";
		if ( evidence.persistence ?: false ) return "persistence";
		if ( evidence.orchestrator ?: false ) return "orchestrator";

		if ( component == "tests" ) {
			return "test";
		}
		if ( component == "http-handlers" || component == "entry-points" ) {
			return "entry";
		}
		if ( component == "views" ) return "view";
		if ( isPersistencePath( path ) ) {
			return "persistence";
		}
		if ( component == "application-models" ) {
			if ( isOrchestratorPath( path, fanIn, fanOut ) ) {
				return "orchestrator";
			}
			return "domain";
		}
		if ( listFindNoCase( "configuration,documentation,manifests", component ) ) {
			return "shared";
		}
		return "unknown";
	}

	private struct function indexRoleEvidence( required struct inventory ) {
		var evidence = {};
		for ( var unit in ( arguments.inventory.units ?: [] ) ) {
			if ( !isStruct( unit ) ) continue;
			var key = normalizePath( unit.filePath ?: "" );
			if ( !len( key ) ) continue;
			if ( !evidence.keyExists( key ) ) evidence[ key ] = { symbols: 0, injects: 0 };
			if ( lCase( toString( unit.unitType ?: "" ) ) != "file" ) evidence[ key ].symbols++;
			if ( lCase( toString( unit.unitType ?: "" ) ) == "handler-action" ) evidence[ key ].entryPoint = true;
		}
		for ( var dep in ( arguments.inventory.dependencies ?: [] ) ) {
			if ( !isStruct( dep ) ) continue;
			var key = normalizePath( dep.filePath ?: "" );
			if ( !len( key ) ) continue;
			if ( !evidence.keyExists( key ) ) evidence[ key ] = { symbols: 0, injects: 0 };
			var kind = lCase( trim( toString( dep.kind ?: "" ) ) );
			if ( kind == "injects" ) evidence[ key ].injects++;
			if ( listFindNoCase( "table-query,table-read,table-write,writes,datasource", kind ) ) evidence[ key ].persistence = true;
			if ( listFindNoCase( "http,schedule,calls-api", kind ) ) evidence[ key ].integration = true;
			if ( kind == "routes" ) evidence[ key ].entryPoint = true;
			if ( kind == "extends" && reFindNoCase( "handler|resthandler|basespec", toString( dep.target ?: "" ) ) ) evidence[ key ].entryPoint = true;
		}
		for ( var key in evidence ) {
			var path = lCase( key );
			if ( reFind( "(^|/)public/assets?/", path ) || listFindNoCase( "js,jsx,mjs", listLast( path, "." ) ) ) evidence[ key ].clientAsset = true;
			// Read the entry, not the map: `evidence.injects` resolved against the
			// outer path-keyed struct, was always 0, and left this branch dead.
			if ( ( evidence[ key ].injects ?: 0 ) >= 2 && ( evidence[ key ].symbols ?: 0 ) <= 12 ) evidence[ key ].orchestrator = true;
		}
		return evidence;
	}

	/**
	 * Role distribution across **files**, not across every node in the snapshot.
	 *
	 * `snapshot.nodes` holds routes, tables, config keys, events and responses
	 * alongside files, so this counted 252 `shared` for a repository with five
	 * config *files* — 247 of them were config keys. That number leads the canvas
	 * role legend, which makes it the first structural claim a reader meets, and
	 * it described the extraction rather than the codebase.
	 */
	private struct function countRoles( required array nodes ) {
		var counts = {};
		for ( var node in arguments.nodes ) {
			var rawId = trim( toString( node.id ?: node.path ?: "" ) );
			var prefix = lCase( listFirst( rawId, ":" ) );
			if ( find( ":", rawId ) > 0 && listFindNoCase( "route,table,config,event,http,schedule,response", prefix ) > 0 ) {
				continue;
			}
			var role = trim( toString( node.role ?: "unknown" ) );
			counts[ role ] = ( counts[ role ] ?: 0 ) + 1;
		}
		return counts;
	}

	private boolean function isPersistencePath( required string path ) {
		var normalized = arguments.path;
		if ( reFind( "(^|/)(dao|repositories?|persistence|stores?)(/|$)", normalized ) ) {
			return true;
		}
		var baseName = listFirst( listLast( normalized, "/" ), "." );
		return reFind( "(dao|repository|repo)$", baseName ) > 0;
	}

	private boolean function isOrchestratorPath( required string path, required numeric fanIn, required numeric fanOut ) {
		var baseName = listFirst( listLast( arguments.path, "/" ), "." );
		if ( reFind( "(service|manager|coordinator|orchestr|facade)$", baseName ) > 0 ) {
			return true;
		}
		return arguments.fanOut >= 2 && arguments.fanIn >= 1;
	}

	private struct function indexCrossingEdges( required any graph, required struct clusterOf ) {
		var counts = {};
		for ( var edge in arguments.graph.getEdges() ) {
			var from = normalizePath( edge.fromFile ?: "" );
			var to = normalizePath( edge.toFile ?: "" );
			var fromCluster = arguments.clusterOf[ from ] ?: "";
			var toCluster = arguments.clusterOf[ to ] ?: "";
			if ( !len( fromCluster ) || !len( toCluster ) || fromCluster == toCluster ) continue;
			counts[ from ] = ( counts[ from ] ?: 0 ) + 1;
			counts[ to ] = ( counts[ to ] ?: 0 ) + 1;
		}
		return counts;
	}

	private array function selectHotspots( required array nodes, required numeric limit, required struct truncation ) {
		var ranked = duplicate( arguments.nodes );
		ranked = ranked.filter( ( node ) => !isSyntheticNode( node ) );
		ranked.sort( ( a, b ) => {
			if ( a.hotspotScore != b.hotspotScore ) return a.hotspotScore > b.hotspotScore ? -1 : 1;
			return compareNoCase( a.path, b.path );
		} );
		if ( ranked.len() > arguments.limit ) {
			markTruncated( arguments.truncation, "maxHotspots" );
			ranked = ranked.slice( 1, arguments.limit );
		}
		return ranked.map( ( node ) => {
			return {
				id           : node.id,
				path         : node.path,
				hotspotScore : node.hotspotScore,
				// Q16 is "which components matter most, **and why**". The rationale
				// existed on the node and not on the hotspot list — the one view that
				// answers the question — so a reader got a ranked list of paths with
				// no reason attached. Found by reading the view, not by querying it.
				rankRationale: node.rankRationale ?: "",
				fanIn        : node.fanIn,
				fanOut       : node.fanOut,
				churnCount   : node.churnCount ?: 0,
				symbolCount  : node.symbolCount,
				lineCount    : node.lineCount,
				inCycle      : node.inCycle,
				clusterId    : node.clusterId,
				component    : node.component,
				layer        : node.layer
			};
		} );
	}

	private array function selectOrphans( required array nodes, required numeric limit, required struct truncation ) {
		var orphans = [];
		for ( var node in arguments.nodes ) {
			if ( isSyntheticNode( node ) ) continue;
			if ( node.fanIn != 0 || node.fanOut != 0 ) continue;
			if ( node.component == "entry-points" || node.component == "tests" ) continue;
			orphans.append( {
				id        : node.id,
				path      : node.path,
				component : node.component,
				layer     : node.layer,
				clusterId : node.clusterId
			} );
		}
		orphans.sort( ( a, b ) => compareNoCase( a.path, b.path ) );
		if ( orphans.len() > arguments.limit ) {
			markTruncated( arguments.truncation, "maxOrphans" );
			orphans = orphans.slice( 1, arguments.limit );
		}
		return orphans;
	}

	private numeric function countOrphanCandidates( required array nodes ) {
		var count = 0;
		for ( var node in arguments.nodes ) {
			if ( isSyntheticNode( node ) ) continue;
			if ( node.fanIn != 0 || node.fanOut != 0 ) continue;
			if ( node.component == "entry-points" || node.component == "tests" ) continue;
			count++;
		}
		return count;
	}

	private array function selectLayerViolations(
		required any graph,
		required struct canonicalPaths,
		required numeric limit,
		required struct truncation,
		struct visibleNodes = {},
		any policy = "application-models>http-handlers"
	) {
		var violations = [];
		var candidateCount = 0;
		for ( var edge in arguments.graph.getEdges() ) {
			var fromPath = arguments.canonicalPaths[ edge.fromFile ] ?: edge.fromFile;
			var toPath = arguments.canonicalPaths[ edge.toFile ] ?: edge.toFile;
			var fromLayer = architectureModelService.classifyFile( fromPath );
			var toLayer = architectureModelService.classifyFile( toPath );
			if ( architectureRuleService.isLayerViolation( fromLayer, toLayer, arguments.policy ) ) {
				candidateCount++;
				if ( arguments.visibleNodes.count() && ( !arguments.visibleNodes.keyExists( normalizePath( edge.fromFile ) ) || !arguments.visibleNodes.keyExists( normalizePath( edge.toFile ) ) ) ) continue;
				violations.append( {
					from      : fromPath,
					to        : toPath,
					fromLayer : fromLayer,
					toLayer   : toLayer,
					kind      : edge.kind ?: "",
					weight    : edge.weight ?: 1
				} );
			}
		}
		violations.sort( ( a, b ) => {
			var byFrom = compareNoCase( a.from, b.from );
			if ( byFrom != 0 ) return byFrom;
			return compareNoCase( a.to, b.to );
		} );
		// Candidates are counted before the visible-node filter, so comparing that
		// count to the limit flags truncation the cap did not cause. Only the cut
		// itself is truncation; the filtered rows are a different loss.
		arguments.truncation.layerViolationCandidates = candidateCount;
		if ( violations.len() > arguments.limit ) {
			markTruncated( arguments.truncation, "maxLayerViolations" );
			violations = violations.slice( 1, arguments.limit );
		}
		return violations;
	}


	private array function directoryRollup( required array nodes ) {
		var dirs = {};
		for ( var node in arguments.nodes ) {
			if ( isSyntheticNode( node ) ) continue;
			var dir = node.dir ?: "";
			if ( !len( dir ) ) dir = ".";
			if ( !dirs.keyExists( dir ) ) {
				dirs[ dir ] = {
					path        : dir,
					fileCount   : 0,
					symbolCount : 0,
					fanInSum    : 0,
					fanOutSum   : 0
				};
			}
			dirs[ dir ].fileCount++;
			dirs[ dir ].symbolCount += val( node.symbolCount ?: 0 );
			dirs[ dir ].fanInSum += val( node.fanIn ?: 0 );
			dirs[ dir ].fanOutSum += val( node.fanOut ?: 0 );
		}
		var keys = sortedKeys( dirs );
		var output = [];
		for ( var key in keys ) output.append( dirs[ key ] );
		return output;
	}


	private boolean function isSyntheticNode( required struct node ) {
		return reFindNoCase( "^(route|table|http|schedule|config|event):", toString( arguments.node.id ?: "" ) ) > 0;
	}

	private string function normalizeRoute( required any target ) {
		return pathNormalizer().route( arguments.target );
	}

	private string function languageFor( required string filePath ) {
		var extension = lCase( listLast( arguments.filePath, "." ) );
		if ( listFindNoCase( "bx,bxm,bxs", extension ) ) return "BoxLang";
		if ( listFindNoCase( "cfc,cfm,cfml", extension ) ) return "CFML";
		if ( listFindNoCase( "js,jsx", extension ) ) return "JavaScript";
		return "";
	}

	private string function parentDir( required string filePath ) {
		var path = replace( arguments.filePath, "\", "/", "all" );
		var parts = listToArray( path, "/" );
		if ( parts.len() <= 1 ) return "";
		arrayDeleteAt( parts, parts.len() );
		return arrayToList( parts, "/" );
	}

	private void function markTruncated( required struct truncation, required string reason ) {
		arguments.truncation.truncated = true;
		if ( !arguments.truncation.reasons.contains( arguments.reason ) ) {
			arguments.truncation.reasons.append( arguments.reason );
		}
	}

	private array function sortedKeys( required struct source ) {
		var keys = structKeyArray( arguments.source );
		arraySort( keys, "textnocase" );
		return keys;
	}

	private any function syntheticNodeBuilder() {
		if ( isNull( variables.syntheticNodes ?: javacast( "null", "" ) ) ) {
			variables.syntheticNodes = new app.models.services.SyntheticNodeBuilder();
		}
		return variables.syntheticNodes;
	}

	private string function normalizePath( required any path ) {
		return pathNormalizer().path( arguments.path );
	}

	private numeric function round4( required numeric value ) {
		return round( arguments.value * 10000 ) / 10000;
	}

	/**
	 * Sorted-key JSON so fingerprints stay stable under key-order shuffle.
	 * Same SHA-256 discipline as ModernizationCouplingGraphService.stableHash.
	 */
	private string function canonicalJson( required any value ) {
		if ( isNull( arguments.value ) ) return "null";
		if ( isStruct( arguments.value ) ) {
			var keys = sortedKeys( arguments.value );
			var parts = [];
			for ( var key in keys ) {
				parts.append( '"' & escapeJson( key ) & '":' & canonicalJson( arguments.value[ key ] ) );
			}
			return "{" & arrayToList( parts, "," ) & "}";
		}
		if ( isArray( arguments.value ) ) {
			var items = [];
			for ( var entry in arguments.value ) {
				items.append( canonicalJson( entry ) );
			}
			return "[" & arrayToList( items, "," ) & "]";
		}
		if ( isBoolean( arguments.value ) && !isNumeric( arguments.value ) ) {
			return arguments.value ? "true" : "false";
		}
		if ( isNumeric( arguments.value ) ) {
			return toString( arguments.value );
		}
		return '"' & escapeJson( toString( arguments.value ) ) & '"';
	}

	private string function escapeJson( required string value ) {
		var out = replace( arguments.value, "\", "\\", "all" );
		out = replace( out, '"', '\"', "all" );
		out = replace( out, char( 10 ), "\n", "all" );
		out = replace( out, char( 13 ), "\r", "all" );
		out = replace( out, char( 9 ), "\t", "all" );
		return out;
	}

	private string function stableHash( required string value ) {
		return lCase( hash( arguments.value, "SHA-256" ) );
	}
	private any function pathNormalizer() {
		if ( isNull( variables.graphPathNormalizer ?: javacast( "null", "" ) ) ) {
			variables.graphPathNormalizer = new app.models.services.GraphPathNormalizer();
		}
		return variables.graphPathNormalizer;
	}
}
