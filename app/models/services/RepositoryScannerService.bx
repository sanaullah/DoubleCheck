/**
 * Discovers reviewable source files for working-tree, revision-diff, or full modes.
 *
 * @see GitRepositoryService
 */

@singleton
class {
	property name="maxFiles" inject="coldbox:setting:scanMaxFiles";

	property name="maxBytes" inject="coldbox:setting:scanMaxBytes";

	property name="maxFileBytes" inject="coldbox:setting:scanMaxFileBytes";

	property name="maxEntries" inject="coldbox:setting:scanMaxEntries";

	property name="modernizeMaxFiles" inject="coldbox:setting:modernizeScanMaxFiles";

	property name="modernizeMaxBytes" inject="coldbox:setting:modernizeScanMaxBytes";

	property name="modernizeMaxEntries" inject="coldbox:setting:modernizeScanMaxEntries";

	property name="modernizeMaxJavaScriptFiles" inject="coldbox:setting:modernizeScanMaxJavaScriptFiles";

	property name="gitRepositoryService" inject="GitRepositoryService";

	property name="supportedLanguageService" inject="SupportedLanguageService";

	property name="log" inject="logbox:logger:{this}";

	property name="secretRedactionService" inject="SecretRedactionService";
	variables.ignoredDirectories = [
		".git",
		".agents",
		".ai",
		".idea",
		".vscode",
		".venv",
		"__pycache__",
		"node_modules",
		"vendor",
		"lib",
		"runtime",
		"data",
		"dist",
		"build",
		"coverage"
	];
	variables.sensitiveNames = [
		".env",
		".env.local",
		".env.production",
		"id_rsa",
		"id_ed25519",
		"credentials",
		"credentials.json"
	];
	variables.sensitiveExtensions = [
		"pem",
		"key",
		"p12",
		"pfx",
		"jks",
		"keystore"
	];

	function init() {
		if (
			isNull(
				variables.supportedLanguageService ?: javacast( "null", "" )
			)
		) {
			variables.supportedLanguageService = new app.models.services.SupportedLanguageService();
		}
		return this;
	}

	/**
	 * Discovers, filters, bounds, reads, and redacts source files for one run.
	 * The result includes skip metrics so scan limits remain visible to callers.
	 */
	struct function scan(
		required string projectPath,
		string mode         = "working-tree",
		string baseRevision = "",
		string headRevision = "HEAD",
		struct options      = {}
	) {
		var root = createObject( "java", "java.io.File" ).init( arguments.projectPath ).getCanonicalFile();
		var supportedExtensions = supportedLanguageService.extensionMap();
		var isModernize = arguments.options.modernize ?: false;
		var effectiveMaxFiles = numericLimit(
			arguments.options.maxFiles ?: ( isModernize ? ( variables.modernizeMaxFiles ?: variables.maxFiles ) : variables.maxFiles ),
			variables.maxFiles
		);
		var effectiveMaxBytes = numericLimit(
			arguments.options.maxBytes ?: ( isModernize ? ( variables.modernizeMaxBytes ?: variables.maxBytes ) : variables.maxBytes ),
			variables.maxBytes
		);
		var effectiveMaxEntries = numericLimit(
			arguments.options.maxEntries ?: ( isModernize ? ( variables.modernizeMaxEntries ?: variables.maxEntries ) : variables.maxEntries ),
			variables.maxEntries
		);
		var effectiveMaxJavaScriptFiles = isModernize
			? numericLimit( arguments.options.maxJavaScriptFiles ?: ( variables.modernizeMaxJavaScriptFiles ?: 500 ), 500 )
			: effectiveMaxFiles;
		var candidateResult = candidatePaths(
			root,
			arguments.mode,
			arguments.baseRevision,
			arguments.headRevision,
			effectiveMaxEntries
		);
		var files = [];
		var totalBytes = 0;
		var skipped = {
			ignored   : 0,
			unsupported: 0,
			oversized : 0,
			binary    : 0,
			unreadable: 0,
			limit     : 0
		};
		var candidateLanguageCounts = {};
		var indexedJavaScriptFiles = 0;
		var prioritizedPaths = prioritizeCandidatePaths(
			candidateResult.paths,
			arguments.options.priorityExtensions ?: ( arguments.options.modernize ?: false ? [ "cfm", "cfc", "bx", "bxm", "bxs" ] : [] ),
			arguments.options.priorityPathPrefixes ?: []
		);
		// The /review file picker can narrow a scan to a chosen subset; an
		// empty/omitted list means "scan everything" (existing behavior).
		var hasFileSelection = isArray( arguments.options.selectedFiles ?: "" ) && arguments.options.selectedFiles.len() > 0;
		var selectedFileSet = {};
		if ( hasFileSelection ) {
			for ( var selectedPath in arguments.options.selectedFiles ) {
				selectedFileSet[ normalizePath( toString( selectedPath ) ) ] = true;
			}
		}
		var pathPrefixes = [];
		if ( isArray( arguments.options.pathPrefixes ?: "" ) ) {
			for ( var prefix in arguments.options.pathPrefixes ) {
				var normalizedPrefix = reReplace( replace( trim( toString( prefix ) ), "\", "/", "all" ), "/+$", "" );
				if ( len( normalizedPrefix ) ) pathPrefixes.append( normalizedPrefix );
			}
		}

		var candidateIndex = 0;
		for ( var candidatePath in prioritizedPaths ) {
			candidateIndex++;
			if ( isModernize && candidateIndex % 25 == 0 && isCustomFunction( arguments.options.checkCancellation ?: "" ) ) {
				arguments.options.checkCancellation();
			}
			var extensionHint = lCase( listLast( replace( toString( candidatePath ), "\\", "/", "all" ), "." ) );
			if ( len( extensionHint ) && supportedExtensions.keyExists( extensionHint ) ) {
				var languageHint = supportedExtensions[ extensionHint ];
				candidateLanguageCounts[ languageHint ] = val( candidateLanguageCounts[ languageHint ] ?: 0 ) + 1;
			}
			if ( files.len() >= effectiveMaxFiles ) {
				skipped.limit++;
				continue;
			}
			try {
				var candidate = createObject( "java", "java.io.File" ).init( candidatePath ).getCanonicalFile();
				var revisionContent = len( candidateResult.contentRevision ?: "" );
				if ( !candidate.toPath().startsWith( root.toPath() ) || ( !revisionContent && !candidate.isFile() ) ) {
					skipped.ignored++;
					continue;
				}

				var relativePath = normalizePath( root
						.toPath()
						.relativize( candidate.toPath() )
						.toString() );
				if ( shouldIgnore( relativePath ) ) {
					skipped.ignored++;
					continue;
				}
				if ( hasFileSelection && !selectedFileSet.keyExists( relativePath ) ) {
					skipped.ignored++;
					continue;
				}
				if ( pathPrefixes.len() && !pathMatchesPrefixes( relativePath, pathPrefixes ) ) {
					skipped.ignored++;
					continue;
				}

				var extension = lCase( listLast( relativePath, "." ) );
				if ( !supportedExtensions.keyExists( extension ) ) {
					skipped.unsupported++;
					continue;
				}
				if ( isModernize && supportedExtensions[ extension ] == "JavaScript" && indexedJavaScriptFiles >= effectiveMaxJavaScriptFiles ) {
					skipped.limit++;
					continue;
				}

				var sizeBytes = 0;
				var content = "";
				if ( revisionContent ) {
					var blob = gitRepositoryService.readBlob(
							root         = root,
							revision     = candidateResult.contentRevision,
							relativePath = relativePath,
							maxBytes     = maxFileBytes
						);
					if ( blob.oversized ) {
						skipped.oversized++;
						continue;
					}
					if ( !blob.available ) {
						skipped.unreadable++;
						continue;
					}
					sizeBytes = blob.sizeBytes;
					content = blob.content;
				} else {
					sizeBytes = candidate.length();
					if ( sizeBytes > maxFileBytes ) {
						skipped.oversized++;
						continue;
					}
					content = fileRead( candidate.getPath(), "UTF-8" );
				}
				if ( totalBytes + sizeBytes > effectiveMaxBytes ) {
					skipped.oversized++;
					continue;
				}
				if ( find( char( 0 ), content ) ) {
					skipped.binary++;
					continue;
				}
				var lines = listToArray(
					replace(
						content,
						char( 13 ),
						"",
						"all"
					),
					char( 10 ),
					true,
					true
				);
				var fileEntry = {
					filePath    : relativePath,
					absolutePath: revisionContent ? "" : candidate.getPath(),
					language    : supportedExtensions[ extension ],
					contentHash : lCase( hash( content, "SHA-256" ) ),
					sizeBytes   : sizeBytes,
					lineCount   : max( 1, lines.len() )
				};
				// A line array per file has extreme object overhead across a large
				// estate. Modernize retains one source string and its line count; the
				// inventory/context stages split one file at a time and release it.
				if ( isModernize ) {
					fileEntry.content = content;
				} else {
					fileEntry.content = content;
					fileEntry.lines = lines;
				}
				var changedLines = changedLinesFor(
					root,
					relativePath,
					arguments.mode,
					candidateResult,
					lines.len()
				);
				if ( changedLines.len() ) {
					fileEntry.changedLines = changedLines;
				}
				files.append( fileEntry );
				if ( isModernize ) lines = [];
				if ( supportedExtensions[ extension ] == "JavaScript" ) indexedJavaScriptFiles++;
				totalBytes += sizeBytes;
			} catch (any error) {
				skipped.unreadable++;
				if ( !isNull( variables.log ?: javacast( "null", "" ) ) ) {
					log.warn(
							"Repository file could not be indexed",
							{
								path      : toString( candidatePath ),
								type      : error.type ?: "",
								message   : secretRedactionService.redactText( error.message ?: "" ),
								stackTrace: secretRedactionService.redactText( error.stackTrace ?: "" )
							}
						);
				}
			}
		}

		var languages = [];
		files.each(
				( file ) => {
					if ( !languages.contains( file.language ) ) {
						languages.append( file.language );
					}
				}
			);
		languages.sort( "textnocase" );
		return {
			files             : files,
			candidateCount    : candidateResult.paths.len(),
			candidateLanguages: candidateLanguageCounts,
			languages         : languages,
			totalBytes        : totalBytes,
			skipped           : skipped,
			scope             : candidateResult.scope,
			gitAvailable      : candidateResult.gitAvailable,
			discoveryTruncated: candidateResult.discoveryTruncated ?: false,
			baseRevision      : candidateResult.baseRevision ?: "",
			headRevision      : candidateResult.headRevision ?: "",
			repositoryRevision: candidateResult.repositoryRevision ?: "",
			limits            : { maxFiles: effectiveMaxFiles, maxBytes: effectiveMaxBytes, maxEntries: effectiveMaxEntries, maxJavaScriptFiles: effectiveMaxJavaScriptFiles },
			error             : candidateResult.error ?: ""
		};
	}

	/**
	 * Lightweight file listing for the /review directory picker: same
	 * discovery/ignore/extension rules as scan(), but skips reading file
	 * contents so a large repository can be browsed quickly.
	 */
	struct function listSourceFiles(
		required string projectPath,
		string mode         = "full",
		string baseRevision = "",
		string headRevision = "HEAD"
	) {
		var root = createObject( "java", "java.io.File" ).init( arguments.projectPath ).getCanonicalFile();
		var supportedExtensions = supportedLanguageService.extensionMap();
		var candidateResult = candidatePaths(
			root,
			arguments.mode,
			arguments.baseRevision,
			arguments.headRevision
		);
		var files = [];
		var seen = {};
		for ( var candidatePath in candidateResult.paths ) {
			if ( files.len() >= maxFiles ) {
				break;
			}
			try {
				var candidate = createObject( "java", "java.io.File" ).init( candidatePath ).getCanonicalFile();
				var revisionContent = len( candidateResult.contentRevision ?: "" );
				if ( !candidate.toPath().startsWith( root.toPath() ) || ( !revisionContent && !candidate.isFile() ) ) {
					continue;
				}
				var relativePath = normalizePath( root
						.toPath()
						.relativize( candidate.toPath() )
						.toString() );
				if ( seen.keyExists( relativePath ) || shouldIgnore( relativePath ) ) {
					continue;
				}
				seen[ relativePath ] = true;
				var extension = lCase( listLast( relativePath, "." ) );
				if ( !supportedExtensions.keyExists( extension ) ) {
					continue;
				}
				files.append( { filePath: relativePath, language: supportedExtensions[ extension ] } );
			} catch (any ignored) {
				continue;
			}
		}
		files.sort( ( a, b ) => compareNoCase( a.filePath, b.filePath ) );
		return {
			files             : files,
			scope             : candidateResult.scope,
			gitAvailable      : candidateResult.gitAvailable,
			discoveryTruncated: candidateResult.discoveryTruncated ?: false,
			error             : candidateResult.error ?: ""
		};
	}

	/**
	 * Prefer CFML/BoxLang paths ahead of JS when a scan budget will truncate,
	 * so Modernize does not burn the file cap on assets before legacy pages.
	 * Optional priorityPathPrefixes further boost directory-scoped focus areas
	 * (e.g. legacy/_scheduledScripts or modules/orders) ahead of the rest of the estate.
	 */
	array function prioritizeCandidatePaths( required array paths, array priorityExtensions = [], array priorityPathPrefixes = [] ) {
		if ( ( !arguments.priorityExtensions.len() && !arguments.priorityPathPrefixes.len() ) || arguments.paths.len() < 2 ) return arguments.paths;
		var preferred = {};
		for ( var extension in arguments.priorityExtensions ) preferred[ lCase( trim( extension ) ) ] = true;
		var prefixes = [];
		for ( var prefix in arguments.priorityPathPrefixes ) {
			var normalizedPrefix = reReplace( replace( trim( toString( prefix ) ), "\", "/", "all" ), "/+$", "" );
			if ( len( normalizedPrefix ) ) prefixes.append( normalizedPrefix );
		}
		var scopedPrimary = [];
		var primary = [];
		var secondary = [];
		for ( var path in arguments.paths ) {
			var extension = lCase( listLast( replace( toString( path ), "\\", "/", "all" ), "." ) );
			var extensionPreferred = preferred.count() ? preferred.keyExists( extension ) : true;
			var prefixPreferred = prefixes.len() ? pathMatchesPrefixes( path, prefixes ) : false;
			if ( prefixPreferred && extensionPreferred ) scopedPrimary.append( path );
			else if ( extensionPreferred ) primary.append( path );
			else secondary.append( path );
		}
		return scopedPrimary.append( primary, true ).append( secondary, true );
	}

	boolean function pathMatchesPrefixes( required string relativePath, required array prefixes ) {
		var path = lCase( replace( trim( arguments.relativePath ), "\", "/", "all" ) );
		if ( !len( path ) ) return false;
		var haystack = "/" & reReplace( path, "^(\./)+", "" ) & "/";
		for ( var prefix in arguments.prefixes ) {
			var needle = lCase( reReplace( replace( trim( toString( prefix ) ), "\", "/", "all" ), "/+$", "" ) );
			if ( !len( needle ) ) continue;
			if ( findNoCase( "/" & needle & "/", haystack ) ) return true;
			if ( path == needle || left( path, len( needle ) + 1 ) == needle & "/" ) return true;
		}
		return false;
	}

	/**
	 * Attaches changed-line ranges only for working-tree / revision-diff
	 * scans; `full` mode leaves files without changedLines so ContextPackService
	 * keeps its current symbol-first behavior. Untracked files (no diff output)
	 * fall back to treating the whole file as changed.
	 */
	private array function changedLinesFor(
		required any root,
		required string relativePath,
		required string mode,
		required struct candidateResult,
		required numeric lineCount
	) {
		var normalizedMode = lCase( arguments.mode );
		if ( normalizedMode != "working-tree" && normalizedMode != "revision-diff" ) {
			return [];
		}
		var changed = gitRepositoryService.changedLineRanges(
				root         = arguments.root,
				relativePath = arguments.relativePath,
				baseRevision = normalizedMode == "working-tree" ? "HEAD" : ( arguments.candidateResult.baseRevision ?: "HEAD" ),
				headRevision = normalizedMode == "working-tree" ? "" : ( arguments.candidateResult.headRevision ?: "" )
			);
		if ( !changed.available ) {
			return [];
		}
		return changed.ranges.len() ? changed.ranges : [ { startLine: 1, endLine: max( 1, arguments.lineCount ) } ];
	}

	private struct function candidatePaths(
		required any root,
		required string mode,
		required string baseRevision,
		required string headRevision,
		numeric entryLimit = 0
	) {
		var effectiveEntryLimit = arguments.entryLimit > 0 ? int( arguments.entryLimit ) : int( variables.maxEntries );
		if ( lCase( arguments.mode ) == "working-tree" ) {
			var changes = gitRepositoryService.workingTreePaths( arguments.root, effectiveEntryLimit );
			if ( changes.available ) {
				return {
					paths             : changes.paths,
					scope             : "working-tree",
					gitAvailable      : true,
					discoveryTruncated: changes.truncated,
					repositoryRevision: changes.repositoryRevision
				};
			}
			return {
				paths             : [],
				scope             : "working-tree-unavailable",
				gitAvailable      : false,
				discoveryTruncated: false
			};
		}
		if ( lCase( arguments.mode ) == "revision-diff" ) {
			var revisionDiff = gitRepositoryService.revisionPaths(
					root         = arguments.root,
					baseRevision = arguments.baseRevision,
					headRevision = arguments.headRevision,
					maxEntries   = effectiveEntryLimit
				);
			return {
				paths             : revisionDiff.paths,
				scope             : revisionDiff.available ? "revision-diff" : "revision-diff-unavailable",
				gitAvailable      : revisionDiff.available,
				discoveryTruncated: revisionDiff.truncated,
				baseRevision      : revisionDiff.baseRevision,
				headRevision      : revisionDiff.headRevision,
				repositoryRevision: revisionDiff.repositoryRevision,
				contentRevision   : revisionDiff.headRevision,
				error             : revisionDiff.error
			};
		}

		var gitFiles = gitRepositoryService.fullPaths( arguments.root, effectiveEntryLimit );
		if ( gitFiles.available ) {
			return {
				paths             : gitFiles.paths,
				scope             : "full-git",
				gitAvailable      : true,
				discoveryTruncated: gitFiles.truncated,
				repositoryRevision: gitFiles.repositoryRevision
			};
		}
		return discoverPaths( arguments.root, effectiveEntryLimit );
	}

	private struct function discoverPaths( required any root, numeric entryLimit = 0 ) {
		var effectiveEntryLimit = arguments.entryLimit > 0 ? int( arguments.entryLimit ) : int( variables.maxEntries );
		var supportedExtensions = supportedLanguageService.extensionMap();
		var directories = [ arguments.root];
		var paths = [];
		var visited = {};
		var inspectedEntries = 0;
		var truncated = false;

		while ( directories.len() && inspectedEntries < effectiveEntryLimit ) {
			var directory = directories[ 1 ];
			arrayDeleteAt( directories, 1 );
			var canonicalDirectory = directory.getCanonicalFile();
			var directoryKey = lCase( canonicalDirectory.getPath() );
			if ( visited.keyExists( directoryKey ) ) {
				continue;
			}
			visited[ directoryKey ] = true;

			var listing = directoryList(
				canonicalDirectory.getPath(),
				false,
				"query"
			);
			for ( var row = 1; row <= listing.recordCount; row++ ) {
				inspectedEntries++;
				if ( inspectedEntries > effectiveEntryLimit ) {
					truncated = true;
					break;
				}

				var candidate = createObject( "java", "java.io.File" ).init( listing.directory[ row ] & "/" & listing.name[ row ] );
				var canonicalCandidate = candidate.getCanonicalFile();
				if ( !canonicalCandidate.toPath().startsWith( arguments.root.toPath() ) ) {
					continue;
				}
				var relativePath = normalizePath( arguments
						.root
						.toPath()
						.relativize( canonicalCandidate.toPath() )
						.toString() );
				if ( shouldIgnore( relativePath ) ) {
					continue;
				}
				if ( lCase( listing.type[ row ] ) == "dir" ) {
					directories.append( canonicalCandidate );
					continue;
				}
				if ( lCase( listing.type[ row ] ) == "file" ) {
					var extension = lCase( listLast( canonicalCandidate.getName(), "." ) );
					if ( supportedExtensions.keyExists( extension ) ) {
						paths.append( canonicalCandidate.getPath() );
					}
				}
			}
		}
		if ( directories.len() ) {
			truncated = true;
		}
		return {
			paths             : paths,
			scope             : "full",
			gitAvailable      : directoryExists( arguments.root.getPath() & "/.git" ),
			discoveryTruncated: truncated
		};
	}

	private numeric function numericLimit( required any value, required numeric fallback ) {
		return isNumeric( arguments.value ) && val( arguments.value ) > 0
			? int( arguments.value )
			: max( 1, int( arguments.fallback ) );
	}

	private boolean function shouldIgnore( required string relativePath ) {
		var normalized = "/" & lCase( normalizePath( arguments.relativePath ) ) & "/";
		if ( left( normalized, len( "/resources/codeinsight/" ) ) == "/resources/codeinsight/" ) {
			return true;
		}
		for ( var directory in variables.ignoredDirectories ) {
			if ( find( "/#lCase( directory )#/", normalized ) ) {
				return true;
			}
		}
		var fileName = lCase( listLast( normalizePath( arguments.relativePath ), "/" ) );
		if ( variables.sensitiveNames.contains( fileName ) || left( fileName, 5 ) == ".env." ) {
			return true;
		}
		var extension = listLen( fileName, "." ) > 1 ? listLast( fileName, "." ) : "";
		return variables.sensitiveExtensions.contains( extension );
	}

	private string function normalizePath( required string path ) {
		return replace(
			arguments.path,
			"\",
			"/",
			"all"
		);
	}
}
