/**
 * The graph's non-file entities: routes, tables, outbound integrations,
 * configuration keys and events.
 *
 * These are the endpoints of a flow — where a request enters and where it lands
 * — so they have to be nodes for a path to be drawable at all. They are bounded
 * by how many routes and tables a project has, not by its file count, which is
 * why `CodeGraphMetricsService` exempts them from the node cap.
 *
 * @see CodeGraphMetricsService
 */
@singleton
class threadsafe {
	property name="pathNormalizer" inject="GraphPathNormalizer";

	function init() {
		if ( isNull( variables.pathNormalizer ?: javacast( "null", "" ) ) ) {
			variables.pathNormalizer = new app.models.services.GraphPathNormalizer();
		}
		return this;
	}

	void function append( required array nodes, required array dependencies ) {
		var seen = {};
		for ( var node in arguments.nodes ) seen[ pathNormalizer.path( node.id ?: "" ) ] = true;
		for ( var dep in arguments.dependencies ) {
			var id = resourceId( dep );
			if ( !len( id ) || seen.keyExists( pathNormalizer.path( id ) ) ) continue;
			seen[ pathNormalizer.path( id ) ] = true;
			var meta = resourceMeta( id );
			arguments.nodes.append( {
				id          : id,
				path        : id,
				dir         : "",
				component   : meta.component,
				layer       : meta.component,
				role        : meta.role,
				language    : "",
				symbolCount : 0,
				lineCount   : 0,
				fanIn       : 0,
				fanOut      : 0,
				clusterId   : "",
				hotspotScore: 0,
				inCycle     : false
			} );
		}
		arguments.nodes.sort( ( a, b ) => compareNoCase( a.path, b.path ) );
	}

	/**
	 * The non-file entity a dependency points at, or "" when it points at a file.
	 *
	 * The single owner of this mapping. `CodeGraphProjectionService` needs the same
	 * answer to give these entities edges, and two copies of "what does a
	 * `table-write` row name" would drift the way five copies of `normalizePath`
	 * once did.
	 */
	string function resourceId( required any dep ) {
		if ( !isStruct( arguments.dep ) ) return "";
		var kind = lCase( trim( toString( arguments.dep.kind ?: "" ) ) );
		var target = trim( toString( arguments.dep.target ?: "" ) );
		var id = "";
		if ( kind == "routes" || kind == "calls-api" ) {
			var routePath = pathNormalizer.route( target );
			id = len( routePath ) ? "route:" & routePath : "";
		} else if ( listFindNoCase( "table-query,table-read,table-write", kind ) ) {
			id = "table:" & lCase( target );
		} else if ( listFindNoCase( "http,schedule", kind ) ) {
			id = kind & ":" & lCase( len( target ) ? target : kind );
		} else if ( kind == "emits" ) {
			id = "event:" & lCase( len( target ) ? target : "event" );
		} else if ( kind == "responds" ) {
			// The shape a request answers with, as an entity: it lets a reader ask
			// "which actions return JSON" and lets a flow end somewhere named.
			id = "response:" & lCase( len( target ) ? target : "data" );
		} else if ( kind == "reads-config" ) {
			// A setting is a thing the system has, not just a line in a file.
			// As a node it answers "what does this key affect" from either end.
			id = "config:" & lCase( len( target ) ? target : "config" );
		}
		// A bare prefix names nothing; it would collapse every unnamed row of that
		// kind onto one node and claim they were the same table or setting.
		return listFindNoCase( "route:,config:,event:,table:,http:,schedule:,response:", id ) ? "" : id;
	}

	/** Role and component for a resource id, so both producers label it alike. */
	struct function resourceMeta( required string id ) {
		var prefix = lCase( listFirst( arguments.id, ":" ) );
		if ( prefix == "route" ) return { role: "entry", component: "http-handlers" };
		if ( prefix == "table" ) return { role: "persistence", component: "application-models" };
		if ( prefix == "config" ) return { role: "shared", component: "configuration" };
		if ( prefix == "response" ) return { role: "entry", component: "http-handlers" };
		return { role: "integration", component: "other" };
	}
}
