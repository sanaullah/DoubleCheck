/**
 * Validates and fingerprints allowlisted roles and run budgets from the create payload.
 */

@singleton
class {
	property name="maxTasks" inject="coldbox:setting:planMaxTasks";

	property name="defaultTokenBudget" inject="coldbox:setting:runDefaultTokenBudget";

	property name="maxTokenBudget" inject="coldbox:setting:runMaxTokenBudget";

	property name="defaultTokensPerTask" inject="coldbox:setting:runDefaultTokensPerTask";

	property name="maxTokensPerTask" inject="coldbox:setting:runMaxTokensPerTask";

	property name="defaultDurationMs" inject="coldbox:setting:runDefaultDurationMs";

	property name="maxDurationMs" inject="coldbox:setting:runMaxDurationMs";

	property name="defaultIterationsPerTask" inject="coldbox:setting:runDefaultIterationsPerTask";

	property name="maxIterationsPerTask" inject="coldbox:setting:runMaxIterationsPerTask";

	property name="defaultToolOutputCharacters" inject="coldbox:setting:runDefaultToolOutputCharacters";

	property name="maxToolOutputCharacters" inject="coldbox:setting:runMaxToolOutputCharacters";

	property name="defaultCostUsd" inject="coldbox:setting:runDefaultCostUsd";

	property name="maxCostUsd" inject="coldbox:setting:runMaxCostUsd";

	property name="appSettingsService" inject="AppSettingsService";
	variables.policyVersion = "review-policy-v1";
	variables.budgetVersion = "run-budgets-v2";
	variables.allowedRoles = [
		"correctness",
		"security",
		"architecture",
		"testing",
		"performance",
		"boxlang-conventions",
		"cfml-conventions"
	];

	struct function normalize( struct input = {} ) {
		var requestedPolicy = arguments.input.policy ?: {};
		var requestedBudgets = arguments.input.budgets ?: {};
		if ( !isStruct( requestedPolicy ) ) {
			validationError( "policy must be an object" );
		}
		if ( !isStruct( requestedBudgets ) ) {
			validationError( "budgets must be an object" );
		}
		var roles = normalizeRoles( requestedPolicy.allowedRoles ?: [] );
		var reviewGoal = normalizeReviewGoal( requestedPolicy.reviewGoal ?: "" );
		var fast = isBoolean( arguments.input.fast ?: "" ) ? arguments.input.fast : false;
		// Each resolved* value checks the Settings-panel override first,
		// falling back to the coldbox:setting (env-derived) value injected
		// above when no override has been saved - read fresh every call so
		// a Settings change applies to the very next run.
		var resolvedMaxTasks = appSettingsService.get( "planMaxTasks", maxTasks );
		var resolvedDefaultTokenBudget = appSettingsService.get( "runDefaultTokenBudget", defaultTokenBudget );
		var resolvedMaxTokenBudget = appSettingsService.get( "runMaxTokenBudget", maxTokenBudget );
		var resolvedDefaultTokensPerTask = appSettingsService.get( "runDefaultTokensPerTask", defaultTokensPerTask );
		var resolvedMaxTokensPerTask = appSettingsService.get( "runMaxTokensPerTask", maxTokensPerTask );
		var resolvedDefaultDurationMs = appSettingsService.get( "runDefaultDurationMs", defaultDurationMs );
		var resolvedMaxDurationMs = appSettingsService.get( "runMaxDurationMs", maxDurationMs );
		var resolvedDefaultIterationsPerTask = appSettingsService.get( "runDefaultIterationsPerTask", defaultIterationsPerTask );
		var resolvedMaxIterationsPerTask = appSettingsService.get( "runMaxIterationsPerTask", maxIterationsPerTask );
		var resolvedDefaultToolOutputCharacters = appSettingsService.get( "runDefaultToolOutputCharacters", defaultToolOutputCharacters );
		var resolvedMaxToolOutputCharacters = appSettingsService.get( "runMaxToolOutputCharacters", maxToolOutputCharacters );
		var resolvedDefaultCostUsd = appSettingsService.get( "runDefaultCostUsd", defaultCostUsd );
		var resolvedMaxCostUsd = appSettingsService.get( "runMaxCostUsd", maxCostUsd );
		var taskLimit = boundedInteger(
			requestedBudgets.maxTasks ?: resolvedMaxTasks,
			"budgets.maxTasks",
			1,
			resolvedMaxTasks
		);
		var tokenLimit = boundedInteger(
			requestedBudgets.maxTokens ?: resolvedDefaultTokenBudget,
			"budgets.maxTokens",
			128,
			resolvedMaxTokenBudget
		);
		var perTaskLimit = boundedInteger(
			requestedBudgets.maxTokensPerTask ?: resolvedDefaultTokensPerTask,
			"budgets.maxTokensPerTask",
			128,
			resolvedMaxTokensPerTask
		);
		if ( perTaskLimit > tokenLimit ) {
			validationError(
				"budgets.maxTokensPerTask cannot exceed budgets.maxTokens"
			);
		}
		var durationLimit = boundedInteger(
			requestedBudgets.maxDurationMs ?: resolvedDefaultDurationMs,
			"budgets.maxDurationMs",
			1000,
			resolvedMaxDurationMs
		);
		var iterationLimit = boundedInteger(
			requestedBudgets.maxIterationsPerTask ?: resolvedDefaultIterationsPerTask,
			"budgets.maxIterationsPerTask",
			1,
			resolvedMaxIterationsPerTask
		);
		var toolOutputLimit = boundedInteger(
			requestedBudgets.maxToolOutputCharacters ?: resolvedDefaultToolOutputCharacters,
			"budgets.maxToolOutputCharacters",
			1000,
			resolvedMaxToolOutputCharacters
		);
		var costLimit = boundedDecimal(
			requestedBudgets.maxCostUsd ?: resolvedDefaultCostUsd,
			"budgets.maxCostUsd",
			.01,
			resolvedMaxCostUsd
		);
		var policy = {
			version     : variables.policyVersion,
			allowedRoles: roles,
			reviewGoal  : reviewGoal,
			fast        : fast
		};
		policy.fingerprint = stableHash( policy.version & "|" & roles.toList( "," ) & "|" & reviewGoal & "|" & fast );
		var budgets = {
			version                : variables.budgetVersion,
			maxTasks               : taskLimit,
			maxTokens              : tokenLimit,
			maxTokensPerTask       : perTaskLimit,
			maxDurationMs          : durationLimit,
			maxIterationsPerTask   : iterationLimit,
			maxToolOutputCharacters: toolOutputLimit,
			maxCostUsd             : costLimit
		};
		budgets.fingerprint = stableHash( budgets.version & "|" & budgets.maxTasks & "|" & budgets.maxTokens & "|" & budgets.maxTokensPerTask & "|" & budgets.maxDurationMs & "|" & budgets.maxIterationsPerTask & "|" & budgets.maxToolOutputCharacters & "|" & budgets.maxCostUsd );
		return { policy: policy, budgets: budgets };
	}

	private array function normalizeRoles( required any requestedRoles ) {
		if ( !isArray( arguments.requestedRoles ) ) {
			validationError( "policy.allowedRoles must be an array" );
		}
		var requested = arguments.requestedRoles;
		if ( !requested.len() ) {
			return duplicate( variables.allowedRoles );
		}
		for ( var role in requested ) {
			if ( !isSimpleValue( role ) || !variables.allowedRoles.contains( lCase( trim( role ) ) ) ) {
				validationError( "policy.allowedRoles contains an unsupported role" );
			}
		}
		var normalized = variables.allowedRoles.filter( ( role ) => requested.findNoCase( role ) > 0 );
		if ( !normalized.len() ) {
			validationError( "policy.allowedRoles must select at least one role" );
		}
		return normalized;
	}

	private string function normalizeReviewGoal( required any value ) {
		if ( !isSimpleValue( arguments.value ) ) {
			validationError( "policy.reviewGoal must be text" );
		}
		var goal = trim( toString( arguments.value ) );
		if ( len( goal ) > 500 ) {
			validationError( "policy.reviewGoal must be 500 characters or fewer" );
		}
		return goal;
	}

	private numeric function boundedInteger(
		required any value,
		required string field,
		required numeric minimum,
		required numeric maximum
	) {
		if (
			!isNumeric( arguments.value ) || val( arguments.value ) != int( val( arguments.value ) ) ||
					val( arguments.value ) < arguments.minimum ||
				val( arguments.value ) > arguments.maximum
		) {
			validationError(
				"#arguments.field# must be an integer between #arguments.minimum# and #arguments.maximum#"
			);
		}
		return int( val( arguments.value ) );
	}

	private void function validationError( required string message ) {
		throw( type = "ValidationException", message = arguments.message );
	}

	private numeric function boundedDecimal(
		required any value,
		required string field,
		required numeric minimum,
		required numeric maximum
	) {
		if ( !isNumeric( arguments.value ) || val( arguments.value ) < arguments.minimum || val( arguments.value ) > arguments.maximum ) {
			validationError(
				"#arguments.field# must be between #arguments.minimum# and #arguments.maximum#"
			);
		}
		return int( val( arguments.value ) * 1000000 ) / 1000000;
	}

	private string function stableHash( required string value ) {
		return lCase( hash( arguments.value, "SHA-256" ) );
	}
}