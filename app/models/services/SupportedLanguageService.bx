/**
 * Canonical registry for languages supported by repository review.
 */

@singleton
class {
	variables.languages = [
		{
			name      : "BoxLang",
			extensions: [ "bx", "bxm", "bxs"],
			tier      : "unverified"
		},
		{
			name      : "CFML",
			extensions: [ "cfc", "cfm"],
			tier      : "discovery-only"
		},
		{
			name      : "JavaScript",
			extensions: [ "js", "jsx"],
			tier      : "discovery-only"
		}
	];

	/**
	 * Returns the supported language definitions in product order.
	 */
	array function definitions() {
		return duplicate( variables.languages );
	}

	/**
	 * Returns a map of lowercase source extensions to language names.
	 */
	struct function extensionMap() {
		var extensions = {};
		for ( var language in variables.languages ) {
			for ( var extension in language.extensions ) {
				extensions[ extension ] = language.name;
			}
		}
		return extensions;
	}
}