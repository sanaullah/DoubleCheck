/**
 * Versioned, role-specific prompt contracts for the Modernize workflow.
 * Prompts are chat-only: repository text is evidence, never executable
 * instructions. Optional skill packs are reference material only.
 */
@singleton
class {
	property name="skillService" inject="ModernizationSkillService";
	property name="promptCompiler" inject="PromptCompiler";
	property name="aiProviderResolver" inject="AIProviderResolverService";
	variables.promptVersion = "modernization-prompt-v6";
	variables.skillRoles = [
		"modernization-application",
		"modernization-database",
		"modernization-roadmap",
		"modernization-slice-rebuild"
	];

	function init() {
		if ( isNull( variables.skillService ?: javacast( "null", "" ) ) ) {
			variables.skillService = new app.models.services.ModernizationSkillService();
		}
		return this;
	}

	struct function build(
		required string role,
		struct runtime = {},
		struct evidence = {},
		struct budgets = {}
	) {
		var safeRole = lCase( trim( arguments.role ) );
		if ( ![ "modernization-application", "modernization-database", "modernization-roadmap", "modernization-architecture", "modernization-repair", "modernization-slice-rebuild", "modernization-item-rebuild" ].contains( safeRole ) ) {
			throw( type = "ValidationException", message = "Unsupported modernization agent role" );
		}
		var runtimeName = trim( arguments.runtime.runtime ?: "" );
		var profile = trim( arguments.runtime.layoutProfile ?: arguments.runtime.profile ?: "" );
		var roleInstruction = roleInstruction( safeRole, arguments.evidence );
		var evidenceJson = jsonSerialize( boundedEvidence( arguments.evidence, safeRole ) );
		var skillPack = [];
		if ( variables.skillRoles.contains( safeRole ) ) {
			try {
				skillPack = variables.skillService.listPack( len( runtimeName ) ? runtimeName : "boxlang", len( profile ) ? profile : "modern", safeRole );
			} catch ( any ignored ) {
				skillPack = [];
			}
		}
		var compiled = getCompiler().compile(
			safeRole,
			{
					task: {
						runtime       : runtimeName,
						profile       : profile,
						roleInstruction: roleInstruction,
						budgets       : arguments.budgets
					},
				evidence : jsonDeserialize( evidenceJson ),
				reference: skillPack
			},
			{ provider: providerName(), model: modelName(), budgets: arguments.budgets }
		);
		var user = compiled.userPrompt;
		var promptPackage = duplicate( compiled );
		promptPackage.userPrompt = user;
		promptPackage.messages = [ { role: "system", content: compiled.systemPrompt }, { role: "user", content: user } ];
		var provenance = duplicate( compiled.provenance );
		provenance.promptVersion = variables.promptVersion;
		provenance.contractVersion = compiled.promptVersion;
		provenance.role = safeRole;
		provenance.outputSchema = compiled.outputSchema;
		promptPackage.provenance = duplicate( provenance );
		return {
			role         : safeRole,
			promptVersion: variables.promptVersion,
			promptId     : compiled.promptId,
			contractVersion: compiled.promptVersion,
			outputSchemaId: compiled.outputSchema,
			messages     : [ { role: "system", content: compiled.systemPrompt }, { role: "user", content: user } ],
			outputSchema : compiled.schema,
			promptPackage: promptPackage,
			runtime      : runtimeName,
			profile      : profile,
			budgets      : duplicate( arguments.budgets ),
			skillPack    : skillPack,
			provenance   : provenance,
			validationContext: collectValidationContext( arguments.evidence )
		};
	}

	string function version() {
		return variables.promptVersion;
	}

	private any function getCompiler() {
		if ( !isNull( variables.promptCompiler ?: javacast( "null", "" ) ) ) return variables.promptCompiler;
		variables.promptCompiler = new app.models.services.PromptCompiler();
		return variables.promptCompiler;
	}

	private string function providerName() {
		if ( !isNull( variables.aiProviderResolver ?: javacast( "null", "" ) ) ) return variables.aiProviderResolver.resolve().provider ?: "";
		return "";
	}

	private string function modelName() {
		if ( !isNull( variables.aiProviderResolver ?: javacast( "null", "" ) ) ) return variables.aiProviderResolver.resolve().model ?: "";
		return "";
	}

	/**
	 * Keeps the evidence ledger available to the shared output validator without
	 * putting repository text into the immutable system contract.
	 */
	private struct function collectValidationContext( required struct evidence ) {
		var ids = [];
		var paths = [];
		collectEvidenceReferences( arguments.evidence, ids, paths, "" );
		return { allowedEvidenceIds: ids, allowedFilePaths: paths };
	}

	private void function collectEvidenceReferences( required any value, required array ids, required array paths, string parentKey = "" ) {
		if ( isArray( arguments.value ) ) {
			for ( var item in arguments.value ) collectEvidenceReferences( item, arguments.ids, arguments.paths, arguments.parentKey );
			return;
		}
		if ( !isStruct( arguments.value ) ) return;
		for ( var key in arguments.value ) {
			var value = arguments.value[ key ];
			var normalizedKey = lCase( trim( key ) );
			if ( [ "evidenceRefs", "evidenceFactIds", "evidenceIds" ].contains( normalizedKey ) && isArray( value ) ) {
				for ( var reference in value ) if ( isSimpleValue( reference ) && len( trim( toString( reference ) ) ) && !arguments.ids.contains( toString( reference ) ) ) arguments.ids.append( toString( reference ) );
			}
			if ( normalizedKey == "evidence" && isArray( value ) ) {
				for ( var record in value ) if ( isStruct( record ) ) {
					if ( len( trim( record.filePath ?: "" ) ) && !arguments.paths.contains( record.filePath ) ) arguments.paths.append( record.filePath );
					if ( len( trim( record.id ?: "" ) ) && !arguments.ids.contains( record.id ) ) arguments.ids.append( record.id );
				}
			}
			collectEvidenceReferences( value, arguments.ids, arguments.paths, normalizedKey );
		}
	}

	private string function roleInstruction( required string role, struct evidence = {} ) {
		switch ( arguments.role ) {
			case "modernization-application":
				var shard = isStruct( arguments.evidence.shardMeta ?: "" ) ? arguments.evidence.shardMeta : {};
				if ( shard.count() && isArray( shard.paths ?: "" ) && shard.paths.len() ) {
					var targetCap = min( 8, max( 4, shard.paths.len() + 2 ) );
					var linkCap = min( 8, max( 4, shard.paths.len() + 2 ) );
					var routeCap = min( 6, max( 2, shard.paths.len() ) );
					return "APPLICATION SHARD #val( shard.index ?: 1 )# of #val( shard.total ?: 1 )#. Analyze ONLY these legacy paths: #shard.paths.toList( ', ' )#. Account for every listed path: it must appear as a target sourcePath or a unitLink sourcePath; group related pages into coherent handler/service/view slices when behavior supports it instead of creating one handler per filename. Return COMPLETE COMPACT JSON with keys in this exact order: targetUnits, unitLinks, routeContracts, samples, contexts, extracts. Hard caps: #targetCap# targetUnits, #linkCap# unitLinks, #routeCap# routeContracts, 1 sample. contexts and extracts MUST be empty arrays []. Keep purpose/notes/rollback under 160 characters, sample code under 12 lines, symbol/signature arrays under 6 entries, and each evidenceRefs/evidence array under 4 items. Do not repeat source excerpts in prose. For every target include legal ColdBox targetPath, layer, symbol/method names and signatures, purpose, sourcePath, legacyUnitIds, evidenceRefs, confidence, validationStatus. A route is allowed only for an evidenced cflocation/form/remote-method/entry seam and must include a non-empty `path` (the legacy request path, e.g. /admin/manageUsers.cfm), targetUnitId, and unitLinkId. A route without `path` is discarded. Preserve UNKNOWN for method/auth/response/sideEffects when source does not establish them. Do not infer admin/auth or side effects from names. Do not turn custom tags, includes, cffile/cfpdf actions, stylesheet links, or arbitrary URL variables into routes. Do not invent files outside this shard.";
				}
				return "Produce implementer-ready target units in a strangler plan, not a folder summary. Map behavior into coherent ColdBox handler/service/view/config concerns and avoid one handler per page filename. Return COMPLETE compact JSON with keys in this exact order: targetUnits, unitLinks, routeContracts, samples, contexts, extracts. contexts and extracts MUST be empty arrays; architecture extraction is a separate evidence decision. Every target needs a legal ColdBox targetPath, layer, evidenced symbols/signatures, purpose, sourcePath, legacyUnitIds, source-range evidenceRefs, confidence, and validationStatus. Routes require actual navigation or remote-entry evidence, a non-empty `path` (the legacy request path), targetUnitId, unitLinkId, and UNKNOWN values where method/auth/response/side effects are not established. A route without `path` is discarded. Scaffold-only targets need newProposal=true and proposalReason.";
			case "modernization-database":
				return "Produce actionable dbFindings for observed schema objects and app readers/writers. Return COMPLETE COMPACT JSON with no more than 20 dbFindings, 24 dbTransitions, and 2 samples. Inspect schemaEvidence before deciding whether DDL is present; sourceKind=auto-discovered and populated tables/columns are real DDL evidence. Consolidate repeated reader/writer issues by object rather than repeating one finding per file. Keep problem, proposedChange, and rollback under 160 characters; keep sampleMigration to an up/down skeleton under 12 lines; keep every ID/evidence array under 6 items. Each finding needs category, severity, objectRef, problem, proposedChange, evidenceRefs, confidence, expandContract stage, related legacy/target ids, and validationStatus. Each transition needs operation, order, migrationPath, bounded sampleMigration with up/down skeleton, rollback, objects touched, and irreversible flag. When schema is absent, emit one explicit inference-limit finding and do not invent tables, columns, indexes, or procedures. Prefer finishing a smaller complete JSON over truncating a larger one.";
			case "modernization-repair":
				return "Replace only the listed invalid item fingerprints. Return replacements with the same itemFingerprint and no new items. Do not rewrite valid items, invent evidence, or broaden the repair scope.";
			case "modernization-slice-rebuild":
				var phaseId = trim( arguments.evidence.phaseId ?: arguments.evidence.phase.id ?: "" );
				var note = trim( arguments.evidence.note ?: "" );
				return "Rebuild only roadmap phase `#phaseId#` and its linked target units, unitLinks, routeContracts, samples, and related db findings/transitions. Honor the user note when present: `#note#`. Do not rewrite unrelated phases. Improve idiomatic ColdBox naming and sample-contract compliance using the supplied legacy evidence pack. Emit a fragment with targetUnits, unitLinks, routeContracts, roadmapPhase, samples, and optional dbFindings/dbTransitions arrays.";
			case "modernization-architecture":
				// Deliberately light: this call already covers the FULL repository
				// map in one shot (unsharded, unlike application/roadmap), so its
				// per-group output must stay small. The step-by-step migration
				// guide (migrationSteps) is generated separately by the sharded
				// roadmap role instead — asking for structured multi-step guidance
				// here, across every group, in one whole-repo call risked exactly
				// the same overload/timeout failure the roadmap role used to hit.
				return "Analyze the FULL aggregated target unit map, unitLinks, routeContracts, and coupling signals across the whole repository at once — not a narrow shard window. Return at most 48 compact placements, each with a stable domainKey, recommended placementType (main-app, coldbox-module, external-service, background-worker, or scheduled-service), at most 40 targetUnitIds, at most 40 evidenceRefs, a short rationale, uncertainty, and optional questions. If a domain has more than 40 units, emit multiple placements that share the same domainKey/placementType instead of one oversized array. Group units that share one feature domain. Progressive packaging ladder (follow strictly): (1) DEFAULT is main-app — shared bootstrap, config, temp/common/js/static folders, and loosely related views stay in the monolith. (2) background-worker for general scheduled/job folders that stay near the monolith data plane; scheduled-service for integration-heavy jobs (payments, mail APIs, webhooks, CRM/inventory connectors, cloud identity) that may later become a separate jobs host. (3) coldbox-module ONLY for a cohesive in-process feature boundary that can share deployment/runtime/data (e.g. a real modules/ package or a tightly cohesive nested feature folder) — do NOT label every top-level folder as a module. (4) external-service ONLY for a separate small application / side-app / microservice candidate with an explicit deployable seam (its own Application.cfc/cfm tree, separate hosting root, independent ops boundary) — never promote scheduled jobs, temp, or shared includes to microservices. Prefer main-app whenever unsure. Do not emit gates, alternatives, migration steps, or long prose—the application derives those deterministically. Leave units that do not fit a coherent group uncovered; the pipeline will conservatively fill gaps. Do not invent units, signals, or evidence not present in the supplied map.";
			case "modernization-item-rebuild":
				var rebuildItemType = trim( arguments.evidence.itemType ?: "" );
				var rebuildItemId = trim( arguments.evidence.itemId ?: "" );
				var rebuildNote = trim( arguments.evidence.note ?: "" );
				return "Rebuild only the single #rebuildItemType# with id `#rebuildItemId#`. Return exactly one replacement item with that same id in the matching array (dbFindings for a db-finding, dbTransitions for a db-transition) and leave the other array empty. Honor the user note when present: `#rebuildNote#`. Use only the supplied prior item and schemaEvidence; do not invent tables, columns, indexes, or procedures not already present there. Do not widen scope to other findings or transitions.";
			default:
				var roadmapShard = isStruct( arguments.evidence.shardMeta ?: "" ) ? arguments.evidence.shardMeta : {};
				if ( roadmapShard.count() && isArray( roadmapShard.targetUnitIds ?: "" ) && roadmapShard.targetUnitIds.len() ) {
					var roadmapGroupLabel = trim( roadmapShard.groupName ?: "Slice" );
					var shardIds = roadmapShard.targetUnitIds;
					var listedIds = shardIds.len() > 24 ? shardIds.slice( 1, 24 ) : shardIds;
					var idListText = listedIds.toList( ", " );
					var moreIdsNote = shardIds.len() > 24
						? " (plus #( shardIds.len() - 24 )# more ids in shard evidence — cover the listed ids with representative migrationSteps; do not enumerate every remaining id in prose)"
						: "";
					// migrationSteps lives here (not on the architecture role) because
					// this call is already sharded to a small, bounded group of units —
					// the one place a concrete legacy-file/method-to-target guide can be
					// requested for every phase without risking the whole-repo overload
					// that made the unsharded architecture call time out.
					// Never dump thousands of leftover unit ids into the immutable task
					// segment: PromptCompiler treats roleInstruction as uncapped and a
					// megashard list exceeds AI_MAX_PROMPT_CHARACTERS before evidence fits.
					return "ROADMAP SHARD #val( roadmapShard.index ?: 1 )# of #val( roadmapShard.total ?: 1 )# — group `#roadmapGroupLabel#`. Produce EXACTLY ONE roadmap phase covering ONLY these target unit ids: #idListText##moreIdsNote#. Do not reference any unit, route, finding, or transition id outside this list and its linked evidence. Set dependencies to an empty array and currentSlice to false; the pipeline assigns phase order and the current slice deterministically after all shards return. Return COMPLETE COMPACT JSON with keys roadmapPhases (array with exactly one phase), samples, assumptions. Prefer actionable modernization fields: classification (remain-monolith|refactor-monolith|coldbox-module|background-worker|scheduled-service|microservice|external-service|retire|investigate), wave (integer), risks, rollbackStrategy, testingStrategy, estimatedComplexity (low|medium|high|unknown), componentIds. Legacy file references belong only inside migrationSteps.legacyRef as evidence — do not center the phase name on legacy comparison. The phase also needs goal, pattern, unitIds (matching the listed ids), routeIds, dbFindingIds, transitionIds, sampleIds, parityIntent, exitCriteria, rollback, implementerPrompt. Keep goal/parityIntent/rollback/implementerPrompt under 200 characters and exitCriteria to at most 4 short items. Also produce migrationSteps: up to 6 ordered steps, each with action, legacyRef ({filePath,symbolName} copied from this shard's own evidence, never invented), targetRef ({targetPath,methodName} matching one of this shard's own listed unit ids), and an optional note. When this shard lists more units than 6 steps can cover, pick the most representative steps rather than trying to enumerate every unit — migrationSteps is a starting guide, not an exhaustive list. The `signals` array is this slice's deterministic coupling evidence — shared application scope, session or auth gates, include chains, dynamic component construction, SQL coupling, Java or outbound integration — each with a hit count and file:line examples. Name the two or three highest-count signals explicitly in implementerPrompt and cover them in migrationSteps: that coupling is what makes this slice hard, not moving files. Never cite a signal that is not listed. Cover only evidenced work; do not manufacture module, side-app, schema-transition, auth, or retirement decisions.";
				}
				return "After application and database fragments are merged, produce a concise ordered roadmap using ONLY IDs present in the merged plan. Prioritize actionable migration information: classification, wave, risks, rollbackStrategy, testingStrategy, estimatedComplexity. Legacy comparisons belong only as evidence refs. Preserve coexistence. When target.contexts or target.extracts already group units into coherent feature domains, prefer one phase per coherent group over one catch-all phase — a group's targetUnitIds is a strong hint for that phase's unitIds. Only fall back to a single combined phase when no such grouping exists. Each phase needs goal/pattern, earlier-phase dependencies, linked unit/route/finding/transition ids, parity intent, exitCriteria, rollback, implementerPrompt, and linked sample ids. Put route IDs only in routeIds and target-unit IDs only in unitIds. Mark exactly one actionable mapped phase currentSlice=true. Cover only evidenced work; do not manufacture module, side-app, schema-transition, auth, or retirement decisions. Deduplicate assumptions and omit assumptions already represented by evidence.";
		}
	}

	private struct function outputSchema( required string role ) {
		if ( arguments.role == "modernization-application" ) {
			return {
				targetUnits: [ { id: "string", targetPath: "string", layer: "handler|service|view|config|interceptor|test|module", symbolNames: [ "string" ], signatures: [ "string" ], purpose: "string", sourcePath: "string", legacyUnitIds: [ "string" ], evidenceRefs: [ "evidence-id" ], relatedDbFindingIds: [ "string" ], confidence: "0..1", validationStatus: "passed|warning|failed|needs-review", sampleCode: "bounded skeleton string" } ],
				unitLinks: [ { id: "string", legacyUnitId: "string", sourcePath: "string", targetUnitId: "string", relation: "coexist-route|implicit-view|stage-legacy-model|wrap-api|migrate|split|merge|retain-legacy|retire|acl-boundary", notes: "string", evidenceRefs: [ { filePath: "string", startLine: 1, endLine: 1 } ], confidence: "0..1", validationStatus: "string" } ],
				routeContracts: [ { id: "string", path: "/legacy.cfm", legacyPath: "/legacy.cfm", targetEvent: "handler.action", targetRoute: "/target", targetUnitId: "string", unitLinkId: "string", method: "GET|POST|UNKNOWN", relation: "coexist-route", rollback: "string", request: { method: "GET|POST|UNKNOWN", path: "/legacy.cfm" }, response: {}, auth: "string|UNKNOWN", sideEffects: [ "string" ], evidence: [ { filePath: "string", startLine: 1, endLine: 1 } ], validationStatus: "string" } ],
				contexts: [ { id: "string", name: "string", purpose: "string", targetUnitIds: [ "string" ], stayInMonolith: true, evidenceBasis: "explicit-seam|domain-clustering", evidenceRefs: [ "evidence-id" ] } ],
				extracts: [ { id: "string", name: "string", reason: "string", suggestedBoundary: "string", dataBoundaryNote: "string", sharedDatasourceRisk: "string", targetUnitIds: [ "string" ], evidenceBasis: "explicit-seam|domain-clustering", evidenceRefs: [ "evidence-id" ] } ],
				samples: [ { id: "string", sampleKind: "app|test", targetPath: "string", language: "boxlang|cfml|javascript", code: "bounded skeleton string", relatedItemIds: [ "string" ], irreversible: false } ]
			};
		}
		if ( arguments.role == "modernization-architecture" ) {
			return {
				placements: [ { id: "string", domainKey: "string", name: "string", placementType: "main-app|coldbox-module|external-service|background-worker|scheduled-service", targetUnitIds: [ "string" ], rationale: "short string", evidenceRefs: [ "evidence-id" ], uncertainty: [ "string" ], questions: [ "string" ] } ],
				contexts: [ { id: "string", name: "string", purpose: "string", packaging: "centralized|coldbox-module", targetUnitIds: [ "string" ], stayInMonolith: true, recommendation: "string", evidenceBasis: "explicit-seam|domain-clustering", evidenceRefs: [ "evidence-id" ], moduleSlug: "string", dependsOnContextIds: [ "string" ] } ],
				extracts: [ { id: "string", name: "string", reason: "string", suggestedBoundary: "string", dataBoundaryNote: "string", sharedDatasourceRisk: "string", targetUnitIds: [ "string" ], recommendation: "string", evidenceBasis: "explicit-seam|domain-clustering", evidenceRefs: [ "evidence-id" ], moduleSlug: "string", dependsOnContextIds: [ "string" ] } ]
			};
		}
		if ( arguments.role == "modernization-database" ) {
			return {
				dbFindings: [ { id: "string", category: "type|constraint|index|design|cf-sql-mismatch|coverage", severity: "blocker|high|medium|low|info", objectRef: "string", problem: "string", proposedChange: "string", expandContract: "expand|backfill|contract|safe-now|defer", relatedLegacyUnitIds: [ "string" ], relatedTargetUnitIds: [ "string" ], evidenceRefs: [ "evidence-id" ], confidence: "0..1", validationStatus: "string" } ],
				dbTransitions: [ { id: "string", dbFindingId: "string", operation: "expand|backfill|switch|contract", order: 1, migrationPath: "resources/database/migrations/YYYY_MM_DD_HHMMSS_name.bx", objectsTouched: [ "string" ], sampleMigration: "bounded up/down skeleton", rollback: "string", irreversible: false, evidenceRefs: [ "evidence-id" ] } ],
				samples: [ { id: "string", sampleKind: "migration", targetPath: "string", language: "sql|boxlang", code: "bounded skeleton string", relatedItemIds: [ "string" ], irreversible: false } ]
			};
		}
		if ( arguments.role == "modernization-repair" ) return { replacements: "array" };
		if ( arguments.role == "modernization-slice-rebuild" ) {
			return {
				targetUnits: "array",
				unitLinks: "array",
				routeContracts: "array",
				roadmapPhase: { id: "string", name: "string", goal: "string", pattern: "string", unitIds: [ "string" ], routeIds: [ "string" ], sampleIds: [ "string" ], dbFindingIds: [ "string" ], transitionIds: [ "string" ], parityIntent: "string", exitCriteria: [ "string" ], rollback: "string", implementerPrompt: "string", currentSlice: false },
				samples: "array",
				dbFindings: "array",
				dbTransitions: "array"
			};
		}
		if ( arguments.role == "modernization-item-rebuild" ) {
			return {
				dbFindings: [ { id: "string", category: "type|constraint|index|design|cf-sql-mismatch|coverage", severity: "blocker|high|medium|low|info", objectRef: "string", problem: "string", proposedChange: "string", expandContract: "expand|backfill|contract|safe-now|defer", relatedLegacyUnitIds: [ "string" ], relatedTargetUnitIds: [ "string" ], evidenceRefs: [ "evidence-id" ], confidence: "0..1", validationStatus: "string" } ],
				dbTransitions: [ { id: "string", dbFindingId: "string", operation: "expand|backfill|switch|contract", order: 1, migrationPath: "resources/database/migrations/YYYY_MM_DD_HHMMSS_name.bx", objectsTouched: [ "string" ], sampleMigration: "bounded up/down skeleton", rollback: "string", irreversible: false, evidenceRefs: [ "evidence-id" ] } ]
			};
		}
		return { roadmapPhases: [ { id: "string", name: "string", goal: "string", pattern: "string", dependencies: [ "phase-id" ], unitIds: [ "string" ], routeIds: [ "string" ], dbFindingIds: [ "string" ], transitionIds: [ "string" ], parityIntent: "string", exitCriteria: [ "string" ], rollback: "string", implementerPrompt: "string", sampleIds: [ "string" ], currentSlice: false, migrationSteps: [ { order: 1, action: "string", legacyRef: { filePath: "string", symbolName: "string" }, targetRef: { targetPath: "string", methodName: "string" }, note: "string" } ] } ], samples: "array", assumptions: "array" };
	}

	private struct function boundedEvidence( required struct evidence, string role = "" ) {
		var result = {};
		// Architecture and roadmap see the whole repository map, not a 2-file shard —
		// they need more room than a single application shard call needs per call, not
		// less. 40000 stays below application's 48000 (shard scans include raw source
		// excerpts; the whole-repo passes only see the already-compacted unit/link/route
		// map via compactArchitectureEvidence/compactRoadmapEvidence).
		var characterLimit = arguments.role == "modernization-application"
			? 48000
			: ( arguments.role == "modernization-database"
				? 36000
				: ( [ "modernization-architecture", "modernization-roadmap" ].contains( arguments.role ) ? 40000 : 24000 ) );
		var source = arguments.role == "modernization-roadmap"
			? compactRoadmapEvidence( arguments.evidence )
			: ( arguments.role == "modernization-architecture"
				? compactArchitectureEvidence( arguments.evidence )
				: ( arguments.role == "modernization-database" ? compactDatabaseEvidence( arguments.evidence ) : arguments.evidence ) );
		var orderedKeys = arguments.role == "modernization-application"
			? [ "shardMeta", "inventory", "context", "signals", "schemaEvidence", "coverage" ]
			: ( arguments.role == "modernization-database"
				? [ "schemaEvidence", "signals", "coverage" ]
				: ( arguments.role == "modernization-repair"
					? [ "invalidItems", "validation", "inventory", "schemaEvidence", "context" ]
					: ( arguments.role == "modernization-architecture"
						// Signals ahead of routeContracts: coupling/seam evidence is
						// what an explicit-seam vs domain-clustering call rests on,
						// and this whole-repo call can exhaust its budget before the
						// later keys are reached.
						? [ "target", "unitLinks", "signals", "routeContracts", "coverage" ]
						: ( arguments.role == "modernization-item-rebuild"
							? [ "priorItem", "schemaEvidence" ]
							: [ "target", "unitLinks", "routeContracts", "dbFindings", "dbTransitions", "samples", "signals", "coverage", "assumptions" ] ) ) ) );
		var included = {};
		for ( var key in orderedKeys ) {
			if ( !source.keyExists( key ) ) continue;
			included[ key ] = true;
			result[ key ] = arguments.role == "modernization-database" && key == "signals"
				? boundedValue( databaseSignals( source[ key ] ), 0, characterLimit )
				: boundedValue( source[ key ], 0, characterLimit );
			if ( len( jsonSerialize( result ) ) >= characterLimit ) break;
		}
		for ( var key in source.keyArray().sort( "textnocase" ) ) {
			if ( included.keyExists( key ) || len( jsonSerialize( result ) ) >= characterLimit ) continue;
			result[ key ] = boundedValue( source[ key ], 0, characterLimit );
		}
		return result;
	}

	private struct function compactRoadmapEvidence( required struct evidence ) {
		var target = isStruct( arguments.evidence.target ?: "" ) ? arguments.evidence.target : {};
		return {
			target: {
				units: compactRecords(
					isArray( target.units ?: "" ) ? target.units : [],
					[ "id", "targetPath", "sourcePath", "layer", "purpose", "confidence", "validationStatus" ],
					200
				),
				placements: compactRecords(
					isArray( target.placements ?: "" ) ? target.placements : [],
					[ "id", "name", "domainKey", "placementType", "targetUnitIds", "rationale", "decisionRequired" ],
					48
				),
				contexts: compactRecords(
					isArray( target.contexts ?: "" ) ? target.contexts : [],
					[ "id", "name", "targetUnitIds", "stayInMonolith", "recommendation" ],
					30
				),
				extracts: compactRecords(
					isArray( target.extracts ?: "" ) ? target.extracts : [],
					[ "id", "name", "targetUnitIds", "suggestedBoundary", "dataBoundaryNote" ],
					30
				)
			},
			unitLinks: compactRecords(
				isArray( arguments.evidence.unitLinks ?: "" ) ? arguments.evidence.unitLinks : [],
				[ "id", "targetUnitId", "legacyUnitId", "sourcePath", "relation", "validationStatus" ],
				200
			),
			routeContracts: compactRecords(
				isArray( arguments.evidence.routeContracts ?: "" ) ? arguments.evidence.routeContracts : [],
				[ "id", "path", "legacyPath", "method", "targetUnitId", "unitLinkId", "validationStatus" ],
				200
			),
			dbFindings: compactRecords(
				isArray( arguments.evidence.dbFindings ?: "" ) ? arguments.evidence.dbFindings : [],
				[ "id", "category", "severity", "objectRef", "problem", "proposedChange", "validationStatus" ],
				100
			),
			dbTransitions: compactRecords(
				isArray( arguments.evidence.dbTransitions ?: "" ) ? arguments.evidence.dbTransitions : [],
				[ "id", "dbFindingId", "operation", "order", "objectsTouched", "irreversible" ],
				100
			),
			samples: compactRecords(
				isArray( arguments.evidence.samples ?: "" ) ? arguments.evidence.samples : [],
				[ "id", "sampleKind", "targetPath", "relatedItemIds", "phaseId" ],
				60
			),
			signals: compactRecords(
				isArray( arguments.evidence.signals ?: "" ) ? arguments.evidence.signals : [],
				[ "signalId", "group", "meaning", "count", "files" ],
				20
			),
			coverage: arguments.evidence.coverage ?: {},
			assumptions: arguments.evidence.assumptions ?: []
		};
	}

	private struct function compactArchitectureEvidence( required struct evidence ) {
		var target = isStruct( arguments.evidence.target ?: "" ) ? arguments.evidence.target : {};
		var units = preferModelMappedUnits( isArray( target.units ?: "" ) ? target.units : [] );
		return {
			target: {
				units: compactRecords(
					units,
					[ "id", "targetPath", "sourcePath", "layer", "purpose", "confidence", "validationStatus" ],
					80
				),
				placements: compactRecords(
					isArray( target.placements ?: "" ) ? target.placements : [],
					[ "id", "name", "domainKey", "placementType", "targetUnitIds", "rationale", "evidenceRefs", "uncertainty" ],
					30
				)
			},
			unitLinks: compactRecords(
				preferModelMappedLinks( isArray( arguments.evidence.unitLinks ?: "" ) ? arguments.evidence.unitLinks : [], units ),
				[ "id", "targetUnitId", "legacyUnitId", "sourcePath", "relation", "validationStatus" ],
				80
			),
			routeContracts: compactRecords(
				isArray( arguments.evidence.routeContracts ?: "" ) ? arguments.evidence.routeContracts : [],
				[ "id", "path", "legacyPath", "method", "targetUnitId", "unitLinkId", "validationStatus" ],
				40
			),
			signals: architectureSignals( arguments.evidence.signals ?: [] ),
			coverage: arguments.evidence.coverage ?: {}
		};
	}

	/** Prefer LLM-mapped units so architecture does not drown in coverage-fallback stubs. */
	private array function preferModelMappedUnits( required array units ) {
		var preferred = [];
		var fallback = [];
		for ( var unit in arguments.units ) {
			if ( !isStruct( unit ) ) continue;
			if ( isCoverageFallbackUnit( unit ) ) fallback.append( unit );
			else preferred.append( unit );
		}
		return preferred.len() ? preferred.append( fallback, true ) : fallback;
	}

	private array function preferModelMappedLinks( required array links, required array preferredUnits ) {
		var preferredIds = {};
		for ( var unit in arguments.preferredUnits ) {
			if ( isStruct( unit ) && !isCoverageFallbackUnit( unit ) ) {
				var unitId = trim( toString( unit.id ?: unit.itemId ?: "" ) );
				if ( len( unitId ) ) preferredIds[ unitId ] = true;
			}
		}
		if ( !preferredIds.count() ) return arguments.links;
		var preferred = [];
		var other = [];
		for ( var link in arguments.links ) {
			if ( !isStruct( link ) ) continue;
			if ( preferredIds.keyExists( trim( toString( link.targetUnitId ?: "" ) ) ) ) preferred.append( link );
			else other.append( link );
		}
		return preferred.len() ? preferred.append( other, true ) : other;
	}

	private boolean function isCoverageFallbackUnit( required struct unit ) {
		if ( lCase( trim( arguments.unit.provenanceClass ?: "" ) ) == "deterministically-derived" ) return true;
		return findNoCase( "coverage-", trim( toString( arguments.unit.id ?: "" ) ) ) == 1;
	}

	/**
	 * Seam/coupling evidence for the whole-repository architecture call.
	 * Widened beyond datasource/include coupling to the groups that actually
	 * justify an explicit-seam packaging call — outbound integration, session
	 * and auth gates, shared application state — which the role was previously
	 * asked to find while being denied the evidence for it.
	 *
	 * Returns a bare aggregated array rather than raw records: this is the one
	 * unsharded call, and hundreds of per-hit records would either exhaust the
	 * character budget before later keys are reached or stringify past
	 * boundedValue()'s depth-2 limit.
	 */
	private array function architectureSignals( required any signals ) {
		return aggregateSignals(
			arguments.signals,
			[ "datasource-table-coupling", "include-call-coupling", "outbound-integration", "security-session", "application-lifecycle-state" ],
			20,
			3
		);
	}

	/**
	 * Collapses per-hit signal records into one record per signalId:
	 * {signalId, group, meaning, count, files}. Bounded by construction (there
	 * are only ~17 distinct signalIds), and immune to the "first N records"
	 * monoculture a naive cap would produce on a signal list sorted
	 * alphabetically by signalId.
	 */
	private array function aggregateSignals( required any signals, required array allowedGroups, numeric maxGroups = 20, numeric maxFiles = 3 ) {
		var source = isStruct( arguments.signals ) && isArray( arguments.signals.signals ?: "" )
			? arguments.signals.signals
			: ( isArray( arguments.signals ) ? arguments.signals : [] );
		var buckets = {};
		var order = [];
		for ( var signal in source ) {
			if ( !isStruct( signal ) ) continue;
			var group = lCase( trim( signal.group ?: "" ) );
			if ( arguments.allowedGroups.len() && !arguments.allowedGroups.contains( group ) ) continue;
			var signalId = trim( signal.signalId ?: "" );
			if ( !len( signalId ) ) continue;
			if ( !buckets.keyExists( signalId ) ) {
				buckets[ signalId ] = { signalId: signalId, group: signal.group ?: "", meaning: signal.meaning ?: "", count: 0, files: [] };
				order.append( signalId );
			}
			buckets[ signalId ].count = buckets[ signalId ].count + 1;
			var refs = signal.evidenceRefs ?: [];
			var ref = isArray( refs ) && refs.len() && isStruct( refs[ 1 ] ) ? refs[ 1 ] : {};
			var filePath = trim( toString( ref.filePath ?: "" ) );
			if ( len( filePath ) && buckets[ signalId ].files.len() < arguments.maxFiles ) {
				var label = filePath & ":" & val( ref.startLine ?: 0 );
				if ( !buckets[ signalId ].files.contains( label ) ) buckets[ signalId ].files.append( label );
			}
		}
		var output = order.map( ( item ) => buckets[ item ] );
		output.sort( ( a, b ) => a.count != b.count ? b.count - a.count : compareNoCase( a.signalId, b.signalId ) );
		return output.len() > arguments.maxGroups ? output.slice( 1, arguments.maxGroups ) : output;
	}

	private array function compactRecords( required array records, required array fields, numeric limit = 200 ) {
		var output = [];
		for ( var record in arguments.records ) {
			if ( !isStruct( record ) ) continue;
			var compact = {};
			for ( var field in arguments.fields ) if ( record.keyExists( field ) ) compact[ field ] = record[ field ];
			if ( compact.count() ) output.append( compact );
			if ( output.len() >= arguments.limit ) break;
		}
		return output;
	}

	private struct function databaseSignals( required any signals ) {
		var source = isStruct( arguments.signals ) && isArray( arguments.signals.signals ?: "" )
			? arguments.signals.signals
			: ( isArray( arguments.signals ) ? arguments.signals : [] );
		var selected = [];
		for ( var signal in source ) {
			if ( !isStruct( signal ) ) continue;
			if ( [ "datasource-table-coupling", "application-lifecycle-state" ].contains( lCase( trim( signal.group ?: "" ) ) ) ) selected.append( signal );
		}
		return { signals: selected };
	}

	/**
	 * Keep database prompts focused on observed schema objects. Dropping raw
	 * inventory/source excerpts reduces output truncation on dense MySQL packs.
	 */
	private struct function compactDatabaseEvidence( required struct evidence ) {
		var schema = isStruct( arguments.evidence.schemaEvidence ?: "" ) ? arguments.evidence.schemaEvidence : {};
		var tables = [];
		for ( var table in ( isArray( schema.tables ?: "" ) ? schema.tables : ( isArray( schema.objects ?: "" ) ? schema.objects : [] ) ) ) {
			if ( !isStruct( table ) ) continue;
			var name = trim( toString( table.name ?: table.objectRef ?: "" ) );
			if ( !len( name ) ) continue;
			var columns = isArray( table.columns ?: "" ) ? table.columns : [];
			var columnNames = [];
			for ( var column in columns ) {
				var columnName = isStruct( column ) ? trim( toString( column.name ?: "" ) ) : trim( toString( column ) );
				if ( len( columnName ) ) columnNames.append( columnName );
				if ( columnNames.len() >= 12 ) break;
			}
			tables.append( {
				name: name,
				columnCount: columns.len() ? columns.len() : val( table.columnCount ?: 0 ),
				columns: columnNames
			} );
			if ( tables.len() >= 32 ) break;
		}
		return {
			schemaEvidence: {
				coverage: schema.coverage ?: "",
				sourceKind: schema.sourceKind ?: "",
				vendor: schema.vendor ?: ( isStruct( schema.database ?: "" ) ? ( schema.database.vendor ?: "" ) : "" ),
				tableCount: tables.len() ? tables.len() : val( schema.tableCount ?: 0 ),
				unresolvedCount: val( schema.unresolvedCount ?: 0 ),
				tables: tables
			},
			signals: arguments.evidence.signals ?: [],
			coverage: arguments.evidence.coverage ?: {}
		};
	}

	private any function boundedValue( required any value, numeric depth = 0, numeric characterLimit = 12000 ) {
		if ( arguments.depth > 2 ) return left( toString( arguments.value ), 1200 );
		if ( isArray( arguments.value ) ) {
			var output = [];
			for ( var item in arguments.value ) {
				output.append( boundedValue( item, arguments.depth + 1, arguments.characterLimit ) );
				if ( len( jsonSerialize( output ) ) >= arguments.characterLimit || output.len() >= 120 ) break;
			}
			return output;
		}
		if ( isStruct( arguments.value ) ) {
			var outputStruct = {};
			for ( var key in arguments.value.keyArray().sort( "textnocase" ) ) {
				outputStruct[ key ] = boundedValue( arguments.value[ key ], arguments.depth + 1, arguments.characterLimit );
				if ( len( jsonSerialize( outputStruct ) ) >= arguments.characterLimit ) break;
			}
			return outputStruct;
		}
		return left( toString( arguments.value ), 4000 );
	}
}
