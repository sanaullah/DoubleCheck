/**
 * Infers the effective AI provider name and local/remote classification from
 * a configured provider string and base URL. Mirrors the equivalent bootstrap
 * logic in app/config/Coldbox.bx (which runs before WireBox is available and
 * is left untouched) so profile-sourced provider info is classified the same
 * way as the env-derived fallback settings.
 */
@singleton
class {
	variables.localProviders = [ "ollama", "docker", "lmstudio", "llamacpp" ];

	string function resolveProvider( required string configuredProvider, required string baseURL ) {
		var configured = lCase( trim( arguments.configuredProvider ) );
		var endpoint = trim( arguments.baseURL );
		var knownOpenRouterEndpoint = reFindNoCase( "^https?://(?:www[.])?openrouter[.]ai(?:/|$)", endpoint ) > 0;
		var knownOpenAIEndpoint = reFindNoCase( "^https?://api[.]openai[.]com(?:/|$)", endpoint ) > 0;
		if ( !len( configured ) ) {
			return knownOpenRouterEndpoint
				? "openrouter"
				: ( knownOpenAIEndpoint || !len( endpoint ) ? "openai" : "openai-compatible" );
		}
		if ( configured == "openai-compatible" && knownOpenRouterEndpoint ) return "openrouter";
		if ( configured == "openai-compatible" && knownOpenAIEndpoint ) return "openai";
		return configured;
	}

	boolean function isLocal( required string provider, required string baseURL ) {
		return variables.localProviders.contains( lCase( trim( arguments.provider ) ) ) ||
			reFindNoCase( "localhost|127[.]0[.]0[.]1", arguments.baseURL ) > 0;
	}
}
