/**
 * Classifies whether a configured AI provider/base URL is local. Mirrors the
 * equivalent bootstrap logic in app/config/Coldbox.bx (which runs before
 * WireBox is available and is left untouched) so profile-sourced provider
 * info is classified the same way as the env-derived fallback settings.
 */
@singleton
class {
	variables.localProviders = [ "ollama", "docker", "lmstudio", "llamacpp" ];

	boolean function isLocal( required string provider, required string baseURL ) {
		return variables.localProviders.contains( lCase( trim( arguments.provider ) ) ) ||
			reFindNoCase( "localhost|127[.]0[.]0[.]1", arguments.baseURL ) > 0;
	}
}
