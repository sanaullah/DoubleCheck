/**
 * Redacts common credential shapes before repository evidence leaves the
 * trusted application boundary.
 */

@singleton
class {

	string function redactText( required string text ) {
		var normalized = replace(
			arguments.text,
			char( 13 ),
			"",
			"all"
		);
		return redactLines(
			listToArray(
				normalized,
				char( 10 ),
				true,
				true
			)
		).lines.toList( char( 10 ) );
	}

	/**
	 * Walk structs/arrays and redact string leaves only. Prefer this over
	 * redactText(jsonSerialize(...)) — line redaction on pretty JSON destroys
	 * object shape when keys/values mention password, token, secret, etc.
	 */
	any function redactStructured( required any value ) {
		if ( isStruct( arguments.value ) ) {
			var out = {};
			for ( var key in arguments.value ) {
				out[ key ] = redactStructured( arguments.value[ key ] );
			}
			return out;
		}
		if ( isArray( arguments.value ) ) {
			var items = [];
			for ( var item in arguments.value ) {
				items.append( redactStructured( item ) );
			}
			return items;
		}
		if ( isSimpleValue( arguments.value ) && isStringish( arguments.value ) ) {
			return redactText( toString( arguments.value ) );
		}
		return arguments.value;
	}

	private boolean function isStringish( required any value ) {
		return !isNumeric( arguments.value ) && !isBoolean( arguments.value ) && !isDate( arguments.value );
	}

	string function redactLine( required string line ) {
		if (
			reFindNoCase(
								"(api[_-]?key|password|passwd|secret|token|authorization|client[_-]?secret|private[_-]?key)\s*[:=]",
								arguments.line
							) ||
							reFindNoCase( "\bAKIA[0-9A-Z]{16}\b", arguments.line ) ||
						reFindNoCase( "\bgh[pousr]_[A-Za-z0-9]{20,}\b", arguments.line ) ||
					reFindNoCase( "\bsk-[A-Za-z0-9_-]{16,}\b", arguments.line ) ||
				reFindNoCase( "-----BEGIN [A-Z ]*PRIVATE KEY-----", arguments.line )
		) {
			return "[REDACTED SENSITIVE CONTENT]";
		}
		return arguments.line;
	}

	struct function redactLines( required array lines ) {
		var result = [];
		var redactionCount = 0;
		var insidePrivateKey = false;
		for ( var line in arguments.lines ) {
			if ( reFindNoCase( "-----BEGIN [A-Z ]*PRIVATE KEY-----", line ) ) {
				insidePrivateKey = true;
			}
			if ( insidePrivateKey ) {
				result.append( "[REDACTED SENSITIVE CONTENT]" );
				redactionCount++;
				if ( reFindNoCase( "-----END [A-Z ]*PRIVATE KEY-----", line ) ) {
					insidePrivateKey = false;
				}
				continue;
			}
			var redacted = redactLine( line );
			if ( redacted != line ) {
				redactionCount++;
			}
			result.append( redacted );
		}
		return {
			lines         : result,
			redactionCount: redactionCount
		};
	}
}