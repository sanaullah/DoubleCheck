/**
 * Ensures SQLite is present and schema is ready before the app serves traffic.
 * Creates the DB file/folder and tables only when missing; otherwise applies
 * lightweight column upgrades.
 */

@singleton
class {
	property name="datasource" inject="coldbox:setting:datasource";

	property name="log" inject="logbox:logger:{this}";

	/**
	 * Public status for diagnostics / setup messaging.
	 */
	struct function getDatabaseStatus() {
		var dbPath = resolveDbPath();
		return {
			dbPath     : dbPath,
			dbExists   : fileExists( dbPath ),
			schemaReady: hasCoreSchema()
		};
	}

	void function ensureSchema() {
		var dbPath = resolveDbPath();
		ensureDatabaseFile( dbPath );

		queryExecute(
			"PRAGMA foreign_keys = ON",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"PRAGMA journal_mode = WAL",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"PRAGMA busy_timeout = 5000",
			{},
			{ datasource: datasource }
		);

		if ( hasCoreSchema() ) {
			log.info( "DoubleCheck database schema present — checking upgrades" );
			ensurePendingUpgrades();
			log.info( "DoubleCheck SQLite schema is ready" );
			return;
		}

		log.info( "DoubleCheck database schema missing — creating tables" );
		createCoreSchema();
		ensurePendingUpgrades();
		log.info( "DoubleCheck SQLite schema is ready" );
	}

	private string function resolveDbPath() {
		var configured = getSystemSetting( "DOUBLECHECK_DB_PATH", "./.db/doublecheck.db" );
		try {
			return createObject( "java", "java.io.File" ).init( configured ).getCanonicalPath();
		} catch (any e) {
			return configured;
		}
	}

	private void function ensureDatabaseFile( required string dbPath ) {
		var dbDirectory = getDirectoryFromPath( arguments.dbPath );
		if ( !directoryExists( dbDirectory ) ) {
			directoryCreate(
				dbDirectory,
				true,
				true
			);
			log.info( "Created database directory: #dbDirectory#" );
		}
		if ( !fileExists( arguments.dbPath ) ) {
			fileWrite( arguments.dbPath, "" );
			log.info( "Created database file: #arguments.dbPath#" );
		}
	}

	/**
	 * Core tables that must exist for the app to run.
	 */
	private boolean function hasCoreSchema() {
		try {
			var tables = queryExecute(
				"
					SELECT name
					FROM sqlite_master
					WHERE type = 'table'
					  AND name IN ( 'review_runs', 'review_events', 'review_findings' )
				",
				{},
				{ datasource: datasource }
			);
			return tables.recordCount >= 3;
		} catch (any e) {
			return false;
		}
	}

	private void function createCoreSchema() {
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_runs (
					id TEXT PRIMARY KEY,
					project_path TEXT NOT NULL,
					mode TEXT NOT NULL,
					run_kind TEXT NOT NULL DEFAULT 'review',
					input_json TEXT NOT NULL DEFAULT '{}',
					base_revision TEXT,
					head_revision TEXT,
					status TEXT NOT NULL,
					progress INTEGER NOT NULL DEFAULT 0,
					current_phase TEXT NOT NULL DEFAULT '',
					message TEXT NOT NULL DEFAULT '',
					created_at TEXT NOT NULL,
					started_at TEXT,
					completed_at TEXT,
					cancel_requested_at TEXT,
					lease_expires_at TEXT,
					attempt_count INTEGER NOT NULL DEFAULT 0,
					error_reference TEXT,
					policy_json TEXT NOT NULL DEFAULT '{}',
					budgets_json TEXT NOT NULL DEFAULT '{}',
					tenant_id TEXT NOT NULL DEFAULT 'default',
					project_id TEXT NOT NULL DEFAULT 'default',
					worker_id TEXT NOT NULL DEFAULT '',
					lease_token TEXT NOT NULL DEFAULT '',
					updated_at TEXT NOT NULL
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_events (
					sequence INTEGER PRIMARY KEY AUTOINCREMENT,
					run_id TEXT NOT NULL,
					event_type TEXT NOT NULL,
					payload TEXT NOT NULL,
					created_at TEXT NOT NULL,
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_artifacts (
					id INTEGER PRIMARY KEY AUTOINCREMENT,
					run_id TEXT NOT NULL,
					file_path TEXT NOT NULL,
					language TEXT NOT NULL,
					content_hash TEXT NOT NULL,
					size_bytes INTEGER NOT NULL,
					line_count INTEGER NOT NULL,
					created_at TEXT NOT NULL,
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE,
					UNIQUE ( run_id, file_path )
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_findings (
					id TEXT PRIMARY KEY,
					run_id TEXT NOT NULL,
					fingerprint TEXT NOT NULL,
					category TEXT NOT NULL,
					rule_id TEXT NOT NULL,
					severity TEXT NOT NULL,
					confidence REAL NOT NULL,
					title TEXT NOT NULL,
					message TEXT NOT NULL,
					file_path TEXT NOT NULL,
					start_line INTEGER NOT NULL,
					end_line INTEGER NOT NULL,
					evidence TEXT NOT NULL,
					suggestion TEXT NOT NULL,
					source TEXT NOT NULL,
					solution_json TEXT,
					created_at TEXT NOT NULL,
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE,
					UNIQUE ( run_id, fingerprint )
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_summaries (
					run_id TEXT PRIMARY KEY,
					summary TEXT NOT NULL,
					languages TEXT NOT NULL,
					files_scanned INTEGER NOT NULL,
					bytes_scanned INTEGER NOT NULL,
					findings_count INTEGER NOT NULL,
					ai_enabled INTEGER NOT NULL,
					ai_files_reviewed INTEGER NOT NULL DEFAULT 0,
					ai_characters_sent INTEGER NOT NULL DEFAULT 0,
					review_scope TEXT NOT NULL DEFAULT '',
					repository_revision TEXT NOT NULL DEFAULT '',
					base_revision TEXT NOT NULL DEFAULT '',
					head_revision TEXT NOT NULL DEFAULT '',
					discovery_truncated INTEGER NOT NULL DEFAULT 0,
					skipped_json TEXT NOT NULL DEFAULT '{}',
					created_at TEXT NOT NULL,
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS finding_reviews (
					tenant_id TEXT NOT NULL,
					project_id TEXT NOT NULL,
					project_path TEXT NOT NULL,
					fingerprint TEXT NOT NULL,
					review_state TEXT NOT NULL DEFAULT 'new',
					note TEXT NOT NULL DEFAULT '',
					version INTEGER NOT NULL DEFAULT 0,
					updated_by TEXT NOT NULL DEFAULT '',
					updated_at TEXT NOT NULL,
					PRIMARY KEY ( tenant_id, project_id, project_path, fingerprint )
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS finding_review_events (
					id INTEGER PRIMARY KEY AUTOINCREMENT,
					tenant_id TEXT NOT NULL,
					project_id TEXT NOT NULL,
					project_path TEXT NOT NULL,
					fingerprint TEXT NOT NULL,
					run_id TEXT NOT NULL DEFAULT '',
					previous_state TEXT NOT NULL DEFAULT '',
					review_state TEXT NOT NULL,
					note TEXT NOT NULL DEFAULT '',
					version INTEGER NOT NULL,
					changed_by TEXT NOT NULL DEFAULT '',
					created_at TEXT NOT NULL
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS analysis_artifact_cache (
					content_hash TEXT NOT NULL,
					parser_version TEXT NOT NULL,
					language TEXT NOT NULL,
					symbols TEXT NOT NULL,
					dependencies TEXT NOT NULL,
					created_at TEXT NOT NULL,
					PRIMARY KEY ( content_hash, parser_version )
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_symbols (
					id TEXT NOT NULL,
					run_id TEXT NOT NULL,
					file_path TEXT NOT NULL,
					content_hash TEXT NOT NULL,
					parser_version TEXT NOT NULL,
					kind TEXT NOT NULL,
					name TEXT NOT NULL,
					line INTEGER NOT NULL,
					evidence TEXT NOT NULL,
					PRIMARY KEY ( run_id, id ),
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_dependencies (
					id TEXT NOT NULL,
					run_id TEXT NOT NULL,
					source_file TEXT NOT NULL,
					content_hash TEXT NOT NULL,
					parser_version TEXT NOT NULL,
					kind TEXT NOT NULL,
					target TEXT NOT NULL,
					target_file TEXT NOT NULL DEFAULT '',
					line INTEGER NOT NULL,
					evidence TEXT NOT NULL,
					PRIMARY KEY ( run_id, id ),
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_graph_summaries (
					run_id TEXT PRIMARY KEY,
					parser_version TEXT NOT NULL,
					files_analyzed INTEGER NOT NULL,
					parser_executions INTEGER NOT NULL,
					cache_hits INTEGER NOT NULL,
					symbol_count INTEGER NOT NULL,
					dependency_count INTEGER NOT NULL,
					impact_count INTEGER NOT NULL DEFAULT 0,
					baseline_run_id TEXT NOT NULL DEFAULT '',
					created_at TEXT NOT NULL,
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_impacts (
					id TEXT NOT NULL,
					run_id TEXT NOT NULL,
					changed_file TEXT NOT NULL,
					changed_symbol TEXT NOT NULL,
					impacted_file TEXT NOT NULL,
					reason TEXT NOT NULL,
					depth INTEGER NOT NULL,
					via_file TEXT NOT NULL DEFAULT '',
					PRIMARY KEY ( run_id, id ),
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_architecture_models (
					run_id TEXT PRIMARY KEY,
					model_version TEXT NOT NULL,
					repository_revision TEXT NOT NULL DEFAULT '',
					fingerprint TEXT NOT NULL,
					model_json TEXT NOT NULL,
					cache_key TEXT NOT NULL DEFAULT '',
					reused INTEGER NOT NULL DEFAULT 0,
					baseline_fingerprint TEXT NOT NULL DEFAULT '',
					diff_json TEXT NOT NULL DEFAULT '{}',
					created_at TEXT NOT NULL,
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_plans (
					run_id TEXT PRIMARY KEY,
					plan_version TEXT NOT NULL,
					model_fingerprint TEXT NOT NULL,
					policy_fingerprint TEXT NOT NULL DEFAULT '',
					budget_fingerprint TEXT NOT NULL DEFAULT '',
					fingerprint TEXT NOT NULL,
					task_count INTEGER NOT NULL,
					plan_json TEXT NOT NULL,
					created_at TEXT NOT NULL,
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS architecture_model_cache (
					cache_key TEXT PRIMARY KEY,
					project_path TEXT NOT NULL,
					repository_revision TEXT NOT NULL,
					model_version TEXT NOT NULL,
					input_fingerprint TEXT NOT NULL,
					model_json TEXT NOT NULL,
					created_at TEXT NOT NULL
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_specialist_results (
					run_id TEXT NOT NULL,
					task_id TEXT NOT NULL,
					role TEXT NOT NULL,
					result_version TEXT NOT NULL,
					status TEXT NOT NULL,
					summary TEXT NOT NULL DEFAULT '',
					finding_refs_json TEXT NOT NULL DEFAULT '[]',
					provenance_json TEXT NOT NULL DEFAULT '{}',
					error TEXT NOT NULL DEFAULT '',
					duration_ms INTEGER NOT NULL DEFAULT 0,
					created_at TEXT NOT NULL,
					PRIMARY KEY ( run_id, task_id ),
					FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TABLE IF NOT EXISTS review_tool_audits (
					run_id TEXT NOT NULL,
					task_id TEXT NOT NULL,
					sequence INTEGER NOT NULL,
					tool_name TEXT NOT NULL,
					input_fingerprint TEXT NOT NULL,
					status TEXT NOT NULL,
					output_characters INTEGER NOT NULL DEFAULT 0,
					duration_ms INTEGER NOT NULL DEFAULT 0,
					created_at TEXT NOT NULL,
					PRIMARY KEY ( run_id, task_id, sequence ),
					FOREIGN KEY ( run_id, task_id )
						REFERENCES review_specialist_results( run_id, task_id )
						ON DELETE CASCADE
				)
			",
			{},
			{ datasource: datasource }
		);
	}

	private void function ensurePendingUpgrades() {
		ensureColumn(
			"review_runs",
			"lease_expires_at",
			"TEXT"
		);
		ensureColumn(
			"review_runs",
			"base_revision",
			"TEXT"
		);
		ensureColumn(
			"review_runs",
			"head_revision",
			"TEXT"
		);
		ensureColumn(
			"review_runs",
			"attempt_count",
			"INTEGER NOT NULL DEFAULT 0"
		);
		ensureColumn(
			"review_runs",
			"error_reference",
			"TEXT"
		);
		ensureColumn(
			"review_runs",
			"policy_json",
			"TEXT NOT NULL DEFAULT '{}'"
		);
		ensureColumn(
			"review_runs",
			"budgets_json",
			"TEXT NOT NULL DEFAULT '{}'"
		);
		ensureColumn(
			"review_runs",
			"source_run_id",
			"TEXT"
		);
		ensureModernizationSchema();
		ensureColumn(
			"review_summaries",
			"ai_files_reviewed",
			"INTEGER NOT NULL DEFAULT 0"
		);
		ensureColumn(
			"review_summaries",
			"ai_characters_sent",
			"INTEGER NOT NULL DEFAULT 0"
		);
		ensureColumn(
			"review_summaries",
			"review_scope",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_summaries",
			"repository_revision",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_summaries",
			"base_revision",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_summaries",
			"head_revision",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_summaries",
			"discovery_truncated",
			"INTEGER NOT NULL DEFAULT 0"
		);
		ensureColumn(
			"review_summaries",
			"skipped_json",
			"TEXT NOT NULL DEFAULT '{}'"
		);
		ensureColumn(
			"review_dependencies",
			"target_file",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_graph_summaries",
			"impact_count",
			"INTEGER NOT NULL DEFAULT 0"
		);
		ensureColumn(
			"review_graph_summaries",
			"baseline_run_id",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_architecture_models",
			"cache_key",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_architecture_models",
			"reused",
			"INTEGER NOT NULL DEFAULT 0"
		);
		ensureColumn(
			"review_architecture_models",
			"baseline_fingerprint",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_architecture_models",
			"diff_json",
			"TEXT NOT NULL DEFAULT '{}'"
		);
		ensureColumn(
			"review_plans",
			"policy_fingerprint",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_plans",
			"budget_fingerprint",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_findings",
			"solution_json",
			"TEXT"
		);
		ensureLocalSupportSchema();
		ensureAiSettingsSchema();
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_events_run_sequence ON review_events ( run_id, sequence )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_runs_created_at ON review_runs ( created_at DESC )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_runs_source ON review_runs ( tenant_id, source_run_id )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_artifacts_run ON review_artifacts ( run_id, file_path )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_findings_run_severity ON review_findings ( run_id, severity )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_finding_reviews_project_state ON finding_reviews ( tenant_id, project_id, project_path, review_state )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_finding_review_events_identity ON finding_review_events ( tenant_id, project_id, project_path, fingerprint, version )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_symbols_run_file ON review_symbols ( run_id, file_path, line )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_dependencies_run_source ON review_dependencies ( run_id, source_file, line )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_dependencies_run_target ON review_dependencies ( run_id, target_file, source_file )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_impacts_run_changed ON review_impacts ( run_id, changed_file, depth )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_review_architecture_revision ON review_architecture_models ( repository_revision, model_version )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_architecture_cache_revision ON architecture_model_cache ( project_path, repository_revision, model_version )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"CREATE INDEX IF NOT EXISTS idx_specialist_results_run_status ON review_specialist_results ( run_id, status )",
			{},
			{ datasource: datasource }
		);
		queryExecute(
			"
				CREATE TRIGGER IF NOT EXISTS trg_review_runs_contract_immutable
				BEFORE UPDATE OF policy_json, budgets_json, run_kind, input_json ON review_runs
				BEGIN
					SELECT RAISE(
						ABORT,
						'review run contract is immutable'
					);
				END
			",
			{},
			{ datasource: datasource }
		);
	}

	private void function ensureModernizationSchema() {
		ensureColumn( "review_runs", "run_kind", "TEXT NOT NULL DEFAULT 'review'" );
		ensureColumn( "review_runs", "input_json", "TEXT NOT NULL DEFAULT '{}'" );
		var statements = [
			"CREATE TABLE IF NOT EXISTS modernization_schema_packs ( run_id TEXT PRIMARY KEY, source_kind TEXT NOT NULL, format TEXT NOT NULL, relative_path TEXT NOT NULL DEFAULT '', content_hash TEXT NOT NULL DEFAULT '', pack_version TEXT NOT NULL DEFAULT '', metadata_json TEXT NOT NULL DEFAULT '{}', sanitized_json TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL, FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE )",
			"CREATE TABLE IF NOT EXISTS modernization_checkpoints ( run_id TEXT NOT NULL, stage TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'pending', progress INTEGER NOT NULL DEFAULT 0, payload_json TEXT NOT NULL DEFAULT '{}', updated_at TEXT NOT NULL, PRIMARY KEY ( run_id, stage ), FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE )",
			"CREATE TABLE IF NOT EXISTS modernization_plans ( run_id TEXT PRIMARY KEY, plan_version TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'generated', fingerprint TEXT NOT NULL DEFAULT '', plan_json TEXT NOT NULL, validation_json TEXT NOT NULL DEFAULT '{}', coverage_json TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL, updated_at TEXT NOT NULL, FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE )",
			"CREATE TABLE IF NOT EXISTS modernization_decisions ( run_id TEXT NOT NULL, item_type TEXT NOT NULL, item_id TEXT NOT NULL, decision TEXT NOT NULL, note TEXT NOT NULL DEFAULT '', item_fingerprint TEXT NOT NULL DEFAULT '', decided_by TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL, updated_at TEXT NOT NULL, PRIMARY KEY ( run_id, item_type, item_id ), FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE )",
			"CREATE TABLE IF NOT EXISTS modernization_decision_events ( id INTEGER PRIMARY KEY AUTOINCREMENT, run_id TEXT NOT NULL, item_type TEXT NOT NULL, item_id TEXT NOT NULL, action TEXT NOT NULL, decision_json TEXT NOT NULL DEFAULT '{}', actor TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL, FOREIGN KEY ( run_id ) REFERENCES review_runs( id ) ON DELETE CASCADE )",
			"CREATE INDEX IF NOT EXISTS idx_review_runs_kind_history ON review_runs ( run_kind, created_at DESC )",
			"CREATE INDEX IF NOT EXISTS idx_modernization_checkpoints_run ON modernization_checkpoints ( run_id, updated_at )",
			"CREATE INDEX IF NOT EXISTS idx_modernization_decisions_lookup ON modernization_decisions ( run_id, item_type, updated_at )",
			"CREATE INDEX IF NOT EXISTS idx_modernization_decision_events_lookup ON modernization_decision_events ( run_id, item_type, item_id, id )"
		];
		for ( var statement in statements ) {
			queryExecute( statement, {}, { datasource: datasource } );
		}
		queryExecute( "DROP TRIGGER IF EXISTS trg_review_runs_contract_immutable", {}, { datasource: datasource } );
		queryExecute(
			"
				CREATE TRIGGER IF NOT EXISTS trg_review_runs_contract_immutable
				BEFORE UPDATE OF policy_json, budgets_json, run_kind, input_json ON review_runs
				BEGIN
					SELECT RAISE( ABORT, 'review run contract is immutable' );
				END
			",
			{},
			{ datasource: datasource }
		);
	}

	private void function ensureAiSettingsSchema() {
		var statements = [
			"CREATE TABLE IF NOT EXISTS ai_provider_profiles ( id TEXT PRIMARY KEY, tenant_id TEXT NOT NULL DEFAULT 'default', name TEXT NOT NULL, provider TEXT NOT NULL, base_url TEXT NOT NULL, api_key TEXT NOT NULL DEFAULT '', model TEXT NOT NULL, timeout_seconds INTEGER NOT NULL DEFAULT 120, context_window INTEGER NOT NULL DEFAULT 8192, input_usd_per_million REAL NOT NULL DEFAULT 0, output_usd_per_million REAL NOT NULL DEFAULT 0, is_active INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL, updated_at TEXT NOT NULL )",
			"CREATE INDEX IF NOT EXISTS idx_ai_provider_profiles_active ON ai_provider_profiles ( tenant_id, is_active )",
			"CREATE TABLE IF NOT EXISTS app_settings ( tenant_id TEXT NOT NULL DEFAULT 'default', setting_key TEXT NOT NULL, setting_value TEXT NOT NULL, updated_at TEXT NOT NULL, PRIMARY KEY ( tenant_id, setting_key ) )"
		];
		for ( var statement in statements ) {
			queryExecute( statement, {}, { datasource: datasource } );
		}
	}

	private void function ensureLocalSupportSchema() {
		// Lightweight helpers used by the local app (not multi-tenant SaaS).
		var statements = [
			"CREATE TABLE IF NOT EXISTS review_workers ( id TEXT PRIMARY KEY, status TEXT NOT NULL, capabilities_json TEXT NOT NULL DEFAULT '{}', last_seen_at TEXT NOT NULL, lease_expires_at TEXT NOT NULL, started_at TEXT NOT NULL )",
			"CREATE TABLE IF NOT EXISTS evaluation_gate_runs ( id TEXT PRIMARY KEY, corpus_version TEXT NOT NULL, language TEXT NOT NULL, capability_tier TEXT NOT NULL, passed INTEGER NOT NULL, metrics_json TEXT NOT NULL, failures_json TEXT NOT NULL, created_at TEXT NOT NULL )",
			"CREATE TABLE IF NOT EXISTS language_capabilities ( language TEXT PRIMARY KEY, capability_tier TEXT NOT NULL, corpus_version TEXT NOT NULL, gate_run_id TEXT NOT NULL, promoted_at TEXT NOT NULL, FOREIGN KEY ( gate_run_id ) REFERENCES evaluation_gate_runs( id ) )",
			"CREATE INDEX IF NOT EXISTS idx_runs_tenant_project_created ON review_runs ( tenant_id, project_id, created_at DESC )",
			"CREATE INDEX IF NOT EXISTS idx_runs_queue_lease ON review_runs ( status, lease_expires_at, created_at )"
		];
		ensureColumn(
			"review_runs",
			"tenant_id",
			"TEXT NOT NULL DEFAULT 'default'"
		);
		ensureColumn(
			"review_runs",
			"project_id",
			"TEXT NOT NULL DEFAULT 'default'"
		);
		ensureColumn(
			"review_runs",
			"worker_id",
			"TEXT NOT NULL DEFAULT ''"
		);
		ensureColumn(
			"review_runs",
			"lease_token",
			"TEXT NOT NULL DEFAULT ''"
		);
		for ( var statement in statements ) {
			queryExecute(
				statement,
				{},
				{ datasource: datasource }
			);
		}
	}

	private void function ensureColumn(
		required string tableName,
		required string columnName,
		required string definition
	) {
		var columns = queryExecute(
			"PRAGMA table_info( #arguments.tableName# )",
			{},
			{ datasource: datasource }
		);
		for ( var row = 1; row <= columns.recordCount; row++ ) {
			if ( lCase( columns.name[ row ] ) == lCase( arguments.columnName ) ) {
				return;
			}
		}
		queryExecute(
			"ALTER TABLE #arguments.tableName# ADD COLUMN #arguments.columnName# #arguments.definition#",
			{},
			{ datasource: datasource }
		);
	}
}
