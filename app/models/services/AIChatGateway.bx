/**
 * Thin wrapper around BoxLang aiChat() with provider enablement checks.
 *
 * @see SpecialistAgentGateway
 * @see AIReviewService
 */

@singleton
class {
	property name="baseURL" inject="coldbox:setting:aiBaseURL";

	boolean function isEnabled( required string provider, required string apiKey ) {
		var configuredBaseURL = "";
		if ( structKeyExists( variables, "baseURL" ) && !isNull( variables.baseURL ) ) configuredBaseURL = toString( variables.baseURL );
		return len( trim( arguments.apiKey ) ) || [ "ollama", "docker", "lmstudio", "llamacpp" ].contains( lCase( arguments.provider ) ) || reFindNoCase( "localhost|127\.0\.0\.1", configuredBaseURL ) > 0;
	}

	any function chat( required any prompt, required struct params, required struct options ) {
		return aiChat(
			arguments.prompt,
			arguments.params,
			arguments.options
		);
	}
}
