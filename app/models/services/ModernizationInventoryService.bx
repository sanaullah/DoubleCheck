	}

	private boolean function isLikelyJavaScriptConstruction( required string target, required string sourcePath, string sourceLine = "" ) {
		var extension = lCase( listLast( arguments.sourcePath, "." ) );
		if ( extension != "cfm" ) return false;
		var normalizedTarget = lCase( trim( arguments.target ) );
