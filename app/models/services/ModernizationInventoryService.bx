		var parameterMismatch = unparameterized || ( find( "?", arguments.line ) > 0 && !hasBinding );
			var dynamicIdentifier = ( reFindNoCase( "(from|join|into|update|delete)[ ]+", arguments.line ) > 0 ) && find( char( 35 ), arguments.line ) > 0;
