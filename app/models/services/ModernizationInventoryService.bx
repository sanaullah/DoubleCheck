	private boolean function isApplicationRoute( required string value ) {
		var route = trim( arguments.value );
		if ( !len( route ) || left( route, 1 ) == char( 35 ) || left( route, 1 ) == "?" ) return false;
		if ( reFindNoCase( "^(?:https?:|mailto:|javascript:|data:|tel:)", route ) ) return false;
		var withoutQuery = listFirst( route, char( 63 ) & char( 35 ) );
		var extension = find( ".", listLast( withoutQuery, "/" ) ) ? lCase( listLast( withoutQuery, "." ) ) : "";
		if ( len( extension ) && !listFindNoCase( "cfm,cfc,cfml,bx,bxm,html,htm", extension ) ) return false;
		return left( route, 1 ) == "/" || find( "/", route ) || listFindNoCase( "cfm,cfc,cfml,bx,bxm,html,htm", extension );
	}

	private struct function stripCfmlComments( required string line, required boolean open ) {
		var value = arguments.line;
		var inside = arguments.open;
		var guard = 0;
		while ( guard++ < 20 ) {
			if ( inside ) {
				var closeAt = find( "--->", value );
				if ( !closeAt ) return { text: "", open: true };
				value = closeAt + 4 <= len( value )
					? mid( value, closeAt + 4, len( value ) - closeAt - 3 )
					: "";
				inside = false;
			}
			var openAt = find( "<!---", value );
			if ( !openAt ) break;
			var closeAt = find( "--->", value, openAt + 5 );
			if ( !closeAt ) {
				value = openAt > 1 ? left( value, openAt - 1 ) : "";
				inside = true;
				break;
			}
			value = ( openAt > 1 ? left( value, openAt - 1 ) : "" )
				& ( closeAt + 4 <= len( value ) ? mid( value, closeAt + 4, len( value ) - closeAt - 3 ) : "" );
		}
		return { text: value, open: inside };
	}

	private struct function sqlReferences( required string line ) {
		var tables = [];
		var columns = [];
		var tableMatch = variables.javaPatternMatcher( "(?:from|join|into|update|delete\\s+from)\\s+([A-Za-z_][A-Za-z0-9_.$-]*)", arguments.line );
		while ( tableMatch.find() ) tables.append( tableMatch.group( 1 ) );
		var columnMatch = variables.javaPatternMatcher( "\\b([A-Za-z_][A-Za-z0-9_.$-]*)\\s*(?:=|>|<|in\\s*\\(|like\\s)", arguments.line );
		while ( columnMatch.find() ) columns.append( columnMatch.group( 1 ) );
		var sqlKeyword = reFindNoCase( "(select|insert|update|delete)", arguments.line ) > 0;
		var hasInterpolation = find( char( 35 ), arguments.line ) > 0 || find( "&", arguments.line ) > 0 || find( "+", arguments.line ) > 0 || findNoCase( "stringFormat", arguments.line ) > 0;
		var unparameterized = sqlKeyword && hasInterpolation;
