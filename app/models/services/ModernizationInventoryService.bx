	private struct function buildResolutionIndex( required array files ) {
		var index = { byPath: {}, byBasename: {}, byStem: {}, paths: [] };
		for ( var file in arguments.files ) {
			if ( !isStruct( file ) ) continue;
			var path = normalizePath( file.filePath ?: file.path ?: "" );
			var extension = lCase( listLast( path, "." ) );
			if ( !len( path ) || !listFindNoCase( "cfc,cfm,cfml", extension ) ) continue;
			if ( !index.paths.contains( path ) ) index.paths.append( path );
			addResolutionCandidate( index.byPath, lCase( path ), path );
			var basename = listLast( path, "/" );
			addResolutionCandidate( index.byBasename, lCase( basename ), path );
			var stem = reReplaceNoCase( basename, "\.(?:cfc|cfm|cfml)$", "", "one" );
			addResolutionCandidate( index.byStem, lCase( stem ), path );
		}
		return index;
	}

	private void function addResolutionCandidate( required struct bucket, required string key, required string path ) {
		if ( !len( trim( arguments.key ) ) ) return;
		if ( !arguments.bucket.keyExists( arguments.key ) ) arguments.bucket[ arguments.key ] = [];
		if ( !arguments.bucket[ arguments.key ].contains( arguments.path ) ) arguments.bucket[ arguments.key ].append( arguments.path );
	}

	private struct function resolveTarget( required string target, required struct index, string resolutionHint = "" ) {
		var raw = trim( arguments.target );
		if ( !len( raw ) ) return {};
		var normalized = normalizePath( raw );
		var candidate = uniqueResolutionCandidate( arguments.index.byPath[ lCase( normalized ) ] ?: [] );
		if ( len( candidate ) ) return { targetFile: candidate, resolution: len( trim( arguments.resolutionHint ) ) ? arguments.resolutionHint : "path" };

		var basename = listLast( normalized, "/" );
		candidate = uniqueResolutionCandidate( arguments.index.byBasename[ lCase( basename ) ] ?: [] );
		if ( len( candidate ) ) return { targetFile: candidate, resolution: len( trim( arguments.resolutionHint ) ) ? arguments.resolutionHint : "basename" };

		var stem = reReplaceNoCase( basename, "\.(?:cfc|cfm|cfml)$", "", "one" );
		if ( !find( "/", normalized ) && !find( ".", stem ) ) {
			candidate = uniqueResolutionCandidate( arguments.index.byStem[ lCase( stem ) ] ?: [] );
			if ( len( candidate ) ) return { targetFile: candidate, resolution: len( trim( arguments.resolutionHint ) ) ? arguments.resolutionHint : "stem" };
		}

		var dottedTarget = reReplaceNoCase( normalized, "\.(?:cfc|cfm|cfml)$", "", "one" );
		dottedTarget = replace( dottedTarget, ".", "/", "all" );
		var dottedCandidates = [];
		for ( var path in arguments.index.paths ) {
			var pathWithoutExtension = reReplaceNoCase( path, "\.(?:cfc|cfm|cfml)$", "", "one" );
			if ( pathSuffixMatches( dottedTarget, pathWithoutExtension ) ) dottedCandidates.append( path );
		}
		candidate = uniqueResolutionCandidate( dottedCandidates );
		if ( len( candidate ) ) return { targetFile: candidate, resolution: len( trim( arguments.resolutionHint ) ) ? arguments.resolutionHint : "dotted-path" };
		return {};
	}

	private string function uniqueResolutionCandidate( required array candidates ) {
		var distinct = {};
		for ( var candidate in arguments.candidates ) {
			var path = trim( toString( candidate ) );
			if ( len( path ) ) distinct[ lCase( path ) ] = path;
		}
		return distinct.count() == 1 ? distinct[ distinct.keyArray()[ 1 ] ] : "";
	}

	private boolean function pathSuffixMatches( required string target, required string candidate ) {
		var targetParts = listToArray( reReplace( lCase( replace( arguments.target, "\", "/", "all" ) ), "^/+|/+$", "", "all" ), "/" );
		var candidateParts = listToArray( reReplace( lCase( replace( arguments.candidate, "\", "/", "all" ) ), "^/+|/+$", "", "all" ), "/" );
		if ( !targetParts.len() || !candidateParts.len() || candidateParts.len() > targetParts.len() ) return false;
		var offset = targetParts.len() - candidateParts.len();
		for ( var index = 1; index <= candidateParts.len(); index++ ) if ( targetParts[ offset + index ] != candidateParts[ index ] ) return false;
		return true;
	}

	private boolean function isBuiltinConstruction( required string target ) {
		var value = lCase( trim( arguments.target ) );
		return listFindNoCase( "array,struct,query,string,numeric,boolean,date,list,object,function,output,option,storedproc,http,extends,implements", value ) > 0
