	}

	private boolean function shouldKeepNewConstruction( required string target, required string sourcePath, required struct index, required struct resolution ) {
		if ( len( trim( arguments.resolution.targetFile ?: "" ) ) ) return true;
		var value = trim( arguments.target );
		if ( find( ".", value ) || arguments.index.byStem.keyExists( lCase( value ) ) ) return true;
		var extension = lCase( listLast( arguments.sourcePath, "." ) );
		return listFindNoCase( "cfc,cfml", extension ) > 0;
	}

	private struct function unresolvedEvidence( required string kind, required string path, required numeric lineNumber, required string line ) {
		return { id: stableItemId( "unresolved", "#arguments.kind#:#arguments.path#:#arguments.lineNumber#" ), kind: arguments.kind, filePath: arguments.path, startLine: arguments.lineNumber, endLine: arguments.lineNumber, extractionMethod: "regex-conservative-v1", evidence: left( trim( arguments.line ), 240 ) };
	}

	private struct function routeFromLine(required string path, required numeric lineNumber, required string line, required struct file) {
		var routeKind = "";
		var attribute = "";
		var method = "GET";
		if ( reFindNoCase( "<cflocation\b", arguments.line ) ) {
			routeKind = "redirect";
			attribute = "url";
		} else if ( reFindNoCase( "<(?:cf)?form\b", arguments.line ) ) {
			routeKind = "form-action";
			attribute = "action";
			var methodMatch = variables.javaPatternMatcher( "(?i)\bmethod\s*=\s*[\""']([A-Za-z]+)", arguments.line );
			method = methodMatch.find() ? uCase( methodMatch.group( 1 ) ) : "GET";
		} else if ( reFindNoCase( "<a\b", arguments.line ) ) {
			routeKind = "anchor";
			attribute = "href";
		} else if ( reFindNoCase( "\blocation[.]href\s*=", arguments.line ) ) {
			routeKind = "client-redirect";
			var locationMatch = variables.javaPatternMatcher( "(?i)\blocation[.]href\s*=\s*[\""']([^\""']+)", arguments.line );
			if ( locationMatch.find() ) {
				var locationPath = trim( locationMatch.group( 1 ) );
				if ( isApplicationRoute( locationPath ) ) return routeEvidenceItem( arguments.path, arguments.lineNumber, arguments.line, arguments.file, locationPath, method, routeKind );
			}
			return javacast( "null", "" );
		} else {
			return javacast( "null", "" );
		}
		var matcher = variables.javaPatternMatcher( "(?i)\b#attribute#\s*=\s*[\""']([^\""']+)", arguments.line );
		if ( matcher.find() ) {
			var routePath = trim( matcher.group( 1 ) );
			if ( isApplicationRoute( routePath ) ) return routeEvidenceItem( arguments.path, arguments.lineNumber, arguments.line, arguments.file, routePath, method, routeKind );
		}
		return javacast( "null", "" );
	}

	private struct function remoteRouteFromLine(required string path, required numeric lineNumber, required string line, required struct file) {
		if ( !reFindNoCase( "\bremote\b.*\bfunction\b|<cffunction\b.*\baccess\s*=\s*[\""']remote", arguments.line ) ) return javacast( "null", "" );
		var expression = findNoCase( "<cffunction", arguments.line )
			? "(?i)\bname\s*=\s*[\""']([A-Za-z_][A-Za-z0-9_]*)"
			: "(?i)\bfunction\s+([A-Za-z_][A-Za-z0-9_]*)";
		var matcher = variables.javaPatternMatcher( expression, arguments.line );
		if ( !matcher.find() ) return { id: stableItemId( "route", "#arguments.path#:#arguments.lineNumber#:remote" ), legacyPath: "", method: "UNKNOWN", routeKind: "remote-cfc-method", filePath: arguments.path, startLine: arguments.lineNumber, endLine: arguments.lineNumber, extractionMethod: "remote-cfc-regex-v1", evidenceRefs: [ evidence( arguments.path, arguments.lineNumber, arguments.line, arguments.file ) ], unresolved: true };
		var name = matcher.group( 1 );
		return { id: stableItemId( "route", "#arguments.path#:#arguments.lineNumber#:remote:#name#" ), legacyPath: "remote:#name#", method: "UNKNOWN", routeKind: "remote-cfc-method", filePath: arguments.path, startLine: arguments.lineNumber, endLine: arguments.lineNumber, extractionMethod: "remote-cfc-regex-v1", evidenceRefs: [ evidence( arguments.path, arguments.lineNumber, arguments.line, arguments.file ) ], unresolved: false };
	}

	private struct function routeEvidenceItem(
