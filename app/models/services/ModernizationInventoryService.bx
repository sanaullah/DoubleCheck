/**
 * Conservative CFML inventory used only by Modernize. This is a line-oriented
 * extractor, not a full CFML AST; every record carries the source range and
 * extraction method so the proposal layer can show its evidence honestly.
 */
@singleton
class {
	property name="identityService" inject="ModernizationIdentityService";
	property name="maxDeepFiles" inject="coldbox:setting:modernizeInventoryMaxDeepFiles";
	variables.version       = "cfml-inventory-conservative-v5";
	variables.patternCache  = {};

	struct function build( required any scan ) {
		var files = isStruct( arguments.scan ) ? ( arguments.scan.files ?: [] ) : arguments.scan;
		var inventoryFiles = [];
		var units = [];
		var dependencies = [];
		var routeEvidence = [];
		var unresolved = [];
		var cfmlFileCount = 0;
		var deepFileCount = 0;
		var shallowFileCount = 0;
		var totalBytes = 0;
		var resolutionIndex = buildResolutionIndex( files );
		var configuredDeepLimit = isStruct( arguments.scan ) && isNumeric( arguments.scan.maxDeepFiles ?: "" )
			? val( arguments.scan.maxDeepFiles )
			: val( variables.maxDeepFiles ?: 300 );
		var deepLimit = max( 1, configuredDeepLimit );
		var deepPaths = selectDeepPaths( files, deepLimit );
		for ( var file in files ) {
			if ( !isStruct( file ) ) continue;
			var path = normalizePath( file.filePath ?: file.path ?: "" );
			var extension = lCase( listLast( path, "." ) );
			var isCfml = ( file.language ?: "" ) == "ColdFusion" || listFindNoCase( "cfm,cfc", extension );
			if ( !isCfml ) continue;
			cfmlFileCount++;
			var isDeep = deepPaths.keyExists( lCase( path ) );
			var content = structKeyExists( file, "content" ) ? toString( file.content ) : "";
			var lineCount = val( file.lineCount ?: 0 );
			if ( lineCount <= 0 ) {
				lineCount = structKeyExists( file, "lines" ) && isArray( file.lines )
					? max( 1, file.lines.len() )
					: max( 1, listToArray( normalizeText( content ), char( 10 ), true, true ).len() );
			}
			totalBytes += val( file.sizeBytes ?: len( content ) );
			inventoryFiles.append(
				{
					filePath    : path,
					language    : "CFML",
					contentHash : file.contentHash ?: lCase( hash( content, "SHA-256" ) ),
					sizeBytes   : val( file.sizeBytes ?: len( content ) ),
					lineCount   : lineCount,
					extractionMethod: isDeep ? "regex-conservative-v1" : "source-metadata-v1",
					detailCoverage: isDeep ? "deep" : "structural"
				}
			);
			var unitKind = classifyUnit( path );
			if ( extension == "cfm" || unitKind == "custom-tag" ) {
				units.append( makeUnit( unitKind == "custom-tag" ? "custom-tag" : "page", path, listFirst( listLast( path, "/" ), "." ), 1, lineCount, isDeep ? "regex-conservative-v1" : "source-metadata-v1", file, [], isDeep ) );
			}
			if ( unitKind == "application" ) {
				units.append( makeUnit( "application", path, "Application.cfc", 1, lineCount, isDeep ? "regex-conservative-v1" : "source-metadata-v1", file, [], isDeep ) );
			} else if ( extension == "cfc" ) {
				// Keep component files visible even when their methods use syntax the
				// conservative extractor cannot parse. Method units are added below.
				units.append( makeUnit( "component", path, listFirst( listLast( path, "/" ), "." ), 1, lineCount, isDeep ? "regex-conservative-v1" : "source-metadata-v1", file, [], isDeep ) );
			}
			if ( !isDeep ) {
				shallowFileCount++;
				continue;
			}
			deepFileCount++;
			var lines = structKeyExists( file, "lines" ) && isArray( file.lines ) ? file.lines : listToArray( normalizeText( content ), char( 10 ), true, true );
			if ( !lines.len() ) lines = [ "" ];
			if ( extension == "cfc" ) {
				var declaration = extractComponentDeclaration( lines );
				var declarationEvidence = evidence( path, declaration.declarationLine, lines[ declaration.declarationLine ] ?: "", file );
				if ( len( declaration.extends ) ) {
					dependencies.append( dependency( "extends", declaration.extends, declarationEvidence, resolveTarget( declaration.extends, resolutionIndex ) ) );
				}
				if ( len( declaration.implements ) ) {
					for ( var contract in listToArray( declaration.implements, "," ) ) {
						var contractTarget = trim( contract );
						dependencies.append( dependency( "implements", contractTarget, declarationEvidence, resolveTarget( contractTarget, resolutionIndex ) ) );
					}
				}
			}
			var functionsFound = extractFunctions( path, lines, file );
			if ( unitKind == "application" ) {
				for ( var fn in functionsFound.units ) {
					if ( isLifecycleFunction( fn.symbolName ) ) fn.unitType = "lifecycle-hook";
				}
			}
			for ( var fn in functionsFound.units ) units.append( fn );
			for ( var unresolvedItem in functionsFound.unresolved ) unresolved.append( unresolvedItem );

			var cfmlCommentOpen = false;
			for ( var lineNumber = 1; lineNumber <= lines.len(); lineNumber++ ) {
				var sourceLine = toString( lines[ lineNumber ] );
				var commentSafe = stripCfmlComments( sourceLine, cfmlCommentOpen );
				cfmlCommentOpen = commentSafe.open;
				sourceLine = commentSafe.text;
				var trimmed = trim( sourceLine );
				if ( !len( trimmed ) ) continue;
				var lineEvidence = evidence( path, lineNumber, sourceLine, file );
				var remoteRoute = remoteRouteFromLine( path, lineNumber, sourceLine, file );
				if ( !isNull( remoteRoute ?: javacast( "null", "" ) ) ) routeEvidence.append( remoteRoute );
				var includeMatch = variables.javaPatternMatcher( "(?:<cfinclude\\s+template\\s*=\\s*|\\binclude\\s+)[^A-Za-z0-9_./-]*([A-Za-z0-9_./-]+)", sourceLine );
				if ( includeMatch.find() ) {
					var includeTarget = includeMatch.group( 1 );
					var includeResolution = resolveTarget( includeTarget, resolutionIndex );
					if ( isStruct( includeResolution ) ) includeResolution.resolution = includeResolution.resolution ?: "include";
					dependencies.append( dependency( "include", includeTarget, lineEvidence, includeResolution ) );
					if ( find( char( 35 ), includeTarget ) ) unresolved.append( unresolvedEvidence( "dynamic-include", path, lineNumber, sourceLine ) );
				} else if ( reFindNoCase( "<cfinclude\\b|\\binclude\\s+", sourceLine ) ) {
					unresolved.append( unresolvedEvidence( "dynamic-include", path, lineNumber, sourceLine ) );
				}
				var constructText = sourceLine;
				if ( reFindNoCase( "<(?:cfobject|cfinvoke)\\b", sourceLine ) ) constructText = joinTagLines( lines, lineNumber ).text;
				var createObjectMatch = variables.javaPatternMatcher( "\\bcreateObject\\s*\\(\\s*[""']component[""']\\s*,\\s*[""']([^""']+)[""']", constructText );
				while ( createObjectMatch.find() ) {
					var createTarget = createObjectMatch.group( 1 );
					if ( hasInterpolatedConstructionTarget( createTarget ) ) {
						unresolved.append( unresolvedEvidence( "dynamic-component", path, lineNumber, sourceLine ) );
					} else {
						dependencies.append( dependency( "component-construction", createTarget, lineEvidence, resolveTarget( createTarget, resolutionIndex ) ) );
					}
				}
				var tagConstructMatch = variables.javaPatternMatcher( "<(?:cfobject|cfinvoke)\\b[^>]*\\bcomponent\\s*=\\s*[""']([^""']+)[""']", constructText );
				while ( tagConstructMatch.find() ) {
					var tagTarget = tagConstructMatch.group( 1 );
					if ( hasInterpolatedConstructionTarget( tagTarget ) ) {
						unresolved.append( unresolvedEvidence( "dynamic-component", path, lineNumber, sourceLine ) );
					} else {
						dependencies.append( dependency( "component-construction", tagTarget, lineEvidence, resolveTarget( tagTarget, resolutionIndex ) ) );
					}
				}
				var dynamicLiteralMatch = variables.javaPatternMatcher( "\\b(?:createObject|cfinvoke)\\b[^\\r\\n]*[&+]\\s*[""']([A-Za-z_][A-Za-z0-9_./-]*)[""']", constructText );
				while ( dynamicLiteralMatch.find() ) {
					var literalTarget = dynamicLiteralMatch.group( 1 );
					var literalResolution = resolveTarget( literalTarget, resolutionIndex, "dynamic-literal" );
					if ( len( literalResolution.targetFile ?: "" ) ) dependencies.append( dependency( "component-construction", literalTarget, lineEvidence, literalResolution ) );
				}
				var newMatch = variables.javaPatternMatcher( "(?i)new[ ]+([A-Za-z_][A-Za-z0-9_./-]*)", sourceLine );
				while ( newMatch.find() ) {
					var newTarget = newMatch.group( 1 );
					if ( isBuiltinConstruction( newTarget ) || isLikelyJavaScriptConstruction( newTarget, path, sourceLine ) ) continue;
					var newResolution = resolveTarget( newTarget, resolutionIndex );
					if ( shouldKeepNewConstruction( newTarget, path, resolutionIndex, newResolution ) ) dependencies.append( dependency( "component-construction", newTarget, lineEvidence, newResolution ) );
				}
				if ( ( reFindNoCase( "createObject|cfinvoke", sourceLine ) && reFindNoCase( "(arguments|variables|url|form)[.]", sourceLine ) ) || ( findNoCase( "<cfinvoke", sourceLine ) && find( char( 35 ), sourceLine ) ) ) {
					unresolved.append( unresolvedEvidence( "dynamic-component", path, lineNumber, sourceLine ) );
				}
				if ( reFindNoCase( "(?:<cfhttp\b|\bhttpRequest\b|\bhttpClient\b|\bnew\s+Http\s*\(|\bfetch\s*\()", sourceLine ) ) dependencies.append( dependency( "http", "outbound", lineEvidence ) );
				if ( reFindNoCase( "(?:<cfschedule\b|\bscheduler(?:New|Start|Stop)?\b|\bonSchedule\b|\bschedule\s*\()", sourceLine ) ) dependencies.append( dependency( "schedule", "scheduled-work", lineEvidence ) );
				if ( reFindNoCase( "(cf_file|fileRead|fileWrite|fileCopy|fileMove|directoryList|directoryCreate|fileUpload|cffile)", sourceLine ) ) dependencies.append( dependency( "filesystem", "filesystem", lineEvidence ) );
				if ( ( findNoCase( "createobject", sourceLine ) && findNoCase( "java", sourceLine ) ) || findNoCase( "new java.", sourceLine ) ) dependencies.append( dependency( "java", "java-interop", lineEvidence ) );
				if ( reFindNoCase( "(datasource|this[.]datasource)[ ]*=", sourceLine ) ) dependencies.append( dependency( "datasource", extractQuotedOrValue( sourceLine, "datasource" ), lineEvidence ) );
				if ( reFindNoCase( "(queryExecute|executeQuery|cfquery|queryNew|cfstoredproc)", sourceLine ) ) {
					dependencies.append( dependency( "query", "sql", lineEvidence ) );
					if ( reFindNoCase( "(cf_sql_[A-Za-z0-9_]+|cfsqltype|sqltype)", sourceLine ) ) dependencies.append( dependency( "sql-type-hint", "sql-type-hint", lineEvidence ) );
					if ( reFindNoCase( "cfstoredproc|CALL[ ]+[A-Za-z_]", sourceLine ) ) dependencies.append( dependency( "sql-proc-call", "stored-procedure", lineEvidence ) );
					var sqlInfo = sqlReferences( sourceLine );
					for ( var tableRef in sqlInfo.tables ) dependencies.append( dependency( "table-query", tableRef, lineEvidence ) );
					for ( var columnRef in sqlInfo.columns ) dependencies.append( dependency( "column-query", columnRef, lineEvidence ) );
					if ( sqlInfo.unparameterized ) unresolved.append( unresolvedEvidence( "unparameterized-sql", path, lineNumber, sourceLine ) );
					if ( sqlInfo.parameterMismatch ) dependencies.append( dependency( "sql-parameter-mismatch", "parameter-binding", lineEvidence ) );
					if ( sqlInfo.dynamicIdentifier ) unresolved.append( unresolvedEvidence( "dynamic-sql", path, lineNumber, sourceLine ) );
				}
				for ( var scope in [ "session", "application", "client" ] ) {
					if ( reFindNoCase( "#scope#[ ]*[.]", sourceLine ) ) dependencies.append( dependency( "scope.#scope#", scope, lineEvidence ) );
				}
				if ( reFindNoCase( "session[.](user|isLoggedIn|authenticated)|isLoggedIn|loginRequired|authenticate|authorize", sourceLine ) ) dependencies.append( dependency( "security-session-gate", "session-gate", lineEvidence ) );
				if ( findNoCase( "evaluate", sourceLine ) ) unresolved.append( unresolvedEvidence( "dynamic-evaluate", path, lineNumber, sourceLine ) );
				var route = routeFromLine( path, lineNumber, sourceLine, file );
				if ( !isNull( route ?: javacast( "null", "" ) ) ) {
					routeEvidence.append( route );
					if ( route.unresolved ?: false ) unresolved.append( unresolvedEvidence( "dynamic-route", path, lineNumber, sourceLine ) );
				}
			}
		}
		var dependencyOccurrences = dependencies.len();
		dependencies = compactDependencies( dependencies );
		units.sort( ( a, b ) => compareNoCase( a.filePath & ":" & a.startLine & ":" & a.symbolName, b.filePath & ":" & b.startLine & ":" & b.symbolName ) );
		dependencies.sort( ( a, b ) => compareNoCase( a.filePath & ":" & a.startLine & ":" & a.kind & ":" & a.target, b.filePath & ":" & b.startLine & ":" & b.kind & ":" & b.target ) );
		unresolved.sort( ( a, b ) => compareNoCase( a.filePath & ":" & a.startLine & ":" & a.kind, b.filePath & ":" & b.startLine & ":" & b.kind ) );
		var noScope = cfmlFileCount == 0;
		return {
			version       : variables.version,
			files         : inventoryFiles,
			units         : units,
			dependencies  : dependencies,
			routeEvidence : routeEvidence,
			unresolved    : unresolved,
			noModernizationScope: noScope,
			type          : noScope ? "NoModernizationScope" : "ModernizationInventory",
			status        : noScope ? "NoModernizationScope" : "ready",
			summary       : {
				cfmlFiles: cfmlFileCount,
				deepFiles: deepFileCount,
				shallowFiles: shallowFileCount,
				structureComplete: true,
				detailCoverage: shallowFileCount > 0 ? "bounded" : "complete",
				unitCount: units.len(),
				dependencyCount: dependencies.len(),
				dependencyOccurrences: dependencyOccurrences,
				dependencyGroupsCollapsed: max( 0, dependencyOccurrences - dependencies.len() ),
				unresolvedCount: unresolved.len(),
				totalBytes: totalBytes
			},
			coverage      : isStruct( arguments.scan ) ? ( arguments.scan.scope ?: "full" ) : "full",
			fingerprint   : lCase( hash( variables.version & "|" & jsonSerialize( { files: inventoryFiles, units: units, dependencies: dependencies, unresolved: unresolved } ), "SHA-256" ) )
		};
	}

	struct function inventory( required any scan ) returntype="struct" { return build( arguments.scan ); }
	struct function analyze( required any scan ) returntype="struct" { return build( arguments.scan ); }

	private struct function extractFunctions( required string path, required array lines, required struct file ) {
		var result = { units: [], unresolved: [] };
		var safeLines = commentSafeLines( arguments.lines );
		for ( var lineNumber = 1; lineNumber <= safeLines.len(); lineNumber++ ) {
			var sourceLine = toString( safeLines[ lineNumber ] );
				// <cffunction> attributes commonly wrap across lines; only the
				// closing tag needs the joined text, so a plain sourceLine match
				// still short-circuits the common single-line case.
				var tagSearchText = reFindNoCase( "<cffunction\b", sourceLine ) ? joinTagLines( safeLines, lineNumber ).text : sourceLine;
				var tagMatch = variables.javaPatternMatcher( "<cffunction\\s+[^>]*\\bname\\s*=[^A-Za-z0-9_]*([A-Za-z_][A-Za-z0-9_.-]*)[^>]*>", tagSearchText );
			if ( tagMatch.find() ) {
				var endLine = findClosingTag( safeLines, lineNumber, "</cffunction>" );
				var tagUnit = makeUnit( "function", arguments.path, tagMatch.group( 1 ), lineNumber, endLine, "tag-regex-v1", arguments.file, [ "signature", "access", "return" ] );
				tagUnit.parameters = extractTagArguments( safeLines, lineNumber, endLine );
				var tagParameterNames = tagUnit.parameters.map( ( item ) => item.name ).toList( ", " );
				tagUnit.signature = tagMatch.group( 1 ) & "(" & tagParameterNames & ")";
				result.units.append( tagUnit );
				continue;
			}
				var fnMatch = variables.javaPatternMatcher( "(?:(?:public|private|protected|remote|static|final)\\s+)*(?:[A-Za-z_][A-Za-z0-9_.$]*\\s+)?function\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)", sourceLine );
			if ( fnMatch.find() ) {
				var fnName = fnMatch.group( 1 );
				var endLine = findFunctionEnd( safeLines, lineNumber );
				var unit = makeUnit( "function", arguments.path, fnName, lineNumber, endLine, "script-regex-v1", arguments.file, [ "signature", "access", "return" ] );
				unit.signature = "#fnName#(#trim( fnMatch.group( 2 ) )#)";
				unit.parameters = parseParameters( fnMatch.group( 2 ) );
				result.units.append( unit );
			}
		}
		return result;
	}

	private array function commentSafeLines( required array lines ) {
		var output = [];
		var cfmlCommentOpen = false;
		for ( var line in arguments.lines ) {
			var safe = stripCfmlComments( toString( line ), cfmlCommentOpen );
			cfmlCommentOpen = safe.open;
			output.append( safe.text );
		}
		return output;
	}

	private array function parseParameters( required string parameterText ) {
		var output = [];
		for ( var rawParameter in listToArray( arguments.parameterText, ",", true, true ) ) {
			var value = trim( rawParameter );
			if ( !len( value ) ) continue;
			var parameterMatch = variables.javaPatternMatcher( "(?i)^(?:(required|optional)\\s+)?(?:(string|numeric|boolean|struct|array|query|any|date|component|[A-Za-z_][A-Za-z0-9_.]*)\\s+)?([A-Za-z_][A-Za-z0-9_]*)", value );
			if ( parameterMatch.find() ) {
				output.append( { name: parameterMatch.group( 3 ), type: parameterMatch.group( 2 ) ?: "any", required: lCase( parameterMatch.group( 1 ) ?: "optional" ) == "required" } );
			} else {
				output.append( { name: left( value, 120 ), type: "unknown", required: false, unresolved: true } );
			}
		}
		return output;
	}

	private array function extractTagArguments( required array lines, required numeric startLine, required numeric endLine ) {
		var output = [];
		for ( var lineNumber = arguments.startLine; lineNumber <= arguments.endLine && lineNumber <= arguments.lines.len(); lineNumber++ ) {
				var argumentMatch = variables.javaPatternMatcher( "(?i)<cfargument\\s+[^>]*\\bname\\s*=[^A-Za-z0-9_]*([A-Za-z_][A-Za-z0-9_.-]*)[^>]*>", toString( arguments.lines[ lineNumber ] ) );
			if ( argumentMatch.find() ) {
				var line = toString( arguments.lines[ lineNumber ] );
					var typeMatch = variables.javaPatternMatcher( "(?i)\\btype\\s*=[^A-Za-z]*([A-Za-z][A-Za-z0-9_-]*)", line );
					var requiredMatch = variables.javaPatternMatcher( "(?i)\\brequired\\s*=[^A-Za-z0-9]*(true|false|yes|no|1|0)", line );
				output.append( { name: argumentMatch.group( 1 ), type: typeMatch.find() ? typeMatch.group( 1 ) : "any", required: requiredMatch.find() && [ "true", "yes", "1" ].contains( lCase( requiredMatch.group( 1 ) ) ) } );
			}
		}
		return output;
	}

	private struct function makeUnit(
		required string kind,
		required string path,
		required string name,
		required numeric startLine,
		required numeric endLine,
		required string method,
		required struct file,
		array evidenceKinds = [],
		boolean inspectSource = true
	) {
		var signature = arguments.name;
		var id = stableItemId( "legacy-unit", "#arguments.path#:#arguments.startLine#:#arguments.name#:#arguments.kind#" );
		var unitLines = arguments.inspectSource
			? ( structKeyExists( arguments.file, "lines" ) && isArray( arguments.file.lines ) ? arguments.file.lines : listToArray( normalizeText( arguments.file.content ?: "" ), char( 10 ), true, true ) )
			: [];
		var unitLine = ( unitLines.len() && arguments.startLine <= unitLines.len() ) ? unitLines[ arguments.startLine ] : "";
		var access = "";
		var accessMatch = variables.javaPatternMatcher( "(?i)^\\s*(public|private|protected|remote)\\b", unitLine );
		if ( accessMatch.find() ) access = lCase( accessMatch.group( 1 ) );
		var returnType = "";
		// Keep the return-type capture conservative and quote-agnostic.  The
		// previous character-class expression was parsed as a malformed numeric
		// pattern by BoxLang's regex bridge on some runtimes.
		var returnMatch = variables.javaPatternMatcher( "(?i)returntype[[:space:]]*=[[:space:]]*[^A-Za-z0-9]*([A-Za-z0-9_.-]+)", unitLine );
		if ( returnMatch.find() ) returnType = returnMatch.group( 1 );
		return {
			id: id,
			filePath: arguments.path,
			layer: arguments.kind == "application" ? "application" : ( arguments.kind == "page" ? "page" : ( arguments.kind == "custom-tag" ? "custom-tag" : "component" ) ),
			unitType: arguments.kind,
			symbolName: arguments.name,
			signature: signature,
			startLine: arguments.startLine,
			endLine: max( arguments.startLine, arguments.endLine ),
			access: access,
			returnType: returnType,
			evidenceRefs: [ { filePath: arguments.path, startLine: arguments.startLine, endLine: max( arguments.startLine, arguments.endLine ), extractionMethod: arguments.method, contentHash: arguments.file.contentHash ?: "" } ],
			signalIds: [],
			touchedTables: [],
			touchedColumns: [],
			extractionMethod: arguments.method
		};
	}

	private struct function evidence(required string path, required numeric lineNumber, required string line, required struct file) {
		return { filePath: arguments.path, startLine: arguments.lineNumber, endLine: arguments.lineNumber, extractionMethod: "regex-conservative-v1", contentHash: arguments.file.contentHash ?: lCase( hash( arguments.line, "SHA-256" ) ), snippet: left( trim( arguments.line ), 240 ) };
	}

	private struct function dependency( required string kind, required string target, required struct evidence, struct resolution = {} ) {
		var record = { id: stableItemId( "dependency", "#arguments.kind#:#arguments.evidence.filePath#:#arguments.evidence.startLine#:#arguments.target#" ), kind: arguments.kind, target: arguments.target, filePath: arguments.evidence.filePath, startLine: arguments.evidence.startLine, endLine: arguments.evidence.endLine, evidenceRefs: [ arguments.evidence ] };
		if ( isStruct( arguments.resolution ) && len( trim( arguments.resolution.targetFile ?: "" ) ) ) {
			record.targetFile = arguments.resolution.targetFile;
			record.resolution = arguments.resolution.resolution ?: "path";
		}
		return record;
	}

	/**
	 * Select a deterministic evidence-rich subset for expensive line analysis.
	 * Every CFML file still receives a structural inventory record and base unit.
	 */
	private struct function selectDeepPaths( required array files, required numeric limit ) {
		var candidates = [];
		for ( var file in arguments.files ) {
			if ( !isStruct( file ) ) continue;
			var path = normalizePath( file.filePath ?: file.path ?: "" );
			var extension = lCase( listLast( path, "." ) );
			if ( !len( path ) || !( ( file.language ?: "" ) == "ColdFusion" || listFindNoCase( "cfm,cfc", extension ) ) ) continue;
			var lowerPath = lCase( path );
			var score = extension == "cfc" ? 100 : 10;
			if ( reFindNoCase( "(^|/)application[.]cfc$", lowerPath ) ) score = 140;
			else if ( reFindNoCase( "(^|/)(config|routes?|router|bootstrap|security|auth)(/|[.])", lowerPath ) ) score = max( score, 120 );
			else if ( reFindNoCase( "(^|/)(index|default|home)[.]cfm$", lowerPath ) ) score = max( score, 80 );
			candidates.append( { path: path, key: lowerPath, domain: inventoryDomain( lowerPath ), score: score } );
		}
		candidates.sort( ( a, b ) => a.score == b.score ? compareNoCase( a.path, b.path ) : ( a.score > b.score ? -1 : 1 ) );
		var selected = {};
		var selectedCount = 0;
		// Components and framework/application seams establish the dependency spine.
		for ( var candidate in candidates ) {
			if ( selectedCount >= arguments.limit ) break;
			if ( candidate.score < 100 ) continue;
			selected[ candidate.key ] = true;
			selectedCount++;
		}
		// Preserve at least one detailed page per top-level application domain.
		var representedDomains = {};
		for ( var candidate in candidates ) {
			if ( selectedCount >= arguments.limit ) break;
			if ( selected.keyExists( candidate.key ) || representedDomains.keyExists( candidate.domain ) ) continue;
			selected[ candidate.key ] = true;
			representedDomains[ candidate.domain ] = true;
			selectedCount++;
		}
		for ( var candidate in candidates ) {
			if ( selectedCount >= arguments.limit ) break;
			if ( selected.keyExists( candidate.key ) ) continue;
			selected[ candidate.key ] = true;
			selectedCount++;
		}
		return selected;
	}

	/** Collapse repeated line-level dependencies into evidence-rich file groups. */
	private array function compactDependencies( required array dependencies ) {
		var grouped = {};
		for ( var item in arguments.dependencies ) {
			var key = lCase( trim( item.kind ?: "" ) & "|" & normalizePath( item.filePath ?: "" ) & "|" & trim( item.target ?: "" ) & "|" & normalizePath( item.targetFile ?: "" ) );
			if ( !grouped.keyExists( key ) ) {
				var first = duplicate( item );
				first.occurrenceCount = 1;
				first.evidenceRefs = isArray( first.evidenceRefs ?: "" ) ? first.evidenceRefs : [];
				first.id = stableItemId( "dependency", key );
				grouped[ key ] = first;
				continue;
			}
			grouped[ key ].occurrenceCount++;
			for ( var ref in item.evidenceRefs ?: [] ) {
				if ( grouped[ key ].evidenceRefs.len() >= 6 ) break;
				var refKey = "#ref.filePath ?: ''#:#ref.startLine ?: 0#:#ref.endLine ?: 0#";
				if ( !grouped[ key ].evidenceRefs.some( ( existing ) => "#existing.filePath ?: ''#:#existing.startLine ?: 0#:#existing.endLine ?: 0#" == refKey ) ) grouped[ key ].evidenceRefs.append( ref );
			}
		}
		var output = grouped.valueArray();
		output.sort( ( a, b ) => compareNoCase( a.filePath & ":" & a.kind & ":" & a.target, b.filePath & ":" & b.kind & ":" & b.target ) );
		return output;
	}

	private string function inventoryDomain( required string path ) {
		var parts = listToArray( reReplace( arguments.path, "^/+|/+$", "", "all" ), "/" );
		if ( !parts.len() ) return "root";
		return parts.len() >= 2 ? parts[ 1 ] & "/" & parts[ 2 ] : parts[ 1 ];
