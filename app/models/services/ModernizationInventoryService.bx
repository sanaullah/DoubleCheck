	private string function extractQuotedOrValue(required string line, required string name) {
		var marker = lCase( trim( arguments.name ) ) & "=";
		var position = findNoCase( marker, arguments.line );
		if ( !position ) return "";
		var value = trim( mid( arguments.line, position + len( marker ), len( arguments.line ) ) );
		if ( len( value ) >= 2 && ( ( left( value, 1 ) == char( 34 ) && right( value, 1 ) == char( 34 ) ) || ( left( value, 1 ) == char( 39 ) && right( value, 1 ) == char( 39 ) ) ) ) value = mid( value, 2, len( value ) - 2 );
		return left( value, 160 );
