	private struct function extractComponentDeclaration( required array lines ) {
		var safeLines = commentSafeLines( arguments.lines );
		for ( var lineNumber = 1; lineNumber <= safeLines.len(); lineNumber++ ) {
			var sourceLine = toString( safeLines[ lineNumber ] );
			var isTag = reFindNoCase( "<cfcomponent\b", sourceLine ) > 0;
