	private numeric function findFunctionEnd(required array lines, required numeric startLine) {
		var depth = 0;
		for ( var i = arguments.startLine; i <= arguments.lines.len(); i++ ) {
			var line = arguments.lines[ i ];
			depth += len( reMatchNoCase( "\\b(function|if|for|while|switch|try)\\b", line ) );
			depth -= len( reMatchNoCase( "\\b(end|})\\b", line ) );
