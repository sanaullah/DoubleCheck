/** Bounded JSON-only chat gateway for modernization roles. */
@singleton
class {
	property name="chatGateway" inject="AIChatGateway";
	property name="skillService" inject="ModernizationSkillService";
	property name="secretRedactionService" inject="SecretRedactionService";
	property name="aiProviderResolver" inject="AIProviderResolverService";
	property name="promptCompiler" inject="PromptCompiler";
	property name="promptOutputValidator" inject="PromptOutputValidator";
	property name="maxRetries" inject="coldbox:setting:specialistMaxRetries";
	property name="retryBackoffMs" inject="coldbox:setting:specialistRetryBackoffMs";
	property name="log" inject="logbox:logger:{this}";
	variables.cancelledRuns = {};

	boolean function isEnabled() {
		var resolved = aiProviderResolver.resolve();
		return chatGateway.isEnabled( resolved.apiKey, resolved.isLocal );
	}

	/** Compile-provider preflight with no network or tool execution. */
	struct function preflight( required struct request, struct options = {} ) {
		var resolved = aiProviderResolver.resolve();
		var fittedRequest = fitRequest( resolved, arguments.request );
		var contractId = promptContractId( fittedRequest, arguments.options );
		assertProviderContract( resolved, fittedRequest, contractId );
		return {
			ok: true,
			request: fittedRequest,
			provider: resolved.provider ?: "",
			model: len( trim( arguments.options.model ?: "" ) ) ? trim( arguments.options.model ) : ( resolved.model ?: "" ),
			promptProvenance: isStruct( fittedRequest.provenance ?: "" ) ? duplicate( fittedRequest.provenance ) : {},
			diagnostics: isStruct( fittedRequest.provenance.segmentCharacters ?: "" ) ? duplicate( fittedRequest.provenance.segmentCharacters ) : {}
		};
	}

	/**
	 * Optional allowlisted skill reader for agent path. Construction/read failures
	 * never block the preferred chat JSON path.
	 */
	array function buildSkillTools() {
		try {
			var service = variables.skillService ?: javacast( "null", "" );
			if ( isNull( service ) ) return [];
			return [
				aiTool(
					"read_modernization_skill",
					"Read one allowlisted DoubleCheck modernization skill by name. Skills come from the DoubleCheck install only, never the analyzed project.",
					( name ) => {
						try {
							return service.readSkill( name );
						} catch ( any error ) {
							return {
								ok   : false,
								error: secretRedactionService.redactText( error.message ?: "Skill read failed" )
							};
						}
					}
				).describeName( "Allowlisted skill folder name under .agents/skills" )
			];
		} catch ( any ignored ) {
			return [];
		}
	}

	struct function run( required string runId, required struct request, struct options = {} ) {
		if ( !isEnabled() ) {
			throw( type = "AIConfigurationException", message = "Modernization provider is not enabled" );
		}
		if ( isCancelled( arguments.runId, arguments.options ) ) throw( type = "RunCancelled", message = "Modernization provider request cancelled" );
		// Resolved once per call (not cached on this singleton) so concurrent
		// shard dispatches on different pool threads never cross-contaminate
		// each other's provider/key - see AIProviderResolverService.
		var resolved = aiProviderResolver.resolve();
		var requestedRetries = isNumeric( arguments.options.maxRetries ?: "" )
			? max( 0, min( 3, int( arguments.options.maxRetries ) ) )
			: max( 0, min( 3, int( maxRetries ?: 2 ) ) );
		var requestedBudgets = structKeyExists( arguments.options, "budgets" ) && isStruct( arguments.options.budgets ) ? arguments.options.budgets : {};
		var budgets = requestedBudgets;
		if ( isNumeric( budgets.maxCostUsd ?: "" ) && val( budgets.maxCostUsd ) <= 0 ) return { ok: false, payload: {}, attempt: 0, provider: resolved.provider, model: resolved.model, durationMs: 0, error: "cost-budget-exceeded" };
		var iterationLimit = isNumeric( budgets.maxIterations ?: "" ) ? max( 1, int( budgets.maxIterations ) ) : 3;
		var attemptLimit = min( requestedRetries, iterationLimit - 1 );
		var startedAt = isNumeric( arguments.options.startedAt ?: "" ) ? val( arguments.options.startedAt ) : getTickCount();
		var maxDurationMs = isNumeric( arguments.options.maxDurationMs ?: "" ) ? max( 1000, int( arguments.options.maxDurationMs ) ) : 180000;
		// Prefer chat with injected skill pack. Optional agent+tool path may run first
		// when explicitly requested; any tool/agent failure falls through to chat.
		if ( arguments.options.useSkillAgent ?: false ) {
			try {
				var skillResult = runWithSkillAgent( resolved, arguments.runId, arguments.request, arguments.options, budgets, startedAt, maxDurationMs );
				if ( isStruct( skillResult ) && ( skillResult.ok ?: false ) ) return skillResult;
			} catch ( any toolError ) {
				if ( lCase( toolError.type ?: "" ) == "runcancelled" ) rethrow;
				emitObservation( arguments.options, {
					stage : "skill-tool-fallback",
					runId : arguments.runId,
					error : secretRedactionService.redactText( toolError.message ?: "Skill tool path unavailable" )
				} );
			}
		}
		var lastError = "";
		var lastDiagnostics = {};
		var spentUsd = 0;
		var activeRequest = copyRequest( arguments.request );
		if ( !isStruct( activeRequest.provenance ?: "" ) && isStruct( activeRequest.promptPackage ?: "" ) && isStruct( activeRequest.promptPackage.provenance ?: "" ) ) activeRequest.provenance = duplicate( activeRequest.promptPackage.provenance );
		var effectiveModel = len( trim( arguments.options.model ?: "" ) ) ? trim( arguments.options.model ) : resolved.model;
		var contractId = promptContractId( activeRequest, arguments.options );
		var schemaId = promptSchemaId( activeRequest, arguments.options );
		assertProviderContract( resolved, activeRequest, contractId );
		for ( var attempt = 0; attempt <= attemptLimit; attempt++ ) {
			if ( isCancelled( arguments.runId, arguments.options ) ) {
				throw( type = "RunCancelled", message = "Modernization provider request cancelled" );
			}
			var elapsedMs = getTickCount() - startedAt;
			if ( elapsedMs >= maxDurationMs ) {
				emitObservation( arguments.options, { stage: "budget-exceeded", runId: arguments.runId, elapsedMs: elapsedMs, maxDurationMs: maxDurationMs } );
				return { ok: false, payload: {}, attempt: attempt, provider: resolved.provider, model: effectiveModel, durationMs: elapsedMs, error: "budget-exceeded" };
			}
			try {
				activeRequest = fitRequest( resolved, activeRequest );
				var fittedMessages = activeRequest.messages ?: [];
				var response = chatGateway.chat(
					fittedMessages,
					buildParams( resolved, activeRequest, budgets, effectiveModel, contractId ),
					buildOptions( resolved, max( 1, maxDurationMs - elapsedMs ) )
				);
				var responseUsage = extractUsage( response );
				var payload = normalizeResponse( response );
				if ( !isStruct( payload ) ) {
					throw( type = "ModernizationProviderResponseException", message = "Provider returned non-object JSON" );
				}
				if ( len( schemaId ) ) {
					var acceptedPayload = getValidator().sanitizeValid( payload, schemaId, validationContext( activeRequest, arguments.options ) );
					payload = acceptedPayload.value;
					if ( acceptedPayload.rejectedItems.len() && isStruct( activeRequest.provenance ?: "" ) ) activeRequest.provenance.rejectedItems = duplicate( acceptedPayload.rejectedItems );
				}
				var outputTokens = isNumeric( budgets.maxTokensPerTask ?: "" ) ? int( budgets.maxTokensPerTask ) : ( isNumeric( budgets.maxTokens ?: "" ) ? int( budgets.maxTokens ) : 12000 );
				var outputLimit = max( 2048, min( 120000, outputTokens * 4 ) );
				if ( len( jsonSerialize( payload ) ) > outputLimit ) {
					throw( type = "ModernizationProviderResponseException", message = "Provider response exceeded the modernization output budget" );
				}
				var usage = normalizeUsage( responseUsage, activeRequest, payload );
				var costUsd = estimateCost( resolved, usage );
				spentUsd += costUsd;
				if ( isNumeric( budgets.maxCostUsd ?: "" ) && spentUsd > val( budgets.maxCostUsd ) ) {
					emitObservation( arguments.options, { stage: "budget-exceeded", runId: arguments.runId, attempt: attempt + 1, elapsedMs: getTickCount() - startedAt, costUsd: spentUsd, maxCostUsd: val( budgets.maxCostUsd ) } );
					return { ok: false, payload: {}, attempt: attempt + 1, provider: resolved.provider, model: effectiveModel, durationMs: getTickCount() - startedAt, costUsd: spentUsd, usage: usage, error: "cost-budget-exceeded" };
				}
				emitObservation( arguments.options, { stage: "provider-complete", runId: arguments.runId, attempt: attempt + 1, elapsedMs: getTickCount() - startedAt, outputCharacters: len( jsonSerialize( payload ) ), costUsd: spentUsd, usage: usage } );
				try {
					var completeMsg = "Modernize provider complete runId=#arguments.runId# role=#( arguments.options.role ?: '' )# attempt=#( attempt + 1 )# chars=#len( jsonSerialize( payload ) )# costUsd=#spentUsd#";
					if ( !isNull( variables.log ?: javacast( "null", "" ) ) ) log.info( completeMsg );
				} catch ( any ignored ) {}
				var finalProvenance = isStruct( activeRequest.provenance ?: "" ) ? duplicate( activeRequest.provenance ) : {};
				if ( isStruct( activeRequest.truncation ?: "" ) && ( activeRequest.truncation.applied ?: false ) ) finalProvenance.truncation = duplicate( activeRequest.truncation );
				return { ok: true, payload: payload, outputCharacters: len( jsonSerialize( payload ) ), attempt: attempt + 1, provider: resolved.provider, model: effectiveModel, durationMs: getTickCount() - startedAt, costUsd: spentUsd, usage: usage, promptProvenance: finalProvenance };
			} catch ( any error ) {
				if ( lCase( error.type ?: "" ) == "runcancelled" ) rethrow;
				lastError = classifyProviderError( error );
				var errorObservation = {
					stage: "provider-error",
					runId: arguments.runId,
					attempt: attempt + 1,
					elapsedMs: getTickCount() - startedAt,
					error: lastError,
					provider: resolved.provider ?: "",
					model: effectiveModel,
					promptId: contractId,
					promptProvenance: isStruct( activeRequest.provenance ?: "" ) ? duplicate( activeRequest.provenance ) : {}
				};
				lastDiagnostics = exceptionDiagnostics( error );
				if ( lastDiagnostics.count() ) errorObservation.fit = duplicate( lastDiagnostics );
				emitObservation( arguments.options, errorObservation );
				try {
					var errorMsg = "Modernize provider error runId=#arguments.runId# role=#( arguments.options.role ?: '' )# attempt=#( attempt + 1 )# error=#left( lastError, 240 )#";
					if ( !isNull( variables.log ?: javacast( "null", "" ) ) ) log.warn( errorMsg );
				} catch ( any ignored ) {}
				if ( isPromptFitError( error ) ) break;
				if ( attempt < attemptLimit ) {
					if ( isStruct( error.data ?: "" ) && isArray( error.data.reasonCodes ?: "" ) && isStruct( activeRequest.provenance ?: "" ) ) activeRequest.provenance.validationReasonCodes = duplicate( error.data.reasonCodes );
					if ( isRepairableOutputError( error ) ) {
						activeRequest = shrinkRequestForRetry( activeRequest, lastError, contractId );
						emitObservation( arguments.options, { stage: "provider-retry-shrink", runId: arguments.runId, attempt: attempt + 1, error: lastError } );
					}
					var delayMs = isNumeric( retryBackoffMs ?: "" ) ? max( 0, int( retryBackoffMs ) ) * ( attempt + 1 ) : 0;
					if ( delayMs ) sleep( min( 1000, delayMs ) );
				}
			}
		}
		return {
			ok: false,
			payload: {},
			attempt: attemptLimit + 1,
			provider: resolved.provider,
			model: effectiveModel,
			durationMs: getTickCount() - startedAt,
			error: lastError,
			promptProvenance: isStruct( activeRequest.provenance ?: "" ) ? duplicate( activeRequest.provenance ) : {},
			diagnostics: lastDiagnostics
		};
	}

	void function cancelRun( required string runId ) {
		variables.cancelledRuns[ arguments.runId ] = true;
	}

	private boolean function isCancelled( required string runId, required struct options ) {
		if ( variables.cancelledRuns.keyExists( arguments.runId ) ) return true;
		return structKeyExists( arguments.options, "isCancelled" ) && isCustomFunction( arguments.options.isCancelled ) && arguments.options.isCancelled();
	}

	private struct function buildParams( required struct resolved, required struct request, struct budgets = {}, string modelOverride = "", string contractId = "" ) {
		var window = isNumeric( arguments.resolved.contextWindow ?: "" ) ? max( 1024, int( arguments.resolved.contextWindow ) ) : 128000;
		var capabilities = getCompiler().capabilities( arguments.resolved.provider ?: "" );
		var tokenCap = isNumeric( capabilities.maxOutputTokens ?: "" ) ? max( 256, int( capabilities.maxOutputTokens ) ) : 16000;
		var requestedTokens = isNumeric( arguments.budgets.maxTokensPerTask ?: "" )
			? int( arguments.budgets.maxTokensPerTask )
			: min( tokenCap, max( 1024, int( window * .12 ) ) );
		var params = { temperature: 0, max_tokens: min( tokenCap, max( 1024, requestedTokens ) ) };
		var effectiveModel = len( trim( arguments.modelOverride ) ) ? trim( arguments.modelOverride ) : arguments.resolved.model;
		if ( len( trim( effectiveModel ?: "" ) ) ) params.model = effectiveModel;
		if ( structKeyExists( arguments.request, "params" ) && isStruct( arguments.request.params ) ) structAppend( params, arguments.request.params, true );
		// Provider/request metadata must not be able to bypass the immutable run
		// output budget.  Clamp again after merging request params.
		params.max_tokens = min( params.max_tokens ?: tokenCap, min( tokenCap, max( 1024, requestedTokens ) ) );
		if ( len( trim( arguments.contractId ) ) ) structAppend( params, getCompiler().structuredOutput( arguments.contractId, arguments.resolved.provider ?: "" ), true );
		return params;
	}

	private struct function buildOptions( required struct resolved, numeric effectiveTimeout = 0 ) {
		// aiTimeout setting is seconds. Callers pass remaining wall-clock as ms.
		var seconds = isNumeric( arguments.resolved.timeout ?: "" ) ? max( 1, int( arguments.resolved.timeout ) ) : 120;
		if ( arguments.effectiveTimeout > 0 ) {
			seconds = min( seconds, max( 1, int( arguments.effectiveTimeout / 1000 ) ) );
		}
		var result = { provider: arguments.resolved.provider, apiKey: arguments.resolved.apiKey, returnFormat: "json", timeout: seconds };
		if ( len( trim( arguments.resolved.baseURL ?: "" ) ) ) result.baseURL = arguments.resolved.baseURL;
		return result;
	}

	private string function classifyProviderError( required any error ) {
		var raw = secretRedactionService.redactText( arguments.error.message ?: "Provider request failed" );
		if ( isTruncatedJsonError( arguments.error ) ) {
			return "Provider JSON was truncated mid-object (raise max tokens or keep the first slice small). " & left( raw, 240 );
		}
		return left( raw, 500 );
	}

	private boolean function isTruncatedJsonError( required any error ) {
		var message = lCase( toString( arguments.error.message ?: "" ) );
		var typeName = lCase( toString( arguments.error.type ?: "" ) );
		if ( findNoCase( "parse json", message ) || findNoCase( "jsondeserialize", typeName ) || findNoCase( "json", typeName ) ) return true;
		if ( findNoCase( "failed to parse json", message ) ) return true;
		if ( findNoCase( "unexpected end", message ) || findNoCase( "unterminated", message ) ) return true;
		return false;
	}

	private boolean function isRepairableOutputError( required any error ) {
		var typeName = lCase( toString( arguments.error.type ?: "" ) );
		return isTruncatedJsonError( arguments.error ) || findNoCase( "promptoutputvalidation", typeName ) > 0 || findNoCase( "providerresponse", typeName ) > 0;
	}

	private struct function shrinkRequestForRetry( required struct request, string reason = "", string contractId = "" ) {
		var copy = copyRequest( arguments.request );
		var shrink = "RETRY CONSTRAINT: Your previous JSON was truncated. Return a smaller COMPLETE JSON object only, keys in order targetUnits, unitLinks, routeContracts, samples, contexts, extracts. Cap targetUnits at 3, unitLinks at 3, routeContracts at 3, samples at 2. contexts=[] and extracts=[]. Each evidenceRefs array at most 2 ids. sampleCode under 8 lines. Map only the shard paths already listed; do not invent a repo-wide contexts dump.";
		if ( len( trim( arguments.contractId ) ) && isStruct( copy.promptPackage ?: "" ) ) {
			var repaired = getCompiler().compileRepair( copy.promptPackage, len( trim( arguments.reason ) ) ? arguments.reason : "output validation failure" );
			if ( isStruct( arguments.request.provenance ?: "" ) && isArray( arguments.request.provenance.validationReasonCodes ?: "" ) ) repaired.provenance.validationReasonCodes = duplicate( arguments.request.provenance.validationReasonCodes );
			copy.promptPackage = repaired;
			copy.messages = repaired.messages;
			copy.provenance = repaired.provenance;
			copy.userPrompt = repaired.userPrompt;
			if ( !isArray( copy.messages ?: "" ) ) copy.messages = [];
			copy.messages[ copy.messages.len() ].content &= char( 10 ) & shrink;
		} else {
			if ( !isArray( copy.messages ?: "" ) ) copy.messages = [];
			if ( copy.messages.len() && lCase( trim( copy.messages[ 1 ].role ?: "" ) ) == "system" ) {
				copy.messages.append( { role: "user", content: "BEGIN_REPAIR_REQUEST" & char( 10 ) & "The previous response failed output validation. Return the same semantic result as one complete JSON object." & char( 10 ) & "END_REPAIR_REQUEST" & char( 10 ) & shrink } );
			} else {
				copy.messages.append( { role: "user", content: shrink } );
			}
		}
		if ( !isStruct( copy.params ?: "" ) ) copy.params = {};
		copy.params.max_tokens = 8000;
		copy.truncation = { applied: true, omitted: [ "evidence-for-repair" ], boundaries: [ "complete-envelope" ], retry: true };
		return copy;
	}

	private void function emitObservation( required struct options, required struct observation ) {
		if ( structKeyExists( arguments.options, "onObservation" ) && isCustomFunction( arguments.options.onObservation ) ) {
			try {
				var safe = duplicate( arguments.observation );
				safe.role = structKeyExists( arguments.options, "role" ) ? arguments.options.role : "";
				if ( structKeyExists( safe, "error" ) ) safe.error = secretRedactionService.redactText( toString( safe.error ) );
				arguments.options.onObservation( safe );
			} catch ( any ignored ) {
				// Observability is best effort and must never fail a modernization run.
			}
		}
	}

	private struct function runWithSkillAgent(
		required struct resolved,
		required string runId,
		required struct request,
		required struct options,
		required struct budgets,
		required numeric startedAt,
		required numeric maxDurationMs
	) {
		if ( isCancelled( arguments.runId, arguments.options ) ) {
			throw( type = "RunCancelled", message = "Modernization provider request cancelled" );
		}
		var skillCapabilities = getCompiler().capabilities( arguments.resolved.provider ?: "" );
		if ( !( skillCapabilities.tools ?: false ) ) {
			throw( type = "ModernizationProviderCapabilityException", message = "Provider does not support the allowlisted modernization skill tool transport" );
		}
		if ( !( skillCapabilities.distinctSystem ?: true ) ) throw( type = "ModernizationProviderCapabilityException", message = "Provider cannot preserve the immutable modernization system contract" );
		var tools = buildSkillTools();
		if ( !tools.len() ) {
			throw( type = "ModernizationSkillToolUnavailable", message = "Skill tools unavailable" );
		}
		var systemText = "";
		var userText = "";
		for ( var message in ( arguments.request.messages ?: [] ) ) {
			var role = lCase( trim( message.role ?: "" ) );
			var content = toString( message.content ?: "" );
			if ( role == "system" ) systemText &= ( len( systemText ) ? char( 10 ) : "" ) & content;
			else userText &= ( len( userText ) ? char( 10 ) : "" ) & content;
		}
		if ( !len( trim( systemText ) ) ) {
			var fallbackContract = promptContractId( arguments.request, arguments.options );
			if ( !len( fallbackContract ) ) throw( type = "ModernizationPromptContractException", message = "Skill agent requires a compiled modernization contract" );
			var fallbackPackage = getCompiler().compile( fallbackContract, { task: {}, evidence: {} }, { provider: arguments.resolved.provider, model: arguments.resolved.model } );
			systemText = fallbackPackage.systemPrompt;
		}
		if ( !len( trim( userText ) ) ) userText = "Produce the modernization JSON payload.";
		var elapsedMs = getTickCount() - arguments.startedAt;
		if ( elapsedMs >= arguments.maxDurationMs ) {
			throw( type = "ModernizationSkillToolUnavailable", message = "Skill agent budget exceeded before start" );
		}
		var agent = aiAgent(
			name         = "modernization-skill",
			description  = "Modernization planner with optional allowlisted skill reads",
			instructions = systemText,
			tools        = tools
		);
		var effectiveModel = len( trim( arguments.options.model ?: "" ) ) ? trim( arguments.options.model ) : arguments.resolved.model;
		var raw = agent.run(
			userText,
			buildParams( arguments.resolved, arguments.request, arguments.budgets, effectiveModel, promptContractId( arguments.request, arguments.options ) ),
			buildOptions( arguments.resolved, max( 1, arguments.maxDurationMs - elapsedMs ) )
		);
		var responseUsage = extractUsage( raw );
		var payload = normalizeResponse( raw );
		if ( !isStruct( payload ) ) {
			throw( type = "ModernizationProviderResponseException", message = "Skill agent returned non-object JSON" );
		}
		var skillSchemaId = promptSchemaId( arguments.request, arguments.options );
		if ( len( skillSchemaId ) ) {
			var acceptedPayload = getValidator().sanitizeValid( payload, skillSchemaId, validationContext( arguments.request, arguments.options ) );
			payload = acceptedPayload.value;
			if ( acceptedPayload.rejectedItems.len() && isStruct( arguments.request.provenance ?: "" ) ) arguments.request.provenance.rejectedItems = duplicate( acceptedPayload.rejectedItems );
		}
		var usage = normalizeUsage( responseUsage, arguments.request, payload );
		var costUsd = estimateCost( arguments.resolved, usage );
		emitObservation( arguments.options, {
			stage            : "provider-complete",
			runId            : arguments.runId,
			attempt          : 1,
			elapsedMs        : getTickCount() - arguments.startedAt,
			outputCharacters : len( jsonSerialize( payload ) ),
			costUsd          : costUsd,
			usage            : usage,
			path             : "skill-agent"
		} );
		return {
			ok               : true,
			payload          : payload,
			outputCharacters : len( jsonSerialize( payload ) ),
			attempt          : 1,
			provider         : arguments.resolved.provider,
			model            : effectiveModel,
			costUsd          : costUsd,
			usage            : usage,
			path             : "skill-agent",
			promptProvenance: isStruct( arguments.request.provenance ?: "" ) ? duplicate( arguments.request.provenance ) : {}
		};
	}

	private string function promptContractId( required struct request, required struct options ) {
		if ( isStruct( arguments.request.promptPackage ?: "" ) && len( trim( arguments.request.promptPackage.promptId ?: "" ) ) ) return arguments.request.promptPackage.promptId;
		if ( len( trim( arguments.request.promptId ?: "" ) ) ) return arguments.request.promptId;
		var role = lCase( trim( arguments.options.role ?: "" ) );
		return [ "modernization-application", "modernization-database", "modernization-roadmap", "modernization-architecture", "modernization-repair", "modernization-slice-rebuild", "modernization-item-rebuild" ].contains( role ) ? role : "";
	}

	private string function promptSchemaId( required struct request, required struct options ) {
		if ( isStruct( arguments.request.promptPackage ?: "" ) && len( trim( arguments.request.promptPackage.outputSchema ?: "" ) ) ) return arguments.request.promptPackage.outputSchema;
		if ( len( trim( arguments.request.outputSchemaId ?: "" ) ) ) return arguments.request.outputSchemaId;
		var role = promptContractId( arguments.request, arguments.options );
		return len( role ) ? role & "-v1" : "";
	}

	private struct function validationContext( required struct request, required struct options ) {
		var context = isStruct( arguments.request.validationContext ?: "" ) ? duplicate( arguments.request.validationContext ) : {};
		if ( isArray( arguments.options.allowedFilePaths ?: "" ) ) context.allowedFilePaths = arguments.options.allowedFilePaths;
		if ( isArray( arguments.request.allowedFilePaths ?: "" ) ) context.allowedFilePaths = arguments.request.allowedFilePaths;
		if ( isArray( arguments.options.allowedFactIds ?: "" ) ) context.allowedFactIds = arguments.options.allowedFactIds;
		if ( isArray( arguments.options.allowedEvidenceIds ?: "" ) ) context.allowedEvidenceIds = arguments.options.allowedEvidenceIds;
		return context;
	}

	private void function assertProviderContract( required struct resolved, required struct request, string contractId = "" ) {
		var capabilities = getCompiler().capabilities( arguments.resolved.provider ?: "" );
		if ( !isArray( arguments.request.messages ?: "" ) ) {
			if ( len( trim( arguments.contractId ) ) ) throw( type = "ModernizationPromptContractException", message = "Modernization request has no compiled messages" );
			return;
		}
		var hasSystem = arguments.request.messages.some( ( message ) => lCase( trim( message.role ?: "" ) ) == "system" );
		if ( len( trim( arguments.contractId ) ) && !( capabilities.distinctSystem ?: true ) && hasSystem ) throw( type = "ModernizationProviderCapabilityException", message = "Provider cannot preserve the immutable system contract" );
		if ( len( trim( arguments.contractId ) ) && !hasSystem ) {
			var diagnostics = {
				contractId: arguments.contractId,
				messageCount: arguments.request.messages.len(),
				messageRoles: arguments.request.messages.map( ( item ) => toString( item.role ?: "" ) ),
				packageSystemCharacters: isStruct( arguments.request.promptPackage ?: "" ) ? len( toString( arguments.request.promptPackage.systemPrompt ?: "" ) ) : 0
			};
			throw(
				type = "ModernizationPromptContractException",
				message = "Compiled modernization contract lost its system message",
				data = diagnostics,
				detail = jsonSerialize( diagnostics )
			);
		}
	}

	private any function getCompiler() {
		if ( !isNull( variables.promptCompiler ?: javacast( "null", "" ) ) ) return variables.promptCompiler;
		variables.promptCompiler = new app.models.services.PromptCompiler();
		return variables.promptCompiler;
	}

	private any function getValidator() {
		if ( !isNull( variables.promptOutputValidator ?: javacast( "null", "" ) ) ) return variables.promptOutputValidator;
		variables.promptOutputValidator = new app.models.services.PromptOutputValidator();
		return variables.promptOutputValidator;
	}

	private struct function fitRequest( required struct resolved, required struct request ) {
		var output = copyRequest( arguments.request );
		if ( isStruct( output.promptPackage ?: "" ) && isStruct( output.promptPackage.segments ?: "" ) ) {
			var capabilities = getCompiler().capabilities( arguments.resolved.provider ?: "" );
			var configuredCap = isNumeric( arguments.resolved.maxPromptCharacters ?: "" )
				? arguments.resolved.maxPromptCharacters
				: capabilities.maxPromptCharacters;
			var cap = isNumeric( configuredCap ?: "" ) ? max( 4000, int( configuredCap ) ) : 60000;
			var fittedPackage = getCompiler().fitPackage( output.promptPackage, cap );
			output.promptPackage = fittedPackage;
			output.messages = fittedPackage.messages;
			output.userPrompt = fittedPackage.userPrompt;
			output.provenance = fittedPackage.provenance;
			output.truncation = fittedPackage.truncation;
			return output;
		}
		var originalMessages = duplicate( output.messages ?: [] );
		output.messages = fitMessages( arguments.resolved, originalMessages );
		if ( jsonSerialize( originalMessages ) != jsonSerialize( output.messages ) ) {
			output.truncation = { applied: true, omitted: [ "earlier-context" ], boundaries: [ "complete-message" ] };
		}
		return output;
	}

	private boolean function isPromptFitError( required any error ) {
		var typeName = lCase( toString( arguments.error.type ?: "" ) );
		return findNoCase( "promptpackagefit", typeName ) > 0 || findNoCase( "modernizationpromptbudget", typeName ) > 0;
	}

	/**
	 * Request structs may be assembled on a worker whose callback closure
	 * captures BoxLang's scheduled executor. Copy the request envelope shallowly
	 * and replace only the prompt fields we mutate; never recursively clone the
	 * worker runtime graph.
	 */
	private struct function copyRequest( required struct request ) {
		var output = {};
		if ( structKeyExists( arguments.request, "role" ) ) output.role = arguments.request.role;
		if ( structKeyExists( arguments.request, "promptVersion" ) ) output.promptVersion = arguments.request.promptVersion;
		if ( structKeyExists( arguments.request, "promptId" ) ) output.promptId = arguments.request.promptId;
		if ( structKeyExists( arguments.request, "contractVersion" ) ) output.contractVersion = arguments.request.contractVersion;
		if ( structKeyExists( arguments.request, "outputSchemaId" ) ) output.outputSchemaId = arguments.request.outputSchemaId;
		if ( structKeyExists( arguments.request, "messages" ) ) output.messages = arguments.request.messages;
		if ( structKeyExists( arguments.request, "outputSchema" ) ) output.outputSchema = arguments.request.outputSchema;
		if ( structKeyExists( arguments.request, "promptPackage" ) ) output.promptPackage = arguments.request.promptPackage;
		if ( structKeyExists( arguments.request, "runtime" ) ) output.runtime = arguments.request.runtime;
		if ( structKeyExists( arguments.request, "profile" ) ) output.profile = arguments.request.profile;
		if ( structKeyExists( arguments.request, "budgets" ) ) output.budgets = arguments.request.budgets;
		if ( structKeyExists( arguments.request, "skillPack" ) ) output.skillPack = arguments.request.skillPack;
		if ( structKeyExists( arguments.request, "provenance" ) ) output.provenance = arguments.request.provenance;
		if ( structKeyExists( arguments.request, "validationContext" ) ) output.validationContext = arguments.request.validationContext;
		if ( structKeyExists( arguments.request, "allowedFilePaths" ) ) output.allowedFilePaths = arguments.request.allowedFilePaths;
		if ( structKeyExists( arguments.request, "params" ) ) output.params = arguments.request.params;
		if ( structKeyExists( arguments.request, "userPrompt" ) ) output.userPrompt = arguments.request.userPrompt;
		if ( structKeyExists( arguments.request, "truncation" ) ) output.truncation = arguments.request.truncation;
		return output;
	}

	private struct function exceptionDiagnostics( required any error ) {
		if ( isStruct( arguments.error.data ?: "" ) ) return duplicate( arguments.error.data );
		var detail = trim( toString( arguments.error.detail ?: "" ) );
		if ( len( detail ) && isJSON( detail ) ) {
			var parsed = jsonDeserialize( detail );
			if ( isStruct( parsed ) ) return parsed;
		}
		return {};
	}

	private array function fitMessages( required struct resolved, required array messages ) {
		var capabilities = getCompiler().capabilities( arguments.resolved.provider ?: "" );
		var configuredCap = isNumeric( arguments.resolved.maxPromptCharacters ?: "" ) ? arguments.resolved.maxPromptCharacters : capabilities.maxPromptCharacters;
		var cap = isNumeric( configuredCap ?: "" ) ? max( 4000, int( configuredCap ) ) : 60000;
		var output = duplicate( arguments.messages );
		if ( !output.len() ) return output;
		var systemIndex = 0;
		for ( var findIndex = 1; findIndex <= output.len(); findIndex++ ) {
			if ( lCase( trim( output[ findIndex ].role ?: "" ) ) == "system" ) { systemIndex = findIndex; break; }
		}
		var finalIndex = output.len();
		var fixed = ( systemIndex > 0 ? len( toString( output[ systemIndex ].content ?: "" ) ) : 0 ) + len( toString( output[ finalIndex ].content ?: "" ) );
		if ( systemIndex > 0 && finalIndex == systemIndex ) fixed = len( toString( output[ systemIndex ].content ?: "" ) );
		if ( fixed > cap ) throw( type = "ModernizationPromptBudgetException", message = "Immutable prompt contract and required user envelope exceed the provider prompt budget" );
		var remaining = cap - fixed;
		for ( var index = 1; index <= output.len(); index++ ) {
			if ( index == systemIndex || index == finalIndex ) continue;
			var content = toString( output[ index ].content ?: "" );
			if ( len( content ) > remaining ) {
				output[ index ].content = boundedMessage( content, remaining );
				remaining = 0;
			} else {
				remaining -= len( content );
			}
		}
		return output;
	}

	private string function boundedMessage( required string content, required numeric budget ) {
		if ( arguments.budget <= 0 ) return "[earlier context omitted by modernization gateway]";
		if ( len( arguments.content ) <= arguments.budget ) return arguments.content;
		var lineBudget = max( 0, arguments.budget - 48 );
		var lines = left( arguments.content, lineBudget ).listToArray( char( 10 ) );
		var kept = [];
		var size = 0;
		for ( var line in lines ) {
			if ( size + len( line ) + 1 > lineBudget ) break;
			kept.append( line );
			size += len( line ) + 1;
		}
		return kept.toList( char( 10 ) ) & char( 10 ) & "[earlier context truncated at a complete line]";
	}

	private any function normalizeResponse( required any response ) {
		if ( isNull( arguments.response ?: javacast( "null", "" ) ) ) {
			throw( type = "ModernizationProviderResponseException", message = "Provider returned an empty response" );
		}
		if ( isStruct( arguments.response ) ) {
			if ( structKeyExists( arguments.response, "content" ) && isSimpleValue( arguments.response.content ) ) return normalizeResponse( arguments.response.content );
			return arguments.response;
		}
		var text = trim( toString( arguments.response ) );
		if ( !len( text ) ) return {};
		// Strip the optional Markdown fence without relying on a backslash-heavy
		// regex (BoxLang preserves doubled escapes in string literals).
		text = replaceNoCase( text, "```json", "", "all" );
		text = replace( text, "```", "", "all" );
		text = trim( text );
		return jsonDeserialize( text );
	}

	private struct function extractUsage( required any response ) {
		if ( isStruct( arguments.response ) && isStruct( arguments.response.usage ?: "" ) ) return arguments.response.usage;
		if ( isStruct( arguments.response ) && isStruct( arguments.response.meta ?: "" ) && isStruct( arguments.response.meta.usage ?: "" ) ) return arguments.response.meta.usage;
		return {};
	}

	private struct function normalizeUsage( required struct usage, required struct request, required any payload ) {
		var prompt = val( arguments.usage.promptTokens ?: arguments.usage.prompt_tokens ?: arguments.usage.inputTokens ?: arguments.usage.input_tokens ?: 0 );
		var completion = val( arguments.usage.completionTokens ?: arguments.usage.completion_tokens ?: arguments.usage.outputTokens ?: arguments.usage.output_tokens ?: 0 );
		if ( prompt <= 0 ) prompt = max( 1, int( len( jsonSerialize( arguments.request.messages ?: [] ) ) / 4 ) );
		if ( completion <= 0 ) completion = max( 1, int( len( jsonSerialize( arguments.payload ) ) / 4 ) );
		return { promptTokens: prompt, completionTokens: completion, totalTokens: prompt + completion };
	}

	private numeric function estimateCost( required struct resolved, required struct usage ) {
		var inputRate = isNumeric( arguments.resolved.inputUsdPerMillion ?: "" ) ? val( arguments.resolved.inputUsdPerMillion ) : 5;
		var outputRate = isNumeric( arguments.resolved.outputUsdPerMillion ?: "" ) ? val( arguments.resolved.outputUsdPerMillion ) : 15;
		return ( val( arguments.usage.promptTokens ?: 0 ) / 1000000 * inputRate ) + ( val( arguments.usage.completionTokens ?: 0 ) / 1000000 * outputRate );
	}
}
