/**
 * Executes modernization roles and merges bounded fragments.
 * Application mapping is sharded across many small agent calls so large
 * CFML trees (e.g. CFTunes) do not truncate a single mid-object JSON dump.
 */
@singleton
class threadsafe {
	property name="agentFactory" inject="ModernizationAgentFactory";
	property name="agentGateway" inject="ModernizationAgentGateway";
	property name="secretRedactionService" inject="SecretRedactionService";
	property name="identityService" inject="ModernizationIdentityService";
	property name="derivedStructureService" inject="ModernizationDerivedStructureService";
	property name="log" inject="logbox:logger:{this}";
	variables.cancelledRuns = {};
	variables.maxItems = 200;
	// Prefer fewer, larger shards so database/architecture/roadmap keep wall-clock.
	// Callers can still request smaller shards via budgets.applicationShardSize.
	variables.defaultApplicationShards = 40;
	// Absolute shard ceiling for both scoped and unscoped runs. Callers can
	// request less; large inventories expand up to this so maps are not capped
	// at the historical 40-shard wall that left thousands of paths unmapped.
	variables.maxApplicationShards = 200;
	variables.maxScopedApplicationShards = 200;
	variables.defaultShardSize = 6;
	// Conservative per-shard wall-clock used when capping planned shards so later
	// stages (database → architecture → roadmap) are not starved.
	variables.estimatedShardWallMs = 90000;
	variables.minLaterStageReserveMs = 300000;
	variables.maxLaterStageReserveMs = 900000;
	// Unscoped estates this large get directory-inferred packaging seams when
	// the architecture role is missing — otherwise the road collapses to one
	// generic modular-monolith phase.
	variables.minUnitsForFolderInference = 24;
	variables.maxInferredArchitectureScopes = 12;
	// Roadmap shards are sized independently of the application-shard
	// constants above: they cover already-compacted target-unit groups (from
	// derivedStructureService.synthesisRoadmapGroups()), not raw file shards, and the failure mode
	// being fixed is the roadmap role trying to describe an entire ~20-group
	// plan in one call. 24 gives real projects one phase per group while
	// still collapsing small/no-architecture-group test plans to one shard.
	variables.defaultRoadmapUnitBatchSize = 24;
	variables.maxRoadmapShards = 24;

	/**
	 * Direct unit construction does not run WireBox injection, and several specs
	 * build this service with `new`. Seed the derived-structure collaborator so
	 * those paths keep working after the synthesis block moved out.
	 */
	function init() {
		if ( isNull( variables.derivedStructureService ?: javacast( "null", "" ) ) ) {
			variables.derivedStructureService = new app.models.services.ModernizationDerivedStructureService();
		}
		return this;
	}

	struct function propose(
		required string runId,
		required struct input,
		required struct evidence,
		struct options = {}
	) {
		if ( !agentGateway.isEnabled() ) return failure( "provider-disabled" );
		applyModelOverride( arguments.input, arguments.options );
		var budgets = structKeyExists( arguments.input, "budgets" ) && isStruct( arguments.input.budgets ) ? arguments.input.budgets : {};
		var maxTasks = isNumeric( budgets.maxTasks ?: "" ) ? max( 1, int( budgets.maxTasks ) ) : 3;
		var maxDurationMs = isNumeric( budgets.maxDurationMs ?: "" ) ? max( 1000, int( budgets.maxDurationMs ) ) : 180000;
		var startedAt = isNumeric( arguments.input.startedAt ?: "" ) ? val( arguments.input.startedAt ) : getTickCount();
		var fragments = {};
		var errors = [];
		var notes = [];
		var totalOutputCharacters = 0;
		var totalCostUsd = 0;
		var dbPromptProvenance = {};
		var samplePolicy = structKeyExists( arguments.input, "samplePolicy" ) && isStruct( arguments.input.samplePolicy ) ? arguments.input.samplePolicy : {};
		var runtime = { runtime: arguments.input.target.runtime ?: arguments.input.runtime ?: "", profile: arguments.input.target.layoutProfile ?: arguments.input.profile ?: "" };

		// Many small application agents in parallel waves beat one whole-repo JSON
		// that truncates, and finish inside the wall-clock budget.
		var appShards = buildApplicationShards( arguments.evidence, budgets );
		var shardCap = max( 1, appShards.len() );
		var totalOutputLimit = isNumeric( budgets.maxTokens ?: "" ) ? max( 2048, int( budgets.maxTokens ) * 4 * max( 3, shardCap ) ) : 24000 * max( 3, shardCap );
		var initialPreflight = preflightInitialRoles( appShards, runtime, arguments.evidence, budgets, maxTasks, arguments.options );
		if ( !( initialPreflight.ok ?: false ) ) {
			return failure(
				initialPreflight.message ?: "modernization prompt preflight failed",
				[ {
					role: initialPreflight.role ?: "modernization",
					message: initialPreflight.message ?: "modernization prompt preflight failed",
					stage: "prompt-preflight",
					diagnostics: initialPreflight.diagnostics ?: {}
				} ]
			);
		}
		var allApplicationPaths = prioritizedLegacyPaths( arguments.evidence );
		var plannedApplicationPaths = {};
		for ( var plannedShard in appShards ) {
			for ( var plannedPath in plannedShard.shardMeta.paths ?: [] ) plannedApplicationPaths[ lCase( plannedPath ) ] = true;
		}
		// Paths in the inventory that no shard will cover. Two distinct causes,
		// reported separately so a reader can tell "we ran out of shards" from
		// "we had no source text to read".
		var groundedApplicationPaths = groundedPathSet( arguments.evidence );
		var shardCapOmissions = [];
		var ungroundedOmissions = [];
		for ( var applicationPath in allApplicationPaths ) {
			if ( plannedApplicationPaths.keyExists( lCase( applicationPath ) ) ) continue;
			if ( groundedApplicationPaths.count() && !groundedApplicationPaths.keyExists( lCase( normalizeLegacyPath( applicationPath ) ) ) ) {
				ungroundedOmissions.append( applicationPath );
			} else {
				shardCapOmissions.append( applicationPath );
			}
		}
		if ( ungroundedOmissions.len() ) {
			notes.append( {
				role: "modernization-application",
				message: "omitted-ungrounded-paths",
				severity: "info",
				reason: "no-context-partition",
				count: ungroundedOmissions.len(),
				paths: ungroundedOmissions
			} );
			logInfo( "Modernize proposal #arguments.runId#: #ungroundedOmissions.len()# path(s) had no context partition and were not mapped" );
		}
		// Captured before the run: a truncated shard can append smaller retry
		// shards to appShards, and those are retries of already-planned paths
		// rather than additional planned coverage.
		var plannedShardTotal = appShards.len();
		logInfo( "Modernize proposal #arguments.runId#: #plannedShardTotal# application shard(s), concurrency=#( budgets.applicationShardConcurrency ?: 3 )#, maxDurationMs=#maxDurationMs#, maxCostUsd=#( budgets.maxCostUsd ?: '' )#" );
		var appResult = runApplicationShards( arguments.runId, appShards, runtime, budgets, startedAt, maxDurationMs, totalOutputLimit, arguments.options );
		var appMerged = appResult.fragment;
		var appAccepted = appResult.accepted;
		totalOutputCharacters = appResult.outputCharacters;
		totalCostUsd = appResult.costUsd;
		splitProposalMessages( appResult.errors, errors, notes );
		if ( appAccepted > 0 ) fragments[ "modernization-application" ] = appMerged;
		logInfo( "Modernize proposal #arguments.runId#: application shards accepted #appAccepted#/#plannedShardTotal#, costUsd=#totalCostUsd#, outputChars=#totalOutputCharacters#" );

		// Database role remains a single call when the task budget allows it.
		if ( maxTasks >= 2 && isCancelled( arguments.runId, arguments.options ) ) {
			errors.append( { role: "modernization-database", message: "cancelled-after-partial-acceptance" } );
		} else if ( maxTasks >= 2 ) {
			if ( getTickCount() - startedAt >= maxDurationMs ) {
				errors.append( { role: "modernization-database", message: "budget-exceeded", elapsedMs: getTickCount() - startedAt, maxDurationMs: maxDurationMs } );
			} else if ( totalOutputCharacters >= totalOutputLimit ) {
				errors.append( { role: "modernization-database", message: "total-output-budget-exceeded" } );
			} else if ( isNumeric( budgets.maxCostUsd ?: "" ) && totalCostUsd >= val( budgets.maxCostUsd ) ) {
				errors.append( { role: "modernization-database", message: "cost-budget-exceeded" } );
			} else {
				var dbBudgets = duplicate( budgets );
				// Dense schema packs truncate at the default 8k/task ceiling.
				dbBudgets.maxTokensPerTask = min( 16000, max( 12000, int( budgets.maxTokensPerTask ?: 8000 ) ) );
				if ( isNumeric( budgets.maxTokens ?: "" ) ) {
					dbBudgets.maxTokens = max( int( budgets.maxTokens ), dbBudgets.maxTokensPerTask );
				}
				var dbRequest = agentFactory.build( "modernization-database", runtime, arguments.evidence, dbBudgets );
				var dbOptions = copyGatewayOptions( arguments.options );
				dbOptions.budgets = dbBudgets;
				dbOptions.startedAt = getTickCount();
				dbOptions.maxDurationMs = max( 5000, maxDurationMs - ( getTickCount() - startedAt ) );
				// Two retries: first shrinks the ask, second may still salvage
				// truncated JSON inside the gateway before we synthesize.
				dbOptions.maxRetries = 2;
				dbOptions.role = "modernization-database";
				var dbResponse = agentGateway.run( arguments.runId, dbRequest, dbOptions );
				dbPromptProvenance = structKeyExists( dbResponse, "promptProvenance" ) ? dbResponse.promptProvenance : {};
				totalCostUsd += isNumeric( dbResponse.costUsd ?: "" ) ? val( dbResponse.costUsd ) : 0;
				if ( !( dbResponse.ok ?: false ) ) {
					var synthDb = synthesizeDatabaseFragment( arguments.evidence.schemaEvidence ?: {} );
					if ( ( isArray( synthDb.dbFindings ?: "" ) && synthDb.dbFindings.len() ) || ( isArray( synthDb.dbTransitions ?: "" ) && synthDb.dbTransitions.len() ) ) {
						fragments[ "modernization-database" ] = synthDb;
						errors.append( {
							role: "modernization-database",
							message: "synthesized-database-from-schema",
							severity: "info",
							errorType: dbResponse.errorType ?: inferErrorType( dbResponse.error ?: "" ),
							providerError: left( toString( dbResponse.error ?: "" ), 240 )
						} );
					} else {
						errors.append( providerRoleError( "modernization-database", dbResponse ) );
					}
				} else if ( !validFragment( "modernization-database", dbResponse.payload ?: {} ) ) {
					errors.append( { role: "modernization-database", message: "malformed-role-output" } );
				} else {
					var redactedDb = redactPayload( dbResponse.payload ?: {} );
					if ( !redactedDb.count() && ( dbResponse.payload ?: {} ).count() ) errors.append( { role: "modernization-database", message: "redaction-failed" } );
					else {
						fragments[ "modernization-database" ] = redactedDb;
						totalOutputCharacters += isNumeric( dbResponse.outputCharacters ?: "" ) ? int( dbResponse.outputCharacters ) : len( jsonSerialize( dbResponse.payload ?: {} ) );
						if ( dbResponse.salvaged ?: false || ( isStruct( dbPromptProvenance ) && ( dbPromptProvenance.truncatedJsonSalvaged ?: false ) ) ) {
							errors.append( { role: "modernization-database", message: "salvaged-truncated-database-json", severity: "info" } );
						}
					}
				}
			}
		}

		var costExceeded = isNumeric( budgets.maxCostUsd ?: "" ) && totalCostUsd > val( budgets.maxCostUsd );
		if ( costExceeded ) errors.append( { role: "modernization", message: "cost-budget-exceeded" } );
		if ( !fragments.count() ) {
			var firstError = errors.len() ? errors[ 1 ] : {};
			var firstMessage = firstError.message ?: "no-role-output";
			if ( firstMessage == "budget-exceeded" && structKeyExists( firstError, "elapsedMs" ) ) firstMessage &= " (elapsedMs=#firstError.elapsedMs#, maxDurationMs=#firstError.maxDurationMs#)";
			return failure( firstMessage, errors );
		}
		var merged = mergeFragments( arguments.input, arguments.evidence, fragments, errors );
		appendPromptContract( merged, "modernization-database", dbPromptProvenance );
		// Failed/omitted shard paths stay as retryable gaps — do not invent
		// retain-legacy stubs that look like successful maps (RC3).
		appResult.omittedPaths = isArray( appResult.omittedPaths ?: "" ) ? appResult.omittedPaths : [];
		if ( shardCapOmissions.len() ) appResult.omittedPaths.append( shardCapOmissions, true );
		if ( ungroundedOmissions.len() ) appResult.omittedPaths.append( ungroundedOmissions, true );
		merged = ensureApplicationSourceCoverage( merged, arguments.evidence, arguments.input, notes, appResult );
		merged.metadata = isStruct( merged.metadata ?: "" ) ? merged.metadata : {};
		// Every omission a reader could care about lands in one place. Previously
		// only shard-cap omissions were counted here, so a run that dropped 52
		// paths at the context stage still reported `omitted: 0`.
		var allOmittedPaths = duplicate( shardCapOmissions );
		if ( ungroundedOmissions.len() ) allOmittedPaths.append( ungroundedOmissions, true );
		merged.metadata.applicationShards = {
			accepted: appAccepted,
			total: plannedShardTotal,
			resplit: appResult.resplitShards ?: 0,
			failed: appResult.failed ?: 0,
			omitted: ( appResult.omitted ?: 0 ) + allOmittedPaths.len(),
			outcomes: appResult.outcomes ?: [],
			omittedPaths: allOmittedPaths,
			omittedShardCap: shardCapOmissions.len(),
			omittedUngrounded: ungroundedOmissions.len()
		};
		merged.coverage = applyGenerationCoverage( merged.coverage ?: {}, merged.metadata.applicationShards );
		// Architecture and roadmap without application substance would invent
		// unmapped groupings/phases. Require at least one target, link, route, or
		// sample before running either.
		var hasApplicationFragment = fragments.keyExists( "modernization-application" );
		var hasApplicationSubstance = hasApplicationFragment && applicationFragmentHasSubstance( merged );
		if ( hasApplicationFragment && !hasApplicationSubstance ) {
			errors.append( { role: "modernization-application", message: "empty-application-fragment" } );
		}
		if ( !hasApplicationFragment || !hasApplicationSubstance ) {
			var skipMessage = hasApplicationFragment ? "skipped-without-application-substance" : "skipped-without-application-fragment";
			errors.append( { role: "modernization-architecture", message: skipMessage } );
			errors.append( { role: "modernization-roadmap", message: skipMessage } );
		} else {
			// Architecture pass first: a whole-repository view of units, links,
			// routes, and signals so it can group features into packaging
			// decisions the 2-file application shards never see. Its output
			// (target.contexts/.extracts) is then available to the roadmap role
			// below via compactRoadmapEvidence, so the road can follow those
			// groupings into phases instead of one catch-all phase.
			var canAffordArchitecture = !isNumeric( budgets.maxCostUsd ?: "" ) || totalCostUsd < val( budgets.maxCostUsd );
			if ( isCancelled( arguments.runId, arguments.options ) ) {
				errors.append( { role: "modernization-architecture", message: "cancelled-after-partial-acceptance" } );
			} else if ( maxTasks < 3 || getTickCount() - startedAt >= maxDurationMs || totalOutputCharacters >= totalOutputLimit ) {
				errors.append( { role: "modernization-architecture", message: "budget-exceeded" } );
			} else if ( !canAffordArchitecture ) {
				errors.append( { role: "modernization-architecture", message: "cost-budget-exceeded" } );
			} else {
				logInfo( "Modernize proposal #arguments.runId#: starting architecture role" );
				// merged already carries .signals through from mergeFragments().
				var architectureRequest = agentFactory.build( "modernization-architecture", runtime, merged, budgets );
				var architectureOptions = copyGatewayOptions( arguments.options );
				architectureOptions.budgets = budgets;
				architectureOptions.startedAt = getTickCount();
				architectureOptions.maxDurationMs = max( 5000, maxDurationMs - ( getTickCount() - startedAt ) );
				// One retry (not zero) so a truncated-JSON response gets one chance at
				// AgentGateway's shrink-and-retry mitigation instead of failing outright;
				// the gateway's own time-budget check still bails cleanly if there's no
				// time left for it.
				architectureOptions.maxRetries = 1;
				architectureOptions.role = "modernization-architecture";
				var architecture = agentGateway.run( arguments.runId, architectureRequest, architectureOptions );
				appendPromptContract( merged, "modernization-architecture", structKeyExists( architecture, "promptProvenance" ) ? architecture.promptProvenance : {} );
				totalCostUsd += isNumeric( architecture.costUsd ?: "" ) ? val( architecture.costUsd ) : 0;
				if ( architecture.ok ?: false && validFragment( "modernization-architecture", architecture.payload ?: {} ) ) {
					var redactedArchitecture = redactPayload( architecture.payload ?: {} );
					if ( !redactedArchitecture.count() && ( architecture.payload ?: {} ).count() ) errors.append( { role: "modernization-architecture", message: "redaction-failed" } );
					else merged = mergeArchitecture( merged, redactedArchitecture, errors );
				} else errors.append( providerRoleError( "modernization-architecture", architecture ) );
			}
			// Packaging must exist before roadmap sharding. When the architecture
			// role times out or exceeds schema limits, synthesize path-based
			// placements now so roadmap phases follow ColdBox module / worker seams
			// instead of one catch-all road.
			if ( applicationFragmentHasSubstance( merged ) && derivedStructureService.architectureDecisionsMissing( merged ) ) {
				merged = derivedStructureService.applySynthesizedArchitecture( merged, arguments.evidence, notes );
			}

			var canAffordRoadmap = !isNumeric( budgets.maxCostUsd ?: "" ) || totalCostUsd < val( budgets.maxCostUsd );
			if ( isCancelled( arguments.runId, arguments.options ) ) {
				errors.append( { role: "modernization-roadmap", message: "cancelled-after-partial-acceptance" } );
			} else if ( maxTasks < 3 || getTickCount() - startedAt >= maxDurationMs || totalOutputCharacters >= totalOutputLimit ) {
				errors.append( { role: "modernization-roadmap", message: "budget-exceeded" } );
			} else if ( !canAffordRoadmap ) {
				errors.append( { role: "modernization-roadmap", message: "cost-budget-exceeded" } );
			} else {
				logInfo( "Modernize proposal #arguments.runId#: starting roadmap role" );
				// The roadmap role used to be one whole-plan call, which reliably
				// truncated on any real project (many target units / architecture
				// groups all described in one JSON response under the same
				// token cap as every other role). It is now sharded the same way
				// modernization-application already is: one small, bounded call
				// per architecture group (or per unit batch when no groups exist
				// yet), dispatched concurrently, then reconciled back into a
				// single ordered roadmap.
				var roadmapShards = buildRoadmapShards( merged, budgets );
				if ( !roadmapShards.len() ) {
					errors.append( { role: "modernization-roadmap", message: "no-roadmap-groups", severity: "info" } );
				} else {
					var roadmapResult = runRoadmapShards(
						arguments.runId,
						roadmapShards,
						runtime,
						budgets,
						startedAt,
						maxDurationMs,
						totalOutputLimit,
						totalCostUsd,
						arguments.options
					);
					totalCostUsd += roadmapResult.costUsd;
					totalOutputCharacters += roadmapResult.outputCharacters;
					splitProposalMessages( roadmapResult.errors, errors, notes );
					if ( roadmapResult.accepted > 0 ) merged = mergeRoadmap( merged, roadmapResult, samplePolicy, errors );
					merged.metadata = isStruct( merged.metadata ?: "" ) ? merged.metadata : {};
					merged.metadata.roadmapShards = {
						accepted: roadmapResult.accepted,
						total: roadmapShards.len(),
						failed: roadmapResult.failed,
						omitted: roadmapResult.omitted,
						outcomes: roadmapResult.outcomes
					};
					logInfo( "Modernize proposal #arguments.runId#: roadmap shards accepted #roadmapResult.accepted#/#roadmapShards.len()#" );
				}
			}
		}
		merged = polishPlan( merged, samplePolicy, errors );
		// Architecture packaging must exist before synthesized roadmap groups,
		// otherwise the road collapses to one generic strangler phase.
		if ( applicationFragmentHasSubstance( merged ) && derivedStructureService.architectureDecisionsMissing( merged ) ) {
			merged = derivedStructureService.applySynthesizedArchitecture( merged, arguments.evidence, notes );
			merged = polishPlan( merged, samplePolicy, errors );
		}
		if ( applicationFragmentHasSubstance( merged ) && ( !isArray( merged.roadmapPhases ?: "" ) || !merged.roadmapPhases.len() ) ) {
			merged = derivedStructureService.applySynthesizedRoadmap( merged, notes );
			merged = polishPlan( merged, samplePolicy, errors );
		}
		merged.metadata.provider = agentGateway.isEnabled() ? "enabled" : "disabled";
		merged.metadata.promptVersion = agentFactory.version();
		merged.metadata.sourceRevision = arguments.input.sourceRevision ?: "";
		merged.metadata.sourceFingerprint = arguments.input.sourceFingerprint ?: "";
		merged.metadata.inventoryFingerprint = isStruct( arguments.evidence.inventory ?: "" ) ? ( arguments.evidence.inventory.fingerprint ?: "" ) : "";
		merged.metadata.contextFingerprint = isStruct( arguments.evidence.context ?: "" ) ? ( arguments.evidence.context.fingerprint ?: "" ) : "";
		merged.metadata.schemaFingerprint = isStruct( arguments.evidence.schemaEvidence ?: "" )
			? ( arguments.evidence.schemaEvidence.fingerprint ?: arguments.evidence.schemaEvidence.contentHash ?: "" )
			: "";
		merged.metadata.model = appResult.model ?: "";
		merged.metadata.providerId = appResult.provider ?: "";
		merged.metadata.promptContracts = isArray( merged.metadata.promptContracts ?: "" ) ? merged.metadata.promptContracts : [];
		for ( var applicationContract in collectPromptContracts( appResult.outcomes ?: [] ) ) {
			if ( !merged.metadata.promptContracts.some( ( existing ) => existing.key == applicationContract.key ) ) merged.metadata.promptContracts.append( applicationContract );
		}
		merged = annotateProvenance( merged );
		var finalErrors = [];
		var finalNotes = duplicate( notes );
		splitProposalMessages( errors, finalErrors, finalNotes );
		merged.generationErrors = finalErrors;
		merged.generationNotes = finalNotes;
		merged.generationSummary = buildGenerationSummary( merged, fragments, finalErrors, appResult, runId );
		var partial = finalErrors.len() > 0;
		logInfo( "Modernize proposal #arguments.runId#: complete partial=#partial#, errors=#finalErrors.len()#, notes=#finalNotes.len()#, targets=#( isStruct( merged.target ?: '' ) && isArray( merged.target.units ?: '' ) ? merged.target.units.len() : 0 )#, phases=#( isArray( merged.roadmapPhases ?: '' ) ? merged.roadmapPhases.len() : 0 )#" );
		return { ok: true, plan: sortPlan( merged ), partial: partial, errors: finalErrors, notes: finalNotes };
	}

	private struct function ensureApplicationSourceCoverage(
		required struct plan,
		required struct evidence,
		required struct input,
		array notes = [],
		struct appResult = {}
	) {
		var inventory = isStruct( arguments.evidence.inventory ?: "" ) ? arguments.evidence.inventory : {};
		var files = isArray( inventory.files ?: "" ) ? inventory.files : [];
		var inventoryUnits = isArray( inventory.units ?: "" ) ? inventory.units : [];
		if ( !files.len() && inventoryUnits.len() ) {
			var fallbackFiles = {};
			for ( var inventoryUnit in inventoryUnits ) {
				var inventoryPath = normalizeEvidencePath( inventoryUnit.filePath ?: "" );
				if ( len( inventoryPath ) ) fallbackFiles[ inventoryPath ] = { filePath: inventoryPath, lineCount: val( inventoryUnit.endLine ?: 1 ) };
			}
			files = fallbackFiles.keyArray().map( ( item ) => fallbackFiles[ item ] );
		}
		if ( !files.len() ) return arguments.plan;
		arguments.plan.target = isStruct( arguments.plan.target ?: "" ) ? arguments.plan.target : { units: [], contexts: [], extracts: [] };
		arguments.plan.target.units = isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [];
		arguments.plan.unitLinks = isArray( arguments.plan.unitLinks ?: "" ) ? arguments.plan.unitLinks : [];
		var gapPaths = failedOrOmittedShardPaths( arguments.appResult );
		var covered = {};
		for ( var target in arguments.plan.target.units ) {
			var path = normalizeEvidencePath( target.sourcePath ?: target.sourceFile ?: target.legacyPath ?: "" );
			if ( len( path ) ) covered[ path ] = true;
		}
		for ( var link in arguments.plan.unitLinks ) {
			var path = normalizeEvidencePath( link.sourcePath ?: link.sourceFile ?: link.filePath ?: "" );
			if ( len( path ) ) covered[ path ] = true;
		}
		var addedPaths = [];
		var retainedGapPaths = [];
		for ( var file in files ) {
			if ( !isStruct( file ) ) continue;
			var sourcePath = normalizeEvidencePath( file.filePath ?: file.path ?: "" );
			if ( !len( sourcePath ) || covered.keyExists( sourcePath ) || !isLikelyApplicationSource( sourcePath ) ) continue;
			// Empty/timeout/budget-omitted shards remain failed gaps for continue/resume.
			if ( gapPaths.keyExists( lCase( sourcePath ) ) ) {
				retainedGapPaths.append( sourcePath );
				continue;
			}
			var unitsForPath = inventoryUnits.filter( ( item ) => isStruct( item ) && normalizeEvidencePath( item.filePath ?: "" ) == sourcePath );
			var representative = unitsForPath.len() ? unitsForPath[ 1 ] : {};
			var layer = fallbackLayerForSource( sourcePath, representative );
			var target = {
				id: "coverage-" & left( hash( sourcePath, "SHA-256" ), 20 ),
				sourcePath: sourcePath,
				layer: layer,
				purpose: "Coverage fallback for a source path whose LLM shard did not produce a usable mapping",
				legacyUnitIds: unitsForPath.map( ( item ) => item.id ?: "" ).filter( ( item ) => len( trim( item ) ) ),
				evidenceRefs: isArray( representative.evidenceRefs ?: "" )
					? duplicate( representative.evidenceRefs )
					: [ { filePath: sourcePath, startLine: 1, endLine: max( 1, val( file.lineCount ?: 1 ) ), extractionMethod: "inventory-coverage-fallback" } ],
				confidence: 0.35,
				validationStatus: "needs-review",
				provenanceClass: "deterministically-derived",
				newProposal: false
			};
			target.targetPath = deriveTargetPath(
				target,
				sourcePath,
				lCase( arguments.input.target.runtime ?: "boxlang" ),
				lCase( arguments.input.target.layoutProfile ?: "modern" )
			);
			ensureIdentity( target, "target-unit" );
			arguments.plan.target.units.append( target );
			if ( target.legacyUnitIds.len() ) {
				var link = {
					id: "coverage-link-" & left( hash( sourcePath, "SHA-256" ), 20 ),
					legacyUnitId: target.legacyUnitIds[ 1 ],
					sourcePath: sourcePath,
					targetUnitId: target.id,
					relation: "retain-legacy",
					notes: "LLM shard fallback; verify the target concern before implementation",
					evidenceRefs: duplicate( target.evidenceRefs ),
					confidence: 0.35,
					validationStatus: "needs-review",
					provenanceClass: "deterministically-derived"
				};
				ensureIdentity( link, "unit-link" );
				arguments.plan.unitLinks.append( link );
			}
			covered[ sourcePath ] = true;
			addedPaths.append( sourcePath );
		}
		if ( addedPaths.len() ) {
			arguments.plan.target.units = normalizeTargetUnits( arguments.plan.target.units, arguments.input );
			arguments.notes.append( {
				role: "modernization-application",
				message: "inventory-coverage-fallback",
				severity: "info",
				count: addedPaths.len(),
				paths: addedPaths
			} );
		}
		if ( retainedGapPaths.len() ) {
			arguments.notes.append( {
				role: "modernization-application",
				message: "failed-shard-gaps-retained",
				severity: "info",
				count: retainedGapPaths.len(),
				paths: retainedGapPaths
			} );
		}
		return arguments.plan;
	}

	/** Paths belonging to failed or omitted application shards — retryable gaps, not stubs. */
	private struct function failedOrOmittedShardPaths( required struct appResult ) {
		var gapPaths = {};
		for ( var outcome in ( isArray( arguments.appResult.outcomes ?: "" ) ? arguments.appResult.outcomes : [] ) ) {
			if ( ![ "failed", "omitted" ].contains( outcome.status ?: "" ) ) continue;
			for ( var path in ( isArray( outcome.paths ?: "" ) ? outcome.paths : [] ) ) {
				var normalized = lCase( normalizeEvidencePath( path ) );
				if ( len( normalized ) ) gapPaths[ normalized ] = true;
			}
		}
		for ( var omittedPath in ( isArray( arguments.appResult.omittedPaths ?: "" ) ? arguments.appResult.omittedPaths : [] ) ) {
			var normalizedOmitted = lCase( normalizeEvidencePath( omittedPath ) );
			if ( len( normalizedOmitted ) ) gapPaths[ normalizedOmitted ] = true;
		}
		return gapPaths;
	}

	private string function fallbackLayerForSource( required string sourcePath, required struct unit ) {
		var path = lCase( replace( arguments.sourcePath, "\", "/", "all" ) );
		if ( reFindNoCase( "(^|/)Application\.(?:cfc|bx)$", path ) ) return "config";
		if ( find( "/handlers/", "/" & path ) ) return "handler";
		if ( find( "/models/", "/" & path ) || find( "/components/", "/" & path ) ) return "service";
		if ( find( "/views/", "/" & path ) || find( "/layouts/", "/" & path ) || listLast( path, "." ) == "cfm" || listLast( path, "." ) == "bxm" ) return "view";
		var observed = lCase( trim( scalarString( arguments.unit.layer ?: arguments.unit.unitType ?: "" ) ) );
		return observed == "page" ? "view" : "service";
	}

	void function cancelRun( required string runId ) {
		variables.cancelledRuns[ arguments.runId ] = true;
		agentGateway.cancelRun( arguments.runId );
	}

	/**
	 * Carries an optional per-run model override (immutable input, set from
	 * ModernizationPolicyService.normalize()) into the gateway options struct so
	 * every copied gateway-options struct below inherits it without
	 * threading a new parameter through each role.
	 */
	private void function applyModelOverride( required struct input, required struct options ) {
		if ( structKeyExists( arguments.options, "model" ) && len( trim( arguments.options.model ?: "" ) ) ) return;
		if ( !structKeyExists( arguments.input, "execution" ) || !isStruct( arguments.input.execution ) ) return;
		var overrideModel = trim( arguments.input.execution.model ?: "" );
		if ( len( overrideModel ) ) arguments.options.model = overrideModel;
	}

	/**
	 * Copies only gateway-supported option keys. Callback closures are retained
	 * by reference so BoxLang never attempts to recursively duplicate their
	 * captured worker/executor state during live runs.
	 */
	private struct function copyGatewayOptions( struct options = {} ) {
		var output = {};
		var keys = [
			"allowedEvidenceIds", "allowedFactIds", "allowedFilePaths", "budgets",
			"isCancelled", "maxDurationMs", "maxRetries", "model", "onObservation",
			"role", "startedAt", "useSkillAgent"
		];
		for ( var key in keys ) {
			if ( !structKeyExists( arguments.options, key ) ) continue;
			var value = arguments.options[ key ];
			output[ key ] = isStruct( value ) || isArray( value ) ? duplicate( value ) : value;
		}
		return output;
	}

	/**
	 * Apply one bounded, fingerprint-scoped repair response.  The pipeline owns
	 * the validation loop and decides whether another round is allowed; this
	 * method deliberately cannot add items or replace an unlisted fingerprint.
	 */
	struct function repair(
		required string runId,
		required struct plan,
		required struct validation,
		required struct input,
		required struct evidence,
		numeric round = 1,
		struct options = {}
	) {
		applyModelOverride( arguments.input, arguments.options );
		var repairBudgets = structKeyExists( arguments.input, "budgets" ) && isStruct( arguments.input.budgets ) ? arguments.input.budgets : {};
		var repairBudget = structKeyExists( repairBudgets, "maxRepairRounds" ) ? repairBudgets.maxRepairRounds : ( structKeyExists( repairBudgets, "maxIterations" ) ? repairBudgets.maxIterations : 2 );
		var roundLimit = isNumeric( repairBudget ) ? max( 1, min( 2, int( repairBudget ) ) ) : 2;
		if ( arguments.round < 1 || arguments.round > roundLimit ) return { ok: false, repaired: false, reason: "repair-budget-exhausted", plan: arguments.plan };
		var invalidItemList = invalidItems( arguments.plan, arguments.validation );
		if ( !invalidItemList.len() ) return { ok: true, repaired: false, reason: "no-invalid-items", plan: arguments.plan };
		var runtime = { runtime: arguments.input.target.runtime ?: arguments.input.runtime ?: "", profile: arguments.input.target.layoutProfile ?: arguments.input.profile ?: "" };
		var repairEvidence = {
			invalidItems: invalidItemList,
			validation: arguments.validation,
			inventory: arguments.evidence.inventory ?: {},
			context: arguments.evidence.context ?: {},
			schemaEvidence: arguments.evidence.schemaEvidence ?: {}
		};
		var repairRequest = agentFactory.build( "modernization-repair", runtime, repairEvidence, repairBudgets );
		var repairOptions = copyGatewayOptions( arguments.options );
		repairOptions.budgets = repairBudgets;
		repairOptions.role = "modernization-repair";
		repairOptions.maxRetries = 0;
		if ( !structKeyExists( repairOptions, "maxDurationMs" ) && isNumeric( repairOptions.budgets.maxDurationMs ?: "" ) ) repairOptions.maxDurationMs = int( repairOptions.budgets.maxDurationMs );
		var response = agentGateway.run( arguments.runId, repairRequest, repairOptions );
		if ( !( response.ok ?: false ) || !isStruct( response.payload ?: {} ) || !isArray( response.payload.replacements ?: "" ) ) return { ok: false, repaired: false, reason: response.error ?: "malformed-repair-output", plan: arguments.plan };
		var repaired = duplicate( arguments.plan );
		var replaced = 0;
		for ( var replacement in response.payload.replacements ) {
			if ( !isStruct( replacement ) || !len( trim( replacement.itemFingerprint ?: "" ) ) ) continue;
			var fp = trim( replacement.itemFingerprint );
			for ( var collection in [ "target.units", "target.contexts", "target.extracts", "unitLinks", "dbFindings", "dbTransitions", "routeContracts", "roadmapPhases", "samples" ] ) {
				var parts = collection.listToArray( "." );
				var owner = parts.len() == 2 ? ( repaired[ parts[ 1 ] ] ?: {} ) : repaired;
				var key = parts[ parts.len() ];
				if ( !isStruct( owner ) || !isArray( owner[ key ] ?: "" ) ) continue;
				for ( var index = 1; index <= owner[ key ].len(); index++ ) {
					if ( trim( owner[ key ][ index ].itemFingerprint ?: "" ) == fp && invalidItemList.some( ( item ) => item.itemFingerprint == fp ) ) {
						var replacementCopy = isStruct( replacement.item ?: "" )
							? duplicate( replacement.item )
							: duplicate( replacement );
						structDelete( replacementCopy, "id" );
						structDelete( replacementCopy, "itemId" );
						structDelete( replacementCopy, "itemFingerprint" );
						owner[ key ][ index ] = structAppend( duplicate( owner[ key ][ index ] ), replacementCopy, true );
						owner[ key ][ index ].itemFingerprint = fp;
						replaced++;
					}
				}
			}
		}
		if ( replaced > 0 ) {
			repaired.metadata = isStruct( repaired.metadata ?: "" )
				? repaired.metadata
				: { runtime: arguments.input.target ?: {} };
			repaired.target = isStruct( repaired.target ?: "" ) ? repaired.target : { units: [], contexts: [], extracts: [] };
			repaired.target.units = normalizeTargetUnits(
				isArray( repaired.target.units ?: "" ) ? repaired.target.units : [],
				arguments.input
			);
			repaired = polishPlan( repaired, arguments.input.samplePolicy ?: {}, [] );
			repaired = annotateProvenance( repaired );
		}
		return { ok: true, repaired: replaced > 0, replaced: replaced, plan: repaired, round: arguments.round };
	}

	private struct function mergeFragments(required struct input, required struct evidence, required struct fragments, required array errors) {
		var plan = {
			version      : "modernization-plan-v1",
			schemaVersion: "modernization-plan-v1",
			metadata     : { runId: structKeyExists( arguments.input, "runId" ) ? arguments.input.runId : "", generatedAt: now(), runtime: arguments.input.target ?: {}, targetProfile: ( isStruct( arguments.input.target ?: "" ) && structKeyExists( arguments.input.target, "layoutProfile" ) ? arguments.input.target.layoutProfile : ( structKeyExists( arguments.input, "targetProfile" ) ? arguments.input.targetProfile : "" ) ), samplePolicy: arguments.input.samplePolicy ?: { currentPhasesOnly: true } },
			coverage     : evidence.coverage ?: {},
			assumptions  : [],
			inventory    : evidence.inventory ?: { units: [], routeEvidence: [], dependencies: [], unresolved: [] },
			schemaEvidence: evidence.schemaEvidence ?: { database: {}, objects: [], routines: [], unresolved: [] },
			signals      : evidence.signals ?: [],
			target       : { units: [], placements: [], contexts: [], extracts: [] },
			unitLinks    : [], dbFindings: [], dbTransitions: [], routeContracts: [], roadmapPhases: [], samples: [],
			validation   : {}, decisions: []
		};
		var app = fragments[ "modernization-application" ] ?: {};
		var db = fragments[ "modernization-database" ] ?: {};
		plan.target.units = normalizeTargetUnits( boundedStructArray( app.targetUnits ?: app.units ?: [], variables.maxItems, arguments.errors, "target.units" ), arguments.input );
		var leakedArchitectureFields = [];
		if ( isArray( app.contexts ?: "" ) && app.contexts.len() ) leakedArchitectureFields.append( "contexts" );
		if ( isArray( app.extracts ?: "" ) && app.extracts.len() ) leakedArchitectureFields.append( "extracts" );
		if ( leakedArchitectureFields.len() ) arguments.errors.append( {
			role: "modernization-application",
			message: "dropped-nonempty-application-architecture-fields",
			severity: "info",
			fields: leakedArchitectureFields,
			note: "Application shards do not own packaging decisions; architecture-role values were discarded before merge."
		} );
		// Packaging decisions belong exclusively to the architecture role. The
		// application role's schema asks for empty arrays, but models sometimes
		// echo thin context/extract objects anyway; seeding them here would make
		// mergeArchitecture() append duplicate ids later.
		plan.target.contexts = [];
		plan.target.extracts = [];
		plan.unitLinks = boundedStructArray( app.unitLinks ?: [], variables.maxItems, arguments.errors, "unitLinks" );
		plan.routeContracts = boundedStructArray( app.routeContracts ?: [], variables.maxItems, arguments.errors, "routeContracts" );
		plan.dbFindings = boundedStructArray( db.dbFindings ?: [], variables.maxItems, arguments.errors, "dbFindings" );
		plan.dbTransitions = boundedStructArray( db.dbTransitions ?: [], variables.maxItems, arguments.errors, "dbTransitions" );
		plan.samples = boundedStructArray( app.samples ?: [], 40, arguments.errors, "application.samples" );
		plan.samples.append( boundedStructArray( db.samples ?: [], 20, arguments.errors, "database.samples" ), true );
		for ( var item in plan.target.units ) ensureIdentity( item, "target-unit" );
		for ( var item in plan.unitLinks ) ensureIdentity( item, "unit-link" );
		for ( var item in plan.routeContracts ) ensureIdentity( item, "route-contract" );
		for ( var item in plan.dbFindings ) ensureIdentity( item, "db-finding" );
		for ( var item in plan.dbTransitions ) ensureIdentity( item, "db-transition" );
		for ( var item in plan.roadmapPhases ) ensureIdentity( item, "roadmap-phase" );
		for ( var item in plan.samples ) ensureIdentity( item, "sample" );
		if ( isArray( db.dbFindings ?: "" ) && db.dbFindings.len() ) {
			var dbProvenance = lCase( trim( db.dbFindings[ 1 ].provenanceClass ?: "" ) );
			plan.metadata.databaseSource = dbProvenance == "deterministically-derived" ? "synthesized" : "provider";
		}
		return plan;
	}

	/** Providers often echo a legacy source filename as targetPath. Keep the
	 * source identity, but derive a legal ColdBox target path before validation
	 * or persistence so the UI never presents source files as target structure. */
	private array function normalizeTargetUnits( required array units, required struct input ) {
		var target = isStruct( arguments.input.target ?: "" ) ? arguments.input.target : {};
		var runtime = lCase( trim( scalarString( target.runtime ?: arguments.input.targetRuntime ?: "boxlang" ) ) );
		var profile = lCase( trim( scalarString( target.layoutProfile ?: arguments.input.targetProfile ?: "modern" ) ) );
		var output = [];
		for ( var unit in arguments.units ) {
			if ( !isStruct( unit ) ) continue;
			var copy = duplicate( unit );
			// Shard merges sometimes leave path-like fields as arrays (multi-file
			// units). Coerce before trim() — a raw Array crashes packaging.
			var sourcePath = trim( scalarString( copy.sourcePath ?: "" ) );
			if ( !len( sourcePath ) ) sourcePath = trim( scalarString( copy.sourceFile ?: "" ) );
			if ( !len( sourcePath ) ) sourcePath = trim( scalarString( copy.legacyPath ?: "" ) );
			if ( !len( sourcePath ) ) sourcePath = trim( scalarString( copy.filePath ?: "" ) );
			if ( !len( sourcePath ) ) {
				var idHint = trim( scalarString( copy.id ?: "" ) );
				if ( find( "/", idHint ) || reFindNoCase( "\.(cfm|cfc|bx|bxm|js)$", idHint ) ) sourcePath = idHint;
			}
			sourcePath = replace( sourcePath, "\", "/", "all" );
			var rawSourceMarker = trim( scalarString( copy.sourcePath ?: "" ) );
			if ( reFindNoCase( "\(new\)|new proposal|new-proposal", sourcePath ) || reFindNoCase( "\(new\)", rawSourceMarker ) ) {
				sourcePath = reReplaceNoCase( sourcePath, "\s*\(new\)\s*", "", "all" );
				copy.newProposal = true;
				if ( !len( trim( scalarString( copy.proposalReason ?: "" ) ) ) ) copy.proposalReason = "Provider marked this target as a new scaffold without a legacy source file";
			}
			if ( len( sourcePath ) ) copy.sourcePath = sourcePath;
			var candidate = trim( scalarString( copy.targetPath ?: "" ) );
			if ( !len( candidate ) ) candidate = trim( scalarString( copy.pathHint ?: "" ) );
			var sourceIsApplication = reFindNoCase( "(^|/)Application[.](?:cfc|bx)$", sourcePath ) > 0;
			if ( sourceIsApplication ) {
				var applicationLayer = lCase( trim( scalarString( copy.layer ?: copy.kind ?: copy.proposedRole ?: "config" ) ) );
				var parentName = !find( "/", sourcePath )
					? "Root"
					: listGetAt( sourcePath, max( 1, listLen( sourcePath, "/" ) - 1 ), "/" );
				parentName = reReplace( parentName, "[^A-Za-z0-9]", "", "all" );
				if ( !len( parentName ) ) parentName = "Nested";
				var classExtension = runtime == "boxlang" ? ".bx" : ".cfc";
				if ( !find( "/", sourcePath ) && [ "config", "application", "bootstrap", "" ].contains( applicationLayer ) ) {
					candidate = "Application" & classExtension;
				} else if ( applicationLayer == "interceptor" ) {
					candidate = "app/interceptors/#parentName#ApplicationLifecycle#classExtension#";
				} else if ( [ "service", "model" ].contains( applicationLayer ) ) {
					candidate = "app/models/services/#parentName#ApplicationLifecycleService#classExtension#";
				} else {
					candidate = "app/config/#parentName#ApplicationLifecycle#classExtension#";
				}
				if ( find( "/", sourcePath ) ) {
					copy.proposalReason = "Nested Application lifecycle must be decomposed into ColdBox config, interceptor, and service concerns; verify this placeholder mapping";
					copy.validationStatus = "needs-review";
				}
			}
			candidate = normalizeLayerExtension( candidate, copy, runtime );
			if ( !legalModernTargetPath( candidate, runtime, profile ) || !targetPathMatchesLayer( candidate, copy ) ) copy.targetPath = deriveTargetPath( copy, sourcePath, runtime, profile );
			else copy.targetPath = candidate;
			copy.targetPath = normalizeLayerExtension( copy.targetPath, copy, runtime );
			var evidenceRef = trim( scalarString( copy.evidenceRef ?: "" ) );
			if ( len( evidenceRef ) && !structKeyExists( copy, "evidenceRefs" ) && evidenceRef != "new-proposal" ) copy.evidenceRefs = [ { filePath: copy.sourcePath ?: sourcePath, extractionMethod: "provider-reference" } ];
			if ( !len( trim( scalarString( copy.sourcePath ?: "" ) ) ) && !( copy.newProposal ?: false ) && !( copy.explicitProposal ?: false ) && !len( trim( scalarString( copy.proposalReason ?: "" ) ) ) ) {
				copy.newProposal = true;
				copy.proposalReason = "Provider proposed a scaffold target without a legacy source path";
			}
			ensureIdentity( copy, "target-unit" );
			output.append( copy );
		}
		return ensureUniqueTargetPaths( output, runtime, profile );
	}

	private string function normalizeLayerExtension( required string path, required struct unit, required string runtime ) {
		if ( !len( trim( arguments.path ) ) ) return arguments.path;
		var layer = lCase( trim( scalarString( arguments.unit.layer ?: arguments.unit.kind ?: arguments.unit.proposedRole ?: "" ) ) );
		var isView = [ "view", "layout" ].contains( layer ) || findNoCase( "/views/", "/" & arguments.path ) || findNoCase( "/layouts/", "/" & arguments.path );
		var extension = arguments.runtime == "boxlang"
			? ( isView ? ".bxm" : ".bx" )
			: ( isView ? ".cfm" : ".cfc" );
		return reFindNoCase( "\.(?:cfc|cfm|cfml|bx|bxm)$", arguments.path )
			? reReplaceNoCase( arguments.path, "\.(?:cfc|cfm|cfml|bx|bxm)$", extension )
			: arguments.path & extension;
	}

	/**
	 * Shards cannot coordinate filenames. Resolve cross-shard collisions from
	 * source identity after all fragments are merged, while retaining every
	 * target id so unit-link and roadmap references remain stable.
	 */
	private array function ensureUniqueTargetPaths( required array units, required string runtime, required string profile ) {
		var groups = {};
		for ( var unit in arguments.units ) {
			var key = lCase( replace( trim( scalarString( unit.targetPath ?: "" ) ), "\", "/", "all" ) );
			if ( !groups.keyExists( key ) ) groups[ key ] = [];
			groups[ key ].append( unit );
		}
		var used = {};
		for ( var key in groups.keyArray().sort( "textnocase" ) ) {
			if ( groups[ key ].len() != 1 && len( key ) ) continue;
			if ( len( key ) ) used[ key ] = true;
		}
		for ( var key in groups.keyArray().sort( "textnocase" ) ) {
			var members = groups[ key ];
			if ( members.len() == 1 && len( key ) ) continue;
			for ( var unit in members ) {
				var candidate = contextualCollisionPath( unit, arguments.runtime, arguments.profile );
				var normalized = lCase( replace( candidate, "\", "/", "all" ) );
				var suffix = 2;
				while ( used.keyExists( normalized ) ) {
					candidate = appendPathSuffix( contextualCollisionPath( unit, arguments.runtime, arguments.profile ), suffix );
					normalized = lCase( replace( candidate, "\", "/", "all" ) );
					suffix++;
				}
				unit.targetPath = candidate;
				unit.validationStatus = "needs-review";
				used[ normalized ] = true;
			}
		}
		return arguments.units;
	}

	private string function contextualCollisionPath( required struct unit, required string runtime, required string profile ) {
		var sourcePath = replace( trim( scalarString( arguments.unit.sourcePath ?: "" ) ), "\", "/", "all" );
		var sourceName = len( sourcePath ) ? listLast( sourcePath, "/" ) : "ModernizedUnit";
		var stem = reReplaceNoCase( sourceName, "\.(?:cfc|cfm|cfml|bx|bxm|js)$", "" );
		var layer = lCase( trim( scalarString( arguments.unit.layer ?: arguments.unit.kind ?: arguments.unit.proposedRole ?: "" ) ) );
		if ( lCase( stem ) == "index" ) {
			stem = find( "/", sourcePath )
				? listGetAt( sourcePath, max( 1, listLen( sourcePath, "/" ) - 1 ), "/" )
				: "Main";
		}
		stem = reReplace( stem, "[^A-Za-z0-9]", "", "all" );
		if ( !len( stem ) ) stem = "ModernizedUnit";
		if ( reFindNoCase( "\.(?:cfm|bxm)$", sourceName ) && [ "service", "model" ].contains( layer ) ) stem &= "PageService";
		var current = replace( trim( scalarString( arguments.unit.targetPath ?: "" ) ), "\", "/", "all" );
		var directory = reFind( "/", current ) ? reReplace( current, "[^/]+$", "" ) : "";
		var extension = arguments.runtime == "boxlang"
			? ( [ "view", "layout" ].contains( layer ) ? ".bxm" : ".bx" )
			: ( [ "view", "layout" ].contains( layer ) ? ".cfm" : ".cfc" );
		return directory & stem & extension;
	}

	private string function appendPathSuffix( required string path, required numeric suffix ) {
		return reReplace( arguments.path, "(\.[^.]+)$", "#arguments.suffix#\1" );
	}

	private boolean function legalModernTargetPath( required string path, required string runtime, required string profile ) {
		if ( !len( trim( arguments.path ) ) || find( "..", arguments.path ) || reFind( "^(?:[A-Za-z]:|/|\\\\)", arguments.path ) ) return false;
		var extension = lCase( listLast( arguments.path, "." ) );
		var normalized = lCase( replace( arguments.path, "\", "/", "all" ) );
		var applicationName = arguments.runtime == "boxlang" ? "application.bx" : "application.cfc";
		if ( normalized == applicationName ) return true;
		if ( arguments.profile == "flat" && !reFind( "^(?:handlers|models|views|layouts)/", normalized ) ) return false;
		if ( arguments.profile != "flat" && !reFind( "^app/", normalized ) ) return false;
		return arguments.runtime == "boxlang" ? [ "bx", "bxm" ].contains( extension ) : ( arguments.runtime == "lucee" ? [ "cfc", "cfm" ].contains( extension ) : true );
	}

	private boolean function targetPathMatchesLayer( required string path, required struct unit ) {
		var normalized = lCase( replace( arguments.path, "\", "/", "all" ) );
		var layer = lCase( trim( scalarString( arguments.unit.layer ?: arguments.unit.kind ?: "" ) ) );
		if ( !len( layer ) ) return true;
		if ( layer == "service" || layer == "model" ) return find( "/models/", "/" & normalized ) > 0;
		if ( layer == "handler" || layer == "page" ) return find( "/handlers/", "/" & normalized ) > 0;
		if ( layer == "view" || layer == "layout" ) return find( "/views/", "/" & normalized ) > 0 || find( "/layouts/", "/" & normalized ) > 0;
		if ( layer == "config" ) return find( "/config/", "/" & normalized ) > 0 || listLast( normalized, "/" ) == "application.bx";
		if ( layer == "test" ) return find( "tests/specs/", normalized ) == 1;
		return true;
	}

	private string function deriveTargetPath( required struct unit, required string sourcePath, required string runtime, required string profile ) {
		var extension = arguments.runtime == "boxlang" ? ".bx" : ".cfc";
		var sourceName = len( trim( arguments.sourcePath ) ) ? listLast( replace( arguments.sourcePath, "\", "/", "all" ), "/" ) : "ModernizedUnit";
		var stem = sourceName;
		for ( var legacyExt in [ ".cfc", ".cfm", ".bxm", ".bx", ".js" ] ) {
			if ( right( lCase( stem ), len( legacyExt ) ) == legacyExt ) {
				stem = left( stem, len( stem ) - len( legacyExt ) );
				break;
			}
		}
		stem = reReplace( stem, "[^A-Za-z0-9_-]", "-", "all" );
		if ( !len( trim( stem ) ) ) stem = "ModernizedUnit";
		var role = lCase( trim( scalarString( arguments.unit.layer ?: arguments.unit.kind ?: arguments.unit.proposedRole ?: arguments.unit.category ?: "" ) ) );
		var root = arguments.profile == "flat" ? "" : "app/";
		if ( findNoCase( "application", role ) || findNoCase( "bootstrap", role ) ) return "Application" & extension;
		if ( role == "config" ) return root & "config/" & stem & extension;
		if ( role == "interceptor" ) return root & "interceptors/" & stem & extension;
		if ( role == "test" ) return "tests/specs/unit/" & stem & "Spec" & extension;
		if ( findNoCase( "service", role ) || findNoCase( "component", role ) || findNoCase( "model", role ) ) return root & "models/services/" & stem & extension;
		if ( findNoCase( "view", role ) || findNoCase( "layout", role ) ) return root & "views/" & stem & extension;
		return root & "handlers/" & stem & extension;
	}

	private struct function mergeRoadmap(required struct plan, required struct roadmap, struct samplePolicy = {}, array errors = []) {
		arguments.plan.roadmapPhases = boundedStructArray( arguments.roadmap.roadmapPhases ?: arguments.roadmap.phases ?: [], 40, arguments.errors, "roadmapPhases" );
		for ( var phase in arguments.plan.roadmapPhases ) ensureIdentity( phase, "roadmap-phase" );
		arguments.plan.assumptions.append( boundedArray( arguments.roadmap.assumptions ?: [], 40 ), true );
		arguments.plan.samples.append( boundedStructArray( arguments.roadmap.samples ?: [], 20, arguments.errors, "roadmap.samples" ), true );
		for ( var sample in arguments.plan.samples ) ensureIdentity( sample, "sample" );
		arguments.plan.metadata = isStruct( arguments.plan.metadata ?: "" ) ? arguments.plan.metadata : {};
		arguments.plan.metadata.roadmapSource = "provider";
		return arguments.plan;
	}

	/**
	 * Partitions the merged plan into small roadmap-generation jobs so no
	 * single call has to describe the whole plan (the failure mode that made
	 * the roadmap role truncate on any real project). Prefers one shard per
	 * architecture group (mirrors the deterministic derivedStructureService.synthesizeGroupedPhases()
	 * grouping, just producing shard descriptors instead of finished phases);
	 * falls back to plain unit batches when architecture didn't run/produce
	 * groups.
	 */
	private array function buildRoadmapShards( required struct plan, struct budgets = {} ) {
		var batchSize = isNumeric( arguments.budgets.roadmapUnitBatchSize ?: "" )
			? max( 4, min( 60, int( arguments.budgets.roadmapUnitBatchSize ) ) )
			: variables.defaultRoadmapUnitBatchSize;
		var shardCap = isNumeric( arguments.budgets.maxRoadmapShards ?: "" )
			? max( 1, min( variables.maxRoadmapShards, int( arguments.budgets.maxRoadmapShards ) ) )
			: variables.maxRoadmapShards;
		var units = isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [];
		if ( !units.len() ) return [];

		var groups = derivedStructureService.synthesisRoadmapGroups( arguments.plan );
		var shardGroups = [];
		var covered = {};
		if ( groups.len() ) {
			var groupBatch = min( batchSize, 24 );
			for ( var group in groups ) {
				if ( shardGroups.len() >= shardCap ) break;
				var groupIds = [];
				for ( var unitId in ( group.targetUnitIds ?: [] ) ) {
					var id = trim( toString( unitId ) );
					if ( len( id ) && !covered.keyExists( id ) ) { groupIds.append( id ); covered[ id ] = true; }
				}
				if ( !groupIds.len() ) continue;
				for ( var groupOffset = 1; groupOffset <= groupIds.len() && shardGroups.len() < shardCap; groupOffset += groupBatch ) {
					var batchIds = [];
					for ( var groupIndex = groupOffset; groupIndex <= min( groupIds.len(), groupOffset + groupBatch - 1 ); groupIndex++ ) {
						batchIds.append( groupIds[ groupIndex ] );
					}
					if ( batchIds.len() ) {
						shardGroups.append( {
							name: groupOffset == 1 ? ( group.name ?: "Slice" ) : "#( group.name ?: 'Slice' )# (#int( ( groupOffset - 1 ) / groupBatch ) + 1#)",
							targetUnitIds: batchIds,
							kind: group.kind ?: "context"
						} );
					}
				}
			}
			var leftover = [];
			for ( var unit in units ) {
				var id = trim( toString( unit.id ?: unit.itemId ?: "" ) );
				if ( len( id ) && !covered.keyExists( id ) ) leftover.append( id );
			}
			// Architecture placements are still being gap-filled by directory after
			// propose() returns, so at this point a large share of units can be
			// unclaimed even though the finished plan groups them cleanly. Batching
			// those sequentially produced "Continue strangler slices (3)" phases
			// holding half the plan. Group them by the same feature-directory signal
			// the later gap-fill uses so the phase names carry domain meaning.
			// Cap each batch so roleInstruction / evidence stay inside the provider
			// prompt budget: one leftover megashard is what blew immutableCharacters
			// past 60k previously.
			var leftoverBatch = min( batchSize, 24 );
			for ( var leftoverGroup in derivedStructureService.leftoverRoadmapGroups( units, leftover ) ) {
				var groupLeftoverIds = leftoverGroup.targetUnitIds;
				for ( var leftoverOffset = 1; leftoverOffset <= groupLeftoverIds.len() && shardGroups.len() < shardCap; leftoverOffset += leftoverBatch ) {
					var leftoverIds = [];
					for ( var leftoverIndex = leftoverOffset; leftoverIndex <= min( groupLeftoverIds.len(), leftoverOffset + leftoverBatch - 1 ); leftoverIndex++ ) {
						leftoverIds.append( groupLeftoverIds[ leftoverIndex ] );
					}
					if ( !leftoverIds.len() ) continue;
					shardGroups.append( {
						name: leftoverOffset == 1
							? leftoverGroup.name
							: "#leftoverGroup.name# (#int( ( leftoverOffset - 1 ) / leftoverBatch ) + 1#)",
						targetUnitIds: leftoverIds,
						kind: "leftover"
					} );
				}
				if ( shardGroups.len() >= shardCap ) break;
			}
		} else {
			for ( var offset = 1; offset <= units.len(); offset += batchSize ) {
				if ( shardGroups.len() >= shardCap ) break;
				var batchIds = [];
				for ( var i = offset; i <= min( units.len(), offset + batchSize - 1 ); i++ ) {
					var unitId = trim( toString( units[ i ].id ?: units[ i ].itemId ?: "" ) );
					if ( len( unitId ) ) batchIds.append( unitId );
				}
				if ( batchIds.len() ) shardGroups.append( { name: "Slice #shardGroups.len() + 1#", targetUnitIds: batchIds, kind: "unit-batch" } );
			}
		}
		if ( !shardGroups.len() ) return [];
		var shards = [];
		for ( var index = 1; index <= shardGroups.len(); index++ ) {
			shards.append( evidenceForRoadmapShard( arguments.plan, shardGroups[ index ], index, shardGroups.len() ) );
		}
		return shards;
	}

	/**
	 * Coupling signals for one roadmap shard, aggregated per signalId.
	 *
	 * Resolves the shard's target units to their legacy inventory unit ids and
	 * source paths (same resolution ModernizationSliceRebuildService uses), then
	 * selects signals bound to those units by the range join, with a filePath
	 * fallback for newProposal targets and plans built before the join existed.
	 *
	 * Aggregates rather than passing per-hit records: signals arrive sorted
	 * alphabetically by signalId, so any "first N" truncation downstream would
	 * yield a single-signal monoculture and the model would confidently name the
	 * wrong hard part. One record per signalId is bounded by construction.
	 */
	private array function signalsForRoadmapShard(
		required struct plan,
		required array scopedUnits,
		numeric maxGroups = 12,
		numeric maxFilesPerGroup = 3
	) {
		var signals = isArray( arguments.plan.signals ?: "" ) ? arguments.plan.signals : [];
		if ( !signals.len() || !arguments.scopedUnits.len() ) return [];
		var legacyIdSet = {};
		var pathSet = {};
		for ( var unit in arguments.scopedUnits ) {
			if ( !isStruct( unit ) ) continue;
			for ( var legacyId in ( isArray( unit.legacyUnitIds ?: "" ) ? unit.legacyUnitIds : [] ) ) {
				var legacyKey = trim( toString( legacyId ) );
				if ( len( legacyKey ) ) legacyIdSet[ legacyKey ] = true;
			}
			for ( var sourcePath in listToArray( unit.sourcePath ?: "", ",", true, true ) ) {
				var normalizedPath = lCase( normalizeLegacyPath( sourcePath ) );
				if ( len( normalizedPath ) ) pathSet[ normalizedPath ] = true;
			}
		}
		if ( !legacyIdSet.count() && !pathSet.count() ) return [];
		var buckets = {};
		var order = [];
		for ( var signal in signals ) {
			if ( !isStruct( signal ) ) continue;
			var inScope = false;
			for ( var unitId in ( isArray( signal.unitIds ?: "" ) ? signal.unitIds : [] ) ) {
				if ( legacyIdSet.keyExists( trim( toString( unitId ) ) ) ) { inScope = true; break; }
			}
			var refs = signal.evidenceRefs ?: [];
			var ref = isArray( refs ) && refs.len() && isStruct( refs[ 1 ] ) ? refs[ 1 ] : {};
			var filePath = trim( toString( ref.filePath ?: "" ) );
			if ( !inScope && len( filePath ) && pathSet.keyExists( lCase( normalizeLegacyPath( filePath ) ) ) ) inScope = true;
			if ( !inScope ) continue;
			var signalId = trim( signal.signalId ?: "" );
			if ( !len( signalId ) ) continue;
			if ( !buckets.keyExists( signalId ) ) {
				buckets[ signalId ] = { signalId: signalId, group: signal.group ?: "", meaning: signal.meaning ?: "", count: 0, files: [] };
				order.append( signalId );
			}
			buckets[ signalId ].count = buckets[ signalId ].count + 1;
			if ( len( filePath ) && buckets[ signalId ].files.len() < arguments.maxFilesPerGroup ) {
				var label = filePath & ":" & val( ref.startLine ?: 0 );
				if ( !buckets[ signalId ].files.contains( label ) ) buckets[ signalId ].files.append( label );
			}
		}
		var output = order.map( ( item ) => buckets[ item ] );
		output.sort( ( a, b ) => a.count != b.count ? b.count - a.count : compareNoCase( a.signalId, b.signalId ) );
		return output.len() > arguments.maxGroups ? output.slice( 1, arguments.maxGroups ) : output;
	}

	/** Scopes plan evidence down to one roadmap shard's target-unit group, mirroring evidenceForShard()'s file-scoping for application shards. */
	/**
	 * Searchable blob of the legacy/target paths a set of units covers, used to
	 * tie a schema object to the slice that reads or writes it.
	 */
	private string function pathHaystackForUnits( required array units ) {
		var words = [];
		for ( var unit in arguments.units ) {
			if ( !isStruct( unit ) ) continue;
			words.append( lCase( toString( unit.sourcePath ?: "" ) ) );
			words.append( lCase( toString( unit.targetPath ?: "" ) ) );
		}
		return reReplace( words.toList( " " ), "[^a-z0-9]+", " ", "all" );
	}

	/** Whole-token match of a schema object name inside a path haystack. */
	private boolean function objectMatchesHaystack( required any objectName, required string haystack ) {
		if ( !isSimpleValue( arguments.objectName ) ) return false;
		var needle = lCase( reReplace( toString( arguments.objectName ), "[^A-Za-z0-9]+", "", "all" ) );
		// Two-character object names match far too much to be evidence.
		if ( len( needle ) < 3 ) return false;
		return reFindNoCase( "(^|[^a-z0-9])" & needle & "([^a-z0-9]|$)", arguments.haystack ) > 0;
	}

	/** Every schema object a db finding or transition names. */
	private array function objectNamesForDbItem( required struct item ) {
		var objects = [];
		if ( len( trim( toString( arguments.item.objectRef ?: "" ) ) ) ) objects.append( toString( arguments.item.objectRef ) );
		for ( var touched in ( isArray( arguments.item.objectsTouched ?: "" ) ? arguments.item.objectsTouched : [] ) ) {
			if ( isSimpleValue( touched ) && len( trim( toString( touched ) ) ) ) objects.append( toString( touched ) );
		}
		return objects;
	}

	private struct function evidenceForRoadmapShard( required struct plan, required struct group, required numeric index, required numeric total ) {
		var idSet = {};
		for ( var id in ( arguments.group.targetUnitIds ?: [] ) ) idSet[ trim( toString( id ) ) ] = true;
		var units = isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [];
		var scopedUnits = [];
		for ( var unit in units ) if ( idSet.keyExists( trim( toString( unit.id ?: unit.itemId ?: "" ) ) ) ) scopedUnits.append( unit );
		var links = [];
		for ( var link in ( isArray( arguments.plan.unitLinks ?: "" ) ? arguments.plan.unitLinks : [] ) ) {
			if ( idSet.keyExists( trim( toString( link.targetUnitId ?: "" ) ) ) ) links.append( link );
		}
		var routes = [];
		for ( var route in ( isArray( arguments.plan.routeContracts ?: "" ) ? arguments.plan.routeContracts : [] ) ) {
			if ( idSet.keyExists( trim( toString( route.targetUnitId ?: "" ) ) ) ) routes.append( route );
		}
		// The roadmap role is asked to cite dbFindingIds/transitionIds, so it has to
		// be shown them. Relation ids alone selected nothing: providers name the
		// field relatedTargetIds as often as relatedTargetUnitIds and frequently
		// leave both empty, so every shard used to receive an empty ledger and
		// every phase came back with no database work attached.
		var shardHaystack = pathHaystackForUnits( scopedUnits );
		var findings = [];
		var findingIds = {};
		for ( var finding in ( isArray( arguments.plan.dbFindings ?: "" ) ? arguments.plan.dbFindings : [] ) ) {
			if ( !isStruct( finding ) ) continue;
			var relatedIds = [];
			for ( var relatedField in [ "relatedTargetUnitIds", "relatedTargetIds", "relatedLegacyIds" ] ) {
				if ( isArray( finding[ relatedField ] ?: "" ) ) relatedIds.append( finding[ relatedField ], true );
			}
			var matches = false;
			for ( var relatedId in relatedIds ) if ( idSet.keyExists( trim( toString( relatedId ) ) ) ) { matches = true; break; }
			if ( !matches ) {
				for ( var objectName in objectNamesForDbItem( finding ) ) {
					if ( objectMatchesHaystack( objectName, shardHaystack ) ) { matches = true; break; }
				}
			}
			if ( matches ) { findings.append( finding ); findingIds[ trim( toString( finding.id ?: finding.itemId ?: "" ) ) ] = true; }
		}
		var transitions = [];
		for ( var transition in ( isArray( arguments.plan.dbTransitions ?: "" ) ? arguments.plan.dbTransitions : [] ) ) {
			if ( !isStruct( transition ) ) continue;
			var linked = findingIds.keyExists( trim( toString( transition.dbFindingId ?: "" ) ) );
			if ( !linked && isArray( transition.dbFindingIds ?: "" ) ) {
				for ( var relatedFindingId in transition.dbFindingIds ) if ( findingIds.keyExists( trim( toString( relatedFindingId ) ) ) ) { linked = true; break; }
			}
			if ( !linked ) {
				for ( var objectName in objectNamesForDbItem( transition ) ) {
					if ( objectMatchesHaystack( objectName, shardHaystack ) ) { linked = true; break; }
				}
			}
			if ( linked ) transitions.append( transition );
		}
		var samples = [];
		for ( var sample in ( isArray( arguments.plan.samples ?: "" ) ? arguments.plan.samples : [] ) ) {
			var relatedItemIds = isArray( sample.relatedItemIds ?: "" ) ? sample.relatedItemIds : [];
			var relates = false;
			for ( var relatedId in relatedItemIds ) if ( idSet.keyExists( trim( toString( relatedId ) ) ) ) { relates = true; break; }
			if ( relates ) samples.append( sample );
		}
		return {
			target: { units: scopedUnits, contexts: [], extracts: [] },
			unitLinks: links,
			routeContracts: routes,
			dbFindings: findings,
			dbTransitions: transitions,
			samples: samples,
			signals: signalsForRoadmapShard( arguments.plan, scopedUnits ),
			coverage: arguments.plan.coverage ?: {},
			assumptions: [],
			shardMeta: {
				index: arguments.index,
				total: arguments.total,
				kind: arguments.group.kind ?: "unit-batch",
				groupName: arguments.group.name ?: "Slice",
				targetUnitIds: arguments.group.targetUnitIds ?: []
			}
		};
	}

	/**
	 * Dispatches roadmap shards concurrently, same executor/backfill shape as
	 * runApplicationShards() but tracking accumulated phase fragments instead
	 * of merging an application-shaped payload in place. Roadmap is the last
	 * role to run, so unlike application shards it does not reserve spend for
	 * anything downstream.
	 */
	private struct function runRoadmapShards(
		required string runId,
		required array roadmapShards,
		required struct runtime,
		required struct budgets,
		required numeric startedAt,
		required numeric maxDurationMs,
		required numeric totalOutputLimit,
		required numeric spentSoFarUsd,
		struct options = {}
	) {
		var outcomes = [];
		for ( var outcomeIndex = 1; outcomeIndex <= arguments.roadmapShards.len(); outcomeIndex++ ) {
			outcomes.append( {
				shard: outcomeIndex,
				shardTotal: arguments.roadmapShards.len(),
				groupName: arguments.roadmapShards[ outcomeIndex ].shardMeta.groupName ?: "",
				status: "not-run",
				durationMs: 0,
				costUsd: 0,
				outputCharacters: 0,
				usage: {},
				promptProvenance: {},
				provenanceClass: "not-observed"
			} );
		}
		var concurrency = isNumeric( arguments.budgets.applicationShardConcurrency ?: "" )
			? max( 1, min( 12, int( arguments.budgets.applicationShardConcurrency ) ) )
			: 3;
		var maxCost = isNumeric( arguments.budgets.maxCostUsd ?: "" ) ? val( arguments.budgets.maxCostUsd ) : 0;
		var roadmapRequests = [];
		try {
			for ( var preflightIndex = 1; preflightIndex <= arguments.roadmapShards.len(); preflightIndex++ ) {
				var roadmapRequest = agentFactory.build( "modernization-roadmap", arguments.runtime, arguments.roadmapShards[ preflightIndex ], arguments.budgets );
				roadmapRequest.shardIndex = preflightIndex;
				var preflightOptions = copyGatewayOptions( arguments.options );
				preflightOptions.role = "modernization-roadmap";
				preflightOptions.budgets = duplicate( arguments.budgets );
				agentGateway.preflight( roadmapRequest, preflightOptions );
				roadmapRequests.append( roadmapRequest );
			}
		} catch ( any error ) {
			for ( var failedOutcome in outcomes ) failedOutcome.status = "omitted";
			return {
				roadmapPhases: [], assumptions: [], samples: [], accepted: 0, failed: 0,
				omitted: outcomes.len(), outcomes: outcomes,
				errors: [ {
					role: "modernization-roadmap",
					message: left( error.message ?: "modernization roadmap prompt preflight failed", 500 ),
					stage: "prompt-preflight",
					diagnostics: exceptionDiagnostics( error )
				} ],
				outputCharacters: 0, costUsd: 0, provider: "", model: ""
			};
		}

		var state = {
			phaseRecords: [],
			assumptions: [],
			samples: [],
			accepted: 0,
			errors: [],
			totalOutputCharacters: 0,
			totalCostUsd: 0,
			providerId: "",
			modelId: "",
			nextShardIndex: 1,
			dispatchCount: 0,
			pending: [],
			outcomes: outcomes,
			executorName: ensureShardExecutor( concurrency )
		};
		var shardContext = {
			runId: arguments.runId,
			roadmapShards: arguments.roadmapShards,
			roadmapRequests: roadmapRequests,
			runtime: arguments.runtime,
			budgets: arguments.budgets,
			options: arguments.options,
			startedAt: arguments.startedAt,
			maxDurationMs: arguments.maxDurationMs,
			totalOutputLimit: arguments.totalOutputLimit,
			totalShards: arguments.roadmapShards.len(),
			concurrency: concurrency,
			maxCost: maxCost,
			spentSoFarUsd: arguments.spentSoFarUsd
		};

		var primed = 0;
		while ( primed < concurrency && dispatchNextRoadmapShard( state, shardContext ) ) primed = primed + 1;

		while ( state.pending.len() ) {
			var settledIndex = 0;
			while ( !settledIndex ) {
				for ( var scanIndex = 1; scanIndex <= state.pending.len(); scanIndex++ ) {
					if ( state.pending[ scanIndex ].future.isDone() ) {
						settledIndex = scanIndex;
						break;
					}
				}
				if ( !settledIndex ) sleep( 20 );
			}
			var settled = state.pending[ settledIndex ];
			state.pending.deleteAt( settledIndex );
			recordRoadmapShardResult( state, settled, awaitShardTask( settled ) );
			dispatchNextRoadmapShard( state, shardContext );
		}

		for ( var pendingOutcome in state.outcomes ) {
			if ( pendingOutcome.status == "not-run" ) pendingOutcome.status = "omitted";
		}

		// A plan that only ever needed one shard (the common small-plan case)
		// keeps today's exact single-call behavior: no cross-shard id/dependency
		// rewriting, since there is nothing to reconcile against.
		var phases = shardContext.totalShards <= 1
			? state.phaseRecords.map( ( record ) => record.phase )
			: reconcileShardedRoadmapPhases( state.phaseRecords );

		return {
			roadmapPhases: phases,
			assumptions: state.assumptions,
			samples: state.samples,
			accepted: state.accepted,
			failed: state.outcomes.filter( ( item ) => item.status == "failed" ).len(),
			omitted: state.outcomes.filter( ( item ) => item.status == "omitted" ).len(),
			outcomes: state.outcomes,
			errors: state.errors,
			outputCharacters: state.totalOutputCharacters,
			costUsd: state.totalCostUsd,
			provider: state.providerId,
			model: state.modelId
		};
	}

	/** Dispatches the next queued roadmap shard, mirroring dispatchNextShard()'s budget/cancellation gates without a downstream-role cost reserve. */
	private boolean function dispatchNextRoadmapShard( required struct state, required struct context ) {
		if ( arguments.state.nextShardIndex > arguments.context.totalShards ) return false;
		if ( isCancelled( arguments.context.runId, arguments.context.options ) ) {
			arguments.state.errors.append( { role: "modernization-roadmap", message: "cancelled-after-partial-acceptance", shard: arguments.state.nextShardIndex } );
			return false;
		}
		var elapsedMs = getTickCount() - arguments.context.startedAt;
		var remainingMs = arguments.context.maxDurationMs - elapsedMs;
		if ( remainingMs <= 2000 ) {
			arguments.state.errors.append( { role: "modernization-roadmap", message: "budget-exceeded", shard: arguments.state.nextShardIndex, elapsedMs: elapsedMs, maxDurationMs: arguments.context.maxDurationMs } );
			return false;
		}
		if ( arguments.state.totalOutputCharacters >= arguments.context.totalOutputLimit ) {
			arguments.state.errors.append( { role: "modernization-roadmap", message: "total-output-budget-exceeded", shard: arguments.state.nextShardIndex } );
			return false;
		}
		if ( arguments.context.maxCost > 0 && ( arguments.context.spentSoFarUsd + arguments.state.totalCostUsd ) >= arguments.context.maxCost ) {
			arguments.state.errors.append( { role: "modernization-roadmap", message: "cost-budget-exceeded", shard: arguments.state.nextShardIndex } );
			return false;
		}

		var shardIndex = arguments.state.nextShardIndex;
		var shard = arguments.context.roadmapShards[ shardIndex ];
		var shareCount = arguments.state.dispatchCount < arguments.context.concurrency
			? min( arguments.context.concurrency, arguments.context.totalShards )
			: ( arguments.context.totalShards - arguments.state.dispatchCount );
		var costRemaining = arguments.context.maxCost > 0
			? max( 0, arguments.context.maxCost - arguments.context.spentSoFarUsd - arguments.state.totalCostUsd )
			: 0;
		var perShardCost = arguments.context.maxCost > 0 ? costRemaining / max( 1, shareCount ) : 0;

		var roadmapRequest = arguments.context.roadmapRequests[ shardIndex ];
		var roadmapOptions = duplicate( arguments.context.options );
		roadmapOptions.budgets = duplicate( arguments.context.budgets );
		if ( arguments.context.maxCost > 0 ) roadmapOptions.budgets.maxCostUsd = perShardCost;
		roadmapOptions.startedAt = getTickCount();
		roadmapOptions.maxDurationMs = max( 5000, remainingMs );
		roadmapOptions.maxRetries = isNumeric( arguments.context.options.maxRetries ?: "" )
			? max( 0, min( 1, int( arguments.context.options.maxRetries ) ) )
			: 1;
		roadmapOptions.role = "modernization-roadmap";

		arguments.state.pending.append( dispatchShardTask( arguments.context.runId, shardIndex, roadmapRequest, roadmapOptions, arguments.state.executorName ) );
		arguments.state.nextShardIndex = shardIndex + 1;
		arguments.state.dispatchCount = arguments.state.dispatchCount + 1;
		return true;
	}

	/** Applies one settled roadmap shard's response to the running accounting/phase-record state. */
	private void function recordRoadmapShardResult( required struct state, required struct settled, required struct response ) {
		var outcome = arguments.state.outcomes[ arguments.settled.shardIndex ];
		outcome.provider = arguments.response.provider ?: "";
		outcome.model = arguments.response.model ?: "";
		outcome.costUsd = isNumeric( arguments.response.costUsd ?: "" ) ? val( arguments.response.costUsd ) : 0;
		outcome.durationMs = isNumeric( arguments.response.durationMs ?: "" ) ? int( arguments.response.durationMs ) : 0;
		outcome.outputCharacters = isNumeric( arguments.response.outputCharacters ?: "" ) ? int( arguments.response.outputCharacters ) : 0;
		outcome.usage = isStruct( arguments.response.usage ?: "" ) ? duplicate( arguments.response.usage ) : {};
		outcome.promptProvenance = isStruct( arguments.response.promptProvenance ?: "" ) ? duplicate( arguments.response.promptProvenance ) : {};
		if ( len( outcome.provider ) ) arguments.state.providerId = outcome.provider;
		if ( len( outcome.model ) ) arguments.state.modelId = outcome.model;
		arguments.state.totalCostUsd = arguments.state.totalCostUsd + outcome.costUsd;
		if ( !( arguments.response.ok ?: false ) ) {
			outcome.status = "failed";
			outcome.reason = arguments.response.error ?: "provider-failed";
			arguments.state.errors.append( providerRoleError( "modernization-roadmap", arguments.response, arguments.settled.shardIndex ) );
			return;
		}
		if ( !validFragment( "modernization-roadmap", arguments.response.payload ?: {} ) ) {
			outcome.status = "failed";
			outcome.reason = "malformed-role-output";
			arguments.state.errors.append( { role: "modernization-roadmap", message: "malformed-role-output", shard: arguments.settled.shardIndex } );
			return;
		}
		var redacted = redactPayload( arguments.response.payload ?: {} );
		if ( !redacted.count() && ( arguments.response.payload ?: {} ).count() ) {
			outcome.status = "failed";
			outcome.reason = "redaction-failed";
			arguments.state.errors.append( { role: "modernization-roadmap", message: "redaction-failed", shard: arguments.settled.shardIndex } );
			return;
		}
		outcome.status = "accepted";
		outcome.provenanceClass = "provider-suggested";
		var phasesOut = isArray( redacted.roadmapPhases ?: "" ) ? redacted.roadmapPhases : ( isArray( redacted.phases ?: "" ) ? redacted.phases : [] );
		for ( var phase in phasesOut ) if ( isStruct( phase ) ) arguments.state.phaseRecords.append( { phase: phase, shardIndex: arguments.settled.shardIndex } );
		arguments.state.assumptions.append( boundedArray( redacted.assumptions ?: [], 40 ), true );
		arguments.state.samples.append( boundedStructArray( redacted.samples ?: [], 20, arguments.state.errors, "roadmap.samples" ), true );
		arguments.state.totalOutputCharacters = arguments.state.totalOutputCharacters +
			( isNumeric( arguments.response.outputCharacters ?: "" ) ? int( arguments.response.outputCharacters ) : len( jsonSerialize( arguments.response.payload ?: {} ) ) );
		arguments.state.accepted = arguments.state.accepted + 1;
	}

	/**
	 * Reconciles phases from independent roadmap shard calls, only invoked
	 * once more than one shard actually dispatched. Independent LLM calls
	 * cannot know about each other's output, so none of the following can be
	 * trusted across shards: ids (dedupeById() would silently drop a later
	 * item on collision), dependencies (may reference an id from a call this
	 * one never saw), or currentSlice (multiple shards may each claim it).
	 * All three are normalized deterministically here instead, mirroring how
	 * derivedStructureService.synthesizeGroupedPhases() already chains deterministic phases.
	 */
	private array function reconcileShardedRoadmapPhases( required array phaseRecords ) {
		var ordered = duplicate( arguments.phaseRecords );
		ordered.sort( ( a, b ) => a.shardIndex - b.shardIndex );
		var seenIds = {};
		var previousPhaseId = "";
		var output = [];
		var order = 0;
		for ( var record in ordered ) {
			order = order + 1;
			var phase = duplicate( record.phase );
			var rawId = trim( toString( phase.id ?: phase.itemId ?: "" ) );
			var candidate = len( rawId ) ? rawId : ( "phase-shard-" & record.shardIndex );
			var suffix = 2;
			while ( seenIds.keyExists( lCase( candidate ) ) ) {
				candidate = ( len( rawId ) ? rawId : "phase-shard-" & record.shardIndex ) & "-" & suffix;
				suffix = suffix + 1;
			}
			seenIds[ lCase( candidate ) ] = true;
			phase.id = candidate;
			structDelete( phase, "itemId" );
			phase.dependencies = len( previousPhaseId ) ? [ previousPhaseId ] : [];
			phase.currentSlice = ( order == 1 );
			previousPhaseId = candidate;
			output.append( phase );
		}
		return output;
	}

	/**
	 * Merges the whole-repository architecture role's packaging proposals into
	 * target.contexts/target.extracts. Runs before mergeRoadmap so the roadmap
	 * role can use these groupings as candidate phase boundaries (it already
	 * reads target.contexts/.extracts via compactRoadmapEvidence).
	 */
	private struct function mergeArchitecture(required struct plan, required struct architecture, array errors = []) {
		arguments.plan.target = isStruct( arguments.plan.target ?: "" ) ? arguments.plan.target : { units: [], placements: [], contexts: [], extracts: [] };
		arguments.plan.target.placements = isArray( arguments.plan.target.placements ?: "" ) ? arguments.plan.target.placements : [];
		arguments.plan.target.contexts = isArray( arguments.plan.target.contexts ?: "" ) ? arguments.plan.target.contexts : [];
		arguments.plan.target.extracts = isArray( arguments.plan.target.extracts ?: "" ) ? arguments.plan.target.extracts : [];
		arguments.plan.target.placements.append( boundedStructArray( arguments.architecture.placements ?: [], variables.maxItems, arguments.errors, "target.placements" ), true );
		arguments.plan.target.contexts.append( boundedStructArray( arguments.architecture.contexts ?: [], variables.maxItems, arguments.errors, "target.contexts" ), true );
		arguments.plan.target.extracts.append( boundedStructArray( arguments.architecture.extracts ?: [], variables.maxItems, arguments.errors, "target.extracts" ), true );
		for ( var item in arguments.plan.target.placements ) ensureIdentity( item, "placement" );
		for ( var item in arguments.plan.target.contexts ) ensureIdentity( item, "context" );
		for ( var item in arguments.plan.target.extracts ) ensureIdentity( item, "extract" );
		arguments.plan.metadata = isStruct( arguments.plan.metadata ?: "" ) ? arguments.plan.metadata : {};
		arguments.plan.metadata.architectureSource = "provider";
		return derivedStructureService.normalizeArchitecturePlacementTypes( arguments.plan );
	}

	private boolean function applicationFragmentHasSubstance( required struct plan ) {
		if ( isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) && arguments.plan.target.units.len() ) return true;
		if ( isArray( arguments.plan.unitLinks ?: "" ) && arguments.plan.unitLinks.len() ) return true;
		if ( isArray( arguments.plan.routeContracts ?: "" ) && arguments.plan.routeContracts.len() ) return true;
		if ( isArray( arguments.plan.samples ?: "" ) && arguments.plan.samples.len() ) return true;
		return false;
	}

	private struct function emptyApplicationFragment() {
		return { targetUnits: [], unitLinks: [], routeContracts: [], contexts: [], extracts: [], samples: [] };
	}

	private struct function preflightInitialRoles(
		required array appShards,
		required struct runtime,
		required struct evidence,
		required struct budgets,
		required numeric maxTasks,
		struct options = {}
	) {
		var activeRole = "modernization-application";
		var activeOperation = "build-request";
		var activeShard = 0;
		try {
			for ( var shardIndex = 1; shardIndex <= arguments.appShards.len(); shardIndex++ ) {
				activeRole = "modernization-application";
				activeShard = shardIndex;
				activeOperation = "build-request";
				var applicationRequest = agentFactory.build( "modernization-application", arguments.runtime, arguments.appShards[ shardIndex ], arguments.budgets );
				activeOperation = "copy-options";
				var requestOptions = copyGatewayOptions( arguments.options );
				requestOptions.role = "modernization-application";
				requestOptions.budgets = duplicate( arguments.budgets );
				activeOperation = "fit-package";
				agentGateway.preflight( applicationRequest, requestOptions );
			}
			if ( arguments.maxTasks >= 2 ) {
				activeRole = "modernization-database";
				activeShard = 0;
				activeOperation = "build-request";
				var databaseRequest = agentFactory.build( "modernization-database", arguments.runtime, arguments.evidence, arguments.budgets );
				activeOperation = "copy-options";
				var databaseOptions = copyGatewayOptions( arguments.options );
				databaseOptions.role = "modernization-database";
				databaseOptions.budgets = duplicate( arguments.budgets );
				activeOperation = "fit-package";
				agentGateway.preflight( databaseRequest, databaseOptions );
			}
			return { ok: true };
		} catch ( any error ) {
			var diagnostics = exceptionDiagnostics( error );
			diagnostics.operation = activeOperation;
			if ( activeShard > 0 ) diagnostics.shard = activeShard;
			return {
				ok: false,
				role: activeRole,
				message: left( error.message ?: "modernization prompt preflight failed", 500 ),
				diagnostics: diagnostics
			};
		}
	}

	private struct function exceptionDiagnostics( required any error ) {
		if ( isStruct( arguments.error.data ?: "" ) ) return duplicate( arguments.error.data );
		var detail = trim( toString( arguments.error.detail ?: "" ) );
		if ( len( detail ) && isJSON( detail ) ) {
			var parsed = jsonDeserialize( detail );
			if ( isStruct( parsed ) ) return parsed;
		}
		return {};
	}

	/**
	 * Run application shards over a bounded worker pool sized to
	 * applicationShardConcurrency. Shards are dispatched one at a time; the
	 * moment any in-flight shard finishes, the next queued shard is dispatched
	 * to fill the freed slot immediately, instead of waiting for a whole
	 * fixed-size batch to drain before starting the next one. Soft budget
	 * errors keep any shards that already succeeded.
	 */
	private struct function runApplicationShards(
		required string runId,
		required array appShards,
		required struct runtime,
		required struct budgets,
		required numeric startedAt,
		required numeric maxDurationMs,
		required numeric totalOutputLimit,
		struct options = {}
	) {
		var outcomes = [];
		for ( var outcomeIndex = 1; outcomeIndex <= arguments.appShards.len(); outcomeIndex++ ) {
			outcomes.append( {
				shard: outcomeIndex,
				shardTotal: arguments.appShards.len(),
				paths: duplicate( arguments.appShards[ outcomeIndex ].shardMeta.paths ?: [] ),
				status: "not-run",
				durationMs: 0,
				costUsd: 0,
				outputCharacters: 0,
				usage: {},
				promptProvenance: {},
				provenanceClass: "not-observed"
			} );
		}
		var concurrency = isNumeric( arguments.budgets.applicationShardConcurrency ?: "" )
			? max( 1, min( 12, int( arguments.budgets.applicationShardConcurrency ) ) )
			: 3;
		var maxCost = isNumeric( arguments.budgets.maxCostUsd ?: "" ) ? val( arguments.budgets.maxCostUsd ) : 0;
		var maxTasks = isNumeric( arguments.budgets.maxTasks ?: "" ) ? max( 1, int( arguments.budgets.maxTasks ) ) : 3;
		// Keep meaningful provider spend for database + architecture + roadmap.
		var reserveCost = laterStageReserveCost( maxCost, maxTasks );

		var state = {
			appMerged: emptyApplicationFragment(),
			appAccepted: 0,
			errors: [],
			totalOutputCharacters: 0,
			totalCostUsd: 0,
			providerId: "",
			modelId: "",
			stopReason: "",
			nextShardIndex: 1,
			dispatchCount: 0,
			pending: [],
			outcomes: outcomes,
			executorName: ensureShardExecutor( concurrency ),
			resumedPathKeys: {}
		};
		applyApplicationResume( state, arguments.options.resumeFrom ?: {} );
		var shardContext = {
			runId: arguments.runId,
			appShards: arguments.appShards,
			runtime: arguments.runtime,
			budgets: arguments.budgets,
			options: arguments.options,
			startedAt: arguments.startedAt,
			maxDurationMs: arguments.maxDurationMs,
			totalOutputLimit: arguments.totalOutputLimit,
			totalShards: arguments.appShards.len(),
			concurrency: concurrency,
			maxCost: maxCost,
			maxTasks: maxTasks,
			reserveCost: reserveCost,
			reserveMs: laterStageReserveMs( arguments.maxDurationMs, maxTasks )
		};

		var primed = 0;
		while ( primed < concurrency && dispatchNextShard( state, shardContext ) ) primed = primed + 1;

		while ( state.pending.len() ) {
			var settledIndex = 0;
			while ( !settledIndex ) {
				for ( var scanIndex = 1; scanIndex <= state.pending.len(); scanIndex++ ) {
					if ( state.pending[ scanIndex ].future.isDone() ) {
						settledIndex = scanIndex;
						break;
					}
				}
				if ( !settledIndex ) sleep( 20 );
			}
			var settled = state.pending[ settledIndex ];
			state.pending.deleteAt( settledIndex );
			recordShardResult( state, settled, awaitShardTask( settled ), shardContext );
			emitShardProgress( arguments.options, state );
			// Backfill the slot the just-settled shard freed, so a fast shard
			// immediately picks up new work instead of waiting on its
			// slower batch-mates.
			dispatchNextShard( state, shardContext );
		}

		var reportedOutcomes = [];
		for ( var pendingOutcome in state.outcomes ) {
			if ( pendingOutcome.status == "not-run" ) {
				// A re-split child that never got dispatched adds nothing beyond its
				// parent's recorded failure — the same paths are already reported
				// there, so counting it again would double-report the gap.
				if ( structKeyExists( pendingOutcome, "splitFromShard" ) ) continue;
				pendingOutcome.status = "omitted";
				pendingOutcome.reason = len( state.stopReason ) ? state.stopReason : "not-run";
			}
			reportedOutcomes.append( pendingOutcome );
		}
		return {
			fragment: state.appMerged,
			accepted: state.appAccepted,
			failed: reportedOutcomes.filter( ( item ) => item.status == "failed" ).len(),
			omitted: reportedOutcomes.filter( ( item ) => item.status == "omitted" ).len(),
			outcomes: reportedOutcomes,
			resplitShards: state.outcomes.filter( ( item ) => structKeyExists( item, "splitFromShard" ) ).len(),
			errors: state.errors,
			outputCharacters: state.totalOutputCharacters,
			costUsd: state.totalCostUsd,
			provider: state.providerId,
			model: state.modelId
		};
	}

	/**
	 * Dispatches the next queued shard, if cancellation and budget checks
	 * allow it. Returns false (without dispatching) once shards are exhausted,
	 * the run is cancelled, or a soft budget limit is reached; the caller stops
	 * priming/backfilling but still lets already-dispatched shards finish.
	 */
	private boolean function dispatchNextShard( required struct state, required struct context ) {
		while ( arguments.state.nextShardIndex <= arguments.context.totalShards ) {
			if ( isCancelled( arguments.context.runId, arguments.context.options ) ) {
				if ( arguments.state.appAccepted <= 0 && arguments.state.pending.len() == 0 ) {
					throw( type = "RunCancelled", message = "Modernization proposal cancelled" );
				}
				arguments.state.errors.append( { role: "modernization-application", message: "cancelled-after-partial-acceptance", shard: arguments.state.nextShardIndex } );
				arguments.state.stopReason = "cancelled";
				return false;
			}
			var elapsedMs = getTickCount() - arguments.context.startedAt;
			var remainingMs = arguments.context.maxDurationMs - elapsedMs;
			// Keep a meaningful slice of wall clock for database → architecture →
			// roadmap. A tight reserve while still filling the initial concurrency
			// window; once backfilling, stop application shards early enough that
			// later stages can run for real instead of synthesizing.
			var reserveMs = arguments.context.maxTasks >= 2
				? ( arguments.state.dispatchCount < arguments.context.concurrency ? 2000 : val( arguments.context.reserveMs ?: variables.minLaterStageReserveMs ) )
				: 0;
			if ( remainingMs <= reserveMs ) {
				arguments.state.errors.append( { role: "modernization-application", message: "budget-exceeded", shard: arguments.state.nextShardIndex, elapsedMs: elapsedMs, maxDurationMs: arguments.context.maxDurationMs, reservedMs: reserveMs } );
				arguments.state.stopReason = "budget-exceeded";
				return false;
			}
			if ( arguments.state.totalOutputCharacters >= arguments.context.totalOutputLimit ) {
				arguments.state.errors.append( { role: "modernization-application", message: "total-output-budget-exceeded", shard: arguments.state.nextShardIndex } );
				arguments.state.stopReason = "total-output-budget-exceeded";
				return false;
			}
			if ( arguments.context.maxCost > 0 && arguments.state.totalCostUsd >= ( arguments.context.maxCost - arguments.context.reserveCost ) ) {
				arguments.state.errors.append( { role: "modernization-application", message: "cost-reserved-for-roadmap", severity: "info", shard: arguments.state.nextShardIndex, reservedUsd: arguments.context.reserveCost, spentUsd: arguments.state.totalCostUsd, maxCostUsd: arguments.context.maxCost } );
				logInfo( "Modernize application shards stopping early to reserve cost for architecture + roadmap (spent=#arguments.state.totalCostUsd#, reserve=#arguments.context.reserveCost#, max=#arguments.context.maxCost#)" );
				arguments.state.stopReason = "cost-reserved-for-roadmap";
				return false;
			}

			var shardIndex = arguments.state.nextShardIndex;
			var shard = arguments.context.appShards[ shardIndex ];
			var pathKey = shardPathKey( shard.shardMeta.paths ?: [] );
			if ( len( pathKey ) && arguments.state.resumedPathKeys.keyExists( pathKey ) ) {
				arguments.state.outcomes[ shardIndex ].status = "accepted";
				arguments.state.outcomes[ shardIndex ].reason = "resumed-from-checkpoint";
				arguments.state.outcomes[ shardIndex ].provenanceClass = "checkpoint-resumed";
				arguments.state.nextShardIndex = shardIndex + 1;
				continue;
			}
			// While still filling the initial concurrency window, several shards
			// are dispatched back-to-back before any of them can report real
			// cost, so they share the window's budget evenly (matching the old
			// wave math). Once backfilling starts, each dispatch already knows
			// the real cost spent so far, so it can divide what is actually left
			// among the shards still queued.
			var shareCount = arguments.state.dispatchCount < arguments.context.concurrency
				? min( arguments.context.concurrency, arguments.context.totalShards )
				: ( arguments.context.totalShards - arguments.state.dispatchCount );
			var costRemaining = arguments.context.maxCost > 0 ? max( 0, arguments.context.maxCost - arguments.context.reserveCost - arguments.state.totalCostUsd ) : 0;
			var perShardCost = arguments.context.maxCost > 0 ? costRemaining / max( 1, shareCount ) : 0;

			emitProposalObservation( arguments.context.options, {
				stage: "application-shard",
				runId: arguments.context.runId,
				shard: shardIndex,
				shardTotal: arguments.context.totalShards,
				paths: shard.shardMeta.paths ?: [],
				parallel: arguments.context.concurrency > 1
			} );
			logInfo( "Modernize application shard #shardIndex#/#arguments.context.totalShards# starting (#( isArray( shard.shardMeta.paths ?: '' ) ? shard.shardMeta.paths.len() : 0 )# paths)" );
			var appRequest = agentFactory.build( "modernization-application", arguments.context.runtime, shard, arguments.context.budgets );
			appRequest.shardIndex = shardIndex;
			var appOptions = duplicate( arguments.context.options );
			appOptions.budgets = duplicate( arguments.context.budgets );
			if ( arguments.context.maxCost > 0 ) appOptions.budgets.maxCostUsd = perShardCost;
			// Per-call clock uses remaining overall budget so pipeline setup
			// time does not make every shard fail as already overdue.
			appOptions.startedAt = getTickCount();
			appOptions.maxDurationMs = max( 5000, remainingMs - reserveMs );
			// One bounded retry is the normal policy, but controlled
			// diagnostics may explicitly disable it.
			appOptions.maxRetries = isNumeric( arguments.context.options.maxRetries ?: "" )
				? max( 0, min( 1, int( arguments.context.options.maxRetries ) ) )
				: 1;
			appOptions.role = "modernization-application";

			arguments.state.pending.append( dispatchShardTask( arguments.context.runId, shardIndex, appRequest, appOptions, arguments.state.executorName ) );
			arguments.state.nextShardIndex = shardIndex + 1;
			arguments.state.dispatchCount = arguments.state.dispatchCount + 1;
			return true;
		}
		return false;
	}

	/**
	 * Re-queues a truncated shard as two smaller shards.
	 *
	 * A shard whose JSON was cut mid-object asked for more output than the model
	 * would emit in one response; retrying the same ask at the same size just
	 * truncates again. Halving the path list halves the output. One generation
	 * of splitting only, so a persistently failing shard cannot fan out.
	 * Returns true when the shard was re-queued.
	 */
	private boolean function resplitTruncatedShard( required struct state, required struct context, required numeric shardIndex ) {
		if ( arguments.shardIndex > arguments.context.appShards.len() ) return false;
		var shard = arguments.context.appShards[ arguments.shardIndex ];
		var paths = isArray( shard.shardMeta.paths ?: "" ) ? shard.shardMeta.paths : [];
		if ( paths.len() < 2 ) return false;
		if ( val( shard.shardMeta.splitGeneration ?: 0 ) >= 1 ) return false;
		if ( arguments.context.totalShards + 2 > variables.maxApplicationShards ) return false;

		var midpoint = int( paths.len() / 2 );
		var halves = [ paths.slice( 1, midpoint ), paths.slice( midpoint + 1, paths.len() - midpoint ) ];
		for ( var half in halves ) {
			if ( !half.len() ) continue;
			var childIndex = arguments.context.appShards.len() + 1;
			var child = evidenceForShard( shard, half, childIndex, childIndex );
			child.shardMeta.splitGeneration = val( shard.shardMeta.splitGeneration ?: 0 ) + 1;
			child.shardMeta.splitFromShard = arguments.shardIndex;
			arguments.context.appShards.append( child );
			arguments.state.outcomes.append( {
				shard: childIndex,
				shardTotal: childIndex,
				paths: duplicate( half ),
				status: "not-run",
				durationMs: 0,
				costUsd: 0,
				outputCharacters: 0,
				usage: {},
				promptProvenance: {},
				provenanceClass: "not-observed",
				splitFromShard: arguments.shardIndex
			} );
			arguments.context.totalShards = arguments.context.appShards.len();
		}
		logInfo( "Modernize application shard #arguments.shardIndex# truncated; re-queued as smaller shards (#paths.len()# paths split)" );
		return true;
	}

	/** Applies a settled shard's response to the running merge/accounting state. */
	private void function recordShardResult( required struct state, required struct settled, required struct appResponse, struct context = {} ) {
		var outcome = arguments.state.outcomes[ arguments.settled.shardIndex ];
		outcome.provider = arguments.appResponse.provider ?: "";
		outcome.model = arguments.appResponse.model ?: "";
		outcome.costUsd = isNumeric( arguments.appResponse.costUsd ?: "" ) ? val( arguments.appResponse.costUsd ) : 0;
		outcome.durationMs = isNumeric( arguments.appResponse.durationMs ?: "" ) ? int( arguments.appResponse.durationMs ) : 0;
		outcome.outputCharacters = isNumeric( arguments.appResponse.outputCharacters ?: "" ) ? int( arguments.appResponse.outputCharacters ) : 0;
		outcome.usage = isStruct( arguments.appResponse.usage ?: "" ) ? duplicate( arguments.appResponse.usage ) : {};
		outcome.promptProvenance = isStruct( arguments.appResponse.promptProvenance ?: "" ) ? duplicate( arguments.appResponse.promptProvenance ) : {};
		if ( len( outcome.provider ) ) arguments.state.providerId = outcome.provider;
		if ( len( outcome.model ) ) arguments.state.modelId = outcome.model;
		arguments.state.totalCostUsd = arguments.state.totalCostUsd + ( isNumeric( arguments.appResponse.costUsd ?: "" ) ? val( arguments.appResponse.costUsd ) : 0 );
		if ( !( arguments.appResponse.ok ?: false ) ) {
			outcome.status = "failed";
			outcome.reason = arguments.appResponse.error ?: "provider-failed";
			// The failure is always reported: re-queued work may still never run if
			// the wall-clock or cost reserve blocks dispatch, and silently swapping
			// a hard failure for an optimistic note would hide that.
			arguments.state.errors.append( providerRoleError( "modernization-application", arguments.appResponse, arguments.settled.shardIndex ) );
			logInfo( "Modernize application shard #arguments.settled.shardIndex# failed: #( arguments.appResponse.error ?: 'provider-failed' )#" );
			// A truncated response means the ask was too large, not that the paths
			// are unmappable. Re-queue them in smaller pieces as well.
			var failureType = arguments.appResponse.errorType ?: inferErrorType( arguments.appResponse.error ?: "" );
			if ( failureType == "truncated_json" && arguments.context.count() && resplitTruncatedShard( arguments.state, arguments.context, arguments.settled.shardIndex ) ) {
				outcome.resplit = true;
				arguments.state.errors.append( {
					role: "modernization-application",
					message: "resplit-truncated-shard",
					severity: "info",
					shard: arguments.settled.shardIndex
				} );
			}
			return;
		}
		if ( !validFragment( "modernization-application", arguments.appResponse.payload ?: {} ) ) {
			outcome.status = "failed";
			outcome.reason = "malformed-role-output";
			arguments.state.errors.append( { role: "modernization-application", message: "malformed-role-output", shard: arguments.settled.shardIndex } );
			logInfo( "Modernize application shard #arguments.settled.shardIndex# malformed-role-output" );
			return;
		}
		var redactedApp = redactPayload( arguments.appResponse.payload ?: {} );
		if ( !redactedApp.count() && ( arguments.appResponse.payload ?: {} ).count() ) {
			outcome.status = "failed";
			outcome.reason = "redaction-failed";
			arguments.state.errors.append( { role: "modernization-application", message: "redaction-failed", shard: arguments.settled.shardIndex } );
			logInfo( "Modernize application shard #arguments.settled.shardIndex# redaction-failed" );
			return;
		}
		outcome.status = "accepted";
		outcome.provenanceClass = "provider-suggested";
		arguments.state.appMerged = mergeApplicationFragments( arguments.state.appMerged, redactedApp );
		arguments.state.appAccepted = arguments.state.appAccepted + 1;
		arguments.state.totalOutputCharacters = arguments.state.totalOutputCharacters +
			( isNumeric( arguments.appResponse.outputCharacters ?: "" ) ? int( arguments.appResponse.outputCharacters ) : len( jsonSerialize( arguments.appResponse.payload ?: {} ) ) );
		logInfo( "Modernize application shard #arguments.settled.shardIndex# accepted" );
	}

	/**
	 * Gets or creates a fixed-size worker pool sized to this run's requested
	 * shard concurrency. BoxLang's "fixed" executor queues submissions beyond
	 * maxThreads and runs the next one the moment a thread frees, which is
	 * exactly the dequeue behavior shard scheduling needs.
	 */
	private string function ensureShardExecutor( required numeric concurrency ) {
		var executorName = "modernization-shard-" & arguments.concurrency;
		try {
			executorGet( executorName );
		} catch ( any missingExecutor ) {
			try {
				executorNew(
					type       = "fixed",
					name       = executorName,
					maxThreads = arguments.concurrency
				);
			} catch ( any concurrentCreation ) {
				executorGet( executorName );
			}
		}
		return executorName;
	}

	/**
	 * Submits one shard to the pool and returns immediately with its future.
	 * Args are rebound into a fresh function frame so the async closure does
	 * not share a mutable outer-scope reference (classic async capture bug).
	 */
	private struct function dispatchShardTask(
		required string runId,
		required numeric shardIndex,
		required struct request,
		required struct options,
		required string executorName
	) {
		var rid = arguments.runId;
		var req = duplicate( arguments.request );
		var opts = copyGatewayOptions( arguments.options );
		var gw = agentGateway;
		var future = asyncRun( () => gw.run( rid, req, opts ), arguments.executorName )
			.orTimeout( opts.maxDurationMs, "milliseconds" );
		return { shardIndex: arguments.shardIndex, future: future, startedAt: getTickCount() };
	}

	/** Resolves one shard's future, converting a thrown/timed-out future into a normal failed response. */
	private struct function awaitShardTask( required struct item ) {
		try {
			return arguments.item.future.get();
		} catch ( any error ) {
			var rawMessage = trim( toString( error.message ?: "" ) );
			var elapsedMs = getTickCount() - arguments.item.startedAt;
			var isTimeout = findNoCase( "timeout", rawMessage ) > 0 || findNoCase( "timed out", rawMessage ) > 0 ||
				findNoCase( "DeadlineExceeded", toString( error.type ?: "" ) ) > 0;
			logInfo( "Modernize application shard #arguments.item.shardIndex# #( isTimeout ? 'timed out' : 'errored' )# after #elapsedMs# ms: #rawMessage#" );
			return { ok: false, error: len( rawMessage ) ? rawMessage : "provider-failed" };
		}
	}

	private struct function mergeApplicationFragments( required struct base, required struct next ) {
		var merged = duplicate( arguments.base );
		for ( var key in [ "targetUnits", "unitLinks", "routeContracts", "contexts", "extracts", "samples" ] ) {
			if ( !isArray( merged[ key ] ?: "" ) ) merged[ key ] = [];
			if ( isArray( arguments.next[ key ] ?: "" ) ) merged[ key ].append( arguments.next[ key ], true );
			else if ( key == "targetUnits" && isArray( arguments.next.units ?: "" ) ) merged[ key ].append( arguments.next.units, true );
		}
		merged.targetUnits = dedupeById( merged.targetUnits );
		merged.unitLinks = dedupeById( merged.unitLinks );
		merged.routeContracts = dedupeById( merged.routeContracts );
		merged.contexts = dedupeById( merged.contexts );
		merged.extracts = dedupeById( merged.extracts );
		merged.samples = dedupeById( merged.samples );
		return merged;
	}

	/**
	 * Partition inventory into foundation-first file batches so each agent sees
	 * a small, completeable mapping job instead of the whole tree. Prefers fewer,
	 * larger shards under wall-clock pressure so later stages retain budget.
	 */
	private array function buildApplicationShards( required struct evidence, struct budgets = {} ) {
		var shardSize = isNumeric( arguments.budgets.applicationShardSize ?: "" ) ? max( 2, min( 20, int( arguments.budgets.applicationShardSize ) ) ) : variables.defaultShardSize;
		var paths = prioritizedLegacyPaths( arguments.evidence );
		// Only map what the model can actually read. Ungrounded paths fall out
		// here and surface as omitted coverage in propose(), which is honest and
		// retryable via the continue endpoint — far better than a confident
		// mapping invented from a filename.
		var grounded = groundedPathSet( arguments.evidence );
		if ( grounded.count() ) {
			paths = paths.filter( ( item ) => grounded.keyExists( lCase( normalizeLegacyPath( item ) ) ) );
		}
		var shardCap = applicationShardCap( arguments.evidence, arguments.budgets, paths.len(), shardSize );
		// Full-estate runs: raise files-per-shard (up to 12) so the ceiling covers
		// more inventory with fewer LLM calls.
		var scopePaths = isArray( arguments.evidence.scopePaths ?: "" )
			? arguments.evidence.scopePaths
			: ( isStruct( arguments.evidence.input ?: "" ) && isArray( arguments.evidence.input.scopePaths ?: "" ) ? arguments.evidence.input.scopePaths : [] );
		if ( !scopePaths.len() && paths.len() > shardCap * shardSize ) {
			shardSize = min( 12, max( shardSize, ceiling( paths.len() / max( 1, shardCap ) ) ) );
		}
		// Cap planned shards by affordable wall-clock after later-stage reserve so
		// application mapping cannot consume the entire duration budget.
		var affordableCap = affordableApplicationShardCap( arguments.budgets );
		if ( affordableCap > 0 && shardCap > affordableCap ) {
			shardCap = affordableCap;
			if ( paths.len() > shardCap * shardSize ) {
				shardSize = min( 12, max( shardSize, ceiling( paths.len() / max( 1, shardCap ) ) ) );
			}
		}
		if ( !paths.len() ) {
			var single = duplicate( arguments.evidence );
			single.shardMeta = { index: 1, total: 1, paths: [], foundation: true };
			return [ single ];
		}
		var chunks = [];
		for ( var offset = 1; offset <= paths.len(); offset += shardSize ) {
			var slice = [];
			for ( var i = offset; i <= min( paths.len(), offset + shardSize - 1 ); i++ ) {
				slice.append( paths[ i ] );
			}
			chunks.append( slice );
			if ( chunks.len() >= shardCap ) break;
		}
		var shards = [];
		for ( var chunkIndex = 1; chunkIndex <= chunks.len(); chunkIndex++ ) {
			shards.append( evidenceForShard( arguments.evidence, chunks[ chunkIndex ], chunkIndex, chunks.len() ) );
		}
		return shards;
	}

	/**
	 * How many application shards can finish before the later-stage wall-clock
	 * reserve must be held. Returns 0 when duration is unbounded / unknown so
	 * callers keep the inventory-driven cap.
	 */
	private numeric function affordableApplicationShardCap( required struct budgets ) {
		var maxDurationMs = isNumeric( arguments.budgets.maxDurationMs ?: "" ) ? int( arguments.budgets.maxDurationMs ) : 0;
		if ( maxDurationMs <= 0 ) return 0;
		var maxTasks = isNumeric( arguments.budgets.maxTasks ?: "" ) ? max( 1, int( arguments.budgets.maxTasks ) ) : 3;
		var concurrency = isNumeric( arguments.budgets.applicationShardConcurrency ?: "" )
			? max( 1, min( 12, int( arguments.budgets.applicationShardConcurrency ) ) )
			: 3;
		var reserveMs = laterStageReserveMs( maxDurationMs, maxTasks );
		var availableMs = max( 60000, maxDurationMs - reserveMs );
		var waves = max( 1, int( availableMs / max( 1, variables.estimatedShardWallMs ) ) );
		return max( concurrency, waves * concurrency );
	}

	/** Wall-clock reserved for database (+ architecture + roadmap when enabled). */
	private numeric function laterStageReserveMs( required numeric maxDurationMs, required numeric maxTasks ) {
		if ( arguments.maxTasks < 2 ) return 0;
		var laterStages = arguments.maxTasks >= 3 ? 3 : 1;
		var desired = variables.minLaterStageReserveMs * laterStages;
		var proportional = int( arguments.maxDurationMs * ( arguments.maxTasks >= 3 ? 0.30 : 0.15 ) );
		return max( variables.minLaterStageReserveMs, min( variables.maxLaterStageReserveMs, max( desired, proportional ) ) );
	}

	/** Cost reserved for database (+ architecture + roadmap when enabled). */
	private numeric function laterStageReserveCost( required numeric maxCost, required numeric maxTasks ) {
		if ( arguments.maxTasks < 2 || arguments.maxCost <= 0 ) return 0;
		if ( arguments.maxTasks >= 3 ) {
			if ( arguments.maxCost >= 10 ) return max( 8, min( arguments.maxCost * 0.35, 25 ) );
			return arguments.maxCost * 0.35;
		}
		if ( arguments.maxCost >= 10 ) return max( 3, min( arguments.maxCost * 0.25, 10 ) );
		return arguments.maxCost * 0.2;
	}

	/**
	 * Expand toward covering prioritized paths up to the hard ceiling. Scoped
	 * and unscoped both expand — the old unscoped 40-shard wall left full-repo
	 * runs with thousands of omittedPaths and a hollow narrative road.
	 */
	private numeric function applicationShardCap(
		required struct evidence,
		required struct budgets,
		required numeric pathCount,
		required numeric shardSize
	) {
		var requested = isNumeric( arguments.budgets.maxApplicationShards ?: "" )
			? max( 1, int( arguments.budgets.maxApplicationShards ) )
			: variables.defaultApplicationShards;
		var hardCeiling = variables.maxApplicationShards;
		requested = max( 1, min( hardCeiling, requested ) );
		if ( arguments.pathCount <= 0 ) return requested;
		var needed = max( 1, ceiling( arguments.pathCount / max( 1, arguments.shardSize ) ) );
		return min( hardCeiling, max( requested, needed ) );
	}

	/**
	 * Paths whose source text actually reached a context partition.
	 *
	 * The context pack is budget-bounded, so it can hold fewer paths than the
	 * inventory lists. Sharding straight off the inventory used to hand the
	 * application role a path with no source text behind it; the role answered
	 * from the filename and inventory metadata, producing confident but
	 * ungrounded target units. Callers use this to shard only what can be read.
	 *
	 * Returns an empty struct when no partitions exist at all (context pack not
	 * in play, e.g. unit tests) so callers fall back to every inventory path.
	 */
	private struct function groundedPathSet( required struct evidence ) {
		var grounded = {};
		var context = isStruct( arguments.evidence.context ?: "" ) ? arguments.evidence.context : {};
		var partitions = isArray( context.partitions ?: "" )
			? context.partitions
			: ( isArray( context.contexts ?: "" ) ? context.contexts : [] );
		for ( var partition in partitions ) {
			if ( !isStruct( partition ) ) continue;
			// A partition with refs but no rendered text still carries no source
			// the role can read, so it does not count as grounding.
			if ( !len( trim( toString( partition.text ?: "" ) ) ) ) continue;
			var path = normalizeLegacyPath( partition.filePath ?: partition.path ?: "" );
			if ( len( path ) ) grounded[ lCase( path ) ] = true;
		}
		return grounded;
	}

	private array function prioritizedLegacyPaths( required struct evidence ) {
		var inventory = isStruct( arguments.evidence.inventory ?: "" ) ? arguments.evidence.inventory : {};
		var scopePaths = isArray( arguments.evidence.scopePaths ?: "" )
			? arguments.evidence.scopePaths
			: ( isStruct( arguments.evidence.input ?: "" ) && isArray( arguments.evidence.input.scopePaths ?: "" ) ? arguments.evidence.input.scopePaths : [] );
		var seen = {};
		var scored = [];
		var appendPath = ( path ) => {
			var normalized = normalizeLegacyPath( path );
			if ( !len( normalized ) || seen.keyExists( lCase( normalized ) ) ) return;
			seen[ lCase( normalized ) ] = true;
			scored.append( { path: normalized, score: foundationScore( normalized, scopePaths ) } );
		};
		if ( isArray( inventory.units ?: "" ) ) {
			for ( var unit in inventory.units ) {
				if ( isStruct( unit ) ) appendPath( unit.filePath ?: unit.path ?: unit.sourcePath ?: "" );
			}
		}
		if ( isArray( inventory.files ?: "" ) ) {
			for ( var file in inventory.files ) {
				if ( isStruct( file ) ) appendPath( file.filePath ?: file.path ?: "" );
				else if ( isSimpleValue( file ) ) appendPath( file );
			}
		}
		if ( isArray( inventory.routeEvidence ?: "" ) ) {
			for ( var route in inventory.routeEvidence ) {
				if ( isStruct( route ) ) appendPath( route.filePath ?: route.path ?: "" );
			}
		}
		scored = scored.filter( ( item ) => isLikelyApplicationSource( item.path ) );
		scored.sort( ( a, b ) => {
			if ( a.score != b.score ) return b.score - a.score;
			return compareNoCase( a.path, b.path );
		} );
		return scored.map( ( item ) => item.path );
	}

	private boolean function isLikelyApplicationSource( required string path ) {
		var lower = lCase( arguments.path );
		if ( !len( lower ) ) return false;
		if ( reFindNoCase( "\.(cfc|cfm|cfml|bx|bxs|bxm)$", lower ) ) return true;
		if ( findNoCase( "application.", lower ) || findNoCase( "router.", lower ) || findNoCase( "coldbox.", lower ) ) return true;
		return false;
	}

	private numeric function foundationScore( required string path, array scopePaths = [] ) {
		var lower = lCase( arguments.path );
		var score = 0;
		if ( reFindNoCase( "(^|/|\\)application\.(cfc|bx)$", lower ) ) score += 100;
		if ( reFindNoCase( "coldbox\.(cfc|bx)$", lower ) ) score += 90;
		if ( findNoCase( "router.", lower ) || findNoCase( "/routes", lower ) ) score += 80;
		if ( findNoCase( "/config/", lower ) || findNoCase( "\config\", lower ) ) score += 70;
		if ( findNoCase( "application.", lower ) ) score += 40;
		if ( findNoCase( "index.", lower ) ) score += 20;
		if ( findNoCase( "/model", lower ) || findNoCase( "/service", lower ) || findNoCase( "/handler", lower ) || findNoCase( "/controller", lower ) ) score += 10;
		for ( var scopePath in arguments.scopePaths ) {
			var needle = lCase( reReplace( replace( trim( toString( scopePath ) ), "\", "/", "all" ), "/+$", "" ) );
			if ( !len( needle ) ) continue;
			if ( lower == needle || left( lower, len( needle ) + 1 ) == needle & "/" || find( "/" & needle & "/", "/" & lower & "/" ) ) {
				score += 200;
				break;
			}
		}
		return score;
	}

	private string function normalizeLegacyPath( required any path ) {
		return replace( replace( trim( scalarString( arguments.path ) ), "\", "/", "all" ), "//", "/", "all" );
	}

	private struct function evidenceForShard( required struct evidence, required array paths, required numeric index, required numeric total ) {
		var pathSet = {};
		for ( var path in arguments.paths ) pathSet[ lCase( path ) ] = true;
		var inventory = isStruct( arguments.evidence.inventory ?: "" ) ? duplicate( arguments.evidence.inventory ) : {};
		inventory.units = filterItemsByPath( inventory.units ?: [], pathSet );
		inventory.files = filterItemsByPath( inventory.files ?: [], pathSet );
		inventory.routeEvidence = filterItemsByPath( inventory.routeEvidence ?: [], pathSet );
		inventory.dependencies = filterItemsByPath( inventory.dependencies ?: [], pathSet );
		inventory.unresolved = filterItemsByPath( inventory.unresolved ?: [], pathSet );
		var context = isStruct( arguments.evidence.context ?: "" ) ? duplicate( arguments.evidence.context ) : {};
		if ( isArray( context.partitions ?: "" ) ) context.partitions = filterItemsByPath( context.partitions, pathSet );
		if ( isArray( context.contexts ?: "" ) ) context.contexts = filterItemsByPath( context.contexts, pathSet );
		if ( isArray( context.files ?: "" ) ) context.files = filterItemsByPath( context.files, pathSet );
		var coverage = isStruct( arguments.evidence.coverage ?: "" ) ? {
			version: arguments.evidence.coverage.version ?: "",
			schemaCoverage: arguments.evidence.coverage.schemaCoverage ?: "",
			banners: arguments.evidence.coverage.banners ?: [],
			truncated: arguments.evidence.coverage.truncated ?: false,
			cfmlFiles: arguments.evidence.coverage.cfmlFiles ?: 0
		} : {};
		return {
			inventory: inventory,
			schemaEvidence: { note: "Database role owns schema details; application shards map files only.", objects: [] },
			signals: filterSignalsByPath( arguments.evidence.signals ?: [], pathSet ),
			coverage: coverage,
			context: context,
			shardMeta: {
				index: arguments.index,
				total: arguments.total,
				paths: arguments.paths,
				foundation: arguments.index == 1
			}
		};
	}

	private array function filterItemsByPath( required array items, required struct pathSet ) {
		var output = [];
		for ( var item in arguments.items ) {
			if ( !isStruct( item ) ) {
				if ( isSimpleValue( item ) && arguments.pathSet.keyExists( lCase( normalizeLegacyPath( item ) ) ) ) output.append( item );
				continue;
			}
			var candidate = normalizeLegacyPath( item.filePath ?: item.path ?: item.sourcePath ?: item.relativePath ?: "" );
			if ( len( candidate ) && arguments.pathSet.keyExists( lCase( candidate ) ) ) output.append( item );
		}
		return output;
	}

	private array function filterSignalsByPath( required array signals, required struct pathSet ) {
		var output = [];
		for ( var signal in arguments.signals ) {
			if ( !isStruct( signal ) ) continue;
			var matched = false;
			for ( var ref in ( isArray( signal.evidenceRefs ?: "" ) ? signal.evidenceRefs : [] ) ) {
				var path = normalizeLegacyPath( isStruct( ref ) ? ( ref.filePath ?: ref.path ?: "" ) : "" );
				if ( len( path ) && arguments.pathSet.keyExists( lCase( path ) ) ) {
					matched = true;
					break;
				}
			}
			if ( matched ) output.append( signal );
		}
		return output;
	}

	private void function emitProposalObservation( required struct options, required struct observation ) {
		if ( structKeyExists( arguments.options, "onObservation" ) && isCustomFunction( arguments.options.onObservation ) ) {
			try {
				arguments.options.onObservation( duplicate( arguments.observation ) );
			} catch ( any ignored ) {}
		}
	}

	private void function splitProposalMessages( required array incoming, required array errors, required array notes ) {
		for ( var item in arguments.incoming ) {
			if ( !isStruct( item ) ) continue;
			if ( isInformationalProposalMessage( item ) ) arguments.notes.append( item );
			else arguments.errors.append( item );
		}
	}

	private boolean function isInformationalProposalMessage( required struct item ) {
		var message = lCase( trim( arguments.item.message ?: "" ) );
		var severity = lCase( trim( arguments.item.severity ?: "" ) );
		if ( severity == "info" || severity == "note" ) return true;
		if ( findNoCase( "synthesized-", message ) == 1 ) return true;
		if ( message == "cost-reserved-for-roadmap" ) return true;
		if ( message == "ignored-non-object-items" ) return true;
		return false;
	}

	private void function logInfo( required string message ) {
		try {
			if ( !isNull( variables.log ?: javacast( "null", "" ) ) ) {
				variables.log.info( arguments.message );
			}
		} catch ( any ignored ) {}
	}

	private void function appendModernizationLog( required string level, required string message ) {
		// Kept for compatibility; logInfo delegates to the injected LogBox logger.
	}

	/**
	 * Collapses one-handler-per-legacy-page into ColdBox handlers with actions.
	 *
	 * The application role is explicitly told to group related pages into
	 * coherent handler slices, and it cannot comply: each shard sees ~6 files, so
	 * pages that belong on the same handler are usually in different shards. A
	 * live run produced 84 handler files for 84 legacy pages, which is the
	 * monolith transliterated rather than a ColdBox application.
	 *
	 * Grouping is by legacy feature directory — the same seam used for placements
	 * and roadmap phases — so `admin/fileMove.cfm` and `admin/dashboard.cfm`
	 * become the `fileMove` and `dashboard` actions of `handlers/Admin.bx`.
	 *
	 * Units are annotated, never merged: ids stay stable so links, routes, phases
	 * and prior decisions keep resolving, and the page-to-action mapping stays
	 * visible instead of disappearing into a collapsed unit.
	 */
	private struct function groupHandlerUnitsIntoActions( required struct plan, array errors = [] ) {
		var target = isStruct( arguments.plan.target ?: "" ) ? arguments.plan.target : {};
		var units = isArray( target.units ?: "" ) ? target.units : [];
		if ( !units.len() ) return arguments.plan;

		var groups = {};
		for ( var unit in units ) {
			if ( !isStruct( unit ) ) continue;
			if ( lCase( trim( toString( unit.layer ?: "" ) ) ) != "handler" ) continue;
			var sourcePath = normalizeLegacyPath( unit.sourcePath ?: "" );
			if ( !find( "/", sourcePath ) ) continue;
			var domain = lCase( listFirst( sourcePath, "/" ) );
			if ( !len( domain ) ) continue;
			if ( !groups.keyExists( domain ) ) groups[ domain ] = [];
			groups[ domain ].append( unit );
		}

		var grouped = 0;
		var handlers = 0;
		// Roadmap migration steps cite target paths directly, so every rewrite has
		// to be replayed onto them. Skipping this turned a correct regrouping into
		// 74 blocking "cites a targetPath not among this phase's own units".
		var pathRemap = {};
		for ( var domain in groups ) {
			var members = groups[ domain ];
			// A single page is already its own handler; renaming it gains nothing
			// and would churn fingerprints for no structural benefit.
			if ( members.len() < 2 ) continue;
			var handlerName = handlerNameForDomain( domain );
			var seenActions = {};
			for ( var member in members ) {
				var previousPath = replace( trim( toString( member.targetPath ?: "" ) ), "\", "/", "all" );
				var action = actionNameFromTargetPath( previousPath, member.sourcePath ?: "" );
				if ( !len( action ) ) continue;
				// Two legacy pages can reduce to the same action name; keep both
				// addressable rather than silently dropping one.
				var uniqueAction = action;
				var suffix = 2;
				while ( seenActions.keyExists( lCase( uniqueAction ) ) ) {
					uniqueAction = action & suffix;
					suffix++;
				}
				seenActions[ lCase( uniqueAction ) ] = true;
				member.targetPath = "app/handlers/" & handlerName & ".bx";
				member.action = uniqueAction;
				member.handlerGrouping = {
					handler            : handlerName,
					domain             : domain,
					previousTargetPath : previousPath,
					basis              : "legacy-feature-directory"
				};
				if ( len( previousPath ) ) {
					pathRemap[ lCase( previousPath ) ] = { targetPath: member.targetPath, methodName: uniqueAction };
				}
				grouped++;
			}
			if ( seenActions.count() ) handlers++;
		}
		remapMigrationStepTargets( arguments.plan, pathRemap );
		if ( grouped ) {
			arguments.errors.append( {
				role: "modernization-application",
				message: "grouped-handler-units-into-actions",
				severity: "info",
				units: grouped,
				handlers: handlers
			} );
		}
		target.units = units;
		arguments.plan.target = target;
		return arguments.plan;
	}

	/**
	 * Normalizes migration-step references, then drops the ones nothing backs.
	 *
	 * Providers emit `legacyRef.filePath` as "/login/login.cfm" while the
	 * inventory holds "login/login.cfm", so a perfectly good reference fails the
	 * inventory gate on a leading slash alone. Normalizing first recovers those.
	 *
	 * What remains after normalization is genuinely unbacked — a live run cited
	 * `handlers/login.cfc`, a CFML path in a BoxLang plan matching no unit — and
	 * blocks the whole plan. Dropping an unbacked step is the same treatment
	 * unbacked routes already get: the proposer proposes, deterministic gates
	 * verify, and what cannot be evidenced does not ship as guidance.
	 */
	private struct function pruneUnbackedMigrationSteps( required struct plan, array errors = [] ) {
		if ( !isArray( arguments.plan.roadmapPhases ?: "" ) ) return arguments.plan;
		var target = isStruct( arguments.plan.target ?: "" ) ? arguments.plan.target : {};
		var knownTargetPaths = {};
		for ( var unit in ( isArray( target.units ?: "" ) ? target.units : [] ) ) {
			if ( !isStruct( unit ) ) continue;
			var unitPath = lCase( normalizeLegacyPath( unit.targetPath ?: "" ) );
			if ( len( unitPath ) ) knownTargetPaths[ unitPath ] = true;
		}
		var inventoryPaths = {};
		var inventory = isStruct( arguments.plan.inventory ?: "" ) ? arguments.plan.inventory : {};
		for ( var file in ( isArray( inventory.files ?: "" ) ? inventory.files : [] ) ) {
			var filePath = lCase( normalizeLegacyPath( isStruct( file ) ? ( file.filePath ?: "" ) : toString( file ) ) );
			if ( len( filePath ) ) inventoryPaths[ filePath ] = true;
		}
		if ( !knownTargetPaths.count() && !inventoryPaths.count() ) return arguments.plan;

		// Providers name a target as "handlers/Library.cfc" — no app/ prefix and the
		// source runtime's extension — which matches no unit literally but clearly
		// means the Library handler. Indexing units by bare file name lets those
		// resolve instead of being discarded as invented.
		var unitsByBaseName = {};
		for ( var indexedUnit in ( isArray( target.units ?: "" ) ? target.units : [] ) ) {
			if ( !isStruct( indexedUnit ) ) continue;
			var indexedPath = normalizeLegacyPath( indexedUnit.targetPath ?: "" );
			if ( !len( indexedPath ) ) continue;
			var baseName = lCase( listFirst( listLast( indexedPath, "/" ), "." ) );
			if ( !len( baseName ) ) continue;
			if ( !unitsByBaseName.keyExists( baseName ) ) unitsByBaseName[ baseName ] = [];
			if ( !arrayContainsNoCase( unitsByBaseName[ baseName ], indexedPath ) ) unitsByBaseName[ baseName ].append( indexedPath );
		}

		var normalized = 0;
		var dropped = 0;
		var deduped = 0;
		for ( var phase in arguments.plan.roadmapPhases ) {
			if ( !isStruct( phase ) || !isArray( phase.migrationSteps ?: "" ) ) continue;
			var kept = [];
			var seenSteps = {};
			for ( var step in phase.migrationSteps ) {
				if ( !isStruct( step ) ) continue;
				var legacyRef = isStruct( step.legacyRef ?: "" ) ? step.legacyRef : {};
				var legacyPath = normalizeLegacyPath( legacyRef.filePath ?: "" );
				// "/login/login.cfm" and "login/login.cfm" are the same file.
				var trimmedLegacy = reReplace( legacyPath, "^/+", "", "one" );
				if ( len( trimmedLegacy ) && compare( trimmedLegacy, legacyPath ) != 0 && inventoryPaths.keyExists( lCase( trimmedLegacy ) ) ) {
					step.legacyRef.filePath = trimmedLegacy;
					legacyPath = trimmedLegacy;
					normalized++;
				}
				var legacyBacked = !len( legacyPath ) || !inventoryPaths.count() || inventoryPaths.keyExists( lCase( legacyPath ) );
				var targetRef = isStruct( step.targetRef ?: "" ) ? step.targetRef : {};
				var stepTarget = reReplace( normalizeLegacyPath( targetRef.targetPath ?: "" ), "^/+", "", "one" );
				var targetBacked = !len( stepTarget ) || !knownTargetPaths.count() || knownTargetPaths.keyExists( lCase( stepTarget ) );
				if ( len( stepTarget ) && !targetBacked ) {
					// Resolve by file name, preferring a unit this phase already owns
					// so a shared name cannot pull the step into another phase.
					var wantedBase = lCase( listFirst( listLast( stepTarget, "/" ), "." ) );
					var candidates = unitsByBaseName[ wantedBase ] ?: [];
					var phaseOwned = [];
					for ( var phaseUnitId in ( isArray( phase.unitIds ?: "" ) ? phase.unitIds : [] ) ) {
						var phaseUnitPath = "";
						for ( var lookupUnit in ( isArray( target.units ?: "" ) ? target.units : [] ) ) {
							if ( trim( toString( lookupUnit.id ?: lookupUnit.itemId ?: "" ) ) == trim( toString( phaseUnitId ) ) ) {
								phaseUnitPath = normalizeLegacyPath( lookupUnit.targetPath ?: "" );
								break;
							}
						}
						if ( len( phaseUnitPath ) && arrayContainsNoCase( candidates, phaseUnitPath ) && !arrayContainsNoCase( phaseOwned, phaseUnitPath ) ) {
							phaseOwned.append( phaseUnitPath );
						}
					}
					var resolvedPath = phaseOwned.len() == 1 ? phaseOwned[ 1 ] : ( candidates.len() == 1 ? candidates[ 1 ] : "" );
					if ( len( resolvedPath ) ) {
						step.targetRef.targetPath = resolvedPath;
						step.targetRef.targetPathProvenance = "resolved-by-file-name";
						targetBacked = true;
						normalized++;
					}
				}
				if ( !legacyBacked || !targetBacked ) {
					dropped++;
					continue;
				}
				// One live phase carried 1469 steps of which 47 were distinct — a
				// single step repeated 319 times. Identical steps are noise.
				var stepKey = lCase( trim( toString( step.action ?: "" ) ) ) & "|" &
					lCase( trim( toString( ( step.legacyRef ?: {} ).filePath ?: "" ) ) ) & "|" &
					lCase( trim( toString( ( step.legacyRef ?: {} ).symbolName ?: "" ) ) ) & "|" &
					lCase( trim( toString( ( step.targetRef ?: {} ).targetPath ?: "" ) ) ) & "|" &
					lCase( trim( toString( ( step.targetRef ?: {} ).methodName ?: "" ) ) );
				if ( seenSteps.keyExists( stepKey ) ) {
					deduped++;
					continue;
				}
				seenSteps[ stepKey ] = true;
				kept.append( step );
			}
			phase.migrationSteps = kept;
		}
		if ( normalized || dropped || deduped ) {
			arguments.errors.append( {
				role: "modernization-roadmap",
				message: "pruned-unbacked-migration-steps",
				severity: "info",
				normalized: normalized,
				dropped: dropped,
				deduplicated: deduped
			} );
		}
		return arguments.plan;
	}

	/**
	 * Replays target-path rewrites onto roadmap migration steps.
	 *
	 * A step's `targetRef.targetPath` is compared against the current target
	 * paths of its phase's units, so any rewrite that does not update the steps
	 * leaves them citing files that no longer exist. Where the rewrite also
	 * produced a handler action, the step's methodName is filled in with it —
	 * "handlers/Admin.bx :: fileMove" is what the implementer actually needs.
	 */
	private void function remapMigrationStepTargets( required struct plan, required struct pathRemap ) {
		if ( !arguments.pathRemap.count() ) return;
		if ( !isArray( arguments.plan.roadmapPhases ?: "" ) ) return;
		for ( var phase in arguments.plan.roadmapPhases ) {
			if ( !isStruct( phase ) || !isArray( phase.migrationSteps ?: "" ) ) continue;
			for ( var step in phase.migrationSteps ) {
				if ( !isStruct( step ) || !isStruct( step.targetRef ?: "" ) ) continue;
				var stepPath = lCase( replace( trim( toString( step.targetRef.targetPath ?: "" ) ), "\", "/", "all" ) );
				if ( !len( stepPath ) || !arguments.pathRemap.keyExists( stepPath ) ) continue;
				var mapped = arguments.pathRemap[ stepPath ];
				step.targetRef.targetPath = mapped.targetPath;
				if ( len( trim( toString( mapped.methodName ?: "" ) ) ) ) step.targetRef.methodName = mapped.methodName;
			}
		}
	}

	/** PascalCase ColdBox handler name for a legacy feature directory. */
	private string function handlerNameForDomain( required string domain ) {
		var cleaned = reReplace( arguments.domain, "[^A-Za-z0-9]+", " ", "all" );
		var words = [];
		for ( var word in listToArray( cleaned, " " ) ) {
			var token = trim( word );
			if ( len( token ) ) words.append( uCase( left( token, 1 ) ) & right( token, len( token ) - 1 ) );
		}
		return words.len() ? words.toList( "" ) : "Main";
	}

	/** Action name for a page, taken from its proposed handler file name. */
	private string function actionNameFromTargetPath( required string targetPath, required string sourcePath ) {
		var base = listLast( arguments.targetPath, "/" );
		base = listFirst( base, "." );
		if ( !len( trim( base ) ) ) {
			base = listFirst( listLast( normalizeLegacyPath( arguments.sourcePath ), "/" ), "." );
		}
		base = reReplace( trim( base ), "[^A-Za-z0-9]+", "", "all" );
		if ( !len( base ) ) return "";
		return lCase( left( base, 1 ) ) & right( base, len( base ) - 1 );
	}

	/**
	 * Restores method-level detail the deterministic inventory already extracted.
	 *
	 * An application shard sees a bounded window of a file, so for a large CFC it
	 * routinely answers with a single placeholder symbol
	 * (`{name: "UNKNOWN", signature: "UNKNOWN"}`) and a purpose that says the
	 * details were not extracted. On a live run `cfc/services/SongServices.cfc`
	 * carried 23 parsed methods in the inventory and reached the plan as one
	 * UNKNOWN symbol with a single legacyUnitId — so a reader could not tell
	 * which behaviour moves where, or whether anything was dropped.
	 *
	 * The inventory is source-observed and already holds the names, signatures,
	 * and line ranges, so this fills the gap deterministically rather than
	 * spending another provider call on it. Provider-supplied real symbols are
	 * never overwritten.
	 */
	private struct function backfillUnitSymbolsFromInventory( required struct plan, array errors = [] ) {
		var target = isStruct( arguments.plan.target ?: "" ) ? arguments.plan.target : {};
		var units = isArray( target.units ?: "" ) ? target.units : [];
		var inventoryUnits = isStruct( arguments.plan.inventory ?: "" ) && isArray( arguments.plan.inventory.units ?: "" )
			? arguments.plan.inventory.units
			: [];
		if ( !units.len() || !inventoryUnits.len() ) return arguments.plan;

		var byPath = {};
		for ( var legacy in inventoryUnits ) {
			if ( !isStruct( legacy ) ) continue;
			var legacyPath = lCase( normalizeLegacyPath( legacy.filePath ?: "" ) );
			if ( !len( legacyPath ) ) continue;
			if ( !byPath.keyExists( legacyPath ) ) byPath[ legacyPath ] = [];
			byPath[ legacyPath ].append( legacy );
		}

		var maxSymbols = 40;
		var enriched = 0;
		var recoveredSymbols = 0;
		for ( var unit in units ) {
			if ( !isStruct( unit ) ) continue;
			var sourcePath = lCase( normalizeLegacyPath( unit.sourcePath ?: "" ) );
			if ( !len( sourcePath ) || !byPath.keyExists( sourcePath ) ) continue;
			var legacyRecords = byPath[ sourcePath ];
			if ( !legacyRecords.len() ) continue;

			// Only fill a gap: a shard that genuinely named methods keeps its answer.
			var existing = isArray( unit.symbols ?: "" ) ? unit.symbols : [];
			var hasRealSymbols = false;
			for ( var symbol in existing ) {
				var symbolName = trim( toString( isStruct( symbol ) ? ( symbol.name ?: symbol.method ?: "" ) : symbol ) );
				if ( len( symbolName ) && uCase( symbolName ) != "UNKNOWN" ) { hasRealSymbols = true; break; }
			}
			if ( hasRealSymbols ) continue;

			var rebuilt = [];
			var legacyIds = [];
			for ( var legacyRecord in legacyRecords ) {
				var name = trim( toString( legacyRecord.symbolName ?: "" ) );
				if ( len( name ) && rebuilt.len() < maxSymbols ) {
					rebuilt.append( {
						name     : name,
						signature: trim( toString( legacyRecord.signature ?: name ) ),
						startLine: val( legacyRecord.startLine ?: 0 ),
						endLine  : val( legacyRecord.endLine ?: 0 ),
						source   : "inventory"
					} );
				}
				var legacyId = trim( toString( legacyRecord.id ?: "" ) );
				if ( len( legacyId ) && legacyIds.len() < maxSymbols && !arrayContainsNoCase( legacyIds, legacyId ) ) legacyIds.append( legacyId );
			}
			if ( !rebuilt.len() ) continue;
			unit.symbols = rebuilt;
			unit.symbolsProvenance = "inventory-backfilled";
			// The count is what tells a reader whether the window truncated.
			unit.legacySymbolCount = legacyRecords.len();
			if ( legacyRecords.len() > rebuilt.len() ) unit.symbolsTruncated = true;
			var priorLegacyIds = isArray( unit.legacyUnitIds ?: "" ) ? unit.legacyUnitIds : [];
			if ( legacyIds.len() > priorLegacyIds.len() ) unit.legacyUnitIds = legacyIds;
			enriched++;
			recoveredSymbols += rebuilt.len();
		}
		if ( enriched ) {
			arguments.errors.append( {
				role: "modernization-application",
				message: "backfilled-unit-symbols-from-inventory",
				severity: "info",
				units: enriched,
				symbols: recoveredSymbols
			} );
		}
		target.units = units;
		arguments.plan.target = target;
		return arguments.plan;
	}

	/**
	 * Collapses `confidence` onto one type across every plan collection.
	 *
	 * Providers mix an enum (high/medium/low) and a 0..1 score in the same field
	 * — one run carried 105 "high" alongside 13 "0.7" — so any sort, filter, or
	 * threshold on confidence was unreliable. The enum wins because the UI and
	 * validators read it; the original number is preserved as confidenceScore.
	 */
	private struct function normalizePlanConfidence( required struct plan ) {
		var collections = [
			isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [],
			isArray( arguments.plan.unitLinks ?: "" ) ? arguments.plan.unitLinks : [],
			isArray( arguments.plan.routeContracts ?: "" ) ? arguments.plan.routeContracts : [],
			isArray( arguments.plan.dbFindings ?: "" ) ? arguments.plan.dbFindings : [],
			isArray( arguments.plan.dbTransitions ?: "" ) ? arguments.plan.dbTransitions : []
		];
		for ( var collection in collections ) {
			for ( var item in collection ) {
				if ( !isStruct( item ) || !structKeyExists( item, "confidence" ) ) continue;
				var raw = item.confidence;
				if ( !isSimpleValue( raw ) ) {
					structDelete( item, "confidence" );
					continue;
				}
				var text = trim( toString( raw ) );
				if ( !len( text ) ) {
					structDelete( item, "confidence" );
					continue;
				}
				if ( isNumeric( text ) ) {
					var score = val( text );
					// Providers sometimes answer on a 0-100 scale.
					if ( score > 1 ) score = score / 100;
					item.confidenceScore = score;
					item.confidence = score >= 0.8 ? "high" : ( score >= 0.5 ? "medium" : "low" );
					continue;
				}
				var normalized = lCase( text );
				if ( [ "high", "medium", "low" ].contains( normalized ) ) item.confidence = normalized;
				else if ( [ "very-high", "veryhigh", "certain", "confident" ].contains( normalized ) ) item.confidence = "high";
				else if ( [ "moderate", "med", "unsure" ].contains( normalized ) ) item.confidence = "medium";
				else if ( [ "very-low", "verylow", "speculative", "guess" ].contains( normalized ) ) item.confidence = "low";
				else item.confidence = "medium";
			}
		}
		return arguments.plan;
	}

	/**
	 * Deterministic cleanup so common provider aliases validate and the Solution
	 * UI gets a mapped current slice instead of an empty narrative road.
	 */
	private struct function polishPlan( required struct plan, struct samplePolicy = {}, array errors = [] ) {
		var polished = arguments.plan;
		polished = backfillUnitSymbolsFromInventory( polished, arguments.errors );
		polished = groupHandlerUnitsIntoActions( polished, arguments.errors );
		polished.dbTransitions = normalizeDbTransitions( polished.dbTransitions ?: [] );
		polished.routeContracts = normalizeRouteContracts( polished.routeContracts ?: [] );
		polished = resolveInventoryReferences( polished );
		// Roadmap normalization first separates route ids that providers placed in
		// unitIds; target alias resolution can then safely canonicalize only the
		// remaining target-unit references.
		polished.roadmapPhases = normalizeRoadmapReferences( polished, arguments.errors );
		polished.roadmapPhases = ensureRoadmapActionFields( polished.roadmapPhases ?: [], polished );
		polished = resolveTargetReferences( polished );
		polished = ensureUniqueTargetUnitIds( polished, arguments.errors );
		polished = ensureUniqueCollectionIds( polished, arguments.errors );
		polished = dropUnresolvedUnitLinks( polished, arguments.errors );
		// Routes are retained only after unit ids are canonicalized and links are
		// repaired. Retaining first made every route minted in one shard that
		// referenced another shard's unit look unbacked, and 39 of 40 were dropped.
		polished.routeContracts = retainEvidencedRoutes( polished, arguments.errors );
		// Re-validate phase references against the final route set.
		polished.roadmapPhases = normalizeRoadmapReferences( polished, arguments.errors );
		polished = normalizePlanConfidence( polished );
		polished = pruneUnbackedMigrationSteps( polished, arguments.errors );
		polished.assumptions = dedupeSimpleValues( polished.assumptions ?: [] );
		polished.samples = normalizeSamples( polished.samples ?: [], polished.metadata.runtime ?: {} );
		polished.samples = liftUnitSampleCode( polished.samples ?: [], polished.target.units ?: [] );
		polished.samples = dedupeById( polished.samples ?: [] );
		polished.roadmapPhases = orderRoadmapPhases( polished.roadmapPhases ?: [] );
		polished.roadmapPhases = ensureCurrentSlice( polished.roadmapPhases ?: [] );
		polished.roadmapPhases = ensurePhaseNames( polished.roadmapPhases ?: [] );
		polished.roadmapPhases = ensureRoadmapActionFields( polished.roadmapPhases ?: [], polished );
		var sampleLimit = isNumeric( arguments.samplePolicy.maxFiles ?: "" ) ? max( 1, int( arguments.samplePolicy.maxFiles ) ) : 40;
		polished.samples = boundedStructArray( polished.samples ?: [], sampleLimit, arguments.errors, "samples" );
		if ( ( arguments.samplePolicy.currentPhasesOnly ?: true ) && isArray( polished.roadmapPhases ?: "" ) ) {
			polished.samples = currentSliceSamples( polished.samples ?: [], polished.roadmapPhases, polished.target.units ?: [] );
			// currentSliceSamples() intentionally drops every non-current-slice
			// sample to keep the exported samples list bounded, but
			// normalizeRoadmapReferences() already validated phase.sampleIds
			// against the full (pre-pruning) sample set above — every
			// non-current phase's sampleIds would otherwise dangle after
			// pruning and fail validateReferences()'s reference check.
			var survivingSampleIds = {};
			for ( var survivingSample in polished.samples ) survivingSampleIds[ trim( survivingSample.id ?: survivingSample.itemId ?: "" ) ] = true;
			for ( var polishedPhase in polished.roadmapPhases ) polishedPhase.sampleIds = validIds( polishedPhase.sampleIds ?: [], survivingSampleIds );
		}
		polished.samples = ensureActionableSamples( polished, arguments.samplePolicy, arguments.errors );
		for ( var item in polished.routeContracts ) ensureIdentity( item, "route-contract" );
		for ( var item in polished.unitLinks ?: [] ) ensureIdentity( item, "unit-link" );
		for ( var item in polished.target.units ?: [] ) ensureIdentity( item, "target-unit" );
		for ( var item in polished.target.contexts ?: [] ) ensureIdentity( item, "context" );
		for ( var item in polished.target.extracts ?: [] ) ensureIdentity( item, "extract" );
		for ( var item in polished.dbFindings ?: [] ) ensureIdentity( item, "db-finding" );
		for ( var item in polished.dbTransitions ?: [] ) ensureIdentity( item, "db-transition" );
		for ( var item in polished.roadmapPhases ) ensureIdentity( item, "roadmap-phase" );
		for ( var item in polished.samples ) ensureIdentity( item, "sample" );
		return polished;
	}

	/**
	 * Application shards invent identifiers independently. Resolve their path,
	 * source-path, basename, and pre-normalization aliases to the retained target
	 * unit ids before reference validation. Unknown placement/roadmap aliases are
	 * preserved as explicit uncertainty rather than dangling ids that flood the
	 * plan with repetitive referential-integrity blockers.
	 */
	private struct function resolveTargetReferences( required struct plan ) {
		var target = isStruct( arguments.plan.target ?: "" ) ? arguments.plan.target : {};
		var units = isArray( target.units ?: "" ) ? target.units : [];
		var lookup = buildTargetLookup( units );

		for ( var link in ( isArray( arguments.plan.unitLinks ?: "" ) ? arguments.plan.unitLinks : [] ) ) {
			if ( !isStruct( link ) ) continue;
			var resolvedLinkTarget = resolveTargetToken(
				link.targetUnitId ?: link.targetId ?: "",
				link.sourcePath ?: link.sourceFile ?: link.filePath ?: "",
				lookup
			);
			if ( len( resolvedLinkTarget ) ) link.targetUnitId = resolvedLinkTarget;
		}

		var linkTargets = {};
		for ( var link in ( isArray( arguments.plan.unitLinks ?: "" ) ? arguments.plan.unitLinks : [] ) ) {
			if ( !isStruct( link ) ) continue;
			var linkId = trim( toString( link.id ?: link.itemId ?: "" ) );
			var linkTargetId = trim( toString( link.targetUnitId ?: "" ) );
			if ( len( linkId ) && len( linkTargetId ) ) linkTargets[ linkId ] = linkTargetId;
		}

		for ( var route in ( isArray( arguments.plan.routeContracts ?: "" ) ? arguments.plan.routeContracts : [] ) ) {
			if ( !isStruct( route ) ) continue;
			var resolvedRouteTarget = resolveTargetToken(
				route.targetUnitId ?: route.targetId ?: "",
				route.sourcePath ?: route.legacyPath ?: "",
				lookup
			);
			if ( !len( resolvedRouteTarget ) ) {
				var routeLinkId = trim( toString( route.unitLinkId ?: "" ) );
				if ( len( routeLinkId ) && linkTargets.keyExists( routeLinkId ) ) resolvedRouteTarget = linkTargets[ routeLinkId ];
			}
			if ( len( resolvedRouteTarget ) ) route.targetUnitId = resolvedRouteTarget;
		}

		for ( var collectionName in [ "placements", "contexts", "extracts" ] ) {
			for ( var grouping in ( isArray( target[ collectionName ] ?: "" ) ? target[ collectionName ] : [] ) ) {
				if ( !isStruct( grouping ) ) continue;
				var normalizedIds = [];
				var unresolvedIds = [];
				for ( var rawId in ( isArray( grouping.targetUnitIds ?: "" ) ? grouping.targetUnitIds : ( isArray( grouping.unitIds ?: "" ) ? grouping.unitIds : [] ) ) ) {
					var resolvedGroupId = resolveTargetToken( rawId, "", lookup );
					if ( len( resolvedGroupId ) ) {
						if ( !arrayContainsNoCase( normalizedIds, resolvedGroupId ) ) normalizedIds.append( resolvedGroupId );
					} else if ( len( trim( toString( rawId ) ) ) && !arrayContainsNoCase( unresolvedIds, toString( rawId ) ) ) {
						unresolvedIds.append( toString( rawId ) );
					}
				}
				grouping.targetUnitIds = normalizedIds;
				grouping.unitIds = normalizedIds;
				if ( unresolvedIds.len() ) {
					grouping.unresolvedTargetUnitIds = unresolvedIds;
					grouping.validationStatus = "needs-review";
					grouping.uncertainty = isArray( grouping.uncertainty ?: "" ) ? grouping.uncertainty : [];
					grouping.uncertainty.append( "Some provider target references could not be matched to retained target units." );
				}
			}
		}

		for ( var phase in ( isArray( arguments.plan.roadmapPhases ?: "" ) ? arguments.plan.roadmapPhases : [] ) ) {
			if ( !isStruct( phase ) ) continue;
			var phaseIds = [];
			var unresolvedPhaseIds = [];
			for ( var rawPhaseId in ( isArray( phase.unitIds ?: "" ) ? phase.unitIds : ( isArray( phase.targetUnitIds ?: "" ) ? phase.targetUnitIds : [] ) ) ) {
				var resolvedPhaseId = resolveTargetToken( rawPhaseId, "", lookup );
				if ( len( resolvedPhaseId ) ) {
					if ( !arrayContainsNoCase( phaseIds, resolvedPhaseId ) ) phaseIds.append( resolvedPhaseId );
				} else if ( len( trim( toString( rawPhaseId ) ) ) ) unresolvedPhaseIds.append( toString( rawPhaseId ) );
			}
			phase.unitIds = phaseIds;
			if ( unresolvedPhaseIds.len() ) phase.unresolvedTargetUnitIds = dedupeSimpleValues( unresolvedPhaseIds );
		}

		arguments.plan.target = target;
		return arguments.plan;
	}

	/**
	 * Drop unitLinks whose targetUnitId still does not resolve after alias
	 * repair. Dangling hashes / invented ids (targetUnit-2, models/Foo.cfc)
	 * otherwise flood validation with unknownTargetUnitId blockers.
	 */
	/**
	 * Guarantees every target unit carries a distinct id.
	 *
	 * Ids are minted from item content, so two shards proposing the same target
	 * for the same legacy file mint the same id. Target-path de-collision then
	 * renames one of them (home.bx -> home2.bx) without re-minting, leaving two
	 * units sharing an id. That single collision cascaded into five blocking
	 * violations on a live run: the duplicate id itself, a placement owning "the"
	 * unit twice, and three migration steps that looked out-of-phase because the
	 * phase resolved the shared id to only one of the two units.
	 *
	 * The first occurrence keeps the id so existing links, routes, and decisions
	 * stay valid; later duplicates are re-minted from their own (now distinct)
	 * content.
	 */
	private struct function ensureUniqueTargetUnitIds( required struct plan, array errors = [] ) {
		var target = isStruct( arguments.plan.target ?: "" ) ? arguments.plan.target : {};
		var units = isArray( target.units ?: "" ) ? target.units : [];
		if ( units.len() < 2 ) return arguments.plan;
		var seen = {};
		var reminted = 0;
		for ( var unit in units ) {
			if ( !isStruct( unit ) ) continue;
			var unitId = trim( toString( unit.id ?: unit.itemId ?: "" ) );
			if ( len( unitId ) && !seen.keyExists( unitId ) ) {
				seen[ unitId ] = true;
				continue;
			}
			// Re-mint from the unit's own content, which now differs from its twin.
			var candidate = identityService.itemId( "target-unit", unit );
			if ( !len( candidate ) || seen.keyExists( candidate ) ) {
				// Content is still identical; fall back to a deterministic
				// discriminator so the id cannot collide again.
				candidate = identityService.itemId( "target-unit", {
					previousId: unitId,
					targetPath: toString( unit.targetPath ?: "" ),
					sourcePath: toString( unit.sourcePath ?: "" ),
					ordinal: seen.count() + 1
				} );
			}
			unit.id = candidate;
			unit.idProvenance = "reminted-duplicate";
			// The fingerprint covered the old id, so it has to be rebuilt too.
			structDelete( unit, "itemFingerprint" );
			unit.itemFingerprint = identityService.itemFingerprint( "target-unit", unit );
			seen[ candidate ] = true;
			reminted++;
		}
		if ( reminted ) {
			arguments.errors.append( {
				role: "modernization-application",
				message: "reminted-duplicate-target-unit-ids",
				severity: "info",
				count: reminted
			} );
		}
		target.units = units;
		arguments.plan.target = target;
		return arguments.plan;
	}

	/**
	 * Applies the same duplicate-id repair to the plan's other collections.
	 *
	 * `ensureUniqueTargetUnitIds` only covered target units, but ids are minted
	 * from item content everywhere, so any collection can collide the same way —
	 * a live run produced two dbTransitions sharing an id. Every duplicate id is
	 * a blocking violation regardless of which array it sits in.
	 */
	private struct function ensureUniqueCollectionIds( required struct plan, array errors = [] ) {
		var collections = [
			{ key: "dbFindings", kind: "db-finding" },
			{ key: "dbTransitions", kind: "db-transition" },
			{ key: "routeContracts", kind: "route-contract" },
			{ key: "samples", kind: "sample" },
			{ key: "roadmapPhases", kind: "roadmap-phase" }
		];
		var reminted = 0;
		for ( var collection in collections ) {
			var items = isArray( arguments.plan[ collection.key ] ?: "" ) ? arguments.plan[ collection.key ] : [];
			if ( items.len() < 2 ) continue;
			var seen = {};
			var ordinal = 0;
			for ( var item in items ) {
				if ( !isStruct( item ) ) continue;
				ordinal++;
				var itemId = trim( toString( item.id ?: item.itemId ?: "" ) );
				if ( len( itemId ) && !seen.keyExists( itemId ) ) {
					seen[ itemId ] = true;
					continue;
				}
				var candidate = identityService.itemId( collection.kind, item );
				if ( !len( candidate ) || seen.keyExists( candidate ) ) {
					candidate = identityService.itemId( collection.kind, { previousId: itemId, ordinal: ordinal, collection: collection.key } );
				}
				item.id = candidate;
				item.idProvenance = "reminted-duplicate";
				structDelete( item, "itemFingerprint" );
				item.itemFingerprint = identityService.itemFingerprint( collection.kind, item );
				seen[ candidate ] = true;
				reminted++;
			}
		}
		if ( reminted ) {
			arguments.errors.append( {
				role: "modernization",
				message: "reminted-duplicate-item-ids",
				severity: "info",
				count: reminted
			} );
		}
		return arguments.plan;
	}

	private struct function dropUnresolvedUnitLinks( required struct plan, array errors = [] ) {
		var targetIds = {};
		var units = isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [];
		// Sharding breaks referential integrity: a link minted in shard 3 can name
		// a unit that only exists in shard 7's output. The pair of paths on both
		// sides is stable across shards, so repair through those before dropping.
		var unitsBySourceTarget = {};
		var unitsBySource = {};
		var unitsByTarget = {};
		var noteCandidate = ( bucket, key, unitId ) => {
			if ( !len( key ) ) return;
			if ( !bucket.keyExists( key ) ) bucket[ key ] = [];
			if ( !arrayContainsNoCase( bucket[ key ], unitId ) ) bucket[ key ].append( unitId );
		};
		for ( var unit in units ) {
			var unitId = trim( toString( unit.id ?: unit.itemId ?: "" ) );
			if ( !len( unitId ) ) continue;
			targetIds[ unitId ] = true;
			var unitSource = lCase( normalizeLegacyPath( unit.sourcePath ?: "" ) );
			var unitTarget = lCase( normalizeLegacyPath( unit.targetPath ?: "" ) );
			noteCandidate( unitsBySourceTarget, unitSource & "|" & unitTarget, unitId );
			noteCandidate( unitsBySource, unitSource, unitId );
			noteCandidate( unitsByTarget, unitTarget, unitId );
		}
		var kept = [];
		var dropped = 0;
		var repaired = 0;
		for ( var link in ( isArray( arguments.plan.unitLinks ?: "" ) ? arguments.plan.unitLinks : [] ) ) {
			if ( !isStruct( link ) ) continue;
			var targetId = trim( toString( link.targetUnitId ?: "" ) );
			if ( len( targetId ) && targetIds.keyExists( targetId ) ) {
				kept.append( link );
				continue;
			}
			var linkSource = lCase( normalizeLegacyPath( link.sourcePath ?: "" ) );
			var linkTarget = lCase( normalizeLegacyPath( link.targetPath ?: "" ) );
			var resolved = "";
			for ( var candidate in [
				unitsBySourceTarget[ linkSource & "|" & linkTarget ] ?: [],
				unitsByTarget[ linkTarget ] ?: [],
				unitsBySource[ linkSource ] ?: []
			] ) {
				// Only adopt an unambiguous match; a path shared by several units
				// tells us nothing about which one this link meant.
				if ( candidate.len() == 1 ) {
					resolved = candidate[ 1 ];
					break;
				}
			}
			if ( len( resolved ) ) {
				link.targetUnitId = resolved;
				link.targetUnitIdProvenance = "repaired-by-path";
				kept.append( link );
				repaired++;
			} else {
				dropped++;
			}
		}
		if ( repaired ) {
			arguments.errors.append( {
				role: "modernization-application",
				message: "repaired-cross-shard-unit-links",
				severity: "info",
				count: repaired
			} );
		}
		if ( dropped ) {
			arguments.errors.append( {
				role: "modernization-application",
				message: "dropped-unresolved-unit-links",
				severity: "info",
				count: dropped
			} );
		}
		arguments.plan.unitLinks = kept;
		return arguments.plan;
	}

	private struct function buildTargetLookup( required array units ) {
		var lookup = { byId: {}, aliases: {} };
		for ( var unit in arguments.units ) {
			if ( !isStruct( unit ) ) continue;
			var canonicalId = trim( toString( unit.id ?: unit.itemId ?: "" ) );
			if ( !len( canonicalId ) ) continue;
			lookup.byId[ canonicalId ] = canonicalId;
			registerTargetAlias( lookup, canonicalId, canonicalId );
			for ( var aliasField in [ "targetPath", "pathHint", "sourcePath", "sourceFile", "legacyPath", "filePath" ] ) {
				if ( len( trim( toString( unit[ aliasField ] ?: "" ) ) ) ) registerTargetAlias( lookup, unit[ aliasField ], canonicalId );
			}
		}
		return lookup;
	}

	private void function registerTargetAlias( required struct lookup, required any alias, required string canonicalId ) {
		var normalized = normalizeTargetAlias( arguments.alias );
		if ( !len( normalized ) ) return;
		var aliases = [ normalized ];
		var withoutExtension = reReplaceNoCase( normalized, "\.(?:cfc|cfm|cfml|bx|bxm)$", "" );
		if ( withoutExtension != normalized ) aliases.append( withoutExtension );
		if ( findNoCase( "app/", normalized ) == 1 ) aliases.append( removeChars( normalized, 1, 4 ) );
		if ( findNoCase( "app/", withoutExtension ) == 1 ) aliases.append( removeChars( withoutExtension, 1, 4 ) );
		var basename = listLast( normalized, "/" );
		if ( len( basename ) ) {
			aliases.append( basename );
			aliases.append( reReplaceNoCase( basename, "\.(?:cfc|cfm|cfml|bx|bxm)$", "" ) );
		}
		for ( var aliasKey in aliases ) {
			if ( !len( aliasKey ) ) continue;
			if ( !arguments.lookup.aliases.keyExists( aliasKey ) ) arguments.lookup.aliases[ aliasKey ] = [];
			if ( !arrayContainsNoCase( arguments.lookup.aliases[ aliasKey ], arguments.canonicalId ) ) arguments.lookup.aliases[ aliasKey ].append( arguments.canonicalId );
		}
	}

	private string function resolveTargetToken( required any token, required string hintPath, required struct lookup ) {
		var raw = trim( isStruct( arguments.token ) ? toString( arguments.token.id ?: arguments.token.targetPath ?: arguments.token.path ?: "" ) : toString( arguments.token ) );
		if ( len( raw ) && arguments.lookup.byId.keyExists( raw ) ) return arguments.lookup.byId[ raw ];
		for ( var candidate in [ raw, arguments.hintPath ] ) {
			var normalized = normalizeTargetAlias( candidate );
			if ( !len( normalized ) ) continue;
			var keys = [ normalized, reReplaceNoCase( normalized, "\.(?:cfc|cfm|cfml|bx|bxm)$", "" ) ];
			if ( findNoCase( "app/", normalized ) == 1 ) keys.append( removeChars( normalized, 1, 4 ) );
			for ( var key in keys ) {
				if ( arguments.lookup.aliases.keyExists( key ) && arguments.lookup.aliases[ key ].len() == 1 ) return arguments.lookup.aliases[ key ][ 1 ];
			}
		}
		return "";
	}

	private string function normalizeTargetAlias( required any value ) {
		var normalized = lCase( replace( trim( toString( arguments.value ) ), "\", "/", "all" ) );
		while ( find( "//", normalized ) ) normalized = replace( normalized, "//", "/", "all" );
		return reReplace( normalized, "^\./", "" );
	}

	/**
	 * Guarantees a transition carries a cfmigrations-shaped migration body.
	 *
	 * Providers reliably return `sampleMigration: { up: "...", down: "..." }` —
	 * the statement bodies without the component wrapper the validator requires,
	 * so every transition failed the "missing up(schema, query)" gate. Wrapping
	 * the model's own statements keeps the evidence and satisfies the contract;
	 * a body the provider already wrapped is left untouched.
	 */
	private void function ensureMigrationSkeleton( required struct transition ) {
		var existing = arguments.transition.migrationCode ?: "";
		if ( isSimpleValue( existing ) && reFindNoCase( "function\s+up\s*\(", toString( existing ) ) ) return;
		var sample = arguments.transition.sampleMigration ?: "";
		if ( isSimpleValue( sample ) && reFindNoCase( "function\s+up\s*\(", toString( sample ) ) ) {
			arguments.transition.migrationCode = toString( sample );
			return;
		}
		var upBody = "";
		var downBody = "";
		if ( isStruct( sample ) ) {
			upBody = trim( toString( sample.up ?: sample.forward ?: "" ) );
			downBody = trim( toString( sample.down ?: sample.rollback ?: sample.reverse ?: "" ) );
		} else if ( isSimpleValue( sample ) ) {
			upBody = trim( toString( sample ) );
		}
		if ( !len( downBody ) ) downBody = trim( toString( arguments.transition.rollback ?: "" ) );
		if ( !len( upBody ) && !len( downBody ) ) return;
		var objectLabel = "";
		if ( isArray( arguments.transition.objectsTouched ?: "" ) && arguments.transition.objectsTouched.len() ) {
			objectLabel = toString( arguments.transition.objectsTouched[ 1 ] );
		}
		var indent = ( body, fallback ) => {
			var text = len( trim( arguments.body ) ) ? trim( arguments.body ) : arguments.fallback;
			var lines = [];
			for ( var line in listToArray( replace( text, char( 13 ), "", "all" ), char( 10 ), true, false ) ) {
				lines.append( "        " & line );
			}
			return lines.toList( char( 10 ) );
		};
		arguments.transition.migrationCode = "component {" & char( 10 ) &
			"    function up( schema, query ) {" & char( 10 ) &
			indent( upBody, "// review expand step for `" & objectLabel & "` before running" ) & char( 10 ) &
			"    }" & char( 10 ) &
			"    function down( schema, query ) {" & char( 10 ) &
			indent( downBody, "// review rollback for `" & objectLabel & "` before running" ) & char( 10 ) &
			"    }" & char( 10 ) & "}";
		arguments.transition.migrationCodeProvenance = "wrapped-provider-statements";
	}

	/**
	 * Guarantees a cfmigrations-shaped migration path.
	 *
	 * `migrationPath` is unreliable provider output — observed as a bare
	 * directory and, in another run, as the literal operation name ("expand") —
	 * and the validator requires a `YYYY_MM_DD_HHMMSS` filename. The synthesized
	 * name is derived from the transition's own order and object so it stays
	 * stable across runs; a wall-clock stamp would churn item fingerprints.
	 */
	private void function ensureMigrationPath( required struct transition, required numeric position ) {
		var current = replace( trim( toString( arguments.transition.migrationPath ?: "" ) ), "\", "/", "all" );
		if ( len( current ) && reFind( "[0-9]{4}_[0-9]{2}_[0-9]{2}_[0-9]{6}.*\.bx$", current ) ) return;
		var order = isNumeric( arguments.transition.order ?: "" ) ? int( arguments.transition.order ) : arguments.position;
		var operation = reReplace( lCase( toString( arguments.transition.operation ?: "change" ) ), "[^a-z0-9]+", "_", "all" );
		var objectName = "";
		if ( isArray( arguments.transition.objectsTouched ?: "" ) && arguments.transition.objectsTouched.len() ) {
			objectName = reReplace( lCase( toString( arguments.transition.objectsTouched[ 1 ] ) ), "[^a-z0-9]+", "_", "all" );
		}
		var slug = trim( operation & ( len( objectName ) ? "_" & objectName : "" ) );
		if ( !len( slug ) ) slug = "migration";
		arguments.transition.migrationPath = "resources/database/migrations/2025_01_01_" &
			right( "00000" & max( 0, order ), 6 ) & "_" & slug & ".bx";
		arguments.transition.migrationPathProvenance = "derived-from-order-and-object";
	}

	private array function normalizeDbTransitions( required any transitions ) {
		var output = isArray( arguments.transitions ) ? arguments.transitions : [];
		var allowedOps = [ "expand", "backfill", "switch", "contract", "forward-only", "forward_only" ];
		var opAliases = {
			"expand-contract": "expand",
			"expand_contract": "expand",
			"migrate": "switch",
			"migration": "switch",
			"alter": "expand",
			"add": "expand",
			"create": "expand",
			"drop": "contract",
			"remove": "contract",
			"delete": "contract",
			// Providers reach for their own vocabulary. One live run returned
			// "verify" 23 times and "capture" once, and every transition then
			// tripped the invalid-operation gate.
			"verify": "switch",
			"validate": "switch",
			"check": "switch",
			"capture": "expand",
			"introduce": "expand",
			"extend": "expand",
			"populate": "backfill",
			"seed": "backfill",
			"copy": "backfill",
			"migrate-data": "backfill",
			"cutover-traffic": "switch",
			"retire": "contract",
			"cleanup": "contract",
			"clean-up": "contract",
			"back-fill": "backfill",
			"cutover": "switch",
			"forwardonly": "forward-only",
			"forward only": "forward-only"
		};
		for ( var transition in output ) {
			if ( !isStruct( transition ) ) continue;
			transition.evidenceRefs = normalizeProviderList( transition.evidenceRefs ?: transition.evidence ?: [] );
			transition.objectsTouched = normalizeProviderList( transition.objectsTouched ?: transition.objects ?: [] );
			ensureMigrationSkeleton( transition );
			var operation = lCase( trim( toString( transition.operation ?: transition.phase ?: "" ) ) );
			if ( len( operation ) && !allowedOps.contains( operation ) ) {
				operation = opAliases[ operation ] ?: operation;
			}
			if ( len( operation ) && allowedOps.contains( operation ) ) {
				transition.operation = operation;
			} else {
				// Empty drafts and unrecognized provider vocabulary land here alike.
				// Passing an unknown verb through unchanged only moved the failure to
				// the validator, which flagged every transition as invalid. Expand is
				// the non-destructive default; the flag keeps the inference visible
				// and records what the provider actually said.
				if ( len( operation ) ) transition.operationProvided = operation;
				transition.operation = "expand";
				transition.operationInferred = true;
			}
			var path = replace( trim( scalarString( transition.migrationPath ?: transition.filePath ?: "" ) ), "\", "/", "all" );
			if ( !len( path ) ) continue;
			var fileName = listLast( path, "/" );
			var nameWithoutExtension = listFirst( fileName, "." );
			var timestampDigits = reReplace( left( nameWithoutExtension, 20 ), "[^0-9]", "", "all" );
			if ( len( timestampDigits ) < 14 ) continue;
			var slug = reReplace( nameWithoutExtension, "^[0-9_]+_?", "", "one" );
			slug = lCase( reReplace( slug, "[^a-zA-Z0-9_-]", "_", "all" ) );
			if ( !len( slug ) ) slug = "modernization_change";
			var directory = listLen( path, "/" ) > 1
				? listDeleteAt( path, listLen( path, "/" ), "/" ) & "/"
				: "";
			transition.migrationPath = directory &
				mid( timestampDigits, 1, 4 ) & "_" &
				mid( timestampDigits, 5, 2 ) & "_" &
				mid( timestampDigits, 7, 2 ) & "_" &
				mid( timestampDigits, 9, 6 ) & "_" &
				slug & ".bx";
		}
		// Expand/backfill/switch/contract only means anything in sequence, and the
		// gate requires `order` to be monotonic. Providers return repeated or
		// out-of-sequence numbers, so renumber densely while preserving the
		// relative order they asked for — the ordering is the provider's
		// intent; only the numbering is unreliable.
		var ordered = [];
		for ( var orderedItem in output ) if ( isStruct( orderedItem ) ) ordered.append( orderedItem );
		var originalIndex = {};
		for ( var indexPosition = 1; indexPosition <= ordered.len(); indexPosition++ ) {
			originalIndex[ indexPosition ] = ordered[ indexPosition ];
		}
		ordered.sort( ( a, b ) => {
			var left = isNumeric( a.order ?: "" ) ? val( a.order ) : 999999;
			var right = isNumeric( b.order ?: "" ) ? val( b.order ) : 999999;
			return left == right ? 0 : ( left < right ? -1 : 1 );
		} );
		for ( var sequence = 1; sequence <= ordered.len(); sequence++ ) {
			ordered[ sequence ].order = sequence;
		}

		// Last-resort pass: the loop above repairs a recoverable path, but skips a
		// transition whose path is absent or carries no timestamp digits at all
		// (observed as a bare directory, and as the literal operation name).
		// Synthesize one so the cfmigrations gate is satisfiable.
		var transitionPosition = 0;
		for ( var pending in ordered ) {
			transitionPosition++;
			ensureMigrationPath( pending, transitionPosition );
		}
		return ordered;
	}

	/**
	 * Provider (and repair) output is untrusted and can return an array where a
	 * scalar string is expected. Coerces to a plain string so callers can trim()
	 * it safely instead of crashing on a type mismatch.
	 */
	private string function scalarString( required any value ) {
		if ( isSimpleValue( arguments.value ) ) return toString( arguments.value );
		if ( isArray( arguments.value ) ) {
			for ( var item in arguments.value ) if ( isSimpleValue( item ) && len( trim( toString( item ) ) ) ) return trim( toString( item ) );
			return "";
		}
		return "";
	}

	private array function normalizeProviderList( required any value ) {
		if ( isArray( arguments.value ) ) return duplicate( arguments.value );
		if ( !isSimpleValue( arguments.value ) ) return [];
		var text = trim( toString( arguments.value ) );
		if ( !len( text ) ) return [];
		text = reReplace( text, "^[[:space:]]*\[|\][[:space:]]*$", "", "all" );
		text = replace( text, '"', "", "all" );
		text = reReplace( text, "[,\r\n]+", ",", "all" );
		var output = [];
		for ( var item in listToArray( text, "," ) ) {
			var normalized = trim( item );
			if ( len( normalized ) && !arrayContainsNoCase( output, normalized ) ) output.append( normalized );
		}
		return output;
	}

	/**
	 * Turns a legacy source path into a route path the validator accepts.
	 *
	 * `safeRoutePath()` requires a leading "/", no ".." anywhere, and no "//".
	 * Legacy CFML navigation is full of relative hops ("../login/login.cfm"), so
	 * a derived path has to be resolved rather than just slash-prefixed —
	 * otherwise deriving the path trades a dropped route for a blocking
	 * validation error. Returns "" when nothing safe can be produced.
	 */
	private string function safeRoutePathFrom( required string sourcePath ) {
		var normalized = replace( trim( arguments.sourcePath ), "\", "/", "all" );
		if ( !len( normalized ) ) return "";
		var resolved = [];
		for ( var segment in listToArray( normalized, "/" ) ) {
			var cleaned = trim( segment );
			if ( !len( cleaned ) || cleaned == "." ) continue;
			if ( cleaned == ".." ) {
				// Pop the parent this hop escapes; a hop above the root is simply
				// dropped, which keeps the remaining path inside the application.
				if ( resolved.len() ) resolved.deleteAt( resolved.len() );
				continue;
			}
			resolved.append( cleaned );
		}
		if ( !resolved.len() ) return "";
		var candidate = "/" & resolved.toList( "/" );
		// Defensive: never hand back something the gate would reject.
		if ( find( "..", candidate ) || reFind( "^//", candidate ) ) return "";
		return candidate;
	}

	private array function retainEvidencedRoutes( required struct plan, array errors = [] ) {
		var targetIds = {};
		var targetsById = {};
		var linksById = {};
		var linksByTarget = {};
		for ( var target in ( isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [] ) ) {
			var targetId = trim( target.id ?: target.itemId ?: "" );
			if ( len( targetId ) ) {
				targetIds[ targetId ] = true;
				targetsById[ targetId ] = target;
			}
		}
		for ( var link in ( isArray( arguments.plan.unitLinks ?: "" ) ? arguments.plan.unitLinks : [] ) ) {
			var linkId = trim( link.id ?: link.itemId ?: "" );
			var linkTargetId = trim( link.targetUnitId ?: "" );
			if ( len( linkId ) ) linksById[ linkId ] = link;
			if ( len( linkTargetId ) ) {
				if ( !linksByTarget.keyExists( linkTargetId ) ) linksByTarget[ linkTargetId ] = [];
				linksByTarget[ linkTargetId ].append( link );
			}
		}
		var output = [];
		for ( var route in ( isArray( arguments.plan.routeContracts ?: "" ) ? arguments.plan.routeContracts : [] ) ) {
			if ( !isStruct( route ) ) continue;
			var copy = duplicate( route );
			var routeId = trim( copy.id ?: copy.itemId ?: "" );
			var targetId = trim( copy.targetUnitId ?: "" );
			var linkId = trim( copy.unitLinkId ?: "" );
			if ( !len( linkId ) && isArray( copy.evidence ?: "" ) ) {
				var evidenceTokens = [];
				for ( var evidenceItem in copy.evidence ) {
					var evidenceToken = isSimpleValue( evidenceItem )
						? trim( toString( evidenceItem ) )
						: trim( evidenceItem.ref ?: evidenceItem.id ?: evidenceItem.evidenceId ?: "" );
					if ( len( evidenceToken ) ) evidenceTokens.append( evidenceToken );
				}
				var matchingLinks = [];
				for ( var candidateLinkId in linksById ) {
					var candidateLegacyId = trim( linksById[ candidateLinkId ].legacyUnitId ?: "" );
					if ( len( candidateLegacyId ) && arrayContainsNoCase( evidenceTokens, candidateLegacyId ) ) matchingLinks.append( linksById[ candidateLinkId ] );
				}
				if ( matchingLinks.len() == 1 ) {
					linkId = matchingLinks[ 1 ].id ?: "";
					copy.unitLinkId = linkId;
				}
			}
			if ( len( linkId ) && linksById.keyExists( linkId ) ) {
				var linkedTarget = trim( linksById[ linkId ].targetUnitId ?: "" );
				if ( len( linkedTarget ) ) {
					targetId = linkedTarget;
					copy.targetUnitId = linkedTarget;
				}
			}
			if ( !len( linkId ) && len( targetId ) && linksByTarget.keyExists( targetId ) && linksByTarget[ targetId ].len() == 1 ) {
				linkId = linksByTarget[ targetId ][ 1 ].id ?: "";
				copy.unitLinkId = linkId;
			}
			var evidencePresent = structKeyExists( copy, "evidence" );
			var hasEvidence = isArray( copy.evidence ?: "" ) && copy.evidence.len() > 0;
			var validReferences = len( targetId ) && targetIds.keyExists( targetId ) && len( linkId ) && linksById.keyExists( linkId );
			// Providers routinely omit `path` while still returning a resolvable
			// link/target. The legacy source path behind that link is real
			// evidence, so derive the route path from it rather than discarding
			// an otherwise well-formed route.
			if ( !len( trim( scalarString( copy.path ?: "" ) ) ) ) {
				var derivedPath = "";
				if ( len( linkId ) && linksById.keyExists( linkId ) ) {
					derivedPath = trim( scalarString( linksById[ linkId ].sourcePath ?: "" ) );
				}
				if ( !len( derivedPath ) && len( targetId ) && targetsById.keyExists( targetId ) ) {
					derivedPath = trim( scalarString( targetsById[ targetId ].sourcePath ?: "" ) );
				}
				derivedPath = safeRoutePathFrom( derivedPath );
				if ( len( derivedPath ) ) {
					copy.path = derivedPath;
					if ( !len( trim( scalarString( copy.legacyPath ?: "" ) ) ) ) copy.legacyPath = derivedPath;
					if ( isStruct( copy.request ?: "" ) && !len( trim( scalarString( copy.request.path ?: "" ) ) ) ) copy.request.path = derivedPath;
					copy.pathProvenance = "derived-from-linked-source";
				}
			}
			if ( !len( trim( scalarString( copy.path ?: "" ) ) ) || !validReferences ) {
				arguments.errors.append( {
					role: "modernization-application",
					message: "omitted-unbacked-route",
					severity: "info",
					routeId: routeId,
					reason: !len( trim( scalarString( copy.path ?: "" ) ) ) ? "missing-path" : "missing-target-or-link"
				} );
				continue;
			}
			// Explicit empty evidence arrays are treated as invented and omitted.
			// Missing evidence keys are retained as needs-review so sparse provider
			// shards do not wipe the entire routeContracts list.
			if ( !hasEvidence ) {
				if ( evidencePresent ) {
					arguments.errors.append( {
						role: "modernization-application",
						message: "omitted-unbacked-route",
						severity: "info",
						routeId: routeId,
						reason: "missing-route-evidence"
					} );
					continue;
				}
				copy.validationStatus = len( trim( copy.validationStatus ?: "" ) ) ? copy.validationStatus : "needs-review";
				arguments.errors.append( {
					role: "modernization-application",
					message: "route-missing-evidence",
					severity: "info",
					routeId: routeId,
					reason: "missing-route-evidence"
				} );
			}
			output.append( copy );
		}
		return dedupeById( output );
	}

	private array function ensurePhaseNames( required array phases ) {
		var output = [];
		for ( var phase in arguments.phases ) {
			if ( !isStruct( phase ) ) continue;
			var copy = duplicate( phase );
			if ( !len( trim( copy.name ?: "" ) ) ) {
				var goal = trim( copy.goal ?: "" );
				if ( len( goal ) ) {
					copy.name = len( goal ) > 90 ? left( goal, 87 ) & "..." : goal;
				} else if ( len( trim( copy.pattern ?: "" ) ) ) {
					copy.name = replace( copy.pattern, "-", " ", "all" );
				} else {
					copy.name = copy.id ?: "Roadmap phase";
				}
			}
			output.append( copy );
		}
		return output;
	}

	/**
	 * Soft-fill actionable roadmap fields for both provider and synthesized
	 * phases so Solution UI never renders blank classification/wave/risks.
	 * Empty strings and empty arrays are normalized; existing values are kept.
	 */
	private array function ensureRoadmapActionFields( required array phases, required struct plan ) {
		var allowedClassification = [
			"remain-monolith", "refactor-monolith", "coldbox-module", "background-worker",
			"scheduled-service", "microservice", "external-service", "shared-library", "retire", "investigate"
		];
		var placementByUnit = {};
		for ( var placement in ( isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.placements ?: "" ) ? arguments.plan.target.placements : [] ) ) {
			if ( !isStruct( placement ) ) continue;
			var placementType = lCase( trim( placement.placementType ?: placement.packaging ?: "" ) );
			for ( var unitId in ( isArray( placement.targetUnitIds ?: "" ) ? placement.targetUnitIds : [] ) ) {
				var key = trim( toString( unitId ) );
				if ( len( key ) && !placementByUnit.keyExists( key ) ) placementByUnit[ key ] = placementType;
			}
		}
		var output = [];
		var waveIndex = 0;
		for ( var phase in arguments.phases ) {
			if ( !isStruct( phase ) ) continue;
			var copy = duplicate( phase );
			waveIndex++;
			var classification = lCase( trim( toString( copy.classification ?: "" ) ) );
			if ( !allowedClassification.contains( classification ) ) {
				var inferred = "refactor-monolith";
				for ( var phaseUnitId in ( isArray( copy.unitIds ?: "" ) ? copy.unitIds : [] ) ) {
					var mapped = placementByUnit[ trim( toString( phaseUnitId ) ) ] ?: "";
					if ( len( mapped ) ) {
						inferred = derivedStructureService.synthesizeRoadmapClassification( mapped );
						break;
					}
				}
				copy.classification = inferred;
			}
			if ( !isNumeric( copy.wave ?: "" ) || val( copy.wave ) < 1 ) {
				copy.wave = waveIndex;
			} else {
				copy.wave = max( 1, min( 20, int( copy.wave ) ) );
			}
			var complexity = lCase( trim( toString( copy.estimatedComplexity ?: "" ) ) );
			if ( ![ "low", "medium", "high", "unknown" ].contains( complexity ) ) {
				var unitCount = isArray( copy.unitIds ?: "" ) ? copy.unitIds.len() : 0;
				copy.estimatedComplexity = unitCount > 40 ? "high" : ( unitCount > 15 ? "medium" : ( unitCount > 0 ? "low" : "unknown" ) );
			}
			if ( !isArray( copy.risks ?: "" ) || !copy.risks.len() ) {
				copy.risks = [ "Parity and coexist routing may regress if this wave advances without exitCriteria checks." ];
			} else {
				copy.risks = copy.risks.filter( ( item ) => isSimpleValue( item ) && len( trim( toString( item ) ) ) )
					.map( ( item ) => trim( toString( item ) ) );
				if ( !copy.risks.len() ) copy.risks = [ "Parity and coexist routing may regress if this wave advances without exitCriteria checks." ];
			}
			if ( !len( trim( toString( copy.rollbackStrategy ?: "" ) ) ) ) {
				copy.rollbackStrategy = len( trim( toString( copy.rollback ?: "" ) ) )
					? trim( toString( copy.rollback ) )
					: "Route traffic back to legacy paths for this slice until exitCriteria pass.";
			}
			if ( !len( trim( toString( copy.testingStrategy ?: "" ) ) ) ) {
				copy.testingStrategy = "Parity checks for linked target units, coexist route smoke, and a rollback drill before advancing.";
			}
			output.append( copy );
		}
		return output;
	}

	private array function normalizeRouteContracts( required array routes ) {
		var output = [];
		for ( var route in arguments.routes ) {
			if ( !isStruct( route ) ) continue;
			var copy = duplicate( route );
			var routeRequest = isStruct( copy.request ?: "" ) ? copy.request : {};
			// Provider (and repair) output is untrusted and can return an array
			// where a scalar string is expected (e.g. method: ["GET","POST"]);
			// coerce defensively before trim() rather than crashing the run.
			var path = trim( scalarString( copy.path ?: copy.legacyPath ?: routeRequest.path ?: "" ) );
			path = replace( path, "\", "/", "all" );
			if ( len( path ) && left( path, 1 ) != "/" ) path = "/" & path;
			copy.path = path;
			if ( !len( trim( scalarString( copy.legacyPath ?: "" ) ) ) ) copy.legacyPath = path;
			if ( !len( trim( scalarString( copy.method ?: "" ) ) ) ) copy.method = uCase( trim( scalarString( routeRequest.method ?: "GET" ) ) );
			else copy.method = uCase( trim( scalarString( copy.method ) ) );
			if ( !structKeyExists( copy, "rollback" ) || !len( trim( scalarString( copy.rollback ?: "" ) ) ) ) {
				copy.rollback = trim( scalarString( copy.rollbackNote ?: copy.rollbackIntent ?: copy.rollbackPlan ?: "Revert this route to the legacy path and remove the ColdBox mapping." ) );
			}
			if ( !isStruct( copy.request ?: "" ) ) copy.request = { method: copy.method, path: copy.path };
			else {
				if ( !len( trim( scalarString( copy.request.path ?: "" ) ) ) ) copy.request.path = copy.path;
				if ( !len( trim( scalarString( copy.request.method ?: "" ) ) ) ) copy.request.method = copy.method;
			}
			if ( !structKeyExists( copy, "response" ) ) copy.response = { contentType: "text/html" };
			if ( !structKeyExists( copy, "auth" ) ) copy.auth = "unknown";
			if ( !structKeyExists( copy, "sideEffects" ) ) copy.sideEffects = [];
			if ( !isArray( copy.evidence ?: "" ) ) {
				var refs = copy.evidenceRefs ?: [];
				copy.evidence = isArray( refs ) ? refs : ( len( trim( toString( refs ) ) ) ? [ refs ] : [] );
			}
			if ( !copy.evidence.len() ) copy.validationStatus = "needs-review";
			if ( !isArray( copy.evidenceRefs ?: "" ) || !copy.evidenceRefs.len() ) copy.evidenceRefs = copy.evidence;
			output.append( copy );
		}
		return output;
	}

	private array function normalizeRoadmapReferences( required struct plan, array errors = [] ) {
		var unitIds = {};
		var unitsById = {};
		var routeIds = {};
		var findingIds = {};
		var transitionIds = {};
		var sampleIds = {};
		for ( var item in ( isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [] ) ) {
			unitIds[ trim( item.id ?: item.itemId ?: "" ) ] = true;
			unitsById[ trim( item.id ?: item.itemId ?: "" ) ] = item;
		}
		for ( var item in ( isArray( arguments.plan.routeContracts ?: "" ) ? arguments.plan.routeContracts : [] ) ) routeIds[ trim( item.id ?: item.itemId ?: "" ) ] = true;
		for ( var item in ( isArray( arguments.plan.dbFindings ?: "" ) ? arguments.plan.dbFindings : [] ) ) findingIds[ trim( item.id ?: item.itemId ?: "" ) ] = true;
		for ( var item in ( isArray( arguments.plan.dbTransitions ?: "" ) ? arguments.plan.dbTransitions : [] ) ) transitionIds[ trim( item.id ?: item.itemId ?: "" ) ] = true;
		for ( var item in ( isArray( arguments.plan.samples ?: "" ) ? arguments.plan.samples : [] ) ) sampleIds[ trim( item.id ?: item.itemId ?: "" ) ] = true;
		var output = [];
		for ( var phase in ( isArray( arguments.plan.roadmapPhases ?: "" ) ? arguments.plan.roadmapPhases : [] ) ) {
			if ( !isStruct( phase ) ) continue;
			var copy = duplicate( phase );
			var normalizedUnits = [];
			var normalizedRoutes = validIds( copy.routeIds ?: [], routeIds );
			for ( var id in ( isArray( copy.unitIds ?: "" ) ? copy.unitIds : [] ) ) {
				var key = trim( toString( id ) );
				if ( unitIds.keyExists( key ) ) normalizedUnits.append( key );
				else if ( routeIds.keyExists( key ) && !arrayContainsNoCase( normalizedRoutes, key ) ) normalizedRoutes.append( key );
				else if ( len( key ) ) arguments.errors.append( { role: "modernization-roadmap", message: "dropped-unknown-reference", severity: "info", phaseId: copy.id ?: "", reference: key } );
			}
			copy.unitIds = normalizedUnits;
			copy.routeIds = normalizedRoutes;
			copy.dbFindingIds = validIds( copy.dbFindingIds ?: [], findingIds );
			copy.transitionIds = validIds( copy.transitionIds ?: [], transitionIds );
			copy.sampleIds = validIds( copy.sampleIds ?: [], sampleIds );
			output.append( copy );
		}
		return linkDatabaseWorkToPhases( arguments.plan, output, unitsById, arguments.errors );
	}

	/**
	 * Attaches database findings/transitions to the roadmap phase that touches
	 * the same data.
	 *
	 * The roadmap role is sharded over target-unit groups and does not receive
	 * the database ledger, so its phases came back with empty dbFindingIds and
	 * transitionIds and the whole database plan sat orphaned beside the roadmap.
	 * Matching a schema object name against the legacy paths in a phase is
	 * deterministic and evidence-backed; anything still unmatched is attached to
	 * the first phase so no database work is silently unscheduled.
	 */
	private array function linkDatabaseWorkToPhases(
		required struct plan,
		required array phases,
		required struct unitsById,
		array errors = []
	) {
		if ( !arguments.phases.len() ) return arguments.phases;
		var findings = isArray( arguments.plan.dbFindings ?: "" ) ? arguments.plan.dbFindings : [];
		var transitions = isArray( arguments.plan.dbTransitions ?: "" ) ? arguments.plan.dbTransitions : [];
		if ( !findings.len() && !transitions.len() ) return arguments.phases;

		var haystacks = [];
		for ( var phase in arguments.phases ) {
			var phaseUnits = [];
			for ( var unitId in ( isArray( phase.unitIds ?: "" ) ? phase.unitIds : [] ) ) {
				var unit = arguments.unitsById[ trim( toString( unitId ) ) ] ?: {};
				if ( isStruct( unit ) && unit.count() ) phaseUnits.append( unit );
			}
			var label = reReplace( lCase( trim( toString( phase.name ?: "" ) ) & " " & trim( toString( phase.goal ?: "" ) ) ), "[^a-z0-9]+", " ", "all" );
			haystacks.append( label & " " & pathHaystackForUnits( phaseUnits ) );
		}

		var linkedFindings = 0;
		var linkedTransitions = 0;
		var attachOrphan = 0;
		var buckets = [
			{ items: findings, field: "dbFindingIds" },
			{ items: transitions, field: "transitionIds" }
		];
		for ( var bucket in buckets ) {
			for ( var item in bucket.items ) {
				if ( !isStruct( item ) ) continue;
				var itemId = trim( toString( item.id ?: item.itemId ?: "" ) );
				if ( !len( itemId ) ) continue;
				// Already scheduled by the provider — leave it alone.
				var alreadyScheduled = false;
				for ( var existing in arguments.phases ) {
					if ( arrayContainsNoCase( isArray( existing[ bucket.field ] ?: "" ) ? existing[ bucket.field ] : [], itemId ) ) {
						alreadyScheduled = true;
						break;
					}
				}
				if ( alreadyScheduled ) continue;
				var matchedIndex = 0;
				for ( var objectName in objectNamesForDbItem( item ) ) {
					for ( var haystackIndex = 1; haystackIndex <= haystacks.len(); haystackIndex++ ) {
						if ( objectMatchesHaystack( objectName, haystacks[ haystackIndex ] ) ) {
							matchedIndex = haystackIndex;
							break;
						}
					}
					if ( matchedIndex ) break;
				}
				if ( !matchedIndex ) {
					matchedIndex = 1;
					attachOrphan++;
				}
				if ( !isArray( arguments.phases[ matchedIndex ][ bucket.field ] ?: "" ) ) arguments.phases[ matchedIndex ][ bucket.field ] = [];
				arguments.phases[ matchedIndex ][ bucket.field ].append( itemId );
				if ( bucket.field == "transitionIds" ) linkedTransitions++;
				else linkedFindings++;
			}
		}

		if ( linkedFindings || linkedTransitions ) {
			arguments.errors.append( {
				role: "modernization-roadmap",
				message: "linked-database-work-to-phases",
				severity: "info",
				findings: linkedFindings,
				transitions: linkedTransitions,
				unmatchedAttachedToFirstPhase: attachOrphan
			} );
		}
		return arguments.phases;
	}

	private array function validIds( required any values, required struct lookup ) {
		var output = [];
		if ( !isArray( arguments.values ) ) return output;
		for ( var value in arguments.values ) {
			var key = trim( toString( value ) );
			if ( len( key ) && arguments.lookup.keyExists( key ) && !arrayContainsNoCase( output, key ) ) output.append( key );
		}
		return output;
	}

	private array function dedupeSimpleValues( required any values ) {
		var output = [];
		var seen = {};
		if ( !isArray( arguments.values ) ) return output;
		for ( var value in arguments.values ) {
			var text = trim( isSimpleValue( value ) ? toString( value ) : jsonSerialize( value ) );
			var key = lCase( text );
			if ( !len( key ) || seen.keyExists( key ) ) continue;
			seen[ key ] = true;
			output.append( value );
		}
		return output;
	}

	private array function normalizeSamples( required array samples, required any runtime ) {
		var runtimeName = lCase( trim( isStruct( arguments.runtime ) ? ( arguments.runtime.runtime ?: "" ) : toString( arguments.runtime ) ) );
		var output = [];
		for ( var sample in arguments.samples ) {
			if ( !isStruct( sample ) ) continue;
			var copy = duplicate( sample );
			if ( !structKeyExists( copy, "code" ) ) copy.code = copy.sampleCode ?: copy.body ?: "";
			var kind = lCase( trim( scalarString( copy.sampleKind ?: copy.kind ?: "" ) ) );
			var path = replace( trim( scalarString( copy.targetPath ?: copy.path ?: "" ) ), "\", "/", "all" );
			if ( runtimeName == "boxlang" && kind != "migration" && len( path ) ) {
				var isView = findNoCase( "/views/", "/" & path ) || findNoCase( "/layouts/", "/" & path );
				path = reReplaceNoCase( path, "\.(?:cfc|cfm|cfml|bx|bxm)$", isView ? ".bxm" : ".bx" );
				copy.targetPath = path;
				copy.language = "boxlang";
			}
			output.append( copy );
		}
		return output;
	}

	private struct function resolveInventoryReferences( required struct plan ) {
		var inventory = isStruct( arguments.plan.inventory ?: "" ) ? arguments.plan.inventory : {};
		var units = isArray( inventory.units ?: "" ) ? inventory.units : [];
		var lookup = buildInventoryLookup( units );
		for ( var target in ( isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [] ) ) {
			if ( !isStruct( target ) ) continue;
			var sourcePath = normalizeEvidencePath( target.sourcePath ?: target.sourceFile ?: target.legacyPath ?: "" );
			var legacyIds = [];
			for ( var legacyId in ( isArray( target.legacyUnitIds ?: "" ) ? target.legacyUnitIds : [] ) ) {
				var resolved = resolveInventoryToken( legacyId, sourcePath, lookup );
				if ( len( resolved ) && !arrayContainsNoCase( legacyIds, resolved ) ) legacyIds.append( resolved );
			}
			if ( !legacyIds.len() && len( sourcePath ) ) {
				var preferred = preferredInventoryIdForPath( sourcePath, lookup );
				if ( len( preferred ) ) legacyIds.append( preferred );
			}
			if ( legacyIds.len() ) target.legacyUnitIds = legacyIds;
			if ( legacyIds.len() && ( !len( sourcePath ) || !lookup.byPath.keyExists( sourcePath ) ) ) {
				var canonicalPaths = [];
				for ( var resolvedId in legacyIds ) {
					if ( !lookup.byId.keyExists( resolvedId ) ) continue;
					var canonicalPath = normalizeEvidencePath( lookup.byId[ resolvedId ].filePath ?: "" );
					if ( len( canonicalPath ) && !arrayContainsNoCase( canonicalPaths, canonicalPath ) ) canonicalPaths.append( canonicalPath );
				}
				if ( canonicalPaths.len() ) target.sourcePath = canonicalPaths.toList( ", " );
			}
			if ( len( sourcePath ) && lookup.byPath.keyExists( sourcePath ) && ( target.newProposal ?: false ) ) {
				structDelete( target, "newProposal" );
				if ( structKeyExists( target, "proposalReason" ) && findNoCase( "without a legacy source path", target.proposalReason ?: "" ) ) structDelete( target, "proposalReason" );
			}
			var inventoryBacked = legacyIds.len() > 0 || ( len( sourcePath ) && lookup.byPath.keyExists( sourcePath ) );
			if ( !inventoryBacked && !( target.newProposal ?: false ) && !( target.explicitProposal ?: false ) && !len( trim( target.proposalReason ?: "" ) ) ) {
				target.newProposal = true;
				target.proposalReason = len( sourcePath )
					? "Proposed target could not be matched to indexed inventory; treat as an explicit scaffold"
					: "Provider proposed a scaffold target without a legacy source path";
			}
		}
		for ( var link in ( isArray( arguments.plan.unitLinks ?: "" ) ? arguments.plan.unitLinks : [] ) ) {
			if ( !isStruct( link ) ) continue;
			var hint = "";
			for ( var targetUnit in ( isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [] ) ) {
				if ( ( targetUnit.id ?: "" ) == ( link.targetUnitId ?: "" ) ) {
					hint = normalizeEvidencePath( targetUnit.sourcePath ?: "" );
					break;
				}
			}
			if ( !len( hint ) ) hint = normalizeEvidencePath( link.sourcePath ?: link.sourceFile ?: link.filePath ?: link.legacyUnitId ?: "" );
			var resolvedLink = resolveInventoryToken( link.legacyUnitId ?: link.sourceUnitId ?: "", hint, lookup );
			if ( len( resolvedLink ) ) {
				link.legacyUnitId = resolvedLink;
				var currentLinkSource = normalizeEvidencePath( link.sourcePath ?: "" );
				if ( lookup.byId.keyExists( resolvedLink ) && ( !len( currentLinkSource ) || !lookup.byPath.keyExists( currentLinkSource ) ) ) {
					link.sourcePath = normalizeEvidencePath( lookup.byId[ resolvedLink ].filePath ?: "" );
				}
			} else {
				structDelete( link, "legacyUnitId" );
				link.newProposal = true;
				if ( !isArray( link.evidenceRefs ?: "" ) || !link.evidenceRefs.len() ) {
					link.evidenceRefs = [ { extractionMethod: "new-proposal", note: "Scaffold link without resolvable legacy unit" } ];
				}
			}
			if ( ( !isArray( link.evidence ?: "" ) || !link.evidence.len() ) && ( !isArray( link.evidenceRefs ?: "" ) || !link.evidenceRefs.len() ) ) {
				var evidencePath = normalizeEvidencePath( link.sourcePath ?: hint ?: "" );
				link.evidence = len( evidencePath )
					? [ { filePath: evidencePath, extractionMethod: "inventory-resolve" } ]
					: [ { extractionMethod: "new-proposal", note: "Unit link retained without file evidence" } ];
				link.evidenceRefs = link.evidence;
			} else if ( !isArray( link.evidence ?: "" ) || !link.evidence.len() ) {
				link.evidence = link.evidenceRefs;
			} else if ( !isArray( link.evidenceRefs ?: "" ) || !link.evidenceRefs.len() ) {
				link.evidenceRefs = link.evidence;
			}
			if ( isArray( link.evidenceRefs ?: "" ) ) {
				var rewritten = [];
				for ( var evidenceRef in link.evidenceRefs ) {
					var resolvedEvidence = resolveInventoryToken( evidenceRef, hint, lookup );
					if ( len( resolvedEvidence ) && !arrayContainsNoCase( rewritten, resolvedEvidence ) ) rewritten.append( resolvedEvidence );
				}
				if ( !rewritten.len() && len( resolvedLink ) ) rewritten.append( resolvedLink );
				link.evidenceRefs = rewritten;
			}
			if ( len( resolvedLink ) && lookup.byId.keyExists( resolvedLink ) ) {
				var canonicalLinkPath = normalizeEvidencePath( lookup.byId[ resolvedLink ].filePath ?: "" );
				var validEvidence = [];
				for ( var evidenceItem in ( isArray( link.evidence ?: "" ) ? link.evidence : [] ) ) {
					var evidencePath = normalizeEvidencePath( isStruct( evidenceItem ) ? ( evidenceItem.filePath ?: evidenceItem.path ?: "" ) : toString( evidenceItem ) );
					if ( len( evidencePath ) && lookup.byPath.keyExists( evidencePath ) ) validEvidence.append( evidenceItem );
				}
				if ( !validEvidence.len() && len( canonicalLinkPath ) ) {
					validEvidence = [ { filePath: canonicalLinkPath, extractionMethod: "inventory-resolve" } ];
				}
				link.evidence = validEvidence;
			}
		}
		for ( var route in ( isArray( arguments.plan.routeContracts ?: "" ) ? arguments.plan.routeContracts : [] ) ) {
			if ( !isStruct( route ) || !isArray( route.evidence ?: "" ) ) continue;
			var rewrittenEvidence = [];
			for ( var evidenceItem in route.evidence ) {
				var resolvedRouteEvidence = resolveInventoryToken( evidenceItem, "", lookup );
				rewrittenEvidence.append( len( resolvedRouteEvidence ) ? resolvedRouteEvidence : evidenceItem );
			}
			route.evidence = rewrittenEvidence;
		}
		return arguments.plan;
	}

	private struct function buildInventoryLookup( required array units ) {
		var byId = {};
		var byPath = {};
		var byBasename = {};
		var byHashPrefix = {};
		for ( var unit in arguments.units ) {
			if ( !isStruct( unit ) ) continue;
			var id = trim( unit.id ?: unit.itemId ?: "" );
			var path = normalizeEvidencePath( unit.filePath ?: unit.path ?: "" );
			if ( len( id ) ) byId[ id ] = unit;
			if ( len( path ) ) {
				if ( !byPath.keyExists( path ) ) byPath[ path ] = [];
				byPath[ path ].append( unit );
				var base = listLast( path, "/" );
				if ( len( base ) ) {
					if ( !byBasename.keyExists( base ) ) byBasename[ base ] = [];
					byBasename[ base ].append( unit );
				}
			}
			for ( var ref in ( isArray( unit.evidenceRefs ?: "" ) ? unit.evidenceRefs : [] ) ) {
				var hashValue = lCase( trim( isStruct( ref ) ? ( ref.contentHash ?: "" ) : toString( ref ) ) );
				if ( len( hashValue ) >= 16 ) byHashPrefix[ left( hashValue, 16 ) ] = unit;
				if ( len( hashValue ) >= 32 ) byHashPrefix[ left( hashValue, 32 ) ] = unit;
			}
			if ( len( id ) >= 16 ) byHashPrefix[ left( lCase( id ), 16 ) ] = unit;
		}
		return { byId: byId, byPath: byPath, byBasename: byBasename, byHashPrefix: byHashPrefix };
	}

	private string function preferredInventoryIdForPath( required string path, required struct lookup ) {
		var normalized = normalizeEvidencePath( arguments.path );
		if ( !len( normalized ) ) return "";
		var candidates = [];
		if ( arguments.lookup.byPath.keyExists( normalized ) ) candidates = arguments.lookup.byPath[ normalized ];
		else {
			var base = listLast( normalized, "/" );
			if ( len( base ) && arguments.lookup.byBasename.keyExists( base ) ) candidates = arguments.lookup.byBasename[ base ];
		}
		if ( !candidates.len() ) return "";
		var best = candidates[ 1 ];
		for ( var candidate in candidates ) {
			var bestScore = inventoryUnitScore( best );
			var candidateScore = inventoryUnitScore( candidate );
			if ( candidateScore > bestScore || ( candidateScore == bestScore && val( candidate.startLine ?: 0 ) < val( best.startLine ?: 0 ) ) ) best = candidate;
		}
		return trim( best.id ?: best.itemId ?: "" );
	}

	private string function resolveInventoryToken( required any token, required string hintPath, required struct lookup ) {
		var raw = trim( isStruct( arguments.token ) ? ( arguments.token.id ?: arguments.token.filePath ?: arguments.token.path ?: "" ) : toString( arguments.token ) );
		if ( !len( raw ) ) return "";
		if ( [ "new-proposal", "new", "none", "n/a", "-" ].contains( lCase( raw ) ) ) return "";
		if ( arguments.lookup.byId.keyExists( raw ) ) return raw;
		var asPath = normalizeEvidencePath( raw );
		if ( len( asPath ) ) {
			var fromPath = preferredInventoryIdForPath( asPath, arguments.lookup );
			if ( len( fromPath ) ) return fromPath;
		}
		if ( len( trim( arguments.hintPath ) ) ) {
			var fromHint = preferredInventoryIdForPath( arguments.hintPath, arguments.lookup );
			if ( len( fromHint ) ) return fromHint;
		}
		var compact = lCase( reReplace( raw, "[^a-f0-9]", "", "all" ) );
		if ( len( compact ) >= 16 && arguments.lookup.byHashPrefix.keyExists( left( compact, 16 ) ) ) return trim( arguments.lookup.byHashPrefix[ left( compact, 16 ) ].id ?: "" );
		if ( len( compact ) >= 32 && arguments.lookup.byHashPrefix.keyExists( left( compact, 32 ) ) ) return trim( arguments.lookup.byHashPrefix[ left( compact, 32 ) ].id ?: "" );
		// Drop unresolved hash-like tokens so validation does not keep dead IDs.
		if ( len( compact ) >= 16 && compact == lCase( raw ) ) return "";
		if ( find( "/", asPath ) || reFindNoCase( "\.(cfm|cfc|bx|bxm)$", asPath ) ) return raw;
		return "";
	}

	private array function dedupeById( required array items ) {
		var seen = {};
		var output = [];
		for ( var item in arguments.items ) {
			if ( !isStruct( item ) ) continue;
			var id = trim( item.id ?: item.itemId ?: "" );
			if ( len( id ) && seen.keyExists( id ) ) continue;
			if ( len( id ) ) seen[ id ] = true;
			output.append( item );
		}
		return output;
	}

	private boolean function arrayContainsNoCase( required array values, required string needle ) {
		for ( var value in arguments.values ) if ( compareNoCase( toString( value ), arguments.needle ) == 0 ) return true;
		return false;
	}

	private numeric function inventoryUnitScore( required struct unit ) {
		var kind = lCase( trim( scalarString( arguments.unit.unitType ?: arguments.unit.layer ?: "" ) ) );
		if ( kind == "page" || kind == "application" ) return 3;
		if ( kind == "component" || kind == "custom-tag" ) return 2;
		return 1;
	}

	private string function normalizeEvidencePath( required any path ) {
		return lCase( replace( trim( scalarString( arguments.path ) ), "\", "/", "all" ) );
	}

	private array function orderRoadmapPhases( required array phases ) {
		var list = [];
		for ( var phase in arguments.phases ) if ( isStruct( phase ) ) list.append( phase );
		if ( list.len() < 2 ) return list;
		var hasDeps = false;
		for ( var phase in list ) {
			if ( isArray( phase.dependencies ?: "" ) && phase.dependencies.len() ) { hasDeps = true; break; }
		}
		if ( !hasDeps ) {
			list.sort( ( first, second ) => compareNoCase( identityKey( first ), identityKey( second ) ) );
			return list;
		}
		var byId = {};
		for ( var phase in list ) byId[ trim( phase.id ?: phase.itemId ?: "" ) ] = phase;
		var visiting = {};
		var seen = {};
		var ordered = [];
		for ( var phase in list ) appendPhaseInDependencyOrder( phase.id ?: phase.itemId ?: "", byId, visiting, seen, ordered );
		for ( var phase in list ) {
			var leftover = trim( phase.id ?: phase.itemId ?: "" );
			if ( !seen.keyExists( leftover ) ) ordered.append( phase );
		}
		return ordered;
	}

	private void function appendPhaseInDependencyOrder(
		required string id,
		required struct byId,
		required struct visiting,
		required struct seen,
		required array ordered
	) {
		var key = trim( arguments.id );
		if ( !len( key ) || arguments.seen.keyExists( key ) || !arguments.byId.keyExists( key ) ) return;
		if ( arguments.visiting.keyExists( key ) ) return;
		arguments.visiting[ key ] = true;
		var node = arguments.byId[ key ];
		for ( var dependency in ( isArray( node.dependencies ?: "" ) ? node.dependencies : [] ) ) {
			appendPhaseInDependencyOrder( dependency, arguments.byId, arguments.visiting, arguments.seen, arguments.ordered );
		}
		structDelete( arguments.visiting, key );
		arguments.seen[ key ] = true;
		arguments.ordered.append( node );
	}

	private array function ensureCurrentSlice( required array phases ) {
		var list = [];
		for ( var phase in arguments.phases ) if ( isStruct( phase ) ) list.append( duplicate( phase ) );
		if ( !list.len() ) return list;
		var hasCurrent = false;
		for ( var phase in list ) if ( phase.currentSlice ?: false ) { hasCurrent = true; break; }
		if ( hasCurrent ) return list;
		var pick = 0;
		for ( var index = 1; index <= list.len(); index++ ) {
			var candidate = list[ index ];
			var linked = ( isArray( candidate.unitIds ?: "" ) && candidate.unitIds.len() ) || ( isArray( candidate.routeIds ?: "" ) && candidate.routeIds.len() );
			var pattern = lCase( trim( candidate.pattern ?: "" ) );
			if ( linked && ( pattern == "vertical-slice" || pattern == "coexist-route" || findNoCase( "slice", pattern ) ) ) { pick = index; break; }
			if ( !pick && linked ) pick = index;
		}
		if ( !pick ) pick = 1;
		list[ pick ].currentSlice = true;
		return list;
	}

	private array function currentSliceSamples( required array samples, required array phases, array units = [] ) {
		var currentPhaseIds = {};
		var allowedSampleIds = {};
		var currentUnitIds = {};
		for ( var phase in arguments.phases ) {
			if ( !isStruct( phase ) || !( phase.currentSlice ?: false ) ) continue;
			currentPhaseIds[ phase.id ?: phase.itemId ?: "" ] = true;
			for ( var sampleId in ( isArray( phase.sampleIds ?: "" ) ? phase.sampleIds : [] ) ) allowedSampleIds[ trim( sampleId ) ] = true;
			for ( var unitId in ( isArray( phase.unitIds ?: "" ) ? phase.unitIds : ( isArray( phase.targetUnitIds ?: "" ) ? phase.targetUnitIds : [] ) ) ) {
				currentUnitIds[ trim( toString( unitId ) ) ] = true;
			}
		}
		var output = [];
		for ( var sample in arguments.samples ) {
			if ( !isStruct( sample ) ) continue;
			var phaseId = sample.phaseId ?: sample.roadmapPhaseId ?: "";
			var sampleId = trim( sample.id ?: sample.itemId ?: "" );
			if ( sample.currentSlice ?: false || ( len( phaseId ) && currentPhaseIds.keyExists( phaseId ) ) || ( len( sampleId ) && allowedSampleIds.keyExists( sampleId ) ) ) {
				output.append( sample );
				continue;
			}
			// Keep provider samples that already relate to current-slice units
			// even when phases omitted sampleIds (common on roadmap shards).
			var related = isArray( sample.relatedItemIds ?: "" ) ? sample.relatedItemIds : [];
			var relatedToCurrent = false;
			for ( var relatedId in related ) {
				if ( currentUnitIds.keyExists( trim( toString( relatedId ) ) ) ) {
					relatedToCurrent = true;
					break;
				}
			}
			if ( relatedToCurrent ) output.append( sample );
		}
		return output;
	}

	/**
	 * Promote inline targetUnit.sampleCode into the samples collection when
	 * providers returned code on units but left samples empty.
	 */
	private array function liftUnitSampleCode( required array samples, required array units ) {
		var output = isArray( arguments.samples ) ? duplicate( arguments.samples ) : [];
		var seenPaths = {};
		for ( var existing in output ) {
			var path = lCase( replace( trim( toString( existing.targetPath ?: existing.path ?: "" ) ), "\", "/", "all" ) );
			if ( len( path ) ) seenPaths[ path ] = true;
		}
		for ( var unit in arguments.units ) {
			if ( !isStruct( unit ) ) continue;
			var code = trim( toString( unit.sampleCode ?: "" ) );
			if ( !len( code ) ) continue;
			var targetPath = replace( trim( toString( unit.targetPath ?: "" ) ), "\", "/", "all" );
			if ( !len( targetPath ) || seenPaths.keyExists( lCase( targetPath ) ) ) continue;
			var unitId = trim( toString( unit.id ?: unit.itemId ?: "" ) );
			output.append( {
				id: "lifted-sample-#left( hash( targetPath & "|" & unitId, 'SHA-256' ), 12 )#",
				sampleKind: "app",
				targetPath: targetPath,
				language: reFindNoCase( "\.(bx|bxm)$", targetPath ) ? "boxlang" : "cfml",
				code: left( code, 4000 ),
				relatedItemIds: len( unitId ) ? [ unitId ] : [],
				irreversible: false,
				provenanceClass: "provider-suggested"
			} );
			seenPaths[ lCase( targetPath ) ] = true;
			if ( output.len() >= 40 ) break;
		}
		return output;
	}

	/**
	 * When current-slice phases have units but samples were pruned or never
	 * returned, emit bounded deterministic skeletons labeled honestly.
	 */
	private array function ensureActionableSamples( required struct plan, struct samplePolicy = {}, array errors = [] ) {
		var samples = isArray( arguments.plan.samples ?: "" ) ? arguments.plan.samples : [];
		if ( samples.len() ) return samples;
		var phases = isArray( arguments.plan.roadmapPhases ?: "" ) ? arguments.plan.roadmapPhases : [];
		var unitsById = {};
		for ( var unit in ( isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [] ) ) {
			var unitId = trim( toString( unit.id ?: unit.itemId ?: "" ) );
			if ( len( unitId ) ) unitsById[ unitId ] = unit;
		}
		var maxSamples = isNumeric( arguments.samplePolicy.maxFiles ?: "" ) ? max( 1, min( 8, int( arguments.samplePolicy.maxFiles ) ) ) : 6;
		var generated = [];
		for ( var phase in phases ) {
			if ( !isStruct( phase ) || !( phase.currentSlice ?: false ) ) continue;
			var phaseId = trim( toString( phase.id ?: phase.itemId ?: "" ) );
			for ( var rawUnitId in ( isArray( phase.unitIds ?: "" ) ? phase.unitIds : [] ) ) {
				if ( generated.len() >= maxSamples ) break;
				var id = trim( toString( rawUnitId ) );
				if ( !len( id ) || !unitsById.keyExists( id ) ) continue;
				var unit = unitsById[ id ];
				var targetPath = replace( trim( toString( unit.targetPath ?: "" ) ), "\", "/", "all" );
				if ( !len( targetPath ) ) continue;
				var layer = lCase( trim( toString( unit.layer ?: unit.kind ?: "handler" ) ) );
				var isView = [ "view", "layout" ].contains( layer ) || findNoCase( "/views/", "/" & targetPath );
				var language = reFindNoCase( "\.(bx|bxm)$", targetPath ) ? "boxlang" : "cfml";
				var nl = char( 10 );
				var skeleton = language == "boxlang"
					? ( isView ? "<bx:output>#nl#  <!--- Deterministic sample skeleton for #targetPath# — not observed source. --->#nl#</bx:output>" : "class {#nl#  // Deterministic sample skeleton for #targetPath# — not observed source.#nl#}" )
					: ( isView ? "<cfoutput>#nl#  <!--- Deterministic sample skeleton for #targetPath# — not observed source. --->#nl#</cfoutput>" : "component {#nl#  // Deterministic sample skeleton for #targetPath# — not observed source.#nl#}" );
				var sampleId = "synth-sample-#left( hash( phaseId & "|" & id, 'SHA-256' ), 12 )#";
				generated.append( {
					id: sampleId,
					sampleKind: isView ? "view" : "app",
					targetPath: targetPath,
					language: language,
					code: skeleton,
					relatedItemIds: [ id ],
					irreversible: false,
					phaseId: phaseId,
					currentSlice: true,
					provenanceClass: "deterministically-derived"
				} );
			}
			if ( generated.len() ) {
				phase.sampleIds = generated.map( ( item ) => item.id );
			}
		}
		if ( generated.len() ) {
			arguments.errors.append( {
				role: "modernization",
				message: "synthesized-current-slice-samples",
				severity: "info",
				count: generated.len()
			} );
			arguments.plan.samples = generated;
			return generated;
		}
		return samples;
	}

	/**
	 * Deterministic database fragment from observed schemaEvidence when the
	 * provider truncates or fails. Labeled provenanceClass so UI/validation
	 * never pretends these were model-authored.
	 */
	private struct function synthesizeDatabaseFragment( required any schemaEvidence ) {
		var schema = isStruct( arguments.schemaEvidence ) ? arguments.schemaEvidence : {};
		var tables = [];
		if ( isArray( schema.tables ?: "" ) ) tables = schema.tables;
		else if ( isArray( schema.objects ?: "" ) ) tables = schema.objects;
		else if ( isStruct( schema.database ?: "" ) && isArray( schema.database.tables ?: "" ) ) tables = schema.database.tables;
		if ( !tables.len() && ( schema.coverage ?: "absent" ) == "absent" ) {
			return { dbFindings: [], dbTransitions: [], samples: [] };
		}
		var findings = [];
		var transitions = [];
		var order = 1;
		for ( var table in tables ) {
			if ( findings.len() >= 20 ) break;
			var name = isStruct( table ) ? trim( toString( table.name ?: table.objectRef ?: "" ) ) : trim( toString( table ) );
			if ( !len( name ) ) continue;
			var slug = reReplace( lCase( name ), "[^a-z0-9]+", "_", "all" );
			var findingId = "synth-db-finding-#slug#";
			findings.append( {
				id: findingId,
				category: "coverage",
				severity: "info",
				objectRef: name,
				problem: "Observed table `#name#` needs an expand/contract migration plan during strangler modernization.",
				proposedChange: "Inventory readers/writers and stage an expand-contract migration for `#name#`.",
				expandContract: "expand",
				relatedLegacyUnitIds: [],
				relatedTargetUnitIds: [],
				evidenceRefs: [],
				confidence: 0.45,
				validationStatus: "needs-review",
				provenanceClass: "deterministically-derived"
			} );
			transitions.append( {
				id: "synth-db-transition-#slug#",
				dbFindingId: findingId,
				operation: "expand",
				order: order++,
				migrationPath: "resources/database/migrations/YYYY_MM_DD_HHMMSS_expand_#slug#.bx",
				objectsTouched: [ name ],
				sampleMigration: "component {" & char( 10 ) & "  function up( schema, query ) {" & char( 10 ) & "    // expand `" & name & "` — generated from observed DDL, not executed" & char( 10 ) & "  }" & char( 10 ) & "  function down( schema, query ) {" & char( 10 ) & "    // review before contracting `" & name & "`" & char( 10 ) & "  }" & char( 10 ) & "}",
				rollback: "Review expand before any contract step for `#name#`.",
				irreversible: false,
				evidenceRefs: [],
				provenanceClass: "deterministically-derived"
			} );
		}
		if ( !findings.len() && ( schema.coverage ?: "" ) != "absent" ) {
			findings.append( {
				id: "synth-db-finding-schema-present",
				category: "coverage",
				severity: "info",
				objectRef: "schema",
				problem: "Schema evidence was observed but table names could not be enumerated for a provider fragment.",
				proposedChange: "Retry the database stage with a smaller schema pack or raise max tokens.",
				expandContract: "defer",
				relatedLegacyUnitIds: [],
				relatedTargetUnitIds: [],
				evidenceRefs: [],
				confidence: 0.3,
				validationStatus: "needs-review",
				provenanceClass: "deterministically-derived"
			} );
		}
		return { dbFindings: findings, dbTransitions: transitions, samples: [] };
	}

	private array function boundedArray(required any value, required numeric limit) {
		return isArray( arguments.value ) && arguments.value.len() ? arguments.value.slice( 1, min( arguments.limit, arguments.value.len() ) ) : [];
	}

	private array function boundedStructArray(required any value, required numeric limit, array errors = [], string collection = "items") {
		var output = [];
		var rejected = 0;
		for ( var item in boundedArray( arguments.value, arguments.limit ) ) {
			if ( isStruct( item ) ) output.append( item );
			else rejected++;
		}
		if ( rejected ) arguments.errors.append( { role: "provider-contract", collection: arguments.collection, message: "ignored-non-object-items", severity: "info", count: rejected } );
		return output;
	}

	private boolean function validFragment(required string role, required any payload) {
		if ( !isStruct( arguments.payload ) ) return false;
		if ( arguments.role == "modernization-repair" ) return structKeyExists( arguments.payload, "replacements" ) && isArray( arguments.payload.replacements );
		var keys = arguments.role == "modernization-application"
			? [ "targetUnits", "units", "unitLinks", "routeContracts", "contexts", "extracts", "samples" ]
			: ( arguments.role == "modernization-database"
				? [ "dbFindings", "dbTransitions", "samples" ]
			: ( arguments.role == "modernization-architecture" ? [ "placements", "contexts", "extracts" ] : [ "roadmapPhases", "phases", "samples", "assumptions" ] ) );
		var present = false;
		for ( var key in keys ) {
			if ( !structKeyExists( arguments.payload, key ) ) continue;
			present = true;
			if ( !isArray( arguments.payload[ key ] ) ) return false;
		}
		return present;
	}

	private struct function redactPayload(required struct payload) {
		try {
			var redacted = secretRedactionService.redactStructured( arguments.payload );
			return isStruct( redacted ) ? redacted : {};
		} catch ( any ignored ) {
			// Never persist a provider payload that could not pass redaction;
			// retaining raw output would violate the local privacy boundary.
			return {};
		}
	}

	private void function ensureIdentity(required struct item, required string kind) {
		var id = trim( scalarString( arguments.item.id ?: "" ) );
		if ( !len( id ) ) id = trim( scalarString( arguments.item.itemId ?: "" ) );
		if ( !len( id ) ) arguments.item.id = identityService.itemId( arguments.kind, arguments.item );
		else arguments.item.id = id;
		var fingerprint = trim( scalarString( arguments.item.itemFingerprint ?: "" ) );
		if ( !len( fingerprint ) ) arguments.item.itemFingerprint = identityService.itemFingerprint( arguments.kind, arguments.item );
		else arguments.item.itemFingerprint = fingerprint;
	}
	private boolean function isCancelled(required string runId, required struct options) {
		return variables.cancelledRuns.keyExists( arguments.runId ) || ( structKeyExists( arguments.options, "isCancelled" ) && isCustomFunction( arguments.options.isCancelled ) && arguments.options.isCancelled() );
	}
	private array function collectPromptContracts( required array outcomes ) {
		var contracts = [];
		for ( var outcome in arguments.outcomes ) {
			if ( !isStruct( outcome.promptProvenance ?: "" ) || !outcome.promptProvenance.count() ) continue;
			var provenance = duplicate( outcome.promptProvenance );
			var key = ( provenance.promptId ?: "" ) & "|" & ( provenance.promptVersion ?: provenance.contractVersion ?: "" ) & "|" & ( provenance.promptHash ?: "" );
			if ( !contracts.some( ( item ) => item.key == key ) ) contracts.append( { key: "modernization-application|" & key, provenance: provenance, role: "modernization-application" } );
		}
		return contracts;
	}

	private void function appendPromptContract( required struct plan, required string role, required any provenance ) {
		if ( !isStruct( arguments.provenance ) || !arguments.provenance.count() ) return;
		arguments.plan.metadata = isStruct( arguments.plan.metadata ?: "" ) ? arguments.plan.metadata : {};
		arguments.plan.metadata.promptContracts = isArray( arguments.plan.metadata.promptContracts ?: "" ) ? arguments.plan.metadata.promptContracts : [];
		var item = { key: arguments.role & "|" & ( arguments.provenance.promptId ?: "" ) & "|" & ( arguments.provenance.promptHash ?: "" ), provenance: duplicate( arguments.provenance ), role: arguments.role };
		if ( !arguments.plan.metadata.promptContracts.some( ( existing ) => existing.key == item.key ) ) arguments.plan.metadata.promptContracts.append( item );
	}

	private struct function providerRoleError( required string role, required struct response, numeric shard = 0 ) {
		var entry = {
			role: arguments.role,
			message: arguments.response.error ?: ( arguments.response.ok ?: false ? "malformed-role-output" : "provider-failed" )
		};
		if ( len( trim( arguments.response.errorType ?: "" ) ) ) entry.errorType = arguments.response.errorType;
		if ( structKeyExists( arguments.response, "retryable" ) ) entry.retryable = !!arguments.response.retryable;
		if ( arguments.shard > 0 ) entry.shard = arguments.shard;
		return entry;
	}

	private struct function buildGenerationSummary(
		required struct plan,
		required struct fragments,
		required array errors,
		required struct appResult,
		required string runId
	) {
		var completed = [ "inventory", "schema", "context", "evidence" ];
		var incomplete = [];
		if ( ( arguments.appResult.accepted ?: 0 ) > 0 ) completed.append( "application-shards" );
		else incomplete.append( "application-shards" );
		if ( arguments.fragments.keyExists( "modernization-database" ) ) completed.append( "database" );
		else incomplete.append( "database" );
		var architectureSource = arguments.plan.metadata.architectureSource ?: "";
		var hasArchitecture = ( isArray( arguments.plan.target.placements ?: "" ) && arguments.plan.target.placements.len() )
			|| ( isArray( arguments.plan.target.contexts ?: "" ) && arguments.plan.target.contexts.len() )
			|| ( isArray( arguments.plan.target.extracts ?: "" ) && arguments.plan.target.extracts.len() );
		// Synthesized packaging after budget/provider failure is incomplete truth,
		// not a completed architecture stage.
		if ( hasArchitecture && architectureSource != "synthesized" ) completed.append( "architecture" );
		else if ( hasArchitecture && architectureSource == "synthesized" && !hasRoleError( arguments.errors, "modernization-architecture" ) ) completed.append( "architecture" );
		else incomplete.append( "architecture" );
		var roadmapSource = arguments.plan.metadata.roadmapSource ?: "";
		var hasRoadmap = isArray( arguments.plan.roadmapPhases ?: "" ) && arguments.plan.roadmapPhases.len();
		var roadmapAccepted = isStruct( arguments.plan.metadata.roadmapShards ?: "" )
			? val( arguments.plan.metadata.roadmapShards.accepted ?: 0 )
			: 0;
		if ( hasRoadmap && roadmapAccepted > 0 && roadmapSource != "synthesized" ) {
			completed.append( "roadmap" );
		} else if ( hasRoadmap && roadmapSource != "synthesized" && !hasRoleError( arguments.errors, "modernization-roadmap" ) ) {
			completed.append( "roadmap" );
		} else if ( hasRoadmap && roadmapSource == "synthesized" && !hasRoleError( arguments.errors, "modernization-roadmap" ) ) {
			completed.append( "roadmap" );
		} else {
			incomplete.append( "roadmap" );
		}
		var primary = arguments.errors.len() ? arguments.errors[ 1 ] : {};
		var status = arguments.errors.len() ? "partial_failure" : "succeeded";
		if ( architectureSource == "synthesized" && hasArchitecture && ( primary.role ?: "" ) == "modernization-architecture" ) {
			for ( var item in arguments.errors ) {
				if ( ( item.role ?: "" ) != "modernization-architecture" && !isInformationalProposalMessage( item ) ) {
					primary = item;
					break;
				}
			}
		}
		var errorType = primary.errorType ?: inferErrorType( primary.message ?: "" );
		var omittedPathCount = isArray( arguments.appResult.omittedPaths ?: "" ) ? arguments.appResult.omittedPaths.len() : val( arguments.appResult.omitted ?: 0 );
		var failedShardCount = val( arguments.appResult.failed ?: 0 );
		var fallbackStubCount = 0;
		for ( var note in ( isArray( arguments.plan.generationNotes ?: "" ) ? arguments.plan.generationNotes : [] ) ) {
			if ( ( note.message ?: "" ) == "inventory-coverage-fallback" ) fallbackStubCount = val( note.count ?: 0 );
		}
		var migrationStepCount = 0;
		for ( var phase in ( isArray( arguments.plan.roadmapPhases ?: "" ) ? arguments.plan.roadmapPhases : [] ) ) {
			migrationStepCount += isArray( phase.migrationSteps ?: "" ) ? phase.migrationSteps.len() : 0;
		}
		var sampleCount = isArray( arguments.plan.samples ?: "" ) ? arguments.plan.samples.len() : 0;
		var actionabilityIncomplete = ( sampleCount == 0 && migrationStepCount == 0 && ( roadmapSource == "synthesized" || incomplete.contains( "database" ) ) );
		if ( actionabilityIncomplete && status == "succeeded" ) status = "partial_failure";
		var limitReached = "";
		if ( errorType == "request_timeout" || findNoCase( "budget-exceeded", primary.message ?: "" ) || errorType == "budget_exceeded" ) {
			limitReached = errorType.len() ? errorType : "budget_exceeded";
		} else if ( omittedPathCount > 0 || val( arguments.appResult.omitted ?: 0 ) > 0 ) {
			limitReached = "shard_cap_or_budget";
		} else if ( status == "partial_failure" && len( errorType ) ) {
			limitReached = errorType;
		}
		var recommendedContinuation = "Review partial plan gates before accepting.";
		if ( failedShardCount > 0 || omittedPathCount > 0 || val( arguments.appResult.omitted ?: 0 ) > 0 ) {
			recommendedContinuation = "Continue omitted or failed coverage via POST /api/v1/runs/#arguments.runId#/modernization/continue";
		} else if ( incomplete.contains( "architecture" ) || architectureSource == "synthesized" ) {
			recommendedContinuation = "Retry architecture packaging or rebuild placements after coverage is complete.";
		} else if ( incomplete.contains( "database" ) ) {
			recommendedContinuation = "Retry the database stage; schema evidence was present but no provider findings were retained.";
		} else if ( errorType == "request_timeout" ) {
			recommendedContinuation = "Retry with a narrower scopePaths wave or higher AI_TIMEOUT; partial shards are retained.";
		} else if ( actionabilityIncomplete ) {
			recommendedContinuation = "Plan is structurally present but not actionable — retry roadmap/database stages or continue failed shards.";
		}
		return {
			status: status,
			stage: incomplete.len() ? incomplete[ 1 ] : "proposal_generation",
			errorType: errorType,
			message: primary.message ?: ( actionabilityIncomplete ? "actionability-incomplete" : "" ),
			retryable: structKeyExists( primary, "retryable" ) ? !!primary.retryable : ( status == "partial_failure" ),
			completedStages: completed,
			incompleteStages: incomplete,
			checkpointId: arguments.runId & ":proposal",
			lastSuccessfulCheckpoint: arguments.runId & ":proposal",
			architectureSource: architectureSource,
			roadmapSource: roadmapSource,
			databaseSource: arguments.plan.metadata.databaseSource ?: ( arguments.fragments.keyExists( "modernization-database" ) ? "provider" : "" ),
			limitReached: limitReached,
			actionability: actionabilityIncomplete ? "incomplete" : "present",
			partialResults: {
				acceptedShards: val( arguments.appResult.accepted ?: 0 ),
				failedShards: failedShardCount,
				omittedPaths: omittedPathCount,
				fallbackStubCount: fallbackStubCount,
				migrationSteps: migrationStepCount,
				samples: sampleCount,
				phases: isArray( arguments.plan.roadmapPhases ?: "" ) ? arguments.plan.roadmapPhases.len() : 0,
				units: isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units.len() : 0,
				placements: isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.placements ?: "" ) ? arguments.plan.target.placements.len() : 0
			},
			recommendedContinuation: recommendedContinuation
		};
	}

	private boolean function hasRoleError( required array errors, required string role ) {
		for ( var item in arguments.errors ) {
			if ( ( item.role ?: "" ) == arguments.role && !isInformationalProposalMessage( item ) ) return true;
		}
		return false;
	}

	private string function inferErrorType( required string message ) {
		var lower = lCase( arguments.message );
		if ( findNoCase( "request_timeout", lower ) || findNoCase( "timed out", lower ) || findNoCase( "request timeout", lower ) ) return "request_timeout";
		if ( findNoCase( "budget-exceeded", lower ) || findNoCase( "budget_exceeded", lower ) ) return "budget_exceeded";
		if ( findNoCase( "cost-budget", lower ) ) return "cost_budget_exceeded";
		if ( findNoCase( "prompt budget", lower ) || findNoCase( "prompt-preflight", lower ) ) return "prompt_budget_exceeded";
		if ( findNoCase( "truncated", lower ) ) return "truncated_json";
		return len( trim( arguments.message ) ) ? "provider_error" : "";
	}

	private void function applyApplicationResume( required struct state, required any resumeFrom ) {
		if ( !isStruct( arguments.resumeFrom ) || !( arguments.resumeFrom.accepted ?: 0 ) ) return;
		if ( isStruct( arguments.resumeFrom.fragment ?: "" ) && arguments.resumeFrom.fragment.count() ) {
			arguments.state.appMerged = mergeApplicationFragments( arguments.state.appMerged, arguments.resumeFrom.fragment );
		}
		arguments.state.appAccepted = max( arguments.state.appAccepted, int( arguments.resumeFrom.accepted ?: 0 ) );
		arguments.state.totalOutputCharacters = max( arguments.state.totalOutputCharacters, int( arguments.resumeFrom.outputCharacters ?: 0 ) );
		arguments.state.totalCostUsd = max( arguments.state.totalCostUsd, val( arguments.resumeFrom.costUsd ?: 0 ) );
		for ( var prior in ( isArray( arguments.resumeFrom.outcomes ?: "" ) ? arguments.resumeFrom.outcomes : [] ) ) {
			if ( ( prior.status ?: "" ) != "accepted" ) continue;
			var key = shardPathKey( prior.paths ?: [] );
			if ( len( key ) ) arguments.state.resumedPathKeys[ key ] = true;
		}
	}

	private string function shardPathKey( required array paths ) {
		var normalized = [];
		for ( var path in arguments.paths ) {
			var value = lCase( normalizeLegacyPath( path ) );
			if ( len( value ) ) normalized.append( value );
		}
		normalized.sort( "textnocase" );
		return normalized.toList( "|" );
	}

	private void function emitShardProgress( required struct options, required struct state ) {
		if ( !structKeyExists( arguments.options, "onShardComplete" ) || !isCustomFunction( arguments.options.onShardComplete ) ) return;
		try {
			arguments.options.onShardComplete( {
				fragment: arguments.state.appMerged,
				outcomes: arguments.state.outcomes,
				accepted: arguments.state.appAccepted,
				failed: arguments.state.outcomes.filter( ( item ) => ( item.status ?: "" ) == "failed" ).len(),
				omitted: arguments.state.outcomes.filter( ( item ) => ( item.status ?: "" ) == "omitted" ).len(),
				outputCharacters: arguments.state.totalOutputCharacters,
				costUsd: arguments.state.totalCostUsd
			} );
		} catch ( any ignored ) {}
	}

	private struct function failure(required string message, array errors = []) {
		return { ok: false, plan: {}, partial: false, errors: arguments.errors.len() ? arguments.errors : [ { role: "provider", message: arguments.message } ] };
	}

	private struct function applyGenerationCoverage( required struct coverage, required struct shardReport ) {
		var result = duplicate( arguments.coverage );
		result.llm = isStruct( result.llm ?: "" ) ? result.llm : {};
		var contextOmitted = val( result.llm.omittedPartitions ?: 0 );
		var contextOmittedPaths = isArray( result.llm.omittedPaths ?: "" ) ? duplicate( result.llm.omittedPaths ) : [];
		var outcomes = isArray( arguments.shardReport.outcomes ?: "" ) ? duplicate( arguments.shardReport.outcomes ) : [];
		var omittedPaths = isArray( arguments.shardReport.omittedPaths ?: "" ) ? duplicate( arguments.shardReport.omittedPaths ) : [];
		var gaps = [];
		for ( var outcome in outcomes ) {
			if ( ![ "failed", "omitted" ].contains( outcome.status ?: "" ) ) continue;
			gaps.append( {
				kind: "application-shard",
				shard: outcome.shard ?: 0,
				status: outcome.status ?: "omitted",
				reason: outcome.reason ?: "not-run",
				paths: duplicate( outcome.paths ?: [] ),
				provenanceClass: "not-observed"
			} );
		}
		if ( omittedPaths.len() ) {
			gaps.append( {
				kind: "application-shard-cap",
				status: "omitted",
				reason: "max-application-shards",
				paths: omittedPaths,
				provenanceClass: "not-observed"
			} );
		}
		if ( contextOmitted > 0 ) {
			gaps.append( {
				kind: "context-partition",
				status: "omitted",
				reason: "context-budget",
				paths: contextOmittedPaths,
				provenanceClass: "not-observed"
			} );
		}
		result.llm.planned = val( arguments.shardReport.total ?: outcomes.len() ) + ( omittedPaths.len() ? 1 : 0 );
		result.llm.completed = val( arguments.shardReport.accepted ?: 0 );
		result.llm.failed = val( arguments.shardReport.failed ?: 0 );
		result.llm.omitted = val( arguments.shardReport.omitted ?: 0 ) + omittedPaths.len() + contextOmitted;
		result.llm.gaps = gaps;
		result.llm.shards = outcomes;
		result.llm.complete = result.llm.failed == 0 && result.llm.omitted == 0 && result.llm.completed >= result.llm.planned;
		result.llm.status = result.llm.complete ? "complete" : "incomplete";
		result.complete = result.llm.complete && !( result.truncated ?: false );
		result.status = result.complete ? "complete" : "incomplete";
		return result;
	}

	private struct function annotateProvenance( required struct plan ) {
		var allowed = [ "source-observed", "provider-suggested", "deterministically-derived", "not-observed" ];
		arguments.plan.metadata = isStruct( arguments.plan.metadata ?: "" ) ? arguments.plan.metadata : {};
		arguments.plan.metadata.provenanceContract = {
			version: "modernization-provenance-v1",
			classes: allowed
		};

		if ( isStruct( arguments.plan.inventory ?: "" ) ) {
			for ( var inventoryCollection in [ "files", "units", "dependencies", "routeEvidence" ] ) {
				annotateItems( arguments.plan.inventory[ inventoryCollection ] ?: [], "source-observed", allowed );
			}
			annotateItems( arguments.plan.inventory.unresolved ?: [], "not-observed", allowed );
		}
		if ( isStruct( arguments.plan.schemaEvidence ?: "" ) ) {
			var schemaObserved = ( arguments.plan.schemaEvidence.coverage ?: "absent" ) != "absent";
			arguments.plan.schemaEvidence.provenanceClass = schemaObserved ? "source-observed" : "not-observed";
			if ( isStruct( arguments.plan.schemaEvidence.database ?: "" ) ) {
				arguments.plan.schemaEvidence.database.provenanceClass = schemaObserved ? "source-observed" : "not-observed";
			}
			for ( var schemaCollection in [ "tables", "columns", "constraints", "indexes", "routines", "objects" ] ) {
				annotateItems( arguments.plan.schemaEvidence[ schemaCollection ] ?: [], "source-observed", allowed );
			}
			annotateItems( arguments.plan.schemaEvidence.unresolved ?: [], "not-observed", allowed );
		}
		annotateItems( arguments.plan.signals ?: [], "deterministically-derived", allowed );
		if ( isStruct( arguments.plan.target ?: "" ) ) {
			for ( var targetCollection in [ "units", "contexts", "extracts" ] ) {
				annotateItems( arguments.plan.target[ targetCollection ] ?: [], "provider-suggested", allowed );
			}
		}
		for ( var proposalCollection in [ "unitLinks", "dbFindings", "dbTransitions", "routeContracts", "roadmapPhases", "samples" ] ) {
			annotateItems( arguments.plan[ proposalCollection ] ?: [], "provider-suggested", allowed );
		}
		return arguments.plan;
	}

	private void function annotateItems( required any items, required string fallback, required array allowed ) {
		if ( !isArray( arguments.items ) ) return;
		for ( var index = 1; index <= arguments.items.len(); index++ ) {
			if ( !isStruct( arguments.items[ index ] ) ) continue;
			var current = lCase( trim( arguments.items[ index ].provenanceClass ?: "" ) );
			arguments.items[ index ].provenanceClass = arguments.allowed.contains( current ) ? current : arguments.fallback;
		}
	}

	private array function invalidItems( required struct plan, required struct validation ) {
		var output = [];
		var seen = {};
		var messages = isArray( arguments.validation.messages ?: "" ) ? arguments.validation.messages : [];
		for ( var message in messages ) {
			if ( lCase( message.level ?: message.validationLevel ?: "" ) != "blocking" ) continue;
			var category = message.category ?: "";
			var collection = category == "target.units" ? "target.units" : category;
			if ( ![ "target.units", "target.contexts", "target.extracts", "unitLinks", "dbFindings", "dbTransitions", "routeContracts", "roadmapPhases", "samples" ].contains( collection ) ) continue;
			var parts = collection.listToArray( "." );
			var owner = parts.len() == 2 ? ( arguments.plan[ parts[ 1 ] ] ?: {} ) : arguments.plan;
			var key = parts[ parts.len() ];
			for ( var item in ( isStruct( owner ) && isArray( owner[ key ] ?: "" ) ? owner[ key ] : [] ) ) {
				var fp = trim( item.itemFingerprint ?: "" );
				var itemId = item.id ?: item.itemId ?: "";
				if ( len( message.itemId ?: "" ) && message.itemId != itemId ) continue;
				if ( len( fp ) && !seen.keyExists( fp ) ) { output.append( { itemId: itemId, itemFingerprint: fp, category: category, item: item } ); seen[ fp ] = true; }
			}
		}
		return output;
	}

	/**
	 * Provider order is not a durable ordering contract.  Sort every generated
	 * collection by stable identity before persisting/exporting so retries and
	 * different providers produce the same artifact ordering. Roadmap phases stay
	 * in dependency order from polishPlan so validation and the Road UI agree.
	 */
	private struct function sortPlan( required struct plan ) {
		var collections = [ "target.units", "target.contexts", "target.extracts", "unitLinks", "routeContracts", "dbFindings", "samples", "assumptions" ];
		for ( var path in collections ) {
			var parts = path.listToArray( "." );
			var parent = parts.len() == 2 ? arguments.plan[ parts[ 1 ] ] : arguments.plan;
			var key = parts[ parts.len() ];
			if ( isStruct( parent ) && isArray( parent[ key ] ?: "" ) ) {
				parent[ key ].sort( ( first, second ) => compareNoCase(
					identityKey( first ),
					identityKey( second )
				) );
			}
		}
		if ( isArray( arguments.plan.dbTransitions ?: "" ) ) {
			arguments.plan.dbTransitions.sort( ( first, second ) => {
				var orderCompare = val( first.order ?: 0 ) - val( second.order ?: 0 );
				return orderCompare != 0 ? orderCompare : compareNoCase( identityKey( first ), identityKey( second ) );
			} );
		}
		return arguments.plan;
	}

	private string function identityKey( required any item ) {
		if ( !isStruct( arguments.item ) ) return toString( arguments.item );
		return lCase( trim( arguments.item.id ?: arguments.item.itemId ?: arguments.item.itemFingerprint ?: arguments.item.filePath ?: arguments.item.path ?: jsonSerialize( arguments.item ) ) );
	}
}
