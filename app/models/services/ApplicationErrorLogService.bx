/**
 * Minimal local error sink used when framework logging is unavailable or
 * fails during bootstrap. Runtime contents are ignored by Git.
 */
@singleton
class {
	property name="logPath" inject="coldbox:setting:errorLogPath";

	void function error( required string message, struct context = {} ) {
		try {
			var target = trim( toString( variables.logPath ?: "" ) );
			if ( !len( target ) ) return;
			var parent = getDirectoryFromPath( target );
			if ( !directoryExists( parent ) ) directoryCreate( parent, true );
			var record = {
				timestamp: dateTimeFormat( now(), "iso" ),
				message  : left( toString( arguments.message ), 4000 ),
				context  : arguments.context
			};
			fileWrite( target, jsonSerialize( record ) & char( 10 ), "UTF-8", true );
		} catch ( any ignored ) {
			// Error logging must never replace the original failure.
		}
	}
}
