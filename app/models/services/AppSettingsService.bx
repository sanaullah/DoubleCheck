/**
 * Resolves flat app setting overrides, read fresh from SQLite on every call
 * (deliberately not cached/injected) so a Settings-panel change takes effect
 * on the next read with no server restart or reinit required. Falls back to
 * the env-derived coldbox:setting value already injected app-wide when no
 * override has been saved, so zero-config behavior is unchanged.
 *
 * @see AppSettingsRepository
 */
@singleton
class threadsafe {
	property name="settingsRepository" inject="AppSettingsRepository";

	/** Reads a single override, or returns fallbackValue when unset. */
	any function get( required string key, required any fallbackValue, string tenantId = "default" ) {
		var overrides = settingsRepository.getAll( arguments.tenantId );
		return overrides.keyExists( arguments.key ) ? overrides[ arguments.key ] : arguments.fallbackValue;
	}

	/** Reads all overrides at once - use when several keys are needed together to avoid repeated queries. */
	struct function getAll( string tenantId = "default" ) {
		return settingsRepository.getAll( arguments.tenantId );
	}

	void function set( required string key, required any value, string tenantId = "default" ) {
		settingsRepository.set( arguments.tenantId, arguments.key, toString( arguments.value ) );
	}

	void function setMany( required struct values, string tenantId = "default" ) {
		settingsRepository.setMany( arguments.tenantId, arguments.values );
	}
}
