/**
 * Optional LLM narrative for deterministic CodeGraph snapshots.
 * Never mutates the snapshot; failures return { used:false, error:... }.
 *
 * @see ArchitectureEnrichmentService
 * @see CodeGraphRunService
 * @see AIChatGateway
 */

@singleton
class threadsafe {
	property name="chatGateway" inject="AIChatGateway";
	property name="aiProviderResolver" inject="AIProviderResolverService";
	property name="maxClusters" inject="coldbox:setting:codegraphNarrativeMaxClusters";
	property name="maxHotspots" inject="coldbox:setting:codegraphNarrativeMaxHotspots";
	property name="maxFlows" inject="coldbox:setting:codegraphNarrativeMaxFlows";
	property name="maxCycles" inject="coldbox:setting:codegraphNarrativeMaxCycles";
	property name="maxPromptCharacters" inject="coldbox:setting:codegraphNarrativeMaxCharacters";
	property name="log" inject="logbox:logger:{this}";
	property name="secretRedactionService" inject="SecretRedactionService";
	property name="promptCompiler" inject="PromptCompiler";
	property name="promptOutputValidator" inject="PromptOutputValidator";

	variables.narrativeVersion = "codegraph-narrative-v2";
	variables.maxClusters = 24;
	variables.maxHotspots = 20;
	variables.maxFlows = 24;
	variables.maxCycles = 12;
	variables.maxPromptCharacters = 30000;

	boolean function isEnabled() {
		var resolved = aiProviderResolver.resolve();
		return chatGateway.isEnabled( resolved.apiKey, resolved.isLocal );
	}

	string function cacheKey( required struct snapshot, string projectPath = "" ) {
		return stableHash(
			lCase( trim( arguments.projectPath ) ) & "|" &
			trim( toString( arguments.snapshot.fingerprint ?: "" ) ) & "|" &
			signature()
		);
	}

	/**
	 * Produce an optional narrative blob for a deterministic snapshot.
	 * Does not mutate arguments.snapshot.
	 */
	struct function narrate( required struct snapshot ) {
		return enrich( arguments.snapshot );
	}

	/**
	 * ArchitectureEnrichmentService-shaped entry point.
	 */
	struct function enrich( required struct snapshot ) {
		var resolved = aiProviderResolver.resolve();
		var empty = disabledResult( resolved, "" );
		if ( !chatGateway.isEnabled( resolved.apiKey, resolved.isLocal ) ) {
			return empty;
		}

		var evidence = {};
		var payload = {};
		try {
			evidence = buildEvidenceContext( arguments.snapshot );
			if ( !evidence.hasEvidence ) {
				return disabledResult( resolved, "" );
			}
			payload = buildPayload( resolved, arguments.snapshot, evidence );
			evidence.validationContext = payload.validationContext;
		} catch ( any compileError ) {
			if ( !isNull( variables.log ?: javacast( "null", "" ) ) ) {
				log.error(
					"AI CodeGraph narrative evidence compile failed",
					{
						type      : compileError.type ?: "",
						message   : secretRedactionService.redactText( compileError.message ?: "" ),
						provider  : resolved.provider,
						model     : resolved.model,
						stackTrace: secretRedactionService.redactText( compileError.stackTrace ?: "" )
					}
				);
			}
			return mergeNarrativeResult(
				resolved,
				emptyNarrativeContent(),
				{},
				0,
				false,
				"CodeGraph narrative unavailable"
			);
		}

		var activePackage = payload.promptPackage;
		var response = "";
		var attempts = 0;
		try {
			assertDistinctSystem( resolved.provider ?: "" );
			while ( attempts < 2 ) {
				attempts++;
				try {
					response = chatGateway.chat(
						activePackage.messages,
						buildParams( resolved ),
						buildOptions( resolved )
					);
					var acceptedResponse = getValidator().sanitizeValid(
						response,
						"codegraph-narrative-v2",
						evidence.validationContext
					);
					response = acceptedResponse.value;
					if ( acceptedResponse.rejectedItems.len() ) {
						activePackage.provenance.rejectedItems = duplicate( acceptedResponse.rejectedItems );
					}
					break;
				} catch ( any attemptError ) {
					if ( attempts >= 2 || !isRepairablePromptError( attemptError ) ) rethrow;
					if ( isStruct( attemptError.data ?: "" ) && isArray( attemptError.data.reasonCodes ?: "" ) ) {
						activePackage.provenance.validationReasonCodes = duplicate( attemptError.data.reasonCodes );
					}
					activePackage = getCompiler().compileRepair(
						activePackage,
						attemptError.message ?: "output validation failure"
					);
				}
			}
			var normalized = normalize( response, evidence );
			return mergeNarrativeResult( resolved, normalized, activePackage.provenance, attempts, true, "" );
		} catch ( any error ) {
			if ( !isNull( variables.log ?: javacast( "null", "" ) ) ) {
				log.error(
					"AI CodeGraph narrative failed",
					{
						type      : error.type ?: "",
						message   : secretRedactionService.redactText( error.message ?: "" ),
						provider  : resolved.provider,
						model     : resolved.model,
						stackTrace: secretRedactionService.redactText( error.stackTrace ?: "" )
					}
				);
			}
			return mergeNarrativeResult(
				resolved,
				emptyNarrativeContent(),
				activePackage.provenance ?: {},
				attempts,
				false,
				"CodeGraph narrative unavailable"
			);
		}
	}

	private struct function disabledResult( required struct resolved, required string error ) {
		return mergeNarrativeResult( arguments.resolved, emptyNarrativeContent(), {}, 0, false, arguments.error, false );
	}

	private struct function emptyNarrativeContent() {
		return {
			pitch      : {},
			domains    : [],
			processes  : [],
			onboarding : [],
			risk       : [],
			summaries  : []
		};
	}

	private struct function mergeNarrativeResult(
		required struct resolved,
		required struct content,
		required struct promptProvenance,
		required numeric attempts,
		required boolean used,
		required string error,
		boolean enabled = true
	) {
		return {
			used             : arguments.used,
			enabled          : arguments.enabled,
			version          : variables.narrativeVersion,
			provider         : arguments.resolved.provider,
			model            : arguments.resolved.model,
			error            : arguments.error,
			pitch            : arguments.content.pitch ?: {},
			domains          : isArray( arguments.content.domains ?: "" ) ? arguments.content.domains : [],
			processes        : isArray( arguments.content.processes ?: "" ) ? arguments.content.processes : [],
			onboarding       : isArray( arguments.content.onboarding ?: "" ) ? arguments.content.onboarding : [],
			risk             : isArray( arguments.content.risk ?: "" ) ? arguments.content.risk : [],
			summaries        : isArray( arguments.content.summaries ?: "" ) ? arguments.content.summaries : [],
			promptProvenance : arguments.promptProvenance,
			attempts         : arguments.attempts
		};
	}

	/**
	 * Keep only v2 narrative items that cite ids present in the snapshot.
	 */
	private struct function normalize( required any response, required struct evidence ) {
		var parsed = parseResponse( arguments.response );
		if ( !isStruct( parsed ) ) return emptyNarrativeContent();

		var allowedClusters = listToLookup( arguments.evidence.validationContext.allowedClusterIds ?: [] );
		var allowedNodes = listToLookup( arguments.evidence.validationContext.allowedNodeIds ?: [] );
		var allowedFlows = listToLookup( arguments.evidence.validationContext.allowedFlowIds ?: [] );
		var allowedHotspots = listToLookup( arguments.evidence.validationContext.allowedHotspotIds ?: [] );
		var allowedCycles = listToLookup( arguments.evidence.validationContext.allowedCycleIds ?: [] );

		var pitch = {};
		if ( isStruct( parsed.pitch ?: "" ) && len( trim( parsed.pitch.text ?: "" ) ) ) {
			pitch = { text: left( trim( parsed.pitch.text ), 600 ) };
		}

		var domains = normalizeDomains( parsed.domains ?: [], allowedClusters );
		var processes = normalizeProcesses( parsed.processes ?: [], allowedFlows );
		var onboarding = normalizeOnboarding(
			parsed.onboarding ?: [],
			allowedClusters,
			allowedNodes,
			allowedFlows
		);
		var risk = normalizeRisk( parsed.risk ?: [], allowedHotspots, allowedCycles );
		var summaries = [];
		if ( domains.len() ) {
			for ( var domain in domains ) {
				summaries.append( {
					clusterId : domain.clusterId,
					title     : domain.title,
					text      : domain.text
				} );
			}
		}

		return {
			pitch      : pitch,
			domains    : domains,
			processes  : processes,
			onboarding : onboarding,
			risk       : risk,
			summaries  : summaries
		};
	}

	private any function parseResponse( required any response ) {
		if ( isStruct( arguments.response ) ) return arguments.response;
		if ( isSimpleValue( arguments.response ) ) {
			try {
				return jsonDeserialize( arguments.response );
			} catch ( any ignored ) {
				return {};
			}
		}
		return {};
	}

	private array function normalizeDomains( required array items, required struct allowedClusters ) {
		var out = [];
		var seen = {};
		for ( var candidate in arguments.items ) {
			if ( !isStruct( candidate ) || !len( trim( candidate.text ?: "" ) ) ) continue;
			var clusterId = trim( toString( candidate.clusterId ?: "" ) );
			if ( !len( clusterId ) || !arguments.allowedClusters.keyExists( clusterId ) ) continue;
			if ( seen.keyExists( clusterId ) ) continue;
			seen[ clusterId ] = true;
			out.append( {
				clusterId : clusterId,
				title     : left( trim( candidate.title ?: "" ), 120 ),
				text      : left( trim( candidate.text ), 800 )
			} );
		}
		return out;
	}

	private array function normalizeProcesses( required array items, required struct allowedFlows ) {
		var out = [];
		var seen = {};
		for ( var candidate in arguments.items ) {
			if ( !isStruct( candidate ) || !len( trim( candidate.text ?: "" ) ) ) continue;
			var flowId = trim( toString( candidate.flowId ?: "" ) );
			if ( !len( flowId ) || !arguments.allowedFlows.keyExists( flowId ) ) continue;
			if ( seen.keyExists( flowId ) ) continue;
			seen[ flowId ] = true;
			out.append( {
				flowId : flowId,
				title  : left( trim( candidate.title ?: "" ), 120 ),
				text   : left( trim( candidate.text ), 800 )
			} );
		}
		return out;
	}

	private array function normalizeOnboarding(
		required array items,
		required struct allowedClusters,
		required struct allowedNodes,
		required struct allowedFlows
	) {
		var out = [];
		var seen = {};
		for ( var candidate in arguments.items ) {
			if ( !isStruct( candidate ) || !len( trim( candidate.text ?: "" ) ) ) continue;
			var refType = lCase( trim( toString( candidate.refType ?: "" ) ) );
			var refId = trim( toString( candidate.refId ?: "" ) );
			if ( !len( refId ) ) continue;
			if ( refType == "cluster" && !arguments.allowedClusters.keyExists( refId ) ) continue;
			if ( refType == "node" && !arguments.allowedNodes.keyExists( refId ) ) continue;
			if ( refType == "flow" && !arguments.allowedFlows.keyExists( refId ) ) continue;
			if ( !listFindNoCase( "cluster,node,flow", refType ) ) continue;
			var step = isNumeric( candidate.step ?: "" ) ? max( 1, min( 5, int( val( candidate.step ) ) ) ) : out.len() + 1;
			var key = refType & ":" & refId & ":" & step;
			if ( seen.keyExists( key ) ) continue;
			seen[ key ] = true;
			out.append( {
				step    : step,
				refType : refType,
				refId   : refId,
				text    : left( trim( candidate.text ), 400 )
			} );
		}
		out.sort( ( a, b ) => a.step > b.step ? 1 : ( a.step < b.step ? -1 : 0 ) );
		if ( out.len() > 5 ) out = out.slice( 1, 5 );
		return out;
	}

	private array function normalizeRisk(
		required array items,
		required struct allowedHotspots,
		required struct allowedCycles
	) {
		var out = [];
		var seen = {};
		for ( var candidate in arguments.items ) {
			if ( !isStruct( candidate ) || !len( trim( candidate.text ?: "" ) ) ) continue;
			var refType = lCase( trim( toString( candidate.refType ?: "" ) ) );
			var refId = trim( toString( candidate.refId ?: "" ) );
			if ( !len( refId ) ) continue;
			if ( refType == "hotspot" && !arguments.allowedHotspots.keyExists( refId ) ) continue;
			if ( refType == "cycle" && !arguments.allowedCycles.keyExists( refId ) ) continue;
			if ( !listFindNoCase( "hotspot,cycle", refType ) ) continue;
			var key = refType & ":" & refId;
			if ( seen.keyExists( key ) ) continue;
			seen[ key ] = true;
			out.append( {
				refType : refType,
				refId   : refId,
				text    : left( trim( candidate.text ), 600 )
			} );
		}
		return out;
	}

	private array function normalizeSummaries( required array items, required struct allowedClusters ) {
		var out = [];
		var seen = {};
		for ( var candidate in arguments.items ) {
			if ( !isStruct( candidate ) || !len( trim( candidate.text ?: "" ) ) ) continue;
			var clusterId = trim( toString( candidate.clusterId ?: "" ) );
			if ( !len( clusterId ) || !arguments.allowedClusters.keyExists( clusterId ) ) continue;
			if ( seen.keyExists( clusterId ) ) continue;
			seen[ clusterId ] = true;
			out.append( {
				clusterId : clusterId,
				title     : left( trim( candidate.title ?: "" ), 120 ),
				text      : left( trim( candidate.text ), 800 )
			} );
		}
		return out;
	}

	private struct function buildEvidenceContext( required struct snapshot ) {
		var clusters = isArray( arguments.snapshot.clusters ?: "" ) ? arguments.snapshot.clusters : [];
		var nodes = isArray( arguments.snapshot.nodes ?: "" ) ? arguments.snapshot.nodes : [];
		var hotspots = isArray( arguments.snapshot.hotspots ?: "" ) ? arguments.snapshot.hotspots : [];
		var flows = isArray( arguments.snapshot.flows ?: "" ) ? arguments.snapshot.flows : [];
		var rawCycles = isArray( arguments.snapshot.cycles ?: "" ) ? arguments.snapshot.cycles : [];
		var cycleRecords = presentCycles( rawCycles );

		return {
			hasEvidence  : clusters.len() || hotspots.len() || flows.len() || cycleRecords.len(),
			cycleRecords : cycleRecords,
			roleCounts   : roleCountsFromNodes( nodes )
		};
	}

	private struct function buildPayload(
		required struct resolved,
		required struct snapshot,
		required struct evidence
	) {
		var maxClusterCount = numericSetting( variables.maxClusters, 24 );
		var maxHotspotCount = numericSetting( variables.maxHotspots, 20 );
		var maxFlowCount = numericSetting( variables.maxFlows, 24 );
		var maxCycleCount = numericSetting( variables.maxCycles, 12 );
		var maximumCharacters = numericSetting( variables.maxPromptCharacters, 30000 );
		var window = isNumeric( arguments.resolved.contextWindow )
			? max( 1024, int( val( arguments.resolved.contextWindow ) ) )
			: 128000;
		maximumCharacters = min( maximumCharacters, max( 1000, int( window * .75 * 2 ) ) );

		var clusterRecords = [];
		var hotspotRecords = [];
		var flowRecords = [];
		var cycleRecords = [];
		var characters = 0;

		var clusters = isArray( arguments.snapshot.clusters ?: "" ) ? arguments.snapshot.clusters : [];
		for ( var cluster in clusters ) {
			if ( !isStruct( cluster ) || clusterRecords.len() >= maxClusterCount ) break;
			var paths = isArray( cluster.filePaths ?: "" ) ? cluster.filePaths : [];
			var samplePaths = [];
			for ( var pathIndex = 1; pathIndex <= min( 6, paths.len() ); pathIndex++ ) {
				samplePaths.append( paths[ pathIndex ] );
			}
			var record = {
				id           : cluster.id ?: "",
				label        : cluster.label ?: "",
				fileCount    : val( cluster.fileCount ?: 0 ),
				symbolCount  : val( cluster.symbolCount ?: 0 ),
				cohesion     : cluster.cohesion ?: "",
				crossingEdges: val( cluster.crossingEdges ?: 0 ),
				filePaths    : samplePaths
			};
			var encoded = jsonSerialize( record );
			if ( characters + len( encoded ) > maximumCharacters ) break;
			clusterRecords.append( record );
			characters += len( encoded );
		}

		var hotspots = isArray( arguments.snapshot.hotspots ?: "" ) ? arguments.snapshot.hotspots : [];
		for ( var hotspot in hotspots ) {
			if ( !isStruct( hotspot ) || hotspotRecords.len() >= maxHotspotCount ) break;
			var record = {
				id           : hotspot.id ?: hotspot.path ?: "",
				path         : hotspot.path ?: hotspot.id ?: "",
				hotspotScore : hotspot.hotspotScore ?: "",
				fanIn        : val( hotspot.fanIn ?: 0 ),
				fanOut       : val( hotspot.fanOut ?: 0 ),
				clusterId    : hotspot.clusterId ?: "",
				inCycle      : hotspot.inCycle ?: false
			};
			var encoded = jsonSerialize( record );
			if ( characters + len( encoded ) > maximumCharacters ) break;
			hotspotRecords.append( record );
			characters += len( encoded );
		}

		var flows = isArray( arguments.snapshot.flows ?: "" ) ? arguments.snapshot.flows : [];
		for ( var flow in flows ) {
			if ( !isStruct( flow ) || flowRecords.len() >= maxFlowCount ) break;
			var steps = isArray( flow.steps ?: "" ) ? flow.steps : [];
			var sampleSteps = [];
			for ( var stepIndex = 1; stepIndex <= min( 8, steps.len() ); stepIndex++ ) {
				sampleSteps.append( steps[ stepIndex ] );
			}
			var record = {
				id          : flow.id ?: "",
				entryFile   : flow.entryFile ?: "",
				entrySymbol : flow.entrySymbol ?: "",
				sinkFile    : flow.sinkFile ?: "",
				steps       : sampleSteps
			};
			var encoded = jsonSerialize( record );
			if ( characters + len( encoded ) > maximumCharacters ) break;
			flowRecords.append( record );
			characters += len( encoded );
		}

		for ( var cycle in ( arguments.evidence.cycleRecords ?: [] ) ) {
			if ( cycleRecords.len() >= maxCycleCount ) break;
			var members = isArray( cycle.members ?: "" ) ? cycle.members : [];
			var sampleMembers = [];
			for ( var memberIndex = 1; memberIndex <= min( 12, members.len() ); memberIndex++ ) {
				sampleMembers.append( members[ memberIndex ] );
			}
			var record = {
				id      : cycle.id ?: "",
				members : sampleMembers
			};
			var encoded = jsonSerialize( record );
			if ( characters + len( encoded ) > maximumCharacters ) break;
			cycleRecords.append( record );
			characters += len( encoded );
		}

		var compiled = getCompiler().compile(
			"codegraph-narrative",
			{
				task: {
					clusterCount : clusterRecords.len(),
					hotspotCount : hotspotRecords.len(),
					flowCount    : flowRecords.len(),
					cycleCount   : cycleRecords.len(),
					fingerprint  : arguments.snapshot.fingerprint ?: ""
				},
				evidence: {
					clusters   : clusterRecords,
					hotspots   : hotspotRecords,
					flows      : flowRecords,
					cycles     : cycleRecords,
					roleCounts : arguments.evidence.roleCounts ?: {}
				}
			},
			{ provider: arguments.resolved.provider, model: arguments.resolved.model }
		);
		return {
			messages           : compiled.messages,
			provenance         : compiled.provenance,
			promptPackage      : compiled,
			validationContext  : validationContextFromRecords(
				clusterRecords,
				hotspotRecords,
				flowRecords,
				cycleRecords
			)
		};
	}

	private struct function validationContextFromRecords(
		required array clusterRecords,
		required array hotspotRecords,
		required array flowRecords,
		required array cycleRecords
	) {
		var allowedClusterIds = [];
		var allowedNodeIds = [];
		var allowedFlowIds = [];
		var allowedHotspotIds = [];
		var allowedCycleIds = [];

		for ( var cluster in arguments.clusterRecords ) {
			var clusterId = trim( toString( cluster.id ?: "" ) );
			if ( len( clusterId ) ) allowedClusterIds.append( clusterId );
		}
		for ( var hotspot in arguments.hotspotRecords ) {
			var hotspotId = trim( toString( hotspot.id ?: hotspot.path ?: "" ) );
			if ( len( hotspotId ) ) {
				allowedHotspotIds.append( hotspotId );
				if ( !allowedNodeIds.contains( hotspotId ) ) allowedNodeIds.append( hotspotId );
			}
			var hotspotPath = trim( toString( hotspot.path ?: "" ) );
			if ( len( hotspotPath ) && !allowedNodeIds.contains( hotspotPath ) ) {
				allowedNodeIds.append( hotspotPath );
			}
		}
		for ( var flow in arguments.flowRecords ) {
			var flowId = trim( toString( flow.id ?: "" ) );
			if ( len( flowId ) ) allowedFlowIds.append( flowId );
			var steps = isArray( flow.steps ?: "" ) ? flow.steps : [];
			for ( var step in steps ) {
				var nodeId = trim( toString( step ) );
				if ( len( nodeId ) && !allowedNodeIds.contains( nodeId ) ) allowedNodeIds.append( nodeId );
			}
		}
		for ( var cycle in arguments.cycleRecords ) {
			var cycleId = trim( toString( cycle.id ?: "" ) );
			if ( len( cycleId ) ) allowedCycleIds.append( cycleId );
			var members = isArray( cycle.members ?: "" ) ? cycle.members : [];
			for ( var member in members ) {
				var memberId = trim( toString( member ) );
				if ( len( memberId ) && !allowedNodeIds.contains( memberId ) ) allowedNodeIds.append( memberId );
			}
		}

		return {
			allowedClusterIds : allowedClusterIds,
			allowedNodeIds    : allowedNodeIds,
			allowedFlowIds    : allowedFlowIds,
			allowedHotspotIds : allowedHotspotIds,
			allowedCycleIds   : allowedCycleIds
		};
	}

	private array function presentCycles( required array cycles ) {
		var output = [];
		for ( var cycle in arguments.cycles ) {
			if ( !isArray( cycle ) || !cycle.len() ) continue;
			var members = [];
			for ( var member in cycle ) {
				var normalized = normalizePath( member );
				if ( len( normalized ) && !members.contains( normalized ) ) members.append( normalized );
			}
			if ( !members.len() ) continue;
			members.sort( ( a, b ) => compareNoCase( a, b ) );
			output.append( {
				id      : cycleId( members ),
				members : members
			} );
		}
		output.sort( ( a, b ) => compareNoCase( a.id, b.id ) );
		return output;
	}

	private string function cycleId( required array members ) {
		return "cycle-" & left( lCase( hash( arguments.members.toList( "|" ), "SHA-256" ) ), 8 );
	}

	private struct function roleCountsFromNodes( required array nodes ) {
		var counts = {};
		for ( var node in arguments.nodes ) {
			if ( !isStruct( node ) ) continue;
			var role = trim( toString( node.role ?: "unknown" ) );
			if ( !len( role ) ) role = "unknown";
			counts[ role ] = ( counts.keyExists( role ) ? counts[ role ] : 0 ) + 1;
		}
		return counts;
	}

	private struct function listToLookup( required array values ) {
		var lookup = {};
		for ( var value in arguments.values ) lookup[ value ] = true;
		return lookup;
	}

	private string function normalizePath( required string path ) {
		return lCase( replace( trim( arguments.path ), "\", "/", "all" ) );
	}

	private boolean function isRepairablePromptError( required any error ) {
		var typeName = lCase( toString( arguments.error.type ?: "" ) );
		var message = lCase( toString( arguments.error.message ?: "" ) );
		return findNoCase( "promptoutputvalidation", typeName ) > 0
			|| findNoCase( "json", typeName ) > 0
			|| findNoCase( "parse", message ) > 0
			|| findNoCase( "json", message ) > 0;
	}

	private void function assertDistinctSystem( required string provider ) {
		if ( !( getCompiler().capabilities( arguments.provider ).distinctSystem ?: true ) ) {
			throw(
				type = "AIProviderCapabilityException",
				message = "Provider cannot preserve the immutable prompt system contract"
			);
		}
	}

	private any function getCompiler() {
		if ( !isNull( variables.promptCompiler ?: javacast( "null", "" ) ) ) return variables.promptCompiler;
		variables.promptCompiler = new app.models.services.PromptCompiler();
		return variables.promptCompiler;
	}

	private any function getValidator() {
		if ( !isNull( variables.promptOutputValidator ?: javacast( "null", "" ) ) ) {
			return variables.promptOutputValidator;
		}
		variables.promptOutputValidator = new app.models.services.PromptOutputValidator();
		return variables.promptOutputValidator;
	}

	private struct function buildParams( required struct resolved ) {
		var window = isNumeric( arguments.resolved.contextWindow )
			? max( 1024, int( val( arguments.resolved.contextWindow ) ) )
			: 128000;
		var capabilities = getCompiler().capabilities( arguments.resolved.provider ?: "" );
		var outputCap = isNumeric( capabilities.maxOutputTokens ?: "" ) ? int( capabilities.maxOutputTokens ) : 2000;
		var params = {
			temperature : 0,
			max_tokens  : min( outputCap, min( 2000, max( 256, int( window * .25 ) ) ) )
		};
		if ( len( trim( arguments.resolved.model ) ) ) {
			params.model = arguments.resolved.model;
		}
		structAppend(
			params,
			getCompiler().structuredOutput( "codegraph-narrative", arguments.resolved.provider ?: "" ),
			true
		);
		return params;
	}

	private struct function buildOptions( required struct resolved ) {
		var options = {
			provider     : arguments.resolved.provider,
			apiKey       : arguments.resolved.apiKey,
			returnFormat : "json",
			timeout      : arguments.resolved.timeout
		};
		if ( len( trim( arguments.resolved.baseURL ) ) ) {
			options.baseURL = arguments.resolved.baseURL;
		}
		return options;
	}

	private string function signature() {
		var resolved = aiProviderResolver.resolve();
		return variables.narrativeVersion & ":" & (
			chatGateway.isEnabled( resolved.apiKey, resolved.isLocal ) ? "enabled" : "disabled"
		) & ":" & lCase( resolved.provider ) & ":" & lCase( resolved.model );
	}

	private numeric function numericSetting( required any value, required numeric fallback ) {
		return isNumeric( arguments.value ) ? max( 1, val( arguments.value ) ) : arguments.fallback;
	}

	private string function stableHash( required string value ) {
		return lCase( hash( arguments.value, "SHA-256" ) );
	}
}
