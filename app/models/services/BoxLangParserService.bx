/**
 * Parses BoxLang sources into symbols, dependencies, and impact edges for the graph.
 */

@singleton
class threadsafe {
	property name="codegraphParserStrategy" inject="coldbox:setting:codegraphParserStrategy";

	variables.parserVersion = "boxlang-ast-parser-v11";
	variables.sourceScanner = new app.models.services.CfmlSourceScanner();
	variables.callTargetFilter = new app.models.services.CallTargetFilter();
	variables.integrationDetector = new app.models.services.IntegrationDetector();

	string function getVersion() {
		return variables.parserVersion & "-strategy-" & configuredStrategy();
	}

	boolean function supports( required struct file ) {
		return arguments.file.language == "BoxLang";
	}

	struct function parse( required struct file ) {
		var strategy = configuredStrategy();
		if ( strategy != "regex" ) {
			try {
				var sourcePath = trim( toString( arguments.file.absolutePath ?: arguments.file.filePath ?: "" ) );
				if ( len( sourcePath ) && fileExists( sourcePath ) ) {
					var ast = BoxAST( filepath = sourcePath, returnType = "struct" );
					var parsed = parseRegex( arguments.file, "ast" );
					walkAstSemantics( ast, parsed, arguments.file );
					applyAstPositions( parsed, ast );
					return parsed;
				}
				var sourceText = toString( arguments.file.content ?: "" );
				if ( len( trim( sourceText ) ) ) {
					var sourceType = lCase( right( trim( toString( arguments.file.filePath ?: "" ) ), 4 ) ) == ".bxm" ? "template" : "script";
					var sourceAst = BoxAST( source = sourceText, sourceType = sourceType, returnType = "struct" );
					var sourceParsed = parseRegex( arguments.file, "ast" );
					walkAstSemantics( sourceAst, sourceParsed, arguments.file );
					applyAstPositions( sourceParsed, sourceAst );
					return sourceParsed;
				}
			} catch ( any astError ) {
				if ( strategy == "ast" ) return parseRegex( arguments.file, "regex-fallback" );
			}
		}
		return parseRegex( arguments.file, "regex" );
	}

	private struct function parseRegex( required struct file, string parseStrategy = "regex" ) {
		var symbols = [];
		var dependencies = [];
		var normalizedPath = replace(
			arguments.file.filePath,
			"\",
			"/",
			"all"
		);
		// A `handlers/` directory is ColdBox convention, not a language rule. Keying
		// only on it meant a ColdFusion project that does not follow the layout —
		// including ColdBox itself — produced zero handler-actions and therefore
		// zero request flows, with nothing saying why. The file-name convention is
		// the other half of the same signal and is just as explicit.
		var isHandler = reFindNoCase( "(^|/)handlers/|handler\.(?:cfc|bx)$", normalizedPath ) > 0;
		var isTest = reFindNoCase( "(^|/)tests/|(?:spec|test)\.bx$", normalizedPath ) > 0;
		var className = listFirst( listLast( normalizedPath, "/" ), "." );
		extractSqlDependencies( dependencies, arguments.file.lines );

		for ( var lineNumber = 1; lineNumber <=
			arguments
				.file
				.lines
				.len(); lineNumber++ ) {
			var sourceLine = arguments.file.lines[ lineNumber ];
			var trimmed = trim( sourceLine );
			if ( !len( trimmed ) || reFind( "^(//|/\*|\*|<!--)", trimmed ) ) {
				continue;
			}

			var classMatch = match(
				"^\s*(?:abstract\s+|final\s+)?(class|interface)\b(.*)$",
				sourceLine
			);
			if ( classMatch.find() ) {
				symbols.append(
						symbol(
							classMatch.group( 1 ).lCase(),
							className,
							lineNumber,
							sourceLine
						)
					);
				addAttributeDependency(
					dependencies,
					sourceLine,
					"extends",
					"extends",
					lineNumber
				);
				if (
					reFindNoCase(
						"\b(?:testbox\.system\.BaseSpec|coldbox\.system\.testing\.BaseTestCase)\b",
						sourceLine
					)
				) {
					isTest = true;
				}
				var implemented = attribute( sourceLine, "implements" );
				if ( len( implemented ) ) {
					for ( var contract in listToArray( implemented, "," ) ) {
						dependencies.append(
								dependency(
									"implements",
									trim( contract ),
									lineNumber,
									sourceLine
								)
							);
					}
				}
			}

			var functionMatch = match(
				"^\s*(?:(?:public|private|protected|remote|package|static|final|abstract)\s+)*(?:([A-Za-z_][A-Za-z0-9_.]*)\s+)?function\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(([^)]*)",
				sourceLine
			);
			var declaredFunction = "";
			if ( functionMatch.find() ) {
				declaredFunction = functionMatch.group( 2 );
				var returnType = isNull( functionMatch.group( 1 ) ) ? "" : functionMatch.group( 1 );
				symbols.append(
						symbol(
							"function",
							declaredFunction,
							lineNumber,
							sourceLine
						)
					);
				if ( isHandler && !isLifecycleFunction( declaredFunction ) && isHandlerAction( declaredFunction ) ) {
					symbols.append(
							symbol(
								"handler-action",
								declaredFunction,
								lineNumber,
								sourceLine
							)
						);
				}
				if ( isTest && ( reFindNoCase( "^test", declaredFunction ) || reFindNoCase( "@test\b", sourceLine ) ) ) {
					symbols.append(
							symbol(
								"test",
								declaredFunction,
								lineNumber,
								sourceLine
							)
						);
				}
				addTypeDependency(
					dependencies,
					returnType,
					lineNumber,
					sourceLine
				);
				addParameterTypes(
					dependencies,
					functionMatch.group( 3 ),
					lineNumber,
					sourceLine
				);
			}

			if ( reFindNoCase( "^\s*property\b", sourceLine ) ) {
				var propertyName = attribute( sourceLine, "name" );
				if ( len( propertyName ) ) {
					symbols.append(
							symbol(
								"property",
								propertyName,
								lineNumber,
								sourceLine
							)
						);
				}
				addAttributeDependency(
					dependencies,
					sourceLine,
					"inject",
					"injects",
					lineNumber
				);
				addTypeDependency(
					dependencies,
					attribute( sourceLine, "type" ),
					lineNumber,
					sourceLine
				);
			}

			var importMatch = match( "^\s*import\s+([A-Za-z_][A-Za-z0-9_.$]*)", sourceLine );
			if ( importMatch.find() ) {
				dependencies.append(
						dependency(
							"imports",
							importMatch.group( 1 ),
							lineNumber,
							sourceLine
						)
					);
			}

			var routeMatch = match( "\broute\s*\(\s*[""']([^""']+)[""']", sourceLine );
			if ( routeMatch.find() ) {
				symbols.append(
						symbol(
							"route",
							routeMatch.group( 1 ),
							lineNumber,
							sourceLine
						)
				);
				var routeWindow = logicalSource( arguments.file.lines, lineNumber );
				var routeText = routeWindow.text;
				var actionMatch = match( "\.withAction\s*\(\s*[""']([^""']+)[""']", routeText );
				var handlerMatch = match( "\.toHandler\s*\(\s*[""']([^""']+)[""']", routeText );
				var verbMatch = match( "\.withVerbs?\s*\(\s*[""']([^""']+)[""']", routeText );
				if ( handlerMatch.find() ) {
					var routeMetadata = {
						pattern: routeMatch.group( 1 ),
						action : actionMatch.find() ? actionMatch.group( 1 ) : "",
						verb   : verbMatch.find() ? verbMatch.group( 1 ) : ""
					};
					routeMetadata.handler = handlerMatch.group( 1 );
					dependencies.append( dependency( "routes", routeMatch.group( 1 ), lineNumber, routeText, routeWindow.endLine, routeMetadata ) );
				}
			}

			var viewMatch = match( "\b(?:event\.)?setView\s*\(\s*[""']([^""']+)[""']", sourceLine );
			if ( viewMatch.find() ) dependencies.append( dependency( "renders", viewMatch.group( 1 ), lineNumber, sourceLine ) );
			addResponseDependency( dependencies, sourceLine, lineNumber );
			extractResourceDependencies( dependencies, sourceLine, lineNumber );

			var constructionMatch = match( "\bnew\s+([A-Za-z_][A-Za-z0-9_.$]*)", sourceLine );
			while ( constructionMatch.find() ) {
				dependencies.append(
						dependency(
							"constructs",
							constructionMatch.group( 1 ),
							lineNumber,
							sourceLine
						)
					);
			}

			if ( isTest ) {
				addTestBoxSymbols(
					symbols,
					sourceLine,
					lineNumber
				);
			}

			addCallDependencies(
				dependencies,
				sourceLine,
				lineNumber,
				declaredFunction
			);
		}

		return {
			parserVersion: getVersion(),
			parseStrategy: arguments.parseStrategy,
			symbols      : symbols,
			dependencies : dependencies
		};
	}

	private string function configuredStrategy() {
		var strategy = lCase( trim( toString( variables.codegraphParserStrategy ?: "auto" ) ) );
		return listFindNoCase( "auto,ast,regex", strategy ) ? strategy : "auto";
	}

	/**
	 * Keep the existing extraction taxonomy as the compatibility baseline, but
	 * use BoxAST's declaration positions when the AST is available. This makes
	 * multi-line declarations cite their real end line while preserving the
	 * regex kill switch for dialects the AST cannot parse.
	 */
	private void function applyAstPositions( required struct parsed, required struct ast ) {
		var symbolsByName = {};
		for ( var item in arguments.parsed.symbols ?: [] ) {
			var key = lCase( trim( toString( item.name ?: "" ) ) );
			if ( !len( key ) ) continue;
			if ( !symbolsByName.keyExists( key ) ) symbolsByName[ key ] = [];
			symbolsByName[ key ].append( item );
		}
		walkAstPositions( arguments.ast, symbolsByName );
	}

	private void function walkAstPositions( required any node, required struct symbolsByName ) {
		if ( isArray( arguments.node ) ) {
			for ( var child in arguments.node ) walkAstPositions( child, arguments.symbolsByName );
			return;
		}
		if ( !isStruct( arguments.node ) ) return;

		var astType = lCase( trim( toString( astField( arguments.node, "ASTType" ) ) ) );
		var name = astText( astField( arguments.node, "name" ) );
		if ( listFindNoCase( "boxfunctiondeclaration,boxproperty,boxlocalclass", astType ) && len( name ) && arguments.symbolsByName.keyExists( lCase( name ) ) ) {
			var endLine = astEndLine( arguments.node );
			if ( endLine > 0 ) {
				for ( var symbolItem in arguments.symbolsByName[ lCase( name ) ] ) {
					symbolItem.endLine = max( val( symbolItem.endLine ?: symbolItem.line ?: 1 ), endLine );
				}
			}
		}

		for ( var key in structKeyArray( arguments.node ) ) {
			if ( listFindNoCase( "ASTPackage,sourceText,comments,position,documentation,annotations", key ) ) continue;
			var childValue = arguments.node[ key ];
			if ( isStruct( childValue ) || isArray( childValue ) ) walkAstPositions( childValue, arguments.symbolsByName );
		}
	}

	/**
	 * Walk the AST for declarations and expression-level evidence. The regex
	 * extractor remains the compatibility baseline; AST records are merged into
	 * it so a successful AST parse can add multi-line declarations/calls without
	 * dropping dialect-specific regex evidence.
	 */
	private void function walkAstSemantics( required any ast, required struct parsed, required struct file ) {
		var normalizedPath = replace( arguments.file.filePath ?: "", "\", "/", "all" );
		// A `handlers/` directory is ColdBox convention, not a language rule. Keying
		// only on it meant a ColdFusion project that does not follow the layout —
		// including ColdBox itself — produced zero handler-actions and therefore
		// zero request flows, with nothing saying why. The file-name convention is
		// the other half of the same signal and is just as explicit.
		var isHandler = reFindNoCase( "(^|/)handlers/|handler\.(?:cfc|bx)$", normalizedPath ) > 0;
		var isTest = reFindNoCase( "(^|/)tests/|(?:spec|test)\.bx$", normalizedPath ) > 0;
		var className = listFirst( listLast( normalizedPath, "/" ), "." );
		walkAstNode( arguments.ast, arguments.parsed, isHandler, isTest, className );
	}

	private void function walkAstNode(
		required any node,
		required struct parsed,
		required boolean isHandler,
		required boolean isTest,
		required string className
	) {
		if ( isArray( arguments.node ) ) {
			for ( var child in arguments.node ) walkAstNode( child, arguments.parsed, arguments.isHandler, arguments.isTest, arguments.className );
			return;
		}
		if ( !isStruct( arguments.node ) ) return;

		var astType = lCase( trim( toString( astField( arguments.node, "ASTType" ) ) ) );
		var line = astStartLine( arguments.node );
		var endLine = max( line, astEndLine( arguments.node ) );
		var evidence = left( trim( toString( astField( arguments.node, "sourceText" ) ) ), 500 );

		if ( astType == "boxlocalclass" ) {
			var declaredClass = astText( astField( arguments.node, "name" ) );
			if ( !len( declaredClass ) ) declaredClass = arguments.className;
			appendAstSymbol( arguments.parsed.symbols, "class", declaredClass, line, endLine, evidence );
			if ( reFindNoCase( "\\b(?:testbox\\.system\\.BaseSpec|coldbox\\.system\\.testing\\.BaseTestCase)\\b", evidence ) ) arguments.isTest = true;
		}
		if ( astType == "boxclass" && len( arguments.className ) ) appendAstSymbol( arguments.parsed.symbols, "class", arguments.className, line, endLine, evidence );

		if ( astType == "boxfunctiondeclaration" ) {
			var functionName = astText( astField( arguments.node, "name" ) );
			if ( len( functionName ) ) {
				appendAstSymbol( arguments.parsed.symbols, "function", functionName, line, endLine, evidence );
				if ( arguments.isHandler && !isLifecycleFunction( functionName ) && isHandlerAction( functionName ) ) appendAstSymbol( arguments.parsed.symbols, "handler-action", functionName, line, endLine, evidence );
				if ( arguments.isTest && reFindNoCase( "^test", functionName ) ) appendAstSymbol( arguments.parsed.symbols, "test", functionName, line, endLine, evidence );
				addTypeDependency( arguments.parsed.dependencies, astText( astField( arguments.node, "type" ) ), line, evidence );
				for ( var arg in ( isArray( astField( arguments.node, "args" ) ) ? astField( arguments.node, "args" ) : [] ) ) {
					addTypeDependency( arguments.parsed.dependencies, astText( astField( arg, "type" ) ), line, evidence );
				}
			}
		}

		if ( astType == "boxproperty" ) {
			var propertyName = astAnnotationValue( arguments.node, "name" );
			if ( len( propertyName ) ) appendAstSymbol( arguments.parsed.symbols, "property", propertyName, line, endLine, evidence );
			var injected = astAnnotationValue( arguments.node, "inject" );
			if ( len( injected ) ) appendAstDependency( arguments.parsed.dependencies, "injects", injected, line, endLine, evidence );
			addTypeDependency( arguments.parsed.dependencies, astAnnotationValue( arguments.node, "type" ), line, evidence );
		}

		if ( astType == "boxnew" ) {
			var constructed = astText( astField( arguments.node, "expression" ) );
			if ( len( constructed ) ) appendAstDependency( arguments.parsed.dependencies, "constructs", constructed, line, endLine, evidence );
		}

		if ( astType == "boximport" ) {
			var imported = astText( astField( arguments.node, "value" ) );
			if ( !len( imported ) ) imported = astText( astField( arguments.node, "expression" ) );
			if ( !len( imported ) ) imported = reReplace( trim( toString( astField( arguments.node, "sourceText" ) ) ), "^import\\s+", "" );
			if ( len( imported ) ) appendAstDependency( arguments.parsed.dependencies, "imports", imported, line, endLine, evidence );
		}

		if ( astType == "boxfunctioninvocation" ) {
			var functionCall = astText( astField( arguments.node, "name" ) );
			var firstArgument = astArgumentValue( arguments.node, 1 );
			if ( functionCall == "route" && len( firstArgument ) ) appendAstSymbol( arguments.parsed.symbols, "route", firstArgument, line, endLine, evidence );
			if ( functionCall == "queryExecute" ) extractResourceDependencies( arguments.parsed.dependencies, evidence, line );
			if ( listFindNoCase( "describe,feature,story,scenario,given,when,it,then", functionCall ) && len( firstArgument ) ) appendAstSymbol( arguments.parsed.symbols, listFindNoCase( "describe,feature,story,scenario,given,when", functionCall ) ? "test-suite" : "test", firstArgument, line, endLine, evidence );
		}

		if ( astType == "boxmethodinvocation" ) {
			var methodName = astText( astField( arguments.node, "name" ) );
			var methodArgument = astArgumentValue( arguments.node, 1 );
			if ( methodName == "setView" && len( methodArgument ) ) appendAstDependency( arguments.parsed.dependencies, "renders", methodArgument, line, endLine, evidence );
			var routePath = astInvocationValue( arguments.node, "route" );
			if ( len( routePath ) ) {
				var routeHandler = astInvocationValue( arguments.node, "toHandler" );
				var routeAction = astInvocationValue( arguments.node, "withAction" );
				var routeVerb = astInvocationValue( arguments.node, "withVerbs" );
				appendAstSymbol( arguments.parsed.symbols, "route", routePath, line, endLine, evidence );
				if ( len( routeHandler ) ) appendAstDependency( arguments.parsed.dependencies, "routes", routePath, line, endLine, evidence, { pattern: routePath, action: routeAction, verb: routeVerb, handler: routeHandler } );
			}
		}

		for ( var key in structKeyArray( arguments.node ) ) {
			if ( listFindNoCase( "ASTPackage,sourceText,comments,position,documentation,annotations", key ) ) continue;
			var childValue = arguments.node[ key ];
			if ( isStruct( childValue ) || isArray( childValue ) ) walkAstNode( childValue, arguments.parsed, arguments.isHandler, arguments.isTest, arguments.className );
		}
	}

	private void function appendAstSymbol(
		required array symbols,
		required string kind,
		required string name,
		required numeric line,
		required numeric endLine,
		required string evidence
	) {
		var key = lCase( arguments.kind & "|" & arguments.name & "|" & arguments.line );
		for ( var item in arguments.symbols ) {
			var itemKind = structKeyExists( item, "kind" ) ? toString( item.kind ) : "";
			var itemName = structKeyExists( item, "name" ) ? toString( item.name ) : "";
			var itemLine = structKeyExists( item, "line" ) ? val( item.line ) : 0;
			if ( lCase( itemKind & "|" & itemName & "|" & itemLine ) == key ) {
				item.endLine = max( val( structKeyExists( item, "endLine" ) ? item.endLine : itemLine ), arguments.endLine );
				return;
			}
		}
		arguments.symbols.append( symbol( arguments.kind, arguments.name, arguments.line, arguments.evidence, arguments.endLine ) );
	}

	private void function appendAstDependency(
		required array dependencies,
		required string kind,
		required string target,
		required numeric line,
		required numeric endLine,
		required string evidence,
		struct metadata = {}
	) {
		if ( !len( trim( arguments.target ) ) ) return;
		var key = lCase( arguments.kind & "|" & arguments.target & "|" & arguments.line );
		for ( var item in arguments.dependencies ) {
			var itemKind = structKeyExists( item, "kind" ) ? toString( item.kind ) : "";
			var itemTarget = structKeyExists( item, "target" ) ? toString( item.target ) : "";
			var itemLine = structKeyExists( item, "line" ) ? val( item.line ) : 0;
			if ( lCase( itemKind & "|" & itemTarget & "|" & itemLine ) == key ) return;
		}
		arguments.dependencies.append( dependency( arguments.kind, arguments.target, arguments.line, arguments.evidence, arguments.endLine, arguments.metadata ) );
	}

	private any function astField( required struct node, required string key ) {
		if ( !structKeyExists( arguments.node, arguments.key ) ) return "";
		return arguments.node[ arguments.key ];
	}

	private string function astText( required any value ) {
		if ( isNull( arguments.value ) ) return "";
		if ( isSimpleValue( arguments.value ) ) return trim( toString( arguments.value ) );
		if ( !isStruct( arguments.value ) ) return "";
		if ( structKeyExists( arguments.value, "value" ) && !isNull( arguments.value.value ) ) return astText( arguments.value.value );
		if ( structKeyExists( arguments.value, "name" ) && !isStruct( arguments.value.name ) ) return trim( toString( arguments.value.name ?: "" ) );
		if ( structKeyExists( arguments.value, "sourceText" ) ) return trim( toString( arguments.value.sourceText ?: "" ) );
		return "";
	}

	private string function astAnnotationValue( required struct node, required string key ) {
		for ( var annotation in ( isArray( astField( arguments.node, "annotations" ) ) ? astField( arguments.node, "annotations" ) : [] ) ) {
			if ( lCase( astText( astField( annotation, "key" ) ) ) == lCase( arguments.key ) ) return astText( astField( annotation, "value" ) );
		}
		return "";
	}

	private string function astArgumentValue( required struct node, required numeric index ) {
		var args = isArray( astField( arguments.node, "arguments" ) ) ? astField( arguments.node, "arguments" ) : [];
		if ( arguments.index < 1 || arguments.index > args.len() ) return "";
		var argument = args[ arguments.index ];
		return astText( isStruct( argument ) ? astField( argument, "value" ) : argument );
	}

	private string function astInvocationValue( required any node, required string target ) {
		if ( isNull( arguments.node ) || !isStruct( arguments.node ) ) return "";
		var astType = lCase( trim( toString( astField( arguments.node, "ASTType" ) ) ) );
		if ( listFindNoCase( "boxfunctioninvocation,boxmethodinvocation", astType ) && lCase( astText( astField( arguments.node, "name" ) ) ) == lCase( arguments.target ) ) return astArgumentValue( arguments.node, 1 );
		if ( astType == "boxmethodinvocation" ) return astInvocationValue( astField( arguments.node, "obj" ), arguments.target );
		return "";
	}

	private numeric function astStartLine( required struct node ) {
		var position = astField( arguments.node, "position" );
		if ( !isStruct( position ) ) return 1;
		var start = astField( position, "start" );
		if ( !isStruct( start ) ) return 1;
		return max( 1, val( astField( start, "line" ) ?: 1 ) );
	}

	private numeric function astEndLine( required struct node ) {
		var position = astField( arguments.node, "position" );
		if ( !isStruct( position ) ) return 0;
		var end = astField( position, "end" );
		if ( !isStruct( end ) ) return 0;
		return max( 0, val( astField( end, "line" ) ?: 0 ) );
	}

	private void function addTestBoxSymbols(
		required array symbols,
		required string sourceLine,
		required numeric lineNumber
	) {
		var testMatch = match(
			"\b(describe|feature|story|scenario|given|when|it|then)\s*\(\s*[""']([^""']+)[""']",
			arguments.sourceLine
		);
		while ( testMatch.find() ) {
			var testFunction = lCase( testMatch.group( 1 ) );
			arguments.symbols.append(
					symbol(
						listFindNoCase(
								"describe,feature,story,scenario,given,when",
								testFunction
							)
							? "test-suite"
							: "test",
						testMatch.group( 2 ),
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
	}

	private void function addCallDependencies(
		required array dependencies,
		required string sourceLine,
		required numeric lineNumber,
		string declaredFunction = ""
	) {
		// Match against masked text so SQL and prose inside string literals cannot
		// register as calls; evidence below still cites the original line.
		var callMatch = match(
			"\b([A-Za-z_$][A-Za-z0-9_$]*(?:\.[A-Za-z_$][A-Za-z0-9_$]*)*)\s*\(",
			sourceScanner.maskLiterals( arguments.sourceLine )
		);
		while ( callMatch.find() ) {
			var target = callMatch.group( 1 );
			var leafName = listLast( target, "." );
			// Built-ins, matchers and globals can never resolve to a project
			// file, so persisting them only consumes the edge budget.
			if ( callTargetFilter.isNoise( target, "BoxLang" ) || ( len( arguments.declaredFunction ) && leafName == arguments.declaredFunction ) ) {
				continue;
			}
			arguments.dependencies.append(
					dependency(
						"calls",
						target,
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
	}

	private void function addParameterTypes(
		required array dependencies,
		required string parameters,
		required numeric lineNumber,
		required string sourceLine
	) {
		for ( var parameter in listToArray( arguments.parameters, "," ) ) {
			var parameterMatch = match(
				"^\s*(?:required\s+)?([A-Za-z_][A-Za-z0-9_.]*)\s+[A-Za-z_][A-Za-z0-9_]*",
				parameter
			);
			if ( parameterMatch.find() ) {
				addTypeDependency(
					arguments.dependencies,
					parameterMatch.group( 1 ),
					arguments.lineNumber,
					arguments.sourceLine
				);
			}
		}
	}

	private void function addTypeDependency(
		required array dependencies,
		required string target,
		required numeric lineNumber,
		required string sourceLine
	) {
		var builtInTypes = "any,array,binary,boolean,class,date,function,guid,numeric,query,string,struct,uuid,void,xml";
		if ( len( trim( arguments.target ) ) && !listFindNoCase( builtInTypes, trim( arguments.target ) ) ) {
			arguments.dependencies.append(
					dependency(
						"type-reference",
						trim( arguments.target ),
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
	}

	/**
	 * Is this declaration an action a request can actually enter through?
	 *
	 * Being in a handler is not enough. A cold read of the ColdBox framework put
	 * `_privateInvoker`, `init` and `onHandlerDIComplete` at the top of "start
	 * here" under the reason *"a request starts here"* — three things a request
	 * never starts at. The instrument check was satisfied because the entries had
	 * paths and line numbers; only reading them showed they were wrong.
	 *
	 * Constructors, underscore-prefixed internals and the handler lifecycle hooks
	 * are all reachable only by the framework, never by a route.
	 */
	private boolean function isHandlerAction( required string name ) {
		var declared = trim( arguments.name );
		if ( !len( declared ) || left( declared, 1 ) == "_" ) return false;
		return !listFindNoCase(
			"init,onDIComplete,onHandlerDIComplete,preHandler,postHandler,aroundHandler,preEvent,postEvent,aroundEvent,onMissingAction,onError,onInvalidHTTPMethod,onAuthorizationFailure",
			declared
		);
	}

	private boolean function isLifecycleFunction( required string name ) {
		return listFindNoCase(
				"onAppInit,onRequestStart,onRequestEnd,onSessionStart,onSessionEnd,onException",
				arguments.name
			) >
			0;
	}

	private struct function symbol(
		required string kind,
		required string name,
		required numeric line,
		required string evidence,
		numeric endLine = 0
	) {
		return {
			kind    : arguments.kind,
			name    : arguments.name,
			line    : arguments.line,
			endLine : arguments.endLine > 0 ? arguments.endLine : arguments.line,
			evidence: left( trim( arguments.evidence ), 500 )
		};
	}

	private struct function dependency(
		required string kind,
		required string target,
		required numeric line,
		required string evidence,
		numeric endLine = 0,
		struct metadata = {}
	) {
		var result = {
			kind    : arguments.kind,
			target  : arguments.target,
			line    : arguments.line,
			endLine : arguments.endLine > 0 ? arguments.endLine : arguments.line,
			evidence: left( trim( arguments.evidence ), 500 )
		};
		for ( var key in arguments.metadata ) result[ key ] = arguments.metadata[ key ];
		return result;
	}

	private struct function logicalSource( required array lines, required numeric startLine, numeric maxLookahead = 5 ) {
		var text = "";
		var endLine = arguments.startLine;
		var limit = min( arguments.lines.len(), arguments.startLine + arguments.maxLookahead );
		for ( var i = arguments.startLine; i <= limit; i++ ) {
			text &= " " & toString( arguments.lines[ i ] ?: "" );
			endLine = i;
			if ( find( ".end()", text ) ) break;
		}
		return { text: text, endLine: endLine };
	}

	/**
	 * What a request actually returns to its caller.
	 *
	 * G4: flows ended at whatever hop the traversal ran out on, so more than half
	 * of them reported `sinkKind: unknown` — the reader could follow a request all
	 * the way in and never learn what came back. A response is a terminal effect
	 * like a table write is, and it is stated in the source: `renderData( type:
	 * "json" )`, `relocate(`, `setNextEvent(`. The target records the shape, so a
	 * flow can end "responds json" rather than trailing off.
	 *
	 * Deliberately shallow. Whether *this* branch is the one that runs is control
	 * flow, which §16 lists as not statically provable here; the honest claim is
	 * that the action can complete this way, and the flow says so.
	 */
	private void function addResponseDependency( required array dependencies, required string sourceLine, required numeric lineNumber ) {
		var responseShape = responseShapeFor( arguments.sourceLine );
		if ( !len( responseShape ) ) return;
		arguments.dependencies.append( dependency( "responds", responseShape, arguments.lineNumber, arguments.sourceLine ) );
	}

	private string function responseShapeFor( required string sourceLine ) {
		var redirectMatch = match( "\b(?:relocate|setNextEvent)\s*\(", arguments.sourceLine );
		if ( redirectMatch.find() ) return "redirect";
		var renderDataMatch = match( "\brenderData\s*\(", arguments.sourceLine );
		if ( !renderDataMatch.find() ) return "";
		var typeMatch = match( "\btype\s*[:=]\s*[""']([A-Za-z]+)[""']", arguments.sourceLine );
		return typeMatch.find() ? lCase( typeMatch.group( 1 ) ) : "data";
	}

	private void function extractResourceDependencies( required array dependencies, required string sourceLine, required numeric lineNumber ) {
		var scopeMatch = match( "\b(application|session|client)\.([A-Za-z_][A-Za-z0-9_]*)", arguments.sourceLine );
		while ( scopeMatch.find() ) appendUniqueDependency( arguments.dependencies, "scope.#scopeMatch.group( 1 )#", scopeMatch.group( 2 ), arguments.lineNumber, arguments.sourceLine );
		// Shared with Modernize so "what does this talk to" cannot be answered two
		// different ways on the same file. The previous test needed a literal URL
		// as the first argument of `http(` and therefore never fired.
		for ( var integration in integrationDetector.detect( arguments.sourceLine ) ) {
			appendUniqueDependency( arguments.dependencies, integration.kind, integration.target, arguments.lineNumber, arguments.sourceLine );
		}
	}

	private void function extractSqlDependencies( required array dependencies, required array lines ) {
		for ( var queryWindow in variables.sourceScanner.queryWindows( arguments.lines ) ) {
			var references = variables.sourceScanner.sqlReferences( queryWindow.text, true );
			if ( references.dynamicIdentifier ?: false ) continue;
			for ( var table in ( references.tables ?: [] ) ) {
				var evidenceLine = queryWindow.startLine;
				var evidence = queryWindow.lines.len() ? queryWindow.lines[ 1 ] : queryWindow.text;
				for ( var offset = 1; offset <= queryWindow.lines.len(); offset++ ) {
					if ( findNoCase( table, queryWindow.lines[ offset ] ) ) {
						evidenceLine = queryWindow.startLine + offset - 1;
						evidence = queryWindow.lines[ offset ];
						break;
					}
				}
				appendUniqueDependency( arguments.dependencies, references.statementKind ?: "table-query", table, evidenceLine, evidence, evidenceLine );
			}
		}
	}

	private void function appendUniqueDependency(
		required array dependencies,
		required string kind,
		required string target,
		required numeric line,
		required string evidence,
		numeric endLine = 0
	) {
		var key = lCase( arguments.kind & "|" & arguments.target & "|" & arguments.line );
		for ( var item in arguments.dependencies ) {
			var itemKind = structKeyExists( item, "kind" ) ? toString( item.kind ) : "";
			var itemTarget = structKeyExists( item, "target" ) ? toString( item.target ) : "";
			var itemLine = structKeyExists( item, "line" ) ? val( item.line ) : 0;
			if ( lCase( itemKind & "|" & itemTarget & "|" & itemLine ) == key ) return;
		}
		arguments.dependencies.append( dependency( arguments.kind, arguments.target, arguments.line, arguments.evidence, arguments.endLine ) );
	}

	private void function addAttributeDependency(
		required array dependencies,
		required string sourceLine,
		required string attributeName,
		required string kind,
		required numeric lineNumber
	) {
		var target = attribute( arguments.sourceLine, arguments.attributeName );
		if ( len( target ) ) {
			arguments.dependencies.append(
					dependency(
						arguments.kind,
						target,
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
	}

	private string function attribute( required string sourceLine, required string attributeName ) {
		var attributeMatch = match(
			"\b#arguments.attributeName#\s*=\s*[""']([^""']+)[""']",
			arguments.sourceLine
		);
		return attributeMatch.find() ? attributeMatch.group( 1 ) : "";
	}

	private any function match( required string expression, required string source ) {
		return variables.sourceScanner.matcher( arguments.expression, arguments.source, false );
	}
}
