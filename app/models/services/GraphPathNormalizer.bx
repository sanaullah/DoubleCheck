/**
 * One owner for turning a source path or route into a graph key.
 *
 * Five CodeGraph services each carried their own copy of this, and two of them
 * had drifted to the wrong string literal — `"\\"` instead of `"\"`, which in
 * BoxLang is two backslashes and therefore matches nothing a real path contains.
 * Both were inert only because every caller happened to pass an already
 * normalised path. A key that is computed five ways is a key that will
 * eventually disagree with itself, and the graph joins on it.
 *
 * @see CodeGraphFlowService
 * @see CodeGraphQueryService
 * @see CodeGraphProjectionService
 * @see CodeGraphMetricsService
 */
@singleton
class threadsafe {

	/** Lower-cased, forward-slashed, no repeated separators. */
	string function path( required any value ) {
		var normalized = replace( trim( toString( arguments.value ?: "" ) ), "\", "/", "all" );
		while ( find( "//", normalized ) ) normalized = replace( normalized, "//", "/", "all" );
		return lCase( normalized );
	}

	/**
	 * A route pattern reduced to its comparable shape: query string dropped,
	 * named parameters collapsed to `:id`, trailing slash removed.
	 */
	string function route( required any value ) {
		var normalized = reReplace( trim( toString( arguments.value ?: "" ) ), "\?.*$", "" );
		normalized = reReplace( normalized, ":([A-Za-z_][A-Za-z0-9_]*)", ":id", "all" );
		while ( len( normalized ) > 1 && right( normalized, 1 ) == "/" ) {
			normalized = left( normalized, len( normalized ) - 1 );
		}
		return lCase( normalized );
	}
}
