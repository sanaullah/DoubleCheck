/**
 * Builds allowlisted specialist definitions from the versioned prompt
 * registry. Dynamic task briefs and repository metadata remain user-side data.
 *
 * @see SpecialistReviewService
 */
@singleton
class {
	property name="aiProviderResolver" inject="AIProviderResolverService";
	property name="promptCompiler" inject="PromptCompiler";

	variables.promptVersion = "specialist-prompt-v5";
	variables.roles = {
		security: { name: "SecurityReviewer", description: "Finds exploitable defects with exact source evidence." },
		correctness: { name: "CorrectnessReviewer", description: "Finds concrete behavioral and reliability defects." },
		architecture: { name: "ArchitectureReviewer", description: "Reviews changed component and dependency boundaries." },
		testing: { name: "TestImpactReviewer", description: "Reviews resolved test impact and regression coverage." },
		performance: { name: "PerformanceReviewer", description: "Finds bounded, evidence-backed performance risks." },
		"boxlang-conventions": { name: "BoxLangConventionsReviewer", description: "Reviews BoxLang and ColdBox correctness conventions." },
		"cfml-conventions": { name: "CfmlConventionsReviewer", description: "Finds concrete CFML defects and evidence-backed modernization opportunities." }
	};

	struct function definition( required struct task ) {
		var resolved = aiProviderResolver.resolve();
		var role = lCase( trim( arguments.task.role ?: "" ) );
		if ( !variables.roles.keyExists( role ) ) throw( type = "SpecialistPolicyException", message = "Specialist role is not allowlisted" );
		var roleDefinition = variables.roles[ role ];
		var compiled = getCompiler().compile(
			"specialist.#role#",
			{ task: taskEnvelope( arguments.task ), evidence: {} },
			{ provider: resolved.provider, model: resolved.model }
		);
		var provenance = duplicate( compiled.provenance );
		provenance.promptVersion = variables.promptVersion;
		provenance.contractVersion = compiled.promptVersion;
		provenance.outputSchema = compiled.outputSchema;
		provenance.role = role;
		provenance.promptMode = "agent-tools";
		compiled.provenance = duplicate( provenance );
		return {
			version      : variables.promptVersion,
			promptId     : compiled.promptId,
			outputSchema : compiled.outputSchema,
			taskId       : arguments.task.id,
			role         : role,
			name         : roleDefinition.name,
			description  : roleDefinition.description,
			maxTokens    : max( 1, int( arguments.task.budget.maxTokens ?: 3000 ) ),
			maxIterations: max( 1, int( arguments.task.budget.maxIterations ?: compiled.limits.maxIterations ?: 8 ) ),
			instructions : compiled.systemPrompt,
			input        : compiled.userPrompt,
			promptPackage: compiled,
			provenance   : provenance
		};
	}

	string function input( required struct task ) {
		var resolved = aiProviderResolver.resolve();
		return getCompiler().compile(
			"specialist.#lCase( trim( arguments.task.role ?: '' ) )#",
			{ task: taskEnvelope( arguments.task ), evidence: {} },
			{ provider: resolved.provider, model: resolved.model }
		).userPrompt;
	}

	private any function getCompiler() {
		if ( !isNull( variables.promptCompiler ?: javacast( "null", "" ) ) ) return variables.promptCompiler;
		variables.promptCompiler = new app.models.services.PromptCompiler();
		return variables.promptCompiler;
	}

	private struct function taskEnvelope( required struct task ) {
		var context = arguments.task.context ?: {};
		return {
			taskId   : arguments.task.id,
			role     : arguments.task.role,
			objective: arguments.task.objective ?: "",
			brief    : arguments.task.brief ?: "",
			budget   : arguments.task.budget ?: {},
			context  : {
				changedSymbols     : context.changedSymbols ?: [],
				impactCount        : context.impactCount ?: 0,
				architectureFactIds: context.architectureFactIds ?: [],
				files              : ( context.files ?: [] ).map( ( file ) => {
					return {
						filePath   : file.filePath,
						contentHash: file.contentHash,
						language   : file.language,
						ranges     : file.ranges
					};
				} )
			}
		};
	}
}
