/**
 * Projects a finished snapshot into levelled graph rows.
 *
 * The snapshot is file-shaped because that is what fits on a canvas. The code
 * graph is symbol-shaped. This service derives both, plus the directory and
 * cluster rollups between them, and links every node to its parent so the
 * explorer can drill by query instead of by filtering a downloaded blob.
 *
 * Symbol edges come from `review_dependencies.source_symbol_id`, which is
 * populated by interval containment during indexing. An edge whose source
 * symbol is unknown stays at file level rather than being attributed to a
 * guess.
 *
 * @see CodeGraphGraphRepository
 * @see ArchitectureIndexService
 */

@singleton
class threadsafe {

	/**
	 * Move this whenever the projection's **output shape** changes.
	 *
	 * The snapshot fingerprint covers what the projection reads, not what it does
	 * with it, so a changed projection against an unchanged repository produces an
	 * identical fingerprint — and the reuse path then copies the previous build's
	 * rows. That failure has already been recorded three times against the parse
	 * cache; this is the same mistake one layer down, with its own version.
	 */
	// v9: every node carries `resolution` / `provenance` / `confidence`, so an
	// entity can state how it came to exist the way an edge already could.
	// v8: knowledge carries domain -> domain `depends-on` edges derived from
	// cluster dependencies, and process edges carry their step ordinal.
	// v7: directory edges roll up through every ancestor, so intermediate
	// directories that hold no files directly are no longer isolated.
	// v6: resource nodes carry a declaration line and a parent file for the kinds
	// that genuinely have one (routes, events). They were all `line: 0,
	// parentId: ""`, so every route, table, config key and event the graph named
	// was un-openable and outside the drill hierarchy.
	variables.projectionVersion = "codegraph-projection-v9";

	string function getVersion() {
		return variables.projectionVersion;
	}

	struct function project( required struct snapshot, required struct reviewGraph ) {
		var nodes = [];
		var edges = [];
		var seenNodes = {};
		var clusterOfFile = {};
		var fileNodeIds = {};

		var appendNode = ( node ) => {
			if ( seenNodes.keyExists( node.id ) ) return;
			seenNodes[ node.id ] = true;
			nodes.append( node );
		};

		for ( var cluster in ( arguments.snapshot.clusters ?: [] ) ) {
			if ( !isStruct( cluster ) ) continue;
			var clusterId = "cluster:" & trim( toString( cluster.id ?: "" ) );
			appendNode( {
				id        : clusterId,
				level     : "cluster",
				parentId  : "",
				path      : trim( toString( cluster.label ?: cluster.id ?: "" ) ),
				symbolName: "",
				kind      : "cluster",
				role      : "",
				language  : "",
				// A cluster is computed by modularity over the coupling graph, not
				// read from source. Saying so is the entity-level half of the contract
				// edges have carried since the ontology work.
				resolution: "derived",
				provenance: "derived",
				confidence: "derived",
				line      : 0,
				endLine   : 0,
				fanIn     : val( cluster.crossingEdges ?: 0 ),
				fanOut    : val( cluster.fileCount ?: 0 ),
				hotspot   : val( cluster.fileCount ?: 0 )
			} );
			for ( var filePath in ( cluster.filePaths ?: [] ) ) {
				clusterOfFile[ normalizePath( filePath ) ] = clusterId;
			}
		}

		// The design's navigation model is cluster → directory → directory → file →
		// symbol, one self-join per level. Directories were written as roots, so the
		// middle of that chain did not exist: `app/` never listed `app/models/`.
		// Every ancestor is materialised here, including ones the rollup skipped
		// because they hold no files directly.
		var directorySeen = {};
		var directoryStats = {};
		for ( var directory in ( arguments.snapshot.directories ?: [] ) ) {
			if ( !isStruct( directory ) ) continue;
			var dirPath = normalizePath( directory.path ?: "" );
			directoryStats[ dirPath ] = {
				fanIn  : val( directory.fanInSum ?: 0 ),
				fanOut : val( directory.fanOutSum ?: 0 ),
				hotspot: val( directory.fileCount ?: 0 )
			};
		}
		var directoryPaths = {};
		for ( var dirPath in directoryStats ) {
			var walk = dirPath;
			while ( len( walk ) && walk != "." ) {
				directoryPaths[ walk ] = true;
				if ( !find( "/", walk ) ) break;
				walk = left( walk, len( walk ) - len( listLast( walk, "/" ) ) - 1 );
			}
		}
		var orderedDirectories = structKeyArray( directoryPaths );
		orderedDirectories.sort( ( a, b ) => compareNoCase( a, b ) );
		for ( var dirPath in orderedDirectories ) {
			var dirId = "dir:" & dirPath;
			directorySeen[ dirPath ] = dirId;
			var parentPath = find( "/", dirPath ) ? left( dirPath, len( dirPath ) - len( listLast( dirPath, "/" ) ) - 1 ) : "";
			var stats = directoryStats[ dirPath ] ?: { fanIn: 0, fanOut: 0, hotspot: 0 };
			appendNode( {
				id        : dirId,
				level     : "directory",
				parentId  : len( parentPath ) && directoryPaths.keyExists( parentPath ) ? "dir:" & parentPath : "",
				path      : dirPath,
				symbolName: "",
				kind      : "directory",
				role      : "",
				language  : "",
				// Directories exist on disk; the rollup statistics are derived.
				resolution: "exact",
				provenance: "filesystem",
				confidence: "high",
				line      : 0,
				endLine   : 0,
				fanIn     : stats.fanIn,
				fanOut    : stats.fanOut,
				hotspot   : stats.hotspot
			} );
		}

		// A route, table, setting or event is not a file, and storing it as one made
		// the file level 52% non-code and self-certifying as complete. They get
		// their own level; the ids stay derived from the entity, not its position.
		// Where a resource is *declared*, for the kinds that genuinely have a
		// declaration in this repository. A route is declared by a `route( "/x" )`
		// call and an event by the line that publishes it; a table, a config key or
		// a remote host is referenced from code but declared outside it.
		//
		// Every resource carried `line: 0` and `parentId: ""`, so the answers to
		// "what starts a request" and "which settings does this read" named entities
		// the reader could neither open nor drill to. Only the ones with real
		// evidence get a site — the rest stay 0, because a fabricated location is
		// worse than none.
		// File nodes are appended after this block, so their ids are not known yet.
		// The set of file paths is, and that is all the parent link needs.
		var knownFilePaths = {};
		for ( var node in ( arguments.snapshot.nodes ?: [] ) ) {
			if ( !isStruct( node ) ) continue;
			var candidatePath = normalizePath( node.path ?: node.id ?: "" );
			if ( len( candidatePath ) && !isResourceId( trim( toString( node.id ?: node.path ?: "" ) ) ) ) {
				knownFilePaths[ candidatePath ] = true;
			}
		}

		var resourceOrigins = {};
		for ( var symbolItem in ( arguments.reviewGraph.symbols ?: [] ) ) {
			if ( !isStruct( symbolItem ) || trim( toString( symbolItem.kind ?: "" ) ) != "route" ) continue;
			var routeKey = "route:" & lCase( trim( toString( symbolItem.name ?: "" ) ) );
			if ( resourceOrigins.keyExists( routeKey ) ) continue;
			resourceOrigins[ routeKey ] = {
				path: normalizePath( symbolItem.filePath ?: "" ),
				line: val( symbolItem.line ?: 0 )
			};
		}
		for ( var depItem in ( arguments.reviewGraph.dependencies ?: [] ) ) {
			if ( !isStruct( depItem ) || trim( toString( depItem.kind ?: "" ) ) != "emits" ) continue;
			var eventKey = "event:" & lCase( trim( toString( depItem.target ?: "" ) ) );
			if ( resourceOrigins.keyExists( eventKey ) ) continue;
			resourceOrigins[ eventKey ] = {
				path: normalizePath( depItem.sourceFile ?: "" ),
				line: val( depItem.line ?: 0 )
			};
		}

		var resourceNodeIds = {};
		for ( var node in ( arguments.snapshot.nodes ?: [] ) ) {
			if ( !isStruct( node ) ) continue;
			var rawId = trim( toString( node.id ?: node.path ?: "" ) );
			if ( !isResourceId( rawId ) ) continue;
			var resourceId = "resource:" & lCase( rawId );
			resourceNodeIds[ lCase( rawId ) ] = resourceId;
			var origin = resourceOrigins[ lCase( rawId ) ] ?: { path: "", line: 0 };
			appendNode( {
				id        : resourceId,
				level     : "resource",
				// The declaring file, so a route belongs to its router and the
				// cluster → resource drill exists. Empty for entities declared
				// outside the codebase.
				parentId  : len( origin.path ) && knownFilePaths.keyExists( origin.path ) ? "file:" & origin.path : "",
				path      : rawId,
				symbolName: listRest( rawId, ":" ),
				kind      : lCase( listFirst( rawId, ":" ) ),
				role      : trim( toString( node.role ?: "" ) ),
				language  : "",
				// A route or event was matched at a known line; a table, config key or
				// remote host was inferred from a reference and has no declaration.
				resolution: len( origin.path ) ? "exact" : "heuristic",
				provenance: "parser",
				confidence: len( origin.path ) ? "high" : "medium",
				line      : origin.line,
				endLine   : 0,
				fanIn     : val( node.fanIn ?: 0 ),
				fanOut    : val( node.fanOut ?: 0 ),
				hotspot   : val( node.hotspotScore ?: 0 )
			} );
		}

		for ( var node in ( arguments.snapshot.nodes ?: [] ) ) {
			if ( !isStruct( node ) ) continue;
			var filePath = normalizePath( node.path ?: node.id ?: "" );
			if ( !len( filePath ) || isResourceId( trim( toString( node.id ?: node.path ?: "" ) ) ) ) continue;
			var fileId = "file:" & filePath;
			fileNodeIds[ filePath ] = fileId;
			// A file's parent is its cluster when it has one, so drilling a domain
			// lists its files; otherwise its directory, so nothing is unreachable.
			var parentId = clusterOfFile[ filePath ] ?: ( directorySeen[ normalizePath( node.dir ?: "" ) ] ?: "" );
			appendNode( {
				id        : fileId,
				level     : "file",
				parentId  : parentId,
				path      : node.path ?: filePath,
				symbolName: "",
				kind      : trim( toString( node.component ?: "file" ) ),
				role      : trim( toString( node.role ?: "" ) ),
				language  : trim( toString( node.language ?: "" ) ),
				// The file is on disk; its role and layer are classified.
				resolution: "exact",
				provenance: "filesystem",
				confidence: "high",
				line      : 0,
				endLine   : val( node.lineCount ?: 0 ),
				fanIn     : val( node.fanIn ?: 0 ),
				fanOut    : val( node.fanOut ?: 0 ),
				hotspot   : val( node.hotspotScore ?: 0 )
			} );
		}

		var symbolIdByKey = {};
		var symbolsByFile = {};
		for ( var symbol in ( arguments.reviewGraph.symbols ?: [] ) ) {
			if ( !isStruct( symbol ) ) continue;
			var symbolFile = normalizePath( symbol.filePath ?: "" );
			if ( !fileNodeIds.keyExists( symbolFile ) ) continue;
			var symbolName = trim( toString( symbol.name ?: "" ) );
			if ( !len( symbolName ) ) continue;
			var symbolId = "symbol:" & trim( toString( symbol.id ?: ( symbolFile & "##" & symbolName ) ) );
			symbolIdByKey[ trim( toString( symbol.id ?: "" ) ) ] = symbolId;
			if ( !symbolsByFile.keyExists( symbolFile ) ) symbolsByFile[ symbolFile ] = {};
			symbolsByFile[ symbolFile ][ lCase( symbolName ) ] = symbolId;
			// The declaration site as an edge, not only as a parent link. G5's
			// separation of *defines* from *references*: containment says where a
			// symbol lives, this says the file declares it, and the reference side
			// is served from occurrences by `/references`.
			edges.append( {
				id         : edgeId( "symbol", fileNodeIds[ symbolFile ], symbolId, "defines" ),
				level      : "symbol",
				from       : fileNodeIds[ symbolFile ],
				to         : symbolId,
				groupKind  : "defines",
				kinds      : [ "defines" ],
				occurrences: 1,
				weight     : 1,
				resolution : "exact",
				provenance : "parser",
				confidence : "high",
				line       : val( symbol.line ?: 0 ),
				evidence   : trim( toString( symbol.evidence ?: "" ) )
			} );
			appendNode( {
				id        : symbolId,
				level     : "symbol",
				parentId  : fileNodeIds[ symbolFile ],
				path      : symbol.filePath ?: symbolFile,
				symbolName: symbolName,
				kind      : trim( toString( symbol.kind ?: "symbol" ) ),
				role      : "",
				language  : "",
				// A declaration the parser matched at a known line.
				resolution: "exact",
				provenance: "parser",
				confidence: "high",
				line      : val( symbol.line ?: 0 ),
				endLine   : val( symbol.endLine ?: 0 ),
				fanIn     : 0,
				fanOut    : 0,
				hotspot   : 0
			} );
		}

		for ( var edge in ( arguments.snapshot.clusterEdges ?: [] ) ) {
			if ( !isStruct( edge ) ) continue;
			var from = "cluster:" & trim( toString( edge.from ?: edge.source ?: "" ) );
			var to = "cluster:" & trim( toString( edge.to ?: edge.target ?: "" ) );
			if ( !seenNodes.keyExists( from ) || !seenNodes.keyExists( to ) || from == to ) continue;
			edges.append( {
				id         : edgeId( "cluster", from, to, "" ),
				level      : "cluster",
				from       : from,
				to         : to,
				groupKind  : "cluster-dependency",
				kinds      : [],
				occurrences: val( edge.weight ?: edge.occurrences ?: 1 ),
				weight     : val( edge.weight ?: 0 ),
				resolution : "derived",
				provenance : "derived",
				confidence : "derived",
				line       : 0,
				evidence   : ""
			} );
		}

		// Holds keys for both levels; file and symbol ids cannot collide.
		var edgeSeen = {};
		var symbolFanIn = {};
		var symbolFanOut = {};
		for ( var dep in ( arguments.reviewGraph.dependencies ?: [] ) ) {
			if ( !isStruct( dep ) ) continue;
			var fromFile = normalizePath( dep.sourceFile ?: "" );
			var toFile = normalizePath( dep.targetFile ?: "" );
			var kind = lCase( trim( toString( dep.kind ?: "" ) ) );

			// A dependency on a table, setting, route, event or remote host has no
			// target *file*, so requiring one dropped every such relationship at
			// projection: the entities were stored as nodes nothing pointed at, and
			// `/lineage`, `/neighbours` and the MCP tools answered "empty" for
			// questions the snapshot could already answer.
			if ( !fileNodeIds.keyExists( toFile ) && fileNodeIds.keyExists( fromFile ) ) {
				var resourceKey = lCase( syntheticNodeBuilder().resourceId( dep ) );
				if ( !len( resourceKey ) || !resourceNodeIds.keyExists( resourceKey ) ) continue;
				var resourceTo = resourceNodeIds[ resourceKey ];
				var resourceFrom = fileNodeIds[ fromFile ];
				appendResourceEdge( edges, edgeSeen, resourceFrom, resourceTo, kind, dep );
				var resourceSymbolId = trim( toString( dep.sourceSymbolId ?: "" ) );
				if ( len( resourceSymbolId ) && symbolIdByKey.keyExists( resourceSymbolId ) ) {
					appendResourceEdge( edges, edgeSeen, symbolIdByKey[ resourceSymbolId ], resourceTo, kind, dep );
				}
				continue;
			}

			if ( !fileNodeIds.keyExists( fromFile ) || !fileNodeIds.keyExists( toFile ) ) continue;
			var fileFrom = fileNodeIds[ fromFile ];
			var fileTo = fileNodeIds[ toFile ];
			// A file depending on itself is not a relationship anyone can act on, so
			// it stays out of the file level — but the *symbols* inside it do call
			// each other, and dropping the row here is what kept the call graph
			// cross-file only. Fall through to the symbol pass instead of skipping.
			var sameFile = fromFile == toFile;

			// A `routes` or `calls-api` row resolves to the handling *file*, so the
			// route itself was bypassed: 51 route nodes with no edge, and the entity
			// every flow starts at could not be asked what declares or serves it.
			// Route the relationship through the entity as well as around it.
			var throughResource = lCase( syntheticNodeBuilder().resourceId( dep ) );
			if ( len( throughResource ) && resourceNodeIds.keyExists( throughResource ) && listFindNoCase( "routes,calls-api", kind ) ) {
				var viaNode = resourceNodeIds[ throughResource ];
				appendResourceEdge( edges, edgeSeen, fileFrom, viaNode, kind == "routes" ? "declares" : kind, dep );
				// Only a `routes` row knows the handler. A `calls-api` row resolves to
				// the file that *declares* the route — the router — so emitting the
				// same edge for it told the reader the route was served by its own
				// router. A route "handled by" its declaring file is the declaration
				// read twice, not a second fact.
				if ( kind == "routes" && !sameFile ) {
					appendResourceEdge( edges, edgeSeen, viaNode, fileTo, "routes-to", dep );
				}
			}
			var fileKey = fileFrom & "|" & fileTo & "|" & kind;
			if ( !sameFile && !edgeSeen.keyExists( fileKey ) ) {
				edgeSeen[ fileKey ] = true;
				edges.append( {
					id         : edgeId( "file", fileFrom, fileTo, kind ),
					level      : "file",
					from       : fileFrom,
					to         : fileTo,
					groupKind  : kind,
					kinds      : [ kind ],
					occurrences: 1,
					weight     : 1,
					resolution : resolutionOf( kind ),
					provenance : "parser",
					confidence : confidenceOf( kind ),
					line       : val( dep.line ?: 0 ),
					evidence   : trim( toString( dep.evidence ?: "" ) )
				} );
			}

			var sourceSymbolId = trim( toString( dep.sourceSymbolId ?: "" ) );
			if ( !len( sourceSymbolId ) || !symbolIdByKey.keyExists( sourceSymbolId ) ) continue;
			var symbolFrom = symbolIdByKey[ sourceSymbolId ];
			// An edge at the symbol level must join two symbols. When the target
			// names no symbol in that file, the dependency is already represented
			// by the file-level edge above — emitting a symbol-to-file edge here
			// would break the level contract and the reader would drop it anyway.
			// `ArchitectureIndexService` resolves the file from the call's *receiver*
			// (`service` in `service.method`) while `target` keeps the whole dotted
			// expression, so a verbatim match can never find `method`. Try the leaf
			// as well; prefer a full match when both resolve.
			var targetName = lCase( trim( toString( dep.target ?: "" ) ) );
			var fileSymbols = symbolsByFile[ toFile ] ?: {};
			var symbolTo = fileSymbols[ targetName ] ?: "";
			if ( !len( symbolTo ) && find( ".", targetName ) ) {
				symbolTo = fileSymbols[ lCase( listLast( targetName, "." ) ) ] ?: "";
			}
			if ( !len( symbolTo ) || symbolFrom == symbolTo ) continue;
			var symbolKey = symbolFrom & "|" & symbolTo & "|" & kind;
			if ( edgeSeen.keyExists( symbolKey ) ) continue;
			edgeSeen[ symbolKey ] = true;
			symbolFanOut[ symbolFrom ] = ( symbolFanOut[ symbolFrom ] ?: 0 ) + 1;
			symbolFanIn[ symbolTo ] = ( symbolFanIn[ symbolTo ] ?: 0 ) + 1;
			edges.append( {
				id         : edgeId( "symbol", symbolFrom, symbolTo, kind ),
				level      : "symbol",
				from       : symbolFrom,
				to         : symbolTo,
				groupKind  : kind,
				kinds      : [ kind ],
				occurrences: 1,
				weight     : 1,
				resolution : resolutionOf( kind ),
				provenance : "parser",
				confidence : confidenceOf( kind ),
				line       : val( dep.line ?: 0 ),
				evidence   : trim( toString( dep.evidence ?: "" ) )
			} );
		}

		for ( var node in nodes ) {
			if ( node.level != "symbol" ) continue;
			node.fanIn = symbolFanIn[ node.id ] ?: 0;
			node.fanOut = symbolFanOut[ node.id ] ?: 0;
			node.hotspot = node.fanIn + ( 0.5 * node.fanOut );
		}

		appendDirectoryEdges( nodes, edges, directorySeen );

		return { nodes: nodes, edges: edges };
	}

	/**
	 * Project the narrative into knowledge nodes and edges.
	 *
	 * The meaning layer was prose keyed to ids inside one JSON blob: readable, and
	 * not a graph. Nothing could ask "which risks touch this file", "what is this
	 * cluster for" or "which domain owns this process" without downloading the
	 * narrative and re-implementing the joins in the caller.
	 *
	 * Every knowledge node points at a structural node that already exists — the
	 * normalizer has already discarded any id the snapshot does not contain — so
	 * this cannot invent structure, which is the §1 contract. It only attaches.
	 *
	 * Run as a second pass because the narrative resolves after the projection, and
	 * because a run without a provider must still get the structural graph.
	 */
	struct function projectKnowledge( required struct snapshot, required struct narrative ) {
		var nodes = [];
		var edges = [];
		var seen = {};
		// Model output that named something the graph does not contain was dropped
		// with no record: 29 narrative processes became 23 nodes and nothing said
		// six had gone. The normalizer already counts what *it* rejects; this is a
		// second, later drop point that had no account at all.
		var dropped = { domain: 0, process: 0, risk: 0, duplicate: 0 };
		var appendKnowledge = ( id, kind, label, text, targets ) => {
			if ( seen.keyExists( id ) ) {
				dropped.duplicate++;
				return;
			}
			if ( !targets.len() ) {
				dropped[ kind ] = ( dropped[ kind ] ?: 0 ) + 1;
				return;
			}
			seen[ id ] = true;
			nodes.append( {
				id        : id,
				level     : "knowledge",
				parentId  : targets[ 1 ],
				path      : label,
				symbolName: label,
				kind      : kind,
				role      : "knowledge",
				language  : "",
				// The §1 contract on the entity as well as the edge: a domain, process
				// or risk is a model's interpretation of proven structure.
				resolution: "narrative",
				provenance: "llm",
				confidence: "interpretive",
				line      : 0,
				endLine   : 0,
				fanIn     : 0,
				fanOut    : targets.len(),
				hotspot   : 0
			} );
			var stepOrdinal = 0;
			for ( var target in targets ) {
				stepOrdinal++;
				edges.append( {
					id         : edgeId( "knowledge", id, target, kind == "risk" ? "affects" : "describes" ),
					level      : "knowledge",
					from       : id,
					to         : target,
					groupKind  : kind == "risk" ? "affects" : "describes",
					kinds      : [ kind == "risk" ? "affects" : "describes" ],
					// For a process the targets arrive in flow order, so this is the
					// step number; for a domain or a risk there is one target and the
					// ordinal is simply 1.
					occurrences: stepOrdinal,
					weight     : 1,
					// An LLM sentence about proven structure is neither parsed nor
					// derived from parsing. Saying so on the edge is what keeps the
					// knowledge layer from reading as evidence.
					resolution : "narrative",
					provenance : "llm",
					confidence : "interpretive",
					line       : 0,
					evidence   : left( text, 500 )
				} );
			}
		};

		for ( var domain in ( arguments.narrative.domains ?: [] ) ) {
			if ( !isStruct( domain ) ) continue;
			var clusterId = trim( toString( domain.clusterId ?: "" ) );
			if ( !len( clusterId ) ) continue;
			appendKnowledge(
				"knowledge:domain:" & lCase( clusterId ),
				"domain",
				trim( toString( domain.title ?: clusterId ) ),
				trim( toString( domain.text ?: "" ) ),
				[ "cluster:" & clusterId ]
			);
		}

		// Domain → domain, derived from the cluster dependencies that already exist.
		//
		// The knowledge layer had only `describes` and `affects`: every edge pointed
		// from meaning down at structure, and nothing related two domains to each
		// other. "Which domains does this one depend on" — the question an architect
		// asks first — had no answer at any level.
		//
		// This is derived, not interpreted: the edge exists because files in one
		// cluster depend on files in the other. It is marked `derived` rather than
		// `narrative` for exactly that reason — the *names* are the model's, the
		// relationship is the graph's.
		var domainOfCluster = {};
		for ( var domain in ( arguments.narrative.domains ?: [] ) ) {
			if ( !isStruct( domain ) ) continue;
			var domainCluster = trim( toString( domain.clusterId ?: "" ) );
			if ( len( domainCluster ) ) domainOfCluster[ domainCluster ] = "knowledge:domain:" & lCase( domainCluster );
		}
		var seenDomainEdges = {};
		for ( var clusterEdge in ( arguments.snapshot.clusterEdges ?: [] ) ) {
			if ( !isStruct( clusterEdge ) ) continue;
			var fromDomain = domainOfCluster[ trim( toString( clusterEdge.from ?: "" ) ) ] ?: "";
			var toDomain = domainOfCluster[ trim( toString( clusterEdge.to ?: "" ) ) ] ?: "";
			if ( !len( fromDomain ) || !len( toDomain ) || fromDomain == toDomain ) continue;
			var domainEdgeKey = fromDomain & "|" & toDomain;
			if ( seenDomainEdges.keyExists( domainEdgeKey ) ) continue;
			seenDomainEdges[ domainEdgeKey ] = true;
			edges.append( {
				id         : edgeId( "knowledge", fromDomain, toDomain, "depends-on" ),
				level      : "knowledge",
				from       : fromDomain,
				to         : toDomain,
				groupKind  : "depends-on",
				kinds      : [ "depends-on" ],
				occurrences: val( clusterEdge.edgeCount ?: clusterEdge.weight ?: 1 ),
				weight     : val( clusterEdge.weight ?: 1 ),
				resolution : "derived",
				provenance : "derived",
				confidence : "derived",
				line       : 0,
				evidence   : val( clusterEdge.edgeCount ?: clusterEdge.weight ?: 1 ) & " file dependencies between these modules"
			} );
		}

		// A process is named by a flow, and a flow already knows every file it
		// touches — so the knowledge node attaches to all of them and "which
		// processes run through this file" becomes one query.
		var flowsById = {};
		for ( var flow in ( arguments.snapshot.flows ?: [] ) ) {
			if ( isStruct( flow ) && len( trim( toString( flow.id ?: "" ) ) ) ) flowsById[ trim( toString( flow.id ) ) ] = flow;
		}
		for ( var process in ( arguments.narrative.processes ?: [] ) ) {
			if ( !isStruct( process ) ) continue;
			var flowId = trim( toString( process.flowId ?: "" ) );
			if ( !flowsById.keyExists( flowId ) ) {
				dropped.process++;
				continue;
			}
			// `occurrences` carries the step ordinal, so "which processes run through
			// this file" can also answer *where* in the process. A process attached to
			// its files as an unordered set could say a request touches a repository
			// and not whether that was before or after the handler.
			var orderedTargets = flowTargets( flowsById[ flowId ] );
			appendKnowledge(
				"knowledge:process:" & lCase( flowId ),
				"process",
				trim( toString( process.title ?: flowId ) ),
				trim( toString( process.text ?: "" ) ),
				orderedTargets
			);
		}

		for ( var risk in ( arguments.narrative.risk ?: [] ) ) {
			if ( !isStruct( risk ) ) continue;
			var refId = trim( toString( risk.refId ?: "" ) );
			if ( !len( refId ) ) continue;
			appendKnowledge(
				"knowledge:risk:" & lCase( refId ),
				"risk",
				// A hard 120-character cut left every risk node named by half a
				// sentence — "…including ReviewRunService, ModernizationRunService,
				// CodeGrap". Trim at a word boundary and mark the elision.
				summarise( trim( toString( risk.text ?: refId ) ), 120 ),
				trim( toString( risk.text ?: "" ) ),
				[ "file:" & normalizePath( refId ) ]
			);
		}

		return { nodes: nodes, edges: edges, dropped: dropped };
	}

	/**
	 * A label short enough for a node, cut at a word boundary.
	 *
	 * `left( text, 120 )` produced names ending mid-word. A reader scanning the
	 * knowledge level saw fragments, and the ellipsis is what tells them the rest
	 * exists rather than that the sentence simply stopped.
	 */
	private string function summarise( required string text, required numeric maximum ) {
		var value = trim( arguments.text );
		if ( len( value ) <= arguments.maximum ) return value;
		var cut = left( value, arguments.maximum );
		var boundary = cut.lastIndexOf( " " );
		if ( boundary > arguments.maximum * 0.6 ) cut = left( cut, boundary );
		return trim( cut ) & "…";
	}

	/** Every structural node a flow passes through, as projected node ids. */
	private array function flowTargets( required struct flow ) {
		var targets = [];
		var seen = {};
		var steps = duplicate( arguments.flow.steps ?: [] );
		steps.insertAt( 1, arguments.flow.entryFile ?: "" );
		for ( var step in steps ) {
			var raw = trim( toString( step ?: "" ) );
			if ( !len( raw ) ) continue;
			var id = isResourceId( raw ) ? "resource:" & lCase( raw ) : "file:" & normalizePath( raw );
			if ( seen.keyExists( id ) ) continue;
			seen[ id ] = true;
			targets.append( id );
		}
		return targets;
	}

	/**
	 * Roll file dependencies up into directory-to-directory edges.
	 *
	 * The directory level existed as 62 parented boxes with no relationships at
	 * all, and reported itself complete — a drill step that shows structure and
	 * hides every dependency crossing it. Weight is the number of distinct file
	 * edges behind the roll-up, so a thick line means many files, not one busy
	 * pair. A directory's edge to itself is omitted: internal coupling is what the
	 * level below is for.
	 */
	private void function appendDirectoryEdges(
		required array nodes,
		required array edges,
		required struct directorySeen
	) {
		// Every directory a file sits under, not only its immediate parent. Rolling
		// up one level left every intermediate directory isolated — `app/models`,
		// `app/views`, `app/modules` and `tests/specs` had no edges at all, because
		// no file sits *directly* in them. Half the directory level was unusable as
		// an architecture view: the layer that should answer "how does this project
		// hang together" showed the domain layer connected to nothing.
		var ancestorsOfFile = {};
		for ( var node in arguments.nodes ) {
			if ( node.level != "file" ) continue;
			var dirPath = normalizePath( node.path );
			dirPath = find( "/", dirPath ) ? left( dirPath, len( dirPath ) - len( listLast( dirPath, "/" ) ) - 1 ) : "";
			var chain = [];
			var walk = dirPath;
			while ( len( walk ) && walk != "." ) {
				if ( arguments.directorySeen.keyExists( walk ) ) chain.append( arguments.directorySeen[ walk ] );
				if ( !find( "/", walk ) ) break;
				walk = left( walk, len( walk ) - len( listLast( walk, "/" ) ) - 1 );
			}
			ancestorsOfFile[ node.id ] = chain;
		}
		var rolled = {};
		for ( var edge in arguments.edges ) {
			if ( edge.level != "file" ) continue;
			for ( var from in ( ancestorsOfFile[ edge.from ] ?: [] ) ) {
				for ( var to in ( ancestorsOfFile[ edge.to ] ?: [] ) ) {
					// A directory depending on itself is containment, not a dependency.
					if ( from == to ) continue;
					var key = from & "|" & to & "|" & edge.groupKind;
					if ( !rolled.keyExists( key ) ) {
						rolled[ key ] = { from: from, to: to, kind: edge.groupKind, count: 0, line: 0, evidence: "" };
					}
					rolled[ key ].count++;
				}
			}
		}
		var keys = structKeyArray( rolled );
		keys.sort( ( a, b ) => compareNoCase( a, b ) );
		for ( var key in keys ) {
			var roll = rolled[ key ];
			arguments.edges.append( {
				id         : edgeId( "directory", roll.from, roll.to, roll.kind ),
				level      : "directory",
				from       : roll.from,
				to         : roll.to,
				groupKind  : roll.kind,
				kinds      : [ roll.kind ],
				occurrences: roll.count,
				weight     : roll.count,
				// Derived from file edges rather than read from source, so it carries
				// the resolution of a roll-up and not of a parsed line.
				resolution : "derived",
				provenance : "derived",
				confidence : "derived",
				line       : 0,
				evidence   : roll.count & " file dependencies"
			} );
		}
	}

	/** Is this snapshot node one of the non-file entities? */
	private boolean function isResourceId( required string id ) {
		var prefix = lCase( listFirst( arguments.id, ":" ) );
		return find( ":", arguments.id ) > 0 && listFindNoCase( "route,table,config,event,http,schedule,response", prefix ) > 0;
	}

	/**
	 * One file-or-symbol → resource edge.
	 *
	 * Stored at `level: "resource"` because its endpoints sit at different levels,
	 * and a level-homogeneous reader would otherwise return an edge to a node it
	 * did not also return.
	 */
	private void function appendResourceEdge(
		required array edges,
		required struct edgeSeen,
		required string from,
		required string to,
		required string kind,
		required struct dep
	) {
		var key = arguments.from & "|" & arguments.to & "|" & arguments.kind;
		if ( arguments.edgeSeen.keyExists( key ) ) return;
		arguments.edgeSeen[ key ] = true;
		arguments.edges.append( {
			id         : edgeId( "resource", arguments.from, arguments.to, arguments.kind ),
			level      : "resource",
			from       : arguments.from,
			to         : arguments.to,
			groupKind  : arguments.kind,
			kinds      : [ arguments.kind ],
			occurrences: 1,
			weight     : 1,
			resolution : resolutionOf( arguments.kind ),
			provenance : "parser",
			confidence : confidenceOf( arguments.kind ),
			line       : val( arguments.dep.line ?: 0 ),
			evidence   : trim( toString( arguments.dep.evidence ?: "" ) )
		} );
	}

	private any function syntheticNodeBuilder() {
		if ( isNull( variables.syntheticNodes ?: javacast( "null", "" ) ) ) {
			variables.syntheticNodes = new app.models.services.SyntheticNodeBuilder();
		}
		return variables.syntheticNodes;
	}

	/**
	 * How the relationship was established, so a reader can weigh it.
	 *
	 * `exact` is declared in the source and cannot be wrong. `heuristic` was
	 * resolved by matching a name against a type or symbol, which is right most of
	 * the time and is the honest label for the rest. Nothing here is `unresolved`:
	 * unresolved dependencies are excluded upstream and reported as a count.
	 */
	private string function resolutionOf( required string kind ) {
		return listFindNoCase( "extends,implements,routes,routes-to,declares,renders,includes,imports", arguments.kind ) ? "exact" : "heuristic";
	}

	private string function confidenceOf( required string kind ) {
		if ( listFindNoCase( "extends,implements,routes,routes-to,declares,renders,includes,imports", arguments.kind ) ) return "high";
		// A table name, setting key or event name is read from a literal in the
		// source, so the *name* is not a guess — only its binding to a real table or
		// listener is. That is better evidence than a receiver-type match and worse
		// than a declaration, which is exactly what medium is for.
		if ( listFindNoCase( "injects,constructs,type-reference,tests,table-read,table-write,table-query,reads-config,emits,http,schedule,calls-api", arguments.kind ) ) return "medium";
		return "low";
	}

	private string function edgeId(
		required string level,
		required string from,
		required string to,
		required string kind
	) {
		return arguments.level & "-" & lCase( hash( arguments.from & "|" & arguments.to & "|" & arguments.kind, "SHA-256" ) );
	}

	private string function normalizePath( required any path ) {
		return pathNormalizer().path( arguments.path );
	}
	private any function pathNormalizer() {
		if ( isNull( variables.graphPathNormalizer ?: javacast( "null", "" ) ) ) {
			variables.graphPathNormalizer = new app.models.services.GraphPathNormalizer();
		}
		return variables.graphPathNormalizer;
	}
}
