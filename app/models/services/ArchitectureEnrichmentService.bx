/**
 * Optional LLM enrichment of deterministic architecture facts with citation checks.
 *
 * @see ArchitectureModelService
 * @see AIChatGateway
 */

@singleton
class {
	property name="chatGateway" inject="AIChatGateway";

	property name="aiProviderResolver" inject="AIProviderResolverService";

	property name="factLimit" inject="coldbox:setting:architectureEnrichmentFactLimit";

	property name="maxPromptCharacters" inject="coldbox:setting:architectureEnrichmentMaxCharacters";

	property name="maxInferredFacts" inject="coldbox:setting:architectureEnrichmentMaxFacts";

	property name="log" inject="logbox:logger:{this}";

	property name="secretRedactionService" inject="SecretRedactionService";

	property name="promptCompiler" inject="PromptCompiler";

	property name="promptOutputValidator" inject="PromptOutputValidator";
	variables.enrichmentVersion = "architecture-enrichment-v1";
	variables.factLimit = 200;
	variables.maxPromptCharacters = 30000;
	variables.maxInferredFacts = 50;

	boolean function isEnabled() {
		var resolved = aiProviderResolver.resolve();
		return chatGateway.isEnabled( resolved.apiKey, resolved.isLocal );
	}

	string function cacheKey(
		required app.models.domain.ArchitectureModel architectureModel,
		string projectPath = ""
	) {
		return stableHash( lCase( trim( arguments.projectPath ) ) & "|" & arguments.architectureModel.getFingerprint() & "|" & signature() );
	}

	struct function enrich( required app.models.domain.ArchitectureModel architectureModel ) {
		var resolved = aiProviderResolver.resolve();
		var base = arguments.architectureModel.getMemento();
		if ( !chatGateway.isEnabled( resolved.apiKey, resolved.isLocal ) || !base.facts.len() ) {
			return {
				model: withEnrichment(
					base,
					{
						enabled   : false,
						used      : false,
						version   : variables.enrichmentVersion,
						provider  : resolved.provider,
						model     : resolved.model,
						addedFacts: 0,
						error     : ""
					}
				),
				attempted : false,
				addedFacts: 0,
				error     : "",
				signature : signature()
			};
		}
		var payload = buildPayload( resolved, base.facts );
		assertDistinctSystem( resolved.provider ?: "" );
		var activePackage = payload.promptPackage;
		var response = "";
		var attempts = 0;
		try {
			while ( attempts < 2 ) {
				attempts++;
				try {
					response = chatGateway.chat(
						activePackage.messages,
						buildParams( resolved ),
						buildOptions( resolved )
					);
					getValidator().assertValid(
						response,
						"architecture-enrichment-v1",
						{ allowedFactIds: base.facts.map( ( item ) => item.id ?: "" ) }
					);
					break;
				} catch ( any attemptError ) {
					if ( attempts >= 2 || !isRepairablePromptError( attemptError ) ) rethrow;
					if ( isStruct( attemptError.data ?: "" ) && isArray( attemptError.data.reasonCodes ?: "" ) ) activePackage.provenance.validationReasonCodes = duplicate( attemptError.data.reasonCodes );
					activePackage = getCompiler().compileRepair( activePackage, attemptError.message ?: "output validation failure" );
				}
			}
			var inferredFacts = normalize( response, base.facts );
			var enriched = duplicate( base );
			enriched.facts.append( inferredFacts, true );
			enriched.summary.factCount = enriched.facts.len();
			enriched.summary.inferredFacts = inferredFacts.len();
			enriched.fingerprint = stableHash( base.fingerprint & "|" & signature() & "|" & inferredFacts.map( ( item
							 ) => item.id ).toList( "," ) );
			var metadata = {
				enabled   : true,
				used      : true,
				version   : variables.enrichmentVersion,
				provider  : resolved.provider,
						model     : resolved.model,
						addedFacts: inferredFacts.len(),
						error     : "",
						promptProvenance: activePackage.provenance
			};
			return {
				model     : withEnrichment( enriched, metadata ),
				attempted : true,
				addedFacts: inferredFacts.len(),
				error     : "",
				signature : signature(),
				promptProvenance: activePackage.provenance,
				attempts: attempts
			};
		} catch (any error) {
			if ( !isNull( variables.log ?: javacast( "null", "" ) ) ) {
				log.error(
						"AI architecture enrichment failed",
						{
							type      : error.type ?: "",
							message   : secretRedactionService.redactText( error.message ?: "" ),
							provider  : resolved.provider,
							model     : resolved.model,
							stackTrace: secretRedactionService.redactText( error.stackTrace ?: "" )
						}
					);
			}
			return {
				model: withEnrichment(
					base,
					{
						enabled   : true,
						used      : false,
						version   : variables.enrichmentVersion,
						provider  : resolved.provider,
						model     : resolved.model,
						addedFacts: 0,
						error     : "Architecture enrichment unavailable",
						promptProvenance: activePackage.provenance
					}
				),
				attempted : true,
				addedFacts: 0,
				error     : "Architecture enrichment unavailable",
				signature : signature(),
				promptProvenance: activePackage.provenance,
				attempts: attempts
			};
		}
	}

	private app.models.domain.ArchitectureModel function withEnrichment( required struct modelData, required struct metadata ) {
		var data = duplicate( arguments.modelData );
		data.enrichment = arguments.metadata;
		return new app.models.domain.ArchitectureModel( data );
	}

	private array function normalize( required any response, required array deterministicFacts ) {
		if ( isSimpleValue( arguments.response ) ) {
			try { arguments.response = jsonDeserialize( arguments.response ); } catch ( any ignored ) { return []; }
		}
		if ( !isStruct( arguments.response ) || !isArray( arguments.response.statements ?: "" ) ) {
			return [];
		}
		var factIndex = {};
		for ( var item in arguments.deterministicFacts ) {
			factIndex[ item.id ] = item;
		}
		var inferred = [];
		var seen = {};
		for ( var candidate in arguments.response.statements ) {
			if (
				!isStruct( candidate ) || !len( trim( candidate.statement ?: "" ) ) || !isArray( candidate.evidenceFactIds ?: "" ) ||
					!candidate.evidenceFactIds.len()
			) {
				continue;
			}
			var allEvidenceValid = true;
			var evidenceRecords = [];
			for ( var factId in candidate.evidenceFactIds ) {
				if ( !factIndex.keyExists( factId ) ) {
					allEvidenceValid = false;
					break;
				}
				evidenceRecords.append( duplicate( factIndex[ factId ].evidence ), true );
			}
			if ( !allEvidenceValid || !evidenceRecords.len() ) {
				continue;
			}
			var statement = left( trim( candidate.statement ), 1000 );
			var id = stableHash( "ai|" & statement & "|" & candidate.evidenceFactIds.toList( "," ) );
			if ( seen.keyExists( id ) ) {
				continue;
			}
			seen[ id ] = true;
			inferred.append(
					{
						id  : id,
						type: "inference/" & lCase( candidate.type ?: "architecture" ),
						name: left(
							trim( candidate.name ?: "AI architecture inference" ),
							200
						),
						statement : statement,
						inferred  : true,
						origin    : "bx-ai",
						confidence: isNumeric( candidate.confidence ?: "" ) ? min( 1, max( 0, candidate.confidence ) ) : .7,
						evidence       : evidenceRecords,
						evidenceFactIds: candidate.evidenceFactIds
					}
				);
			if ( inferred.len() >= numericSetting( variables.maxInferredFacts, 50 ) ) {
				break;
			}
		}
		return inferred;
	}

	private struct function buildPayload( required struct resolved, required array facts ) {
		var factRecords = [];
		var characters = 0;
		var maximumFacts = numericSetting( variables.factLimit, 200 );
		var maximumCharacters = numericSetting( variables.maxPromptCharacters, 30000 );
		var window = isNumeric( arguments.resolved.contextWindow ) ? max( 1024, int( val( arguments.resolved.contextWindow ) ) ) : 128000;
		maximumCharacters = min( maximumCharacters, max( 1000, int( window * .75 * 2 ) ) );
		for ( var item in arguments.facts ) {
			var record = {
				id       : item.id,
				type     : item.type,
				statement: item.statement,
				evidence : item.evidence.map(
						( evidenceItem ) => {
							return {
								filePath: evidenceItem.filePath,
								line    : evidenceItem.line,
								recordId: evidenceItem.recordId
							};
						}
					)
			};
			var encoded = jsonSerialize( record );
			if ( factRecords.len() >= maximumFacts || characters + len( encoded ) > maximumCharacters ) {
				break;
			}
			factRecords.append( record );
			characters += len( encoded );
		}
		var compiled = getCompiler().compile(
			"architecture-enricher",
			{
				task    : { factCount: factRecords.len(), maxInferredFacts: numericSetting( variables.maxInferredFacts, 50 ) },
				evidence: { facts: factRecords }
			},
			{ provider: arguments.resolved.provider, model: arguments.resolved.model }
		);
		return { messages: compiled.messages, provenance: compiled.provenance, promptPackage: compiled };
	}

	private boolean function isRepairablePromptError( required any error ) {
		var typeName = lCase( toString( arguments.error.type ?: "" ) );
		var message = lCase( toString( arguments.error.message ?: "" ) );
		return findNoCase( "promptoutputvalidation", typeName ) > 0 || findNoCase( "json", typeName ) > 0 || findNoCase( "parse", message ) > 0 || findNoCase( "json", message ) > 0;
	}

	private void function assertDistinctSystem( required string provider ) {
		if ( !( getCompiler().capabilities( arguments.provider ).distinctSystem ?: true ) ) throw( type = "AIProviderCapabilityException", message = "Provider cannot preserve the immutable prompt system contract" );
	}

	private any function getCompiler() {
		if ( !isNull( variables.promptCompiler ?: javacast( "null", "" ) ) ) return variables.promptCompiler;
		variables.promptCompiler = new app.models.services.PromptCompiler();
		return variables.promptCompiler;
	}

	private any function getValidator() {
		if ( !isNull( variables.promptOutputValidator ?: javacast( "null", "" ) ) ) return variables.promptOutputValidator;
		variables.promptOutputValidator = new app.models.services.PromptOutputValidator();
		return variables.promptOutputValidator;
	}

	private struct function buildParams( required struct resolved ) {
		var window = isNumeric( arguments.resolved.contextWindow ) ? max( 1024, int( val( arguments.resolved.contextWindow ) ) ) : 128000;
		var capabilities = getCompiler().capabilities( arguments.resolved.provider ?: "" );
		var outputCap = isNumeric( capabilities.maxOutputTokens ?: "" ) ? int( capabilities.maxOutputTokens ) : 2000;
		var params = {
			temperature: 0,
			max_tokens : min( outputCap, min( 2000, max( 256, int( window * .25 ) ) ) )
		};
		if ( len( trim( arguments.resolved.model ) ) ) {
			params.model = arguments.resolved.model;
		}
		structAppend( params, getCompiler().structuredOutput( "architecture-enricher", arguments.resolved.provider ?: "" ), true );
		return params;
	}

	private struct function buildOptions( required struct resolved ) {
		var options = {
			provider    : arguments.resolved.provider,
			apiKey      : arguments.resolved.apiKey,
			returnFormat: "json",
			timeout     : arguments.resolved.timeout
		};
		if ( len( trim( arguments.resolved.baseURL ) ) ) {
			options.baseURL = arguments.resolved.baseURL;
		}
		return options;
	}

	private string function signature() {
		var resolved = aiProviderResolver.resolve();
		return variables.enrichmentVersion & ":" & (
			chatGateway.isEnabled( resolved.apiKey, resolved.isLocal ) ? "enabled" : "disabled"
		) & ":" & lCase( resolved.provider ) & ":" & lCase( resolved.model );
	}

	private numeric function numericSetting( required any value, required numeric fallback ) {
		return isNumeric( arguments.value ) ? max( 1, val( arguments.value ) ) : arguments.fallback;
	}

	private string function stableHash( required string value ) {
		return lCase( hash( arguments.value, "SHA-256" ) );
	}
}
