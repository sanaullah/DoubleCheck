/**
 * Parses CFML (.cfc/.cfm) sources into symbols, dependencies, and impact edges for the graph.
 * Mirrors BoxLangParserService's contract so ArchitectureIndexService can dispatch to either.
 *
 * @see BoxLangParserService
 * @see ArchitectureIndexService
 */

@singleton
class {
	variables.parserVersion = "cfml-symbol-parser-v5";
	variables.patternCache  = {};
	variables.callTargetFilter = new app.models.services.CallTargetFilter();

	string function getVersion() {
		return variables.parserVersion;
	}

	boolean function supports( required struct file ) {
		return arguments.file.language == "CFML";
	}

	struct function parse( required struct file ) {
		var symbols = [];
		var dependencies = [];
		var normalizedPath = replace(
			arguments.file.filePath,
			"\",
			"/",
			"all"
		);
		var isHandler = reFindNoCase( "(^|/)handlers/", normalizedPath ) > 0;
		var isTest = reFindNoCase( "(^|/)tests/|(?:spec|test)\.cfc$", normalizedPath ) > 0;
		var isApplicationCfc = reFindNoCase( "(^|/)Application\.cfc$", normalizedPath ) > 0;
		var className = listFirst( listLast( normalizedPath, "/" ), "." );
		extractSqlDependencies( dependencies, arguments.file.lines );

		for ( var lineNumber = 1; lineNumber <= arguments.file.lines.len(); lineNumber++ ) {
			var sourceLine = arguments.file.lines[ lineNumber ];
			var trimmed = trim( sourceLine );
			if ( !len( trimmed ) ) {
				continue;
			}

			// <cfcomponent name="..." extends="..." implements="...">
			var tagComponentMatch = match( "<cfcomponent\b", sourceLine );
			// script: component extends="..." implements="..." { ... }
			var scriptComponentMatch = match( "^\s*(?:final\s+|abstract\s+)?component\b", sourceLine );
			var isTagComponent = tagComponentMatch.find();
			if ( isTagComponent || scriptComponentMatch.find() ) {
				var componentTagText = isTagComponent ? joinTagLines( arguments.file.lines, lineNumber ).text : sourceLine;
				var componentName = attribute( componentTagText, "name" );
				symbols.append(
						symbol(
							"class",
							len( componentName ) ? componentName : className,
							lineNumber,
							sourceLine
						)
					);
				addAttributeDependency(
					dependencies,
					componentTagText,
					"extends",
					"extends",
					lineNumber
				);
				var implemented = attribute( componentTagText, "implements" );
				if ( len( implemented ) ) {
					for ( var contract in listToArray( implemented, "," ) ) {
						dependencies.append(
								dependency(
									"implements",
									trim( contract ),
									lineNumber,
									sourceLine
								)
							);
					}
				}
			}

			// <cffunction name="...">
			var tagFunctionMatch = match( "<cffunction\b", sourceLine );
			// script: [modifiers] function name(...)
			var scriptFunctionMatch = match(
				"^\s*(?:(?:public|private|package|remote|static|final|abstract)\s+)*(?:([A-Za-z_][A-Za-z0-9_.]*)\s+)?function\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(([^)]*)",
				sourceLine
			);
			var declaredFunction = "";
			if ( tagFunctionMatch.find() ) {
				declaredFunction = attribute( joinTagLines( arguments.file.lines, lineNumber ).text, "name" );
				if ( len( declaredFunction ) ) {
					addFunctionSymbols(
						symbols,
						declaredFunction,
						lineNumber,
						sourceLine,
						isHandler,
						isApplicationCfc
					);
				}
			} else if ( scriptFunctionMatch.find() ) {
				declaredFunction = scriptFunctionMatch.group( 2 );
				addFunctionSymbols(
					symbols,
					declaredFunction,
					lineNumber,
					sourceLine,
					isHandler,
					isApplicationCfc
				);
				var returnType = isNull( scriptFunctionMatch.group( 1 ) ) ? "" : scriptFunctionMatch.group( 1 );
				addTypeDependency(
					dependencies,
					returnType,
					lineNumber,
					sourceLine
				);
				addParameterTypes(
					dependencies,
					scriptFunctionMatch.group( 3 ),
					lineNumber,
					sourceLine
				);
			}

			// <cfproperty name="..." type="...">  |  script: property name="..." type="...";
			if ( reFindNoCase( "^\s*<?cfproperty\b|^\s*property\b", sourceLine ) ) {
				var isCfpropertyTag = reFindNoCase( "<cfproperty\b", sourceLine ) > 0;
				var propertyTagText = isCfpropertyTag ? joinTagLines( arguments.file.lines, lineNumber ).text : sourceLine;
				var propertyName = attribute( propertyTagText, "name" );
				if ( len( propertyName ) ) {
					symbols.append(
							symbol(
								"property",
								propertyName,
								lineNumber,
								sourceLine
							)
						);
				}
				addTypeDependency(
					dependencies,
					attribute( propertyTagText, "type" ),
					lineNumber,
					sourceLine
				);
				addAttributeDependency(
					dependencies,
					propertyTagText,
					"inject",
					"injects",
					lineNumber
				);
			}

			// <cfimport ...>  |  script: import ...;
			var tagImportMatch = match( "<cfimport\b", sourceLine );
			var scriptImportMatch = match( "^\s*import\s+([A-Za-z_][A-Za-z0-9_.$]*)", sourceLine );
			if ( tagImportMatch.find() ) {
				var importPath = attribute( joinTagLines( arguments.file.lines, lineNumber ).text, "path" );
				if ( len( importPath ) ) {
					dependencies.append(
							dependency(
								"imports",
								importPath,
								lineNumber,
								sourceLine
							)
						);
				}
			} else if ( scriptImportMatch.find() ) {
				dependencies.append(
						dependency(
							"imports",
							scriptImportMatch.group( 1 ),
							lineNumber,
							sourceLine
						)
					);
			}

			// <cfinclude template="...">  |  <cfmodule template="..." | name="...">
			var includeMatch = match( "<cf(?:include|module)\b", sourceLine );
			if ( includeMatch.find() ) {
				var includeTagText = joinTagLines( arguments.file.lines, lineNumber ).text;
				var includeTarget = attribute( includeTagText, "template" );
				if ( !len( includeTarget ) ) {
					includeTarget = attribute( includeTagText, "name" );
				}
				if ( len( includeTarget ) ) {
					dependencies.append(
							dependency(
								"includes",
								includeTarget,
								lineNumber,
								sourceLine
							)
						);
				}
			}

			// new Component(...)  |  createObject( "component", "path" )
			var constructionMatch = match( "\bnew\s+([A-Za-z_][A-Za-z0-9_.$]*)", sourceLine );
			while ( constructionMatch.find() ) {
				dependencies.append(
						dependency(
							"constructs",
							constructionMatch.group( 1 ),
							lineNumber,
							sourceLine
						)
					);
			}
			var createObjectMatch = match(
				"\bcreateObject\s*\(\s*[""']component[""']\s*,\s*[""']([^""']+)[""']",
				sourceLine
			);
			if ( createObjectMatch.find() ) {
				dependencies.append(
						dependency(
							"constructs",
							createObjectMatch.group( 1 ),
							lineNumber,
							sourceLine
						)
					);
			}

			if ( isTest ) {
				addTestBoxSymbols(
					symbols,
					sourceLine,
					lineNumber
				);
			}

			addCallDependencies(
				dependencies,
				sourceLine,
				lineNumber,
				declaredFunction
			);
			extractResourceDependencies( dependencies, sourceLine, lineNumber );
		}

		var parseStrategy = "regex";
		var sourcePath = trim( toString( arguments.file.absolutePath ?: arguments.file.filePath ?: "" ) );
		if ( len( sourcePath ) && fileExists( sourcePath ) ) {
			try {
				var ast = BoxAST( filepath = sourcePath, returnType = "struct" );
				if ( enrichFromAst( ast, symbols, dependencies ) ) parseStrategy = "ast";
			} catch ( any astError ) {
				parseStrategy = "regex-fallback";
			}
		}
		var sourceText = toString( arguments.file.content ?: "" );
		if ( len( trim( sourceText ) ) && parseStrategy != "ast" ) {
			try {
				var sourceType = findNoCase( "<cf", sourceText ) > 0 ? "cftemplate" : "cfscript";
				var sourceAst = BoxAST( source = sourceText, sourceType = sourceType, returnType = "struct" );
				if ( enrichFromAst( sourceAst, symbols, dependencies ) ) parseStrategy = "ast";
			} catch ( any sourceAstError ) {
				if ( parseStrategy == "regex" ) parseStrategy = "regex-fallback";
			}
		}

		return {
			parserVersion: variables.parserVersion,
			parseStrategy: parseStrategy,
			symbols      : symbols,
			dependencies : dependencies
		};
	}

	/**
	 * Enrich the line-scoped CFML baseline with BoxAST declaration positions and
	 * expression evidence when the runtime can parse the concrete source file.
	 * Tag/template files remain regex-compatible when BoxAST returns no body.
	 */
	private boolean function enrichFromAst(
		required any ast,
		required array symbols,
		required array dependencies
	) {
		if ( !isStruct( arguments.ast ) ) return false;
		var astType = lCase( trim( toString( astField( arguments.ast, "ASTType" ) ) ) );
		var hasBody = isArray( astField( arguments.ast, "body" ) ) && astField( arguments.ast, "body" ).len() > 0;
		var hasProperties = isArray( astField( arguments.ast, "properties" ) ) && astField( arguments.ast, "properties" ).len() > 0;
		var hasStatements = isArray( astField( arguments.ast, "statements" ) ) && astField( arguments.ast, "statements" ).len() > 0;
		if ( !listFindNoCase( "boxclass,boxscript,boxtemplate", astType ) || ( !hasBody && !hasProperties && !hasStatements ) ) return false;

		walkAstNode( arguments.ast, arguments.symbols, arguments.dependencies );
		applyAstPositions( arguments.ast, arguments.symbols );
		return true;
	}

	private void function walkAstNode(
		required any node,
		required array symbols,
		required array dependencies
	) {
		if ( isArray( arguments.node ) ) {
			for ( var child in arguments.node ) walkAstNode( child, arguments.symbols, arguments.dependencies );
			return;
		}
		if ( !isStruct( arguments.node ) ) return;

		var astType = lCase( trim( toString( astField( arguments.node, "ASTType" ) ) ) );
		var line = astStartLine( arguments.node );
		var endLine = max( line, astEndLine( arguments.node ) );
		var evidence = left( trim( toString( astField( arguments.node, "sourceText" ) ) ), 500 );

		if ( astType == "boxclass" ) {
			var className = astAnnotationValue( arguments.node, "name" );
			if ( len( className ) ) appendAstSymbol( arguments.symbols, "class", className, line, endLine, evidence );
		}

		if ( astType == "boxfunctiondeclaration" ) {
			var functionName = astText( astField( arguments.node, "name" ) );
			if ( len( functionName ) ) appendAstSymbol( arguments.symbols, "function", functionName, line, endLine, evidence );
			addTypeDependency( arguments.dependencies, astText( astField( arguments.node, "type" ) ), line, evidence );
			for ( var arg in ( isArray( astField( arguments.node, "args" ) ) ? astField( arguments.node, "args" ) : [] ) ) {
				addTypeDependency( arguments.dependencies, astText( astField( arg, "type" ) ), line, evidence );
			}
		}

		if ( astType == "boxproperty" ) {
			var propertyName = astAnnotationValue( arguments.node, "name" );
			if ( len( propertyName ) ) appendAstSymbol( arguments.symbols, "property", propertyName, line, endLine, evidence );
			var injected = astAnnotationValue( arguments.node, "inject" );
			if ( len( injected ) ) appendAstDependency( arguments.dependencies, "injects", injected, line, endLine, evidence );
			addTypeDependency( arguments.dependencies, astAnnotationValue( arguments.node, "type" ), line, evidence );
		}

		if ( astType == "boxnew" ) {
			var constructed = astText( astField( arguments.node, "expression" ) );
			if ( len( constructed ) ) appendAstDependency( arguments.dependencies, "constructs", constructed, line, endLine, evidence );
		}

		if ( astType == "boxfunctioninvocation" ) {
			var functionCall = astText( astField( arguments.node, "name" ) );
			if ( functionCall == "queryExecute" ) extractResourceDependencies( arguments.dependencies, evidence, line );
		}

		for ( var key in structKeyArray( arguments.node ) ) {
			if ( listFindNoCase( "ASTPackage,sourceText,comments,position,documentation,annotations", key ) ) continue;
			var childValue = arguments.node[ key ];
			if ( isStruct( childValue ) || isArray( childValue ) ) walkAstNode( childValue, arguments.symbols, arguments.dependencies );
		}
	}

	private void function applyAstPositions( required any ast, required array symbols ) {
		var symbolsByName = {};
		for ( var item in arguments.symbols ) {
			var key = lCase( trim( toString( structKeyExists( item, "name" ) ? item.name : "" ) ) );
			if ( !len( key ) ) continue;
			if ( !symbolsByName.keyExists( key ) ) symbolsByName[ key ] = [];
			symbolsByName[ key ].append( item );
		}
		walkAstPositions( arguments.ast, symbolsByName );
	}

	private void function walkAstPositions( required any node, required struct symbolsByName ) {
		if ( isArray( arguments.node ) ) {
			for ( var child in arguments.node ) walkAstPositions( child, arguments.symbolsByName );
			return;
		}
		if ( !isStruct( arguments.node ) ) return;
		var name = astText( astField( arguments.node, "name" ) );
		var key = lCase( trim( name ) );
		if ( len( key ) && arguments.symbolsByName.keyExists( key ) ) {
			var endLine = astEndLine( arguments.node );
			if ( endLine > 0 ) {
				for ( var symbolItem in arguments.symbolsByName[ key ] ) symbolItem.endLine = max( val( symbolItem.endLine ?: symbolItem.line ?: 1 ), endLine );
			}
		}
		for ( var childKey in structKeyArray( arguments.node ) ) {
			if ( listFindNoCase( "ASTPackage,sourceText,comments,position,documentation,annotations", childKey ) ) continue;
			var childValue = arguments.node[ childKey ];
			if ( isStruct( childValue ) || isArray( childValue ) ) walkAstPositions( childValue, arguments.symbolsByName );
		}
	}

	private void function appendAstSymbol(
		required array symbols,
		required string kind,
		required string name,
		required numeric line,
		required numeric endLine,
		required string evidence
	) {
		var key = lCase( arguments.kind & "|" & arguments.name & "|" & arguments.line );
		for ( var item in arguments.symbols ) {
			var itemKind = structKeyExists( item, "kind" ) ? toString( item.kind ) : "";
			var itemName = structKeyExists( item, "name" ) ? toString( item.name ) : "";
			var itemLine = structKeyExists( item, "line" ) ? val( item.line ) : 0;
			if ( lCase( itemKind & "|" & itemName & "|" & itemLine ) == key ) {
				item.endLine = max( val( structKeyExists( item, "endLine" ) ? item.endLine : itemLine ), arguments.endLine );
				return;
			}
		}
		arguments.symbols.append( symbol( arguments.kind, arguments.name, arguments.line, arguments.evidence, arguments.endLine ) );
	}

	private void function appendAstDependency(
		required array dependencies,
		required string kind,
		required string target,
		required numeric line,
		required numeric endLine,
		required string evidence
	) {
		if ( !len( trim( arguments.target ) ) ) return;
		var key = lCase( arguments.kind & "|" & arguments.target & "|" & arguments.line );
		for ( var item in arguments.dependencies ) {
			var itemKind = structKeyExists( item, "kind" ) ? toString( item.kind ) : "";
			var itemTarget = structKeyExists( item, "target" ) ? toString( item.target ) : "";
			var itemLine = structKeyExists( item, "line" ) ? val( item.line ) : 0;
			if ( lCase( itemKind & "|" & itemTarget & "|" & itemLine ) == key ) return;
		}
		arguments.dependencies.append( dependency( arguments.kind, arguments.target, arguments.line, arguments.evidence, arguments.endLine ) );
	}

	private any function astField( required struct node, required string key ) {
		if ( !structKeyExists( arguments.node, arguments.key ) ) return "";
		return arguments.node[ arguments.key ];
	}

	private string function astText( required any value ) {
		if ( isNull( arguments.value ) ) return "";
		if ( isSimpleValue( arguments.value ) ) return trim( toString( arguments.value ) );
		if ( !isStruct( arguments.value ) ) return "";
		if ( structKeyExists( arguments.value, "value" ) && !isNull( arguments.value.value ) ) return astText( arguments.value.value );
		if ( structKeyExists( arguments.value, "name" ) && !isStruct( arguments.value.name ) ) return trim( toString( arguments.value.name ?: "" ) );
		if ( structKeyExists( arguments.value, "sourceText" ) ) return trim( toString( arguments.value.sourceText ?: "" ) );
		return "";
	}

	private string function astAnnotationValue( required struct node, required string key ) {
		for ( var annotation in ( isArray( astField( arguments.node, "annotations" ) ) ? astField( arguments.node, "annotations" ) : [] ) ) {
			if ( lCase( astText( astField( annotation, "key" ) ) ) == lCase( arguments.key ) ) return astText( astField( annotation, "value" ) );
		}
		return "";
	}

	private numeric function astStartLine( required struct node ) {
		var position = astField( arguments.node, "position" );
		if ( !isStruct( position ) ) return 1;
		var start = astField( position, "start" );
		if ( !isStruct( start ) ) return 1;
		return max( 1, val( astField( start, "line" ) ?: 1 ) );
	}

	private numeric function astEndLine( required struct node ) {
		var position = astField( arguments.node, "position" );
		if ( !isStruct( position ) ) return 0;
		var end = astField( position, "end" );
		if ( !isStruct( end ) ) return 0;
		return max( 0, val( astField( end, "line" ) ?: 0 ) );
	}

	private void function addFunctionSymbols(
		required array symbols,
		required string declaredFunction,
		required numeric lineNumber,
		required string sourceLine,
		required boolean isHandler,
		required boolean isApplicationCfc
	) {
		arguments.symbols.append(
				symbol(
					"function",
					arguments.declaredFunction,
					arguments.lineNumber,
					arguments.sourceLine
				)
			);
		if ( arguments.isHandler && !isLifecycleFunction( arguments.declaredFunction ) ) {
			arguments.symbols.append(
					symbol(
						"handler-action",
						arguments.declaredFunction,
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
		if ( arguments.isApplicationCfc && isLifecycleFunction( arguments.declaredFunction ) ) {
			arguments.symbols.append(
					symbol(
						"lifecycle-hook",
						arguments.declaredFunction,
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
	}

	private void function addTestBoxSymbols(
		required array symbols,
		required string sourceLine,
		required numeric lineNumber
	) {
		var testMatch = match(
			"\b(describe|feature|story|scenario|given|when|it|then)\s*\(\s*[""']([^""']+)[""']",
			arguments.sourceLine
		);
		while ( testMatch.find() ) {
			var testFunction = lCase( testMatch.group( 1 ) );
			arguments.symbols.append(
					symbol(
						listFindNoCase(
								"describe,feature,story,scenario,given,when",
								testFunction
							)
							? "test-suite"
							: "test",
						testMatch.group( 2 ),
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
	}

	private void function addCallDependencies(
		required array dependencies,
		required string sourceLine,
		required numeric lineNumber,
		string declaredFunction = ""
	) {
		// Masked for matching only; the evidence recorded below is the real line.
		var callMatch = match(
			"\b([A-Za-z_$][A-Za-z0-9_$]*(?:\.[A-Za-z_$][A-Za-z0-9_$]*)*)\s*\(",
			sourceScanner().maskLiterals( arguments.sourceLine )
		);
		while ( callMatch.find() ) {
			var target = callMatch.group( 1 );
			var leafName = listLast( target, "." );
			// Shared with the BoxLang and JavaScript parsers so one concept has
			// one implementation.
			if ( callTargetFilter.isNoise( target, "CFML" ) || ( len( arguments.declaredFunction ) && leafName == arguments.declaredFunction ) ) {
				continue;
			}
			arguments.dependencies.append(
					dependency(
						"calls",
						target,
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
	}

	private void function addParameterTypes(
		required array dependencies,
		required string parameters,
		required numeric lineNumber,
		required string sourceLine
	) {
		for ( var parameter in listToArray( arguments.parameters, "," ) ) {
			var parameterMatch = match(
				"^\s*(?:required\s+)?([A-Za-z_][A-Za-z0-9_.]*)\s+[A-Za-z_][A-Za-z0-9_]*",
				parameter
			);
			if ( parameterMatch.find() ) {
				addTypeDependency(
					arguments.dependencies,
					parameterMatch.group( 1 ),
					arguments.lineNumber,
					arguments.sourceLine
				);
			}
		}
	}

	private void function addTypeDependency(
		required array dependencies,
		required string target,
		required numeric lineNumber,
		required string sourceLine
	) {
		var builtInTypes = "any,array,binary,boolean,date,function,guid,numeric,query,string,struct,uuid,void,xml,component";
		if ( len( trim( arguments.target ) ) && !listFindNoCase( builtInTypes, trim( arguments.target ) ) ) {
			arguments.dependencies.append(
					dependency(
						"type-reference",
						trim( arguments.target ),
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
	}

	private boolean function isLifecycleFunction( required string name ) {
		return listFindNoCase(
				"onApplicationStart,onApplicationEnd,onRequestStart,onRequestEnd,onSessionStart,onSessionEnd,onError,onMissingTemplate,onAbort",
				arguments.name
			) >
			0;
	}

	private struct function symbol(
		required string kind,
		required string name,
		required numeric line,
		required string evidence,
		numeric endLine = 0
	) {
		return {
			kind    : arguments.kind,
			name    : arguments.name,
			line    : arguments.line,
			endLine : arguments.endLine > 0 ? arguments.endLine : arguments.line,
			evidence: left( trim( arguments.evidence ), 500 )
		};
	}

	private struct function dependency(
		required string kind,
		required string target,
		required numeric line,
		required string evidence,
		numeric endLine = 0,
		struct metadata = {}
	) {
		var result = {
			kind    : arguments.kind,
			target  : arguments.target,
			line    : arguments.line,
			endLine : arguments.endLine > 0 ? arguments.endLine : arguments.line,
			evidence: left( trim( arguments.evidence ), 500 )
		};
		for ( var key in arguments.metadata ) result[ key ] = arguments.metadata[ key ];
		return result;
	}

	private void function extractResourceDependencies( required array dependencies, required string sourceLine, required numeric lineNumber ) {
		var scopeMatch = match( "\b(application|session|client)\.([A-Za-z_][A-Za-z0-9_]*)", arguments.sourceLine );
		while ( scopeMatch.find() ) appendUniqueDependency( arguments.dependencies, "scope.#scopeMatch.group( 1 )#", scopeMatch.group( 2 ), arguments.lineNumber, arguments.sourceLine );
		var httpMatch = match( "\b(?:http|httpService)\s*\(\s*[""']([^""']+)[""']", arguments.sourceLine );
		if ( httpMatch.find() ) appendUniqueDependency( arguments.dependencies, "http", httpMatch.group( 1 ), arguments.lineNumber, arguments.sourceLine );
		if ( match( "\bschedule\s*\(", arguments.sourceLine ).find() ) appendUniqueDependency( arguments.dependencies, "schedule", "schedule", arguments.lineNumber, arguments.sourceLine );
	}

	private void function extractSqlDependencies( required array dependencies, required array lines ) {
		var scanner = sourceScanner();
		for ( var queryWindow in scanner.queryWindows( arguments.lines ) ) {
			var references = scanner.sqlReferences( queryWindow.text, true );
			if ( references.dynamicIdentifier ?: false ) continue;
			for ( var table in ( references.tables ?: [] ) ) {
				var evidenceLine = queryWindow.startLine;
				var evidence = queryWindow.lines.len() ? queryWindow.lines[ 1 ] : queryWindow.text;
				for ( var offset = 1; offset <= queryWindow.lines.len(); offset++ ) {
					if ( findNoCase( table, queryWindow.lines[ offset ] ) ) {
						evidenceLine = queryWindow.startLine + offset - 1;
						evidence = queryWindow.lines[ offset ];
						break;
					}
				}
				appendUniqueDependency( arguments.dependencies, "table-query", table, evidenceLine, evidence, evidenceLine );
			}
		}
	}

	private void function appendUniqueDependency(
		required array dependencies,
		required string kind,
		required string target,
		required numeric line,
		required string evidence,
		numeric endLine = 0
	) {
		var key = lCase( arguments.kind & "|" & arguments.target & "|" & arguments.line );
		for ( var item in arguments.dependencies ) {
			var itemKind = structKeyExists( item, "kind" ) ? toString( item.kind ) : "";
			var itemTarget = structKeyExists( item, "target" ) ? toString( item.target ) : "";
			var itemLine = structKeyExists( item, "line" ) ? val( item.line ) : 0;
			if ( lCase( itemKind & "|" & itemTarget & "|" & itemLine ) == key ) return;
		}
		arguments.dependencies.append( dependency( arguments.kind, arguments.target, arguments.line, arguments.evidence, arguments.endLine ) );
	}

	private void function addAttributeDependency(
		required array dependencies,
		required string sourceLine,
		required string attributeName,
		required string kind,
		required numeric lineNumber
	) {
		var target = attribute( arguments.sourceLine, arguments.attributeName );
		if ( len( target ) ) {
			arguments.dependencies.append(
					dependency(
						arguments.kind,
						target,
						arguments.lineNumber,
						arguments.sourceLine
					)
				);
		}
	}

	private string function attribute( required string sourceLine, required string attributeName ) {
		var attributeMatch = match(
			"\b#arguments.attributeName#\s*=\s*[""']([^""']+)[""']",
			arguments.sourceLine
		);
		return attributeMatch.find() ? attributeMatch.group( 1 ) : "";
	}

	/**
	 * Tag attributes commonly wrap across lines (e.g. `<cfcomponent` on one
	 * line, `name="..."` on the next). Joins from startLine up to the line
	 * that closes the tag with `>`, bounded by maxLookahead, so attribute
	 * extraction doesn't silently miss symbols on wrapped tags.
	 */
	private struct function joinTagLines( required array lines, required numeric startLine, numeric maxLookahead = 5 ) {
		return sourceScanner().joinTagLines( arguments.lines, arguments.startLine, arguments.maxLookahead );
	}

	private any function match( required string expression, required string source ) {
		return compiledPattern( arguments.expression ).matcher( arguments.source );
	}
	private any function compiledPattern( required string expression ) {
		// No doubled-backslash normalization here: this service's patterns are
		// written for the Java bridge directly. ModernizationInventoryService
		// normalizes; the shared scanner keeps the two apart by cache key.
		return sourceScanner().compiledPattern( arguments.expression, false );
	}

	private any function sourceScanner() {
		if ( !isNull( variables.cfmlSourceScanner ?: javacast( "null", "" ) ) ) return variables.cfmlSourceScanner;
		variables.cfmlSourceScanner = new app.models.services.CfmlSourceScanner();
		return variables.cfmlSourceScanner;
	}
}
