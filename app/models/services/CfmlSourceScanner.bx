/**
 * Shared CFML scanning *mechanics*: joining a tag that wraps across lines, and
 * compiling/caching the regexes used to read it.
 *
 * Part 5 asks for this because ModernizationInventoryService and
 * CfmlParserService each grew their own copy. It deliberately holds mechanics
 * only — **the extractors are not merged**. Their taxonomies and evidence
 * contracts legitimately differ, and folding them together would silently change
 * what each one reports.
 *
 * Two real differences surfaced while consolidating, and both are preserved
 * rather than flattened:
 *
 *  - The inventory's pattern compiler normalizes doubled backslashes (BoxLang
 *    source literals keep `\\` where Java's regex bridge wants `\`); the
 *    parser's does not. That is a behaviour difference, not an oversight, so it
 *    is a parameter — and it is part of the cache key, because the same
 *    expression compiles to two different patterns depending on it.
 *  - The parser's tag joiner reports `endLine`; the inventory's did not. The
 *    shared one always reports it. An extra key harms no caller; a missing one
 *    would.
 */
@singleton
class threadsafe {

	variables.patternCache = {};

	/**
	 * Joins a tag that wraps across lines into one string, stopping at the first
	 * line containing `>` or after `maxLookahead` lines.
	 *
	 * `toString()` on each line is the inventory's guard: a line array can carry
	 * non-string values, and concatenating those directly throws.
	 */
	struct function joinTagLines( required array lines, required numeric startLine, numeric maxLookahead = 5 ) {
		var text = "";
		var endLine = arguments.startLine;
		var limit = min( arguments.startLine + arguments.maxLookahead, arguments.lines.len() );
		for ( var i = arguments.startLine; i <= limit; i++ ) {
			text &= " " & toString( arguments.lines[ i ] );
			endLine = i;
			if ( find( ">", arguments.lines[ i ] ) ) {
				break;
			}
		}
		return { text: text, endLine: endLine };
	}

	/**
	 * Case-insensitive compiled pattern, cached.
	 *
	 * The cache key includes `normalizeDoubledEscapes` — without it the two
	 * callers would collide on the same expression string and one would silently
	 * receive the other's pattern.
	 */
	any function compiledPattern( required string expression, boolean normalizeDoubledEscapes = false ) {
		var cacheKey = ( arguments.normalizeDoubledEscapes ? "n:" : "r:" ) & arguments.expression;
		if ( !structKeyExists( variables.patternCache, cacheKey ) ) {
			// BoxLang source literals retain doubled backslashes while Java's regex
			// bridge expects a single escape character. Normalize only the doubled
			// form so the conservative patterns compile consistently.
			var expressionText = arguments.normalizeDoubledEscapes
				? replace( arguments.expression, char( 92 ) & char( 92 ), char( 92 ), "all" )
				: arguments.expression;
			variables.patternCache[ cacheKey ] = createObject( "java", "java.util.regex.Pattern" ).compile(
				expressionText,
				createObject( "java", "java.util.regex.Pattern" ).CASE_INSENSITIVE
			);
		}
		return variables.patternCache[ cacheKey ];
	}

	/** A matcher for `source` against `expression`. */
	any function matcher( required string expression, required string source, boolean normalizeDoubledEscapes = false ) {
		return compiledPattern( arguments.expression, arguments.normalizeDoubledEscapes ).matcher( arguments.source );
	}

	/**
	 * Shared SQL-reference mechanics. Modernize keeps its own taxonomy and calls
	 * this with includeDeclarations=false; CodeGraph parsers opt into DDL names
	 * because SchemaService is part of the structural table map.
	 */
	struct function sqlReferences( required string source, boolean includeDeclarations = false ) {
		var tables = [];
		var columns = [];
		var tableExpression = "(?:from|join|into|update|delete\\s+from)\\s+([A-Za-z_][A-Za-z0-9_.$-]*)";
		if ( arguments.includeDeclarations ) {
			tableExpression = "(?:from|join|into|update|delete\\s+from|create\\s+table(?:\\s+if\\s+not\\s+exists)?)\\s+([A-Za-z_][A-Za-z0-9_.$-]*)";
		}
		var tableMatch = matcher( tableExpression, arguments.source, true );
		while ( tableMatch.find() ) {
			var table = tableMatch.group( 1 );
			if ( !tables.contains( table ) ) tables.append( table );
		}
		var columnMatch = matcher( "\\b([A-Za-z_][A-Za-z0-9_.$-]*)\\s*(?:=|>|<|in\\s*\\(|like\\s)", arguments.source, true );
		while ( columnMatch.find() ) columns.append( columnMatch.group( 1 ) );
		var sqlKeyword = matcher( "(select|insert|update|delete|create\\s+table)", arguments.source, true ).find();
		var hasInterpolation = find( char( 35 ), arguments.source ) > 0 || find( "&", arguments.source ) > 0 || find( "+", arguments.source ) > 0 || findNoCase( "stringFormat", arguments.source ) > 0;
		var unparameterized = sqlKeyword && hasInterpolation;
		var hasBinding = reFindNoCase( "(cfqueryparam|params?|queryParams|setParameter)", arguments.source ) > 0;
		var parameterMismatch = unparameterized || ( find( "?", arguments.source ) > 0 && !hasBinding );
		var dynamicIdentifier = reFindNoCase( "(from|join|into|update|delete|create[ ]+table)[ ]+", arguments.source ) > 0 && find( char( 35 ), arguments.source ) > 0;
		return {
			tables            : tables,
			columns           : columns,
			unparameterized   : unparameterized,
			parameterMismatch : parameterMismatch,
			dynamicIdentifier : dynamicIdentifier
		};
	}

	/** Bounded logical queryExecute windows with source positions. */
	array function queryWindows( required array lines, numeric maxLookahead = 200 ) {
		var windows = [];
		for ( var startLine = 1; startLine <= arguments.lines.len(); startLine++ ) {
			if ( !matcher( "\\bqueryExecute\\s*\\(", toString( arguments.lines[ startLine ] ?: "" ), true ).find() ) continue;
			var blockLines = [];
			var endLine = startLine;
			var limit = min( arguments.lines.len(), startLine + max( 1, int( arguments.maxLookahead ) ) );
			for ( var lineNumber = startLine; lineNumber <= limit; lineNumber++ ) {
				var sourceLine = toString( arguments.lines[ lineNumber ] ?: "" );
				blockLines.append( sourceLine );
				endLine = lineNumber;
				if ( matcher( "\\)\\s*;?\\s*$", sourceLine, true ).find() ) break;
			}
			windows.append( {
				startLine : startLine,
				endLine   : endLine,
				lines     : blockLines,
				text      : arrayToList( blockLines, char( 10 ) )
			} );
			startLine = endLine;
		}
		return windows;
	}

	/**
	 * Blank out string literals and line comments so identifier scanning cannot
	 * match inside them, preserving length so column positions stay valid.
	 *
	 * Without this the call extractor reads SQL keywords out of query strings:
	 * `IN` and `JOIN` were the 1st and 8th most frequent "call targets" on this
	 * repository, from `WHERE x IN (` and `JOIN (` inside quoted SQL.
	 *
	 * Interpolation spans are deliberately preserved. `"total ##count( items )##"`
	 * contains a real call, and masking it would trade one class of wrong answer
	 * for another. Block comments are only handled from their opening delimiter to
	 * the end of that line — the callers scan a line at a time and carry no
	 * cross-line state.
	 */
	string function maskLiterals( required string sourceLine ) {
		var source = toString( arguments.sourceLine ?: "" );
		var length = len( source );
		if ( !length ) return source;

		var out = [];
		var quote = "";
		var interpolating = false;
		var index = 1;

		while ( index <= length ) {
			var glyph = mid( source, index, 1 );

			if ( !len( quote ) ) {
				var pair = index < length ? mid( source, index, 2 ) : "";
				// A comment runs to end of line; nothing after it is code.
				if ( pair == "//" || pair == "/*" ) {
					for ( var pad = index; pad <= length; pad++ ) out.append( " " );
					break;
				}
				if ( glyph == '"' || glyph == "'" || glyph == "`" ) {
					quote = glyph;
					out.append( glyph );
					index++;
					continue;
				}
				out.append( glyph );
				index++;
				continue;
			}

			// Inside a literal.
			if ( glyph == "##" || ( quote == "`" && mid( source, index, 2 ) == '${' ) ) {
				interpolating = !interpolating;
				out.append( glyph );
				index++;
				continue;
			}
			if ( glyph == "}" && interpolating && quote == "`" ) {
				interpolating = false;
				out.append( glyph );
				index++;
				continue;
			}
			if ( interpolating ) {
				out.append( glyph );
				index++;
				continue;
			}
			if ( glyph == quote ) {
				// A doubled quote escapes itself in CFML/BoxLang.
				if ( index < length && mid( source, index + 1, 1 ) == quote ) {
					out.append( " " );
					out.append( " " );
					index += 2;
					continue;
				}
				quote = "";
				out.append( glyph );
				index++;
				continue;
			}
			if ( glyph == "\" && index < length ) {
				out.append( " " );
				out.append( " " );
				index += 2;
				continue;
			}
			out.append( " " );
			index++;
		}

		return arrayToList( out, "" );
	}
}
