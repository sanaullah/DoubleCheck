/**
 * Single allowlist for review_runs.run_kind values.
 * Keeps ApiHistory, ReviewHistoryService, and ReviewRunService from drifting.
 */

@singleton
class threadsafe {

	array function all() {
		return [ "review", "modernize", "codegraph" ];
	}

	boolean function isValid( required string runKind ) {
		return all().contains( lCase( trim( arguments.runKind ) ) );
	}

	string function invalidMessage() {
		return "runKind must be review, modernize, or codegraph";
	}

}
