/**
 * Compares architecture fact sets between the current model and a baseline run.
 */

@singleton
class {
	variables.diffVersion = "architecture-diff-v1";

	struct function compare(
		required app.models.domain.ArchitectureModel currentModel,
		any baselineModel = javacast( "null", "" )
	) {
		var current = arguments.currentModel.getMemento();
		if ( isNull( arguments.baselineModel ) ) {
			return {
				version            : variables.diffVersion,
				baselineFingerprint: "",
				currentFingerprint : current.fingerprint,
				added              : current.facts.map( ( item ) => item.id ),
				removed            : [],
				unchanged          : [],
				summary            : {
					addedCount    : current.facts.len(),
					removedCount  : 0,
					unchangedCount: 0,
					hasBaseline   : false
				}
			};
		}
		var baseline = isObject( arguments.baselineModel ) ? arguments.baselineModel.getMemento() : arguments.baselineModel;
		var currentIds = {};
		var baselineIds = {};
		for ( var item in current.facts ) {
			currentIds[ item.id ] = true;
		}
		for ( var item in baseline.facts ) {
			baselineIds[ item.id ] = true;
		}
		var added = [];
		var unchanged = [];
		for ( var id in currentIds ) {
			if ( baselineIds.keyExists( id ) ) {
				unchanged.append( id );
			} else {
				added.append( id );
			}
		}
		var removed = [];
		for ( var id in baselineIds ) {
			if ( !currentIds.keyExists( id ) ) {
				removed.append( id );
			}
		}
		added.sort( "textnocase" );
		removed.sort( "textnocase" );
		unchanged.sort( "textnocase" );
		return {
			version            : variables.diffVersion,
			baselineFingerprint: baseline.fingerprint,
			currentFingerprint : current.fingerprint,
			added              : added,
			removed            : removed,
			unchanged          : unchanged,
			summary            : {
				addedCount    : added.len(),
				removedCount  : removed.len(),
				unchangedCount: unchanged.len(),
				hasBaseline   : true
			}
		};
	}
}