/**
 * Evidence-backed rebuild of a single modernization roadmap phase.
 * Replaces only that phase and its linked artifacts; never widens the plan silently.
 */
@singleton
class threadsafe {
	property name="modernizationRepository" inject="ModernizationRepository";
	property name="agentFactory" inject="ModernizationAgentFactory";
	property name="agentGateway" inject="ModernizationAgentGateway";
	property name="identityService" inject="ModernizationIdentityService";
	property name="validationService" inject="ModernizationValidationService";
	property name="decisionService" inject="ModernizationDecisionService";
	property name="runService" inject="ModernizationRunService";
	property name="secretRedactionService" inject="SecretRedactionService";
	variables.rebuildLocks = {};
	variables.maxNoteChars = 1000;

	function init() {
		if ( isNull( variables.secretRedactionService ?: javacast( "null", "" ) ) ) {
			variables.secretRedactionService = new app.models.services.SecretRedactionService();
		}
		return this;
	}

	void function assertEvidencePack( required struct inventorySlice, required array excerpts ) {
		var units = isArray( arguments.inventorySlice.units ?: "" ) ? arguments.inventorySlice.units : [];
		if ( !units.len() ) return;
		var totalChars = 0;
		for ( var excerpt in arguments.excerpts ) {
			totalChars += len( trim( toString( excerpt.content ?: excerpt.text ?: excerpt ?: "" ) ) );
		}
		if ( totalChars <= 0 ) {
			throw(
				type    = "ModernizationRebuildException",
				message = "Slice rebuild requires legacy source excerpts for linked units"
			);
		}
	}

	struct function mergeFragment( required struct plan, required string phaseId, required struct fragment ) {
		var merged = duplicate( arguments.plan );
		var replaceUnitIds = {};
		var phase = isStruct( arguments.fragment.roadmapPhase ?: "" ) ? arguments.fragment.roadmapPhase : {};
		var oldPhase = findPhase( merged, arguments.phaseId );
		if ( isNull( oldPhase ) ) {
			throw( type = "ModernizationItemNotFound", message = "Roadmap phase was not found" );
		}
		assertFragmentScope( arguments.fragment, oldPhase, arguments.phaseId );
		for ( var unitId in ( isArray( phase.unitIds ?: "" ) ? phase.unitIds : [] ) ) replaceUnitIds[ trim( unitId ) ] = true;
		for ( var unit in ( isArray( arguments.fragment.targetUnits ?: "" ) ? arguments.fragment.targetUnits : [] ) ) {
			replaceUnitIds[ trim( unit.id ?: "" ) ] = true;
		}
		for ( var oldUnitId in ( isArray( oldPhase.unitIds ?: "" ) ? oldPhase.unitIds : [] ) ) {
			replaceUnitIds[ trim( oldUnitId ) ] = true;
		}
		if ( !isStruct( merged.target ?: "" ) ) merged.target = { units: [] };
		if ( !isArray( merged.target.units ?: "" ) ) merged.target.units = [];
		var keptUnits = [];
		for ( var existing in merged.target.units ) {
			var existingId = trim( existing.id ?: "" );
			if ( !replaceUnitIds.keyExists( existingId ) ) keptUnits.append( existing );
		}
		for ( var nextUnit in ( isArray( arguments.fragment.targetUnits ?: "" ) ? arguments.fragment.targetUnits : [] ) ) {
			keptUnits.append( nextUnit );
		}
		merged.target.units = keptUnits;
		merged.unitLinks = replaceCollection( merged.unitLinks ?: [], arguments.fragment.unitLinks ?: [], replaceUnitIds, "targetUnitId" );
		merged.routeContracts = replaceByIds( merged.routeContracts ?: [], arguments.fragment.routeContracts ?: [], collectReplacementIds( oldPhase.routeIds ?: [], phase.routeIds ?: [], arguments.fragment.routeContracts ?: [] ) );
		merged.samples = replaceByIds( merged.samples ?: [], arguments.fragment.samples ?: [], collectReplacementIds( oldPhase.sampleIds ?: [], phase.sampleIds ?: [], arguments.fragment.samples ?: [] ) );
		merged.dbFindings = replaceByIds( merged.dbFindings ?: [], arguments.fragment.dbFindings ?: [], collectReplacementIds( oldPhase.dbFindingIds ?: [], phase.dbFindingIds ?: [], arguments.fragment.dbFindings ?: [] ) );
		merged.dbTransitions = replaceByIds( merged.dbTransitions ?: [], arguments.fragment.dbTransitions ?: [], collectReplacementIds( oldPhase.transitionIds ?: [], phase.transitionIds ?: [], arguments.fragment.dbTransitions ?: [] ) );
		var phases = isArray( merged.roadmapPhases ?: "" ) ? duplicate( merged.roadmapPhases ) : [];
		var replacedPhase = false;
		for ( var index = 1; index <= phases.len(); index++ ) {
			if ( ( phases[ index ].id ?: "" ) == arguments.phaseId ) {
				var nextPhase = duplicate( phase );
				if ( !len( trim( nextPhase.id ?: "" ) ) ) nextPhase.id = arguments.phaseId;
				phases[ index ] = nextPhase;
				replacedPhase = true;
				break;
			}
		}
		if ( !replacedPhase && structCount( phase ) ) phases.append( phase );
		merged.roadmapPhases = phases;
		return merged;
	}

	struct function rebuild( required any run, required string phaseId, required struct input ) {
		ensureModernization( arguments.run );
		if ( !agentGateway.isEnabled() ) {
			throw( type = "AIConfigurationException", message = "Modernization provider is not enabled" );
		}
		var runId = arguments.run.getId();
		if ( variables.rebuildLocks.keyExists( runId ) ) {
			throw( type = "ModernizationRebuildException", message = "A slice rebuild is already in progress for this run" );
		}
		variables.rebuildLocks[ runId ] = true;
		try {
			var planRecord = modernizationRepository.getPlan( runId );
			if ( isNull( planRecord ) ) throw( type = "ValidationException", message = "Modernization plan is not available" );
			var planFingerprint = trim( arguments.input.planFingerprint ?: "" );
			if ( len( planFingerprint ) && planFingerprint != trim( planRecord.fingerprint ?: "" ) ) {
				throw( type = "ModernizationDecisionConflict", message = "The modernization artifact changed; refresh before rebuilding" );
			}
			var plan = duplicate( planRecord.plan ?: {} );
			var phase = findPhase( plan, arguments.phaseId );
			if ( isNull( phase ) ) throw( type = "ModernizationItemNotFound", message = "Roadmap phase was not found" );
			var note = secretRedactionService.redactText( left( trim( arguments.input.note ?: "" ), variables.maxNoteChars ) );
			var evidence = buildEvidencePack( plan, phase, arguments.run.getProjectPath() );
			assertEvidencePack( evidence.inventorySlice, evidence.excerpts );
			var runtime = {
				runtime: plan.metadata.runtime.runtime ?: plan.metadata.runtime ?: "boxlang",
				profile: plan.metadata.targetProfile ?: plan.target.layoutProfile ?: "modern"
			};
			var agentRequest = agentFactory.build(
				"modernization-slice-rebuild",
				runtime,
				{
					phaseId    : arguments.phaseId,
					note       : note,
					phase      : phase,
					priorSlice : extractPriorSlice( plan, phase ),
					evidencePack: evidence
				},
				{}
			);
			var gatewayResult = agentGateway.run( runId, agentRequest, { role: "modernization-slice-rebuild" } );
			if ( !( gatewayResult.ok ?: false ) ) {
				throw( type = "ModernizationRebuildException", message = gatewayResult.error ?: "Slice rebuild provider request failed" );
			}
			var fragment = normalizeFragment( gatewayResult.payload ?: {} );
			assertFragmentScope( fragment, phase, arguments.phaseId );
			var merged = mergeFragment( plan, arguments.phaseId, fragment );
			merged = refingerprintSlice( merged, phase, fragment );
			merged.state = "needs-review";
			var validation = validationService.validate( merged, { inventory: merged.inventory ?: {} } );
			modernizationRepository.savePlan( runId, merged, validation, planRecord.coverage ?: merged.coverage ?: {} );
			decisionService.clearStaleDecisions( runId );
			decisionService.refreshState( runId );
			return {
				result : runService.getResult( runId ),
				rebuild: {
					phaseId          : arguments.phaseId,
					attempt          : gatewayResult.attempt ?: 1,
					skillPack        : agentRequest.skillPack ?: [],
					evidenceUnitCount: ( evidence.inventorySlice.units ?: [] ).len(),
					costUsd          : gatewayResult.costUsd ?: 0
				}
			};
		} finally {
			structDelete( variables.rebuildLocks, runId );
		}
	}

	/**
	 * Rebuild a single db-finding or db-transition in isolation. Unlike rebuild()
	 * this has no roadmap phase to scope against — it reads the prior item plus
	 * schema evidence only, and replaces exactly that one item by id.
	 */
	struct function rebuildItem( required any run, required string itemType, required string itemId, required struct input ) {
		ensureModernization( arguments.run );
		var safeItemType = lCase( trim( arguments.itemType ) );
		if ( ![ "db-finding", "db-transition" ].contains( safeItemType ) ) {
			throw( type = "ValidationException", message = "Item rebuild is only supported for db-finding or db-transition" );
		}
		if ( !agentGateway.isEnabled() ) {
			throw( type = "AIConfigurationException", message = "Modernization provider is not enabled" );
		}
		var runId = arguments.run.getId();
		if ( variables.rebuildLocks.keyExists( runId ) ) {
			throw( type = "ModernizationRebuildException", message = "A slice rebuild is already in progress for this run" );
		}
		variables.rebuildLocks[ runId ] = true;
		try {
			var planRecord = modernizationRepository.getPlan( runId );
			if ( isNull( planRecord ) ) throw( type = "ValidationException", message = "Modernization plan is not available" );
			var planFingerprint = trim( arguments.input.planFingerprint ?: "" );
			if ( len( planFingerprint ) && planFingerprint != trim( planRecord.fingerprint ?: "" ) ) {
				throw( type = "ModernizationDecisionConflict", message = "The modernization artifact changed; refresh before rebuilding" );
			}
			var plan = duplicate( planRecord.plan ?: {} );
			var collection = safeItemType == "db-finding" ? "dbFindings" : "dbTransitions";
			var priorItem = findItemById( isArray( plan[ collection ] ?: "" ) ? plan[ collection ] : [], arguments.itemId );
			if ( isNull( priorItem ) ) throw( type = "ModernizationItemNotFound", message = "Modernization item was not found" );
			var itemFingerprint = trim( arguments.input.itemFingerprint ?: "" );
			if ( len( itemFingerprint ) && itemFingerprint != trim( priorItem.itemFingerprint ?: "" ) ) {
				throw( type = "ModernizationDecisionConflict", message = "The modernization proposal changed; refresh before rebuilding" );
			}
			var note = secretRedactionService.redactText( left( trim( arguments.input.note ?: "" ), variables.maxNoteChars ) );
			var runtime = {
				runtime: plan.metadata.runtime.runtime ?: plan.metadata.runtime ?: "boxlang",
				profile: plan.metadata.targetProfile ?: plan.target.layoutProfile ?: "modern"
			};
			var agentRequest = agentFactory.build(
				"modernization-item-rebuild",
				runtime,
				{
					itemType     : safeItemType,
					itemId       : arguments.itemId,
					note         : note,
					priorItem    : priorItem,
					schemaEvidence: plan.schemaEvidence ?: {}
				},
				{}
			);
			var gatewayResult = agentGateway.run( runId, agentRequest, { role: "modernization-item-rebuild" } );
			if ( !( gatewayResult.ok ?: false ) ) {
				throw( type = "ModernizationRebuildException", message = gatewayResult.error ?: "Item rebuild provider request failed" );
			}
			var payload = isStruct( gatewayResult.payload ?: "" ) ? gatewayResult.payload : {};
			var redacted = {};
			try {
				redacted = secretRedactionService.redactStructured( payload );
			} catch ( any ignored ) {
				redacted = {};
			}
			if ( !isStruct( redacted ) || !redacted.count() ) {
				throw( type = "ModernizationRebuildException", message = "Item rebuild response failed redaction" );
			}
			var replacements = isArray( redacted[ collection ] ?: "" ) ? redacted[ collection ] : [];
			if ( replacements.len() != 1 ) {
				throw( type = "ModernizationRebuildException", message = "Rebuild must return exactly one replacement #safeItemType#" );
			}
			var replacement = duplicate( replacements[ 1 ] );
			var replacementId = trim( replacement.id ?: replacement.itemId ?: "" );
			if ( len( replacementId ) && replacementId != arguments.itemId ) {
				throw( type = "ModernizationRebuildException", message = "Rebuild fragment targeted a different item id" );
			}
			replacement.id = arguments.itemId;
			replacement.itemFingerprint = identityService.itemFingerprint( safeItemType, replacement );
			var items = isArray( plan[ collection ] ?: "" ) ? duplicate( plan[ collection ] ) : [];
			var replaced = false;
			for ( var index = 1; index <= items.len(); index++ ) {
				if ( ( items[ index ].id ?: items[ index ].itemId ?: "" ) == arguments.itemId ) {
					items[ index ] = replacement;
					replaced = true;
					break;
				}
			}
			if ( !replaced ) items.append( replacement );
			plan[ collection ] = items;
			plan.state = "needs-review";
			var validation = validationService.validate( plan, { inventory: plan.inventory ?: {} } );
			modernizationRepository.savePlan( runId, plan, validation, planRecord.coverage ?: plan.coverage ?: {} );
			decisionService.clearStaleDecisions( runId );
			decisionService.refreshState( runId );
			return {
				result : runService.getResult( runId ),
				rebuild: {
					itemId  : arguments.itemId,
					itemType: safeItemType,
					attempt : gatewayResult.attempt ?: 1,
					costUsd : gatewayResult.costUsd ?: 0
				}
			};
		} finally {
			structDelete( variables.rebuildLocks, runId );
		}
	}

	private any function findItemById( required array items, required string itemId ) {
		for ( var item in arguments.items ) {
			if ( ( item.id ?: item.itemId ?: "" ) == arguments.itemId ) return item;
		}
		return javacast( "null", "" );
	}

	struct function buildEvidencePack( required struct plan, required struct phase, required string projectPath ) {
		var linkedLegacyIds = {};
		var linkedPaths = {};
		var phaseUnitIds = stringSet( arguments.phase.unitIds ?: [] );
		for ( var unitId in ( isArray( arguments.phase.unitIds ?: "" ) ? arguments.phase.unitIds : [] ) ) {
			for ( var unit in ( isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [] ) ) {
				if ( ( unit.id ?: "" ) != unitId ) continue;
				for ( var legacyId in ( isArray( unit.legacyUnitIds ?: "" ) ? unit.legacyUnitIds : [] ) ) {
					linkedLegacyIds[ trim( legacyId ) ] = true;
				}
				for ( var sourcePath in listToArray( unit.sourcePath ?: "", ",", true, true ) ) {
					var normalizedPath = lCase( replace( trim( sourcePath ), "\", "/", "all" ) );
					if ( len( normalizedPath ) ) linkedPaths[ normalizedPath ] = true;
				}
			}
		}
		for ( var link in ( isArray( arguments.plan.unitLinks ?: "" ) ? arguments.plan.unitLinks : [] ) ) {
			if ( !phaseUnitIds.keyExists( trim( link.targetUnitId ?: "" ) ) ) continue;
			var linkedLegacyId = trim( link.legacyUnitId ?: link.sourceUnitId ?: "" );
			if ( len( linkedLegacyId ) ) linkedLegacyIds[ linkedLegacyId ] = true;
			var linkedPath = lCase( replace( trim( link.sourcePath ?: link.sourceFile ?: link.filePath ?: "" ), "\", "/", "all" ) );
			if ( len( linkedPath ) ) linkedPaths[ linkedPath ] = true;
		}
		var units = [];
		var excerpts = [];
		for ( var inventoryUnit in ( isStruct( arguments.plan.inventory ?: "" ) && isArray( arguments.plan.inventory.units ?: "" ) ? arguments.plan.inventory.units : [] ) ) {
			var inventoryId = trim( inventoryUnit.id ?: "" );
			var inventoryPath = replace( trim( inventoryUnit.path ?: inventoryUnit.filePath ?: "" ), "\", "/", "all" );
			if ( !( linkedLegacyIds.keyExists( inventoryId ) || linkedPaths.keyExists( lCase( inventoryPath ) ) ) ) continue;
			units.append( inventoryUnit );
			var body = trim( inventoryUnit.content ?: inventoryUnit.sourceExcerpt ?: inventoryUnit.excerpt ?: "" );
			if ( !len( body ) ) body = readSourceExcerpt( arguments.projectPath, inventoryUnit );
			if ( len( body ) ) excerpts.append( { unitId: inventoryId, path: inventoryPath, content: left( body, 4000 ) } );
		}
		return { inventorySlice: { units: units }, excerpts: excerpts };
	}

	private string function readSourceExcerpt( required string projectPath, required struct inventoryUnit ) {
		var relativePath = replace( trim( arguments.inventoryUnit.filePath ?: arguments.inventoryUnit.path ?: "" ), "\", "/", "all" );
		if (
			!len( trim( arguments.projectPath ) ) ||
			!len( relativePath ) ||
			left( relativePath, 1 ) == "/" ||
			reFind( "^[A-Za-z]:", relativePath ) ||
			reFind( "(^|/)\.\.(/|$)", relativePath )
		) return "";
		try {
			var projectRoot = new java:java.io.File( arguments.projectPath ).getCanonicalFile();
			var sourceDocument = new java:java.io.File( projectRoot, relativePath ).getCanonicalFile();
			var rootPath = lCase( replace( projectRoot.getCanonicalPath(), "\", "/", "all" ) ) & "/";
			var sourcePath = lCase( replace( sourceDocument.getCanonicalPath(), "\", "/", "all" ) );
			if ( left( sourcePath, len( rootPath ) ) != rootPath || !sourceDocument.isFile() ) return "";
			var sourceContent = fileRead( sourceDocument.getCanonicalPath(), "UTF-8" );
			var expectedHash = "";
			for ( var ref in ( isArray( arguments.inventoryUnit.evidenceRefs ?: "" ) ? arguments.inventoryUnit.evidenceRefs : [] ) ) {
				if ( len( trim( ref.contentHash ?: "" ) ) ) {
					expectedHash = lCase( trim( ref.contentHash ) );
					break;
				}
			}
			if ( len( expectedHash ) && lCase( hash( sourceContent, "SHA-256" ) ) != expectedHash ) return "";
			var lines = listToArray( replace( sourceContent, char( 13 ), "", "all" ), char( 10 ), true, true );
			if ( !lines.len() ) return "";
			var startLine = max( 1, int( val( arguments.inventoryUnit.startLine ?: 1 ) ) );
			var endLine = min( lines.len(), max( startLine, int( val( arguments.inventoryUnit.endLine ?: startLine ) ) ) );
			var excerptLines = [];
			for ( var lineNumber = startLine; lineNumber <= endLine; lineNumber++ ) {
				excerptLines.append( lines[ lineNumber ] );
			}
			return secretRedactionService.redactText( left( excerptLines.toList( char( 10 ) ), 4000 ) );
		} catch ( any ignored ) {
			return "";
		}
	}

	private struct function extractPriorSlice( required struct plan, required struct phase ) {
		var unitIds = {};
		for ( var unitId in ( isArray( arguments.phase.unitIds ?: "" ) ? arguments.phase.unitIds : [] ) ) unitIds[ trim( unitId ) ] = true;
		var units = [];
		for ( var unit in ( isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [] ) ) {
			if ( unitIds.keyExists( trim( unit.id ?: "" ) ) ) units.append( unit );
		}
		return {
			phase         : arguments.phase,
			targetUnits   : units,
			routeContracts: filterByIds( arguments.plan.routeContracts ?: [], arguments.phase.routeIds ?: [] ),
			samples       : filterByIds( arguments.plan.samples ?: [], arguments.phase.sampleIds ?: [] )
		};
	}

	private struct function normalizeFragment( required struct payload ) {
		var fragment = duplicate( arguments.payload );
		if ( !structKeyExists( fragment, "targetUnits" ) && isArray( fragment.target.units ?: "" ) ) {
			fragment.targetUnits = fragment.target.units;
		}
		if ( !structKeyExists( fragment, "roadmapPhase" ) && isArray( fragment.roadmapPhases ?: "" ) && fragment.roadmapPhases.len() ) {
			fragment.roadmapPhase = fragment.roadmapPhases[ 1 ];
		}
		return fragment;
	}

	private void function assertFragmentScope( required struct fragment, required struct phase, required string phaseId ) {
		var phaseOut = arguments.fragment.roadmapPhase ?: {};
		if ( len( trim( phaseOut.id ?: "" ) ) && trim( phaseOut.id ) != arguments.phaseId ) {
			throw( type = "ModernizationRebuildException", message = "Rebuild fragment targeted a different phase id" );
		}
		if ( !isStruct( phaseOut ) || !structCount( phaseOut ) ) {
			throw( type = "ModernizationRebuildException", message = "Rebuild fragment is missing its roadmap phase" );
		}
		assertCollectionMatchesPhase( arguments.fragment.targetUnits ?: [], phaseOut.unitIds ?: [], "target units" );
		assertCollectionMatchesPhase( arguments.fragment.routeContracts ?: [], phaseOut.routeIds ?: [], "route contracts" );
		assertCollectionMatchesPhase( arguments.fragment.samples ?: [], phaseOut.sampleIds ?: [], "samples" );
		assertCollectionMatchesPhase( arguments.fragment.dbFindings ?: [], phaseOut.dbFindingIds ?: [], "database findings" );
		assertCollectionMatchesPhase( arguments.fragment.dbTransitions ?: [], phaseOut.transitionIds ?: [], "database transitions" );
		var phaseUnitIds = stringSet( phaseOut.unitIds ?: [] );
		for ( var link in ( isArray( arguments.fragment.unitLinks ?: "" ) ? arguments.fragment.unitLinks : [] ) ) {
			if ( !phaseUnitIds.keyExists( trim( link.targetUnitId ?: "" ) ) ) {
				throw( type = "ModernizationRebuildException", message = "Rebuild fragment contains a unit link outside the rebuilt phase" );
			}
		}
		if ( !sameStringSet( arguments.phase.dependencies ?: [], phaseOut.dependencies ?: [] ) ) {
			throw( type = "ModernizationRebuildException", message = "Rebuild fragment cannot change phase dependencies" );
		}
	}

	private void function assertCollectionMatchesPhase( required any items, required any listedIds, required string label ) {
		var itemIds = {};
		for ( var item in ( isArray( arguments.items ) ? arguments.items : [] ) ) {
			var itemId = trim( item.id ?: item.itemId ?: "" );
			if ( !len( itemId ) ) {
				throw( type = "ModernizationRebuildException", message = "Rebuild #arguments.label# must have stable ids" );
			}
			itemIds[ itemId ] = true;
		}
		var phaseIds = stringSet( arguments.listedIds );
		if ( itemIds.count() != phaseIds.count() ) {
			throw( type = "ModernizationRebuildException", message = "Rebuild #arguments.label# do not match the rebuilt phase scope" );
		}
		for ( var itemId in itemIds ) {
			if ( !phaseIds.keyExists( itemId ) ) {
				throw( type = "ModernizationRebuildException", message = "Rebuild #arguments.label# contain an item outside the rebuilt phase" );
			}
		}
	}

	private struct function stringSet( required any values ) {
		var output = {};
		for ( var value in ( isArray( arguments.values ) ? arguments.values : [] ) ) {
			var normalized = trim( toString( value ) );
			if ( len( normalized ) ) output[ normalized ] = true;
		}
		return output;
	}

	private boolean function sameStringSet( required any leftValues, required any rightValues ) {
		var leftSet = stringSet( arguments.leftValues );
		var rightSet = stringSet( arguments.rightValues );
		if ( leftSet.count() != rightSet.count() ) return false;
		for ( var value in leftSet ) if ( !rightSet.keyExists( value ) ) return false;
		return true;
	}

	private struct function refingerprintSlice( required struct plan, required struct phase, required struct fragment ) {
		var kinds = [
			{ collection: "target.units", kind: "target-unit", nested: true },
			{ collection: "unitLinks", kind: "unit-link", nested: false },
			{ collection: "routeContracts", kind: "route-contract", nested: false },
			{ collection: "samples", kind: "sample", nested: false },
			{ collection: "dbFindings", kind: "db-finding", nested: false },
			{ collection: "dbTransitions", kind: "db-transition", nested: false },
			{ collection: "roadmapPhases", kind: "roadmap-phase", nested: false }
		];
		for ( var entry in kinds ) {
			var items = entry.nested
				? ( isStruct( arguments.plan.target ?: "" ) && isArray( arguments.plan.target.units ?: "" ) ? arguments.plan.target.units : [] )
				: ( isArray( arguments.plan[ entry.collection ] ?: "" ) ? arguments.plan[ entry.collection ] : [] );
			for ( var index = 1; index <= items.len(); index++ ) {
				items[ index ].itemFingerprint = identityService.itemFingerprint( entry.kind, items[ index ] );
			}
			if ( entry.nested ) arguments.plan.target.units = items;
			else arguments.plan[ entry.collection ] = items;
		}
		return arguments.plan;
	}

	private any function findPhase( required struct plan, required string phaseId ) {
		for ( var phase in ( isArray( arguments.plan.roadmapPhases ?: "" ) ? arguments.plan.roadmapPhases : [] ) ) {
			if ( ( phase.id ?: "" ) == arguments.phaseId ) return phase;
		}
		return javacast( "null", "" );
	}

	private array function replaceByIds( required array existing, required array incoming, required struct replaceIds ) {
		var kept = [];
		for ( var item in arguments.existing ) {
			var id = trim( item.id ?: item.itemId ?: "" );
			if ( !arguments.replaceIds.keyExists( id ) ) kept.append( item );
		}
		for ( var nextItem in arguments.incoming ) kept.append( nextItem );
		return kept;
	}

	private array function replaceCollection( required array existing, required array incoming, required struct replaceUnitIds, required string unitKey ) {
		var kept = [];
		for ( var item in arguments.existing ) {
			var linked = trim( item[ arguments.unitKey ] ?: "" );
			if ( !arguments.replaceUnitIds.keyExists( linked ) ) kept.append( item );
		}
		for ( var nextItem in arguments.incoming ) kept.append( nextItem );
		return kept;
	}

	private struct function collectReplacementIds( required any oldIds, required any nextIds, required array incoming ) {
		var ids = {};
		for ( var id in ( isArray( arguments.oldIds ) ? arguments.oldIds : [] ) ) ids[ trim( id ) ] = true;
		for ( var id in ( isArray( arguments.nextIds ) ? arguments.nextIds : [] ) ) ids[ trim( id ) ] = true;
