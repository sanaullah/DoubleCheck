/**
 * Domain memento for architecture facts, enrichment metadata, and fingerprint.
 */
class accessors="true" {
	property name="version" type="string";

	property name="fingerprint" type="string";

	property name="repositoryRevision" type="string";

	property name="facts" type="array";

	property name="components" type="array";

	property name="summary" type="struct";

	property name="enrichment" type="struct";

	function init( required struct data ) {
		variables.version = arguments.data.version;
		variables.fingerprint = arguments.data.fingerprint;
		variables.repositoryRevision = arguments.data.repositoryRevision;
		variables.facts = arguments.data.facts;
		variables.components = arguments.data.components;
		variables.summary = arguments.data.summary;
		variables.enrichment = arguments.data.enrichment ?:
			{
				enabled   : false,
				used      : false,
				version   : "",
				provider  : "",
				model     : "",
				addedFacts: 0,
				error     : ""
			};
		return this;
	}

	struct function getMemento() {
		return {
			version           : variables.version,
			fingerprint       : variables.fingerprint,
			repositoryRevision: variables.repositoryRevision,
			facts             : duplicate( variables.facts ),
			components        : duplicate( variables.components ),
			summary           : duplicate( variables.summary ),
			enrichment        : duplicate( variables.enrichment )
		};
	}
}