/**
 * One derived cluster: a candidate boundary and the evidence for or against it.
 *
 * Holds and answers; `ModernizationDerivedStructureService` computes. The
 * distinction matters because membership is the invariant — if two files could
 * both decide which cluster a unit is in, the plan has two owners for one
 * question again.
 *
 * `boundaryEvidence` is deliberately carried rather than reduced to a boolean.
 * "Not separable" is only useful with the reason attached: four shared tables
 * is a different conversation from one crossing call.
 *
 * @see ModernizationDerivedStructureService
 */
class accessors="true" {

	property name="id" type="string";
	property name="domainKey" type="string";
	property name="name" type="string";
	property name="placementType" type="string";
	property name="purpose" type="string";
	property name="rationale" type="string";
	property name="targetUnitIds" type="array";
	property name="filePaths" type="array";
	property name="boundaryEvidence" type="struct";

	function init( required struct data ) {
		variables.id = arguments.data.id ?: "";
		variables.domainKey = arguments.data.domainKey ?: "";
		variables.name = arguments.data.name ?: "";
		variables.placementType = arguments.data.placementType ?: "main-app";
		variables.purpose = arguments.data.purpose ?: "";
		variables.rationale = arguments.data.rationale ?: "";
		variables.targetUnitIds = arguments.data.targetUnitIds ?: [];
		variables.filePaths = arguments.data.filePaths ?: [];
		variables.boundaryEvidence = arguments.data.boundaryEvidence ?: {};
		return this;
	}

	struct function getMemento() {
		return {
			id              : variables.id,
			domainKey       : variables.domainKey,
			name            : variables.name,
			placementType   : variables.placementType,
			purpose         : variables.purpose,
			rationale       : variables.rationale,
			targetUnitIds   : duplicate( variables.targetUnitIds ),
			filePaths       : duplicate( variables.filePaths ),
			boundaryEvidence: duplicate( variables.boundaryEvidence )
		};
	}

	/** True when this cluster owns the unit or the file. */
	boolean function contains( required string identifier ) {
		if ( variables.targetUnitIds.contains( arguments.identifier ) ) return true;
		return variables.filePaths.contains( lCase( replace( arguments.identifier, "\", "/", "all" ) ) );
	}

	/** Nothing crosses this boundary, so it can be taken out as a whole. */
	boolean function isSeparable() {
		return variables.boundaryEvidence.isolated ?: false;
	}

	/** Why it is or is not separable, in the caller's own words. */
	struct function boundaryEvidence() {
		return duplicate( variables.boundaryEvidence );
	}

	/** Everything that would have to be cut to extract this cluster. */
	numeric function couplingCount() {
		var evidence = variables.boundaryEvidence;
		return val( evidence.crossingEdges ?: 0 )
			+ ( isArray( evidence.sharedTablesOutside ?: "" ) ? evidence.sharedTablesOutside.len() : 0 )
			+ ( isArray( evidence.sharedScopesOutside ?: "" ) ? evidence.sharedScopesOutside.len() : 0 );
	}

	numeric function size() {
		return variables.filePaths.len();
	}
}
