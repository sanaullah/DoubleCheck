/** Versioned modernization plan artifact persisted after validation. */
class accessors="true" {
	property name="version" default="modernization-plan-v1";
	property name="metadata";
	property name="coverage";
	property name="assumptions";
	property name="inventory";
	property name="schemaEvidence";
	property name="signals";
	property name="target";
	property name="unitLinks";
	property name="dbFindings";
	property name="dbTransitions";
	property name="routeContracts";
	property name="roadmapPhases";
	property name="samples";
	property name="validation";
	property name="decisions";

	function init( struct data = {} ) {
		variables.version = data.version ?: "modernization-plan-v1";
		variables.metadata = duplicate( data.metadata ?: {} );
		variables.coverage = duplicate( data.coverage ?: {} );
		variables.assumptions = duplicate( data.assumptions ?: [] );
		variables.inventory = duplicate( data.inventory ?: { units: [], routeEvidence: [], dependencies: [], unresolved: [] } );
		variables.schemaEvidence = duplicate( data.schemaEvidence ?: { database: {}, objects: [], routines: [], unresolved: [] } );
		variables.signals = duplicate( data.signals ?: [] );
		variables.target = duplicate( data.target ?: {} );
		variables.unitLinks = duplicate( data.unitLinks ?: [] );
		variables.dbFindings = duplicate( data.dbFindings ?: [] );
		variables.dbTransitions = duplicate( data.dbTransitions ?: [] );
		variables.routeContracts = duplicate( data.routeContracts ?: [] );
		variables.roadmapPhases = duplicate( data.roadmapPhases ?: [] );
		variables.samples = duplicate( data.samples ?: [] );
		variables.validation = duplicate( data.validation ?: {} );
		variables.decisions = duplicate( data.decisions ?: [] );
		return this;
	}

	struct function getMemento() {
		return {
			version       : variables.version,
			schemaVersion : variables.version,
			metadata      : duplicate( variables.metadata ),
			coverage      : duplicate( variables.coverage ),
			assumptions   : duplicate( variables.assumptions ),
			inventory     : duplicate( variables.inventory ),
			schemaEvidence: duplicate( variables.schemaEvidence ),
			signals       : duplicate( variables.signals ),
			target        : duplicate( variables.target ),
			unitLinks     : duplicate( variables.unitLinks ),
			dbFindings    : duplicate( variables.dbFindings ),
			dbTransitions : duplicate( variables.dbTransitions ),
			routeContracts: duplicate( variables.routeContracts ),
			roadmapPhases : duplicate( variables.roadmapPhases ),
			samples       : duplicate( variables.samples ),
			validation    : duplicate( variables.validation ),
			decisions     : duplicate( variables.decisions )
		};
	}
}
