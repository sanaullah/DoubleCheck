/**
 * Domain memento for a bounded specialist plan (tasks, roles, budgets, context).
 */
class accessors="true" {
	property name="version" type="string";

	property name="fingerprint" type="string";

	property name="modelFingerprint" type="string";

	property name="policyFingerprint" type="string";

	property name="budgetFingerprint" type="string";

	property name="contextFingerprint" type="string";

	property name="tasks" type="array";

	property name="summary" type="struct";

	function init( required struct data ) {
		variables.version = arguments.data.version;
		variables.fingerprint = arguments.data.fingerprint;
		variables.modelFingerprint = arguments.data.modelFingerprint;
		variables.policyFingerprint = arguments.data.policyFingerprint ?: "";
		variables.budgetFingerprint = arguments.data.budgetFingerprint ?: "";
		variables.contextFingerprint = arguments.data.contextFingerprint ?: "";
		variables.tasks = arguments.data.tasks;
		variables.summary = arguments.data.summary;
		return this;
	}

	struct function getMemento() {
		return {
			version           : variables.version,
			fingerprint       : variables.fingerprint,
			modelFingerprint  : variables.modelFingerprint,
			policyFingerprint : variables.policyFingerprint,
			budgetFingerprint : variables.budgetFingerprint,
			contextFingerprint: variables.contextFingerprint,
			tasks             : duplicate( variables.tasks ),
			summary           : duplicate( variables.summary )
		};
	}
}