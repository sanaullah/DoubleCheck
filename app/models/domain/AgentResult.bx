/**
 * Domain memento for one specialist task outcome (status, findings, provenance).
 */
class accessors="true" {
	property name="version" type="string";

	property name="taskId" type="string";

	property name="role" type="string";

	property name="status" type="string";

	property name="summary" type="string";

	property name="findings" type="array";

	property name="toolAudit" type="array";

	property name="provenance" type="struct";

	property name="error" type="string";

	property name="durationMs" type="numeric";

	function init( required struct data ) {
		variables.version = arguments.data.version;
		variables.taskId = arguments.data.taskId;
		variables.role = arguments.data.role;
		variables.status = arguments.data.status;
		variables.summary = arguments.data.summary ?: "";
		variables.findings = arguments.data.findings ?: [];
		variables.toolAudit = arguments.data.toolAudit ?: [];
		variables.provenance = arguments.data.provenance ?: {};
		variables.error = arguments.data.error ?: "";
		variables.durationMs = arguments.data.durationMs ?: 0;
		return this;
	}

	struct function getMemento() {
		return {
			version   : variables.version,
			taskId    : variables.taskId,
			role      : variables.role,
			status    : variables.status,
			summary   : variables.summary,
			findings  : duplicate( variables.findings ),
			toolAudit : duplicate( variables.toolAudit ),
			provenance: duplicate( variables.provenance ),
			error     : variables.error,
			durationMs: variables.durationMs
		};
	}
}