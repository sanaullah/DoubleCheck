/**
 * Domain object for a persisted review run row (status, policy, budgets, progress).
 */
class accessors="true" {
	property name="id";

	property name="tenantId";

	property name="projectId";

	property name="projectPath";

	property name="mode";

	property name="runKind";

	property name="input";

	property name="baseRevision";

	property name="headRevision";

	property name="status";

	property name="progress";

	property name="currentPhase";

	property name="message";

	property name="createdAt";

	property name="startedAt";

	property name="completedAt";

	property name="cancelRequestedAt";

	property name="updatedAt";

	property name="policy";

	property name="budgets";

	property name="workerId";

	property name="sourceRunId";

	function init( struct data = {} ) {
		arguments.data.each(
				( key, value ) => {
					if ( structKeyExists( variables, key ) ) {
						variables[ key ] = value;
					}
				}
			);
		return this;
	}

	struct function getMemento() {
		return {
			id               : variables.id ?: "",
			tenantId         : variables.tenantId ?: "default",
			projectId        : variables.projectId ?: "default",
			projectPath      : variables.projectPath ?: "",
			mode             : variables.mode ?: "working-tree",
			runKind          : variables.runKind ?: "review",
			input            : duplicate( variables.input ?: {} ),
			baseRevision     : variables.baseRevision ?: "",
			headRevision     : variables.headRevision ?: "",
			status           : variables.status ?: "queued",
			progress         : variables.progress ?: 0,
			currentPhase     : variables.currentPhase ?: "",
			message          : variables.message ?: "",
			createdAt        : variables.createdAt ?: "",
			startedAt        : variables.startedAt ?: "",
			completedAt      : variables.completedAt ?: "",
			cancelRequestedAt: variables.cancelRequestedAt ?: "",
			updatedAt        : variables.updatedAt ?: "",
			policy           : duplicate( variables.policy ?: {} ),
			budgets          : duplicate( variables.budgets ?: {} ),
			workerId         : variables.workerId ?: "",
			sourceRunId      : variables.sourceRunId ?: ""
		};
	}
}
