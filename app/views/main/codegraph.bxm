<section class="workspace-grid reveal reveal-delay-2">
	<div class="panel create-panel">
		<div class="panel-heading">
			<div class="panel-title-row">
				<span class="panel-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="7" r="2.5"/><circle cx="8" cy="18" r="2.5"/><circle cx="17" cy="17" r="2.5"/>
						<path d="M8.2 7.8 15.8 8.8M7.2 15.8 15.5 15.2M8.3 8.3 9.5 15.7"/>
					</svg>
				</span>
				<div class="panel-title-text">
					<p class="eyebrow">New run</p>
					<h2>Choose a repository</h2>
				</div>
			</div>
			<div class="panel-heading-actions">
				<a class="secondary-button history-jump" href="/#history-panel">Recent runs ↓</a>
			</div>
			<p class="panel-purpose">Point at a local BoxLang, ColdFusion, or JavaScript repo to build an interactive knowledge graph.</p>
		</div>
		<form id="run-form">
			<label for="project-id">Project</label>
			<select id="project-id" name="projectId" required>
				<option value="">Loading projects…</option>
			</select>
			<label for="project-path">Project path</label>
			<bx:output>
			<input
				id="project-path"
				name="projectPath"
				type="text"
				value="#encodeForHTML( prc.defaultProjectPath )#"
				required
				autocomplete="off"
			>
			</bx:output>
			<p class="field-hint">
				Supported source: BoxLang, ColdFusion (CFML), and JavaScript. Read-only local analysis.
			</p>
			<input type="hidden" name="mode" value="full">
			<input type="hidden" name="runKind" value="codegraph">
			<div class="form-grid form-grid-two">
				<div>
					<label>Scope</label>
					<div class="safety-control" aria-label="Full baseline graph">
						<span class="safety-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="m5 12 5 5L20 7"/>
							</svg>
						</span>
						<span><strong>Full baseline</strong><small>Whole project graph</small></span>
					</div>
				</div>
				<div>
					<label>Safety</label>
					<div class="safety-control" aria-label="Read-only run">
						<span class="safety-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="m5 12 5 5L20 7"/>
							</svg>
						</span>
						<span><strong>Read-only</strong><small>No source writes</small></span>
					</div>
				</div>
			</div>
			<div class="review-readiness">
				<div>
					<strong id="readiness-label">Ready for a local CodeGraph run</strong>
					<span id="review-readiness-detail">Full baseline · Deterministic · Read-only</span>
				</div>
				<span class="readiness-dot" aria-hidden="true"></span>
			</div>
			<button type="submit" class="primary-button" id="start-run-button">
				Build knowledge graph
			</button>
			<p class="form-message" id="form-message" role="status"></p>
		</form>
	</div>

	<div class="panel active-panel">
		<div class="panel-heading command-heading">
			<div class="panel-title-row">
				<span class="panel-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 19V5"/><path d="M10 19V9"/><path d="M16 19V12"/><path d="M22 19V7"/>
					</svg>
				</span>
				<div class="panel-title-text">
					<p class="eyebrow" id="command-workspace-label">CodeGraph command center</p>
					<h2 id="active-title">No active CodeGraph run</h2>
				</div>
			</div>
			<div class="panel-heading-actions">
				<div class="command-actions">
					<button type="button" class="secondary-button" id="jump-trace-button" hidden>
						View trace
					</button>
					<button type="button" class="secondary-button" id="jump-findings-button" hidden>
						View graph
					</button>
					<button type="button" class="danger-button" id="cancel-button" hidden>
						Cancel graph
					</button>
				</div>
			</div>
		<p class="panel-purpose" id="command-workspace-purpose">Watch scan, symbol index, metrics, clustering, optional meaning, and snapshot persistence.</p>
			<p class="command-run-context" id="command-run-context">Start a CodeGraph run to monitor its pipeline.</p>
			<details class="run-config-details" id="run-config-details" hidden>
				<summary>Submitted values</summary>
				<dl class="run-config-grid" id="run-config-grid"></dl>
			</details>
		</div>
		<div class="progress-track" aria-label="Run progress">
			<div class="progress-bar" id="progress-bar"></div>
		</div>
		<div class="command-status-line">
			<span class="command-status-badge" id="active-status">Idle</span>
			<span id="active-phase">—</span>
			<strong id="active-progress">0%</strong>
		</div>
		<ol class="pipeline-steps" id="pipeline-steps" aria-label="CodeGraph pipeline">
			<li data-pipeline-stage="scan"><span>1</span><strong>Repository scan</strong><small>Pending</small></li>
			<li data-pipeline-stage="architecture"><span>2</span><strong>Symbol index</strong><small>Pending</small></li>
			<li data-pipeline-stage="planning"><span>3</span><strong>Metrics</strong><small>Pending</small></li>
			<li data-pipeline-stage="deterministic"><span>4</span><strong>Clusters</strong><small>Pending</small></li>
			<li data-pipeline-stage="specialists"><span>5</span><strong>Optional narrative</strong><small>Pending</small></li>
			<li data-pipeline-stage="completion"><span>6</span><strong>Persist snapshot</strong><small>Pending</small></li>
		</ol>
		<div class="command-metrics">
			<div><span>Files</span><strong id="command-files">—</strong></div>
			<div><span>Languages</span><strong id="command-languages">—</strong></div>
			<div><span>Scope</span><strong id="command-scope">—</strong></div>
			<div><span>Nodes</span><strong id="command-findings">—</strong></div>
			<div><span>Clusters</span><strong id="command-specialists">—</strong></div>
			<div><span>Guardrail</span><strong id="command-budget">—</strong></div>
		</div>
		<p class="activity-message" id="active-message" role="status">
			Start a CodeGraph run to watch live progress here.
		</p>
		<section class="evidence-panel" id="evidence-panel">
			<div class="panel-heading compact">
				<div>
					<p class="eyebrow">Live evidence</p>
					<h3>Graph milestones</h3>
					<p class="panel-purpose">Indexing and clustering progress without raw provider noise.</p>
				</div>
				<span class="live-indicator"><span></span> Local stream</span>
			</div>
			<ol class="event-feed" id="event-feed">
				<li class="empty-state-item">
					<div class="empty-state" role="status">
						<span class="empty-state-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h7"/></svg>
						</span>
						<strong class="empty-state-title">No milestones yet</strong>
						<span class="empty-state-hint">Start a CodeGraph run to watch live progress appear here.</span>
					</div>
				</li>
			</ol>
		</section>
	</div>
</section>

<section class="panel codegraph-explorer codegraph-shell reveal reveal-delay-4" id="codegraph-explorer" data-state="idle" hidden aria-labelledby="codegraph-explorer-title">
	<!--
		Application shell, not a document. The canvas owns the centre of one
		screen; everything that explains it docks around it instead of stacking
		above it. See resources/docs/plans/adr-001-codegraph-workspace-layout.md.
	-->
	<header class="cg-shell-head">
		<div class="cg-shell-title">
			<span class="panel-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="7" r="2.5"/><circle cx="8" cy="18" r="2.5"/><circle cx="17" cy="17" r="2.5"/>
					<path d="M8.2 7.8 15.8 8.8M7.2 15.8 15.5 15.2M8.3 8.3 9.5 15.7"/>
				</svg>
			</span>
			<h2 id="codegraph-explorer-title">CodeGraph</h2>
			<span class="status-badge" id="codegraph-status" data-state="idle">No snapshot</span>
			<span class="codegraph-source-text" id="codegraph-source-text"></span>
		</div>
		<div class="cg-shell-actions" id="codegraph-source-bar" hidden>
			<div class="codegraph-export-actions" id="codegraph-export-actions" hidden aria-label="Export CodeGraph">
				<a class="secondary-button" data-codegraph-export="markdown" href="#">Markdown</a>
				<a class="secondary-button" data-codegraph-export="mermaid" href="#">Mermaid</a>
				<a class="secondary-button" data-codegraph-export="svg" href="#">SVG</a>
			</div>
			<button type="button" class="secondary-button" id="codegraph-rebuild">Rebuild map</button>
		</div>
	</header>

	<div class="codegraph-banner" id="codegraph-empty" hidden>
		<div class="empty-state" role="status">
			<span class="empty-state-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="7" r="2.5"/><circle cx="8" cy="18" r="2.5"/><circle cx="17" cy="17" r="2.5"/><path d="M8.2 7.8 15.8 8.8M7.2 15.8 15.5 15.2M8.3 8.3 9.5 15.7"/></svg>
			</span>
			<strong class="empty-state-title">No graph snapshot</strong>
			<span class="empty-state-hint">Complete a CodeGraph run to explore clusters and dependencies.</span>
		</div>
	</div>
	<div class="codegraph-banner codegraph-banner-failed" id="codegraph-failed" hidden role="alert"></div>

	<div class="cg-shell-body" id="codegraph-workspace" hidden>
		<aside class="cg-rail" aria-label="Find and filter">
			<label class="codegraph-toolbar-field codegraph-search-field">
				<span>Find anything</span>
				<input type="search" id="codegraph-search" placeholder="file, symbol, role, flow" autocomplete="off">
			</label>
			<div class="codegraph-role-legend" id="codegraph-role-legend" hidden aria-label="File role legend"></div>
			<div class="codegraph-banner codegraph-banner-truncation" id="codegraph-truncation" hidden role="status"></div>
			<div class="codegraph-directory-tree" id="codegraph-directory-tree" hidden aria-label="CodeGraph browser"></div>
		</aside>

		<div class="cg-stage">
			<div class="codegraph-toolbar" id="codegraph-toolbar" hidden>
				<div class="codegraph-depth" id="codegraph-depth" role="group" aria-label="Graph depth">
					<button type="button" class="codegraph-depth-btn is-active" data-codegraph-depth="start" aria-pressed="true">Start here</button>
					<button type="button" class="codegraph-depth-btn" data-codegraph-depth="cluster" aria-pressed="false">Overview</button>
					<button type="button" class="codegraph-depth-btn" data-codegraph-depth="matrix" aria-pressed="false">Matrix</button>
					<button type="button" class="codegraph-depth-btn" data-codegraph-depth="file" aria-pressed="false" disabled>Files</button>
					<button type="button" class="codegraph-depth-btn" data-codegraph-depth="focus" aria-pressed="false" disabled>Neighbourhood</button>
					<button type="button" class="codegraph-depth-btn" data-codegraph-depth="symbol" aria-pressed="false" disabled>Symbols</button>
				</div>
				<nav class="codegraph-breadcrumb" id="codegraph-breadcrumb" aria-label="Graph drill-down" hidden></nav>
				<label class="codegraph-toolbar-field" id="codegraph-layout-field">
					<span>Layout</span>
					<select id="codegraph-layout">
						<option value="cluster">Cluster</option>
						<option value="layer">Layer</option>
						<option value="swimlane">Swimlane</option>
						<option value="radial">Hub</option>
					</select>
				</label>
				<div class="codegraph-edge-filters" id="codegraph-edge-filters" hidden aria-label="Edge filters"></div>
				<label class="codegraph-toolbar-field codegraph-ai-toggle">
					<input type="checkbox" id="codegraph-show-ai" disabled>
					<span>AI summaries <span class="codegraph-ai-chip" title="Generated by AI — not evidence">AI</span></span>
				</label>
				<button type="button" class="secondary-button" id="codegraph-overview-more" hidden>Show all modules</button>
				<div class="codegraph-camera" id="codegraph-camera" role="group" aria-label="Camera">
					<button type="button" class="codegraph-camera-btn" id="codegraph-zoom-out" title="Zoom out (–)">−</button>
					<button type="button" class="codegraph-camera-btn" id="codegraph-fit" title="Fit view (0)">Fit</button>
					<button type="button" class="codegraph-camera-btn" id="codegraph-zoom-in" title="Zoom in (+)">+</button>
				</div>
			</div>
			<div class="codegraph-canvas-host" id="codegraph-canvas" role="application" aria-label="Code knowledge graph — arrow keys move between nodes, Enter selects" aria-describedby="codegraph-a11y-status" tabindex="0"></div>
			<p id="codegraph-a11y-status" class="visually-hidden" role="status" aria-live="polite"></p>
		</div>

		<aside class="codegraph-inspector cg-inspector" id="codegraph-inspector" aria-live="polite">
			<div class="empty-state" role="status">
				<span class="empty-state-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
				</span>
				<strong class="empty-state-title">Select a node</strong>
				<span class="empty-state-hint">Inspect cluster or file details here.</span>
			</div>
		</aside>
	</div>

	<div class="cg-drawer" id="codegraph-drawer" data-open="false" hidden>
		<nav class="cg-drawer-tabs" id="codegraph-drawer-tabs" role="tablist" aria-label="Detail panels">
			<button type="button" role="tab" data-cg-drawer="briefing" aria-selected="true">Briefing</button>
			<button type="button" role="tab" data-cg-drawer="issues" aria-selected="false">Issues</button>
			<button type="button" role="tab" data-cg-drawer="path" aria-selected="false">Path</button>
			<span class="cg-drawer-spacer"></span>
			<button type="button" class="cg-drawer-toggle" id="codegraph-drawer-toggle" aria-expanded="false">Open</button>
		</nav>
		<div class="cg-drawer-body" id="codegraph-drawer-body">
			<div class="cg-drawer-panel" data-cg-panel="briefing">
				<div class="codegraph-banner codegraph-banner-meaning" id="codegraph-meaning-banner" hidden role="status"></div>
				<div class="codegraph-project-strip" id="codegraph-project-strip" hidden>
					<div class="codegraph-project-strip-main">
						<h3 id="codegraph-project-title">Project</h3>
						<p class="codegraph-project-blurb" id="codegraph-project-blurb"></p>
						<p class="codegraph-project-stats" id="codegraph-project-stats"></p>
						<div class="codegraph-onboarding" id="codegraph-onboarding" hidden>
							<p class="codegraph-section-label">Onboarding path</p>
							<ol class="codegraph-onboarding-list" id="codegraph-onboarding-list"></ol>
						</div>
						<div class="codegraph-processes" id="codegraph-processes" hidden>
							<p class="codegraph-section-label">Top processes</p>
							<div class="codegraph-process-list" id="codegraph-process-list"></div>
						</div>
						<div class="codegraph-risk" id="codegraph-risk" hidden></div>
					</div>
				</div>
				<div class="codegraph-ai-summaries" id="codegraph-ai-summaries" hidden></div>
			</div>
			<div class="cg-drawer-panel" data-cg-panel="issues" hidden>
				<div class="codegraph-issues" id="codegraph-issues" hidden>
					<nav class="codegraph-issue-tabs" id="codegraph-issue-tabs" role="tablist" aria-label="Graph issues">
						<button type="button" role="tab" id="codegraph-tab-cycles" aria-selected="true" data-codegraph-issue="cycles">Cycles</button>
						<button type="button" role="tab" id="codegraph-tab-orphans" aria-selected="false" data-codegraph-issue="orphans">Orphans</button>
						<button type="button" role="tab" id="codegraph-tab-violations" aria-selected="false" data-codegraph-issue="violations">Layer violations</button>
						<button type="button" role="tab" id="codegraph-tab-hotspots" aria-selected="false" data-codegraph-issue="hotspots">Hotspots</button>
					</nav>
					<div class="codegraph-issue-list" id="codegraph-issue-list" role="tabpanel"></div>
				</div>
			</div>
			<div class="cg-drawer-panel" data-cg-panel="path" hidden>
				<section class="codegraph-pathfinder" id="codegraph-pathfinder" hidden aria-labelledby="codegraph-pathfinder-title">
					<div class="codegraph-pathfinder-heading">
						<div>
							<p class="eyebrow">Orientation</p>
							<h3 id="codegraph-pathfinder-title">Dependency path</h3>
						</div>
						<p id="codegraph-path-status" role="status">Select a file, then set it as path start or end.</p>
					</div>
					<div class="codegraph-path-controls">
						<div><span>From</span><code id="codegraph-path-from">Choose a node</code></div>
						<div><span>To</span><code id="codegraph-path-to">Choose a node</code></div>
						<label>
							<span>Direction</span>
							<select id="codegraph-path-direction">
								<option value="forward">Forward</option>
								<option value="reverse">Reverse</option>
								<option value="any">Either</option>
							</select>
						</label>
						<button type="button" class="secondary-button" id="codegraph-path-find" disabled>Find path</button>
						<button type="button" class="secondary-button" id="codegraph-path-swap" disabled>Swap</button>
						<button type="button" class="secondary-button" id="codegraph-path-clear" disabled>Clear</button>
					</div>
					<div class="codegraph-path-results" id="codegraph-path-results" hidden></div>
				</section>
			</div>
		</div>
	</div>
</section>
