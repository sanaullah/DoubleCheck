<section class="page-intro reveal reveal-delay-1">
	<div>
		<p class="eyebrow">Local · BoxLang · ColdFusion · JavaScript · Java</p>
		<h1>DoubleCheck</h1>
		<p class="lede">
			An evidence-backed second pair of eyes for supported application code — read-only by default and running on your machine.
		</p>
	</div>
</section>

<section class="workspace-grid reveal reveal-delay-2">
	<div class="panel create-panel">
		<div class="panel-heading">
			<div class="panel-title-row">
				<span class="panel-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
						<path d="M3 7.5A1.5 1.5 0 0 1 4.5 6H9l2 2h8.5A1.5 1.5 0 0 1 21 9.5v7A1.5 1.5 0 0 1 19.5 18h-15A1.5 1.5 0 0 1 3 16.5v-9Z"/>
					</svg>
				</span>
				<div class="panel-title-text">
					<p class="eyebrow">New run</p>
					<h2>Choose a repository</h2>
				</div>
			</div>
			<div class="panel-heading-actions">
				<a class="secondary-button history-jump" href="#history-panel">Recent runs ↓</a>
			</div>
			<p class="panel-purpose">Point at a local repo and choose a Review or Modernize run.</p>
		</div>
		<form id="run-form">
			<div class="workspace-selector" role="group" aria-labelledby="workspace-label">
				<div>
					<label id="workspace-label" for="run-kind">Workspace</label>
					<p class="field-hint" id="workspace-hint">Review produces evidence-backed findings and optional specialist analysis.</p>
				</div>
				<select id="run-kind" name="runKind">
					<option value="review" selected>Review · find correctness and security issues</option>
					<option value="modernize">Modernize · plan a CFML migration</option>
				</select>
			</div>
			<label for="project-id">Project</label>
			<select id="project-id" name="projectId" required>
				<option value="">Loading projects…</option>
			</select>
			<label for="project-path">Project path</label>
			<bx:output>
			<input
				id="project-path"
				name="projectPath"
				type="text"
				value="#encodeForHTML( prc.defaultProjectPath )#"
				required
				autocomplete="off"
			>
			</bx:output>
			<p class="field-hint">
				Any existing folder on this machine can be reviewed or modernized.
			</p>
			<div class="form-grid form-grid-two">
				<div>
					<label for="run-mode" id="run-mode-label">Review mode</label>
					<select id="run-mode" name="mode">
						<option value="full" selected>Full baseline</option>
						<option value="working-tree">Working tree changes</option>
						<option value="revision-diff">Revision comparison</option>
					</select>
				</div>
				<div>
					<label>Safety</label>
					<div class="safety-control" aria-label="Read-only run">
						<span class="safety-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="m5 12 5 5L20 7"/>
							</svg>
						</span>
						<span><strong>Read-only</strong><small>No source writes</small></span>
					</div>
				</div>
			</div>
			<p class="field-hint" id="mode-hint">
				Working tree needs a Git repository with changed files. For a plain folder or clean tree, choose Full baseline.
			</p>
			<section class="modernization-fields" id="modernization-fields" hidden aria-labelledby="modernization-fields-title">
				<div class="modernization-fields-heading">
					<div>
						<p class="eyebrow">Modernize setup</p>
						<h3 id="modernization-fields-title">Describe the source and target</h3>
					</div>
					<span class="status-badge" id="modernization-provider-status" data-state="idle">Provider check pending</span>
				</div>
				<div class="form-grid form-grid-two">
					<div>
						<label for="source-engine">Source engine</label>
						<select id="source-engine" name="sourceEngine">
							<option value="lucee">Lucee</option>
							<option value="adobe">Adobe ColdFusion</option>
							<option value="unknown">Unknown / infer from repository</option>
						</select>
					</div>
					<div>
						<label for="source-version">Source version <span class="optional-label">Optional</span></label>
						<input id="source-version" name="sourceVersion" type="text" placeholder="e.g. 5.4 or 2021" autocomplete="off">
					</div>
					<div>
						<label for="source-java-version">Java version <span class="optional-label">Optional</span></label>
						<input id="source-java-version" name="sourceJavaVersion" type="text" placeholder="e.g. 11" autocomplete="off">
					</div>
					<div>
						<label for="target-runtime">Target runtime</label>
						<select id="target-runtime" name="targetRuntime">
							<option value="lucee-modern" selected>Lucee · modern</option>
							<option value="boxlang-modern">BoxLang · modern</option>
						</select>
					</div>
					<div>
						<label for="target-language">Target language</label>
						<select id="target-language" name="targetLanguage">
							<option value="cfml" selected>CFML</option>
							<option value="boxlang">BoxLang</option>
						</select>
					</div>
					<div>
						<label for="layout-profile">Layout profile</label>
						<select id="layout-profile" name="layoutProfile">
							<option value="modern" selected>ColdBox app/ + public/</option>
							<option value="flat">Flat repository layout</option>
						</select>
					</div>
					<div>
						<label for="coldbox-major">ColdBox major <span class="optional-label">Optional</span></label>
						<input id="coldbox-major" name="coldboxMajor" type="text" placeholder="e.g. 7" autocomplete="off">
					</div>
					<div>
						<label for="cli-major">CLI major <span class="optional-label">Optional</span></label>
						<input id="cli-major" name="cliMajor" type="text" placeholder="e.g. 6" autocomplete="off">
					</div>
					<div>
						<label for="modernization-provider">Proposal provider</label>
						<select id="modernization-provider" name="provider">
							<option value="ollama" selected>Ollama (local)</option>
							<option value="docker">Docker model (local)</option>
							<option value="openai">Configured remote provider</option>
						</select>
					</div>
				</div>
				<label for="modernization-outcomes">Outcomes <span class="optional-label">Optional</span></label>
				<textarea id="modernization-outcomes" name="outcome" rows="2" maxlength="500" placeholder="e.g. preserve routes, reduce shared state, keep a rollback path"></textarea>
				<div class="form-grid form-grid-two modernization-database-grid">
					<div><label for="database-vendor">Database vendor <span class="optional-label">Optional</span></label><input id="database-vendor" name="databaseVendor" type="text" placeholder="SQL Server, MySQL…"></div>
					<div><label for="database-version">Database version <span class="optional-label">Optional</span></label><input id="database-version" name="databaseVersion" type="text" placeholder="e.g. 8.0"></div>
					<div><label for="database-schema">Database schema <span class="optional-label">Optional</span></label><input id="database-schema" name="databaseSchema" type="text" placeholder="dbo, public…" autocomplete="off"></div>
					<div><label for="database-collation">Collation <span class="optional-label">Optional</span></label><input id="database-collation" name="databaseCollation" type="text"></div>
					<div><label for="database-timezone">Timezone <span class="optional-label">Optional</span></label><input id="database-timezone" name="databaseTimezone" type="text" placeholder="UTC"></div>
				</div>
				<fieldset class="schema-source-fieldset">
					<legend>Schema evidence</legend>
					<div class="form-grid form-grid-two">
						<div>
							<label for="schema-source">Schema source</label>
							<select id="schema-source" name="schemaSource">
								<option value="none" selected>None · infer from SQL evidence</option>
								<option value="attached-dump">Attach local SQL/DDL file</option>
								<option value="repo-path">Relative path inside repository</option>
							</select>
						</div>
						<div id="schema-file-wrap" hidden>
							<label for="schema-file">Local schema file</label>
							<input id="schema-file" type="file" accept=".sql,.ddl,.json,.txt">
							<small class="field-hint">Read locally; the file is included only in the local run request.</small>
						</div>
						<div id="schema-path-wrap" hidden>
							<label for="schema-path">In-repository schema path</label>
							<input id="schema-path" name="schemaPath" type="text" placeholder="resources/schema/schema.sql" autocomplete="off">
						</div>
					</div>
					<p class="field-hint" id="schema-file-status">Schema input is optional. Missing schema remains visible as inference-limited coverage.</p>
				</fieldset>
				<label class="remote-provider-ack" id="remote-provider-ack-wrap" hidden>
					<input type="checkbox" id="remote-provider-ack" name="remoteProviderAcknowledged" value="true">
					<span>I understand that bounded, redacted proposal context may be sent to the configured remote provider.</span>
				</label>
				<p class="form-message" id="modernization-readiness" role="status"></p>
			</section>
			<div class="revision-fields" id="revision-fields" hidden>
				<label for="base-revision">Base revision</label>
				<input
					id="base-revision"
					name="baseRevision"
					type="text"
					placeholder="main, tag, or commit SHA"
					autocomplete="off"
				>
				<label for="head-revision">Head revision</label>
				<input
					id="head-revision"
					name="headRevision"
					type="text"
					value="HEAD"
					autocomplete="off"
				>
			</div>
			<label id="review-goal-label" for="review-goal">Review goal <span class="optional-label">Optional</span></label>
			<textarea
				id="review-goal"
				name="reviewGoal"
				rows="3"
				maxlength="500"
				placeholder="What should this review pay special attention to?"
			></textarea>
			<div class="field-meta">
				<span>Used to brief the specialist crew when AI is configured.</span>
				<span id="review-goal-count">0 / 500</span>
			</div>

			<fieldset class="preset-fieldset">
				<legend>Review depth</legend>
				<div class="preset-grid" role="radiogroup" aria-label="Review depth preset">
					<label class="preset-option">
						<input type="radio" name="reviewPreset" value="quick">
						<span class="preset-mark" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>
							</svg>
						</span>
						<span><strong>Quick</strong><small>Focused feedback</small></span>
					</label>
					<label class="preset-option">
						<input type="radio" name="reviewPreset" value="balanced" checked>
						<span class="preset-mark" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 3 20 12 12 21 4 12 12 3Z"/>
							</svg>
						</span>
						<span><strong>Balanced</strong><small>Recommended</small></span>
					</label>
					<label class="preset-option">
						<input type="radio" name="reviewPreset" value="deep">
						<span class="preset-mark" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="3"/>
								<circle cx="12" cy="12" r="7"/>
								<circle cx="12" cy="12" r="10.5"/>
							</svg>
						</span>
						<span><strong>Deep</strong><small>Maximum context</small></span>
					</label>
				</div>
				<p class="field-hint preset-summary" id="preset-summary">
					Balanced review with broad focus and sensible local limits.
				</p>
			</fieldset>

			<fieldset class="role-fieldset">
				<legend>Focus areas</legend>
				<div class="role-grid">
					<label class="role-option">
						<input type="checkbox" name="allowedRole" value="security" checked>
						<span>Security</span>
					</label>
					<label class="role-option">
						<input type="checkbox" name="allowedRole" value="correctness" checked>
						<span>Correctness</span>
					</label>
					<label class="role-option">
						<input type="checkbox" name="allowedRole" value="testing" checked>
						<span>Testing</span>
					</label>
					<label class="role-option">
						<input type="checkbox" name="allowedRole" value="architecture" checked>
						<span>Architecture</span>
					</label>
					<label class="role-option">
						<input type="checkbox" name="allowedRole" value="performance" checked>
						<span>Performance</span>
					</label>
					<label class="role-option">
						<input type="checkbox" name="allowedRole" value="boxlang-conventions" checked>
						<span>BoxLang conventions</span>
					</label>
					<label class="role-option">
						<input type="checkbox" name="allowedRole" value="cfml-conventions" checked>
						<span>CFML conventions</span>
					</label>
				</div>
				<p class="field-hint">Deterministic checks always run. AI-enabled specialists deepen selected areas when a provider is configured.</p>
			</fieldset>

			<details class="advanced-settings" id="advanced-settings">
				<summary>
					<span>
						<strong>Advanced limits</strong>
						<small>Token, time, tool, and cost guardrails</small>
					</span>
					<span class="advanced-summary-value" id="advanced-summary-value">6 tasks · 12k tokens · $5 max</span>
				</summary>
				<div class="advanced-settings-body">
					<div class="form-grid form-grid-two">
						<div>
							<label for="max-tasks">Maximum review tasks</label>
							<input id="max-tasks" name="maxTasks" type="number" min="1" max="6" value="6" required>
						</div>
						<div>
							<label for="max-tokens">Total task token budget</label>
							<input id="max-tokens" name="maxTokens" type="number" min="128" max="24000" value="12000" required>
						</div>
						<div>
							<label for="max-tokens-per-task">Tokens per task</label>
							<input id="max-tokens-per-task" name="maxTokensPerTask" type="number" min="128" max="6000" value="6000" required>
						</div>
						<div>
							<label for="max-duration-ms">Specialist deadline</label>
							<select id="max-duration-ms" name="maxDurationMs" required>
								<option value="300000">5 minutes</option>
								<option value="600000">10 minutes</option>
								<option value="900000" selected>15 minutes</option>
								<option value="1800000">30 minutes</option>
							</select>
						</div>
						<div>
							<label for="max-iterations">Tool iterations per task</label>
							<input id="max-iterations" name="maxIterationsPerTask" type="number" min="1" max="20" value="8" required>
						</div>
						<div>
							<label for="max-tool-output">Tool output characters</label>
							<input id="max-tool-output" name="maxToolOutputCharacters" type="number" min="1000" max="120000" value="48000" required>
						</div>
						<div>
							<label for="max-cost-usd">Maximum provider cost</label>
							<div class="input-prefix">
								<span>$</span>
								<input id="max-cost-usd" name="maxCostUsd" type="number" min="0.01" max="100" step="0.01" value="40" required>
							</div>
						</div>
					</div>
					<p class="field-hint">These are hard run guardrails. Local models may need a 10–15 minute specialist deadline.</p>
				</div>
			</details>
			<div class="review-readiness">
				<div>
				<strong id="readiness-label">Ready for a local review</strong>
					<span id="review-readiness-detail">Working tree · Balanced · Read-only</span>
				</div>
				<span class="readiness-dot" aria-hidden="true"></span>
			</div>
			<button type="submit" class="primary-button" id="start-run-button">
				Start code review
			</button>
			<p class="form-message" id="form-message" role="status"></p>
		</form>
	</div>

	<div class="panel active-panel">
		<div class="panel-heading command-heading">
			<div class="panel-title-row">
				<span class="panel-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 19V5"/><path d="M10 19V9"/><path d="M16 19V12"/><path d="M22 19V7"/>
					</svg>
				</span>
				<div class="panel-title-text">
					<p class="eyebrow" id="command-workspace-label">Review command center</p>
					<h2 id="active-title">No active review</h2>
				</div>
			</div>
			<div class="panel-heading-actions">
				<div class="command-actions">
					<button type="button" class="secondary-button" id="jump-trace-button" hidden>
						View trace
					</button>
					<button type="button" class="secondary-button" id="jump-findings-button" hidden>
						View findings
					</button>
					<button type="button" class="secondary-button" id="command-export-button" hidden>
						Export report
					</button>
					<button type="button" class="danger-button" id="cancel-button" hidden>
						Cancel review
					</button>
				</div>
			</div>
			<p class="panel-purpose" id="command-workspace-purpose">Watch pipeline stages, crew progress, and live milestones for the active run.</p>
			<p class="command-run-context" id="command-run-context">Start a review to monitor its pipeline and evidence.</p>
		</div>
		<div class="progress-track" aria-label="Run progress">
			<div class="progress-bar" id="progress-bar"></div>
		</div>
		<div class="command-status-line">
			<span class="command-status-badge" id="active-status">Idle</span>
			<span id="active-phase">—</span>
			<strong id="active-progress">0%</strong>
		</div>
		<ol class="pipeline-steps" id="pipeline-steps" aria-label="Review pipeline">
			<li data-pipeline-stage="scan"><span>1</span><strong>Repository scan</strong><small>Pending</small></li>
			<li data-pipeline-stage="architecture"><span>2</span><strong>Architecture model</strong><small>Pending</small></li>
			<li data-pipeline-stage="planning"><span>3</span><strong>Crew planning</strong><small>Pending</small></li>
			<li data-pipeline-stage="deterministic"><span>4</span><strong>Deterministic review</strong><small>Pending</small></li>
			<li data-pipeline-stage="specialists"><span>5</span><strong>Specialist analysis</strong><small>Pending</small></li>
			<li data-pipeline-stage="completion"><span>6</span><strong>Validate + save</strong><small>Pending</small></li>
		</ol>
		<div class="command-metrics">
			<div><span>Files</span><strong id="command-files">—</strong></div>
			<div><span>Languages</span><strong id="command-languages">—</strong></div>
			<div><span>Scope</span><strong id="command-scope">—</strong></div>
			<div><span>Findings</span><strong id="command-findings">—</strong></div>
			<div><span>Specialists</span><strong id="command-specialists">—</strong></div>
			<div><span>Guardrail</span><strong id="command-budget">—</strong></div>
		</div>
		<p class="activity-message" id="active-message" role="status">
			Start a review to watch live progress here.
		</p>
		<div class="specialist-board" id="specialist-board" hidden>
			<div class="panel-heading compact">
				<div>
					<p class="eyebrow">Crew agents</p>
					<h3 id="crew-board-title">Assigned specialists</h3>
					<p class="crew-summary" id="crew-summary" hidden></p>
				</div>
				<span class="crew-source-badge" id="crew-source-badge" hidden></span>
			</div>
			<div class="specialist-grid" id="specialist-grid"></div>
		</div>
		<section class="evidence-panel" id="evidence-panel">
			<div class="panel-heading compact">
				<div>
					<p class="eyebrow">Live evidence</p>
					<h3>Review milestones</h3>
					<p class="panel-purpose">Meaningful review activity without raw provider noise.</p>
				</div>
				<span class="live-indicator"><span></span> Local stream</span>
			</div>
			<ol class="event-feed" id="event-feed">
				<li class="empty-state-item">
					<div class="empty-state" role="status">
						<span class="empty-state-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h7"/></svg>
						</span>
						<strong class="empty-state-title">No milestones yet</strong>
						<span class="empty-state-hint">Start a review to watch live progress appear here.</span>
					</div>
				</li>
			</ol>
		</section>
	</div>
</section>

<details class="panel settings-panel reveal reveal-delay-4" id="settings-panel">
	<summary class="settings-summary">
		<div class="panel-title-row">
			<span class="panel-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="3"/>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
				</svg>
			</span>
			<div class="panel-title-text">
				<p class="eyebrow">Local preferences</p>
				<h2>Settings</h2>
			</div>
		</div>
		<p class="panel-purpose">Set local defaults; provider secrets stay in environment variables. Expand to edit.</p>
		<span class="settings-chevron" aria-hidden="true">▸</span>
	</summary>
	<form id="settings-form" class="settings-form">
		<label>
			<span>Default review depth</span>
			<select name="defaultPreset">
				<option value="quick">Quick</option>
				<option value="balanced">Balanced</option>
				<option value="deep">Deep</option>
			</select>
		</label>
		<label>
			<span>Default review mode</span>
			<select name="defaultMode">
				<option value="full" selected>Full baseline</option>
				<option value="working-tree">Working tree</option>
				<option value="revision-diff">Revision comparison</option>
			</select>
		</label>
		<label class="settings-check">
			<input type="checkbox" name="rememberProject">
			<span>Remember the last project path on this device</span>
		</label>
		<div class="settings-actions">
			<button type="submit" class="primary-button">Save settings</button>
			<button type="button" class="secondary-button" id="settings-reset">Reset</button>
			<span id="settings-status" role="status"></span>
		</div>
	</form>
</details>

<section class="panel observe-panel observability-workspace reveal reveal-delay-3" id="observe-panel" hidden>
	<div class="panel-heading observe-workspace-heading">
		<div class="panel-title-row">
			<span class="panel-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 12h4l2-7 4 14 2-7h6"/>
				</svg>
			</span>
			<div class="panel-title-text">
				<p class="eyebrow">Local observability</p>
				<h2>Review trace</h2>
			</div>
		</div>
		<div class="panel-heading-actions observe-trace-identity">
			<span class="observe-trace-status" id="observe-trace-status" data-status="idle">Idle</span>
			<strong id="trace-count">0 observations</strong>
		</div>
		<p class="panel-purpose">Langfuse-inspired visibility across the review lifecycle, with sensitive values redacted. For raw bx-ai provider events open <a href="/aiflight/" target="_blank" rel="noopener">AiFlight</a>.</p>
	</div>
	<div class="observe-run-context" id="observe-run-context">
		Select a review to inspect its phases, spans, generations, tool calls, timing, failures, inputs, and outputs.
	</div>
	<div class="observe-stats" id="observe-summary" hidden></div>
	<div class="observe-stage-map" id="observe-stage-map" aria-label="Trace lifecycle" hidden></div>
	<div class="observe-workspace-grid">
		<aside class="observe-controls" aria-label="Trace controls">
			<label for="observe-search">Search trace</label>
			<input type="search" id="observe-search" class="observe-search" placeholder="Search observations…" aria-label="Search observability traces">
			<div>
				<span class="observe-control-label">Observation type</span>
				<div class="observe-filters" id="flight-filters" role="group" aria-label="Observation type filters">
					<button type="button" class="observe-filter is-active" data-observe-filter="all">All</button>
					<button type="button" class="observe-filter observe-filter-danger" data-observe-filter="failures">Failures</button>
					<button type="button" class="observe-filter" data-observe-filter="generation">Generations</button>
					<button type="button" class="observe-filter" data-observe-filter="tool">Tools</button>
					<button type="button" class="observe-filter" data-observe-filter="span">Spans</button>
					<button type="button" class="observe-filter" data-observe-filter="event">Events</button>
					<button type="button" class="observe-filter" data-observe-filter="phase">Phases</button>
				</div>
			</div>
			<div>
				<span class="observe-control-label">Specialist role</span>
				<div class="observe-filters observe-role-filters" id="observe-role-filters" role="group" aria-label="Role filters" hidden></div>
			</div>
			<button type="button" class="secondary-button observe-export" id="observe-export" hidden>Export trace JSON</button>
			<p class="observe-privacy-note">Stored locally. Provider payload previews follow the configured redaction and retention limits.</p>
		</aside>
		<div class="observe-timeline">
			<div class="observe-timeline-heading">
				<div>
					<p class="eyebrow">Observation timeline</p>
					<h3>Phases, agents, and model activity</h3>
				</div>
				<span class="panel-purpose">Expand any row for parameters and payloads</span>
			</div>
			<ol class="observe-feed" id="observe-feed"></ol>
		</div>
	</div>
</section>

<section class="panel history-panel reveal reveal-delay-4" id="history-panel">
	<div class="panel-heading">
		<div class="panel-title-row">
			<span class="panel-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
				</svg>
			</span>
			<div class="panel-title-text">
				<p class="eyebrow">Review intelligence</p>
				<h2>Run history</h2>
			</div>
		</div>
		<div class="panel-heading-actions">
			<button type="button" class="secondary-button" id="refresh-button">
				Refresh
			</button>
		</div>
	<p class="panel-purpose">Browse Review and Modernize runs, spot trends, and compare compatible Review baselines.</p>
	</div>
	<form class="history-filters" id="history-filters">
		<label>
			<span>Search</span>
			<input type="search" name="q" id="history-search" placeholder="Repository, run ID, message…">
		</label>
		<label>
			<span>Mode</span>
			<select name="mode" id="history-mode">
				<option value="">All modes</option>
				<option value="working-tree">Working tree</option>
				<option value="revision-diff">Revision comparison</option>
				<option value="full">Full baseline</option>
			</select>
		</label>
		<label>
			<span>Status</span>
			<select name="status" id="history-status">
				<option value="">All statuses</option>
				<option value="succeeded">Succeeded</option>
				<option value="partial">Warnings</option>
				<option value="failed">Failed</option>
				<option value="cancelled">Cancelled</option>
				<option value="running">Running</option>
				<option value="queued">Queued</option>
			</select>
		</label>
		<label>
			<span>Workspace</span>
			<select name="runKind" id="history-run-kind">
				<option value="">Review + Modernize</option>
				<option value="review">Review</option>
				<option value="modernize">Modernize</option>
			</select>
		</label>
		<label>
			<span>From</span>
			<input type="date" name="from" id="history-from">
		</label>
		<label>
			<span>To</span>
			<input type="date" name="to" id="history-to">
		</label>
		<div class="history-filter-actions">
			<button type="submit" class="primary-button">Apply</button>
			<button type="button" class="secondary-button" id="history-clear">Clear</button>
		</div>
	</form>
	<div class="history-trends" id="history-trends" aria-live="polite">
		<div><span>Runs on page</span><strong>—</strong></div>
		<div><span>Findings</span><strong>—</strong></div>
		<div><span>High + critical</span><strong>—</strong></div>
		<div><span>Median duration</span><strong>—</strong></div>
		<div><span>Tokens</span><strong>—</strong></div>
		<div><span>Retries / failures</span><strong>—</strong></div>
	</div>
	<div class="table-wrap">
		<table class="history-table">
			<thead>
				<tr>
					<th>Repository</th>
					<th>Mode</th>
					<th>Status</th>
					<th>Findings / plan</th>
					<th>Agents / validation</th>
					<th>Execution</th>
					<th>Created</th>
					<th></th>
				</tr>
			</thead>
			<tbody id="run-history">
				<tr><td colspan="8">
					<div class="empty-state" role="status">
						<span class="empty-state-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
						</span>
						<strong class="empty-state-title">Loading runs…</strong>
						<span class="empty-state-hint">Fetching recent reviews from the local database.</span>
					</div>
				</td></tr>
			</tbody>
		</table>
	</div>
	<div class="history-pagination" id="history-pagination" hidden>
		<button type="button" class="secondary-button" id="history-previous">Previous</button>
		<span id="history-page-label">Page 1</span>
		<button type="button" class="secondary-button" id="history-next">Next</button>
	</div>
	<section class="history-comparison" id="history-comparison" hidden aria-live="polite">
		<div class="panel-heading">
			<div>
				<p class="eyebrow">Compatible baseline</p>
				<h3 id="history-comparison-title">Run comparison</h3>
			</div>
			<button type="button" class="secondary-button" id="history-comparison-close">Close</button>
		</div>
		<div class="comparison-counts" id="comparison-counts"></div>
		<div class="comparison-movements" id="comparison-movements"></div>
	</section>
</section>
<section class="panel results-panel reveal reveal-delay-3" id="results-panel" data-state="idle">
	<div class="panel-heading">
		<div class="panel-title-row">
			<span class="panel-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="M9 11l2 2 4-4"/><path d="M5 5h14v14H5z"/>
				</svg>
			</span>
			<div class="panel-title-text">
				<p class="eyebrow">Verified result</p>
				<h2>Review findings</h2>
			</div>
		</div>
		<div class="panel-heading-actions">
			<div class="export-actions" id="export-actions" hidden>
				<button type="button" class="secondary-button" data-export-format="markdown">
					Markdown
				</button>
				<button type="button" class="secondary-button" data-export-format="json">
					JSON
				</button>
				<button type="button" class="secondary-button" data-export-format="sarif" data-review-only="true">
					SARIF
				</button>
			</div>
			<span class="ai-badge" id="ai-badge">Deterministic</span>
		</div>
		<p class="panel-purpose">Inspect evidence-backed issues, filter by severity, and export the report.</p>
	</div>
	<p class="result-summary" id="result-summary">
		Complete a run to inspect its indexed languages and evidence-backed findings.
	</p>
	<div class="result-metrics">
		<div><span>Files</span><strong id="result-files">0</strong></div>
		<div><span>Languages</span><strong id="result-languages">—</strong></div>
		<div><span>Findings</span><strong id="result-count">0</strong></div>
		<div><span>AI context</span><strong id="result-ai-coverage">0 files</strong></div>
		<div><span>Scope</span><strong id="result-scope">—</strong></div>
		<div><span>Graph</span><strong id="result-graph">0 symbols</strong></div>
		<div><span>Plan</span><strong id="result-plan">0 tasks</strong></div>
		<div><span>Specialists</span><strong id="result-specialists">0 tasks</strong></div>
	</div>
	<div class="specialist-results" id="specialist-results" hidden></div>
	<div class="baseline-summary" id="baseline-summary" hidden></div>
	<div class="findings-toolbar" id="findings-toolbar">
		<label class="findings-search">
			<span>Search</span>
			<input type="search" id="finding-search" placeholder="Findings, files, or rules">
		</label>
		<label>
			<span>Severity</span>
			<select id="finding-severity">
				<option value="all">All severities</option>
				<option value="critical">Critical</option>
				<option value="high">High</option>
				<option value="medium">Medium</option>
				<option value="low">Low</option>
				<option value="info">Info</option>
			</select>
		</label>
		<label>
			<span>Review state</span>
			<select id="finding-review-state">
				<option value="all">All review states</option>
				<option value="new">New</option>
				<option value="acknowledged">Acknowledged</option>
				<option value="reviewed">Reviewed</option>
				<option value="dismissed">Dismissed</option>
				<option value="resolved">Resolved</option>
				<option value="reopened">Reopened</option>
			</select>
		</label>
		<label>
			<span>Sort</span>
			<select id="finding-sort">
				<option value="priority">Priority</option>
				<option value="confidence">Confidence</option>
				<option value="file">File</option>
			</select>
		</label>
	</div>
	<div class="finding-severity-summary" id="finding-severity-summary" aria-label="Finding severity totals"></div>
	<div class="findings-workspace">
		<div class="findings-list" id="findings-list">
			<div class="empty-state" role="status">
				<span class="empty-state-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l2 2 4-4"/><path d="M5 5h14v14H5z"/></svg>
				</span>
				<strong class="empty-state-title">No result selected</strong>
				<span class="empty-state-hint">Complete a run to inspect evidence-backed findings.</span>
			</div>
		</div>
		<aside class="finding-detail" id="finding-detail" aria-live="polite">
			<div class="empty-state" role="status">
				<span class="empty-state-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
				</span>
				<strong class="empty-state-title">Select a finding</strong>
				<span class="empty-state-hint">Inspect its evidence, recommendation, and review decision here.</span>
			</div>
		</aside>
	</div>
	<details class="fixed-findings" id="fixed-findings" hidden>
		<summary>Fixed since prior run</summary>
		<div class="fixed-findings-list" id="fixed-findings-list"></div>
	</details>
</section>

<section class="panel modernization-results reveal reveal-delay-4" id="modernization-results" data-state="idle" hidden aria-labelledby="modernization-results-title">
	<div class="panel-heading">
		<div class="panel-title-row">
			<span class="panel-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16M4 12h16M4 19h10"/><path d="m17 16 2 2 3-4"/></svg>
			</span>
			<div class="panel-title-text">
				<p class="eyebrow">Modernization workspace</p>
				<h2 id="modernization-results-title">Migration plan</h2>
			</div>
		</div>
		<div class="panel-heading-actions">
			<div class="modernization-export-actions" id="modernization-export-actions" hidden>
				<button type="button" class="secondary-button" data-modernization-export-format="markdown">Markdown</button>
				<button type="button" class="secondary-button" data-modernization-export-format="json">JSON</button>
			</div>
			<span class="status-badge" id="modernization-plan-state" data-state="idle">No plan</span>
		</div>
		<p class="panel-purpose">See what you have in legacy, the strangler road to peel it, and how each slice will look in ColdBox — then accept or rebuild a slice.</p>
	</div>
	<div class="modernization-overview" id="modernization-overview" aria-live="polite">
		<p class="result-summary">Complete a Modernize run to inspect the generated plan.</p>
	</div>
	<div class="modernization-coverage-banner" id="modernization-coverage-banner" hidden></div>
	<div class="modernization-solution" id="modernization-solution" hidden>
		<p class="modernization-road-coverage" id="modernization-road-coverage" hidden></p>
		<p class="modernization-source-stack" id="modernization-source-stack" hidden></p>
		<div class="modernization-solution-grid">
			<section class="modernization-band" aria-labelledby="modern-legacy-title">
				<h3 id="modern-legacy-title">Legacy you have</h3>
				<label class="modernization-legacy-toggle"><input type="checkbox" id="modernization-show-unsliced"> Show not yet sliced</label>
				<div id="modernization-legacy-list"></div>
			</section>
			<section class="modernization-band" aria-labelledby="modern-road-title">
				<h3 id="modern-road-title">Road</h3>
				<div id="modernization-road-list"></div>
			</section>
			<section class="modernization-band" aria-labelledby="modern-target-title">
				<h3 id="modern-target-title">How it will look</h3>
				<div id="modernization-route-strip"></div>
				<div id="modernization-target-tree"></div>
				<div id="modernization-slice-db"></div>
			</section>
		</div>
		<section class="modernization-architecture" id="modernization-architecture" aria-labelledby="modern-architecture-title" hidden>
			<h3 id="modern-architecture-title">Packaging decisions</h3>
			<p class="field-hint">Modular monolith first: what stays centralized, what becomes a ColdBox module, and what might isolate as a side-app (not day-one microservices).</p>
			<div class="modernization-architecture-grid">
				<div>
					<h4>Centralize</h4>
					<div id="modernization-arch-central"></div>
				</div>
				<div>
					<h4>ColdBox modules</h4>
					<div id="modernization-arch-modules"></div>
				</div>
				<div>
					<h4>Side-app / microservice later</h4>
					<div id="modernization-arch-extracts"></div>
				</div>
			</div>
		</section>
		<aside class="modernization-slice-dod" id="modernization-slice-dod" aria-live="polite"></aside>
	</div>
	<details class="modernization-secondary-catalogs" id="modernization-secondary-catalogs">
		<summary>Evidence and catalogs <span class="field-hint">(optional — use after you pick a road slice)</span></summary>
	<nav class="modernization-panes" id="modernization-panes" aria-label="Modernization result sections" role="tablist">
		<button type="button" role="tab" id="modern-tab-overview" aria-controls="modernization-pane-overview" aria-selected="true" tabindex="0" data-modern-pane="overview">Overview</button>
		<button type="button" role="tab" id="modern-tab-legacy" aria-controls="modernization-pane-legacy" aria-selected="false" tabindex="-1" data-modern-pane="legacy">Legacy catalog</button>
		<button type="button" role="tab" id="modern-tab-target" aria-controls="modernization-pane-target" aria-selected="false" tabindex="-1" data-modern-pane="target">Target structure</button>
		<button type="button" role="tab" id="modern-tab-routes" aria-controls="modernization-pane-routes" aria-selected="false" tabindex="-1" data-modern-pane="routes">Route contracts</button>
		<button type="button" role="tab" id="modern-tab-database" aria-controls="modernization-pane-database" aria-selected="false" tabindex="-1" data-modern-pane="database">Database</button>
		<button type="button" role="tab" id="modern-tab-links" aria-controls="modernization-pane-links" aria-selected="false" tabindex="-1" data-modern-pane="links">Links</button>
		<button type="button" role="tab" id="modern-tab-contexts" aria-controls="modernization-pane-contexts" aria-selected="false" tabindex="-1" data-modern-pane="contexts">Contexts</button>
		<button type="button" role="tab" id="modern-tab-roadmap" aria-controls="modernization-pane-roadmap" aria-selected="false" tabindex="-1" data-modern-pane="roadmap">Roadmap</button>
		<button type="button" role="tab" id="modern-tab-validation" aria-controls="modernization-pane-validation" aria-selected="false" tabindex="-1" data-modern-pane="validation">Validation + decisions</button>
	</nav>
	<div class="modernization-pane-toolbar" id="modernization-pane-toolbar">
		<label>Search <input id="modernization-search" type="search" placeholder="Find paths, tables, route names…"></label>
		<label>Item type <select id="modernization-item-type"><option value="all">All items</option><option value="legacy-unit">Legacy units</option><option value="target-unit">Target units</option><option value="unit-link">Unit links</option><option value="route-contract">Routes</option><option value="db-finding">Database findings</option><option value="db-transition">Transitions</option><option value="context">Contexts</option><option value="extract">Extracts</option><option value="roadmap-phase">Roadmap phases</option><option value="sample">Samples</option></select></label>
		<label>Validation <select id="modernization-validation-filter"><option value="all">All validation</option><option value="valid">Valid</option><option value="warning">Warnings</option><option value="blocking">Blocking</option><option value="unknown">Unknown</option></select></label>
		<label>Decision <select id="modernization-decision-filter"><option value="all">All decisions</option><option value="undecided">Undecided</option><option value="accepted">Accepted</option><option value="rejected">Rejected</option></select></label>
		<label>Context <select id="modernization-context-filter"><option value="all">All contexts</option></select></label>
		<label>Phase <select id="modernization-phase-filter"><option value="all">All phases</option></select></label>
	</div>
	<div class="modernization-pane" id="modernization-pane-overview" data-modernization-pane="overview" role="tabpanel" aria-labelledby="modern-tab-overview" tabindex="0"></div>
	<div class="modernization-pane" id="modernization-pane-legacy" data-modernization-pane="legacy" role="tabpanel" aria-labelledby="modern-tab-legacy" tabindex="0" hidden></div>
	<div class="modernization-pane" id="modernization-pane-target" data-modernization-pane="target" role="tabpanel" aria-labelledby="modern-tab-target" tabindex="0" hidden></div>
	<div class="modernization-pane" id="modernization-pane-routes" data-modernization-pane="routes" role="tabpanel" aria-labelledby="modern-tab-routes" tabindex="0" hidden></div>
	<div class="modernization-pane" id="modernization-pane-database" data-modernization-pane="database" role="tabpanel" aria-labelledby="modern-tab-database" tabindex="0" hidden></div>
	<div class="modernization-pane" id="modernization-pane-links" data-modernization-pane="links" role="tabpanel" aria-labelledby="modern-tab-links" tabindex="0" hidden></div>
	<div class="modernization-pane" id="modernization-pane-contexts" data-modernization-pane="contexts" role="tabpanel" aria-labelledby="modern-tab-contexts" tabindex="0" hidden></div>
	<div class="modernization-pane" id="modernization-pane-roadmap" data-modernization-pane="roadmap" role="tabpanel" aria-labelledby="modern-tab-roadmap" tabindex="0" hidden></div>
	<div class="modernization-pane" id="modernization-pane-validation" data-modernization-pane="validation" role="tabpanel" aria-labelledby="modern-tab-validation" tabindex="0" hidden></div>
	<aside class="modernization-item-detail" id="modernization-item-detail" aria-live="polite"></aside>
	</details>
</section>

<section class="panel architecture-explorer reveal reveal-delay-4" id="architecture-explorer" data-state="idle">
	<div class="panel-heading">
		<div class="panel-title-row">
			<span class="panel-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="7" r="2.5"/><circle cx="8" cy="18" r="2.5"/><circle cx="17" cy="17" r="2.5"/>
					<path d="M8.2 7.8 15.8 8.8M7.2 15.8 15.5 15.2M8.3 8.3 9.5 15.7"/>
				</svg>
			</span>
			<div class="panel-title-text">
				<p class="eyebrow">BoxLang architecture</p>
				<h2>Architecture explorer</h2>
			</div>
		</div>
		<div class="panel-heading-actions">
			<span class="status-badge" id="architecture-snapshot">No snapshot</span>
		</div>
		<p class="panel-purpose">See how files connect or what a change touches — click a node to filter facts below.</p>
	</div>
	<div class="architecture-diagram-shell" id="architecture-diagram-shell" hidden>
		<div class="architecture-diagram-head">
			<div class="architecture-diagram-title">
				<span class="architecture-diagram-mode" id="architecture-diagram-mode"></span>
				<p class="architecture-diagram-meta" id="architecture-diagram-meta"></p>
			</div>
			<button type="button" class="secondary-button" id="architecture-clear-selection" hidden>Clear selection</button>
		</div>
		<div class="architecture-diagram" id="architecture-diagram" role="img" aria-label="Architecture flowchart"></div>
	</div>
	<div class="architecture-toolbar">
		<input type="search" id="architecture-search" placeholder="Search symbols, files, or dependencies">
		<select id="architecture-kind">
			<option value="all">All architecture facts</option>
			<option value="symbols">Symbols</option>
			<option value="dependencies">Dependencies</option>
			<option value="impacts">Impact paths</option>
		</select>
	</div>
	<div class="architecture-summary" id="architecture-summary"></div>
	<div class="architecture-results" id="architecture-results">
