<section class="page-intro reveal reveal-delay-1">
	<div>
		<p class="eyebrow">Local · BoxLang · ColdFusion · JavaScript</p>
		<h1>DoubleCheck</h1>
		<p class="lede">
			An evidence-backed second pair of eyes for supported application code — read-only by default and running on your machine.
		</p>
	</div>
</section>

<section class="dashboard-grid reveal reveal-delay-2">
	<div class="panel workspace-card">
		<div class="panel-heading">
			<div class="panel-title-row">
				<span class="panel-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
						<path d="M9 11l2 2 4-4"/><path d="M5 5h14v14H5z"/>
					</svg>
				</span>
				<div class="panel-title-text">
					<p class="eyebrow">Code Analysis</p>
					<h2>Review</h2>
				</div>
			</div>
			<p class="panel-purpose">Find correctness and security issues in your code.</p>
		</div>
		<div class="workspace-card-actions">
			<a href="/review" class="primary-button">Start Review</a>
		</div>
	</div>

	<div class="panel workspace-card">
		<div class="panel-heading">
			<div class="panel-title-row">
				<span class="panel-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 5h16M4 12h16M4 19h10"/><path d="m17 16 2 2 3-4"/>
					</svg>
				</span>
				<div class="panel-title-text">
					<p class="eyebrow">Migration Planning</p>
					<h2>Modernize</h2>
				</div>
			</div>
			<p class="panel-purpose">Plan a CFML migration to BoxLang or Lucee.</p>
		</div>
		<div class="workspace-card-actions">
			<a href="/modernize" class="primary-button">Start Modernize</a>
		</div>
	</div>

	<div class="panel workspace-card">
		<div class="panel-heading">
			<div class="panel-title-row">
				<span class="panel-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="7" r="2.5"/><circle cx="8" cy="18" r="2.5"/><circle cx="17" cy="17" r="2.5"/>
						<path d="M8.2 7.8 15.8 8.8M7.2 15.8 15.5 15.2M8.3 8.3 9.5 15.7"/>
					</svg>
				</span>
				<div class="panel-title-text">
					<p class="eyebrow">Knowledge Graph</p>
					<h2>CodeGraph</h2>
				</div>
			</div>
			<p class="panel-purpose">Explore CF/BoxLang symbols, dependencies, and clusters.</p>
		</div>
		<div class="workspace-card-actions">
			<a href="/codegraph" class="primary-button">Start CodeGraph</a>
		</div>
	</div>
</section>

<section class="panel history-panel reveal reveal-delay-4" id="history-panel">
	<div class="panel-heading">
		<div class="panel-title-row">
			<span class="panel-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
				</svg>
			</span>
			<div class="panel-title-text">
				<p class="eyebrow">Review intelligence</p>
				<h2>Run history</h2>
			</div>
		</div>
		<div class="panel-heading-actions">
			<button type="button" class="secondary-button" id="refresh-button">
				Refresh
			</button>
		</div>
	<p class="panel-purpose">Browse Review, Modernize, and CodeGraph runs, spot trends, and compare compatible Review baselines.</p>
	</div>
	<form class="history-filters" id="history-filters">
		<label>
			<span>Search</span>
			<input type="search" name="q" id="history-search" placeholder="Repository, run ID, message…">
		</label>
		<label>
			<span>Mode</span>
			<select name="mode" id="history-mode">
				<option value="">All modes</option>
				<option value="working-tree">Working tree</option>
				<option value="revision-diff">Revision comparison</option>
				<option value="full">Full baseline</option>
			</select>
		</label>
		<label>
			<span>Status</span>
			<select name="status" id="history-status">
				<option value="">All statuses</option>
				<option value="succeeded">Succeeded</option>
				<option value="partial">Warnings</option>
				<option value="failed">Failed</option>
				<option value="cancelled">Cancelled</option>
				<option value="running">Running</option>
				<option value="queued">Queued</option>
			</select>
		</label>
		<label>
			<span>Workspace</span>
			<select name="runKind" id="history-run-kind">
				<option value="">All workspaces</option>
				<option value="review">Review</option>
				<option value="modernize">Modernize</option>
				<option value="codegraph">CodeGraph</option>
			</select>
		</label>
		<label>
			<span>From</span>
			<input type="date" name="from" id="history-from">
		</label>
		<label>
			<span>To</span>
			<input type="date" name="to" id="history-to">
		</label>
		<div class="history-filter-actions">
			<button type="submit" class="primary-button">Apply</button>
			<button type="button" class="secondary-button" id="history-clear">Clear</button>
		</div>
	</form>
	<div class="history-trends" id="history-trends" aria-live="polite">
		<div><span>Runs on page</span><strong>—</strong></div>
		<div><span>Findings</span><strong>—</strong></div>
		<div><span>High + critical</span><strong>—</strong></div>
		<div><span>Median duration</span><strong>—</strong></div>
		<div><span>Tokens</span><strong>—</strong></div>
		<div><span>Retries / failures</span><strong>—</strong></div>
	</div>
	<div class="table-wrap">
		<table class="history-table">
			<thead>
				<tr>
					<th>Repository</th>
					<th>Mode</th>
					<th>Status</th>
					<th>Findings / plan</th>
					<th>Agents / validation</th>
					<th>Execution</th>
					<th>Created</th>
					<th></th>
				</tr>
			</thead>
			<tbody id="run-history">
				<tr><td colspan="8">
					<div class="empty-state" role="status">
						<span class="empty-state-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
						</span>
						<strong class="empty-state-title">Loading runs…</strong>
						<span class="empty-state-hint">Fetching recent reviews from the local database.</span>
					</div>
				</td></tr>
			</tbody>
		</table>
	</div>
	<div class="history-pagination" id="history-pagination" hidden>
		<button type="button" class="secondary-button" id="history-previous">Previous</button>
		<span id="history-page-label">Page 1</span>
		<button type="button" class="secondary-button" id="history-next">Next</button>
	</div>
	<section class="history-comparison" id="history-comparison" hidden aria-live="polite">
		<div class="panel-heading">
			<div>
				<p class="eyebrow">Compatible baseline</p>
				<h3 id="history-comparison-title">Run comparison</h3>
				<p class="field-hint">Findings that appeared, disappeared, or changed severity between the two selected runs.</p>
			</div>
			<button type="button" class="secondary-button" id="history-comparison-close">Close</button>
		</div>
		<div class="comparison-counts" id="comparison-counts"></div>
		<div class="comparison-movements" id="comparison-movements"></div>
	</section>
</section>

<details class="panel settings-panel reveal reveal-delay-4" id="settings-panel">
	<summary class="settings-summary">
		<div class="panel-title-row">
			<span class="panel-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="3"/>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
				</svg>
			</span>
			<div class="panel-title-text">
				<p class="eyebrow">Local preferences · AI providers · run guardrails</p>
				<h2>Settings</h2>
			</div>
		</div>
		<p class="panel-purpose">Manage AI provider connections and server-wide run defaults. Expand to edit.</p>
		<span class="settings-chevron" aria-hidden="true">▸</span>
	</summary>
	<div class="settings-body">
		<section class="settings-subsection" id="ai-providers-subsection">
			<div class="settings-subsection-heading">
				<h3>AI providers</h3>
				<p class="field-hint">Add one or more provider connections and pick which is active. Basic review works without any provider configured.</p>
			</div>
			<div class="table-wrap">
				<table class="history-table provider-table" id="provider-table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Provider</th>
							<th>Model</th>
							<th>API key</th>
							<th>Status</th>
							<th></th>
						</tr>
					</thead>
					<tbody id="provider-table-body">
						<tr><td colspan="6">
							<div class="empty-state" role="status">
								<span class="empty-state-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
								</span>
								<strong class="empty-state-title">Loading providers…</strong>
							</div>
						</td></tr>
					</tbody>
				</table>
			</div>
			<form id="provider-form" class="settings-form provider-form">
				<input type="hidden" name="id" id="provider-id">
				<label>
					<span>Profile name</span>
					<input type="text" name="name" id="provider-name" maxlength="120" placeholder="e.g. OpenRouter DeepSeek" required>
				</label>
				<label>
					<span>Provider type</span>
					<select name="provider" id="provider-type" required>
						<option value="openai">OpenAI</option>
						<option value="openai-compatible">OpenAI-compatible</option>
						<option value="openrouter" selected>OpenRouter</option>
						<option value="ollama">Ollama (local)</option>
						<option value="docker">Docker Model Runner (local)</option>
						<option value="lmstudio">LM Studio (local)</option>
						<option value="llamacpp">llama.cpp (local)</option>
					</select>
				</label>
				<label>
					<span>Base URL</span>
					<input type="url" name="baseUrl" id="provider-base-url" placeholder="https://openrouter.ai/api/v1" required>
				</label>
				<label>
					<span>Model</span>
					<input type="text" name="model" id="provider-model" maxlength="200" placeholder="e.g. deepseek/deepseek-chat" required>
				</label>
				<label>
					<span>API key</span>
					<input type="password" name="apiKey" id="provider-api-key" autocomplete="off" placeholder="Leave blank to keep the saved key">
				</label>
				<label>
					<span>Timeout (seconds)</span>
					<input type="number" name="timeoutSeconds" id="provider-timeout" min="1" max="3600" value="120" required>
				</label>
				<label>
					<span>Context window (tokens)</span>
					<input type="number" name="contextWindow" id="provider-context-window" min="512" max="2000000" value="128000" required>
				</label>
				<label>
					<span>Input $ / million tokens</span>
					<input type="number" name="inputUsdPerMillion" id="provider-input-rate" min="0" step="0.01" value="0" required>
				</label>
				<label>
					<span>Output $ / million tokens</span>
					<input type="number" name="outputUsdPerMillion" id="provider-output-rate" min="0" step="0.01" value="0" required>
				</label>
				<div class="settings-actions">
					<button type="submit" class="primary-button" id="provider-save-button">Add provider</button>
					<button type="button" class="secondary-button" id="provider-cancel-edit" hidden>Cancel edit</button>
					<span id="provider-form-status" role="status"></span>
				</div>
			</form>
		</section>

		<section class="settings-subsection" id="run-defaults-subsection">
			<div class="settings-subsection-heading">
				<h3>Run defaults</h3>
				<p class="field-hint">Server-wide defaults and hard ceilings for every new run. Per-run "Advanced limits" on Review stay within these ceilings.</p>
			</div>
			<form id="run-defaults-form" class="settings-form">
				<label>
					<span>Max review tasks</span>
					<input type="number" name="planMaxTasks" min="1" max="20" required>
				</label>
				<label>
					<span>Default token budget</span>
					<input type="number" name="runDefaultTokenBudget" min="128" max="200000" required>
				</label>
				<label>
					<span>Max token budget</span>
					<input type="number" name="runMaxTokenBudget" min="128" max="200000" required>
				</label>
				<label>
					<span>Default tokens per task</span>
					<input type="number" name="runDefaultTokensPerTask" min="128" max="100000" required>
				</label>
				<label>
					<span>Max tokens per task</span>
					<input type="number" name="runMaxTokensPerTask" min="128" max="100000" required>
				</label>
				<label>
					<span>Default specialist deadline (ms)</span>
					<input type="number" name="runDefaultDurationMs" min="1000" max="7200000" required>
				</label>
				<label>
					<span>Max specialist deadline (ms)</span>
					<input type="number" name="runMaxDurationMs" min="1000" max="7200000" required>
				</label>
				<label>
					<span>Default iterations per task</span>
					<input type="number" name="runDefaultIterationsPerTask" min="1" max="100" required>
				</label>
				<label>
					<span>Max iterations per task</span>
					<input type="number" name="runMaxIterationsPerTask" min="1" max="100" required>
				</label>
				<label>
					<span>Default tool output characters</span>
					<input type="number" name="runDefaultToolOutputCharacters" min="1000" max="1000000" required>
				</label>
				<label>
					<span>Max tool output characters</span>
					<input type="number" name="runMaxToolOutputCharacters" min="1000" max="1000000" required>
				</label>
				<label>
					<span>Default provider cost ($)</span>
					<input type="number" name="runDefaultCostUsd" min="0.01" max="10000" step="0.01" required>
				</label>
				<label>
					<span>Max provider cost ($)</span>
					<input type="number" name="runMaxCostUsd" min="0.01" max="10000" step="0.01" required>
				</label>
				<label>
					<span>Observability preview characters</span>
					<input type="number" name="observabilityPreviewCharacters" min="100" max="20000" required>
				</label>
				<label class="settings-check">
					<input type="checkbox" name="observabilityEnabled">
					<span>Enable the live observability panel by default</span>
				</label>
				<div class="settings-actions">
					<button type="submit" class="primary-button">Save run defaults</button>
					<span id="run-defaults-status" role="status"></span>
				</div>
			</form>
		</section>

		<section class="settings-subsection" id="local-preferences-subsection">
			<div class="settings-subsection-heading">
				<h3>Local preferences</h3>
				<p class="field-hint">Applied when starting a new review from this device.</p>
			</div>
			<form id="preferences-form" class="settings-form">
				<label>
					<span>Default review depth</span>
					<select name="defaultPreset">
						<option value="quick">Quick</option>
						<option value="balanced">Balanced</option>
						<option value="deep">Deep</option>
					</select>
				</label>
				<label>
					<span>Default review mode</span>
					<select name="defaultMode">
						<option value="full">Full baseline</option>
						<option value="working-tree">Working tree</option>
						<option value="revision-diff">Revision comparison</option>
					</select>
				</label>
				<label class="settings-check">
					<input type="checkbox" name="rememberProject">
					<span>Remember the last project path on this device</span>
				</label>
				<div class="settings-actions">
					<button type="submit" class="primary-button">Save preferences</button>
					<button type="button" class="secondary-button" id="preferences-reset">Reset</button>
					<span id="preferences-status" role="status"></span>
				</div>
			</form>
		</section>
	</div>
</details>
