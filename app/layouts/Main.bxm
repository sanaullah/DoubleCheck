<bx:output>
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=1280">
	<meta name="description" content="DoubleCheck — local second pair of eyes for BoxLang, ColdFusion, JavaScript, and Java">
	<title>DoubleCheck</title>
	<link rel="icon" href="/favicon.ico" sizes="any">
	<link rel="icon" href="/favicon.svg" type="image/svg+xml">
	<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
	<link rel="apple-touch-icon" href="/apple-touch-icon.png">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link
		href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
		rel="stylesheet"
	>
	<link rel="stylesheet" href="/assets/app.css?v=local-oss-18">
</head>
<body>
	<header class="site-header">
		<a class="brand" href="#event.buildLink( "main.index" )#">
			<span class="brand-mark">DC</span>
			<span>
				<strong>DoubleCheck</strong>
				<small>Local code review</small>
			</span>
		</a>
		<div class="system-pill">
			<a class="docs-link" href="/apidocs/" target="_blank" rel="noopener">API docs</a>
			<span class="status-dot" id="health-dot"></span>
			<span id="health-label">Checking system</span>
		</div>
	</header>
	<main class="app-shell">
		#view()#
	</main>
	<script src="/assets/architecture-flow.js?v=local-oss-2" defer></script>
	<script src="/assets/app.js?v=local-oss-16" defer></script>
</body>
</html>
</bx:output>
