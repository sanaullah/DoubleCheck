/**
 * DoubleCheck setup — creates .env if missing.
 * Database file + schema are created and validated automatically on first
 * app start by SchemaService.
 *
 * Usage:
 *   boxlang Setup.bx
 *   box run-script setup
 */
class {

	function init() {
		variables.cwd = normalizePath( ( server.cli.executionPath ?: expandPath( "." ) ) & "/" );
		if ( right( variables.cwd, 1 ) != "/" ) {
			variables.cwd &= "/";
		}
		return this;
	}

	function main() {
		println( "" );
		println( "DoubleCheck setup" );
		println( "-----------------" );

		var envPath     = variables.cwd & ".env";
		var examplePath = variables.cwd & ".env.example";

		if ( !fileExists( envPath ) ) {
			if ( !fileExists( examplePath ) ) {
				println( "[x] Missing .env.example" );
				CLIExit( 1 );
			}
			fileCopy( examplePath, envPath );
			println( "[ok] Created .env from .env.example" );
			println( "     Optional: set OPENAI_API_KEY for LLM specialists" );
		} else {
			println( "[ok] .env already present" );
		}

		println( "" );
		println( "Database and schema are created automatically on first server start." );
		println( "Next: box server start" );
		println( "" );
	}

	private string function normalizePath( required string path ) {
		var normalized = replace( arguments.path, "\", "/", "all" );
		normalized = replace( normalized, "/./", "/", "all" );
		while ( find( "//", normalized ) > 1 ) {
			normalized = replace( normalized, "//", "/", "all" );
		}
		return normalized;
	}

}
