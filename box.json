{
    "name":"DoubleCheck",
    "version":"0.1.0",
    "author":"Sana Ullah",
    "location":"sanaullah/DoubleCheck#v@build.version@",
    "slug":"doublecheck",
    "homepage":"https://github.com/sanaullah/DoubleCheck",
    "repository":{
        "type":"git",
        "URL":"https://github.com/sanaullah/DoubleCheck.git"
    },
    "bugs":"https://github.com/sanaullah/DoubleCheck/issues",
    "license":[
        {
            "type":"Apache-2.0",
            "URL":"https://www.apache.org/licenses/LICENSE-2.0"
        }
    ],
    "createPackageDirectory":false,
    "type":"mvc",
    "language":"boxlang",
    "keywords":"boxlang,coldbox,coldfusion,javascript,code-review",
    "shortDescription":"Local open-source code review for BoxLang, ColdFusion, and JavaScript",
    "ignore":[],
    "dependencies":{
        "coldbox":"be",
        "cfmigrations":"^5.1.2",
        "cbvalidation":"^4.8.0",
        "cbswagger":"^3.1.3+14"
    },
    "devDependencies":{
        "testbox":"*",
        "route-visualizer":"*",
        "commandbox-boxlang":"*",
        "commandbox-migrations":"^6.0.0"
    },
    "installPathConventions":{
        "modules":"lib/modules"
    },
    "installPaths":{
        "coldbox":"lib/coldbox/",
        "testbox":"lib/testbox/",
        "route-visualizer":"lib/modules/route-visualizer/",
        "cfmigrations":"lib/modules/cfmigrations/",
        "cbvalidation":"lib/modules/cbvalidation/",
        "cbswagger":"lib/modules/cbswagger/"
    },
    "scripts":{
        "setup":"!boxlang Setup.bx",
        "postInstall":"!boxlang Setup.bx",
        "compile":"!boxlang compile --source app --target .tmp/compile",
        "test":"!box testbox run"
    },
    "testbox":{
        "runner":"/tests/runner.bxm"
    },
    "description":"Local, evidence-backed code review for BoxLang, ColdFusion, and JavaScript only."
}
